% NPL SOURCE REFERENCE - MON 60B 104B - IWSYSP write system parameters (verbatim, 5P-P2-MON60.NPL)
IWSYSP:      % FUNCTION=104: WRITE SYSTEM PARAMETERS
       T:="N500DF+SYSPAR"; X:=16; 5P1=:D; A:=OLDPAGE
       K:="0"; CALL MOVUS                        % COPY SYSTEM PARAMETERS TO N500DF
       GO FAR 5NOPAR; *)FILL
