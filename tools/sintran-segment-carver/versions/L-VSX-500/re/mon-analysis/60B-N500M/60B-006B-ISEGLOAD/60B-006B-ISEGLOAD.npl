% NPL SOURCE REFERENCE - MON 60B subfunction 006B - ISEGLOAD
% Verbatim from 5P-P2-MON60.NPL. NPL logic, not authoritative bytes.

ISEGLOAD:    % FUNCTION=006: LOAD (PLACE), ONE SEGMENT
       A:=5P1; T:=200; CALL FRUSMOVE             % COPY SEGMENT NAME FROM USER TO MON60 BUFFER
       IF 5D51><0 THEN                           % ANY ND-100/ND-500 SHARED PARTS?
          A:=5P5; T:=40; X:=100; CALL XFRUSMOVE  % YES, COPY SHARD-INFO FROM USER TO MON60 BUFFER
       FI; GO FAR 5NOPAR; *)FILL
