% NPL SOURCE REFERENCE - MON 60B 135B - IABLOG logoff+abort RT-program (verbatim, 5P-P2-MON60.NPL)
IABLOG:      % FUNCTION=135: LOGG OFF PROCESS AND ABORT RT-PROGRAM.
        IF 5D11><0 GO FAR EEILPAR                % 5DD1=RT-DESCR ADDR
        IF X:=5D12=0 THEN X:=RTREF FI            % RT-DESCR=0 MEANS CALLING PROGR
        IF X.STATUS BIT 5BACKGR GO FAR EEILPAR   % ONLY RT-PROGR. CAN BE ABORTED
        CALL GOODRT; GO FAR EEILPAR          % LEGAL RT-DESCR ADDR?
        *IOF
        5DD1; CALL FSEMA; GO FAR 5ABPROG         % YES, HAS IT RESERVED A ND-500 PROC?
        X.PSTAT BONE 5SYSABORT BONE SOFFLOG      % 5SYSABORT=1 AND SOFFLOG=1 MEANS LOGG OFF ND-500 PROC
        GO FAR INPRABORT; *)FILL                 % A=PSTAT; INTERRUPT OFF
