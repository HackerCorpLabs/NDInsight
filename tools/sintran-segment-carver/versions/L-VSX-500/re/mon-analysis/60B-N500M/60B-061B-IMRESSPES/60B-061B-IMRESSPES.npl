% NPL SOURCE REFERENCE - MON 60B 061B - IMRESSPES reserve mem for test-monitor (verbatim, 5P-P2-MON60.NPL)
IMRESSPES:   % FUNCTION=061: RESERVE MEORY FOR THE ND-500 TEST-MONITOR
       IF 5D11 = -1 AND 5D12 >< -1 THEN
          IF A-1>>NCPU-1 GO FAR EEILPAR             % CHECK IF ND-500 CPU SPECIFIED?
          A*5CPUDFSZ+"S5CPUDF"=:X=:CCPUDF           % CCPUDF=CURRENT ND-500 CPU DF.
          IF X.SPREF><0 AND A><RTREF GO FAR EESPRES % ERROR IF THIS CPU IS ALREADY RESERVED FOR SPECIAL USE BY ANOTHER
       FI
  OUT: CALL TUSON; GO FAR ERET                      % ANY OTHER USING THIS CPU NOW?
       GO FAR 5NOPAR; *)FILL                        % NO, RESERVED FOR SPECIAL USE BY THE CALLER
