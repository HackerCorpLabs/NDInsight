% NPL SOURCE REFERENCE - MON 60B 114B - IRELLOG release logging facility (verbatim, 5P-P2-MON60.NPL)
IRELLOG:     % FUNCTION=114: STOP LOGGING AND RELEASE LOGGING FACILITY
       IF 5HRTP><RTREF THEN ELOGNRESERVED; GO FAR ERET FI  % LOGGING FACILITY RESERVED BY THE CALLER?
       0=:5HIFLAG=:5HRTP; GO FAR 5OKRET; *)FILL             % YES, STOP LOGGING AND RELEASE LOGGING FACILITY
