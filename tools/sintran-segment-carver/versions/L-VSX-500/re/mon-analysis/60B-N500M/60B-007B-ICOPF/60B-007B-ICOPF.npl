% NPL SOURCE REFERENCE - MON 60B - ICOPF (shared file-name-copy handler)
% Verbatim from E:\Dev\Ronny\NDInsight\SINTRAN\NPL-SOURCE\NPL\5P-P2-MON60.NPL
% NPL logic (different revision than L07 bytes); use for logic, not as bytes.

IPLSWAPPER:  % FUNCTION=007: PLACE SWAPPER
IDEFSWAP:    % FUNCTION=046: DEFINE SWAP FILE
IDELSWAP:    % FUNCTION=047: DELETE SWAP FILE
ISPRTE:      % FUNCTION=067: READ PROCESS ENTRY FROM NAME SEGMENT
ISSGTE:      % FUNCTION=071: READ PHYS.SEGMENT ENTRY FROM NAME SEGMENT
ISFSYDOM:    % FUNCTION=130: START STANDARD DOMAIN
IDLSYDOM:    % FUNCTION=131: DELETE STANDARD DOMAIN
ICOPF: A:=5P1; T:=200; CALL FRUSMOVE             % COPY FILE NAME TO MON60 BUFFER
       GO FAR 5NOPAR; *)FILL
