% NPL SOURCE REFERENCE - MON 60B 074B/136B - ISPRNM/IPRACTIVE (verbatim, 5P-P2-MON60.NPL)
ISPRNM:      % FUNCTION=074: SET NAME ON CURRENT PROCESS
IPRACTIVE:   % FUNCTION=136: ACTIVATE STOPPED PROCESS
       A:=5P1; T:=50; CALL FRUSMOVE          % COPY PROCESS NAME TO MON60 BUFFER
       GO FAR 5NOPAR; *)FILL
