% NPL SOURCE REFERENCE - MON 60B 125B - IPRIMLOG read moncall log (verbatim, 5P-P2-MON60.NPL)
IPRIMLOG:    % FUNCTION=125: READ MONCALL LOG DATA (PRINT MONCALL LOG)
       IF 5MLOG><RTREF THEN ELOGNRESERVED; GO FAR ERET FI  % MONCALL LOG RESERVED BY THE CALLER?
       A:=5FBUM60=:D:=0; AD SH 12; CALL XSUPDWINDOW    % YES, SETUP WINDOW TO MONCALL LOG DATA BUFFER
       A:=3000; T:=5P1; CALL TOUSMOVE                  % COPY MONCALL LOG DATA TO USER FROM MONCALL LOG DATA BUFFER
       GO FAR 5OKRET; *)FILL
