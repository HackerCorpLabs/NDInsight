% NPL SOURCE REFERENCE - MON 60B 062B - IDEFHIST define histogram (verbatim, 5P-P2-MON60.NPL)
IDEFHIST:    % FUNCTION=062: DEFINE HISTOGRAM
       IF 5HRTP><0 AND A><RTREF THEN EHIUSED; GO FAR ERET FI  % HISTOGRAM ALREADY IN USE BY ANOTHER
       RTREF=:5HRTP; 0=:5HIFLAG                            % SET ND-500 CPU AND SPECIFY PROC TO RUN HISTOGRAM ON
       AD:=5DD3                                            % AD=NUMBER OF INTERVALS
       IF A><0 OR D>>100 OR D=0 GO FAR EEILPAR             % 100B INTERVAL IS MAX
       A:=D=:5HICHANNELS
       AD:=5DD2                                            % AD=INTERVAL SIZE
       IF A><0 OR D=0 GO FAR EEILPAR
       A:=D=:5HINTERVAL; AD:=5DD1=:5HISTART                % 5HISTART=START OF FIRST INTERVAL
       X:="5HIDATA"
       DO WHILE X<<="5HIOUTSIDE"+1; 0=:X.S0; X+1; OD       % CLEAR HISTOGRAM SAMPLING BUFFER
       GO FAR 5OKRET; *)FILL
