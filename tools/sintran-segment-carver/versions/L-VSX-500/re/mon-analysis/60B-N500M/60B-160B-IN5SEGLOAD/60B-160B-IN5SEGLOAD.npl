% NPL SOURCE REFERENCE - MON 60B 160B - IN5SEGLOAD load segment (new domain format) (verbatim, 5P-P2-MON60.NPL)
IN5SEGLOAD:  % FUNCTION=160: LOAD (PLACE), ONE SEGMENT (NEW DOMAIN FORMAT)
       A:=5P1; T:=12; CALL FRUSMOVE              % COPY SEGMENT NAME FROM USER TO MON60 BUFFER
       IF 5D41><0 THEN                           % ANY ND-100/ND-500 SHARED PARTS?
          A:=5P4; T:=300; X:=5; CALL XFRUSMOVE   % YES, COPY SHARD-INFO FROM USER TO MON60 BUFFER
       FI; GO FAR 5NOPAR; *)FILL
