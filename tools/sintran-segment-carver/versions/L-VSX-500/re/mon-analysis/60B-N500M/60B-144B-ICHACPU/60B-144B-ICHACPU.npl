% NPL SOURCE REFERENCE - MON 60B 144B - ICHACPU change CPU (verbatim, 5P-P2-MON60.NPL)
ICHACPU:     % FUNCTION=144: CHANGE CPU
       IF 5D12-1>>NCPU-1 GO FAR EEILPAR
       A*5CPUDFSZ+"S5CPUDF"=:X                   % YES
       IF X.CPUAVAILABLE NBIT 5ALIVE THEN ENOCPU; GO FAR ERET FI
       IF T:=BACKGROUND><0 AND T:=5PASSTYPE=0 THEN % PUBLIC USER?
          IF A BIT 5EXCLUDE THEN ENAUTHORISED; GO FAR ERET FI
       FI
       IF X.SPREF><0 AND A><RTREF GO FAR EESPRES % RESERVED FOR SPECIAL USE BY ANYONE ELSE?
       X=:D:=5PRDESCR.MESSBUFF
       CALL GCPUDF; CALL ERRFATAL
       IF A.SPREF=RTREF AND X><D THEN            % CPU CHANGED AND OLD CPU-DF RESERVED FOR SPECIAL USE BY THE CALLER?
          CALL RELCPU                            % RELEASE OLD CPU-DF FROM SPECIAL USE
       FI
       5D12-1*5CPUDFSZ+"S5CPUDF"=:X
       A:=X.CPUNO; T:=5MBBANK; X:=5PRDESCR.MESSBUFF
       *IOF
       *AAX 5CPUN; STATX                         % SAVE ADDR OF NEW CPU-DF IN MESSAGE
       *AAX 5MSFL-5CPUN; LDATX                   % SET CPU-BOUND PROCESS
       A BONE 5CPUBOUND; *STATX
       *ION
       GO FAR 5OKRET; *)FILL
