% NPL SOURCE REFERENCE - MON 60B 112B - ISTOLOG stop logging (verbatim, 5P-P2-MON60.NPL)
ISTOLOG:     % FUNCTION=112: STOP LOGGING
       IF 5HRTP><RTREF THEN ELOGNRESERVED; GO FAR ERET FI  % LOGGING FACILITY RESERVED BY CALLER?
       0=:5HIFLAG; GO FAR 5OKRET; *)FILL                    % YES, MARK THAT LOGGING IS STOPPED
