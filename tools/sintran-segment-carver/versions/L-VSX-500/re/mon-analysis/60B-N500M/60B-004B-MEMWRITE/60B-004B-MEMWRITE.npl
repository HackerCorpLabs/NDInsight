% NPL SOURCE REFERENCE - MON 60B 004B/005B/033B - IPMWRITE/IDMWRITE/IDAMW (verbatim, 5P-P2-MON60.NPL)
IPMWRITE:    % FUNCTION=004: LOGICAL PROGREAM MEMORY WRITE
IDMWRITE:    % FUNCTION=005: LOGICAL DATA MEMORY WRITE
IDAMW:       % FUNCTION=033: PHYSICAL DATA MEMORY WRITE
       AD:=5DD1
       IF A><0 OR D>>4000 THEN
          EBIGBUF; GO FAR ERET                   % 4000B BYTES ARE MAX DUE TO BUFFER SIZE
       FI
       T:=5D12; A:=5P3; CALL FRUSMOVE            % COPY DATA FROM USER TO MON60 BUFFER
       GO FAR 5NOPAR; *)FILL
