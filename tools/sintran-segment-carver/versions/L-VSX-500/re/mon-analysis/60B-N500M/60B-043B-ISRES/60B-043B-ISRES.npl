% NPL SOURCE REFERENCE - MON 60B 043B - ISRES reserve special use (verbatim, 5P-P2-MON60.NPL)
ISRES:            % FUNCTION=043: RESERVE ND-500 CPU/SYSTEM FOR SPECIAL USE
       IF 5D11=0 AND 5D12=0 THEN
          IF CCPUDF.SPREF=RTREF GO FAR 5OKRET                    % ALREADY RESERVED FOR SPECIAL USE BY CALLER?
          CALL TUSON; GO FAR ERET                                % IF ANYONE ELSE USING THIS ND-500 CPU NOW ?
       ELSE
          IF RTREF=NSPREF GO FAR 5OKRET                          % ALREADY RESERVED FOR SPECIAL USE BY CALLER?
          A=:NSPREF; CALL XTUSON; GO FAR ERET                    % SET UNAVAILABLE AND CHECK FOR OTHER USERS ALREADY LOGGED ON
       FI
       GO FAR 5OKRET
