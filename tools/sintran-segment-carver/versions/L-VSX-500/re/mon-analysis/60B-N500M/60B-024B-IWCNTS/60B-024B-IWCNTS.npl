% NPL SOURCE REFERENCE - MON 60B 024B/157B - IWCNTS write control store (verbatim, 5P-P2-MON60.NPL)
IWCNTS:      % FUNCTION=024 : WRITE CONTROL STORE (equal for func=157)
       IF 5D22>>2000 GO FAR ERET                    % 2000B CS-WORDS ARE MAX.
       T:=5D22 SH 1; A:=5P3; CALL FRUSMOVE       % COPY CONTROL STORE DATA FROM USER TO MON60 BUFFER
       GO FAR 5NOPAR; *)FILL
