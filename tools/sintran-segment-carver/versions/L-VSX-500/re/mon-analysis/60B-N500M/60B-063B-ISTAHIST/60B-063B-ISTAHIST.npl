% NPL SOURCE REFERENCE - MON 60B 063B - ISTAHIST start histogram (verbatim, 5P-P2-MON60.NPL)
ISTAHIST:    % FUNCTION=063: START HISTOGRAM
       IF RTREF><5HRTP THEN EHNRESERVED; GO FAR ERET FI    % HISTOGRAM RESERVED BY CALLER?
       IF 5HIFLAG><0 GO FAR 5OKRET
       5PRDESCR-"S500S"; A=:D:=0; T:=5PRDSIZE; *RDIV ST    % COMPUTE PROC.NO OF CALLER
       A-1*2+"F5DSG"=:T; X:="5RPRONO"
       CALL GET1L; CALL ERRFATAL; A=:5D12
       IF 5HIFLAG=0 THEN
          *IOF
          CALL HIMFEXQUEUE; 0/\0                           % MAKE SURE HISTOGRAM MESS IS NOT IN EX-QUEUE
          CALL SLOCK; 0/\0;
          5D12-5SWPROC*5PRDSIZE+"S500S"; X:=A.MESSBUFF
          T:=5MBBANK; *AAX 5MSFL; LDATX; 5CPUB@3 BLDA DA
          A BONE 5CPUBOUND; *5SCPU@3 BSTA DA; STATX
          *AAX 5CPUN-5MSFL; LDATX
          X:=HIMESS; *AAX 5CPUN; STATX
          5D12; *AAX WANTP-5CPUN; STATX; AAX -WANTP        % PROC.NO. INTO HISTOGRAM MESSAGE
          CALL GCPUDF; CALL ERRFATAL; A=:B
          CALL ITO500XQ                                    % INSERT HISTOGRAM MESS IN EX-QUEUE
          CALL SUNLOCK
          1=:5HIFLAG                                       % MARK THAT HISTOGRAM SAMPLING IS STARTED
          *ION
          "N500DF"=:B
       FI
       GO FAR 5OKRET; *)FILL
