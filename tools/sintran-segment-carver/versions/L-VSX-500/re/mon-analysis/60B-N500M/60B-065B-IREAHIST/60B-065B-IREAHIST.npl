% NPL SOURCE REFERENCE - MON 60B 065B - IREAHIST read histogram (verbatim, 5P-P2-MON60.NPL)
IREAHIST:    % FUNCTION=065: READ HISTOGRAM
       IF RTREF><5HRTP THEN EHNRESERVED; GO FAR ERET FI    % ERROR WHEN HISTOGRAM NOT RESERVED BY CALLER
       T:=5P1; A:="5HIDATA"=:D; X:=200; A:=OLDPAGE         % COPY HISTOGRAM DATA TO USER FROM "5HIDATA"
       K:=1; CALL MOVUS                                    %   SIZE EQUALS 2 WORDS PER CHANNEL (=64)
       5P1+200=:X; AD:=5HIOUTSIDE; CALL STDS0              % COPY SAMPLING OF 'OUSIDE CHANNELS' SEPARATELY
       GO FAR 5OKRET; *)FILL
