% NPL SOURCE REFERENCE - MON 60B 110B - IWPHSG write physical segment (verbatim, 5P-P2-MON60.NPL)
IWPHSG:      % FUNCTION=110: WRITE INTO A PHYSICAL SEGMENT
       AD:=5DD3
       IF A><0 OR D>>4000 THEN              % 4000B BYTES ARE MAX TO WRITE
          EBIGBUFF; GO FAR ERET
       FI
       T:=5D32; A:=5P4; CALL FRUSMOV        % COPY FROM USER TO MON60 BUFFER
       GO FAR 5NOPAR; *)FILL
