% NPL SOURCE REFERENCE - MON 60B 064B - ISTOHIST stop histogram (verbatim, 5P-P2-MON60.NPL)
ISTOHIST:    % FUNCTION=064: STOP HISTOGRAM
       IF RTREF><5HRTP THEN EHNRESERVED; GO FAR ERET FI    % ERROR WHEN HISTOGRAM NOT RESERVED BY CALLER
       IF 5HIFLAG=1 THEN CALL RLHILOG FI; 0=:5HRTP         % IS HISTOGRAM STARTED?
       GO FAR 5OKRET; *)FILL
