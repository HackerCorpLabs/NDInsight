% NPL SOURCE REFERENCE - MON 60B 066B - IRELHIST release histogram (verbatim, 5P-P2-MON60.NPL)
IRELHIST:    % FUNCTION=066: STOP AND RELEASE HISTOGRAM
       IF RTREF><5HRTP THEN EHNRESERVED; GO FAR ERET FI    % ERROR WHEN HISTOGRAM NOT RESERVED BY CALLER
       IF 5HIFLAG><0 THEN CALL RLHILOG FI; 0=:5HRTP
       GO FAR 5OKRET; *)FILL
