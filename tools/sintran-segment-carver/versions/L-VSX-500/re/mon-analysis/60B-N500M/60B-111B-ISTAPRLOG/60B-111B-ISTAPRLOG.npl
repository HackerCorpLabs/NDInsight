% NPL SOURCE REFERENCE - MON 60B 111B - ISTAPRLOG start process-log-one (verbatim, 5P-P2-MON60.NPL)
ISTAPRLOG:   % FUNCTION=111: START PROCESS LOG ONE
       IF 5HRTP><0 AND A><RTREF THEN ELOGINUSE; GO FAR ERET FI % LOGGING FACILITY RESERVED BY ANOTHER?
       IF 5HIFLAG><0 AND A><2 THEN ELOGINUSE; GO FAR ERET FI   % ANOTHER LOGGING FUCTION ALREADY DEFINED BY CALLER
       AD:=5DD1; IF A><0 OR D>>MX5PROCS GO FAR EEILPAR         % LEGAL PROC.NO. TO LOG?
       A:=D=:5LOGPROC; RTREF=:5HRTP                            % SPECIFY PROC.NO. TO LOG, WHO IS LOGGING AND ON WHICH CPU
       2=:5HIFLAG; X:="5HIDATA"                                % MARK THAT LOGGING IS STARTED
       DO WHILE X<<="5HIOUTSIDE"+1; 0=:X.S0; X+1; OD           % CLEAR HISTOGRAM SAMPLING BUFFER
       GO FAR 5OKRET; *)FILL
