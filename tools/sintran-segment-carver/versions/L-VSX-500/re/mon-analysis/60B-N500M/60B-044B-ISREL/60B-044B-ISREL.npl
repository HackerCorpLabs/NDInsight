% NPL SOURCE REFERENCE - MON 60B 044B - ISREL release special use (verbatim, 5P-P2-MON60.NPL)
ISREL:       % FUNCTION=044: RELEASE ND-500 CPU/SYSTEM FROM SPECIAL USE
       IF CCPUDF.SPREF=RTREF THEN CALL RELCPU FI             % RESERVED FOR SPECIAL USE BY THE CALLER?
       IF NSPREF=RTREF THEN 0=:NSPREF FI
       GO FAR 5OKRET; *)FILL
