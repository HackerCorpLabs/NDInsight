% NPL SOURCE REFERENCE - MON 60B 143B - IMO5RT activate program in ND-500 or ND-100 (verbatim, 5P-P2-MON60.NPL)
IMO5RT:      % FUNCTION=143: ACTIVATE PROGRAM EITHER IN ND-500 OR IN ND-100
        AD:=5DD1; IF A><0 GO FAR EEILPAR         % AD=RT-DESCR ADDR
        IF D=0 THEN T:=RTREF=:D FI; AD=:5DD1     % RT-DESCR=0 MEANS CALLING PROGR
        X:=D; CALL GOODRT; GO FAR EEILPAR    % LEGAL RT-DESCR ADDR.?
        *IOF
        5DD1; CALL FSEMA; GO FAR IIM5RT          % YES, HAS IT RESERVED A ND-500 PROC.?
        CALL 5PRACTIVATE; 0/\0                   % YES, ACTIVATE ND-500 PROC.
        GO FAR IIM5RT; *)FILL
