% NPL SOURCE REFERENCE - MON 60B 115B - ISTLAPR start process-log-all (verbatim, 5P-P2-MON60.NPL)
ISTLAPR:     % FUNCTION=115: START PROCESS-LOG-ALL.
       IF 5HRTP><0 AND A><RTREF THEN ELOGINUSE; GO FAR ERET FI % LOGGING FACILITY RESERVED BY ANOTHER PROC?
       IF 5HIFLAG><0 AND A><3 GO FAR ILLFUNC      % NO, ALREADY USED BY THE CALLER FOR OTHER LOGGING FUNC.?
       RTREF=:5HRTP                               % NO, SPECIFY PROC. USING LOGGING FACILITY AN ON WHICH CPU
       X:="5HIDATA"
       DO WHILE X<<="5HIOUTSIDE"+1; 0=:X.S0; X+1; OD       % YES, CLEAR LOGGING-DATA-BUFFER
       3=:5HIFLAG                                          % MARK THAT PROCESS-LOG-ALL IS STARTED
       GO FAR 5OKRET; *)FILL
