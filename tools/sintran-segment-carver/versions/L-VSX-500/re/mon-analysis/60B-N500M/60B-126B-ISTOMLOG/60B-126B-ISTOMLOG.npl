% NPL SOURCE REFERENCE - MON 60B 126B - ISTOMLOG stop moncall log (verbatim, 5P-P2-MON60.NPL)
ISTOMLOG:    % FUNCTION=126: STOP AND RELEASE MONCALL LOG
       IF 5MLOG><RTREF THEN ELOGNRESERVED; GO FAR ERET FI  % MONCALL LOG RESERVED BY THE CALLER?
       0=:5MLOG=:5MLOPROC; GO FAR 5OKRET; *)FILL            % STOP AND RELEASE MONCALL LOG.
