% NPL SOURCE REFERENCE - MON 60B 103B - IRSYSP read system variables (verbatim, 5P-P2-MON60.NPL)
IRSYSP:      % FUNCTION=103: READ SYSTEM VARIABLES
       "N500DF+SYSPAR"=:D; T:=5P1; X:=16
       A:=OLDPAGE; K:=1; CALL MOVUS              % COPY SYSTEM PARAMETERS TO USER
       GO FAR 5OKRET; *)FILL
