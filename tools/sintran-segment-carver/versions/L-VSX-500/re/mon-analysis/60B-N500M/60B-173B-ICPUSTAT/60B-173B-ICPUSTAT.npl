% NPL SOURCE REFERENCE - MON 60B 173B - ICPUSTAT set CPU status (verbatim, 5P-P2-MON60.NPL)
ICPUSTAT:    % FUNCTION=173: SET CPU STATUS
       IF 5D11><0 GO FAR EEILPAR
       IF 5D12-1>>NCPU-1 GO FAR EEILPAR
       IF 5D41><0 OR 5D42>>3 GO FAR EEILPAR
       5D12-1*5CPUDFSZ+"S5CPUDF"+"CPUAVAILABLE"=:X
       IF 5D22><0 THEN
          T:=5IDPIT; CALL GET1L; CALL ERRFATAL; A=:T
          5D42; AD SHZ -1; *BLDA 170 DD
          IF A=0 THEN *5NOTP@3 BSTA DT ELSE *5EXCL@3 BSTA DT FI
          T=:A:=5IDPIT; CALL PUT1L; CALL ERRFATAL
          "A5PIT"=:D; CALL DALTON                      % SET 5PIT AS ALT.PIT
          5IDPIT=:IP1; "PIP"; *MON 2WSEG
          CALL ALTOFF
       FI
       IF 5D32><0 THEN
          T:=5SDPIT; CALL GET1L; CALL ERRFATAL; A=:T
          5D42; AD SHZ -1; *BLDA 170 DD
          IF A=0 THEN *5NOTP@3 BSTA DT ELSE *5EXCL@3 BSTA DT FI
          T=:A:=5SDPIT; CALL PUT1L; CALL ERRFATAL
          "A5PIT"=:D; CALL DALTON                      % SET 5PIT AS ALT.PIT
          5SDPIT=:IP1; "PIP"; *MON 2WSEG
          CALL ALTOFF
       FI
       GO FAR 5OKRET; *)FILL
