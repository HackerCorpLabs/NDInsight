#!/bin/sh
# Reject any commit message that mentions Claude / the AI assistant.
#
# Why this exists: across 46 recorded sessions this rule was broken 17 times
# despite being stated in CLAUDE.md. A rule that gets broken that often is not
# an instruction problem, it is a missing check. So now it is a check.
#
# Installed by scripts/install-git-hooks.ps1, which points core.hooksPath at
# scripts/git-hooks so the hooks are version controlled instead of living
# untracked in .git/hooks.

msg_file="$1"
msg=$(cat "$msg_file")

# Case-insensitive. Covers the message body and any trailer.
if printf '%s' "$msg" | grep -qiE 'claude|anthropic|co-authored-by:[[:space:]]*claude|generated with \[claude'; then
    echo "-----------------------------------------------------------"
    echo "COMMIT REJECTED: the message mentions Claude / Anthropic."
    echo ""
    echo "Offending line(s):"
    printf '%s' "$msg" | grep -inE 'claude|anthropic' | sed 's/^/    /'
    echo ""
    echo "Rule (CLAUDE.md): never mention Claude in commit messages."
    echo "Edit the message and commit again."
    echo "-----------------------------------------------------------"
    exit 1
fi

exit 0
