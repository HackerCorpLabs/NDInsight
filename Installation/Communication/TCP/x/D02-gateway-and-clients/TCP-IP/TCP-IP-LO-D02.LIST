PSSD=SSTAR-1
% ---------    UPDATE SYSTEM SERVER TABLE INDEX 7B -----
PSSD/106660  ^+16/123567   SGF3;100002
% ---------    ADD SERVER NAME ON COMMAND SEGM.   -------
SGF3/000000  'TCPP'

%--------------------------------------------------------
)KILL PSSD+
)KILL SGF3; SGF3=*; SGF3:+123600  
)CLOAD S3CP
30002/123575  SGF3
)9EXIT
