@CC ====================================================================
@CC = FILE NAME: TCP-IP-LO:MODE
@CC = LOADING OF COSMOS TCP/IP GATEWAY VERSION D
@CC = TO BE RUN DURING COLD-START IN THE FILE HENT-MODE:MODE, ANYWHERE
@CC = AFTER THE 'INITIALIZE-BACKGROUND-PROGRAMS' COMMAND IS EXECUTED.
@CC ====================================================================
@CC *********************************************************
@CC * TCP-CONTROL,TELNET+TCP/IP,FTP-START,POWERFAIL-HANDLER *
@CC *********************************************************
@OPERATOR *** COSMOS TCP/IP GATEWAY IS BEING DUMPED ***
@ABORT tcpp
@ABORT ftprt
@ABORT popwr
@(TCP-IP)PO-STOP-D02 0
@SCHEDULE 503
@RT-LOADER
CLEAR-SEG TCPPS
YES
DEL-SEG-NAME TCPPS
NEW-BACK-SEGMENT TCPPS,,DM,,,,,
READ-PROGFILE (TCP-IP)tcpp-D02,TCPPS,,,,,
DECLARE-PROGRAM TCPP,,,,
END-LOAD
YES
CHANGE-RT-DESCRIPTION TCPP,30,TCPPS,,20,2,,,,,,,,
WRITE-SEGMENT TCPPS,,
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS0B0
Y
DELETE-SEGMENT-NAME TCPS0B0
NEW-SEGMENT TCPS0B0,,,,,,,,
READ-BI (TCP-IP)TCP-SER-B0-D02:BPUN,,,,
SE-LO-AD,,177777
END
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS0B1
Y
DELETE-SEGMENT-NAME TCPS0B1
NEW-SEGMENT TCPS0B1,,,,,,,,
READ-BI (TCP-IP)TCP-SER-B1-D02:BPUN,,,,
SE-LO-AD,,177777
END
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS0B2
Y
DELETE-SEGMENT-NAME TCPS0B2
NEW-SEGMENT TCPS0B2,,,,,,,,
READ-BI (TCP-IP)TCP-SER-B2-D02:BPUN,,,,
SE-LO-AD,,177777
END
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS0B3
Y
DELETE-SEGMENT-NAME TCPS0B3
NEW-SEGMENT TCPS0B3,,,,,,,,
READ-BI (TCP-IP)TCP-SER-B3-D02:BPUN,,,,
SE-LO-AD,,177777
END
CLEAR-SEGMENT FTPS0
Y
DELETE-SEGMENT-NAME FTPS0
NEW-SEGMENT FTPS0,,,,,,
READ-PROGFILE (TCP-IP)ftprt-D02,,,,,
END
DECLARE-PROGRAM ftprt,,,
CHANGE-RT-DESCRIPTION ftprt,30,FTPS0,,20,,,,,
END
CLEAR-SEG popwr
Y
NEW-SEG popwr,,,,,,
READ-PROGFILE (TCP-IP)po-pwrfail-D02:prog,,,,
END
DECL-PROG popwr,,,,,
CHANGE-RT-DESC popwr,50,popwr,,0,,,,,
END
EXIT
@cc -------------------
@cc set tcpdevice to n:
@cc  0= 0B,  1= 1B,  2= 2B,  3= 3B.
@cc -4=177774B sets tcpdevice to the lowest numbered ACTIVE eth-II !!
@cc -------------------
@cc set tcpdevice to -4:
@cc @LOOK-AT SEGMENT FTPS0
@cc 24/177774
@cc .
@MODE (TCP-IP)DEFINE-TCPP-D02:MODE,,
@MODE (TCP-IP)DEFINE-FTPRT-D02:MODE,,
