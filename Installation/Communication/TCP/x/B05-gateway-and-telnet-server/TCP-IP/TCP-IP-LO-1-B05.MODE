@CC
@CC  Load server and supervisor onto segments
@CC
@ABORT TCPS1,,,
@PRLS 2241B 1
@(TCP-)PO-STOP-B05
1
@SCHEDULE 503
@RT-LOADER
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPE1
Y
DELETE-SEGMENT-NAME TCPE1
NEW-SEGMENT TCPE1,2,,,,,
LOAD (TCP-)TCP-ERROR-1-B05:BRF,,,,
Y
WRITE-REFERENCES,,,,
END
CHANGE-RT-DESCR TCPS1,40,,,,,,
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS1B0
Y
DELETE-SEGMENT-NAME TCPS1B0
NEW-SEGMENT TCPS1B0,,,,,,,,
READ-BI (TCP-)TCP-SER-B0-B05:BPUN,,,,
SE-LO-AD,,177777
END
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS1B1
Y
DELETE-SEGMENT-NAME TCPS1B1
NEW-SEGMENT TCPS1B1,,,,,,,,
READ-BI (TCP-)TCP-SER-B1-B05:BPUN,,,,
SE-LO-AD,,177777
END
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS1B2
Y
DELETE-SEGMENT-NAME TCPS1B2
NEW-SEGMENT TCPS1B2,,,,,,,,
READ-BI (TCP-)TCP-SER-B2-B05:BPUN,,,,
SE-LO-AD,,177777
END
SET-PAGE-TABLE 2
CLEAR-SEGMENT TCPS1B3
Y
DELETE-SEGMENT-NAME TCPS1B3
NEW-SEGMENT TCPS1B3,,,,,,,,
READ-BI (TCP-)TCP-SER-B3-B05:BPUN,,,,
SE-LO-AD,,177777
END
Clear-seg POPWR
Y
New-seg POPWR,,,,,,
Read-progfile (TCP-)PO-PWRFAIL-B05:PROG,,,,
End
Decl-Prog POPWR,,,,,
Change-RT-Desc POPWR,50,POPWR,,0,,,,,
End
EXIT
@CC
@CC  Write Subnet Bits and Gateway Adress on to segment
@CC
@LOOK-AT SEGMENT TCPS1B1
150615/0
0
0
.
@CC
@CC  Change server number on supervisor segment and delete temporary file.
@CC
@LOOK-AT SEGMENT TCPE1
0/1
0
0
.
@CC
@CC Load the TELNET SERVER as 2 bank
@CC
@ABORT TNSERV
@SCHEDULE 503
@RT-LOADER
CLEAR-SEG TNSEG
YES
DEL-PROGRAM TNSERV
DEL-SEG-NAME TNSEG
NEW-BACKGROUND-SEGMENT TNSEG,2,dm,,,,,
READ-PROGFILE (TCP-)TELNET-SERV-B05:PROG,TNSEG,,,,
DECLARE-PROGRAM TNSERV,,,,
END-LOAD
YES
CHANGE-RT-DESCRIPTION TNSERV,16,TNSEG,,0,2,1,2,,,,,,
WRITE-SEGMENT TNSEG,,
EXIT
@cc
@cc  Mode file to load FTPRT who allocates a TAD and starts
@cc  the FTP server.
@cc
@Abort FTPRT
@SCHEDULE 503
@RT-loader
Clear-segment FTPS0
y
Delete-segment-name FTPS0
New-segment FTPS0,,,,,,
Read-progfile (TCP-)FTPRT-B05:PROG,,,,,
End
Declare-program FTPRT,,,
Change-RT-description FTPRT,30,FTPS0,,0,,,,,
End
Exit
