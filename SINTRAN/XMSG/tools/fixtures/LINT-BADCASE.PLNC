% A file holding exactly the faults the linter checks were written for, every
% one taken from real code that compiled and ran.
%
% RUN IT AND IT MUST REPORT 6 PROBLEMS. Fewer means a check has stopped
% working; more means a check has grown a false alarm.
%
%     python tools\planc-lint.py toolsixtures\LINT-BADCASE.PLNC
MODULE badcase

    EXPORT cmTxLen
    EXPORT cmTxLenN

    BYTES : buf(0:255)
    BYTES : nm(0:15)
    BYTES : tx(0:63)

    INTEGER : passed

    % A MISPLACED EXPORT. It reads perfectly well beside the thing it exports,
    % and PLANC answers *** ERROR - MISPLACED STATEMENT "EXPORT" - after which
    % the module still links with no undefined entries, runs, and passes its
    % own tests. Measured on D100 2026-08-27 with ten of them at once.
    EXPORT lateExp
    INTEGER : lateExp := 7

    % AN ADDRESS FORCED TO 32 BITS. An address here is a 16-bit INTEGER, so this
    % draws *** WARNING - ILLEGAL DATA-ELEMENT TO BE CONVERTED - a WARNING, so the
    % build carries on and the value gets a word of adjacent memory on top of it.
    % Measured 2026-08-27: two published conclusions had to be withdrawn because
    % that junk was STABLE across builds and read as a real measurement.
    INTEGER4 : addrHolder

    ROUTINE VOID, VOID (BYTES, INTEGER, INTEGER) : check(what, got, want)
        passed + 1 =: passed
    ENDROUTINE

    ROUTINE VOID, INTEGER (BYTES) : cmTxLen(b)
        b(1) RETURN
    ENDROUTINE

    ROUTINE VOID, VOID (BYTES) : badAddr(b)
        ADDR(b(0)) FORCE INTEGER4 =: addrHolder
    ENDROUTINE

    ROUTINE VOID, INTEGER (BYTES, INTEGER) : cmTxLenN(b, arrived)
        b(1) RETURN
    ENDROUTINE

    PROGRAM : bad
        INTEGER : len

        % FAULT 1: 512 for a 256-byte buffer, and a 300-byte read out of a
        % 64-byte source. This exact line printed "codec is good".
        cmEnc(buf, 4, nm, 5, tx, 300, 512) =: len

        % FAULT 2: a comparison handed to a routine whose parameters are INTEGER.
        check('fits', len <= 256, 1)
    ENDROUTINE

ENDMODULE
