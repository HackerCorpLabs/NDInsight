{
  // Our node on the LIVE Ethernet test network, joining the XMSG hub on 5010 alongside
  // D100 / D102 / D103 (F:\RC\RonnyTest\HDLC1/2/3).
  //
  // WHY 19998 and not 19999: 19999 is the relay node another agent's HDLC work uses. A second
  // node answering to the same number on the same segment would be the kind of fault that looks
  // like a protocol bug for a day. Ours is 19998.
  //
  // WHY Ethernet and not HDLC: the three machines are already on the hub, and the HDLC ports and
  // config are reserved. This joins the segment they are on without touching any of that.
  //
  // The hub is a BROADCAST hub - every frame reaches every member. Joining is therefore visible
  // to the machines, and every frame we send is seen by all three.

  "self": 19998,

  // Serve a Windows folder as *FA-SERVER, so a SINTRAN machine can COPY-FILE FROM us.
  // This is the proven direction: our FA server answers reads, and the file lands on the
  // machine's own pack. It is how a file authored on Windows - where the bytes are ours to
  // choose - gets onto a machine without fighting a terminal editor.
  "fileServer": { "root": "served" },


  "motd": "Windows XMSG node v0.0.1",

  "log": {
    "enabled": true,
    "level": "info",
    "file": "xmsg-runner-eth.log",
    "maxSizeMb": 2,
    "keep": 3
  },

  "nodes": [
    { "id": 19998, "alias": "windows", "reach": "local" },

    // D102 is the peer we talk to. transport=ethernet with net=tcp dials the hub, exactly as the
    // RetroCore machines do with  device add ETH 0 --net=tcp:127.0.0.1:5010
    {
      "id": 102, "alias": "d102", "reach": "neighbour",
      "transport": "ethernet",
      "ethernet": { "net": "tcp", "host": "127.0.0.1", "port": 5010 }
    },

    // On the same segment, reachable once the machines know about us.
    { "id": 100, "alias": "d100", "reach": "via", "via": [ 102 ] },
    { "id": 103, "alias": "d103", "reach": "via", "via": [ 102 ] }
  ]
}
