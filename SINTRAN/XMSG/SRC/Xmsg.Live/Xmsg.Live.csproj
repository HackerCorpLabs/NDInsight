<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NDInsight.Sintran.Xmsg.Live</RootNamespace>
    <AssemblyName>NDInsight.Sintran.Xmsg.Live</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Xmsg.Node is the portable upper half; Xmsg.Live (the replaceable link half) references it,
         never the other way round. This is the porting seam direction. -->
    <ProjectReference Include="..\Xmsg.Node\Xmsg.Node.csproj" />
    <ProjectReference Include="..\Xmsg.Protocol\Xmsg.Protocol.csproj" />
    <ProjectReference Include="..\Xmsg.Hdlc\Xmsg.Hdlc.csproj" />
    <!-- Xmsg.Ethernet is the second transport under the SAME ILink seam as Xmsg.Hdlc: EthernetLink
         is the Ethernet sibling of LapbLayerAdapter. Xmsg.Ethernet itself stays free of any
         reference to Xmsg.Node - the adapter lives here, on the replaceable live side. -->
    <ProjectReference Include="..\Xmsg.Ethernet\Xmsg.Ethernet.csproj" />
  </ItemGroup>

</Project>
