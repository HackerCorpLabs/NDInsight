<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Xmsg.Servers: the HIGH-LEVEL, swappable server layer - the named XROUT programs (*TADADM now,
    *XM-FIDO later) plus their subsystems (the TAD tty subsystem, accounts, commands). It depends
    only on the boundary contracts in Xmsg.Node.Services (IXmsgServer / IXmsgTransport) and never
    touches the XMSG envelope/sequencing. This is the layer expected to be refactored hard later,
    so it is deliberately isolated from the transport code.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NDInsight.Sintran.Xmsg.Servers</RootNamespace>
    <AssemblyName>NDInsight.Sintran.Xmsg.Servers</AssemblyName>
    <!-- Drives the default TAD MOTD banner ("Emulated TAD server version vN.N.N"). -->
    <Version>0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xmsg.Node\Xmsg.Node.csproj" />
    <!--
      The FA (remote file access) server serves a Windows folder, and the 64-byte directory record
      it has to put on the wire is the SINTRAN object entry. Xmsg.Ndfs is the ONE place that knows
      that structure (it holds the RetroFS dependency so nothing else has to), so the file server
      goes through it rather than growing its own copy of the layout.
    -->
    <ProjectReference Include="..\Xmsg.Ndfs\Xmsg.Ndfs.csproj" />
  </ItemGroup>

</Project>
