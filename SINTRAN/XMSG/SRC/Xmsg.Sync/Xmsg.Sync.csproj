<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The folder-watch sync engine: local edits out to a SINTRAN machine, compiler output back.

    Deliberately references NOTHING of the XMSG stack. The engine talks to an IFileTransport and
    never names FA, XFTRA or remote batch, because which of those actually carries a file is not
    settled - see DOC/PLAN-SYNC-DAEMON-2026-08-09.md. Keeping the seam here means the decision
    can be made late without rewriting the watching, settling and change-detection logic.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
