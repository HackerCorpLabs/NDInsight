% =========================================================================
% CHATLIB - the chat wire format, in ONE place, separately compiled.
%
% WHY THIS EXISTS, and it is not tidiness.
%
% 1. THE PROTOCOL WAS DECLARED TWICE. The client names 24 message kinds and
%    the server 35, with TWENTY in both. They agree today only because
%    somebody keeps checking; nothing makes them agree. A kind that drifts
%    does not fail loudly - an unhandled kind is SILENT, which is the worst
%    failure this product has. Declared here and IMPORTed by both, a mismatch
%    becomes a LINK error, and LIST-ENTRIES-UNDEFINED already runs in every
%    link we do.
%
% 2. IT MAKES SMALL TEST PROGRAMS POSSIBLE, which is the bigger prize. The
%    whole client is 6400 lines and takes about TWENTY MINUTES to compile, so
%    every one-line change has been tested by building the entire product and
%    driving two live machines. A program that links this library and checks
%    the codec builds in EIGHT SECONDS - measured with SPLITTEST - and needs
%    no XMSG, no server and nobody typing. See CHATTEST.PLNC.
%
% THE WIRE SHAPE, taken from the client's buildOwn and the server's
% buildFromSlot, which independently built the same thing:
%
%   byte 0            kind
%   byte 1            name length
%   bytes 2..         the name
%   next two bytes    text length, HIGH byte then LOW
%   then              the text
%
% The length is two bytes and the high one has always been zero in practice,
% because a message never approaches 256 characters. It is written and read as
% two bytes anyway - the format says two, and a reader that assumed one would
% be wrong the first time somebody sent a long line.
%
% NAMES ARE UNIQUE IN SEVEN CHARACTERS ACROSS A BRF BOUNDARY, so everything
% exported here is six or seven long and distinct within that. cmEnc, cmKind,
% cmNmLen, cmTxAt, cmTxLen.
% =========================================================================
MODULE chatlib

    EXPORT cmEnc
    EXPORT cmEncAt
    EXPORT cmKind
    EXPORT cmNmLen
    EXPORT cmTxAt
    EXPORT cmTxLen
    EXPORT cmLenN
    EXPORT cmSane

    % ---- THE MESSAGE KINDS ----------------------------------------------
    %
    % ALL TWENTY that the client and the server BOTH declared. They agreed
    % only because somebody kept checking; nothing made them agree, and an
    % unhandled kind is SILENT - the worst failure this product has. Declared
    % here and IMPORTed by both, a drift becomes a LINK error instead, and
    % LIST-ENTRIES-UNDEFINED already runs in every link.
    %
    % THE NUMBERS ARE THE WIRE AND MAY NEVER BE RENUMBERED. A machine running
    % an older build is on the other end of the trunk and will read whatever
    % it is sent. CHATTST asserts every one of these values for that reason -
    % a test that only checks a round trip would happily agree with a renumber.
    %
    % TWO NAMES CHANGED, and only because they could not cross a BRF boundary:
    % names are unique in SEVEN characters there, so kRename/kRenamed both
    % read KRENAME and kDirect/kDirected both read KDIRECT. The SECOND of each
    % pair was renamed - kRenamed became kRenOk, kDirected became kDirGot -
    % which is two renames rather than four.
    EXPORT kJoin
    EXPORT kWelcome
    EXPORT kReject
    EXPORT kSay
    EXPORT kSaid
    EXPORT kLeave
    EXPORT kJoined
    EXPORT kLeft
    EXPORT kRename
    EXPORT kRenOk
    EXPORT kWho
    EXPORT kMap
    EXPORT kRooms
    EXPORT kTopic
    EXPORT kAllWho
    EXPORT kHist
    EXPORT kDirect
    EXPORT kDirGot
    EXPORT kDirSent
    EXPORT kDirBad

    INTEGER : kJoin     := 1     % a client asking to come in
    INTEGER : kWelcome  := 2     % you are in, and this is your name
    INTEGER : kReject   := 3     % you are not, and this is why
    INTEGER : kSay      := 4     % a client speaking
    INTEGER : kSaid     := 5     % the room being told, SPEAKER INCLUDED
    INTEGER : kLeave    := 6     % a client going
    INTEGER : kJoined   := 7     % somebody arrived - everyone EXCEPT them
    INTEGER : kLeft     := 8     % somebody went - everyone EXCEPT them
    INTEGER : kRename   := 9     % change my nickname
    INTEGER : kRenOk    := 10    % it changed - everyone, ASKER INCLUDED
    INTEGER : kWho      := 11    % who is in this room
    INTEGER : kMap      := 12    % the machines and their trunks
    INTEGER : kRooms    := 13    % what rooms exist
    INTEGER : kTopic    := 14    % the room topic, asked or set
    INTEGER : kAllWho   := 15    % everybody, every room
    INTEGER : kHist     := 16    % a replayed line, MARKED as history
    INTEGER : kDirect   := 17    % a private message going out
    INTEGER : kDirGot   := 18    % a private message arriving
    INTEGER : kDirSent  := 19    % it reached them
    INTEGER : kDirBad   := 20    % it did not, and this is why

    % ---- ENCODE ---------------------------------------------------------
    %
    % Answers the total length written into buf.
    %
    % THE THREE ARRAYS MUST BE THREE DIFFERENT ARRAYS. Passing two subarrays
    % of ONE array to a single routine corrupts both, compiles clean and has
    % cost this project a day - so buf, name and text are separate by
    % contract. A caller that wants to encode out of one buffer must copy
    % first.
    %
    % CLAMPED against the caller's own buffer size, because PLANC checks no
    % array bound and a length that arrived from a wire is not to be trusted.
    ROUTINE VOID, INTEGER (BYTES, INTEGER, BYTES, INTEGER, BYTES, INTEGER, &
            INTEGER) : cmEnc(buf, kind, name, nameLen, text, textLen, bufMax)
        INTEGER : i
        INTEGER : at
        INTEGER : nl
        INTEGER : tl

        nameLen =: nl
        IF nl < 0 THEN
            0 =: nl
        ENDIF
        IF nl > 255 THEN
            255 =: nl
        ENDIF

        % THE NAME MUST FIT THE BUFFER TOO, and for a long time it did not.
        %
        % The clamp below reduced only the TEXT. With a 255-byte name and a
        % 256-byte buffer the text clamped to nothing, and then the name loop
        % wrote buf(2)..buf(256) and the two length bytes landed at buf(257)
        % and buf(258) - THREE BYTES PAST THE END of a 256-byte array, in
        % silence, because PLANC checks no array bound.
        %
        % It was never reachable from the wire: the client sends its own
        % nickname and the server drops any join with a name longer than 16.
        % But that made the safety a property of the CALLERS, and a library
        % whose guarantee lives in its callers is not providing one. It is
        % enforced here now, so no future caller can reintroduce it.
        %
        % A name needs room for the 2-byte header and the 2-byte text length,
        % so the most that can ever fit is bufMax - 4.
        IF nl > bufMax - 4 THEN
            bufMax - 4 =: nl
            IF nl < 0 THEN
                0 =: nl
            ENDIF
        ENDIF

        textLen =: tl
        IF tl < 0 THEN
            0 =: tl
        ENDIF

        % Everything must fit: 2 for kind and name length, the name, 2 for the
        % text length, then the text.
        IF 4 + nl + tl > bufMax THEN
            bufMax - 4 - nl =: tl
            IF tl < 0 THEN
                0 =: tl
            ENDIF
        ENDIF

        kind =: buf(0)
        nl =: buf(1)
        2 =: at

        % SUBSCRIPT FROM ZERO. A PLANC string literal starts at index 0, and
        % writing name(i) inside a 1:n loop skips the first character and reads
        % one byte past the end. That is exactly how a nickname went out as
        % ONNY instead of RONNY, with nothing reporting it.
        IF nl > 0 THEN
            FOR i IN 1:nl DO
                name(i - 1) =: buf(at)
                at + 1 =: at
            ENDFOR
        ENDIF

        tl / 256 =: buf(at)
        tl MOD 256 =: buf(at + 1)
        at + 2 =: at

        IF tl > 0 THEN
            FOR i IN 1:tl DO
                text(i - 1) =: buf(at)
                at + 1 =: at
            ENDFOR
        ENDIF

        at RETURN
    ENDROUTINE

    % ---- ENCODE, WITH THE TEXT AT AN OFFSET -----------------------------
    %
    % The same message, but the text is read from `src` starting at `srcAt`
    % rather than from the beginning of an array.
    %
    % WHY THIS EXISTS RATHER THAN A SUBARRAY. The server's text sits inside its
    % receive buffer at an offset, so the obvious call would be
    % cmEnc(..., inBuf(textAt : textAt + textLength - 1), ...). That is a
    % subarray with BOTH bounds computed, and this project has one measured
    % case of exactly that form compiling clean, running, and WRITING NOTHING
    % AT ALL - see the note on drawBar in CHAT.PLNC. Until that is understood,
    % the form is avoided rather than trusted.
    %
    % The alternative was copying the text into a flat buffer first, which is
    % more work per message and more code than the hand-written encoder it
    % would replace. An offset costs nothing.
    %
    % src, name and buf must still be THREE DIFFERENT ARRAYS.
    ROUTINE VOID, INTEGER (BYTES, INTEGER, BYTES, INTEGER, BYTES, INTEGER, &
            INTEGER, INTEGER) : &
            cmEncAt(buf, kind, name, nameLen, src, srcAt, srcLen, bufMax)
        INTEGER : i
        INTEGER : at
        INTEGER : nl
        INTEGER : tl

        nameLen =: nl
        IF nl < 0 THEN
            0 =: nl
        ENDIF
        IF nl > 255 THEN
            255 =: nl
        ENDIF

        % SAME CLAMP AS cmEnc, and it was missing here for the same reason.
        % See the long note there.
        IF nl > bufMax - 4 THEN
            bufMax - 4 =: nl
            IF nl < 0 THEN
                0 =: nl
            ENDIF
        ENDIF

        srcLen =: tl
        IF tl < 0 THEN
            0 =: tl
        ENDIF
        IF 4 + nl + tl > bufMax THEN
            bufMax - 4 - nl =: tl
            IF tl < 0 THEN
                0 =: tl
            ENDIF
        ENDIF

        kind =: buf(0)
        nl =: buf(1)
        2 =: at

        IF nl > 0 THEN
            FOR i IN 1:nl DO
                name(i - 1) =: buf(at)
                at + 1 =: at
            ENDFOR
        ENDIF

        tl / 256 =: buf(at)
        tl MOD 256 =: buf(at + 1)
        at + 2 =: at

        % THE ONLY DIFFERENCE FROM cmEnc: the text is read from srcAt, and the
        % source subscripts from srcAt + i - 1 rather than from i - 1.
        IF tl > 0 THEN
            FOR i IN 1:tl DO
                src(srcAt + i - 1) =: buf(at)
                at + 1 =: at
            ENDFOR
        ENDIF

        at RETURN
    ENDROUTINE

    % ---- DECODE ---------------------------------------------------------
    %
    % Four small readers rather than one routine handing back a record: PLANC
    % has no multiple return, and a record would have to be declared in both
    % programs - which is the duplication this library exists to remove.

    ROUTINE VOID, INTEGER (BYTES) : cmKind(buf)
        buf(0) RETURN
    ENDROUTINE

    ROUTINE VOID, INTEGER (BYTES) : cmNmLen(buf)
        buf(1) RETURN
    ENDROUTINE

    % Where the text starts. The name length decides it, so a corrupt length
    % moves the text - which is why every caller clamps before using this.
    ROUTINE VOID, INTEGER (BYTES) : cmTxAt(buf)
        buf(1) + 4 RETURN
    ENDROUTINE

    % HIGH BYTE TIMES 256 PLUS LOW. Reading only the low byte would work for
    % every message this product has ever sent and would be wrong for the
    % first one that did not.
    %
    % IT READS TWO BYTES THE CALLER MAY NOT HAVE. The pair sits at
    % buf(1) + 2, and buf(1) is ONE BYTE off a wire - it can say 255, which
    % points at buf(257) in a 256-byte buffer. The callers' guard
    % (2 + nameLength + 1 > readLength) permits nameLength + 3 = readLength, so
    % a 256-byte message with a 253-byte name still reads one past the end.
    % Narrow, and a READ rather than a write, but it is exactly the kind of
    % thing that is impossible to see in PLANC.
    %
    % cmLenN is the safe form: it is told how many bytes ARRIVED and answers
    % -1 if the length field is not wholly inside them. cmTxLen is kept as it
    % was so no existing caller changes behaviour without being edited.
    ROUTINE VOID, INTEGER (BYTES) : cmTxLen(buf)
        INTEGER : at
        buf(1) + 2 =: at
        buf(at) * 256 + buf(at + 1) RETURN
    ENDROUTINE

    % The same reading, bounded by what actually arrived.
    %
    % Answers -1 when the message is too short to hold the field, which is a
    % value no real length can take - so a caller that ignores it gets an
    % obviously wrong answer rather than a plausible one built out of whatever
    % the previous, longer message left in the buffer.
    ROUTINE VOID, INTEGER (BYTES, INTEGER) : cmLenN(buf, arrived)
        INTEGER : at

        % Two bytes for kind and name length must be there before buf(1) means
        % anything at all. Nothing in either program checked even this.
        IF arrived < 2 THEN
            -1 RETURN
        ENDIF

        buf(1) + 2 =: at

        % Both bytes of the pair must be inside the message: the last one is at
        % at + 1, so the message needs at + 2 bytes.
        IF at + 2 > arrived THEN
            -1 RETURN
        ENDIF

        buf(at) * 256 + buf(at + 1) RETURN
    ENDROUTINE

    % Is this buffer a message at all? Answers FALSE for anything too short to
    % hold the fixed part of a header, or whose name and length fields do not
    % fit inside what arrived.
    %
    % WHY IT EXISTS: neither program checked that TWO bytes had arrived before
    % reading buf(0) and buf(1). A zero-length or one-byte delivery decoded
    % stale bytes left by the previous message and acted on them.
    ROUTINE VOID, BOOLEAN (BYTES, INTEGER) : cmSane(buf, arrived)
        IF arrived < 4 THEN
            FALSE RETURN
        ENDIF
        IF buf(1) + 4 > arrived THEN
            FALSE RETURN
        ENDIF
        TRUE RETURN
    ENDROUTINE

ENDMODULE
