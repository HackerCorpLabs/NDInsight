% =========================================================================
% CHATTEST - checks CHATLIB's codec, and prints PASS or FAIL for each case.
%
% THIS IS WHAT THE LIBRARY IS FOR. The client is 6400 lines and takes about
% twenty minutes to compile, so until now every change to the wire format was
% tested by building the whole product and driving two live machines. This
% program links CHATLIB, builds in seconds, needs no XMSG, no server and
% nobody typing - and it fails LOUDLY, on screen, with the numbers.
%
% HOW TO READ IT: every line starts PASS or FAIL, and the last line is a
% count. A single FAIL means the codec is wrong; do not go near a build of the
% real product until this is clean.
%
% ADDING A CASE is one call to `check`. Keep them small and keep the expected
% value a LITERAL - a test that computes its expectation the same way the code
% does will agree with a bug.
% =========================================================================
% The same address type CHATLIB declares - see the note there. An address on this
% machine is a 16-bit INTEGER; forcing ADDR to anything 32-bit draws
% *** WARNING - ILLEGAL DATA-ELEMENT TO BE CONVERTED, and that warning is what
% invalidated the first TWO versions of the ADDR probe below.
TYPE xrAddr = INTEGER

MODULE chattest

    IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER, BYTES, INTEGER, BYTES, &
            INTEGER, INTEGER) : cmEnc)
    IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER, BYTES, INTEGER, BYTES, &
            INTEGER, INTEGER, INTEGER) : cmEncAt)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmKind)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmNmLen)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmTxAt)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmTxLen)
    IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER) : cmLenN)
    IMPORT (ROUTINE VOID, BOOLEAN (BYTES, INTEGER) : cmSane)

    % The relay header - the most intricate framing in the product, and until
    % now the only one with no test at all.
    IMPORT (ROUTINE VOID, INTEGER (INTEGER) : trHLen)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : hsSec)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : hsMin)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : hsHour)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : hsDay)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : hsMon)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : hsYear)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : trOrig)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : trHops)
    IMPORT (ROUTINE VOID, INTEGER (BYTES) : trId)
    IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER, INTEGER) : trStrip)
    IMPORT (ROUTINE VOID, INTEGER (INTEGER, BYTES) : xrClamp)
    IMPORT (ROUTINE VOID, xrAddr (BYTES) : xrAddrOf)
    IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER, INTEGER, INTEGER, INTEGER, &
            BYTES, INTEGER, BYTES, INTEGER, INTEGER, INTEGER) : trEnc)
    IMPORT (INTEGER : kTrkSaid)
    IMPORT (INTEGER : kTrkRly)
    IMPORT (INTEGER : kTrkRlId)
    IMPORT (INTEGER : kTrkDir)
    IMPORT (INTEGER : kTrkDBad)
    IMPORT (INTEGER : maxHops)
    IMPORT (INTEGER : kJoin)
    IMPORT (INTEGER : kWelcome)
    IMPORT (INTEGER : kReject)
    IMPORT (INTEGER : kSay)
    IMPORT (INTEGER : kSaid)
    IMPORT (INTEGER : kLeave)
    IMPORT (INTEGER : kJoined)
    IMPORT (INTEGER : kLeft)
    IMPORT (INTEGER : kRename)
    IMPORT (INTEGER : kRenOk)
    IMPORT (INTEGER : kWho)
    IMPORT (INTEGER : kMap)
    IMPORT (INTEGER : kRooms)
    IMPORT (INTEGER : kTopic)
    IMPORT (INTEGER : kAllWho)
    IMPORT (INTEGER : kHist)
    IMPORT (INTEGER : kDirect)
    IMPORT (INTEGER : kDirGot)
    IMPORT (INTEGER : kDirSent)
    IMPORT (INTEGER : kDirBad)

    INTEGER ARRAY : stack(0:1000)

    % The buffer under test, and the two inputs. THREE SEPARATE ARRAYS - see
    % the note on cmEnc about passing two subarrays of one array.
    BYTES : buf(0:255)
    BYTES : nm(0:15)
    BYTES : tx(0:63)

    % A buffer and a source that can genuinely hold a 300-byte text, so the
    % two-byte-length case can be proved WITHOUT writing past the end of
    % anything. See the note at that test for what it used to do instead.
    BYTES : bigBuf(0:511)
    BYTES : bigTx(0:319)

    % A name long enough to overflow a 256-byte buffer on its own. cmEnc clamps
    % the TEXT against the buffer but did not clamp the NAME, so a 255-byte name
    % wrote three bytes past a 256-byte buffer while the text was clamped to
    % nothing. Nothing in this file ever passed a name longer than five bytes.
    BYTES : hugeNm(0:255)
    xrAddr : addrA, addrB       % for the ADDR-of-a-parameter checks

    INTEGER : passed
    INTEGER : failed

    % One check. Prints the name, then PASS, or FAIL with both numbers - a
    % failure that does not say what it got is a failure you have to reproduce
    % by hand.
    ROUTINE VOID, VOID (BYTES, INTEGER, INTEGER) : check(what, got, want)
        IF got = want THEN
            passed + 1 =: passed
            OUTPUT(1, 'AL', 'PASS ')
            OUTPUT(1, 'AL', what)
            OUTPUT(1, 'AL', '$')
            RETURN
        ENDIF

        failed + 1 =: failed
        OUTPUT(1, 'AL', 'FAIL ')
        OUTPUT(1, 'AL', what)
        OUTPUT(1, 'AL', '  got ')
        OUTPUT(1, 'I', got)
        OUTPUT(1, 'AL', '  want ')
        OUTPUT(1, 'I', want)
        OUTPUT(1, 'AL', '$')
    ENDROUTINE

    % The same check for a BOOLEAN answer. PLANC will not pass a BOOLEAN where
    % an INTEGER is declared, so cmSane needs its own - and printing "got 1
    % want 0" would be less use than TRUE and FALSE anyway.
    ROUTINE VOID, VOID (BYTES, BOOLEAN, BOOLEAN) : checkB(what, got, want)
        IF got = want THEN
            passed + 1 =: passed
            OUTPUT(1, 'AL', 'PASS ')
            OUTPUT(1, 'AL', what)
            OUTPUT(1, 'AL', '$')
            RETURN
        ENDIF

        failed + 1 =: failed
        OUTPUT(1, 'AL', 'FAIL ')
        OUTPUT(1, 'AL', what)
        IF got THEN
            OUTPUT(1, 'AL', '  got TRUE want FALSE')
        ELSE
            OUTPUT(1, 'AL', '  got FALSE want TRUE')
        ENDIF
        OUTPUT(1, 'AL', '$')
    ENDROUTINE

    % ---- CAN A ROUTINE ASK ITS ARRAY PARAMETER HOW BIG IT IS? --------------
    %
    % THIS DECIDES THE SHAPE OF THE WHOLE LIBRARY, so it is asked of the machine
    % rather than assumed.
    %
    % cmEnc is told a buffer size by its caller and has to believe it. A caller
    % that passes the wrong number gets a silent overflow, because PLANC checks
    % no array bound - and one of the tests in this very file did exactly that,
    % claiming 512 for a 256-byte buffer.
    %
    % Three BYTES declared FROM A LITERAL, which is a different shape from an
    % array with explicit bounds. 'HELP' is 4, 'DROP-MEMBER' is 11 and
    % 'RESTART-TRUNK' is 13 - all three are real CHAT-MON keywords, so if the
    % bounds of this shape ever change these tests fail before a menu does.
    BYTES : litShort := 'HELP'
    BYTES : litVerb  := 'DROP-MEMBER'
    BYTES : litLong  := 'RESTART-TRUNK'

    % If MAXINDEX works on a PARAMETER, the library can ask each array its own
    % size and stop trusting the caller at all. ND-60.117.5 3.17 says MAXINDEX
    % returns the DECLARED UPPER BOUND, and page 249 says it is NOT available on
    % array parameters in a STANDARD routine - which implies it IS in an ordinary
    % one. "Implies" is not a measurement, so these three checks measure it.
    ROUTINE VOID, INTEGER (BYTES) : askSize(a)
        MAXINDEX(a, 1) RETURN
    ENDROUTINE

    PROGRAM : ctmain
        INTEGER : i
        INTEGER : len
        INTEGER : at

        INISTACK stack

        0 =: passed
        0 =: failed

        OUTPUT(1, 'AL', 'CHATLIB codec checks$')

        % ---- a plain room line ------------------------------------------
        'RONNY' =: nm
        'hello' =: tx
        cmEnc(buf, kSay, nm, 5, tx, 5, 256) =: len

        % 2 header + 5 name + 2 length + 5 text
        check('length of a 5+5 message', len, 14)
        check('kind survives           ', cmKind(buf), kSay)
        check('name length survives    ', cmNmLen(buf), 5)
        check('text length survives    ', cmTxLen(buf), 5)
        check('text starts after name  ', cmTxAt(buf), 9)

        % THE BYTES THEMSELVES, not just the accessors. An encoder and a
        % decoder that are wrong the same way agree with each other.
        check('byte 0 is the kind      ', buf(0), kSay)
        check('byte 1 is the name len  ', buf(1), 5)
        check('name first byte is R    ', buf(2), 82)
        check('name last byte is Y     ', buf(6), 89)
        check('length high byte is 0   ', buf(7), 0)
        check('length low byte is 5    ', buf(8), 5)
        check('text first byte is h    ', buf(9), 104)

        % ---- an empty text ----------------------------------------------
        'BOB' =: nm
        cmEnc(buf, kSay, nm, 3, tx, 0, 256) =: len
        check('empty text length       ', len, 7)
        check('empty text reads 0      ', cmTxLen(buf), 0)
        check('empty text name intact  ', cmNmLen(buf), 3)

        % ---- an empty name ----------------------------------------------
        'hi' =: tx
        cmEnc(buf, kDirect, nm, 0, tx, 2, 256) =: len
        check('no name, length         ', len, 6)
        check('no name, kind           ', cmKind(buf), kDirect)
        check('no name, text length    ', cmTxLen(buf), 2)
        check('no name, text at 4      ', cmTxAt(buf), 4)

        % ---- THE CLAMP. A text longer than the buffer must be CUT, not
        %      written past the end. PLANC checks no bound, so without the
        %      clamp this would quietly corrupt whatever follows buf.
        'RONNY' =: nm
        cmEnc(buf, kSay, nm, 5, tx, 300, 20) =: len
        check('clamped to buffer       ', len, 20)
        check('clamped text length     ', cmTxLen(buf), 11)

        % ---- a two-byte length is really two bytes -----------------------
        % 300 does not fit in one byte. If cmTxLen only read the low byte it
        % would answer 44 here, which is the whole point of the case.
        %
        % THIS TEST USED TO CORRUPT MEMORY AND PASS. It read
        %
        %     cmEnc(buf, kSay, nm, 5, tx, 300, 512)
        %
        % telling cmEnc the buffer was 512 bytes when buf is 256, with a
        % 300-byte text. Nothing clamped, so it wrote buf(9)..buf(308) - FIFTY
        % THREE BYTES past the end - while reading tx(0)..tx(299), which is 236
        % past the end of a 64-byte array. The three checks below still passed,
        % because buf(7) and buf(8) are in bounds, and the run printed
        % "codec is good".
        %
        % That is the exact trap this file exists to catch, sitting inside the
        % file itself: PLANC checks no array bound, so an overflow is invisible
        % unless a test is written to see it.
        %
        % The case is kept because the two-byte length still needs proving. It
        % now uses a buffer that can HOLD 300 bytes and a source that HAS 300
        % bytes, so the numbers below mean what they say.
        FOR i IN 0:299 DO
            65 + (i MOD 26) =: bigTx(i)
        ENDFOR
        cmEnc(bigBuf, kSay, nm, 5, bigTx, 300, 512) =: len
        check('long text total length  ', len, 309)
        check('long text length        ', cmTxLen(bigBuf), 300)
        check('long text high byte     ', bigBuf(7), 1)
        check('long text low byte      ', bigBuf(8), 44)
        % The LAST text byte really arrived - a length that says 300 while only
        % some of it was copied would pass every check above.
        check('long text last byte     ', bigBuf(8 + 300), 65 + (299 MOD 26))

        % ---- THE OFFSET ENCODER ------------------------------------------
        %
        % cmEncAt reads the text from a POSITION inside another buffer, which
        % is what the server needs - its text arrives inside the receive buffer
        % rather than at the start of an array.
        %
        % THE OFFSET IS THE WHOLE POINT, so the test uses a NON-ZERO one. At
        % offset 0 this routine and cmEnc are indistinguishable, and a test
        % that only tried 0 would pass against a version that ignored srcAt
        % completely.
        'RONNYhello there' =: tx
        cmEnc(buf, kSay, nm, 5, tx, 5, 256) =: len
        cmEncAt(buf, kSay, nm, 5, tx, 5, 11, 256) =: at

        check('offset encoder length   ', at, 20)
        check('offset encoder kind     ', cmKind(buf), kSay)
        check('offset encoder name len ', cmNmLen(buf), 5)
        check('offset encoder text len ', cmTxLen(buf), 11)

        % The text must be what sat at offset 5, not what sat at 0. 'h' is 104
        % and 'R' is 82 - if srcAt were ignored this reads 82 and fails.
        cmTxAt(buf) =: at
        check('offset encoder skipped 5', buf(at), 104)
        check('offset encoder last byte', buf(at + 10), 101)

        % ---- DECODE A MESSAGE WE DID NOT ENCODE --------------------------
        %
        % EVERY TEST ABOVE READS BACK WHAT cmEnc WROTE, and that is a weaker
        % check than it looks: an encoder and a decoder that are wrong in the
        % same way agree with each other perfectly. These build the buffer BY
        % HAND, byte by byte, exactly as the SERVER puts one on the wire, and
        % then ask the readers what they see.
        %
        %   kind 5, name length 3, 'BOB', length 0 and 7, 'hey you'
        5 =: buf(0)
        3 =: buf(1)
        66 =: buf(2)
        79 =: buf(3)
        66 =: buf(4)
        0 =: buf(5)
        7 =: buf(6)
        104 =: buf(7)
        101 =: buf(8)
        121 =: buf(9)
        32 =: buf(10)
        121 =: buf(11)
        111 =: buf(12)
        117 =: buf(13)

        check('hand-built kind         ', cmKind(buf), 5)
        check('hand-built name length  ', cmNmLen(buf), 3)
        check('hand-built text length  ', cmTxLen(buf), 7)
        check('hand-built text starts  ', cmTxAt(buf), 7)

        % AND THE TEXT REALLY IS THERE, at the offset the reader gave. An
        % offset that is right by accident still points at the wrong byte.
        cmTxAt(buf) =: at
        check('hand-built text byte 0  ', buf(at), 104)
        check('hand-built text byte 6  ', buf(at + 6), 117)

        % A NAME OF ZERO LENGTH, hand built. The text then starts at 4, and
        % this is the case a reader that assumes a name is present gets wrong.
        9 =: buf(0)
        0 =: buf(1)
        0 =: buf(2)
        2 =: buf(3)
        104 =: buf(4)
        105 =: buf(5)
        check('hand-built empty name   ', cmNmLen(buf), 0)
        check('hand-built empty at 4   ', cmTxAt(buf), 4)
        check('hand-built empty length ', cmTxLen(buf), 2)

        % A SIXTEEN-CHARACTER NAME - the longest a nickname may be. The text
        % offset must move with it, and 4 + 16 is the first case where a
        % reader with a hard-coded offset still looks plausible.
        5 =: buf(0)
        16 =: buf(1)
        0 =: buf(18)
        1 =: buf(19)
        88 =: buf(20)
        check('hand-built long name    ', cmNmLen(buf), 16)
        check('hand-built long name at ', cmTxAt(buf), 20)
        check('hand-built long name len', cmTxLen(buf), 1)
        cmTxAt(buf) =: at
        check('hand-built long name txt', buf(at), 88)

        % ---- THE BOUNDED READERS -----------------------------------------
        %
        % cmLenN and cmSane are what a receive loop should use: they are told
        % how many bytes ARRIVED and refuse to read outside them. Every case
        % here is one that the unbounded readers answer WRONGLY but plausibly.
        'RONNY' =: nm
        'hello' =: tx
        cmEnc(buf, kSay, nm, 5, tx, 5, 256) =: len          % len is 14

        check('bounded len, full msg   ', cmLenN(buf, len), 5)
        checkB('sane, full message      ', cmSane(buf, len), TRUE)

        % One byte short of the length field: the pair sits at 7 and 8, so 8
        % bytes is not enough. The UNBOUNDED reader answers 5 here by reading a
        % byte that did not arrive.
        check('bounded len, truncated  ', cmLenN(buf, 8), -1)
        checkB('sane, truncated header  ', cmSane(buf, 8), FALSE)

        % Exactly enough for the field, and no text. A message may legally
        % carry no text, so this must be ACCEPTED, not refused.
        check('bounded len, header only', cmLenN(buf, 9), 5)
        checkB('sane, header only       ', cmSane(buf, 9), TRUE)

        % Nothing arrived at all. buf still holds the last message, so an
        % unguarded reader happily decodes it and the caller acts on a message
        % nobody sent. This is the case neither program checked.
        check('bounded len, empty      ', cmLenN(buf, 0), -1)
        checkB('sane, empty             ', cmSane(buf, 0), FALSE)
        checkB('sane, one byte          ', cmSane(buf, 1), FALSE)

        % A name length that points beyond what arrived - the corrupt-length
        % case. buf(1) says 5, so a 6-byte message cannot hold the header.
        checkB('sane, name past end     ', cmSane(buf, 6), FALSE)

        % ---- THE NAME MUST BE CLAMPED TOO --------------------------------
        %
        % cmEnc clamped the TEXT against bufMax and never the NAME. With a
        % 255-byte name and a 256-byte buffer the text clamped to nothing, and
        % then the name loop wrote buf(2)..buf(256) and the two length bytes
        % landed at buf(257) and buf(258) - THREE BYTES PAST THE END, silently.
        %
        % Not reachable from the wire today: the client sends its own nickname
        % and the server drops a join whose name is longer than 16. But that
        % safety lives in the CALLERS, which is the exact duplication this
        % library exists to remove - so it is enforced here and tested here.
        %
        % A message can never be longer than the buffer it was written into.
        % That single check is the one that would have caught the overflow.
        % The clamp has ONE right answer, so it is checked exactly rather than
        % as "small enough": a name must leave room for the 2-byte header and
        % the 2-byte length, so the most that fits a 256-byte buffer is 252,
        % and the total written is then exactly 256.
        FOR i IN 0:255 DO
            88 =: hugeNm(i)
        ENDFOR
        cmEnc(buf, kSay, hugeNm, 255, tx, 5, 256) =: len
        check('huge name clamped to 252', cmNmLen(buf), 252)
        check('huge name total is 256  ', len, 256)
        check('huge name text at 256   ', cmTxAt(buf), 256)

        % The same for the offset encoder, which had the identical hole.
        cmEncAt(buf, kSay, hugeNm, 255, tx, 0, 5, 256) =: len
        check('cmEncAt name clamped    ', cmNmLen(buf), 252)
        check('cmEncAt total is 256    ', len, 256)

        % And a name that fits exactly must NOT be clamped - a fix that just
        % refused every long name would pass the three checks above.
        cmEnc(buf, kSay, hugeNm, 16, tx, 5, 256) =: len
        check('a 16-byte name survives ', cmNmLen(buf), 16)
        % 2 header + 16 name + 2 length + 5 text ('hello', set above) = 25.
        check('16-byte name total len  ', len, 25)

        % ---- DOES MAXINDEX WORK ON A PARAMETER? --------------------------
        %
        % If all three pass, the library can bound itself and no caller can lie
        % to it about a size. If the subarray case fails, it can still bound
        % itself for whole arrays, which is how every current caller passes them.
        check('MAXINDEX on a parameter ', askSize(buf), 255)
        check('MAXINDEX sees a SMALLER ', askSize(nm), 15)
        check('MAXINDEX on a SUBARRAY  ', askSize(tx(0:9)), 9)

        % ---- AND ON A BYTES DECLARED FROM A LITERAL? ----------------------
        %
        % THIS IS THE CASE THE WHOLE PRODUCT NOW LEANS ON. On 2026-08-31 the
        % length parameter was removed from six helpers - putWord, logLine,
        % buildAdmText, cmdIs, tryCmd and showIfMatch - and 93 hand-typed
        % numbers went with it. Each now does MAXINDEX(text, 1) + 1 instead.
        %
        % Two of those, tryCmd and showIfMatch in CHAT-MON, are handed a
        % MODULE-LEVEL BYTES declared from a literal rather than a literal at
        % the call site. R115 measured MAXINDEX on array parameters and on a
        % subarray; it did NOT measure this. The bounds SHOULD be 0:len-1, so
        % MAXINDEX + 1 should be the length - but "should" is not measured, and
        % if it is wrong the symptom is a menu where a command quietly stops
        % matching, which reads as a logic bug and not as an array question.
        %
        % Three lengths on purpose: a short word, one that is not a round
        % number, and one long enough to cross a byte boundary in a way a
        % single case could not distinguish.
        check('MAXINDEX on a literal   ', askSize(litShort) + 1, 4)
        check('MAXINDEX literal, longer', askSize(litVerb) + 1, 11)
        check('MAXINDEX literal, 13 chr', askSize(litLong) + 1, 13)

        % ---- THE DECODERS AGAINST THE ARITHMETIC THEY REPLACE -------------
        %
        % WHY THIS GROUP EXISTS. The client and the server each parse the header
        % by hand, in three places between them:
        %
        %       2 + nameLength =: textAt
        %       inBuf(textAt) * 256 + inBuf(textAt + 1) =: textLength
        %       textAt + 2 =: textAt
        %
        % Replacing that with cmTxAt and cmTxLen is only safe if the library
        % computes the SAME numbers for every name length, not just for the one
        % five-character nickname the tests above happen to use. A name length is
        % a byte off a wire and can be anything from 0 to 255, so the two forms
        % are compared across the whole range here rather than at one point.
        %
        % A ZERO-LENGTH NAME IS IN THE RANGE ON PURPOSE. It is the shortest legal
        % header and the one an off-by-one lands on first.
        %
        % THE UPPER BOUND IS THE BUFFER, NOT 255. A header with name length n puts
        % its two length bytes at n+2 and n+3, so n = 255 would write THREE BYTES
        % PAST THE END of buf(0:255) - and PLANC checks no array bounds, so it
        % would corrupt whatever sits after it and still print PASS. Asked with
        % MAXINDEX rather than written as a literal, so resizing buf cannot leave
        % a stale number here. (MAXINDEX gives the DECLARED UPPER BOUND, 255.)
        MAXINDEX(buf, 1) - 3 =: at
        FOR i IN 0:at DO
            % Build a header by hand - NOT with cmEnc. An encoder and a decoder
            % that are wrong the same way agree with each other perfectly, which
            % is the whole failure this group is here to catch.
            kSaid =: buf(0)
            i =: buf(1)
            % The name bytes themselves do not matter to the arithmetic, and
            % filling 255 of them for each of 256 rounds is work for nothing.
            % What matters is the two length bytes landing where the header says.
            1 =: buf(2 + i)              % text length HIGH byte
            44 =: buf(2 + i + 1)         % text length LOW byte - so 300, over 255

            % cmTxAt must equal the hand-rolled 2 + nameLength + 2.
            IF cmTxAt(buf) >< 2 + i + 2 THEN
                check('cmTxAt matches by hand  ', cmTxAt(buf), 2 + i + 2)
            ENDIF

            % cmTxLen must equal the hand-rolled high * 256 + low. 300 is chosen
            % because a decoder that read ONLY the low byte would answer 44 and
            % pass every other test in this file - no message the product has
            % ever sent reached 256 characters.
            IF cmTxLen(buf) >< 300 THEN
                check('cmTxLen matches by hand ', cmTxLen(buf), 300)
            ENDIF
        ENDFOR

        % A FAILING ROUND REPORTS ITSELF ABOVE, one line per bad length. This
        % one line is what proves the loop RAN - a check that only speaks up on
        % failure is indistinguishable from a loop that never executed. It prints
        % the COUNT it covered, so a bound that silently shrinks is visible.
        check('header lengths agreed   ', at + 1, 253)

        % ---- THE RELAY HEADER --------------------------------------------
        %
        % Three shapes share one buffer:
        %
        %   kTrkSaid  (51)   an ordinary chat frame, no relay header
        %   kTrkRly   (52)   kind | origin high,low | hops | chat frame
        %   kTrkRlId  (53)   kind | origin high,low | hops | id high,low | frame
        %   kTrkDir   (54)   the same six as kTrkRlId
        %
        % This was parsed by hand in two places and never tested. A truncated
        % relay header read as a chat frame builds a PLAUSIBLE message out of
        % rubbish - the origin's high byte lands where the name length belongs -
        % so the short cases below matter more than the happy ones.

        check('trHLen of a plain kind  ', trHLen(kTrkSaid), 0)
        check('trHLen of a say         ', trHLen(kSay), 0)
        check('trHLen of kTrkRly       ', trHLen(kTrkRly), 4)
        check('trHLen of kTrkRlId      ', trHLen(kTrkRlId), 6)
        check('trHLen of kTrkDir       ', trHLen(kTrkDir), 6)
        % A REFUSAL COMING HOME CARRIES THE SAME SIX BYTES. Miss this and
        % trHLen answers 0, the header is read as a name length and a name,
        % and the person is shown rubbish instead of being told their
        % message was dropped - which is worse than the silence this kind
        % exists to end.
        check('trHLen of kTrkDBad      ', trHLen(kTrkDBad), 6)
        check('kTrkDBad is 55          ', kTrkDBad, 55)

        % ---- A HISTORY LINE CARRIES WHEN IT WAS SAID --------------------
        %
        % EIGHT, NOT SEVEN: trHLen counts the KIND byte too, the same way it
        % does for the relay kinds - kTrkRly carries three fields and answers
        % four. Off by one here leaves the name length one byte out and builds
        % a whole message out of rubbish.
        check('trHLen of kHist         ', trHLen(kHist), 8)

        % The ND calendar, laid out as histReplay writes it and as the golden
        % bytes in ChatMessageGoldenBytesTests pin it:
        %   1 second  2 minute  3 hour  4 day  5 month  6..7 year, HIGH first
        %
        % 27 August 1998 at 13:24:05 - the SAME instant the C# test uses, so
        % the two sides are pinned to one example rather than two that can
        % drift apart without either failing.
        kHist =: buf(0)
        5 =: buf(1)
        24 =: buf(2)
        13 =: buf(3)
        27 =: buf(4)
        8 =: buf(5)
        7 =: buf(6)
        206 =: buf(7)
        check('hsSec                   ', hsSec(buf), 5)
        check('hsMin                   ', hsMin(buf), 24)
        check('hsHour                  ', hsHour(buf), 13)
        check('hsDay                   ', hsDay(buf), 27)
        check('hsMon                   ', hsMon(buf), 8)

        % THE FULL YEAR, 1998 and not 98. 7 * 256 + 206 is 1998; reading it as
        % one byte answers 206, which looks like data and is not a year.
        check('hsYear is the FULL year ', hsYear(buf), 1998)

        % A BLOCK WRITTEN BEFORE THE TIME EXISTED SENDS ALL ZEROS, and the
        % YEAR is what says so - not the whole value. Midnight exactly is a
        % real time whose hour, minute and second are all zero, and it must
        % never be mistaken for an absent one.
        0 =: buf(1)
        0 =: buf(2)
        0 =: buf(3)
        0 =: buf(6)
        0 =: buf(7)
        check('an unrecorded year is 0 ', hsYear(buf), 0)
        check('midnight hour is still 0', hsHour(buf), 0)

        % ---- a kind 52, built BY HAND so the encoder cannot agree with a bug
        % Origin 258 is 1*256 + 2, which catches a reader that took only one
        % byte or swapped them: a low-byte-only reader answers 2, a swapped one
        % answers 513.
        kTrkRly =: buf(0)
        1 =: buf(1)
        2 =: buf(2)
        3 =: buf(3)
        % ... and from byte 4, an ordinary frame: name 'ANNA', text 'hi'
        4 =: buf(4)
        65 =: buf(5)
        78 =: buf(6)
        78 =: buf(7)
        65 =: buf(8)
        0 =: buf(9)
        2 =: buf(10)
        104 =: buf(11)
        105 =: buf(12)

        check('relay origin is 258     ', trOrig(buf), 258)
        check('relay hops is 3         ', trHops(buf), 3)

        % 13 bytes in, 3 taken off the front, so 10 out - and byte 1 must now be
        % the NAME LENGTH, which is what the rest of the decoder assumes.
        trStrip(buf, 13, kTrkRly) =: len
        check('kind 52 strips to 10    ', len, 10)
        check('after strip, kind kept  ', cmKind(buf), kTrkRly)
        check('after strip, name len 4 ', cmNmLen(buf), 4)
        check('after strip, text len 2 ', cmTxLen(buf), 2)
        check('after strip, text at 8  ', cmTxAt(buf), 8)
        check('after strip, first is A ', buf(2), 65)
        check('after strip, text is h  ', buf(8), 104)

        % ---- a kind 53, two bytes longer, id 300 to catch a one-byte reader
        kTrkRlId =: buf(0)
        1 =: buf(1)
        2 =: buf(2)
        3 =: buf(3)
        1 =: buf(4)
        44 =: buf(5)
        4 =: buf(6)
        65 =: buf(7)
        78 =: buf(8)
        78 =: buf(9)
        65 =: buf(10)
        0 =: buf(11)
        2 =: buf(12)
        104 =: buf(13)
        105 =: buf(14)

        check('relay id is 300         ', trId(buf), 300)
        check('kind 53 origin still 258', trOrig(buf), 258)
        trStrip(buf, 15, kTrkRlId) =: len
        check('kind 53 strips to 10    ', len, 10)
        check('kind 53 name len 4      ', cmNmLen(buf), 4)
        check('kind 53 text is h       ', buf(8), 104)

        % ---- THE SHORT ONES, which are the reason this exists --------------
        %
        % A message exactly the length of its own header carries no frame, and
        % sliding zero bytes would leave the OLD name length in place - so these
        % must be refused, not merely survived.
        kTrkRly =: buf(0)
        check('kind 52 at 4 is refused ', trStrip(buf, 4, kTrkRly), -1)
        check('kind 52 at 3 is refused ', trStrip(buf, 3, kTrkRly), -1)
        check('kind 52 at 5 is allowed ', trStrip(buf, 5, kTrkRly), 2)
        kTrkRlId =: buf(0)
        check('kind 53 at 6 is refused ', trStrip(buf, 6, kTrkRlId), -1)
        % SIX IS THE POINT: a message long enough for a kind 52 header can still
        % be too short for a kind 53 one, and that is the case a single shared
        % length test would have got wrong.
        check('kind 53 at 5 is refused ', trStrip(buf, 5, kTrkRlId), -1)
        check('kind 53 at 7 is allowed ', trStrip(buf, 7, kTrkRlId), 2)

        % A kind with no relay header must pass through untouched, so a receive
        % loop can call trStrip on everything without a special case.
        check('a plain kind is untouched', trStrip(buf, 14, kSay), 14)

        % ---- BUILD ONE AND TAKE IT APART AGAIN -----------------------------
        %
        % The round trip is the LAST check, not the first: an encoder and a
        % decoder that are wrong the same way agree with each other perfectly,
        % which is why every field above was asserted against a literal.
        'ANNA' =: nm
        'hello' =: tx
        trEnc(bigBuf, kTrkRlId, 258, maxHops, 300, nm, 4, tx, 0, 5, 512) =: len
        % 6 header + 1 name length + 4 name + 2 text length + 5 text = 18.
        % There is NO second kind byte in front of the body - the kind is at
        % byte 0 and is not repeated, which is what the hand-built cases above
        % prove and what a first version of trEnc got wrong.
        check('trEnc total length      ', len, 18)
        check('trEnc origin            ', trOrig(bigBuf), 258)
        check('trEnc hops              ', trHops(bigBuf), maxHops)
        check('trEnc id                ', trId(bigBuf), 300)
        check('trEnc kind              ', cmKind(bigBuf), kTrkRlId)

        trStrip(bigBuf, len, kTrkRlId) =: len
        % 18 in, 5 bytes of header taken off the front, 13 out.
        check('trEnc strips to 13      ', len, 13)
        check('trEnc name survives     ', cmNmLen(bigBuf), 4)
        check('trEnc text survives     ', cmTxLen(bigBuf), 5)
        check('trEnc name first byte A ', bigBuf(2), 65)
        check('trEnc text first byte h ', bigBuf(8), 104)

        % A kind that carries no relay header cannot be built as one.
        check('trEnc refuses a say     ', &
              trEnc(bigBuf, kSay, 258, 3, 300, nm, 4, tx, 0, 5, 512), -1)

        % ---- THE WIRE NUMBERS THEMSELVES ---------------------------------
        %
        % EVERY KIND, ASSERTED AGAINST A LITERAL. This is the half a round-trip
        % test cannot do: encoding and decoding with the same wrong number
        % agrees with itself perfectly, and a machine running an older build on
        % the far end of a trunk does not. These numbers are the WIRE and may
        % never be renumbered - if one of these fails, somebody has changed a
        % number and every other machine still expects the old one.
        check('kJoin is 1              ', kJoin, 1)
        check('kWelcome is 2           ', kWelcome, 2)
        check('kReject is 3            ', kReject, 3)
        check('kSay is 4               ', kSay, 4)
        check('kSaid is 5              ', kSaid, 5)
        check('kLeave is 6             ', kLeave, 6)
        check('kJoined is 7            ', kJoined, 7)
        check('kLeft is 8              ', kLeft, 8)
        check('kRename is 9            ', kRename, 9)
        check('kRenOk is 10            ', kRenOk, 10)
        check('kWho is 11              ', kWho, 11)
        check('kMap is 12              ', kMap, 12)
        check('kRooms is 13            ', kRooms, 13)
        check('kTopic is 14            ', kTopic, 14)
        check('kAllWho is 15           ', kAllWho, 15)
        check('kHist is 16             ', kHist, 16)
        check('kDirect is 17           ', kDirect, 17)
        check('kDirGot is 18           ', kDirGot, 18)
        check('kDirSent is 19          ', kDirSent, 19)
        check('kDirBad is 20           ', kDirBad, 20)

        % THE TRUNK NUMBERS TOO. These cross a wire between MACHINES, one of
        % which may be running an older build, so they are exactly as fixed as
        % the client ones. kTrkRly and kTrkRlId are the PLANC names for what the
        % registry calls TrunkRelay and TrunkRelayId - renamed because both read
        % KTRKREL at seven characters, with the wire numbers untouched.
        check('kTrkSaid is 51          ', kTrkSaid, 51)
        check('kTrkRly is 52           ', kTrkRly, 52)
        check('kTrkRlId is 53          ', kTrkRlId, 53)
        check('kTrkDir is 54           ', kTrkDir, 54)
        check('maxHops is 3            ', maxHops, 3)

        % ---- xrClamp: the read length that keeps XMPFREA inside the buffer --
        %
        % THIS IS THE ONE ROUTINE HERE THAT STOPS A WRITE OVERFLOW rather than
        % a wrong answer, so it is tested against FOUR DIFFERENT BUFFERS. That
        % is the whole point: if MAXINDEX did not really ask each array, every
        % one of these would answer the same and the differing sizes below
        % would fail. It is the same proof as the array-parameter probe above,
        % applied to the routine that matters most.
        check('clamp 10 into nm(16)    ', xrClamp(10, nm), 10)
        check('clamp 99 into nm(16)    ', xrClamp(99, nm), 16)
        check('clamp 99 into tx(64)    ', xrClamp(99, tx), 64)
        check('clamp 99 into buf(256)  ', xrClamp(99, buf), 99)
        check('clamp 999 into buf(256) ', xrClamp(999, buf), 256)
        check('clamp 999 into bigBuf   ', xrClamp(999, bigBuf), 512)

        % EXACTLY FULL IS ALLOWED, one past it is not. A buffer declared
        % (0:255) holds 256 bytes, so 256 is a legal read and 257 is not -
        % the off-by-one that a hand-written "IF want > inBufSize" gets right
        % only because the constant happens to say 256 and not 255.
        check('clamp 256 into buf(256) ', xrClamp(256, buf), 256)
        check('clamp 257 into buf(256) ', xrClamp(257, buf), 256)

        % THE LOW END, which neither program clamped. A returned message
        % carries an error status where the length belongs, so this field is
        % not always a length - see the comment on the routine.
        check('clamp 0 into buf        ', xrClamp(0, buf), 0)
        check('clamp -1 into buf       ', xrClamp(-1, buf), 0)
        check('clamp -32000 into buf   ', xrClamp(-32000, buf), 0)

        % ---- ADDR OF A PARAMETER *IS* THE CALLER'S ARRAY. ANSWERED. ---------
        %
        % ASKED because the XMSG transport was about to move into a shared
        % library, and a shared routine has to take ADDR of a PARAMETER - which
        % nothing in this product had ever done. Every other ADDR here is taken
        % of a MODULE-LEVEL array, in the same module as the call.
        %
        % THE ANSWER IS YES, measured on D100 2026-08-27:
        %
        %     ADDR param  1001        ADDR here  1001
        %
        % Identical, for all three arrays. So a routine may take the address of
        % a buffer it was handed and give it to XMPFREA or XMPFWRI.
        %
        % IT TOOK THREE GOES, AND THE TWO WRONG ONES ARE THE LESSON.
        %
        % Attempt 1 forced both addresses to a bare INTEGER4 and got
        % 3473663 against 65791 - different in both halves. They reproduced
        % EXACTLY across two separate builds, which read as reliability, and
        % the conclusion written down was "a parameter address is not the
        % caller's array, the transport cannot be shared". Wrong.
        %
        % Attempt 2 assumed the trouble was the bare type and switched to a
        % NAMED one, TYPE xrAddr = INTEGER4. Same two numbers, same warning.
        % Also wrong, and wrong for the same unexamined reason.
        %
        % What both had was a WIDTH mismatch, and the pulled listing said so
        % every time - a WARNING, not an error, on the call site as well as
        % inside the routine:
        %
        %     715/CTMAIN  *** WARNING - ILLEGAL DATA-ELEMENT TO BE CONVERTED
        %
        % AN ADDRESS ON THIS MACHINE IS SIXTEEN BITS. XMP-B02:IMPT declares
        %
        %     TYPE XMUSERADDRESS = INTEGER          % NB: NEW MC68000 compiler!!
        %
        % and the line ABOVE it, which is where the mistake came from, is a
        % COMMENT reading "modify XMUSERADDRESS = INTEGER4" - an instruction to
        % widen it FOR THE MC68000. Taking that commented instruction for the
        % declaration is what produced a 32-bit force. The extra word was
        % adjacent memory, which is why the junk was stable enough to look like
        % a measurement.
        %
        % THREE THINGS WORTH KEEPING:
        %
        %   a WARNING can invalidate a result as thoroughly as an ERROR - which
        %   is why the gate prints warnings and not only errors;
        %
        %   reproducible is not the same as correct;
        %
        %   read the DECLARATION, not the first line that matches the name. A
        %   commented-out instruction sat one line above the real one.
        xrAddrOf(buf) =: addrA
        ADDR(buf(0)) FORCE xrAddr =: addrB

        % PRINT THEM BOTH BEFORE JUDGING. The check below failed on its first
        % run, and there are two quite different reasons it could:
        %
        %   the parameter address really is not the caller's array - in which
        %   case the transport cannot be shared in this shape at all; or
        %
        %   ADDR gives a POINTER and FORCE INTEGER4 reads a word of whatever
        %   sits next to it, so the comparison is measuring garbage in the high
        %   half while the address itself is perfectly fine.
        %
        % The working product forces ADDR to XMUSERADDRESS, which XMP-B02:IMPT
        % declares as INTEGER4, so the idiom itself is sound. Printing the
        % numbers says which of the two this is; reasoning about it does not.
        OUTPUT(1, 'AL', 'ADDR param  ')
        OUTPUT(1, 'I', addrA)
        OUTPUT(1, 'AL', '   ADDR here  ')
        OUTPUT(1, 'I', addrB)
        OUTPUT(1, 'AL', '$')

        checkB('param addr = here buf   ', addrA = addrB, TRUE)

        xrAddrOf(nm) =: addrA
        ADDR(nm(0)) FORCE xrAddr =: addrB
        checkB('param addr = here nm    ', addrA = addrB, TRUE)

        xrAddrOf(bigBuf) =: addrA
        ADDR(bigBuf(0)) FORCE xrAddr =: addrB
        checkB('param addr = here bigBuf', addrA = addrB, TRUE)

        % Three separate arrays cannot share a start address, so these catch a
        % routine that ignores its parameter and hands back one fixed thing.
        % They PASSED even under the illegal conversion, which is exactly why
        % they were never evidence that the rest of the probe was sound.
        checkB('buf and nm differ       ', xrAddrOf(buf) = xrAddrOf(nm), FALSE)
        checkB('nm and bigBuf differ    ', xrAddrOf(nm) = xrAddrOf(bigBuf), FALSE)

        % ---- the count ---------------------------------------------------
        OUTPUT(1, 'AL', '$')
        OUTPUT(1, 'AL', 'passed ')
        OUTPUT(1, 'I', passed)
        OUTPUT(1, 'AL', '   failed ')
        OUTPUT(1, 'I', failed)
        OUTPUT(1, 'AL', '$')

        IF failed > 0 THEN
            OUTPUT(1, 'AL', '*** THE CODEC IS WRONG - do not build the product$')
        ELSE
            OUTPUT(1, 'AL', 'codec is good$')
        ENDIF
    ENDROUTINE

ENDMODULE
