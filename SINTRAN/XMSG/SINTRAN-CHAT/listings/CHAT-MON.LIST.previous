   702    (42)  
   703    (43)      % MON1 IS INBIT - read one byte from a device. The PLANC runtime carries it
   704    (44)      % as a MONn routine, but it still has to be DECLARED here or the compiler
   705    (45)      % answers ILLEGAL SYNTAX at the call site. Same declaration CHAT.PLNC uses.
   706    (46)      IMPORT ( ROUTINE VOID, BYTE (INTEGER) : MON1 )
   707    (47)  
   708    (48)      INTEGER ARRAY : stack(0:600)
   709    (49)  
   710    (50)      % ---------------------------------------------------------------
   711    (51)      % The message kinds. These MUST match DOC/protocols/chat-wire.json
   712    (52)      % and ChatMessageKind.cs - all three move in the same commit, which
   713    (53)      % is constraint 5 of the federation design.
   714    (54)      %
   715    (55)      % 32 and up are ADMIN and belong on the command port. They share the
   716    (56)      % room's numbering on purpose: a second vocabulary would mean a
   717    (57)      % second decoder bound, and that bound has already been left behind
   718    (58)      % twice, silently both times.
   719    (59)      % ---------------------------------------------------------------
   720    (60)      INTEGER : kAdmStat := 32
   721    (61)      INTEGER : kAdmRepl := 33
   722    (62)      INTEGER : kAdmStop := 34
   723    (63)  
   724    (64)      % The server's command port, by name. XROUT turns this into an
   725    (65)      % address; nothing here knows or wants the number.
   726    (66)      BYTES : admName := 'CHAT-ADMIN'
   727    (67)      INTEGER : lenAdmName := 10
   728    (68)  
   729    (69)      % Who is asking. Carried in the nickname field so the server's log can
   730    (70)      % say who stopped it - an unattributed STOP is not worth much.
   731    (71)      BYTES : operName := 'OPER'
   732    (72)      INTEGER : lenOperName := 4
   733    (73)  
   734    (74)      INTEGER : myPort
   735    (75)      INTEGER : returnStatus
   736    (76)      % THE SYSTEM NAME IS BYTES, NOT AN INTEGER, and an EMPTY one means the LOCAL
   737    (77)      % system - which is what we want, since CHAT-ADMIN is on this machine.
   738    (78)      % Declaring it INTEGER drew
   739    (79)      %   *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
   740    (80)      % on the CALL rather than on the declaration, which sends you looking at the
   741    (81)      % arguments you changed instead of the one you copied wrong. CHAT.PLNC has
   742    (82)      % the same declaration. Measured on D100, 2026-08-20.
   743    (83)      BYTES : hereSystem := ''
   744    (84)      INTEGER : offSet
   745    (85)      INTEGER : uLength
   746    (86)      INTEGER : wLength
   747    (87)      INTEGER : length
   748    (88)      INTEGER : msgType
   749    (89)      INTEGER : remotePortHash
   750    (90)      INTEGER : nBytes
   751    (91)      INTEGER : waitFlags
   752    (92)      INTEGER : replyKind
   753    (93)      INTEGER : replyTextLen
   754    (94)      INTEGER : replyNameLen
   755    (95)      BOOLEAN : leaving
   756    (96)  
   757    (97)      % The command words. Held as BYTES so isVerb can compare byte by byte.
   758    (98)      BYTES : vExit       := 'EXIT'
   759    (99)      BYTES : vHelp       := '?'
   760   (100)      BYTES : vHelpWord   := 'HELP'
   761   (101)      BYTES : vStatus     := 'STATUS'
   762   (102)      BYTES : vStop       := 'STOP'
   763   (103)      BYTES : vStart      := 'START'
   764   (104)      BYTES : vRestart    := 'RESTART'
   765   (105)      BYTES : vStartTrunk := 'START-TRUNK'
   766   (106)      BYTES : vStopTrunk  := 'STOP-TRUNK'
   767   (107)      BYTES : vRestTrunk  := 'RESTART-TRUNK'
   768   (108)      BYTES : vListTrunks := 'LIST-TRUNKS'
   769   (109)      INTEGER : i
   770   (110)  
   771   (111)      % ONE NUMBER PER COMMAND. The matcher below finds WHICH command was typed
   772   (112)      % before deciding what to do about it, so dispatch is a plain choice on a
   773   (113)      % number rather than a ladder of tests whose ORDER carries meaning. That
   774   (114)      % ordering was a standing trap: LIST-TRUNKS, RESTART-TRUNK and START-TRUNK
   775   (115)      % all had to be tested before the shorter words they begin with, and every
   776   (116)      % new verb had to be inserted in exactly the right place or it was
   777   (117)      % swallowed. With a match count the order no longer matters at all.
   778   (118)      INTEGER : cNone        := 0
   779   (119)      INTEGER : cExit        := 1
   780   (120)      INTEGER : cHelp        := 2
   781   (121)      INTEGER : cStatus      := 3
   782   (122)      INTEGER : cStop        := 4
   783   (123)      INTEGER : cStart       := 5
   784   (124)      INTEGER : cRestart     := 6
   785   (125)      INTEGER : cStartTrunk  := 7
   786   (126)      INTEGER : cStopTrunk   := 8
   787   (127)      INTEGER : cRestTrunk   := 9
   788   (128)      INTEGER : cListTrunks  := 10
   789   (129)  
   790   (130)      % The RT program that IS the chat server. This is the PROGRAM unit's name
   791   (131)      % from CHATSV.PLNC - "PROGRAM : chatServer" - not the file name, and it is
   792   (132)      % what CHANGE-RT-DESCRIPTION and @RT CHATSER both use.
   793   (133)      BYTES : rtProgName := 'CHATSER'
   794   (134)      INTEGER : rtAddr
   795   (135)  
   796   (136)      INTEGER : cmdId          % which command matched, when exactly one did
   797   (137)      INTEGER : cmdCount       % how many matched - 0 unknown, >1 ambiguous
   798   (138)      INTEGER : cmdWordLen     % length of the typed word, up to the first space
   799   (139)      INTEGER : hyphenCh := 45 % '-', the separator inside a compound command
   800   (140)      INTEGER : spaceCh  := 32
   801   (141)      INTEGER : questCh  := 63 % '?'
   802   (142)  
   803   (143)      % Only the PROGRAM's line reader uses these. buildAdmin and showAnswer
   804   (144)      % keep their OWN cursors as locals - a shared cursor across routines is a
   805   (145)      % latent bug waiting for the day the call order changes.
   806   (146)      INTEGER : at
   807   (147)      INTEGER : ch
   808   (148)      INTEGER : maxLine := 80
   809   (149)      BOOLEAN : lineReady
   810   (150)      BYTE : rawCh
   811   (151)  
   812   (152)      % Terminal reading. Same values and same reasons as the client's reader.
   813   (153)      INTEGER : ownTerminal := 1        % device number of your own terminal
   814   (154)      INTEGER : parityMask  := 127      % strip the even-parity bit, see below
   815   (155)      INTEGER : carriageRet := 13
   816   (156)      INTEGER : emptyInput  := 3        % InByte in no-wait: nothing was typed
   817   (157)  
   818   (158)      BYTES : letterBuf(0:63)
   819   (159)      BYTES : outBuf(0:255)
   820   (160)      BYTES : inBuf(0:511)
   821   (161)      BYTES : lineBuf(0:79)
   822   (162)      % AN INITIALISER IS WHAT GIVES A BYTES ITS LENGTH. Declared bare, the
   823   (163)      % compiler answers "ARRAY BOUNDS MISSING" and then, further down, warns the
   824   (164)      % name was never declared - two diagnostics from one omission. CHATSV's
   825   (165)      % spaceByte is the same idiom.
   826   (166)      BYTES : oneByte := ' '
   827   (167)  
   828   (168)      % -----------------------------------------------------------------------
   829   (169)      % Print a status number beside the call that produced it. A bare number
   830   (170)      % with no name attached is what makes an XMSG failure take an hour.
   831   (171)      % -----------------------------------------------------------------------
   832   (172)      ROUTINE VOID, VOID (BYTES, INTEGER) : showStatus(what, status)
   833   (173)          OUTPUT(1, 'AL', what)
   834   (174)          OUTPUT(1, 'AL6', ' st = ')
   835   (175)          OUTPUT(1, 'I6', status)
   836   (176)          OUTPUT(1, 'AL1', '$')
   837   (177)      ENDROUTINE
   838   (178)  
   839   (179)      % -----------------------------------------------------------------------
   840   (180)      % Build one admin message into outBuf.
   841   (181)      %
   842   (182)      % The format is the room's own, unchanged: kind, then a one-byte name
   843   (183)      % length and that many bytes of name, then a TWO-byte big-endian text
   844   (184)      % length and that many bytes of text. Admin messages cost no wire change
   845   (185)      % precisely because they need no new fields - a request carries empty
   846   (186)      % text, and the answer puts readable text where a Said would put what
   847   (187)      % somebody said.
   848   (188)      % -----------------------------------------------------------------------
   849   (189)      ROUTINE VOID, INTEGER (INTEGER) : buildAdmin(kind)
   850   (190)          INTEGER : n
   851   (191)          INTEGER : p
   852   (192)          kind =: outBuf(0)
   853   (193)          lenOperName =: outBuf(1)
   854   (194)          FOR n IN 0:lenOperName - 1 DO
   855   (195)              operName(n) =: outBuf(2 + n)
   856   (196)          ENDFOR
   857   (197)          2 + lenOperName =: p
   858   (198)          % Text length, high byte then low. Always zero on a request.
   859   (199)          0 =: outBuf(p)
   860   (200)          0 =: outBuf(p + 1)
   861   (201)          p + 2 RETURN
   862   (202)      ENDROUTINE
   863   (203)  
   864   (204)      % -----------------------------------------------------------------------
   865   (205)      % Send one admin message to CHAT-ADMIN, addressed BY NAME through XROUT.
   866   (206)      %
   867   (207)      % By name rather than by address because nothing here knows the server's
   868   (208)      % port number, and the whole point of a registered name is that it does
   869   (209)      % not have to. This is the same letter mechanism the client uses to join,
   870   (210)      % against a NORMAL named port rather than a connection port - which is
   871   (211)      % what keeps it from spending a seat.
   872   (212)      % -----------------------------------------------------------------------
   873   (213)      ROUTINE VOID, VOID (INTEGER) : sendAdmin(kind)
   874   (214)          XMMSGIDENTIFIER : msgIdent
   875   (215)  
   876   (216)          % XMPBLET takes the port name as BYTES and appends it as parameter 1
   877   (217)          % of the letter. A PLANC BYTES argument carries its own length, so
   878   (218)          % handing over the whole declared array would ask XROUT for a name
   879   (219)          % with the leftovers on the end. The subarray is exactly the name.
   880   (220)          % NO SUBARRAY HERE, and that is the difference from the client's join.
   881   (221)          %
   882   (222)          % CHAT.PLNC declares roomName with explicit bounds (0:20) and fills it at
   883   (223)          % runtime, so it MUST hand XMPBLET a subarray or the letter would carry
   884   (224)          % eleven bytes of leftovers. admName is declared with an INITIALISER, so
   885   (225)          % its implicit length is already exactly 'CHAT-ADMIN' and the whole array
   886   (226)          % is the name. Writing admName(0:lenAdmName - 1) anyway drew
   887   (227)          %   830 (170)/SENDADMIN *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
   888   (228)          % - a variable subarray of a literal-initialised BYTES is not something
   889   (229)          % this compiler will take. Measured on D100, 2026-08-20.
   890   (230)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, admName) =: returnStatus
   891   (231)          IF returnStatus >< XMOK THEN
   892   (232)              % THIS IS THE NAME LOOKUP, and it is the failure an operator will
   893   (233)              % meet most often by a long way: CHAT-ADMIN is not registered
   894   (234)              % because nothing is running to register it. The status number
   895   (235)              % stays - it is what a second pair of eyes needs - but a number on
   896   (236)              % its own is not an answer to somebody who just wants the server
   897   (237)              % up, so say the likely cause and the command that fixes it.
   898   (238)              showStatus('xmpblet', returnStatus)
   899   (239)              OUTPUT(1, 'AL44', 'the chat server does not answer - try START$')
   900   (240)              RETURN
   901   (241)          ENDIF
   902   (242)  
   903   (243)          xmpfget(0, 200, msgIdent) =: returnStatus
   904   (244)          IF returnStatus >< XMOK THEN
   905   (245)              showStatus('xmpfget', returnStatus)
   906   (246)              RETURN
   907   (247)          ENDIF
   908   (248)  
   909   (249)          % The letter header first...
   910   (250)          offSet =: uLength
   911   (251)          xmpfwri(0, 0, &
   912   (252)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
   913   (253)              0, uLength, wLength) =: returnStatus
   914   (254)  
   915   (255)          % ...then our own message after it. XROUT reads only the header and
   916   (256)          % forwards the rest untouched, so this is where the command rides.
   917   (257)          buildAdmin(kind) =: length
   918   (258)          xmpfwri(0, wLength, &
   919   (259)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
   920   (260)              0, length, offSet) =: returnStatus
   921   (261)  
   922   (262)          xmprout(0, msgIdent, myPort) =: returnStatus
   923   (263)          IF returnStatus >< XMOK THEN
   924   (264)              showStatus('xmprout', returnStatus)
   925   (265)          ENDIF
   926   (266)      ENDROUTINE
   927   (267)  
   928   (268)      % -----------------------------------------------------------------------
   929   (269)      % Wait for the server's answer and print it.
   930   (270)      %
   931   (271)      % BLOCKING on purpose - XFWTF. This program has nothing else to do and a
   932   (272)      % poll would burn the machine for nothing. It is also the one place where
   933   (273)      % blocking is safe: unlike the server, CHATMON holds exactly one port.
   934   (274)      % -----------------------------------------------------------------------
   935   (275)      ROUTINE VOID, VOID : showAnswer
   936   (276)          XMMSGIDENTIFIER : msgIdent
   937   (277)          INTEGER : p
   938   (278)  
   939   (279)          xmpfrcv(waitFlags, myPort, msgType, remotePortHash, msgIdent, nBytes) &
   940   (280)              =: returnStatus
   941   (281)  
   942   (282)          % A RECEIVE IS A MESSAGE ONLY WHEN THE STATUS IS A MESSAGE TYPE.
   943   (283)          % Not "= XMOK" and not "> 0": zero is OK for other calls but is not a
   944   (284)          % message type, and every error is positive too, so "> 0" would accept
   945   (285)          % an empty port. XMTNO=1 through XMTPS=6 are the message types.
   946   (286)          % XMOK IS A SUCCESSFUL RECEIVE, AND THIS TEST MUST ACCEPT ZERO.
   947   (287)          %
   948   (288)          % MEASURED on D100 2026-08-20: this printed "xmpfrcv st = 0" and threw
   949   (289)          % the message away. Zero is XMOK, the type lives in the msgType
   950   (290)          % out-parameter, and the vendor's Appendix G sample tests
   951   (291)          % "IF RETURNSTATUS >< XMOK THEN bad status" before looking at the type.
   952   (292)          %
   953   (293)          % This is the SAME defect CHAT.PLNC's header records at length - it ate
   954   (294)          % the welcome there and cost a day. Writing "1..6 only" a second time,
   955   (295)          % in a new program, with the warning already written down, is exactly
   956   (296)          % the trap that comment exists to prevent.
   957   (297)          %
   958   (298)          % An EMPTY port answers XMXENTM (16896), which is neither XMOK nor 1..6
   959   (299)          % and is still correctly rejected here.
   960   (300)          IF returnStatus >< XMOK AND &
   961   (301)             (returnStatus < XMTNO OR returnStatus > XMTPS) THEN
   962   (302)              showStatus('xmpfrcv', returnStatus)
   963   (303)              RETURN
   964   (304)          ENDIF
   965   (305)  
   966   (306)          xmpfrea(0, 0, &
   967   (307)              ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
   968   (308)              0, nBytes, length) =: returnStatus
   969   (309)          IF returnStatus >< XMOK THEN
   970   (310)              showStatus('xmpfrea', returnStatus)
   971   (311)              RETURN
   972   (312)          ENDIF
   973   (313)  
   974   (314)          inBuf(0) =: replyKind
   975   (315)          IF replyKind >< kAdmRepl THEN
   976   (316)              OUTPUT(1, 'AL17', 'unexpected kind $')
   977   (317)              RETURN
   978   (318)          ENDIF
   979   (319)  
   980   (320)          % Walk it. The name is variable-length, so the text length cannot be
   981   (321)          % read from a fixed offset - this format must be WALKED, not indexed.
   982   (322)          inBuf(1) =: replyNameLen
   983   (323)          2 + replyNameLen =: p
   984   (324)          inBuf(p) * 256 + inBuf(p + 1) =: replyTextLen
   985   (325)          p + 2 =: p
   986   (326)  
   987   (327)          % NO "CHAT-MON:" IN FRONT OF THE ANSWER. The prompt already says C-M:,
   988   (328)          % so every reply repeating the program's own name was noise stacked on
   989   (329)          % top of the one line the operator actually asked for.
   990   (330)          FOR i IN 0:replyTextLen - 1 DO
   991   (331)              % One byte at a time through a one-element BYTES. A string literal
   992   (332)              % cannot be stored into a BYTES element, and 'ALn' formats a
   993   (333)              % STRING - handing it a byte prints the byte's NUMBER.
   994   (334)              inBuf(p + i) =: oneByte
   995   (335)              OUTPUT(1, 'AL1', oneByte)
   996   (336)          ENDFOR
   997   (337)          OUTPUT(1, 'AL1', '$')
   998   (338)      ENDROUTINE
   999   (339)  
  1000   (340)      % -----------------------------------------------------------------------
  1001   (341)      % Read one command line from the terminal into lineBuf, length in at.
  1002   (342)      %
  1003   (343)      % PARITY. Terminal input carries an even-parity bit in bit 7, so carriage
  1004   (344)      % return arrives as 141, NOT 13. Compare without masking and this never
  1005   (345)      % sees the user press return and looks HUNG rather than wrong.
  1006   (346)      %
  1007   (347)      % MON1 CAN RAISE A ROUTINEERROR and it must be caught - an unhandled one
  1008   (348)      % takes the program down instead of ending the line.
  1009   (349)      % -----------------------------------------------------------------------
  1010   (350)      ROUTINE VOID, VOID : readLine
  1011   (351)          0 =: at
  1012   (352)          FALSE =: lineReady
  1013   (353)          DO
  1014   (354)              0 =: ch
  1015   (355)              ON ROUTINEERROR DO
  1016   (356)                  IF ErrCode >< emptyInput THEN
  1017   (357)                      OUTPUT(1, 'AL12', 'read failed$')
  1018   (358)                  ENDIF
  1019   (359)                  0 =: rawCh
  1020   (360)              ENDON
  1021   (361)              MON1(ownTerminal) =: rawCh
  1022   (362)              rawCh =: ch
  1023   (363)              ch AND parityMask =: ch
  1024   (364)  
  1025   (365)              IF ch = carriageRet THEN
  1026   (366)                  TRUE =: lineReady
  1027   (367)  
  1028   (368)                  % A CARRIAGE RETURN IS NOT A NEW LINE ON THIS TERMINAL. It puts
  1029   (369)                  % the cursor back at column ONE of the line just typed, and
  1030   (370)                  % nothing moves it down. So every answer this program printed
  1031   (371)                  % landed ON TOP of the command that asked for it - "CHAT-MON:
  1032   (372)                  % stop sent" written straight over "STOP" - and the screen read
  1033   (373)                  % like the program had mangled the input. It had not; it simply
  1034   (374)                  % never ended the line. One end-of-line here, the moment the
  1035   (375)                  % user presses return, and the answer starts on a line of its
  1036   (376)                  % own.
  1037   (377)                  OUTPUT(1, 'AL1', '$')
  1038   (378)              ENDIF
  1039   (379)  
  1040   (380)              % Leave the moment the keyboard runs dry or the line is finished.
  1041   (381)              % Going round again on an empty buffer is a spin, not a poll.
  1042   (382)              WHILE ch >< 0 AND NOT lineReady
  1043   (383)  
  1044   (384)              IF ch > 31 THEN
  1045   (385)                  % PLANC checks no array bound, so this test is the only thing
  1046   (386)                  % between a held-down key and the variables laid out after it.
  1047   (387)                  IF at < maxLine THEN
  1048   (388)                      ch =: lineBuf(at)
  1049   (389)                      at + 1 =: at
  1050   (390)                  ENDIF
  1051   (391)              ENDIF
  1052   (392)          ENDDO
  1053   (393)      ENDROUTINE
  1054   (394)  
  1055   (395)      % -----------------------------------------------------------------------
  1056   (396)      % Print the command list. Reached by ? the way X-C does it.
  1057   (397)      % -----------------------------------------------------------------------
  1058   (398)      ROUTINE VOID, VOID : showHelp
  1059   (399)          OUTPUT(1, 'AL19', 'CHAT-MON commands:$')
  1060   (400)          OUTPUT(1, 'AL38', '  STATUS                how it stands$')
  1061   (401)          OUTPUT(1, 'AL40', '  STOP                  stop the server$')
  1062   (402)          OUTPUT(1, 'AL29', '  ? or HELP             this$')
  1063   (403)          OUTPUT(1, 'AL30', '  EXIT                  leave$')
  1064   (404)          OUTPUT(1, 'AL38', '  START                 NOT BUILT YET$')
  1065   (405)          OUTPUT(1, 'AL38', '  RESTART               stops it only$')
  1066   (406)          OUTPUT(1, 'AL38', '  START-TRUNK <sys>     NOT BUILT YET$')
  1067   (407)          OUTPUT(1, 'AL38', '  STOP-TRUNK <sys>      NOT BUILT YET$')
  1068   (408)          OUTPUT(1, 'AL38', '  RESTART-TRUNK <sys>   NOT BUILT YET$')
  1069   (409)          OUTPUT(1, 'AL38', '  LIST-TRUNKS           NOT BUILT YET$')
  1070   (410)          OUTPUT(1, 'AL1',  '$')
  1071   (411)          OUTPUT(1, 'AL57', 'Commands may be shortened: L-T or LI-TRU is LIST-TRUNKS.$')
  1072   (412)          OUTPUT(1, 'AL37', 'Upper or lower case, either is fine.$')
  1073   (413)          OUTPUT(1, 'AL52', 'NOT BUILT YET means exactly that - it does nothing.$')
  1074   (414)      ENDROUTINE
  1075   (415)  
  1076   (416)      % -----------------------------------------------------------------------
  1077   (417)      % Say plainly that a command is known but not built yet.
  1078   (418)      %
  1079   (419)      % A SHELL THAT SILENTLY DOES NOTHING IS WORSE THAN ONE THAT REFUSES. The
  1080   (420)      % trunk verbs are declared so the command set is visible and a mode file
  1081   (421)      % can be written against it, but their wire kinds and the server half
  1082   (422)      % arrive with phase B. "Not built yet" is the honest answer; a cheerful
  1083   (423)      % "Ok" that changed nothing would be a lie an operator would act on.
  1084   (424)      % -----------------------------------------------------------------------
  1085   (425)      ROUTINE VOID, VOID : notYet
  1086   (426)          OUTPUT(1, 'AL21', 'known, not built yet$')
  1087   (427)      ENDROUTINE
  1088   (428)  
  1089   (429)      % -----------------------------------------------------------------------
  1090   (430)      % Fold one character to upper case.
  1091   (431)      %
  1092   (432)      % TYPING IN LOWER CASE IS NOT A MISTAKE AND MUST NOT BE TREATED AS ONE.
  1093   (433)      % The old matcher compared raw bytes against upper-case keywords, so
  1094   (434)      % "status" was answered "no such command" while "STATUS" worked. Nothing
  1095   (435)      % about this program needs the shift key held down.
  1096   (436)      % -----------------------------------------------------------------------
  1097   (437)      ROUTINE VOID, INTEGER (INTEGER) : upper(c)
  1098   (438)          IF c >= 97 AND c <= 122 THEN
  1099   (439)              c - 32 RETURN
  1100   (440)          ENDIF
  1101   (441)          c RETURN
  1102   (442)      ENDROUTINE
  1103   (443)  
  1104   (444)      % -----------------------------------------------------------------------
  1105   (445)      % How long is the typed command word? It ends at the first space, so an
  1106   (446)      % argument after it does not spoil the match.
  1107   (447)      % -----------------------------------------------------------------------
  1108   (448)      ROUTINE VOID, INTEGER : verbLength
  1109   (449)          INTEGER : n
  1110   (450)          0 =: n
  1111   (451)          DO
  1112   (452)              WHILE n < at AND lineBuf(n) >< spaceCh
  1113   (453)              n + 1 =: n
  1114   (454)          ENDDO
  1115   (455)          n RETURN
  1116   (456)      ENDROUTINE
  1117   (457)  
  1118   (458)      % -----------------------------------------------------------------------
  1119   (459)      % SINTRAN'S OWN ABBREVIATION RULE, and nothing more clever than it.
  1120   (460)      %
  1121   (461)      % A command is a run of parts separated by '-'. What you type must give
  1122   (462)      % EVERY part, and each typed part must be a PREFIX of the matching keyword
  1123   (463)      % part. So LIST-TRUNKS answers to L-T, LI-TRU, LIST-T and LIST-TRUNKS, and
  1124   (464)      % that is exactly how every SINTRAN command has always behaved.
  1125   (465)      %
  1126   (466)      % A BARE "L" DOES NOT MATCH IT. The parts are not optional - dropping one
  1127   (467)      % is a different command, not a shorter spelling of this one. That is what
  1128   (468)      % keeps L-T from colliding with a future LIST verb.
  1129   (469)      %
  1130   (470)      % This routine only answers yes or no about ONE keyword. Deciding what the
  1131   (471)      % typed word MEANS needs the count across all of them, because a prefix
  1132   (472)      % that fits two commands is ambiguous and must be refused rather than
  1133   (473)      % guessed - see matchAll.
  1134   (474)      % -----------------------------------------------------------------------
  1135   (475)      ROUTINE VOID, BOOLEAN (BYTES, INTEGER) : abbrevMatch(word, wordLen)
  1136   (476)          INTEGER : ti          % cursor in what was typed
  1137   (477)          INTEGER : ki          % cursor in the keyword
  1138   (478)          INTEGER : partLen     % characters given for the part in hand
  1139   (479)          BOOLEAN : bad
  1140   (480)          BOOLEAN : done
  1141   (481)  
  1142   (482)          0 =: ti
  1143   (483)          0 =: ki
  1144   (484)          FALSE =: bad
  1145   (485)          FALSE =: done
  1146   (486)  
  1147   (487)          DO
  1148   (488)              WHILE NOT bad AND NOT done
  1149   (489)  
  1150   (490)              % ---- the typed part must run down the keyword part ------------
  1151   (491)              0 =: partLen
  1152   (492)              DO
  1153   (493)                  WHILE NOT bad AND ti < cmdWordLen AND lineBuf(ti) >< hyphenCh
  1154   (494)                  IF ki >= wordLen THEN
  1155   (495)                      TRUE =: bad                 % typed past the end of it
  1156   (496)                  ELSE
  1157   (497)                      IF word(ki) = hyphenCh THEN
  1158   (498)                          TRUE =: bad             % this keyword part is shorter
  1159   (499)                      ELSE
  1160   (500)                          IF upper(lineBuf(ti)) >< word(ki) THEN
  1161   (501)                              TRUE =: bad
  1162   (502)                          ELSE
  1163   (503)                              ti + 1 =: ti
  1164   (504)                              ki + 1 =: ki
  1165   (505)                              partLen + 1 =: partLen
  1166   (506)                          ENDIF
  1167   (507)                      ENDIF
  1168   (508)                  ENDIF
  1169   (509)              ENDDO
  1170   (510)  
  1171   (511)              % An empty part - "-T", or "L--T" - is not an abbreviation.
  1172   (512)              IF NOT bad AND partLen = 0 THEN
  1173   (513)                  TRUE =: bad
  1174   (514)              ENDIF
  1175   (515)  
  1176   (516)              IF NOT bad THEN
  1177   (517)                  % Run the keyword on to the end of ITS part.
  1178   (518)                  DO
  1179   (519)                      WHILE ki < wordLen AND word(ki) >< hyphenCh
  1180   (520)                      ki + 1 =: ki
  1181   (521)                  ENDDO
  1182   (522)  
  1183   (523)                  IF ti >= cmdWordLen THEN
  1184   (524)                      % Nothing more was typed, so the keyword must be finished
  1185   (525)                      % too. If it is not, a part was left out.
  1186   (526)                      IF ki < wordLen THEN
  1187   (527)                          TRUE =: bad
  1188   (528)                      ENDIF
  1189   (529)                      TRUE =: done
  1190   (530)                  ELSE
  1191   (531)                      % More was typed: both sides are sitting on a '-'.
  1192   (532)                      IF ki >= wordLen THEN
  1193   (533)                          TRUE =: bad
  1194   (534)                      ELSE
  1195   (535)                          ti + 1 =: ti
  1196   (536)                          ki + 1 =: ki
  1197   (537)                      ENDIF
  1198   (538)                  ENDIF
  1199   (539)              ENDIF
  1200   (540)          ENDDO
  1201   (541)  
  1202   (542)          IF bad THEN
  1203   (543)              FALSE RETURN
  1204   (544)          ENDIF
  1205   (545)          TRUE RETURN
  1206   (546)      ENDROUTINE
  1207   (547)  
  1208   (548)      % -----------------------------------------------------------------------
  1209   (549)      % Count one keyword against what was typed, remembering the last hit.
  1210   (550)      % -----------------------------------------------------------------------
  1211   (551)      ROUTINE VOID, VOID (BYTES, INTEGER, INTEGER) : tryCmd(word, wordLen, id)
  1212   (552)          IF abbrevMatch(word, wordLen) THEN
  1213   (553)              cmdCount + 1 =: cmdCount
  1214   (554)              id =: cmdId
  1215   (555)          ENDIF
  1216   (556)      ENDROUTINE
  1217   (557)  
  1218   (558)      % -----------------------------------------------------------------------
  1219   (559)      % Print one keyword if it matched - used to say WHICH commands an
  1220   (560)      % ambiguous abbreviation could have meant. Being told "ambiguous" without
  1221   (561)      % being told between what is a riddle, not an error message.
  1222   (562)      % -----------------------------------------------------------------------
  1223   (563)      ROUTINE VOID, VOID (BYTES, INTEGER) : showIfMatch(word, wordLen)
  1224   (564)          IF abbrevMatch(word, wordLen) THEN
  1225   (565)              OUTPUT(1, 'AL2', '  ')
  1226   (566)              OUTPUT(1, 'AL', word)
  1227   (567)              OUTPUT(1, 'AL1', '$')
  1228   (568)          ENDIF
  1229   (569)      ENDROUTINE
  1230   (570)  
  1231   (571)      % -----------------------------------------------------------------------
  1232   (572)      % Try every keyword. Afterwards cmdCount says what happened: 0 means no
  1233   (573)      % such command, 1 means cmdId is it, more than 1 means ambiguous.
  1234   (574)      %
  1235   (575)      % ORDER IS DELIBERATELY IRRELEVANT HERE. Every keyword is tried, always.
  1236   (576)      % -----------------------------------------------------------------------
  1237   (577)      ROUTINE VOID, VOID : matchAll
  1238   (578)          0 =: cmdCount
  1239   (579)          cNone =: cmdId
  1240   (580)          tryCmd(vExit,       4,  cExit)
  1241   (581)          tryCmd(vHelpWord,   4,  cHelp)
  1242   (582)          tryCmd(vStatus,     6,  cStatus)
  1243   (583)          tryCmd(vStop,       4,  cStop)
  1244   (584)          tryCmd(vStart,      5,  cStart)
  1245   (585)          tryCmd(vRestart,    7,  cRestart)
  1246   (586)          tryCmd(vStartTrunk, 11, cStartTrunk)
  1247   (587)          tryCmd(vStopTrunk,  10, cStopTrunk)
  1248   (588)          tryCmd(vRestTrunk,  13, cRestTrunk)
  1249   (589)          tryCmd(vListTrunks, 11, cListTrunks)
  1250   (590)      ENDROUTINE
  1251   (591)  
  1252   (592)      % -----------------------------------------------------------------------
  1253   (593)      % List what an ambiguous abbreviation could have meant.
  1254   (594)      % -----------------------------------------------------------------------
  1255   (595)      ROUTINE VOID, VOID : showAmbiguous
  1256   (596)          OUTPUT(1, 'AL22', 'ambiguous - could be:$')
  1257   (597)          showIfMatch(vExit,       4)
  1258   (598)          showIfMatch(vHelpWord,   4)
  1259   (599)          showIfMatch(vStatus,     6)
  1260   (600)          showIfMatch(vStop,       4)
  1261   (601)          showIfMatch(vStart,      5)
  1262   (602)          showIfMatch(vRestart,    7)
  1263   (603)          showIfMatch(vStartTrunk, 11)
  1264   (604)          showIfMatch(vStopTrunk,  10)
  1265   (605)          showIfMatch(vRestTrunk,  13)
  1266   (606)          showIfMatch(vListTrunks, 11)
  1267   (607)      ENDROUTINE
  1268   (608)  
  1269   (609)      % -----------------------------------------------------------------------
  1270   (610)      % One command.
  1271   (611)      %
  1272   (612)      % ORDER MATTERS WHERE ONE KEYWORD IS A PREFIX OF ANOTHER. LIST-TRUNKS,
  1273   (613)      % UNTRUNK and RETRUNK are all tested before TRUNK, or the shorter word would
  1274   (614)      % swallow the longer ones.
  1275   (615)      % -----------------------------------------------------------------------
  1276   (616)      % -----------------------------------------------------------------------
  1277   (617)      % START THE SERVER. This is NOT a message, and that is why it was missing.
  1278   (618)      %
  1279   (619)      % STOP is a message to a RUNNING server. START cannot be - there is nothing
  1280   (620)      % running to receive it - so it has to be an RT start from THIS side, the
  1281   (621)      % same thing @RT CHATSER does.
  1282   (622)      %
  1283   (623)      % TWO CALLS, NOT ONE. StartRTProgram (RT 100B) takes the ADDRESS of an RT
  1284   (624)      % description, not a name: "Address of RT description. Use 0 for your own".
  1285   (625)      % GetRTAddress (GRTDA 151B) is what turns CHATSER into that address -
  1286   (626)      % name in, address out. Reaching for StartRTProgram alone and passing it a
  1287   (627)      % name would compile, and start whatever RT description happened to live at
  1288   (628)      % the address those bytes make.
  1289   (629)      %
  1290   (630)      % BOTH ARE REACHED BY NAME through MON-CALL-1B-A00, which CHATMN:MODE now
  1291   (631)      % loads. It did not before, because MON1 was this program's only monitor
  1292   (632)      % call and MON1 is one of the runtime's own MONn routines.
  1293   (633)      %
  1294   (634)      % WHAT THIS CANNOT FIX, and an operator needs to know it: an RT program that
  1295   (635)      % uses XMSG must be RT-LOADED AGAIN after every XMSG restart. Starting one
  1296   (636)      % that was linked BEFORE the restart puts it straight into PASSIVE with zero
  1297   (637)      % CPU and not a line in its log. If START says it started and STATUS still
  1298   (638)      % says nothing is there, that is what happened - use tools\rt-load.ps1.
  1299   (639)      % -----------------------------------------------------------------------
  1300   (640)      ROUTINE VOID, BOOLEAN : startServer
  1301   (641)          BOOLEAN : failed
  1302   (642)  
  1303   (643)          0 =: rtAddr
  1304   (644)  
  1305   (645)          ON ROUTINEERROR DO
  1306   (646)              TRUE =: failed
  1307   (647)          ENDON
  1308   (648)          FALSE =: failed
  1309   (649)  
  1310   (650)          MONITOR_CALL('GetRTAddress', rtProgName, rtAddr)
  1311   (651)  
  1312   (652)          % Clear the handler before anything else can raise under it.
  1313   (653)          ON ROUTINEERROR DO
  1314   (654)          ENDON
  1315   (655)  
  1316   (656)          IF failed OR rtAddr = 0 THEN
  1317   (657)              OUTPUT(1, 'AL31', 'cannot find RT program CHATSER$')
  1318   (658)              FALSE RETURN
  1319   (659)          ENDIF
  1320   (660)  
  1321   (661)          ON ROUTINEERROR DO
  1322   (662)              TRUE =: failed
  1323   (663)          ENDON
  1324   (664)          FALSE =: failed
  1325   (665)  
  1326   (666)          MONITOR_CALL('StartRTProgram', rtAddr)
  1327   (667)  
  1328   (668)          ON ROUTINEERROR DO
  1329   (669)          ENDON
  1330   (670)  
  1331   (671)          IF failed THEN
  1332   (672)              OUTPUT(1, 'AL24', 'could not start CHATSER$')
  1333   (673)              FALSE RETURN
  1334   (674)          ENDIF
  1335   (675)  
  1336   (676)          TRUE RETURN
  1337   (677)      ENDROUTINE
  1338   (678)  
  1339   (679)      ROUTINE VOID, VOID : dispatch
  1340   (680)          IF at = 0 THEN
  1341   (681)              RETURN
  1342   (682)          ENDIF
  1343   (683)  
  1344   (684)          verbLength =: cmdWordLen
  1345   (685)          IF cmdWordLen = 0 THEN
  1346   (686)              RETURN
  1347   (687)          ENDIF
  1348   (688)  
  1349   (689)          % ? IS NOT AN ABBREVIATION OF ANYTHING and must not go near the
  1350   (690)          % matcher. X-C answers ?, and a person coming from anywhere else types
  1351   (691)          % HELP, so both are taken.
  1352   (692)          IF cmdWordLen = 1 AND lineBuf(0) = questCh THEN
  1353   (693)              showHelp
  1354   (694)              RETURN
  1355   (695)          ENDIF
  1356   (696)  
  1357   (697)          matchAll
  1358   (698)  
  1359   (699)          IF cmdCount = 0 THEN
  1360   (700)              OUTPUT(1, 'AL16', 'no such command$')
  1361   (701)              RETURN
  1362   (702)          ENDIF
  1363   (703)  
  1364   (704)          % REFUSE, DO NOT GUESS. "S" fits STATUS, STOP and START, and picking
  1365   (705)          % one of them because it happened to be tested last is how an operator
  1366   (706)          % stops a server they meant to ask about.
  1367   (707)          IF cmdCount > 1 THEN
  1368   (708)              showAmbiguous
  1369   (709)              RETURN
  1370   (710)          ENDIF
  1371   (711)  
  1372   (712)          IF cmdId = cExit THEN
  1373   (713)              TRUE =: leaving
  1374   (714)              RETURN
  1375   (715)          ENDIF
  1376   (716)  
  1377   (717)          IF cmdId = cHelp THEN
  1378   (718)              showHelp
  1379   (719)              RETURN
  1380   (720)          ENDIF
  1381   (721)  
  1382   (722)          IF cmdId = cStatus THEN
  1383   (723)              sendAdmin(kAdmStat)
  1384   (724)              showAnswer
  1385   (725)              RETURN
  1386   (726)          ENDIF
  1387   (727)  
  1388   (728)          IF cmdId = cStop THEN
  1389   (729)              sendAdmin(kAdmStop)
  1390   (730)              % A STOP gets no answer - the server is gone by the time one could
  1391   (731)              % be written. Waiting for a reply that is never coming is how a
  1392   (732)              % tool ends up looking hung when it worked.
  1393   (733)              OUTPUT(1, 'AL10', 'stop sent$')
  1394   (734)              RETURN
  1395   (735)          ENDIF
  1396   (736)  
  1397   (737)          % START IS BACK TO NOT BUILT, AND THE REASON IS MEASURED.
  1398   (738)          %
  1399   (739)          % StartRTProgram (RT 100B) is REFUSED from here. Typing START answered
  1400   (740)          %
  1401   (741)          %     ERROR 00 AT  12156; ILLEGAL MONITOR CALL
  1402   (742)          %       100
  1403   (743)          %
  1404   (744)          % and took CHAT-MON down with it. GetRTAddress (151B) got through, so it
  1405   (745)          % is 100B specifically - it needs a privilege this program does not have
  1406   (746)          % running as an ordinary background program. The manual's parameter list
  1407   (747)          % was read and its PERMISSION COLUMNS were not.
  1408   (748)          %
  1409   (749)          % AND THE GUARD DOES NOT HELP. ON ROUTINEERROR does NOT catch an ILLEGAL
  1410   (750)          % MONITOR CALL - that is a system trap, not a ROUTINEERROR - so wrapping
  1411   (751)          % it more carefully changes nothing. A command that kills the program is
  1412   (752)          % worse than one that admits it does nothing, so it admits it.
  1413   (753)          %
  1414   (754)          % To finish this: read the permission columns for 100B in
  1415   (755)          % Reference-Manuals/ND-860228-2-EN SINTRAN III Monitor Calls.md and find
  1416   (756)          % what context may call it. @RT CHATSER from SINTRAN works, so the
  1417   (757)          % privilege exists somewhere this program is not.
  1418   (758)          IF cmdId = cStart THEN
  1419   (759)              notYet
  1420   (760)              RETURN
  1421   (761)          ENDIF
  1422   (762)  
  1423   (763)          % RESTART IS STOP THEN START, and the two halves travel by different
  1424   (764)          % roads: the stop is a message to the running server, the start is an RT
  1425   (765)          % start from here. The server has to notice the stop and terminate
  1426   (766)          % before the start can take, and nothing here waits for it - so this
  1427   (767)          % says what it did rather than claiming the server is up.
  1428   (768)          % RESTART is STOP then START, and START is refused - see above. The stop
  1429   (769)          % half works, so it does that and says plainly what is left to do by
  1430   (770)          % hand rather than pretending the server is coming back.
  1431   (771)          IF cmdId = cRestart THEN
  1432   (772)              sendAdmin(kAdmStop)
  1433   (773)              OUTPUT(1, 'AL10', 'stop sent$')
  1434   (774)              OUTPUT(1, 'AL31', 'start it yourself: @RT CHATSER$')
  1435   (775)              RETURN
  1436   (776)          ENDIF
  1437   (777)  
  1438   (778)          % Only the four trunk verbs are left, and they need the server half -
  1439   (779)          % see the note in showHelp.
  1440   (780)          notYet
  1441   (781)      ENDROUTINE
  1442   (782)  
  1443   (783)      % -----------------------------------------------------------------------
  1444   (784)      % The program.
  1445   (785)      % -----------------------------------------------------------------------
  1446   (786)      PROGRAM : chatMonitor
  1447   (787)          INISTACK stack
  1448   (788)  
  1449   (789)          % The flags WORD from its bit position. XFWTF is a BIT NUMBER in the
  1450   (790)          % values file, not a mask - 2**XFWTF is what the call wants.
  1451   (791)          2**XFWTF =: waitFlags
  1452   (792)  
  1453   (793)          xmpfopn(0, myPort) =: returnStatus
  1454   (794)          IF returnStatus >< XMOK THEN
  1455   (795)              showStatus('xmpfopn', returnStatus)
  1456   (796)              RETURN
  1457   (797)          ENDIF
  1458   (798)  
  1459   (799)          OUTPUT(1, 'AL31', 'CHAT-MON - type ? for commands$')
  1460   (800)  
  1461   (801)          % ---- THE COMMAND LOOP -------------------------------------------
  1462   (802)          %
  1463   (803)          % A SHELL, NOT A ONE-SHOT. This used to read one line, send it and
  1464   (804)          % exit, so an operator had to restart the program for every command
  1465   (805)          % and could not use it the way X-C is used. It now prompts, dispatches
  1466   (806)          % and prompts again until EXIT - the same feel as X-C, and the same
  1467   (807)          % shape a boot mode file can drive line by line.
  1468   (808)          FALSE =: leaving
  1469   (809)          DO
  1470   (810)              OUTPUT(1, 'AL5', 'C-M: ')
  1471   (811)              readLine
  1472   (812)              dispatch
  1473   (813)              WHILE NOT leaving
  1474   (814)          ENDDO
  1475   (815)      ENDROUTINE
  1476   (816)  
  1477   (817)  ENDMODULE
  1478   (818)  