   351   (311)  %                                                                             %
   352   (312)  %          X R O U T  /  F I L E   S E R V E R   -    E R R O R S             %
   353   (313)  %                                                                             %
   354   (314)  %             Error values returned in byte 1 of return message               %
   355   (315)  %                                                                             %
   356   (316)  %                                                                             %
   357   (317)  %      These are the values in the message header itself which the            %
   358   (318)  %      user sees when the XROUT header is manipulated directly by the         %
   359   (319)  %      user.                                                                  %
   360   (320)  %      The PLANC XMSG library returns the STANDARD values (see later)         %
   361   (321)  %                                                                             %
   362   (322)  %-----------------------------------------------------------------------------%
   363   (323)  
   364   (324)  CONSTANT XRXXX=16960   % Base for XROUT errors: 41100B
   365   (325)  CONSTANT XRSOK=0       % OK - not an error!
   366   (326)  CONSTANT XRISN=1       % Illegal service number
   367   (327)  CONSTANT XRUNN=2       % Unknown name (of server or system)
   368   (328)  CONSTANT XRDDF=3       % Another port already has this name
   369   (329)  CONSTANT XRNSP=4       % No space left for names
   370   (330)  CONSTANT XRIPT=5       % Illegal parameter type
   371   (331)  CONSTANT XRMMP=6       % Missing mandatory parameter
   372   (332)  CONSTANT XRUNM=7       % Unknown magic number
   373   (333)  CONSTANT XRMTL=8       % Too short message (or message buffer)
   374   (334)  CONSTANT XRSMF=9       % Standard message format not handled
   375   (335)  CONSTANT XRPRV=10      % Caller was not privileged
   376   (336)  CONSTANT XRISY=11      % Illegal system number parameter
   377   (337)  CONSTANT XRNRO=12      % No access to remote system
   378   (338)  CONSTANT XRIIV=13      % Illegal integer value
   379   (339)  CONSTANT XRNEI=14      % Cannot define route to a neighbour
   380   (340)  CONSTANT XRNXM=15      % Invalid service request - no intersystem XMSG
   381   (341)  CONSTANT XRILN=16      % Illegal/Reserved Log. unit no. for link
   382   (342)  CONSTANT XRNXL=17      % No more XL-Blocks (Link Descriptors)
   383   (343)  CONSTANT XRNXD=18      % Not enough XD-Blocks for LKINI
   384   (344)  CONSTANT XRNTR=19      % No trace generated
   385   (345)  CONSTANT XRTRA=20      % Trace already active
   386   (346)  CONSTANT XRTRP=21      % Trace passive
   387   (347)  CONSTANT XRTFE=22      % Trace/dump file open error (see param 1)
   388   (348)  CONSTANT XRTRT=23      % Trace RT-prog (XTRACE) not found
   389   (349)  CONSTANT XRTIS=24      % Illegal trace system number
   390   (350)  CONSTANT XRBLK=25      % Bad link - open unsuccessful
   391   (351)  CONSTANT XRSYD=26      % Local system number already defined
   392   (352)  CONSTANT XRNLS=27      % No local system number defined yet
   393   (353)  CONSTANT XRTRE=28      % Too many remote names to this system
   394   (354)  CONSTANT XRRNA=29      % Old service calls (<64) cannot go remote
   395   (355)  CONSTANT XRBUS=30      % Service busy - try later!
   396   (356)  CONSTANT XRNSE=31      % This is not a service port
   397   (357)  CONSTANT XRRPN=32      % Remote port statically declared
   398   (358)  CONSTANT XRUKS=33      % Unknown remote system name
   399   (359)  CONSTANT XRMFL=34      % Not enough message table space in remote system
   400   (360)  CONSTANT XRROV=35      % Remote task space overflow when forwarding
   401   (361)  CONSTANT XRRFU=36      % Routing table space full (too many systems def.)
   402   (362)  CONSTANT XRNRB=37      % No remote batch service available here
   403   (363)  CONSTANT XRURT=38      % Unknown RT program name
   404   (364)  CONSTANT XRSNR=39      % This server is not running
   405   (365)  CONSTANT XRRND=40      % Netserver: remote system is not defined
   406   (366)  CONSTANT XRNNA=41      % Netserver: network not available
   407   (367)  CONSTANT XRISE=42      % Netserver: internal server error
   408   (368)  CONSTANT XRIRQ=43      % Netserver: invalid request
   409   (369)  CONSTANT XRNGA=44      % XMSG not congfigurated with gateway code
   410   (370)  CONSTANT XRRNL=45      % Remote system not on same LAN
   411   (371)  CONSTANT XRNCO=46      % No connection to this system (unknown status)
   412   (372)  CONSTANT XRAMB=47      % Ambiguous name
   413   (373)  CONSTANT XRFFU=48      % Friend system table full (too many friends)
   414   (374)  
   415   (375)  %-----------------------------------------------------------------------------%
   416   (376)  %                                                                             %
   417   (377)  %         X R O U T  /  F I L E   S E R V E R   -    E R R O R S              %
   418   (378)  %                                                                             %
   419   (379)  %                             A S                                             %
   420   (380)  %                                                                             %
   421   (381)  %                  S T A N D A R D   V A L U E S                              %
   422   (382)  %                                                                             %
   423   (383)  %             These are returned by the PLANC XMSG library                    %
   424   (384)  %             when the routine involves an XROUT service.                     %
   425   (385)  %                                                                             %
   426   (386)  %                 base value = XRXXX = 16960 = 41100B                         %
   427   (387)  %                                                                             %
   428   (388)  %-----------------------------------------------------------------------------%
   429   (389)  
   430   (390)  CONSTANT XMXRXXX= 16960      % BASE for STANDARD ERROR system
   431   (391)  
   432   (392)  CONSTANT XMXRISN= 16961      % Illegal service number
   433   (393)  CONSTANT XMXRUNN= 16962      % Unknown name (of server or system)
   434   (394)  CONSTANT XMXRDDF= 16963      % Another port already has this name
   435   (395)  CONSTANT XMXRNSP= 16964      % No space left for names
   436   (396)  CONSTANT XMXRIPT= 16965      % Illegal parameter type
   437   (397)  CONSTANT XMXRMMP= 16966      % Missing mandatory parameter
   438   (398)  CONSTANT XMXRUNM= 16967      % Unknown magic number
   439   (399)  CONSTANT XMXRMTL= 16968      % Too short message (or message buffer)
   440   (400)  CONSTANT XMXRSMF= 16969      % Standard message format not handled
   441   (401)  CONSTANT XMXRPRV= 16970      % Caller was not privileged
   442   (402)  CONSTANT XMXRISY= 16971      % Illegal system number parameter
   443   (403)  CONSTANT XMXRNRO= 16972      % No access to remote system
   444   (404)  CONSTANT XMXRIIV= 16973      % Illegal integer value
   445   (405)  CONSTANT XMXRNEI= 16974      % Cannot define route to a neighbour
   446   (406)  CONSTANT XMXRNXM= 16975      % Invalid service request - no intersystem XMSG
   447   (407)  CONSTANT XMXRILN= 16976      % Illegal/Reserved Log. unit no. for link
   448   (408)  CONSTANT XMXRNXL= 16977      % No more XL-Blocks (Link Descriptors)
   449   (409)  CONSTANT XMXRNXD= 16978      % Not enough XD-Blocks for LKINI
   450   (410)  CONSTANT XMXRNTR= 16979      % No trace generated
   451   (411)  CONSTANT XMXRTRA= 16980      % Trace already active
   452   (412)  CONSTANT XMXRTRP= 16981      % Trace passive
   453   (413)  CONSTANT XMXRTFE= 16982      % Trace/dump file open error (see param 1)
   454   (414)  CONSTANT XMXRTRT= 16983      % Trace RT-prog (XTRACE) not found
   455   (415)  CONSTANT XMXRTIS= 16984      % Illegal trace system number
   456   (416)  CONSTANT XMXRBLK= 16985      % Bad link - open unsuccessful
   457   (417)  CONSTANT XMXRSYD= 16986      % Local system number already defined
   458   (418)  CONSTANT XMXRNLS= 16987      % No local system number defined yet
   459   (419)  CONSTANT XMXRTRE= 16988      % Too many remote names to this system
   460   (420)  CONSTANT XMXRRNA= 16989      % Old service calls (<64) cannot go remote
   461   (421)  CONSTANT XMXRBUS= 16990      % Service busy - try later!
   462   (422)  CONSTANT XMXRNSE= 16991      % This is not a service port
   463   (423)  CONSTANT XMXRRPN= 16992      % Remote port statically declared
   464   (424)  CONSTANT XMXRUKS= 16993      % Unknown remote system name
   465   (425)  CONSTANT XMXRMFL= 16994      % Not enough message table space in remote system
   466   (426)  CONSTANT XMXRROV= 16995      % Remote task space overflow when forwarding
   467   (427)  CONSTANT XMXRRFU= 16996      % Routing table space full (too many systems def.)
   468   (428)  CONSTANT XMXRNRB= 16997      % No remote batch service available here
   469   (429)  CONSTANT XMXRURT= 16998      % Unknown RT-program name
   470   (430)  CONSTANT XMXRSNR= 16999      % this server is not running
   471   (431)  CONSTANT XMXRRND= 17000      % Netserver: remote system is not defined
   472   (432)  CONSTANT XMXRNNA= 17001      % Netserver: network not available
   473   (433)  CONSTANT XMXRISE= 17002      % Netserver: internal server error
   474   (434)  CONSTANT XMXRIRQ= 17003      % Netserver: invalid request
   475   (435)  CONSTANT XMXRNGA= 17004      % XMSG not configured with gateway code
   476   (436)  CONSTANT XMXRRNL= 17005      % remote system not on same LAN
   477   (437)  CONSTANT XMXRNCO= 17006      % no connection to this system(unknown status)
   478   (438)  CONSTANT XMXRAMB= 17007      % ambiguous name
   479   (439)  CONSTANT XMXRFFU= 17008      % friend system table full (too many friends)
   480   (440)  
   481   (441)  %-----------------------------------------------------------------------------%
   482   (442)  %                                                                             %
   483   (443)  %                    format of XROUT messages                                 %
   484   (444)  %                                                                             %
   485   (445)  %-----------------------------------------------------------------------------%
   486   (446)  
   487   (447)  %
   488   (448)  % maximum XMSG name length
   489   (449)  %
   490   (450)  CONSTANT XMMAXNameLength = 32          % actually installation-dependent!
   491   (451)  
   492   (452)  
   493   (453)                                         % XROUT header format
   494   (454)  TYPE XROUTHDR = RECORD PACK            % base record for variants
   495   (455)         BYTE: XRSerialNumber            % serial number for user's use
   496   (456)         BYTE: XRServiceNumber           % code for required service which is
   497   (457)         BYTE: XRStatus = XRServiceNumber% replaced with XROUT status code
   498   (458)         INTEGER2: XRBufferLength = XRServiceNumber % overlay for append routines
   499   (459)         INTEGER2: XRLengthMsg           % total length of following parameters
   500   (460)  ENDRECORD
   501   (461)                                         % parameter formats
   502   (462)  TYPE XROUTPARAMHDR = RECORD PACK       % base record for parameter variants
   503   (463)         BYTE: XRPCode                   % parameter code
   504   (464)         BYTE: XRPLength                 % parameter length
   505   (465)  ENDRECORD
   506   (466)  TYPE XROUTSTRING = XROUTPARAMHDR RECORD PACKED % string parameter format
   507   (467)         BYTES: XRPString(0:XMMAXNameLength-1)   % MAXIMUM length shown
   508   (468)  ENDRECORD
   509   (469)  TYPE XROUTINTEGER = XROUTPARAMHDR RECORD PACKED % integer parameter format
   510   (470)         INTEGER2: XRPInteger
   511   (471)  ENDRECORD
   512   (472)  TYPE XROUTDOUBLE = XROUTPARAMHDR RECORD PACKED % integer4 parameter format
   513   (473)         INTEGER4: XRPDouble
   514   (474)  ENDRECORD
   515   (475)  
   516   (476)  %-----------------------------------------------------------------------------%
   517   (477)  $EOF
