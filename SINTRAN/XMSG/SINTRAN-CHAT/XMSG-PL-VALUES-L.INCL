
%=========================  XMSG version L  ===============  87.01.05  ========
%
%    XMSG-PL-VALUES:INCL  Defines the values for symbolic names for XMSG
%    -------------------  functions, XROUT services and error codes.
%
%==============================================================================

%-------------------------------------------------------------------------------
%       X M S G   -   F U N C T I O N   V A L U E S
%-------------------------------------------------------------------------------

CONSTANT XFDUM=0   % Dummy function
CONSTANT XFDCT=1   % Disconnect from message system
CONSTANT XFGET=2   % Get message space
CONSTANT XFREL=3   % Release message space
CONSTANT XFRHD=4   % Read header from a message (6 bytes)
CONSTANT XFWHD=5   % Write header to a message (6 bytes)
CONSTANT XFREA=6   % Read from message to user buffer
CONSTANT XFWRI=7   % Write from user to message
CONSTANT XFSCM=8   % Set current message
CONSTANT XFMST=9   % Get message status
CONSTANT XFOPN=10  % Open port
CONSTANT XFCLS=11  % Close port
CONSTANT XFSND=12  % Send message to a remote port
CONSTANT XFRCV=13  % Receive a message on a given port
CONSTANT XFPST=14  % Get local port status
CONSTANT XFGST=15  % General status or wait
CONSTANT XFSIN=16  % Service initialisation function (privileged)
CONSTANT XFSRL=17  % Service release function (obsolete)
CONSTANT XFABR=18  % Absolute read block from XMSG area (privileged)
CONSTANT XFABW=19  % Absolute write block to XMSG area (obsolete)
CONSTANT XFMLK=20  % Lock message system (obsolete)
CONSTANT XFMUL=21  % Unlock message system (obsolete)
CONSTANT XFM2P=22  % Magic number to system number and port id.
CONSTANT XFP2M=23  % Port to magic number
CONSTANT XFRIN=24  % Routing initialise (obsolete)
CONSTANT XFCRD=25  % Create driver with context (privileged)
CONSTANT XFSTD=26  % Start driver (privileged)
CONSTANT XFDIB=27  % Define indirect buffer (obsolete)
CONSTANT XFRIB=28  % Read from indirect buffer (obsolete)
CONSTANT XFWIB=29  % Write to indirect buffer (obsolete)
CONSTANT XFPRV=30  % Request privilege
CONSTANT XFRTN=31  % Write word 0 and return message
CONSTANT XFRRH=32  % Receive message and read word 0
CONSTANT XFDUB=33  % Define user buffer area for current message (privileged)
CONSTANT XFWDF=34  % Define wake-up context (drivers only!)
CONSTANT XFDBK=35  % Define bank no (drivers only)
CONSTANT XFSMC=36  % Start multi-function call
CONSTANT XFDMM=37  % Define max memory for a task (privileged)
CONSTANT XFALM=38  % Allocate messages to a task
CONSTANT XFFRM=39  % Free allocated messages
CONSTANT XFLMP=40  % List messages and ports
CONSTANT XFRRE=41  % Receive and read message
CONSTANT XFCPV=42  % Check system and/or user privileges
CONSTANT XFWRT=43  % Write and return message
CONSTANT XFMRT=44  % Modify routing tables (privileged - COSROUT only!)
CONSTANT XFSFM=45  % Send message via specified link/netserver (priv - COSROUT only!)
CONSTANT XFCRR=46  % Cosrout receive and read message (priv - COSROUT only!)
CONSTANT XFGSM=47  % General status multiple or wait
CONSTANT X5FUN=48  % == END MARKER == LEAVE ME HERE PLEASE

%--------------------------------------------------------
% Bit values (options) in function code register (T-reg)
%--------------------------------------------------------

CONSTANT XFWTF=15  % If set then wait if operation not terminated.
CONSTANT XFWAK=14  % In XFRCV/PST/GST/RRH/RRE: Wake up task on status change.
%        XFPRM=13  % In XFOPN: Permanent open requested (Obsolete).
%        XFOPS=12  % In XFOPN: Specified port number required (not implemented).
CONSTANT XFPON=13  % In XFSTD: Driver to run with paging on.
%        XFWOK=13  % In XFDIB: Allow write access to indirect buffer (Obsolete).
%        XFUSG=13  % In XFREA/WRI: Use the user segno def by XFDUS/XFDBK (not impl.).
CONSTANT XFHIP=13  % In XFSND/RTN/WRT/SFM: If not XFROU then high-priority message
                   % In XFPST/GST: If no high-priority message is waiting,
                   %               wake up task on status change.
CONSTANT XFRRO=13  % In XFSND: If XFROU then non-local XROUT (sysno in A-reg).
CONSTANT XFEXC=13  % In XFALM/GET: Allocate/reserve exclusive message buffer(s).
                   % In XFFRM: Free exclusively allocated buffer(s).
CONSTANT XFRES=12  % In XFWRI: Reset message length to 0 before data is written.
                   % In XFWRT: Reset message length and displacement to 0
                   %           before data is written.
CONSTANT XFRMR=12  % In XFRRE: Release the message if the last byte is read.
CONSTANT XFBNC=12  % In XFSND/RTN/WRT: Bounce message.
CONSTANT XFFWD=11  % In XFSND/RTN/WRT/SFM: Forward message.
CONSTANT XFROU=10  % In XFSND: Message to be sent to XROUT (see XFRRO).
CONSTANT XFRDI=10  % In XFWRT: Reset the current message displacement to 0.
CONSTANT XFSEC=9   % In XFSND/RTN/WRT: Secure message (Return if not deliv'd).
CONSTANT XFTCM=8   % In XFSND/SFM: Send task current message
% == Warning: bits 8,9,10,11,12,13,14 (decimal) are used for bank no in XFABR ==
CONSTANT XFSYS=7   % Bit set to indicate system mode call (system domain).

%-----------------------------------------------------
% Function codes when calling DRXMSG from drivers
%-----------------------------------------------------

CONSTANT XDINF=1   % Get message info
CONSTANT XDSBP=2   % Set byte pointer
CONSTANT XDPUS=3   % Put byte sequential
CONSTANT XDPUR=4   % Put byte random
CONSTANT XDGES=5   % Get byte sequential
CONSTANT XDGER=6   % Get byte random

%---------------------------------------------------------------------------
% Message types: Returned as successfull status from XFRCV (nb: max 4 bits)
%---------------------------------------------------------------------------

CONSTANT XMTNO=1   % Normal message
CONSTANT XMROU=2   % Routed message (Via XROUT)
CONSTANT XMTHI=3   % High priority message
CONSTANT XMTRE=4   % Return message (Abnormal condition)
CONSTANT XMKIK=5   % XROUT has been kicked (no message)
CONSTANT XMTPS=6   % Pseudo message (not used)

%-------------------------------------------------------------------------------
%      X M S G    U S E R    E R R O R    S Y M B O L S
%      Returned in T-register
%-------------------------------------------------------------------------------

CONSTANT XKXXX=16896 % Base for standard error system (41000B)
CONSTANT XENOT= -1   % No more XT-blocks free
CONSTANT XEIRM= -2   % Non-local remote port illegal here
CONSTANT XENIR= -3   % Network layer initialization reject (purely internal)
CONSTANT XETMM= -4   % Task is not allowed any more memory
CONSTANT XENIM= -5   % Facility not yet implemented
CONSTANT XEIBP= -6   % Illegal message buffer pointer
CONSTANT XEBNY= -7   % Message buffer not yours
CONSTANT XEIRT= -8   % Illegal function for RT-programs (only drivers)
CONSTANT XENOP= -9   % No more ports available
CONSTANT XEIDR= -10  % Function not available to drivers
CONSTANT XENDM= -11  % No default message
CONSTANT XEMCH= -12  % Message is already chained
CONSTANT XEBFC= -13  % Message is in a queue.
CONSTANT XEAIN= -14  % XMSG Kernel already initialised
CONSTANT XEBNC= -15  % Return of a bounce message
CONSTANT XEWNA= -16  % Write Not Allowed (Indirect buffer)
CONSTANT XENVI= -17  % No Valid Indirect buffer defined
CONSTANT XEILF= -18  % Illegal function code
CONSTANT XEIMA= -19  % Invalid magic number
CONSTANT XEMFL= -20  % Message space full or buffer not available
CONSTANT XEILM= -21  % Illegal message size or not enough space left
CONSTANT XEIPN= -22  % Illegal port number
CONSTANT XEPRV= -23  % Privileged function called without privilege.
CONSTANT XEPVR= -24  % Privilege request refused
CONSTANT XERNA= -25  % Remote system not available
CONSTANT XEROV= -26  % Remote task space overflow
CONSTANT XEXBF= -27  % Message already has XMSG buffer (XFDUB)
CONSTANT XEDRI= -28  % Driver called XMSG before return from previous
CONSTANT XENDP= -29  % No port open (so 'default port' param invalid)
CONSTANT XEITL= -30  % Illegal transfer length for read/write
CONSTANT XEIDP= -31  % Illegal displacement in read/write
CONSTANT XEILR= -32  % Illegal use of reentrant segment in XFDIB
CONSTANT XENOS= -33  % Indirect Buffer not on valid segment
CONSTANT XENSE= -34  % Network sequencing error (purely internal significance)
CONSTANT XERND= -35  % Remote system not defined
CONSTANT XEPCL= -36  % Remote port closed while message queued
CONSTANT XENRU= -37  % XMSG not running === do not move - used in SINTRAN ===
CONSTANT XENTO= -38  % Timeout detected by network layer
CONSTANT XENUS= -39  % No user segment info defined (XFUSG option)
CONSTANT XEREJ= -40  % Network remote reject (request retransmit)
CONSTANT XEIXT= -41  % Driver called XMSG with illegal XT-block
CONSTANT XETMU= -42  % Too many multi-call functions
CONSTANT XENCE= -43  % Network checksum error (purely internal significance)
CONSTANT XEICM= -44  % Function not available to tasks other than COSROUT
CONSTANT XECRA= -63  % XMSG crash (Info in Basefield)

%-------------------------------------------------------------------------------
%       X R O U T   -   S E R V I C E    V A L U E S
%       Values in byte 1 of message. Bit 6 is set => service request
%-------------------------------------------------------------------------------

CONSTANT XSNUL=64    % Null command returns 0 status to sender
CONSTANT XSLET=65    % Send a letter
CONSTANT XSNAM=66    % Give name to this port
CONSTANT XSCNM=67    % Clear name of this port
CONSTANT XSGNM=68    % Get name of port (param: MAGNO)
CONSTANT XSGNI=69    % Get name (param: MC/PORTNO)
CONSTANT XSGMG=71    % Get magic number from name (privileged)
CONSTANT XSDRN=73    % Define remote name (privileged)
CONSTANT XSDSY=74    % Define routing for system N (privileged)
CONSTANT XSDMC=XSDSY % Define routing for system N - old symbol
CONSTANT XSGSY=75    % Get routing info for system N
CONSTANT XSGMC=XSGSY % Get routing info for system N - old symbol
CONSTANT XSLKI=76    % Start up specified link (privileged)
CONSTANT XSTIN=77    % Initialise tracing (open file, ..) (privileged)
CONSTANT XSTCL=78    % Close tracing (privileged)
CONSTANT XSTDC=79    % Define tracing conditions (privileged)
CONSTANT XSCRS=80    % Create service (name, init no of SP's)
CONSTANT XSNSP=81    % New service point(s) (increment/decrement in SP's)
CONSTANT XSGIN=82    % Get information about name
CONSTANT XSDLO=83    % Define local system (privileged)
CONSTANT XSLEK=84    % Send letter and kick if unavailable (privileged)
                     % When COSROUT is running: XSLEK is not available
CONSTANT XSNET=85    % Start/stop gateway (network server) (privileged)
CONSTANT XSSCI=86    % Set crash information (privileged)
CONSTANT XSGAT=87    % Get/check attribute
CONSTANT XSDAT=88    % Define/remove attribute (privileged)
CONSTANT XSNSI=89    % Get network server information (privileged)
CONSTANT XSLIN=90    % Get information about a link (privileged)
CONSTANT XSPIN=91    % Get information about named ports
CONSTANT XSLSY=92    % Get information about a system (privileged)
CONSTANT XSGSU=93    % Get info about system utilization (privileged)
CONSTANT XSCRM=94    % Start/stop Cosmos routing manager (priv - COSROUT only!)
CONSTANT XSGLI=95    % Get information from link tables (priv - COSROUT only!)
CONSTANT XSGSG=96    % Get info about system generation variables (privileged)
CONSTANT XSMAX=XSGSG % Maximum legal service value

%-----------------------------------------------
% XROUT sub-service values in parameter 1.
% (Definitions for XSSCI, XSGAT and XSDAT.)
%-----------------------------------------------

%
% Sub-service definitions for XSSCI (privileged)
%
CONSTANT XSDAR=1   % Enable/disable auto-restart of XMSG
CONSTANT XSDRF=2   % Define/remove restart-files
CONSTANT XSDDF=3   % Define/remove dump-files
CONSTANT XSGDF=4   % Get defined dump-files
CONSTANT XSDUX=5   % Dump XMSG onto files
CONSTANT XSGRF=6   % Get defined restart-files
CONSTANT XSGAR=7   % Get auto-restart definition
%
% Sub-service definitions for XSGAT
%
CONSTANT XSGXV=1   % Get XMSG version and revision
CONSTANT XSCMG=2   % Check magic number
CONSTANT XSGCN=3   % Get complete system or port name (deabbreviate name)
CONSTANT XSGFR=4   % Get friend information (privileged!)
CONSTANT XSGLO=5   % Get local system number and name
%
% Sub-service definitions for XSDAT (privileged)
%
CONSTANT XSDFR=1   % Define friend system
CONSTANT XSRFR=2   % Remove friend system
CONSTANT XSECS=3   % Enable checksum
CONSTANT XSDCS=4   % Disable checksum
CONSTANT XSDAL=5   % Define alternative link (COSROUT only)

%-------------------------------------------------------------------------------
%      X R O U T  /  N E T W O R K    S E R V E R   -    E R R O R S
%      Error values returned in byte 1 of return message (Bit 6 reset)
%-------------------------------------------------------------------------------

CONSTANT XRXXX=16960 % Base for XROUT errors: 41100B
CONSTANT XRSOK=0   % OK - not an error!
CONSTANT XRISN=1   % Illegal service number
CONSTANT XRUNN=2   % Unknown name (of server or system)
CONSTANT XRDDF=3   % Another port already has this name
CONSTANT XRNSP=4   % No space left for names
CONSTANT XRIPT=5   % Illegal parameter type
CONSTANT XRMMP=6   % Missing mandatory parameter
CONSTANT XRUNM=7   % Unknown magic number
CONSTANT XRMTL=8   % Too short message or resulting message too long
CONSTANT XRSMF=9   % Standard message format not handled
CONSTANT XRPRV=10  % Caller was not privileged
CONSTANT XRISY=11  % Illegal system number parameter
CONSTANT XRNRO=12  % No access to remote system
CONSTANT XRIIV=13  % Illegal integer value
CONSTANT XRNEI=14  % Cannot define route to a neighbour
CONSTANT XRNXM=15  % Invalid service request - not available to current caller
CONSTANT XRILN=16  % Illegal/Reserved Logical Unit Number (LUN) for link
CONSTANT XRNXL=17  % No more Link Descriptors (XL-blocks) for start-link/netserver
CONSTANT XRNXD=18  % Not enough resources (XD/XF/XM-Blocks) for start-link/netserver
CONSTANT XRNTR=19  % No trace generated (no trace buffer available)'
CONSTANT XRTRA=20  % Trace already active
CONSTANT XRTRP=21  % Trace passive
CONSTANT XRTFE=22  % Trace/dump file open error (see parameter 1)
CONSTANT XRTRT=23  % Trace RT-prog (XTRACE) not found
CONSTANT XRTIS=24  % Illegal trace system number
CONSTANT XRBLK=25  % Bad link - open unsuccessful
CONSTANT XRSYD=26  % Attempt to redefine local system no
CONSTANT XRNLS=27  % No local system number defined
CONSTANT XRTRE=28  % Too many remote names to this system
CONSTANT XRRNA=29  % Old service calls (<64) cannot go remote
CONSTANT XRBUS=30  % Service points busy
CONSTANT XRNSE=31  % This is not a service port
CONSTANT XRRPN=32  % Remote port statically declared
CONSTANT XRUKS=33  % Unknown remote system name or number
CONSTANT XRMFL=34  % Remote system message table space full
CONSTANT XRROV=35  % Remote task message space used up
CONSTANT XRRFU=36  % Routing table full (too many systems)
CONSTANT XRNRB=37  % No remote batch service available
CONSTANT XRURT=38  % Unknown RT name
CONSTANT XRSNR=39  % This server is not running
CONSTANT XRRND=40  % Netserver: remote system is not defined
CONSTANT XRNNA=41  % Netserver: network not available
CONSTANT XRISE=42  % Netserver: internal server error
CONSTANT XRIRQ=43  % Netserver: invalid request
CONSTANT XRNGA=44  % XMSG not congfigurated with gateway code
CONSTANT XRRNL=45  % Remote system not on same LAN
CONSTANT XRNCO=46  % No connection to this system (unknown status)
CONSTANT XRAMB=47  % Ambiguous name
CONSTANT XRFFU=48  % Friend system table full (too many friends)
CONSTANT XRNTA=49  % Netserver: network temporarily not available
CONSTANT XRMTO=50  % Netserver: message too old
CONSTANT XRCNR=51  % COSMOS routing manager is not running
CONSTANT XRICR=52  % COSMOS routing manager is already running
CONSTANT XRRID=53  % Routing information defined (start/stop inhibited)
CONSTANT XRIRR=54  % COSMOS routing manager: invalid request
CONSTANT XRILX=55  % Illegal link number parameter

%-------------------------------------------------------------------------------
%      X M F I D O  -  S T A T U S E S                                     
%      Returned as parameter 1 in XROUT format letter.
%-------------------------------------------------------------------------------
CONSTANT X412B= 17024    % Base for this error range 41200B
CONSTANT XEFOK= 0        % Ok.
CONSTANT XEFCL= 0+X412B  % Watched port closed.
CONSTANT XEFSU= 1+X412B  % System connection up.
CONSTANT XEFSD= 2+X412B  % System connection down.
CONSTANT XEFTO= 3+X412B  % Timeout on request. (No answer from remote XMFIDO)
CONSTANT XEFAR= 4+X412B  % Start service for this port is already requested.
CONSTANT XEFIP= 5+X412B  % Illegal parameters.
CONSTANT XEFOV= 6+X412B  % Time parameter outside legal values.
CONSTANT XEFNP= 7+X412B  % No corresponding port found.
CONSTANT XEFIE= 8+X412B  % Internal error in XMFIDO.
CONSTANT XEFLT= 9+X412B  % Local XMFIDO is terminating.
CONSTANT XEFRT=10+X412B  % Remote XMFIDO has terminated.
CONSTANT XEFRU=11+X412B  % Table resources used up in XMFIDO.

%-------------------------------------------------------------------------------
%       X M S G / X R O U T    C R A S H    C O D E S
%       Printed on the system console and saved in Xmsg basefield
%-------------------------------------------------------------------------------

CONSTANT XXEIE=1   % Illegal port address in the creation of magic number
CONSTANT XXIOW=2   % Illegal owner of buffer
CONSTANT XXBIN=3   % Memory allocation inconsistency
CONSTANT XXMCE=4   % Message queue length inconsistency
CONSTANT XXIEN=5   % ZRALL gave port not in XQTAB (Not used)
CONSTANT XXIFL=6   % XROUT: ZFUNC function >X5FUN
CONSTANT XXIRT=7   % Illegal RT-Description add used (Not used)
CONSTANT XXNBF=8   % INIT: No Buffer space available (Not used)
CONSTANT XXRIN=9   % Inconsistency in resource allocation
CONSTANT XXNMM=10  % More memory released than owned
CONSTANT XXNIM=11  % Not implemented (Cannot recover) (Not used)
CONSTANT XXCLS=12  % Inconsistency in port chain when closing
CONSTANT XXCHE=13  % Double chaining attempted
CONSTANT XXNOR=14  % No XMSG-RESIDENT found by initialization (Not used)
CONSTANT XXICM=15  % Inconsistency in XMPRT/XPCMS Pair
CONSTANT XX100=16  % This can only be done on N100'S (Not used)
CONSTANT XXMON=17  % Inconsistency in level 5 monitor queues
CONSTANT XXMMC=18  % Multisystem XMSG not implemented/generated (Not used)
CONSTANT XXFBI=19  % Frame buffer handling inconsistency
CONSTANT XXPER=20  % Protocol error in communications system
CONSTANT XXILN=21  % Illegal LOG NO for HDLC (bad LOGPH) (Not used)
CONSTANT XXROU=22  % No legal routing (XROUT) port defined
CONSTANT XXHER=23  % Error in HDLC Driver or interface to it
CONSTANT XXRO2=24  % XROUT fatal error - see XROUT Basefield
CONSTANT XXTAS=25  % Task handling (wait,resume) error
CONSTANT XXMER=26  % Message handling error (kernel-net interface)
CONSTANT XXNER=27  % Network gateway error
CONSTANT XXCRM=28  % No legal COSMOS routing manager port defined
CONSTANT XXRIC=29  % Inconsistency in COSMOS routing manager
CONSTANT XXNGA=30  % Gateway code not generated (Not used)
CONSTANT XXRI2=31  % XROUT: Resource inconsistency
CONSTANT XXINP=32  % XROUT: Releasing invalid name unit
CONSTANT XXBER=33  % XROUT: Buffer handling error (xb... routines)
CONSTANT XXRUT=34  % XROUT: Response with no request outstanding (Not used)
CONSTANT XXNXM=35  % XROUT: No multi-system xmsg - inconsistent! (Not used)
CONSTANT XXNLD=36  % XROUT: Not loaded correctly with RT loader
CONSTANT XXUSR=37  % XROUT: Stopped by 'STOP-XMSG' in SINTRAN-SERVICE (Not used)
CONSTANT XXN10=38  % XROUT: 8X100 library mark set, but this is ND-10 (Not used)
CONSTANT XXNSG=39  % XROUT: No space available for fixing tables and/or message area
CONSTANT XXNI2=40  % XROUT: Not yet implemented (Not used)
CONSTANT XXMIN=41  % XROUT: System / routing table inconsistency
CONSTANT XXTAI=42  % XROUT: Table allocation inconsistency
CONSTANT XXWS3=43  % XROUT: Wrong SINTRAN III SYMBOL--LISTs
CONSTANT XXN33=44  % XROUT: Not enough space for seg 33 (or too big)
CONSTANT XXVSX=45  % XROUT: PIT3 version must run on S3 version I or later
CONSTANT XXNCX=46  % XROUT: CX version must run on a ND-100/CX or a ND-110
CONSTANT XXWSY=47  % XROUT: Not generated for this system
CONSTANT XXMNL=48  % XROUT: Length of system/port names too long, reduce length of name
CONSTANT XXILL=50  % XROUT: Not allowed on this system (error from MON CPUST/ENTSG)
CONSTANT XXKTB=51  % XROUT: Kernel tables are too big, reduce system parameters
CONSTANT XXNIN=52  % XROUT: XMSG is not initialized to SINTRAN.
CONSTANT XXNSA=53  % XROUT: Too many systems, reduce max number of systems accessible
CONSTANT XXNNP=54  % XROUT: Too many named ports, reduce max number of named ports
CONSTANT XXILG=55  % XROUT: XMSG is not generated correctly
CONSTANT XXTBT=56  % XROUT: Physical tables are too big (>64K)
CONSTANT XXTBM=57  % XROUT: Message buffer pool is too big (>256K)
$EOF
