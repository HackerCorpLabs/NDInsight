@cc KEYPROB:MODE - build the VTM function-key probe.
@DELETE-FILE KEYPROB:PROG
@DELETE-FILE KEYPROB:LIST
@DELETE-FILE KEYPROB:BRF
@PLANC-100-F00
COMPILE KEYPROB:PLNC,"KEYPROB:LIST","KEYPROB"
EXIT
@BRF-LINKER-C01
PROGRAM-FILE "KEYPROB"
LOAD KEYPROB
LIBRARY-MODE ON
LOAD INTRF1B
LOAD VTMR
LOAD VTMDATA
LOAD VTMARR
LOAD MON-CALL-1B-A00
LOAD PLANC-1BANK-F00
LIST-ENTRIES-UNDEFINED
EXIT
@cc Built KEYPROB:PROG. Run with @KEYPROB
