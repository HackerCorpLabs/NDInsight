   761   (172)         (ROUTINE VOID,INTEGER(BYTES,INTEGER READ WRITE,INTEGER4,INTEGER):&
   762   (173)          xmpbadb),&
   763   (174)         (ROUTINE VOID,INTEGER(BYTES,INTEGER READ WRITE,BYTES,INTEGER):&
   764   (175)          xmpbast)
   765   (176)  
   766   (177)  IMPORT (ROUTINE INTEGER,VOID(INTEGER WRITE):&
   767   (178)          xmpxets),&
   768   (179)         (ROUTINE INTEGER,VOID(INTEGER WRITE):&
   769   (180)          xmpxrts)
   770   (181)  
   771   (182)  %-----------------------------------------------------------------------------%
   772   (183)  $EOF
   773   (113)  
   774   (114)      % MON1 IS INBIT - read one byte from a device. This is how PLANC reaches a
   775   (115)      % monitor call: the runtime provides them as ordinary routines named MONn,
   776   (116)      % declared exactly like this, and the COSMOS guide's own sample does the
   777   (117)      % same thing one call along with IMPORT (ROUTINE VOID,VOID: MONO) for MON0.
   778   (118)      % The signature is copied from ND-60.117.5 appendix 0.2:
   779   (119)      %
   780   (120)      %     ROUTINE VOID, BYTE ( INTEGER ) : MON1 (dev)
   781   (121)      %
   782   (122)      % NOT MONITOR_CALL. That wants either a MON-CALL-NAMES file this machine
   783   (123)      % does not have, or generates 5MON_P which neither PLANC runtime defines.
   784   (124)      IMPORT ( ROUTINE VOID, BYTE (INTEGER) : MON1 )
   785   (125)  
   786   (126)      % ----- THE THREE MORE THAT CHAT:CNFG NEEDS ------------------------------
   787   (127)      % All copied from ND-60.117.5 EN PLANC Reference Manual, the MONn appendix,
   788   (128)      % which is the ONLY place these signatures are written down correctly:
   789   (129)      %
   790   (130)      %     ROUTINE VOID, INTEGER ( BYTES, BYTES, INTEGER ) : MON50 (file, default, code)
   791   (131)      %     ROUTINE BYTE, VOID ( INTEGER )                  : MON2  (dev)
   792   (132)      %     ROUTINE VOID, VOID ( INTEGER )                  : MON43 (dev)
   793   (133)      %
   794   (134)      % MON50 RETURNS THE DEVICE NUMBER and raises a ROUTINEERROR on failure - it
   795   (135)      % has no status out-parameter, so a missing file can only be learned by
   796   (136)      % catching the raise. MON2 takes the byte as its IN-VALUE, which is why it
   797   (137)      % is called "b MON2(dev)" and not "MON2(dev, b)".
   798   (138)      %
   799   (139)      % MON43 IS CLOSE, AND IT IS NOT 54. A note in this file used to list the
   800   (140)      % available calls as "50/54/1/2", which reads as though 54 were the close.
   801   (141)      % The manual's own table says otherwise: 43B is CloseFile and 54B is
   802   (142)      % DeleteFile. Getting that wrong would not have failed to compile - it
   803   (143)      % would have deleted the user's config file every time they set a nickname.
   804   (144)      IMPORT ( ROUTINE VOID, INTEGER (BYTES, BYTES, INTEGER) : MON50 )
   805   (145)      IMPORT ( ROUTINE BYTE, VOID (INTEGER) : MON2 )
   806   (146)      IMPORT ( ROUTINE VOID, VOID (INTEGER) : MON43 )
   807   (147)  
   808   (148)      % MON70 IS CALLCOMMAND - hand SINTRAN a line as if it had been typed.
   809   (149)      %
   810   (150)      %     ROUTINE VOID, VOID ( BYTES ) : MON70 (command)
   811   (151)      %
   812   (152)      % Needed because CREATING a file is its own monitor call, CreateFile /
   813   (153)      % CRALF 221B, and 221 is NOT among the MONn routines the PLANC runtime
   814   (154)      % provides - the appendix stops at MON263 and has no 221. MON50 opens what
   815   (155)      % exists; it has no size parameter and cannot make a file. See writeCnfg.
   816   (156)      IMPORT ( ROUTINE VOID, VOID (BYTES) : MON70 )
   817   (157)  
   818   (158)      % CreateFile, CRALF 221B - TESTED, AND IT IS NOT THERE.
   819   (159)      %
   820   (160)      %   Brl: LIST-ENTRIES-UNDEFINED
   821   (161)      %   MON221...10101 U
   822   (162)      %
   823   (163)      % The comment further down says 221 "is not among the MONn routines the PLANC
   824   (164)      % runtime provides", and the whole CREATE-FILE-through-MON70 detour rests on
   825   (165)      % it. That claim had never been TESTED - the list it came from is a floor
   826   (166)      % rather than a fence, since MON43 and MON70 are both missing from it and
   827   (167)      % both link - so it was worth one build to find out. It turns out to be
   828   (168)      % RIGHT: there is no MON221 on this machine, and the detour is justified.
   829   (169)      %
   830   (170)      % Measured on D100 2026-08-19, by importing each and reading the linker:
   831   (171)      %
   832   (172)      %   MON43  CloseFile        resolves      (absent from the documented list)
   833   (173)      %   MON70  CallCommand      resolves      (absent from the documented list)
   834   (174)      %   MON221 CreateFile       UNDEFINED
   835   (175)      %   MON317 ExecuteCommand   UNDEFINED
   836   (176)      %
   837   (177)      % So creating a file from PLANC on D100 needs the command route below, or
   838   (178)      % MON-CALL-1BANK:BRF linked in so Monitor_Call('CreateFile',...) works, or a
   839   (179)      % MAC interface routine for 221 loaded ahead of the runtime.
   840   (180)      %
   841   (181)      % The IMPORT is kept as a comment, not deleted, so nobody spends the cycle
   842   (182)      % again:
   843   (183)      %   IMPORT ( ROUTINE VOID, VOID (BYTES, INTEGER4, INTEGER4) : MON221 )
   844   (184)      %
   845   (185)      % Signature straight out of the VENDOR MANUAL - ND-860228-2-EN SINTRAN III
   846   (186)      % Monitor Calls, page 125, its own PLANC block:
   847   (187)      %
   848   (188)      %   INTEGER4 : StartAddress, NoOfPages
   849   (189)      %   BYTES : FileName(0:63)
   850   (190)      %   ON ROUTINEERROR DO
   851   (191)      %       IF ErrCode > 0 THEN ...
   852   (192)      %   ENDON
   853   (193)      %   Monitor_Call('CreateFile', FileName, StartAddress, NoOfPages)
   854   (194)      %
   855   (195)      % (Monitor_Call itself does not work on D100 - see PLANC-MONITOR-CALLS.md -
   856   (196)      % so the same three parameters go to MON221 instead.)
   857   (197)      %
   858   (198)      % A SIXTY-FOUR BYTE NAME BUFFER, for the same reason MON70 wants eighty: a
   859   (199)      % PLANC BYTES argument carries its own length, so a short literal hands the
   860   (200)      % call a short buffer. The manual's FORTRAN form agrees - CHARACTER
   861   (201)      % FileName*64.
   862   (202)      %
   863   (203)      % StartAddress 0 and NoOfPages 0 both mean "an ordinary indexed file that
   864   (204)      % grows as it is written", which is what a one-line config file wants. PLANC
   865   (205)      % cannot pass an INTEGER4 as a constant, so they are variables.
   866   (206)      %
   867   (207)      % ONE DISAGREEMENT WORTH KNOWING: the repo's own
   868   (208)      % Developer\MON\calls\221B_CreateFile.yaml lists both sizes as INTEGER2 in
   869   (209)      % its parameter table, while the MANUAL's PLANC, FORTRAN (INTEGER*4) and
   870   (210)      % COBOL (S9(10)) forms all say four bytes, and its MAC example calls the size
   871   (211)      % "a double word". The manual wins here; the YAML table looks like an
   872   (212)      % extraction slip.
   873   (213)      %
   874   (214)      % The IMPORT is commented out because MON221 does not link on this machine -
   875   (215)      % see the measurement above. Restore it if MON-CALL-1BANK:BRF is ever
   876   (216)      % installed, or if a MAC interface routine for 221 is written.
   877   (217)      %   IMPORT ( ROUTINE VOID, VOID (BYTES, INTEGER4, INTEGER4) : MON221 )
   878   (218)  
   879   (219)      % MON317 - ExecuteCommand, UECOM 317B - IS NOT AVAILABLE ON D100. TESTED.
   880   (220)      %
   881   (221)      % It was imported here and used instead of MON70, because the Monitor Calls
   882   (222)      % manual recommends it ("An error message is output if an error occurs. The
   883   (223)      % program does not terminate") and an error message is exactly what this
   884   (224)      % stubborn CREATE needed. The linker answered:
   885   (225)      %
   886   (226)      %   Brl: LIST-ENTRIES-UNDEFINED
   887   (227)      %   MON317...10020 U
   888   (228)      %
   889   (229)      % So the PLANC runtime on this machine carries no MON317, and the import is
   890   (230)      % left here as a COMMENT rather than deleted so nobody spends the cycle
   891   (231)      % again. Reaching UECOM would need a hand-written MAC interface routine
   892   (232)      % loaded ahead of PLANC-1BANK-F00.
   893   (233)      %
   894   (234)      % AND THE BUILD DID NOT FAIL. BRF-LINKER wrote a runnable CHAT:PROG with the
   895   (235)      % entry still undefined, @CHAT started it, and it behaved oddly in a way
   896   (236)      % that looked like evidence about the CREATE. It was not evidence about
   897   (237)      % anything. LIST-ENTRIES-UNDEFINED is in the build for this reason and its
   898   (238)      % output has to be READ - nothing else fails.
   899   (239)  
   900   (240)      % ----- message kinds, mirroring ChatMessageKind.cs ----------------------
   901   (241)      INTEGER : kJoin    := 1
   902   (242)      INTEGER : kWelcome := 2
   903   (243)      INTEGER : kReject  := 3
   904   (244)      INTEGER : kSay     := 4
   905   (245)      INTEGER : kSaid    := 5
   906   (246)      INTEGER : kLeave   := 6
   907   (247)      INTEGER : kJoined  := 7
   908   (248)      INTEGER : kLeft    := 8
   909   (249)      INTEGER : kRename  := 9
   910   (250)      INTEGER : kRenamed := 10
   911   (251)  
   912   (252)      % ONE KIND, BOTH DIRECTIONS. We send it with an empty text to ask; the room
   913   (253)      % answers with the same kind and the members' names in the text, separated
   914   (254)      % by single spaces. A second kind for the reply would buy nothing - we know
   915   (255)      % we asked, and a room never asks us.
   916   (256)      %
   917   (257)      % This is the eleventh kind, and the note that stood here saying there was
   918   (258)      % no eleventh kind is now wrong and has gone. What it warned about still
   919   (259)      % holds and is worth keeping in plain words: kHello lived here for one day
   920   (260)      % as half of a handshake we invented, and it was wrong because the sender's
   921   (261)      % address arrives WITH the message - there was nothing to hand shake about.
   922   (262)      % /who is different: the membership list is real information that only the
   923   (263)      % room has, so there is something to ask for.
   924   (264)      INTEGER : kWho     := 11
   925   (265)  
   926   (266)      INTEGER : ownTerminal := 1        % device number of your own terminal
   927   (267)      % BACK TO 0, AND 1 IS WORSE. BOTH VALUES MEASURED ON D100, 2026-08-21.
   928   (268)      %
   929   (269)      % With 0: TerminalNoWait SUCCEEDS - no error - and MON1 still blocks, so a
   930   (270)      % listener sees nothing until they press return, at which point the queued
   931   (271)      % lines all arrive at once:
   932   (272)      %
   933   (273)      %     ANNA:
   934   (274)      %     ANNA: NOWAIT-PROOF-LINE
   935   (275)      %
   936   (276)      % With 1: NOTHING IS SHOWN AT ALL, not even on return. The client still
   937   (277)      % joins - X-C LIST-NAMES showed its seat spent - and the server still sends
   938   (278)      % to it: its log recorded "SV bcast sent to  2" for the very lines that
   939   (279)      % never appeared. So the messages arrive at a client that displays none of
   940   (280)      % them, which is strictly worse than the press-return behaviour.
   941   (281)      %
   942   (282)      % 0 IS THEREFORE THE SAFE VALUE UNTIL THIS IS UNDERSTOOD. What 1 actually
   943   (283)      % does is UNVERIFIED - the obvious guess is that it switches the side the
   944   (284)      % terminal READ waits on and the loop then never blocks NOR draws, but
   945   (285)      % nothing has been measured to say so, and the guess that 0 meant "output"
   946   (286)      % has already been wrong once here.
   947   (287)      %
   948   (288)      % THE NOTE THAT USED TO SIT HERE IS NO LONGER TRUE, and it is corrected
   949   (289)      % rather than deleted because it would send the next reader down a dead end.
   950   (290)      % It said: "terminalWait, the restore on exit, calls NoWaitSwitch - the name
   951   (291)      % that is REFUSED on this machine - so the terminal is never actually put
   952   (292)      % back. That wants fixing before any more experiments with this flag."
   953   (293)      %
   954   (294)      % IT WAS FIXED. terminalWait now calls TerminalNoWait FIRST and only falls
   955   (295)      % back to NoWaitSwitch if that raises, which is the same order terminalNoWait
   956   (296)      % uses. The restore does happen. Checked 2026-08-22 by reading the routine,
   957   (297)      % not by assuming the note was current.
   958   (298)      %
   959   (299)      % Worth saying because this codebase has been caught by a stale comment
   960   (300)      % before: one claiming MONITOR_CALL by name could not work here outlived the
   961   (301)      % installation of the package that makes it work, and cost a day of designing
   962   (302)      % around a wall that was not there. A comment is a claim with a date on it.
   963   (303)      INTEGER : inputFlag   := 0
   964   (304)      INTEGER : noWaitOn    := 1        % any non-zero switches no-wait ON
   965   (305)      INTEGER : noWaitOff   := 0        % and zero switches it back off again
   966   (306)      INTEGER : parityMask  := 127      % strip the even-parity bit, see above
   967   (307)      INTEGER : carriageRet := 13
   968   (308)      INTEGER : emptyInput  := 3        % InByte in no-wait: nothing was typed
   969   (309)  
   970   (310)      % The idle sleep, so the poll loop is a POLL and not a SPIN. Unit type 1 is
   971   (311)      % basic time units of 1/50 second, so 10 is a fifth of a second: fast enough
   972   (312)      % that an arriving line looks instant, slow enough to cost nothing.
   973   (313)      %
   974   (314)      % CHATSV carries the hard-won version of this note: a bare loop with no
   975   (315)      % sleep is not an option. When XMSG died under the server, its receive
   976   (316)      % stopped blocking and the loop burned the machine until somebody pressed
   977   (317)      % ESC. The same trap is waiting here the moment the terminal stops blocking.
   978   (318)      INTEGER : sleepUnits := 10
   979   (319)      INTEGER : sleepKind  := 1
   980   (320)      INTEGER : sleepWhy   := 0
   981   (321)  
   982   (322)      % How many messages the last drain pass printed. Set by drainPort, read by
   983   (323)      % the main loop to decide whether the pass found anything at all.
   984   (324)      INTEGER : lastDrainCount := 0
   985   (325)  
   986   (326)      % The ErrCode from the last refused no-wait switch. Module level because a
   987   (327)      % PLANC local cannot be read after its ON block has run, and the number is
   988   (328)      % the whole point of the attempt - see terminalNoWait.
   989   (329)      INTEGER : firstErr := 0
   990   (330)      % How many messages one drain pass will take before going back to the
   991   (331)      % keyboard. See drainPort: the unbounded version hung on the first run.
   992   (332)      INTEGER : maxDrain    := 32
   993   (333)  
   994   (334)      INTEGER ARRAY : stack(0:1000)
   995   (335)  
   996   (336)      BYTES : letterBuf(0:63)           % the XSLET header XMPBLET builds
   997   (337)      BYTES : outBuf(0:255)             % our own message, sent after the header
   998   (338)      % SIZE OF inBuf, named because the read below must clamp against it. XMSG
   999   (339)      % reports the sender's message size; nothing stops that being larger than
  1000   (340)      % this array, and PLANC checks no bound.
  1001   (341)      INTEGER : inBufSize := 256
  1002   (342)      BYTES : inBuf(0:255)              % what arrives, inBufSize bytes
  1003   (343)      % THE LINE BEING TYPED, and its size is a named constant because the loop
  1004   (344)      % below has to test against it. PLANC does not check array bounds: without
  1005   (345)      % the test, an 81st character is written past the end of this array and into
  1006   (346)      % whatever the compiler laid out next - which here is roomName, typedLen,
  1007   (347)      % serverMagic and joined. A user holding a key down would quietly corrupt
  1008   (348)      % the program's own state.
  1009   (349)      % THE LONGEST ROOM OR NICK NAME a command may carry. This was USED by
  1010   (350)      % handleCommand and never DECLARED - the compiler answered ILLEGAL SYNTAX
  1011   (351)      % "MAXNAMELEN" twice, the loader pass built CHAT:PROG regardless, and every
  1012   (352)      % /join and /nick then answered "too long" for any argument at all. A build
  1013   (353)      % with errors still produces a program; only the LISTING says otherwise.
  1014   (354)      INTEGER : maxNameLen := 16
  1015   (355)      INTEGER : maxTyped := 80
  1016   (356)      BYTES : typed(0:79)               % 0:maxTyped-1
  1017   (357)  
  1018   (358)      % One character wide, so a BYTE can be printed as a CHARACTER: 'ALn' formats
  1019   (359)      % a STRING, and handing it a byte prints the byte's NUMBER instead. See
  1020   (360)      % showArrived, where that turned RONNY into 8279787889 on screen.
  1021   (361)      BYTES : oneChar(0:0)
  1022   (362)  
  1023   (363)      % TWENTY-ONE BYTES OF STORAGE, NOT A LITERAL - and this was a live defect,
  1024   (364)      % not tidying. It was BYTES : roomName := 'CHAT-LOBBY', exactly ten bytes,
  1025   (365)      % while /join accepts an argument up to maxNameLen = 16 and copies it in
  1026   (366)      % here. Eleven characters onwards wrote past the end, into whatever the
  1027   (367)      % loader laid out next. The comment on "typed" above already warns that
  1028   (368)      % roomName is what an overlong typed line runs into; roomName had the same
  1029   (369)      % fault pointing at whatever follows IT.
  1030   (370)      %
  1031   (371)      % Twenty-one is the prefix (5) plus the room's own limit (16).
  1032   (372)      BYTES : roomName(0:20)
  1033   (373)      INTEGER : lenRoomName := 10
  1034   (374)  
  1035   (375)      % THE PREFIX EVERY ROOM'S REGISTERED NAME CARRIES, and forgetting it is
  1036   (376)      % why /join never worked.
  1037   (377)      %
  1038   (378)      % ChatRooms.NamePrefix in the C# library says "CHAT-", and ChatRooms.NameFor
  1039   (379)      % builds "CHAT-" + the room's short name in upper case. So the LOBBY room is
  1040   (380)      % registered with XROUT as CHAT-LOBBY. /join used to copy the typed argument
  1041   (381)      % in raw, so "/join GENERAL" asked XROUT for a name called GENERAL - which no
  1042   (382)      % room ever registers. XROUT answered "no such name" and the client sat in
  1043   (383)      % the room it was already in, which is exactly the reported symptom.
  1044   (384)      %
  1045   (385)      % The startup default below is built the same way, from the prefix and the
  1046   (386)      % short name, so there is one rule and not two.
  1047   (387)      % THE SERVICE NAME. A CONSTANT - it is not built from the room any more.
  1048   (388)      %
  1049   (389)      % This used to be roomPrefix := 'CHAT-', and setRoom pasted the typed room
  1050   (390)      % onto it to make a PORT NAME, so joining a room meant addressing a
  1051   (391)      % different port. One port now; the room rides in the message. See
  1052   (392)      % the_room_model in DOC/protocols/chat-wire.json.
  1053   (393)      BYTES : servName := '*CHAT'
  1054   (394)      INTEGER : lenServName := 5
  1055   (395)  
  1056   (396)      % The room joined at start-up when nobody says otherwise. SHORT name: the
  1057   (397)      % prefix is added by setRoom, the same as for a typed /join.
  1058   (398)      BYTES : homeRoom := 'LOBBY'
  1059   (399)      INTEGER : lenHomeRoom := 5
  1060   (400)      BYTES : hereSystem := ''          % length 0 means the LOCAL system
  1061   (401)      INTEGER : lenHereSystem := 0
  1062   (402)  
  1063   (403)      % SIXTEEN BYTES OF STORAGE, NOT A LITERAL, and the change is not cosmetic.
  1064   (404)      %
  1065   (405)      % This was BYTES : myName := 'RONNY', which reserves five bytes and exactly
  1066   (406)      % five. Asking for a longer name would have written past the end of it into
  1067   (407)      % whatever the loader happened to put next, with nothing to stop it - PLANC
  1068   (408)      % checks no array bound. The same defect, in the other direction, is what
  1069   (409)      % the guard in CHATSV.handleMessage exists for.
  1070   (410)      %
  1071   (411)      % Sixteen is the ROOM's number: ChatRoom.MaxNicknameLength says sixteen and
  1072   (412)      % CHATSV drops anything longer, so a name this side cannot send is one the
  1073   (413)      % other side would refuse anyway.
  1074   (414)      BYTES : myName(0:15)
  1075   (415)      INTEGER : lenMyName := 5
  1076   (416)  
  1077   (417)      % The name used when nobody types one AND nothing was remembered. Kept as a
  1078   (418)      % separate literal because myName is now a buffer and has to be filled at
  1079   (419)      % start-up rather than declared full - see setupName.
  1080   (420)      % THE LAST RESORT, and it should not be a person's name. A hardcoded RONNY
  1081   (421)      % turning up on somebody else's terminal is the same kind of wrong as the
  1082   (422)      % OLAV that arrived from a config file written during testing. It is only
  1083   (423)      % reached when SINTRAN itself will not say who is logged in.
  1084   (424)      BYTES : defaultName := 'USER'
  1085   (425)      INTEGER : lenDefault := 4
  1086   (426)  
  1087   (427)      % Where GetUserName writes. SINTRAN pads the answer, so the name ends at the
  1088   (428)      % first space and the buffer is deliberately wider than maxNameLen.
  1089   (429)      BYTES : sintranUser(0:31)
  1090   (430)  
  1091   (431)      % How much of sintranUser is the name. ZERO means SINTRAN would not say, and
  1092   (432)      % that is the state every check below must cope with - see readCnfg, which
  1093   (433)      % refuses to trust a remembered nickname when it cannot tell whose it is.
  1094   (434)      INTEGER : lenSintranUser
  1095   (435)  
  1096   (436)      % THE OTHER FOUR PARAMETERS OF GetUserName, and the reason they exist here.
  1097   (437)      %
  1098   (438)      % The call was first written with ONE argument and answered "refused" every
  1099   (439)      % time. The OVERVIEW table lists only the first parameter -
  1100   (440)      %
  1101   (441)      %     | **GetUserName** (GUSNA 214B) | | | | | |
  1102   (442)      %     | 1. User name                 | STR | O | | . | . |
  1103   (443)      %
  1104   (444)      % - and the DETAIL PAGE gives the real shape:
  1105   (445)      %
  1106   (446)      %     Monitor_Call('GetUserName', UserName(1:16), DirIndex, UserIndex,
  1107   (447)      %                  RemoteFlag, RemoteSystem(1:64))
  1108   (448)      %
  1109   (449)      % FIVE arguments. The same mistake as StartRTProgram: reading the summary
  1110   (450)      % row instead of opening the entry. A monitor call given the wrong number of
  1111   (451)      % arguments is REFUSED, exactly as if it were not permitted, so the two look
  1112   (452)      % identical from the outside and one gets mistaken for the other.
  1113   (453)      INTEGER : dirIndex
  1114   (454)      INTEGER : userIndex
  1115   (455)      INTEGER : remoteFlag
  1116   (456)      BYTES : remoteSystem(0:63)
  1117   (457)  
  1118   (458)      % ----- CHAT:CNFG, the remembered nickname -------------------------------
  1119   (459)      % IN THE USER'S OWN FILE AREA, which is the whole point: OLAV and ANNA log
  1120   (460)      % in as themselves and each gets their own. Nothing here names a user -
  1121   (461)      % SINTRAN resolves an unqualified name against whoever is logged in, so the
  1122   (462)      % separation is free and cannot be got wrong.
  1123   (463)      %
  1124   (464)      % MEASURED 2026-08-18 on D100: user OLAV, "@CREATE-FILE CHAT:CNFG,1"
  1125   (465)      % succeeded and "@CHAT" ran from that user's terminal, so both halves - a
  1126   (466)      % writable file of one's own, and permission to run the client - are real
  1127   (467)      % rather than assumed.
  1128   (468)      %
  1129   (469)      % THE FILE IS ONE LINE: the nickname, ended by a carriage return.
  1130   (470)      % Deliberately not a key=value format. There is one setting, a reader that
  1131   (471)      % has to parse nothing cannot misparse anything, and a person can fix it
  1132   (472)      % with any editor on the machine.
  1133   (473)      BYTES : cnfgName   := 'CHAT'
  1134   (474)      BYTES : cnfgType   := 'CNFG'
  1135   (475)  
  1136   (476)      % MAKING THE FILE IS A COMMAND, NOT AN OPEN, and that cost a build cycle.
  1137   (477)      %
  1138   (478)      % The first version passed the name QUOTED to MON50 - '"CHAT"' - on the
  1139   (479)      % rule that quoting is what asks SINTRAN to create. MEASURED 2026-08-18 as
  1140   (480)      % user ANNA, who had no config file: the open did not fail loudly, but
  1141   (481)      % every MON2 after it raised, and afterwards LIST-FILES showed ANNA still
  1142   (482)      % owned no files at all. Nothing was created.
  1143   (483)      %
  1144   (484)      % The reason is in the manual rather than in the quoting: creating a file
  1145   (485)      % is its OWN monitor call, CreateFile / CRALF 221B, and 221 is not among
  1146   (486)      % the MONn routines the PLANC runtime provides. MON50 opens; it has no size
  1147   (487)      % parameter and cannot make a file that is not there.
  1148   (488)      %
  1149   (489)      % So the file is made the way a person would make it, by handing SINTRAN
  1150   (490)      % the command - MON70, CallCommand. One page, which is far more than one
  1151   (491)      % line needs.
  1152   (492)      %
  1153   (493)      % NO QUOTES, AND THE QUOTES ARE WHY THIS NEVER WORKED.
  1154   (494)      %
  1155   (495)      % This read 'CREATE-FILE "CHAT:CNFG",1' from the day it was written, and
  1156   (496)      % measured on D100 2026-08-19 that command answers
  1157   (497)      %
  1158   (498)      %   @CREATE-FILE "CHAT:CNFG",1
  1159   (499)      %   ILLEGAL CHARACTER IN PARAMETER
  1160   (500)      %
  1161   (501)      % while the unquoted form succeeds silently. So the file was NEVER created,
  1162   (502)      % every save failed, and CHAT:CNFG did not exist for any user.
  1163   (503)      %
  1164   (504)      % THE TRAP IS THAT QUOTES MEAN OPPOSITE THINGS ON THE TWO ROUTES:
  1165   (505)      %
  1166   (506)      %   MON50(file, ...)   quoting the name means CREATE IT IF ABSENT
  1167   (507)      %   CREATE-FILE <name> quoting the name is an ILLEGAL CHARACTER
  1168   (508)      %
  1169   (509)      % The quotes here were carried over from the MON50 attempt described above,
  1170   (510)      % where they were correct, into the command that replaced it, where they are
  1171   (511)      % fatal. A local filespec takes no quotes; the quoting rule is for REMOTE
  1172   (512)      % ones, where the name goes to another machine's command processor.
  1173   (513)      %
  1174   (514)      % AND THE COMMAND MUST END WITH AN APOSTROPHE, which is the second half of
  1175   (515)      % why this never worked. Removing the quotes alone was not enough - measured
  1176   (516)      % on D100 2026-08-19, CHAT:CNFG still did not appear.
  1177   (517)      %
  1178   (518)      % The Monitor Calls manual's own worked example gives the rule, in its
  1179   (519)      % ASSEMBLY-500 section under CallCommand:
  1180   (520)      %
  1181   (521)      %   Command : STRINGDATA 'CLOSE-FILE 102'''
  1182   (522)      %
  1183   (523)      % - that trailing triple apostrophe is the string's closing quote plus ONE
  1184   (524)      % apostrophe character, so the command handed to SINTRAN is
  1185   (525)      % "CLOSE-FILE 102'". The apostrophe TERMINATES the command; without it the
  1186   (526)      % command processor keeps reading past the end of the buffer into whatever
  1187   (527)      % follows, and the command never runs as written.
  1188   (528)      %
  1189   (529)      % In PLANC an apostrophe inside a literal is written doubled, so the line
  1190   (530)      % below is CREATE-FILE CHAT:CNFG,1 followed by one apostrophe.
  1191   (531)      BYTES : cnfgMake := 'CREATE-FILE CHAT:CNFG,1'''
  1192   (532)  
  1193   (533)      % EIGHTY BYTES, BECAUSE THAT IS THE BUFFER MON70 IS DEFINED TO TAKE - and
  1194   (534)      % this, not the quoting and not the terminator, is why the file was never
  1195   (535)      % created. Both earlier fixes were real and neither changed the outcome.
  1196   (536)      %
  1197   (537)      % The Monitor Calls manual gives the PLANC form of CallCommand as
  1198   (538)      %
  1199   (539)      %   BYTES : Command(0:79)
  1200   (540)      %
  1201   (541)      % an EIGHTY-BYTE ARRAY. A PLANC BYTES argument carries its own length, so
  1202   (542)      % handing MON70 a 25-byte literal hands it a 25-byte buffer where it expects
  1203   (543)      % eighty - the same defect that made XROUT look up a room name with eleven
  1204   (544)      % bytes of leftovers on the end, in the other direction.
  1205   (545)      %
  1206   (546)      % So the command is COPIED into a full-size buffer, apostrophe-terminated,
  1207   (547)      % and the rest left as spaces. See makeCnfg.
  1208   (548)      INTEGER : lenCnfgMake := 24
  1209   (549)      BYTES : cmdBuf(0:79)
  1210   (550)      INTEGER : cmdBufSize := 80
  1211   (551)      BYTES : spaceChar := ' '
  1212   (552)  
  1213   (553)      % ----- CreateFile, the direct route -------------------------------------
  1214   (554)      % The FULL filespec, name and type together - the manual's example creates
  1215   (555)      % 'NAME-STORAGE:DATA' in one string - in the 64-byte buffer MON221 expects.
  1216   (556)      % One line of CHAT:CNFG, read whole before any of it is believed. Wider than
  1217   (557)      % maxNameLen because it holds OWNER:NICK, not just a nickname.
  1218   (558)      BYTES : cnfgLine(0:63)
  1219   (559)  
  1220   (560)      BYTES : cnfgFull := 'CHAT:CNFG'
  1221   (561)      INTEGER : lenCnfgFull := 9
  1222   (562)      BYTES : nameBuf(0:63)
  1223   (563)      INTEGER : nameBufSize := 64
  1224   (564)      INTEGER4 : startAddr := 0         % 0 = let SINTRAN place it
  1225   (565)      INTEGER4 : noOfPages := 0         % 0 = indexed, grows when written
  1226   (566)  
  1227   (567)      % Access codes for MON50, from the Monitor Calls manual's own table:
  1228   (568)      %   0  sequential write
  1229   (569)      %   1  sequential read
  1230   (570)      INTEGER : openRead  := 1
  1231   (571)      INTEGER : openWrite := 0
  1232   (572)  
  1233   (573)      % A "nameRemembered" BOOLEAN stood here, to word the prompt differently for
  1234   (574)      % a remembered name than for the built-in one. It was set and never read.
  1235   (575)      % The prompt shows the actual name either way, which answers the same
  1236   (576)      % question better than a different wording would have.
  1237   (577)  
  1238   (578)      INTEGER : myPort
  1239   (579)      INTEGER : returnStatus
  1240   (580)      INTEGER : offSet, uLength, wLength
  1241   (581)      INTEGER : msgType, remotePortHash, nBytes, readLength, readAmount
  1242   (582)      INTEGER : typedLen := 0
  1243   (583)      INTEGER : ch
  1244   (584)      % MON1's out-value is a BYTE, so it lands here first and is widened into ch
  1245   (585)      % before the parity bit is masked off.
  1246   (586)      BYTE : rawCh
  1247   (587)      INTEGER4 : senderMagic
  1248   (588)      % ZERO until the welcome arrives and reveals the real address. It is set
  1249   (589)      % explicitly rather than left to whatever the loader put there, because the
  1250   (590)      % joined test below is what keeps it from ever being used - and a guard is
  1251   (591)      % worth more when the thing it guards is a known value.
  1252   (592)      INTEGER4 : serverMagic := 0
  1253   (593)      % An INTEGER4 myMagic lived here to hold our own port's magic number, read
  1254   (594)      % with XMPFP2M purely so a diagnostic could print it. Both are gone - see
  1255   (595)      % the note in chatClient for what they settled (the reply address was
  1256   (596)      % correct all along) and why that ended the need for them.
  1257   (597)      BOOLEAN : joined := FALSE
  1258   (598)  
  1259   (599)      % Has the user CHOSEN a name with /nick this session?
  1260   (600)      %
  1261   (601)      % This exists to tell two refusals apart, because they arrive on the SAME
  1262   (602)      % kReject and mean completely different things to the person reading them:
  1263   (603)      %
  1264   (604)      %   FALSE - we joined under the name SINTRAN gave us, and the room says it is
  1265   (605)      %           taken. That means the SAME SINTRAN USER is already in the room
  1266   (606)      %           from ANOTHER TERMINAL. Say exactly that.
  1267   (607)      %   TRUE  - the user typed /nick ANNA and ANNA is taken. Telling them they are
  1268   (608)      %           "already in from another terminal" would be FALSE and confusing -
  1269   (609)      %           somebody else has that name.
  1270   (610)      %
  1271   (611)      % Set once, never cleared: after any /nick, every later refusal is about a
  1272   (612)      % name the user picked.
  1273   (613)      BOOLEAN : userChoseNick := FALSE
  1274   (614)  
  1275   (615)      % Said once. A refused sleep every fifth of a second is a flood that hides
  1276   (616)      % itself, so idleSleep speaks the first time and stays quiet after.
  1277   (617)      BOOLEAN : sleepBroken := FALSE
  1278   (618)      % TRUE once RETURN has been seen, so a line half typed when the port
  1279   (619)      % needs draining survives the trip round the outer loop.
  1280   (620)      BOOLEAN : lineReady := FALSE
  1281   (621)      BOOLEAN : running := TRUE
  1282   (622)  
  1283   (623)      % -----------------------------------------------------------------------
  1284   (624)      % Build one of our messages into outBuf. Returns its total length.
  1285   (625)      %
  1286   (626)      % Same layout as ChatMessage.cs, which is the only specification it has:
  1287   (627)      % kind, name length, name, two length bytes, text.
  1288   (628)      %
  1289   (629)      % THE EXACT BYTES ARE PINNED in
  1290   (630)      % SRC/Xmsg.Chat.Tests/ChatMessageGoldenBytesTests.cs - a Said, a Renamed, a
  1291   (631)      % Join and a 300-character line that proves the text length is big-endian.
  1292   (632)      % There is no shared code between that and this, only those goldens, so if
  1293   (633)      % the layout ever changes both sides change in the SAME commit or they
  1294   (634)      % disagree in silence.
  1295   (635)      % -----------------------------------------------------------------------
  1296   (636)      % -----------------------------------------------------------------------
  1297   (637)      % Build the JOIN. Same layout as any other message - kind, nickname, text -
  1298   (638)      % but the TEXT carries the ROOM this time.
  1299   (639)      %
  1300   (640)      % THAT IS WHY THIS COSTS NO WIRE CHANGE. A Join always had an empty text
  1301   (641)      % field; only what goes in it is new. message_prefix does not move and the
  1302   (642)      % golden bytes keep their shape - just their content for Join.
  1303   (643)      % -----------------------------------------------------------------------
  1304   (644)      ROUTINE VOID, INTEGER : buildJoin
  1305   (645)          INTEGER : i, at
  1306   (646)          kJoin =: outBuf(0)
  1307   (647)          lenMyName =: outBuf(1)
  1308   (648)          2 =: at
  1309   (649)          FOR i IN 1:lenMyName DO
  1310   (650)              myName(i - 1) =: outBuf(at)
  1311   (651)              at + 1 =: at
  1312   (652)          ENDFOR
  1313   (653)          % Text length, high byte then low. A room name is far short of 256.
  1314   (654)          0 =: outBuf(at)
  1315   (655)          lenRoomName =: outBuf(at + 1)
  1316   (656)          at + 2 =: at
  1317   (657)          FOR i IN 1:lenRoomName DO
  1318   (658)              roomName(i - 1) =: outBuf(at)
  1319   (659)              at + 1 =: at
  1320   (660)          ENDFOR
  1321   (661)          at RETURN
  1322   (662)      ENDROUTINE
  1323   (663)  
  1324   (664)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : buildOwn(kind, textLength)
  1325   (665)          INTEGER : i, at
  1326   (666)          kind =: outBuf(0)
  1327   (667)          lenMyName =: outBuf(1)
  1328   (668)          2 =: at
  1329   (669)          % SUBSCRIPT FROM ZERO. myName is a BYTES declared from a literal, so its
  1330   (670)          % first character is at index 0. This said myName(i) and that is why the
  1331   (671)          % server saw the nickname as ONNY, not RONNY: the R was skipped and one
  1332   (672)          % byte was read past the end of the string. MEASURED 2026-08-18 in a raw
  1333   (673)          % dump of the arriving letter - the length byte said 5 and the five bytes
  1334   (674)          % were 'O','N','N','Y',0. Nothing reports this; PLANC checks no bound,
  1335   (675)          % and a wrong name is not an error to anyone. Compare cmdIs below, which
  1336   (676)          % has always had it right with word(i - 1).
  1337   (677)          FOR i IN 1:lenMyName DO
  1338   (678)              myName(i - 1) =: outBuf(at)
  1339   (679)              at + 1 =: at
  1340   (680)          ENDFOR
  1341   (681)          0 =: outBuf(at)
  1342   (682)          textLength =: outBuf(at + 1)
  1343   (683)          at + 2 =: at
  1344   (684)          FOR i IN 1:textLength DO
  1345   (685)              typed(i - 1) =: outBuf(at)
  1346   (686)              at + 1 =: at
  1347   (687)          ENDFOR
  1348   (688)          % The out-value goes BEFORE the keyword. ND-60.117.5 prints it as
  1349   (689)          % "result RETURN" in the complex-addition example; writing "RETURN at"
  1350   (690)          % makes the compiler read RETURN as a type and answer
  1351   (691)          % ILLEGAL DATA TYPE "RETURN".
  1352   (692)          at RETURN
  1353   (693)      ENDROUTINE
  1354   (694)  
  1355   (695)      % -----------------------------------------------------------------------
  1356   (696)      % Build a RENAME, which does NOT have the same shape as every other
  1357   (697)      % message and is the one place buildOwn cannot be used.
  1358   (698)      %
  1359   (699)      % THE NEW NAME GOES IN THE NAME FIELD, and the text is empty. This client
  1360   (700)      % had it the other way round - new name in the TEXT, current name in the
  1361   (701)      % NAME field - and the rename was thrown away in silence every time.
  1362   (702)      %
  1363   (703)      % MEASURED 2026-08-18 on D100: "/nick OLAV" was accepted by the client,
  1364   (704)      % sent, and changed nothing; the room went on saying RONNY. Nothing was
  1365   (705)      % printed by either side, because the path it took is a deliberate
  1366   (706)      % do-nothing:
  1367   (707)      %
  1368   (708)      %   the server reads the new name from the NAME field;
  1369   (709)      %   the client had put the CURRENT name there;
  1370   (710)      %   so sameName(slot, ...) matched, and the server took its
  1371   (711)      %   "already your name: not news" RETURN, which prints nothing.
  1372   (712)      %
  1373   (713)      % TWO WRONG THINGS AGREEING TO DO NOTHING. Each side was self-consistent
  1374   (714)      % and the pair was broken, which is why it survived a working build.
  1375   (715)      %
  1376   (716)      % THE C# PAIR IS THE ARBITER and it is unambiguous - ChatClient.Rename
  1377   (717)      % sends "new ChatMessage(ChatMessageKind.Rename, nickname, string.Empty)",
  1378   (718)      % the NEW nickname in the name field and an EMPTY text, and
  1379   (719)      % ChatServer.HandleRename reads it back with _room.TryRename(id,
  1380   (720)      % message.Nickname, ...). The PLANC SERVER already matched that. Only this
  1381   (721)      % side did not.
  1382   (722)      %
  1383   (723)      % The sender is identified by its MAGIC NUMBER, not by the name it sends -
  1384   (724)      % findByMagic(senderMagic) is what picks the seat - so the name field is
  1385   (725)      % free to carry the new name and nothing is lost by not sending the old one.
  1386   (726)      %
  1387   (727)      % myName is deliberately NOT changed here. Our own name changes when the
  1388   (728)      % room says so with kRenamed, so a refused rename leaves us as we were.
  1389   (729)      % -----------------------------------------------------------------------
  1390   (730)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : buildRename(nameFrom, newLength)
  1391   (731)          INTEGER : i, at
  1392   (732)          kRename =: outBuf(0)
  1393   (733)          newLength =: outBuf(1)
  1394   (734)          2 =: at
  1395   (735)          FOR i IN 1:newLength DO
  1396   (736)              typed(nameFrom + i - 1) =: outBuf(at)
  1397   (737)              at + 1 =: at
  1398   (738)          ENDFOR
  1399   (739)          % An empty text, spelled out as its two length bytes.
  1400   (740)          0 =: outBuf(at)
  1401   (741)          0 =: outBuf(at + 1)
  1402   (742)          at + 2 =: at
  1403   (743)          at RETURN
  1404   (744)      ENDROUTINE
  1405   (745)  
  1406   (746)      % -----------------------------------------------------------------------
  1407   (747)      % Say what "no access" actually means, because the number alone sends
  1408   (748)      % people to the wire.
  1409   (749)      %
  1410   (750)      % XRUNN and XRNRO are the same fault seen from two sides, and BOTH mean the
  1411   (751)      % peer has not been told to trust this system. XRUNN reads "unknown name of
  1412   (752)      % server or system" and it is the SYSTEM half of that phrase - not the
  1413   (753)      % server half - which is what sent two earlier investigations chasing
  1414   (754)      % *CHATSV when the room was fine.
  1415   (755)      %
  1416   (756)      % Everything else looks healthy while this is wrong: the peer lists the
  1417   (757)      % system, LIST-SYSTEMS says ON NET, LIST-LINKS says State Run with
  1418   (758)      % thousands of frames received. Nothing comes back because the rejection
  1419   (759)      % happens before XROUT is asked, so there is no error to send.
  1420   (760)      % -----------------------------------------------------------------------
  1421   (761)      ROUTINE VOID, VOID : showFriendAdvice
  1422   (762)          OUTPUT(1, 'AL48', 'the PEER has not defined us as a FRIEND system.$')
  1423   (763)          OUTPUT(1, 'AL26', 'on that machine:  @X-COMM$')
  1424   (764)          OUTPUT(1, 'AL47', '  X-C: DEFINE-FRIEND-SYSTEM   System? <our no>$')
  1425   (765)          OUTPUT(1, 'AL44', 'check it with LIST-ROUTING-INFO - it prints$')
  1426   (766)          OUTPUT(1, 'AL40', '  "T: *, but no access to system NNNNN"$')
  1427   (767)          OUTPUT(1, 'AL45', 'NOTE: DEF-REMOTE CLEARS the friend entry, so$')
  1428   (768)          OUTPUT(1, 'AL46', 'the name comes first and the friend AFTER it.$')
  1429   (769)      ENDROUTINE
  1430   (770)  
  1431   (771)      ROUTINE VOID, VOID (BYTES, INTEGER) : showStatus(where, code)
  1432   (772)          % NOT "offset" - the module already has a global offSet for the letter, and
  1433   (773)          % PLANC ignores case, so that spelling collided with it and the compiler
  1434   (774)          % said IDENTIFIER ALREADY SPECIFIED/DECLARED.
  1435   (775)          %
  1436   (776)          % AND IT IS A RANGE, NOT A PLAIN INTEGER, because this is what CASE
  1437   (777)          % selects on. ND-60.117.5 section 6.3: the CASE expression "may have a
  1438   (778)          % maximum of 256 different values, and must be either an enumeration
  1439   (779)          % with a maximum of 256 different values, or integers ranging between 0
  1440   (780)          % and 255", with the note that an INTEGER RANGE used this way must have
  1441   (781)          % a lower bound of 0. A plain INTEGER spans -32768..32767, so the
  1442   (782)          % compiler answered OUT OF RANGE on both CASE statements - a WARNING,
  1443   (783)          % which is exactly the kind that gets skimmed past.
  1444   (784)          INTEGER RANGE (0:255) : xmxOffset
  1445   (785)  
  1446   (786)          OUTPUT(1, 'AL24', where)
  1447   (787)          OUTPUT(1, 'AL8', ' status ')
  1448   (788)          OUTPUT(1, 'I6', code)
  1449   (789)          OUTPUT(1, 'AL1', ' ')
  1450   (790)  
  1451   (791)          IF code = XMOK THEN
  1452   (792)              OUTPUT(1, 'AL12', 'XMOK - done$')
  1453   (793)              RETURN
  1454   (794)          ENDIF
  1455   (795)  
  1456   (796)          IF code < 0 THEN
  1457   (797)              OUTPUT(1, 'AL36', 'raw kernel error, not a library one$')
  1458   (798)              RETURN
  1459   (799)          ENDIF
  1460   (800)  
  1461   (801)          IF code < XMXKXXX THEN
  1462   (802)              OUTPUT(1, 'AL27', 'message type, not an error$')
  1463   (803)              RETURN
  1464   (804)          ENDIF
  1465   (805)  
  1466   (806)          % XROUT ERRORS SIT ABOVE THE KERNEL ONES, at their own base
  1467   (807)          % XRXXX = 16960 = 41100B, so this test has to come FIRST - the XMX
  1468   (808)          % block below would otherwise decode 16972 as XMX offset 76 and say
  1469   (809)          % nothing useful. Two of these are the same fault wearing two names,
  1470   (810)          % and it is the one that costs a whole evening every time, so it gets
  1471   (811)          % told in full rather than named.
  1472   (812)          IF code >= XRXXX THEN
  1473   (813)              code - XRXXX =: xmxOffset
  1474   (814)              CASE xmxOffset
  1475   (815)                  INCASE 2
  1476   (816)                      OUTPUT(1, 'AL39', 'XRUNN unknown name of server OR SYSTEM$')
  1477   (817)                      showFriendAdvice
  1478   (818)                  INCASE 12
  1479   (819)                      OUTPUT(1, 'AL33', 'XRNRO no access to remote system$')
  1480   (820)                      showFriendAdvice
  1481   (821)                  INCASE 0
  1482   (822)                      OUTPUT(1, 'AL24', 'XRSOK ok - not an error$')
  1483   (823)                  INCASE 1
  1484   (824)                      OUTPUT(1, 'AL29', 'XRISN illegal service number$')
  1485   (825)                  INCASE 3
  1486   (826)                      OUTPUT(1, 'AL41', 'XRDDF another port already has this name$')
  1487   (827)                  INCASE 4
  1488   (828)                      OUTPUT(1, 'AL30', 'XRNSP no space left for names$')
  1489   (829)                  INCASE 7
  1490   (830)                      OUTPUT(1, 'AL27', 'XRUNM unknown magic number$')
  1491   (831)                  INCASE 10
  1492   (832)                      OUTPUT(1, 'AL32', 'XRPRV caller was not privileged$')
  1493   (833)                  INCASE 11
  1494   (834)                      OUTPUT(1, 'AL38', 'XRISY illegal system number parameter$')
  1495   (835)                  ELSE
  1496   (836)                      OUTPUT(1, 'AL23', 'XROUT error, XR offset ')
  1497   (837)                      OUTPUT(1, 'I6', xmxOffset)
  1498   (838)                      OUTPUT(1, 'AL1', '$')
  1499   (839)              ENDCASE
  1500   (840)              RETURN
  1501   (841)          ENDIF
  1502   (842)  
  1503   (843)          code - XMXKXXX =: xmxOffset
  1504   (844)          CASE xmxOffset
  1505   (845)              INCASE 0
  1506   (846)                  OUTPUT(1, 'AL39', 'XMXENTM not terminated - nothing there$')
  1507   (847)              INCASE 1
  1508   (848)                  OUTPUT(1, 'AL31', 'XMXENOT no more XT-blocks free$')
  1509   (849)              INCASE 2
  1510   (850)                  OUTPUT(1, 'AL38', 'XMXEIRM non-local remote port illegal$')
  1511   (851)              INCASE 4
  1512   (852)                  OUTPUT(1, 'AL36', 'XMXETMM task allowed no more memory$')
  1513   (853)              INCASE 5
  1514   (854)                  OUTPUT(1, 'AL33', 'XMXENIM facility not implemented$')
  1515   (855)              INCASE 6
  1516   (856)                  OUTPUT(1, 'AL39', 'XMXEIBP illegal message buffer pointer$')
  1517   (857)              INCASE 7
  1518   (858)                  OUTPUT(1, 'AL33', 'XMXEBNY message buffer not yours$')
  1519   (859)              INCASE 8
  1520   (860)                  OUTPUT(1, 'AL41', 'XMXEIRT illegal function for RT programs$')
  1521   (861)              INCASE 9
  1522   (862)                  OUTPUT(1, 'AL32', 'XMXENOP no more ports available$')
  1523   (863)              INCASE 10
  1524   (864)                  OUTPUT(1, 'AL42', 'XMXEIDR function not available to drivers$')
  1525   (865)              INCASE 11
  1526   (866)                  OUTPUT(1, 'AL27', 'XMXENDM no default message$')
  1527   (867)              INCASE 12
  1528   (868)                  OUTPUT(1, 'AL35', 'XMXEMCH message is already chained$')
  1529   (869)              INCASE 13
  1530   (870)                  OUTPUT(1, 'AL30', 'XMXEBFC message is in a queue$')
  1531   (871)              INCASE 14
  1532   (872)                  OUTPUT(1, 'AL35', 'XMXEAIN kernel already initialised$')
  1533   (873)              INCASE 15
  1534   (874)                  OUTPUT(1, 'AL35', 'XMXEBNC return of a bounce message$')
  1535   (875)              INCASE 16
  1536   (876)                  OUTPUT(1, 'AL26', 'XMXEWNA write not allowed$')
  1537   (877)              INCASE 17
  1538   (878)                  OUTPUT(1, 'AL33', 'XMXENVI no valid indirect buffer$')
  1539   (879)              INCASE 18
  1540   (880)                  OUTPUT(1, 'AL30', 'XMXEILF illegal function code$')
  1541   (881)              INCASE 19
  1542   (882)                  OUTPUT(1, 'AL29', 'XMXEIMA invalid magic number$')
  1543   (883)              INCASE 20
  1544   (884)                  OUTPUT(1, 'AL27', 'XMXEMFL message space full$')
  1545   (885)              INCASE 21
  1546   (886)                  OUTPUT(1, 'AL29', 'XMXEILM illegal message size$')
  1547   (887)              INCASE 22
  1548   (888)                  OUTPUT(1, 'AL28', 'XMXEIPN illegal port number$')
  1549   (889)              INCASE 23
  1550   (890)                  OUTPUT(1, 'AL42', 'XMXEPRV privileged function, no privilege$')
  1551   (891)              INCASE 24
  1552   (892)                  OUTPUT(1, 'AL34', 'XMXEPVR privilege request refused$')
  1553   (893)              INCASE 25
  1554   (894)                  OUTPUT(1, 'AL36', 'XMXERNA remote system not available$')
  1555   (895)              ELSE
  1556   (896)                  OUTPUT(1, 'AL26', 'library error, XMX offset ')
  1557   (897)                  OUTPUT(1, 'I6', xmxOffset)
  1558   (898)                  OUTPUT(1, 'AL1', '$')
  1559   (899)          ENDCASE
  1560   (900)      ENDROUTINE
  1561   (901)  
  1562   (902)      % -----------------------------------------------------------------------
  1563   (903)      % Read the remembered nickname out of CHAT:CNFG into myName.
  1564   (904)      %
  1565   (905)      % A MISSING FILE IS NOT AN ERROR and must not look like one. The first time
  1566   (906)      % anybody runs this there is no file, and that is the ordinary case rather
  1567   (907)      % than a fault - so a failed open leaves myName alone and says nothing. The
  1568   (908)      % caller has already put RONNY there.
  1569   (909)      %
  1570   (910)      % ROUTINEERROR IS THE ONLY WAY TO LEARN THE OPEN FAILED. MON50 does not
  1571   (911)      % return a status; it returns a device number and raises on failure, the
  1572   (912)      % same as MON1 does at end of file. Without the handler a first run - which
  1573   (913)      % is every user's first run - would unwind the program before it joined.
  1574   (914)      % -----------------------------------------------------------------------
  1575   (915)      ROUTINE VOID, VOID : readCnfg
  1576   (916)          INTEGER : dev, n
  1577   (917)          INTEGER : c
  1578   (918)          INTEGER : i, k, m
  1579   (919)          BOOLEAN : openFailed
  1580   (920)          BOOLEAN : haveColon
  1581   (921)  
  1582   (922)          % A FLAG, NOT A MAGIC VALUE OF dev - see the long note in writeCnfg.
  1583   (923)          % A failed open leaves 46 in dev, not 0, so "IF dev = 0" never fired and
  1584   (924)          % this routine went on to READ from a device it had never opened.
  1585   (925)          0 =: dev
  1586   (926)          ON ROUTINEERROR DO
  1587   (927)              % No file, no name, nothing to say.
  1588   (928)              TRUE =: openFailed
  1589   (929)          ENDON
  1590   (930)          FALSE =: openFailed
  1591   (931)          MON50(cnfgName, cnfgType, openRead) =: dev
  1592   (932)  
  1593   (933)          IF openFailed THEN
  1594   (934)              RETURN
  1595   (935)          ENDIF
  1596   (936)  
  1597   (937)          % READ THE WHOLE LINE FIRST, then decide. It is now OWNER:NICK rather
  1598   (938)          % than a bare nickname, and the owner has to be checked before a single
  1599   (939)          % byte of it is allowed near myName.
  1600   (940)          0 =: n
  1601   (941)          ON ROUTINEERROR DO
  1602   (942)              % End of file arrives this way, and on a one-line file it is the
  1603   (943)              % NORMAL ending rather than a fault: a name with no carriage
  1604   (944)              % return after it is still a name. Zero stops the loop below.
  1605   (945)              0 =: c
  1606   (946)          ENDON
  1607   (947)          DO
  1608   (948)              0 =: c
  1609   (949)              MON1(dev) =: c
  1610   (950)              c AND parityMask =: c
  1611   (951)  
  1612   (952)              % Stop at the end of the line. Everything after it is somebody
  1613   (953)              % else's business - a second line, or a comment they added.
  1614   (954)              IF c < 32 THEN
  1615   (955)                  0 =: c
  1616   (956)              ENDIF
  1617   (957)  
  1618   (958)              IF c >< 0 THEN
  1619   (959)                  % The guard IS the bound - PLANC checks no array subscript, so
  1620   (960)                  % this is the only thing between a long line and whatever the
  1621   (961)                  % compiler laid out after cnfgLine.
  1622   (962)                  IF n < 63 THEN
  1623   (963)                      c =: cnfgLine(n)
  1624   (964)                      n + 1 =: n
  1625   (965)                  ENDIF
  1626   (966)              ENDIF
  1627   (967)              WHILE c >< 0
  1628   (968)          ENDDO
  1629   (969)  
  1630   (970)          MON43(dev)
  1631   (971)  
  1632   (972)          % A FILE THAT EXISTS BUT IS EMPTY KEEPS THE DEFAULT. It is the state a
  1633   (973)          % bare CREATE-FILE leaves behind, so it is a state real users will have.
  1634   (974)          IF n = 0 THEN
  1635   (975)              RETURN
  1636   (976)          ENDIF
  1637   (977)  
  1638   (978)          % ---- WHOSE NICKNAME IS THIS? ---------------------------------------
  1639   (979)          %
  1640   (980)          % THE BUG THIS EXISTS TO KILL. CHAT:CNFG lives under whoever ran the
  1641   (981)          % program, and on this machine that is SYSTEM for everybody. So ONE
  1642   (982)          % person's /nick became EVERYONE'S name: logging in as SYSTEM and
  1643   (983)          % starting the client came up as OLAV - a name typed during testing days
  1644   (984)          % earlier, on a different account. Nothing on screen explained it, and
  1645   (985)          % the built-in default and the SINTRAN user name were both innocent.
  1646   (986)          %
  1647   (987)          % The file now records WHO chose the nickname:  OWNER:NICK
  1648   (988)          %
  1649   (989)          % A file with no colon is the OLD format. It is exactly the stale
  1650   (990)          % stranger's nickname this is meant to stop, so it is IGNORED rather
  1651   (991)          % than migrated - the next writeCnfg replaces it with an owned one, and
  1652   (992)          % the machine heals itself without anyone deleting a file by hand.
  1653   (993)          0 =: k
  1654   (994)          FALSE =: haveColon
  1655   (995)          DO
  1656   (996)              WHILE k < n AND NOT haveColon
  1657   (997)              IF cnfgLine(k) = 58 THEN
  1658   (998)                  TRUE =: haveColon
  1659   (999)              ELSE
  1660  (1000)                  k + 1 =: k
  1661  (1001)              ENDIF
  1662  (1002)          ENDDO
  1663  (1003)  
  1664  (1004)          IF NOT haveColon THEN
  1665  (1005)              RETURN
  1666  (1006)          ENDIF
  1667  (1007)  
  1668  (1008)          % No SINTRAN name means no way to prove ownership, so nothing is
  1669  (1009)          % trusted. Better to join as USER than as a stranger.
  1670  (1010)          IF lenSintranUser = 0 THEN
  1671  (1011)              RETURN
  1672  (1012)          ENDIF
  1673  (1013)  
  1674  (1014)          IF k >< lenSintranUser THEN
  1675  (1015)              RETURN
  1676  (1016)          ENDIF
  1677  (1017)  
  1678  (1018)          % DO/WHILE, NOT "FOR i IN 0:(k - 1)". A computed range that comes out
  1679  (1019)          % BACKWARDS when k is 0 is not something to guess about in a language
  1680  (1020)          % that checks no array bound - and this file already uses this shape
  1681  (1021)          % everywhere else, so it is also the local idiom.
  1682  (1022)          0 =: i
  1683  (1023)          DO
  1684  (1024)              WHILE i < k
  1685  (1025)              IF cnfgLine(i) >< sintranUser(i) THEN
  1686  (1026)                  RETURN
  1687  (1027)              ENDIF
  1688  (1028)              i + 1 =: i
  1689  (1029)          ENDDO
  1690  (1030)  
  1691  (1031)          % ---- it is ours, so take it ----------------------------------------
  1692  (1032)          % k is the colon, so the nickname runs from k+1 up to n-1.
  1693  (1033)          0 =: m
  1694  (1034)          k + 1 =: i
  1695  (1035)          DO
  1696  (1036)              WHILE i < n
  1697  (1037)              IF m < maxNameLen THEN
  1698  (1038)                  cnfgLine(i) =: myName(m)
  1699  (1039)                  m + 1 =: m
  1700  (1040)              ENDIF
  1701  (1041)              i + 1 =: i
  1702  (1042)          ENDDO
  1703  (1043)  
  1704  (1044)          IF m > 0 THEN
  1705  (1045)              m =: lenMyName
  1706  (1046)          ENDIF
  1707  (1047)      ENDROUTINE
  1708  (1048)  
  1709  (1049)      % -----------------------------------------------------------------------
  1710  (1050)      % Write myName back to CHAT:CNFG, so the next run offers it.
  1711  (1051)      %
  1712  (1052)      % PLAIN OPEN FIRST, CREATE ONLY IF THAT FAILS, and the order is the point.
  1713  (1053)      % A quoted name asks SINTRAN to CREATE, and a create at a name that already
  1714  (1054)      % exists is refused - measured on the FA wire as SINTRAN error 62, "File
  1715  (1055)      % already exists". Trying the create first would therefore fail on every
  1716  (1056)      % run after the first. Trying the plain open first fails only on the very
  1717  (1057)      % first, which is exactly when a create is what we want.
  1718  (1058)      %
  1719  (1059)      % NOTHING HERE IS FATAL. A user with no space, or a read-only area, still
  1720  (1060)      % gets a working chat - they just get asked their name every time. Saying
  1721  (1061)      % so once is better than either failing or pretending it worked.
  1722  (1062)      % -----------------------------------------------------------------------
  1723  (1063)      % -----------------------------------------------------------------------
  1724  (1064)      % Ask SINTRAN to create CHAT:CNFG, through a FULL-SIZE command buffer.
  1725  (1065)      %
  1726  (1066)      % MON70 takes BYTES(0:79) - see the note on cmdBuf. The command text is
  1727  (1067)      % copied in, the rest filled with spaces, and the apostrophe already on the
  1728  (1068)      % end of cnfgMake terminates it so the padding is never read as parameters.
  1729  (1069)      % -----------------------------------------------------------------------
  1730  (1070)      ROUTINE VOID, VOID : makeCnfg
  1731  (1071)          INTEGER : i
  1732  (1072)  
  1733  (1073)          % CREATE THE FILE WITH THE CALL THAT CREATES FILES.
  1734  (1074)          %
  1735  (1075)          % The command-processor detour is gone. It existed because CreateFile
  1736  (1076)          % 221B has no MONn routine - measured, MON221...10101 U - and the only
  1737  (1077)          % other route needed a library that was not on the machine.
  1738  (1078)          %
  1739  (1079)          % IT IS ON THE MACHINE NOW: MON-CALL-1B-A00:BRF, the SINTRAN III Monitor
  1740  (1080)          % Call Package (ND-210913), installed 2026-08-19 and added to the LOAD
  1741  (1081)          % line in CHATCC:MODE between this program and PLANC-1BANK-F00. That
  1742  (1082)          % library supplies 5MON_P, which is what MONITOR_CALL compiles into, so
  1743  (1083)          % every one of the 230 monitor calls is now reachable - not just the 54
  1744  (1084)          % with a MONn routine.
  1745  (1085)          %
  1746  (1086)          % Parameters per ND-860228-2-EN page 125: the FULL filespec in a 64-byte
  1747  (1087)          % buffer, then StartAddress and NoOfPages, both INTEGER4. Zero and zero
  1748  (1088)          % mean an ordinary indexed file that grows as it is written.
  1749  (1089)          FOR i IN 1:nameBufSize DO
  1750  (1090)              spaceChar(0) =: nameBuf(i - 1)
  1751  (1091)          ENDFOR
  1752  (1092)  
  1753  (1093)          FOR i IN 1:lenCnfgFull DO
  1754  (1094)              cnfgFull(i - 1) =: nameBuf(i - 1)
  1755  (1095)          ENDFOR
  1756  (1096)  
  1757  (1097)          MONITOR_CALL(221B, nameBuf, startAddr, noOfPages)
  1758  (1098)      ENDROUTINE
  1759  (1099)  
  1760  (1100)      ROUTINE VOID, VOID : writeCnfg
  1761  (1101)          INTEGER : dev, i
  1762  (1102)          BYTE : b
  1763  (1103)          BOOLEAN : saveFailed
  1764  (1104)          BOOLEAN : openFailed
  1765  (1105)  
  1766  (1106)          % A FLAG, NOT A MAGIC VALUE OF dev - AND THIS WAS THE BUG.
  1767  (1107)          %
  1768  (1108)          % This used to be "0 =: dev" in the handler and "IF dev = 0 THEN create"
  1769  (1109)          % below. MEASURED 2026-08-19, printing dev straight after a failed open
  1770  (1110)          % on a file that does not exist:
  1771  (1111)          %
  1772  (1112)          %   CNFG: open1 dev=    46
  1773  (1113)          %
  1774  (1114)          % FORTY-SIX, not zero. 46 is SINTRAN's "no such file" - the Monitor Calls
  1775  (1115)          % manual's own PASCAL example tests exactly that: "IF ErrCode = 46 THEN
  1776  (1116)          % ... CreateFile(...)". So the test for "the open failed" never fired,
  1777  (1117)          % the create was NEVER REACHED, and the program went straight on to
  1778  (1118)          % write bytes to a device number it had never been given.
  1779  (1119)          %
  1780  (1120)          % That is the whole of the CHAT:CNFG defect. The quoting, the apostrophe
  1781  (1121)          % terminator and the command buffer size were all real faults in a create
  1782  (1122)          % that was never called in the first place.
  1783  (1123)          %
  1784  (1124)          % A BOOLEAN cannot be confused with a device number, which is the point.
  1785  (1125)          %
  1786  (1126)          % AND THE FLAG IS CLEARED **AFTER** THE ON BLOCK, NOT BEFORE IT.
  1787  (1127)          % Measured 2026-08-19 with the flag cleared before: both opens reported
  1788  (1128)          % failure while returning a perfectly good device number -
  1789  (1129)          %
  1790  (1130)          %   CNFG: open1 dev=    69
  1791  (1131)          %   CNFG: open2 dev=    69
  1792  (1132)          %   CHAT: cannot save the nickname
  1793  (1133)          %
  1794  (1134)          % - so the handler body had run even though nothing failed. Clearing
  1795  (1135)          % after the block is correct whichever way the ON statement behaves: if
  1796  (1136)          % the body only runs on an error it is unchanged, and if it also runs
  1797  (1137)          % once where it stands, the clear undoes it before the call.
  1798  (1138)          0 =: dev
  1799  (1139)          ON ROUTINEERROR DO
  1800  (1140)              TRUE =: openFailed
  1801  (1141)          ENDON
  1802  (1142)          FALSE =: openFailed
  1803  (1143)  
  1804  (1144)          MON50(cnfgName, cnfgType, openWrite) =: dev
  1805  (1145)  
  1806  (1146)          IF openFailed THEN
  1807  (1147)              % Not there yet. Make it, then open it for real.
  1808  (1148)              ON ROUTINEERROR DO
  1809  (1149)                  % A create that fails is not worth its own message - the open
  1810  (1150)                  % below will fail too, and that one already has one.
  1811  (1151)              ENDON
  1812  (1152)              makeCnfg
  1813  (1153)  
  1814  (1154)              ON ROUTINEERROR DO
  1815  (1155)                  TRUE =: openFailed
  1816  (1156)              ENDON
  1817  (1157)              FALSE =: openFailed
  1818  (1158)              MON50(cnfgName, cnfgType, openWrite) =: dev
  1819  (1159)          ENDIF
  1820  (1160)  
  1821  (1161)          IF openFailed THEN
  1822  (1162)              OUTPUT(1, 'AL25', 'cannot save the nickname$')
  1823  (1163)              RETURN
  1824  (1164)          ENDIF
  1825  (1165)  
  1826  (1166)          % ONE MESSAGE, NOT ONE PER BYTE. The first version put this handler
  1827  (1167)          % around the write loop and printed inside it, so a failed save said
  1828  (1168)          % "nickname not fully saved" five times - once per character of ANNA
  1829  (1169)          % plus the carriage return. A handler that fires per byte must not
  1830  (1170)          % print per byte; it sets a flag and the caller speaks once.
  1831  (1171)          ON ROUTINEERROR DO
  1832  (1172)              TRUE =: saveFailed
  1833  (1173)          ENDON
  1834  (1174)          FALSE =: saveFailed
  1835  (1175)  
  1836  (1176)          % OWNER FIRST, THEN A COLON, THEN THE NICKNAME.
  1837  (1177)          %
  1838  (1178)          % The file is written as  OWNER:NICK  so the next run can tell whether
  1839  (1179)          % the nickname is the reader's to use. CHAT:CNFG lives under whoever ran
  1840  (1180)          % the program - SYSTEM for everybody on this machine - so without the
  1841  (1181)          % owner one person's /nick silently became everyone's name. See the long
  1842  (1182)          % note in readCnfg.
  1843  (1183)          %
  1844  (1184)          % If SINTRAN would not say who we are there is no owner to record, so
  1845  (1185)          % the colon is written with nothing before it. readCnfg then finds an
  1846  (1186)          % owner length of zero, which cannot match any real user, and ignores the
  1847  (1187)          % nickname. That is the right way round: an unowned nickname is exactly
  1848  (1188)          % the thing we refuse to inherit.
  1849  (1189)          FOR i IN 1:lenSintranUser DO
  1850  (1190)              sintranUser(i - 1) =: b
  1851  (1191)              b MON2(dev)
  1852  (1192)          ENDFOR
  1853  (1193)  
  1854  (1194)          58 =: b
  1855  (1195)          b MON2(dev)
  1856  (1196)  
  1857  (1197)          FOR i IN 1:lenMyName DO
  1858  (1198)              myName(i - 1) =: b
  1859  (1199)              b MON2(dev)
  1860  (1200)          ENDFOR
  1861  (1201)  
  1862  (1202)          % THE CARRIAGE RETURN MATTERS. readCnfg stops at the first byte below
  1863  (1203)          % 32, and a SINTRAN text file is expected to have one - without it the
  1864  (1204)          % last line runs into whatever follows.
  1865  (1205)          carriageRet =: b
  1866  (1206)          b MON2(dev)
  1867  (1207)  
  1868  (1208)          % CLOSE, ALWAYS - including after a failed write. A file opened for
  1869  (1209)          % sequential write is truncated at CLOSE, not at OPEN, so a program
  1870  (1210)          % that opens and never closes leaves the OLD contents in place and the
  1871  (1211)          % save silently does nothing.
  1872  (1212)          MON43(dev)
  1873  (1213)  
  1874  (1214)          IF saveFailed THEN
  1875  (1215)              OUTPUT(1, 'AL25', 'nickname not fully saved$')
  1876  (1216)          ENDIF
  1877  (1217)      ENDROUTINE
  1878  (1218)  
  1879  (1219)      % -----------------------------------------------------------------------
  1880  (1220)      % Settle who we are, before the join goes out. NOTHING IS ASKED.
  1881  (1221)      %
  1882  (1222)      % THE PROMPT THAT USED TO BE HERE IS GONE, and the reason is worth keeping
  1883  (1223)      % because it was a real design mistake rather than a bug. It asked
  1884  (1224)      % "nickname?" on every single run, which is the wrong shape for a chat
  1885  (1225)      % client on a machine where you have already told SINTRAN who you are by
  1886  (1226)      % logging in. Being asked your name again, every time, by a program running
  1887  (1227)      % in your own file area, is nagging.
  1888  (1228)      %
  1889  (1229)      % The order of preference is now:
  1890  (1230)      %
  1891  (1231)      %   1. CHAT:CNFG in your own file area - what /nick last settled on;
  1892  (1232)      %   2. the built-in fallback, for a user who has never renamed.
  1893  (1233)      %
  1894  (1234)      % THE FALLBACK SHOULD BE THE SINTRAN USER NAME and is not yet. That needs
  1895  (1235)      % GetUserName (GUSNA 214B), and 214 is NOT among the MONn routines the
  1896  (1236)      % PLANC runtime provides - the appendix stops at MON263 and has no 214, the
  1897  (1237)      % same gap that CreateFile 221B falls into. The manual gives the way round
  1898  (1238)      % it: "Any monitor calls not listed here, may be called from a PLANC
  1899  (1239)      % routine if a suitable interface routine is constructed by the user. If
  1900  (1240)      % this is done, the user must load the interface routine BEFORE the PLANC
  1901  (1241)      % runtime library." MAC is installed on this machine, so that door is open
  1902  (1242)      % - it is the next piece of work, not a closed one.
  1903  (1243)      %
  1904  (1244)      % Changing the name is /nick, and the room has to agree to it: the save
  1905  (1245)      % happens when the SERVER confirms with kRenamed, never when the request is
  1906  (1246)      % sent. See showArrived.
  1907  (1247)      % -----------------------------------------------------------------------
  1908  (1248)      % -----------------------------------------------------------------------
  1909  (1249)      % ASK SINTRAN WHO IS LOGGED IN.
  1910  (1250)      %
  1911  (1251)      % GetUserName (GUSNA 214B), one STR out-parameter - Reference-Manuals/
  1912  (1252)      % ND-860228-2-EN SINTRAN III Monitor Calls.md. Ronny asked the obvious
  1913  (1253)      % question: "where does the name OLAV come from when I start chat as the
  1914  (1254)      % system user?" It came off disk, from a nickname saved during testing, and
  1915  (1255)      % failing that from a name compiled into the program. The client had never
  1916  (1256)      % once asked the machine.
  1917  (1257)      %
  1918  (1258)      % THE COMMENT ABOVE setupName USED TO SAY THIS COULD NOT BE DONE - that 214
  1919  (1259)      % is not among the MONn routines the PLANC runtime provides, and that the
  1920  (1260)      % way round it is a MAC interface routine. That is the SAME reasoning that
  1921  (1261)      % was wrong about MONITOR_CALL by name, and wrong for the same reason: the
  1922  (1262)      % runtime's own MONn set is not the limit. MON-CALL-1B-A00 and its names
  1923  (1263)      % file are both linked into this client, and CHATSV has been calling
  1924  (1264)      % MONITOR_CALL('TimeOut', ...) - 267B - through them for weeks.
  1925  (1265)      %
  1926  (1266)      % GUARDED, like every monitor call here. An unguarded one that is refused
  1927  (1267)      % raises ROUTINEERROR and takes the whole program down - that is exactly how
  1928  (1268)      % this client died after joining. If the call is refused we simply keep
  1929  (1269)      % whatever name we already had.
  1930  (1270)      % -----------------------------------------------------------------------
  1931  (1271)      ROUTINE VOID, VOID : nameFromSintran
  1932  (1272)          INTEGER : i
  1933  (1273)          INTEGER : n
  1934  (1274)          BOOLEAN : failed
  1935  (1275)  
  1936  (1276)          FOR i IN 0:31 DO
  1937  (1277)              32 =: sintranUser(i)
  1938  (1278)          ENDFOR
  1939  (1279)  
  1940  (1280)          ON ROUTINEERROR DO
  1941  (1281)              TRUE =: failed
  1942  (1282)          ENDON
  1943  (1283)          FALSE =: failed
  1944  (1284)  
  1945  (1285)          % Cleared first. Which of the five are IN and which are OUT is not clear
  1946  (1286)          % from the manual - the arrows beside the parameter list disagree with
  1947  (1287)          % the O in the overview table - so every one starts at a harmless value
  1948  (1288)          % and the MACHINE is allowed to settle it. The diagnostic below prints
  1949  (1289)          % what came back.
  1950  (1290)          0 =: dirIndex
  1951  (1291)          0 =: userIndex
  1952  (1292)          0 =: remoteFlag
  1953  (1293)          FOR i IN 0:63 DO
  1954  (1294)              32 =: remoteSystem(i)
  1955  (1295)          ENDFOR
  1956  (1296)  
  1957  (1297)          MONITOR_CALL('GetUserName', sintranUser, dirIndex, userIndex, &
  1958  (1298)              remoteFlag, remoteSystem)
  1959  (1299)  
  1960  (1300)          % Clear the handler before anything else can raise under it.
  1961  (1301)          ON ROUTINEERROR DO
  1962  (1302)          ENDON
  1963  (1303)  
  1964  (1304)          % THE DIAGNOSTIC THAT LIVED HERE HAS DONE ITS JOB, and this is what it
  1965  (1305)          % said. Run on D100 2026-08-22 as user SYSTEM, old build against new:
  1966  (1306)          %
  1967  (1307)          %     @NDCHAT   ->  GetUserName refused        (the old ONE-argument call)
  1968  (1308)          %     @CHAT     ->  SINTRAN says: SYSTEM'      (the FIVE-argument call)
  1969  (1309)          %
  1970  (1310)          % So the call works and the five-parameter form was the whole problem.
  1971  (1311)          % Removed rather than left behind a flag - a diagnostic nobody can turn
  1972  (1312)          % off is noise on every single start-up.
  1973  (1313)          IF failed THEN
  1974  (1314)              RETURN
  1975  (1315)          ENDIF
  1976  (1316)  
  1977  (1317)          % THE ANSWER IS PADDED, AND NOT ONLY WITH SPACES. The name ends at the
  1978  (1318)          % first space, at a zero, or at an APOSTROPHE - the screen above shows
  1979  (1319)          % SYSTEM followed by one. Whether that apostrophe is SINTRAN's padding or
  1980  (1320)          % came from how the diagnostic printed the buffer was NOT established, so
  1981  (1321)          % all three are treated as terminators: an apostrophe cannot occur inside
  1982  (1322)          % a SINTRAN user name, so stopping at one is safe either way.
  1983  (1323)          %
  1984  (1324)          % Without this the join would carry padding inside the name field, and
  1985  (1325)          % two clients that "have the same name" would not match.
  1986  (1326)          0 =: n
  1987  (1327)          DO
  1988  (1328)              WHILE n < 31 AND sintranUser(n) >< 32 AND sintranUser(n) >< 0 &
  1989  (1329)                  AND sintranUser(n) >< 39
  1990  (1330)              n + 1 =: n
  1991  (1331)          ENDDO
  1992  (1332)  
  1993  (1333)          % Remembered for readCnfg, which will not honour a saved nickname unless
  1994  (1334)          % it can prove the nickname belongs to whoever is logged in now.
  1995  (1335)          n =: lenSintranUser
  1996  (1336)  
  1997  (1337)          IF n = 0 THEN
  1998  (1338)              RETURN
  1999  (1339)          ENDIF
  2000  (1340)  
  2001  (1341)          % myName holds maxNameLen bytes and PLANC checks no array bound, so this
  2002  (1342)          % clamp is the only thing between a long user name and the variables
  2003  (1343)          % laid out after it.
  2004  (1344)          IF n > maxNameLen THEN
  2005  (1345)              maxNameLen =: n
  2006  (1346)          ENDIF
  2007  (1347)  
  2008  (1348)          FOR i IN 0:n - 1 DO
  2009  (1349)              sintranUser(i) =: myName(i)
  2010  (1350)          ENDFOR
  2011  (1351)          n =: lenMyName
  2012  (1352)      ENDROUTINE
  2013  (1353)  
  2014  (1354)      ROUTINE VOID, VOID : setupName
  2015  (1355)          INTEGER : i
  2016  (1356)  
  2017  (1357)          % The fallback first, then whatever CHAT:CNFG remembers on top of it.
  2018  (1358)          % That way readCnfg can fail, or find an empty file, and simply leave a
  2019  (1359)          % good name in place - it never has to know what to fall back to, and
  2020  (1360)          % no path reaches the join with an empty name.
  2021  (1361)          %
  2022  (1362)          % THE ORDER IS MOST-SPECIFIC-LAST, each layer overwriting the one below:
  2023  (1363)          %   1. the built-in, which is only a shape to start from;
  2024  (1364)          %   2. WHO SINTRAN SAYS YOU ARE - you already logged in to tell it;
  2025  (1365)          %   3. a nickname you deliberately chose with /nick and that was saved.
  2026  (1366)          FOR i IN 1:lenDefault DO
  2027  (1367)              defaultName(i - 1) =: myName(i - 1)
  2028  (1368)          ENDFOR
  2029  (1369)          lenDefault =: lenMyName
  2030  (1370)  
  2031  (1371)          nameFromSintran
  2032  (1372)  
  2033  (1373)          readCnfg
  2034  (1374)  
  2035  (1375)          % NOTHING IS ANNOUNCED HERE, AND THAT IS THE FIX.
  2036  (1376)          %
  2037  (1377)          % This used to print "you are OLAV  (/nick to change)" the moment the
  2038  (1378)          % name was settled locally - BEFORE the join had been sent, let alone
  2039  (1379)          % answered. When the server then refused the name the screen read:
  2040  (1380)          %
  2041  (1381)          %     you are OLAV  (/nick to change)
  2042  (1382)          %     joining (LOBBY) - type and press return
  2043  (1383)          %     OLAV: that nickname is taken
  2044  (1384)          %
  2045  (1385)          % which states an identity and takes it away two lines later. A name we
  2046  (1386)          % merely INTEND to use is not an identity; only the server can grant it,
  2047  (1387)          % and only the WELCOME says it has. The announcement now lives where the
  2048  (1388)          % welcome is handled, so it is printed once and only when it is true.
  2049  (1389)      ENDROUTINE
  2050  (1390)  
  2051  (1391)      % -----------------------------------------------------------------------
  2052  (1392)      % Point at a room, given its name - "LOBBY".
  2053  (1393)      %
  2054  (1394)      % THE PREFIX IS GONE, and with it the bug it existed to fix. This routine
  2055  (1395)      % used to paste "CHAT-" in front, because the room name WAS a port name and
  2056  (1396)      % the port is registered as CHAT-GENERAL rather than GENERAL. /join copied
  2057  (1397)      % the typed argument straight in, asked XROUT for a name that does not
  2058  (1398)      % exist, and the client stayed where it was - "/join doesn't work".
  2059  (1399)      %
  2060  (1400)      % There is no port name to build now. One port, *CHAT, and the room is
  2061  (1401)      % carried in the message, so the room name is just the room name. The whole
  2062  (1402)      % class of mistake goes with it.
  2063  (1403)      %
  2064  (1404)      % shortAt is an index into "typed"; a caller with the name somewhere else
  2065  (1405)      % copies it into typed first. That keeps this routine to one source and one
  2066  (1406)      % rule, which is the whole point of having it.
  2067  (1407)      % -----------------------------------------------------------------------
  2068  (1408)      ROUTINE VOID, VOID (INTEGER, INTEGER) : setRoom (shortAt, shortLen)
  2069  (1409)          INTEGER : i
  2070  (1410)  
  2071  (1411)          FOR i IN 1:shortLen DO
  2072  (1412)              typed(shortAt + i - 1) =: roomName(i - 1)
  2073  (1413)          ENDFOR
  2074  (1414)          shortLen =: lenRoomName
  2075  (1415)      ENDROUTINE
  2076  (1416)  
  2077  (1417)      % -----------------------------------------------------------------------
  2078  (1418)      % Say which room we are in, IN PARENTHESES.
  2079  (1419)      %
  2080  (1420)      % The client joins a room at start-up whether or not anybody asked it to,
  2081  (1421)      % and until now nothing on screen said which one - so every line you typed
  2082  (1422)      % went somewhere you had not been told about. The short name is shown, the
  2083  (1423)      % prefix left off: "CHAT-" is on every room and carries no information.
  2084  (1424)      % -----------------------------------------------------------------------
  2085  (1425)      ROUTINE VOID, VOID : showRoom
  2086  (1426)          INTEGER : i
  2087  (1427)  
  2088  (1428)          OUTPUT(1, 'AL1', '(')
  2089  (1429)          FOR i IN 1:lenRoomName DO
  2090  (1430)              roomName(i - 1) =: oneChar(0)
  2091  (1431)              OUTPUT(1, 'AL1', oneChar)
  2092  (1432)          ENDFOR
  2093  (1433)          OUTPUT(1, 'AL1', ')')
  2094  (1434)      ENDROUTINE
  2095  (1435)  
  2096  (1436)      % -----------------------------------------------------------------------
  2097  (1437)      % Send the join, as a LETTER through XROUT.
  2098  (1438)      %
  2099  (1439)      % The room is reached by NAME - XROUT looks it up and forwards, and this is
  2100  (1440)      % also where the seat is taken, before the server ever sees us. Everything
  2101  (1441)      % after the join goes port to port with no name lookup at all, which is why
  2102  (1442)      % the server's magic number is kept from its first reply.
  2103  (1443)      % -----------------------------------------------------------------------
  2104  (1444)      % ------------------------------------------------------------------
  2105  (1445)      % Take a new nickname LOCALLY, from typed. No message goes anywhere.
  2106  (1446)      %
  2107  (1447)      % Used when a join was refused for a duplicate name: there is no room
  2108  (1448)      % to announce a rename to, so this just changes who we will say we are
  2109  (1449)      % the next time we knock.
  2110  (1450)      %
  2111  (1451)      % Bounded by maxNameLen, checked by the caller. PLANC checks no array
  2112  (1452)      % bound, so that check is the only thing between a long name and
  2113  (1453)      % whatever the compiler laid out after myName.
  2114  (1454)      % ------------------------------------------------------------------
  2115  (1455)      ROUTINE VOID, VOID (INTEGER, INTEGER) : setMyName(nameAt, nameLen)
  2116  (1456)          INTEGER : i
  2117  (1457)          FOR i IN 1:nameLen DO
  2118  (1458)              typed(nameAt + i - 1) =: myName(i - 1)
  2119  (1459)          ENDFOR
  2120  (1460)          nameLen =: lenMyName
  2121  (1461)      ENDROUTINE
  2122  (1462)  
  2123  (1463)      % -----------------------------------------------------------------------
  2124  (1464)      % Say who we are now. Called after a LOCAL rename, so the user can see the
  2125  (1465)      % name the next knock will use.
  2126  (1466)      %
  2127  (1467)      % THIS ROUTINE WAS CALLED AND NEVER EXISTED. The /nick recovery path has
  2128  (1468)      % read
  2129  (1469)      %
  2130  (1470)      %     setMyName(at, argLen)
  2131  (1471)      %     showMyName
  2132  (1472)      %     sendJoin
  2133  (1473)      %
  2134  (1474)      % since the day it was written, and there was no showMyName anywhere in the
  2135  (1475)      % file. PLANC answered
  2136  (1476)      %
  2137  (1477)      %     2494  (1834)/HANDLECOMM  *** ERROR   - ILLEGAL SYNTAX "SHOWMYNAME"
  2138  (1478)      %
  2139  (1479)      % every time - and nobody saw it, because the listing is the only place a
  2140  (1480)      % PLANC error survives and CHAT:LIST has never once been read. The MODE
  2141  (1481)      % file says so in as many words: "Not one *** ERROR in CHAT:LIST is the
  2142  (1482)      % only green light here." Every client build before 2026-08-21 went in
  2143  (1483)      % unchecked, so how much of the program the compiler skipped after this
  2144  (1484)      % point is NOT KNOWN.
  2145  (1485)      % -----------------------------------------------------------------------
  2146  (1486)      ROUTINE VOID, VOID : showMyName
  2147  (1487)          INTEGER : i
  2148  (1488)  
  2149  (1489)          % JUST THE NAME, NO SENTENCE AROUND IT. This used to print a whole line -
  2150  (1490)          % "$CHAT: you are OLAV$" - which made it useless anywhere the name is
  2151  (1491)          % part of something else: a prompt, or "joining LOBBY as OLAV". A routine
  2152  (1492)          % called showMyName should show the name and nothing but; whoever wants a
  2153  (1493)          % sentence builds it.
  2154  (1494)          FOR i IN 1:lenMyName DO
  2155  (1495)              myName(i - 1) =: oneChar(0)
  2156  (1496)              OUTPUT(1, 'AL1', oneChar)
  2157  (1497)          ENDFOR
  2158  (1498)      ENDROUTINE
  2159  (1499)  
  2160  (1500)      ROUTINE VOID, VOID : sendJoin
  2161  (1501)          XMMSGIDENTIFIER : msgIdent
  2162  (1502)          INTEGER : length
  2163  (1503)  
  2164  (1504)          % The XSLET header, built in a local buffer. 123 is our reference
  2165  (1505)          % number, echoed back so a task with several requests outstanding can
  2166  (1506)          % tell the answers apart.
  2167  (1507)          % A SUBARRAY, because roomName is now storage rather than a literal.
  2168  (1508)          %
  2169  (1509)          % XMPBLET takes portName as BYTES and appends it as parameter 1 of the
  2170  (1510)          % letter - a PLANC BYTES argument carries its own length, so handing it
  2171  (1511)          % the whole 21-byte array would ask XROUT for a name with eleven bytes
  2172  (1512)          % of leftovers on the end. roomName(0:lenRoomName-1) is exactly the name
  2173  (1513)          % and nothing else. Runtime bounds in a subarray are legal: the PLANC
  2174  (1514)          % manual's own example is ia1(0:10,i:k-2).
  2175  (1515)          % ADDRESSED TO THE SERVICE, NOT TO THE ROOM. The room is carried in the
  2176  (1516)          % message by buildJoin below.
  2177  (1517)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, &
  2178  (1518)              servName(0:lenServName - 1)) =: returnStatus
  2179  (1519)          IF returnStatus >< XMOK THEN
  2180  (1520)              showStatus('xmpblet', returnStatus)
  2181  (1521)              RETURN
  2182  (1522)          ENDIF
  2183  (1523)  
  2184  (1524)          xmpfget(0, 200, msgIdent) =: returnStatus
  2185  (1525)          IF returnStatus >< XMOK THEN
  2186  (1526)              showStatus('xmpfget', returnStatus)
  2187  (1527)              RETURN
  2188  (1528)          ENDIF
  2189  (1529)  
  2190  (1530)          % The header first...
  2191  (1531)          offSet =: uLength
  2192  (1532)          xmpfwri(0, 0, &
  2193  (1533)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
  2194  (1534)              0, uLength, wLength) =: returnStatus
  2195  (1535)  
  2196  (1536)          % ...then OUR data after it. XROUT reads only the header and forwards
  2197  (1537)          % the rest untouched, so this is where the nickname rides.
  2198  (1538)          buildJoin =: length
  2199  (1539)          xmpfwri(0, wLength, &
  2200  (1540)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  2201  (1541)              0, length, offSet) =: returnStatus
  2202  (1542)  
  2203  (1543)          xmprout(0, msgIdent, myPort) =: returnStatus
  2204  (1544)          IF returnStatus >< XMOK THEN
  2205  (1545)              showStatus('xmprout (the join)', returnStatus)
  2206  (1546)          ENDIF
  2207  (1547)      ENDROUTINE
  2208  (1548)  
  2209  (1549)      % -----------------------------------------------------------------------
  2210  (1550)      % Send one of our messages straight to the server, no XROUT involved.
  2211  (1551)      % -----------------------------------------------------------------------
  2212  (1552)      ROUTINE VOID, VOID (INTEGER) : sendToServer(length)
  2213  (1553)          XMMSGIDENTIFIER : ident
  2214  (1554)          xmpfget(0, length, ident) =: returnStatus
  2215  (1555)          IF returnStatus >< XMOK THEN
  2216  (1556)              RETURN
  2217  (1557)          ENDIF
  2218  (1558)          xmpfwri(0, 0, &
  2219  (1559)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  2220  (1560)              0, length, wLength) =: returnStatus
  2221  (1561)          xmpfsnd(0, myPort, serverMagic) =: returnStatus
  2222  (1562)      ENDROUTINE
  2223  (1563)  
  2224  (1564)      % -----------------------------------------------------------------------
  2225  (1565)      % Show what arrived. The room speaks in the same message format we send.
  2226  (1566)      % -----------------------------------------------------------------------
  2227  (1567)      ROUTINE VOID, VOID : showArrived
  2228  (1568)          INTEGER : kind, nameLength, textLength, textAt, i
  2229  (1569)          % Only used by the kRenamed branch: is this rename about US?
  2230  (1570)          BOOLEAN : sameAsOurs
  2231  (1571)          INTEGER : newLen
  2232  (1572)  
  2233  (1573)          inBuf(0) =: kind
  2234  (1574)          inBuf(1) =: nameLength
  2235  (1575)  
  2236  (1576)          % THE JOIN IS ONE STEP, and a two-step handshake used to live here.
  2237  (1577)          %
  2238  (1578)          % It was added on the reading that "sending the join through XROUT does
  2239  (1579)          % not put the nickname in front of the server" - that the server's
  2240  (1580)          % connection port is handed a bare 4-byte connect, so a kHello reply was
  2241  (1581)          % needed before the nickname could be sent. That reading was WRONG, and
  2242  (1582)          % it was wrong because the SERVER was reading the wrong bytes: a letter
  2243  (1583)          % arrives with its XSLET header still attached, and the server was
  2244  (1584)          % parsing the header's serial number as a message kind.
  2245  (1585)          %
  2246  (1586)          % The nickname was in the first letter the whole time. sendJoin writes it
  2247  (1587)          % after the header and the Programmer Guide is explicit that XROUT
  2248  (1588)          % forwards it untouched. The server's WELCOME is the answer that hands
  2249  (1589)          % over the magic number, which is all this side ever needed. See the
  2250  (1590)          % header skip in CHATSV.PLNC for the layout and the manual reference.
  2251  (1591)          %
  2252  (1592)          % Nothing replaces this block: the welcome below already sets
  2253  (1593)          % serverMagic, and always did.
  2254  (1594)  
  2255  (1595)          % ---- TRUST NOTHING THAT ARRIVED, ON THIS SIDE TOO ------------------
  2256  (1596)          % The server checks exactly these three things before it reads a name or
  2257  (1597)          % a text; this side did not, and the reasoning is identical. inBuf holds
  2258  (1598)          % 256 bytes and PLANC checks no array bound:
  2259  (1599)          %
  2260  (1600)          %   nameLength is ONE BYTE, so it can say 255. The name loop would then
  2261  (1601)          %   read inBuf(2)..inBuf(256) - past the end - and textAt would already
  2262  (1602)          %   be 257 before any text was touched.
  2263  (1603)          %
  2264  (1604)          %   textLength is TWO BYTES, so it can say 65535, and the text loop
  2265  (1605)          %   would walk tens of thousands of bytes off the end of the array.
  2266  (1606)          %
  2267  (1607)          %   A SHORT message is the quieter half: without testing against
  2268  (1608)          %   readLength the loops print whatever the previous, longer message
  2269  (1609)          %   left behind in inBuf.
  2270  (1610)          %
  2271  (1611)          % "The server would never send that" is not a reason. A truncated
  2272  (1612)          % message does it by accident, and a client that only survives a
  2273  (1613)          % well-behaved peer is not one worth writing.
  2274  (1614)          % Both tests are against readLength, which the read below clamps to the
  2275  (1615)          % size of inBuf - so a field that fits the MESSAGE also fits the ARRAY.
  2276  (1616)          IF 2 + nameLength + 1 > readLength THEN
  2277  (1617)              RETURN
  2278  (1618)          ENDIF
  2279  (1619)  
  2280  (1620)          2 + nameLength =: textAt
  2281  (1621)          inBuf(textAt) * 256 + inBuf(textAt + 1) =: textLength
  2282  (1622)          textAt + 2 =: textAt
  2283  (1623)  
  2284  (1624)          IF textAt + textLength > readLength THEN
  2285  (1625)              RETURN
  2286  (1626)          ENDIF
  2287  (1627)  
  2288  (1628)          % The WELCOME is what reveals the server's address: everything after it
  2289  (1629)          % goes straight there.
  2290  (1630)          IF kind = kWelcome THEN
  2291  (1631)              senderMagic =: serverMagic
  2292  (1632)              TRUE =: joined
  2293  (1633)  
  2294  (1634)              % SAY WHO YOU ARE, ONCE, AND ONLY NOW THAT IT IS TRUE. The server
  2295  (1635)              % has accepted the name, so this is a fact rather than a hope - see
  2296  (1636)              % the note in setupName for what printing it early looked like.
  2297  (1637)              OUTPUT(1, 'AL8', 'you are ')
  2298  (1638)              showMyName
  2299  (1639)              OUTPUT(1, 'AL20', '  (/nick to change)$')
  2300  (1640)  
  2301  (1641)              % RETURN, LIKE EVERY OTHER CASE IN THIS CHAIN.
  2302  (1642)              %
  2303  (1643)              % This branch had no RETURN, so after printing the welcome it walked
  2304  (1644)              % on through every remaining test and fell into the printer at the
  2305  (1645)              % bottom - which printed the sender's name and the welcome's empty
  2306  (1646)              % text as
  2307  (1647)              %
  2308  (1648)              %     SYSTEM:
  2309  (1649)              %
  2310  (1650)              % That bare line was read as screen noise for two sittings, and the
  2311  (1651)              % kJoined/kLeft branches were added on the theory that it was an
  2312  (1652)              % arrival notice. It was not: it was THIS message, arriving once and
  2313  (1653)              % being printed twice.
  2314  (1654)              %
  2315  (1655)              % IT WAS THE "unknown message kind: 2" DIAGNOSTIC THAT EXPOSED IT, on
  2316  (1656)              % the first run after that diagnostic was added - kind 2 is kWelcome,
  2317  (1657)              % a kind which plainly HAS a case, and a handled kind reaching the
  2318  (1658)              % bottom of the chain can only mean the case did not stop. Making the
  2319  (1659)              % silent path loud paid for itself immediately.
  2320  (1660)              RETURN
  2321  (1661)          ENDIF
  2322  (1662)  
  2323  (1663)          % ---- OUR OWN NAME CHANGES ONLY WHEN THE ROOM SAYS SO ---------------
  2324  (1664)          % A comment in handleCommand has promised this for as long as /nick has
  2325  (1665)          % existed - "our own name changes only when the room says so, with
  2326  (1666)          % kRenamed" - and nothing implemented it. The name in myName therefore
  2327  (1667)          % stayed at the old one after a successful rename, so the next thing
  2328  (1668)          % this client SENT went out under a name the room no longer knew.
  2329  (1669)          %
  2330  (1670)          % A Renamed carries the NEW name in the name field and the OLD one as
  2331  (1671)          % its text, which is exactly what is needed to tell whether it is about
  2332  (1672)          % us: compare the OLD name with what we currently believe we are called.
  2333  (1673)          % Everybody in the room gets every Renamed, so without that test this
  2334  (1674)          % client would take somebody else's new name for itself.
  2335  (1675)          %
  2336  (1676)          % This is also the ONLY place CHAT:CNFG is written. Saving when /nick is
  2337  (1677)          % SENT would remember a name the server may be about to refuse - it
  2338  (1678)          % refuses an empty one, and one already taken - so the save waits for
  2339  (1679)          % the room's confirmation. A refused rename changes nothing, on screen
  2340  (1680)          % or on disk.
  2341  (1681)          IF kind = kRenamed THEN
  2342  (1682)              IF textLength = lenMyName THEN
  2343  (1683)                  TRUE =: sameAsOurs
  2344  (1684)                  FOR i IN 1:textLength DO
  2345  (1685)                      IF inBuf(textAt + i - 1) >< myName(i - 1) THEN
  2346  (1686)                          FALSE =: sameAsOurs
  2347  (1687)                      ENDIF
  2348  (1688)                  ENDFOR
  2349  (1689)  
  2350  (1690)                  IF sameAsOurs THEN
  2351  (1691)                      % Bounded by the buffer, not by what arrived. A server that
  2352  (1692)                      % sent a longer name than we can hold would otherwise write
  2353  (1693)                      % past the end of myName - and the room's own limit and
  2354  (1694)                      % this buffer are both sixteen, so a name that does not fit
  2355  (1695)                      % here is one the room should never have accepted.
  2356  (1696)                      nameLength =: newLen
  2357  (1697)                      IF newLen > maxNameLen THEN
  2358  (1698)                          maxNameLen =: newLen
  2359  (1699)                      ENDIF
  2360  (1700)                      FOR i IN 1:newLen DO
  2361  (1701)                          inBuf(2 + i - 1) =: myName(i - 1)
  2362  (1702)                      ENDFOR
  2363  (1703)                      newLen =: lenMyName
  2364  (1704)  
  2365  (1705)                      writeCnfg
  2366  (1706)                  ENDIF
  2367  (1707)              ENDIF
  2368  (1708)  
  2369  (1709)              % RETURN, for the same reason kWelcome now does. This branch had none
  2370  (1710)              % either, so a rename would have printed nothing of its own and then
  2371  (1711)              % fallen through to the bottom of the chain to be rendered as speech.
  2372  (1712)              % Two of the seven cases were missing it; a check that every branch
  2373  (1713)              % ends in RETURN is worth running whenever a case is added.
  2374  (1714)              RETURN
  2375  (1715)          ENDIF
  2376  (1716)  
  2377  (1717)          % A BYTE HANDED TO 'AL1' PRINTS AS A NUMBER, NOT A CHARACTER.
  2378  (1718)          %
  2379  (1719)          % MEASURED on D100 2026-08-18, the first run in which the join actually
  2380  (1720)          % completed: the welcome arrived, was received and released correctly,
  2381  (1721)          % and printed as
  2382  (1722)          %
  2383  (1723)          %     8279787889: 7269767679
  2384  (1724)          %
  2385  (1725)          % which is 82 79 78 78 89 = RONNY and 72 69 76 76 79 = HELLO, each byte
  2386  (1726)          % rendered as its decimal value. The message was perfect; only the
  2387  (1727)          % printing was wrong, and it looked alarming enough to be mistaken for
  2388  (1728)          % a decode fault.
  2389  (1729)          %
  2390  (1730)          % 'ALn' formats a STRING. inBuf(x) is a BYTE, so it takes the integer
  2391  (1731)          % path. Copying the byte into a one-character BYTES first gives 'AL1'
  2392  (1732)          % the string it is asking for. This uses nothing new - BYTES arrays,
  2393  (1733)          % assignment and OUTPUT with ALn on a BYTES all appear above and all
  2394  (1734)          % compile.
  2395  (1735)          % THE /who ANSWER IS NOT A LINE SOMEBODY SAID, so it does not get the
  2396  (1736)          % "$NAME: text" shape below. Its name field is empty on purpose - the
  2397  (1737)          % room is answering, not a member - and the generic printer would open
  2398  (1738)          % with a bare colon. Printed here and returned.
  2399  (1739)          IF kind = kWho THEN
  2400  (1740)              OUTPUT(1, 'AL10', '$CHAT: in ')
  2401  (1741)              showRoom
  2402  (1742)              OUTPUT(1, 'AL2', ': ')
  2403  (1743)              FOR i IN 1:textLength DO
  2404  (1744)                  inBuf(textAt + i - 1) =: oneChar(0)
  2405  (1745)                  OUTPUT(1, 'AL1', oneChar)
  2406  (1746)              ENDFOR
  2407  (1747)              OUTPUT(1, 'AL1', '$')
  2408  (1748)              RETURN
  2409  (1749)          ENDIF
  2410  (1750)  
  2411  (1751)          % A REFUSAL IS NOT SPEECH, AND MUST NOT BE PRINTED AS SPEECH.
  2412  (1752)          %
  2413  (1753)          % kReject carries the name that was REFUSED and the reason for it. There
  2414  (1754)          % was no case for it here, so it fell through to the "<name>: <text>"
  2415  (1755)          % printer below and came out as
  2416  (1756)          %
  2417  (1757)          %     OLAV: that nickname is taken
  2418  (1758)          %
  2419  (1759)          % which reads as OLAV saying those words in the room. He did not: the
  2420  (1760)          % server said them ABOUT him. The name belongs where it is the SUBJECT,
  2421  (1761)          % not in the slot reserved for whoever spoke, and the message has to say
  2422  (1762)          % what to do next - a refusal the user cannot act on is just a wall.
  2423  (1763)          IF kind = kReject THEN
  2424  (1764)              % TWO REFUSALS ARRIVE HERE AND THEY MEAN DIFFERENT THINGS.
  2425  (1765)              %
  2426  (1766)              % If the user has NOT chosen a name this session, we joined under the
  2427  (1767)              % name SINTRAN gave us - so "taken" means the SAME SINTRAN USER is
  2428  (1768)              % already in the room from ANOTHER TERMINAL. That is worth saying in
  2429  (1769)              % those words, because "that nickname is taken" sends someone hunting
  2430  (1770)              % for a stranger who has stolen their name, when in fact it is their
  2431  (1771)              % own second window.
  2432  (1772)              %
  2433  (1773)              % DECIDED 2026-08-22: refuse the second instance and say so plainly.
  2434  (1774)              % Not auto-suffixed to SYSTEM-2, and not two sessions sharing one
  2435  (1775)              % identity - both of those make identity per-INSTANCE, which the
  2436  (1776)              % trunk would then have to keep distinct across machines.
  2437  (1777)              %
  2438  (1778)              % The user is NOT thrown out: /nick still works, so a second window
  2439  (1779)              % can join under a name of its own if that is what was wanted.
  2440  (1780)              IF NOT userChoseNick THEN
  2441  (1781)                  OUTPUT(1, 'AL1', '$')
  2442  (1782)                  FOR i IN 1:nameLength DO
  2443  (1783)                      inBuf(2 + i - 1) =: oneChar(0)
  2444  (1784)                      OUTPUT(1, 'AL1', oneChar)
  2445  (1785)                  ENDFOR
  2446  (1786)                  OUTPUT(1, 'AL37', ' is already in the room from another$')
  2447  (1787)                  OUTPUT(1, 'AL39', 'terminal - use /nick <name> to join as$')
  2448  (1788)                  OUTPUT(1, 'AL14', 'somebody else$')
  2449  (1789)                  RETURN
  2450  (1790)              ENDIF
  2451  (1791)  
  2452  (1792)              OUTPUT(1, 'AL1', '$')
  2453  (1793)              OUTPUT(1, 'AL15', 'cannot join as ')
  2454  (1794)              FOR i IN 1:nameLength DO
  2455  (1795)                  inBuf(2 + i - 1) =: oneChar(0)
  2456  (1796)                  OUTPUT(1, 'AL1', oneChar)
  2457  (1797)              ENDFOR
  2458  (1798)              OUTPUT(1, 'AL3', ' - ')
  2459  (1799)              FOR i IN 1:textLength DO
  2460  (1800)                  inBuf(textAt + i - 1) =: oneChar(0)
  2461  (1801)                  OUTPUT(1, 'AL1', oneChar)
  2462  (1802)              ENDFOR
  2463  (1803)              OUTPUT(1, 'AL1', '$')
  2464  (1804)              OUTPUT(1, 'AL33', 'use /nick <name> to pick another$')
  2465  (1805)              RETURN
  2466  (1806)          ENDIF
  2467  (1807)  
  2468  (1808)          % ---- ARRIVALS AND DEPARTURES ARE EVENTS, NOT SPEECH -------------------
  2469  (1809)          %
  2470  (1810)          % These two had NO case at all and fell through to the "<name>: <text>"
  2471  (1811)          % printer below, exactly as kReject once did. A join carries no text, so
  2472  (1812)          % it came out as a bare
  2473  (1813)          %
  2474  (1814)          %     SYSTEM:
  2475  (1815)          %
  2476  (1816)          % which reads as somebody typing a colon and nothing else - screen noise
  2477  (1817)          % rather than a bug, which is why it sat there unnoticed. It was seen on
  2478  (1818)          % 2026-08-22 straight after a /nick and dismissed twice before the
  2479  (1819)          % dispatch chain was actually read.
  2480  (1820)          %
  2481  (1821)          % THE NAME IS THE SUBJECT HERE, not the speaker, so it goes in front of a
  2482  (1822)          % verb and never in front of a colon.
  2483  (1823)          IF kind = kJoined THEN
  2484  (1824)              OUTPUT(1, 'AL1', '$')
  2485  (1825)              FOR i IN 1:nameLength DO
  2486  (1826)                  inBuf(2 + i - 1) =: oneChar(0)
  2487  (1827)                  OUTPUT(1, 'AL1', oneChar)
  2488  (1828)              ENDFOR
  2489  (1829)              OUTPUT(1, 'AL8', ' joined$')
  2490  (1830)              RETURN
  2491  (1831)          ENDIF
  2492  (1832)  
  2493  (1833)          IF kind = kLeft THEN
  2494  (1834)              OUTPUT(1, 'AL1', '$')
  2495  (1835)              FOR i IN 1:nameLength DO
  2496  (1836)                  inBuf(2 + i - 1) =: oneChar(0)
  2497  (1837)                  OUTPUT(1, 'AL1', oneChar)
  2498  (1838)              ENDFOR
  2499  (1839)              OUTPUT(1, 'AL6', ' left$')
  2500  (1840)              RETURN
  2501  (1841)          ENDIF
  2502  (1842)  
  2503  (1843)          % ---- SPEECH, AND ONLY SPEECH ------------------------------------------
  2504  (1844)          %
  2505  (1845)          % THE TEST IS EXPLICIT NOW, and that is the whole point. This used to be a
  2506  (1846)          % bare fall-through that printed WHATEVER was left as "<name>: <text>", so
  2507  (1847)          % every kind nobody had written a case for arrived here and was rendered
  2508  (1848)          % as a person talking. Three separate bugs came out of that one habit:
  2509  (1849)          % kReject as "OLAV: that nickname is taken", kJoined as a bare "SYSTEM:",
  2510  (1850)          % and - the same blindness one layer up - writeCnfg hung off kRenamed
  2511  (1851)          % while the server answers kWelcome, so /nick was confirmed and never
  2512  (1852)          % saved.
  2513  (1853)          %
  2514  (1854)          % A KIND NOBODY HANDLES MUST BE LOUD. It produces no error from the
  2515  (1855)          % compiler and none at run time, so the only way it ever gets noticed is
  2516  (1856)          % if the program says so itself. tools/planc-lint.py now flags a kind that
  2517  (1857)          % is declared and never used again, which would have caught all three
  2518  (1858)          % before they reached the machine.
  2519  (1859)          IF kind = kSaid THEN
  2520  (1860)              OUTPUT(1, 'AL1', '$')
  2521  (1861)              FOR i IN 1:nameLength DO
  2522  (1862)                  inBuf(2 + i - 1) =: oneChar(0)
  2523  (1863)                  OUTPUT(1, 'AL1', oneChar)
  2524  (1864)              ENDFOR
  2525  (1865)              OUTPUT(1, 'AL2', ': ')
  2526  (1866)              FOR i IN 1:textLength DO
  2527  (1867)                  inBuf(textAt + i - 1) =: oneChar(0)
  2528  (1868)                  OUTPUT(1, 'AL1', oneChar)
  2529  (1869)              ENDFOR
  2530  (1870)              OUTPUT(1, 'AL1', '$')
  2531  (1871)              RETURN
  2532  (1872)          ENDIF
  2533  (1873)  
  2534  (1874)          OUTPUT(1, 'AL1', '$')
  2535  (1875)          OUTPUT(1, 'AL23', 'unknown message kind: $')
  2536  (1876)          OUTPUT(1, 'I6', kind)
  2537  (1877)          OUTPUT(1, 'AL1', '$')
  2538  (1878)  
  2539  (1879)          % AND THE FIRST BYTES, BECAUSE THE NUMBER ALONE CANNOT SETTLE IT.
  2540  (1880)          %
  2541  (1881)          % MEASURED 2026-08-22: kind 123 arrives on EVERY start-up, and the
  2542  (1882)          % welcome line that should be there is MISSING - so 123 IS the welcome,
  2543  (1883)          % mis-read, not an extra message. The same welcome parses correctly when
  2544  (1884)          % it arrives LATER (on the /nick path), and both paths call the same
  2545  (1885)          % drainPort. So the difference is ordinal: the FIRST message on the port
  2546  (1886)          % is read differently from every one after it.
  2547  (1887)          %
  2548  (1888)          % 123 is 0x7B, '{' - a printable character sitting where a kind belongs,
  2549  (1889)          % which is what a BODY byte looks like when every field has been shifted
  2550  (1890)          % by an unskipped header. CHATSV carries a comment about exactly this
  2551  (1891)          % class of fault on the SERVER side ("serial number instead of kJoin,
  2552  (1892)          % which is how the missing header skip..."), so this may be its twin.
  2553  (1893)          %
  2554  (1894)          % These six bytes decide it. If they read as text or as the tail of a
  2555  (1895)          % letter header, the shift is confirmed and the fix is a header skip on
  2556  (1896)          % the first receive. If they look like a sane message that simply has an
  2557  (1897)          % unexpected kind, the answer is somewhere else entirely.
  2558  (1898)          %
  2559  (1899)          % TEMPORARY. Delete once the question is answered - a dump nobody can
  2560  (1900)          % turn off is noise, which is the mistake the status line already made.
  2561  (1901)          OUTPUT(1, 'AL12', 'first six: $')
  2562  (1902)          FOR i IN 0:5 DO
  2563  (1903)              OUTPUT(1, 'I5', inBuf(i))
  2564  (1904)          ENDFOR
  2565  (1905)          OUTPUT(1, 'AL1', '$')
  2566  (1906)      ENDROUTINE
  2567  (1907)  
  2568  (1908)      % -----------------------------------------------------------------------
  2569  (1909)      % Take everything the port is holding and print it, WITHOUT WAITING.
  2570  (1910)      %
  2571  (1911)      % flags ZERO means no XFWTF, and that is XMSG's own no-wait: the call
  2572  (1912)      % returns at once whether or not a message was there. Nothing about the
  2573  (1913)      % terminal is involved, which is why this works on a machine where the
  2574  (1914)      % no-wait TERMINAL switch (TNOWAIT 307B) cannot be reached from PLANC.
  2575  (1915)      %
  2576  (1916)      % A SUCCESSFUL RECEIVE DOES RETURN ZERO ON THIS MACHINE, and the opposite
  2577  (1917)      % claim used to stand here. It read: "A SUCCESSFUL RECEIVE DOES NOT RETURN
  2578  (1918)      % ZERO ... a message arrived exactly when the status is POSITIVE", citing
  2579  (1919)      % the constants file's "Message types: Returned as successfull status from
  2580  (1920)      % XFRCV", XMTNO=1 through XMTPS=6.
  2581  (1921)      %
  2582  (1922)      % MEASURED 2026-08-18: the server, doing the same call, prints st= 0 with
  2583  (1923)      % the type in the msgType out-parameter. The constants file is describing
  2584  (1924)      % the RAW MON 200B interface underneath; through the XMP library the status
  2585  (1925)      % is XMOK and the type comes back separately. Appendix G's sample agrees -
  2586  (1926)      % it tests "IF RETURNSTATUS >< XMOK" and only then reads MSGTYPE.
  2587  (1927)      %
  2588  (1928)      % Excluding zero cost the whole join: XMPFRCV took the welcome off the
  2589  (1929)      % queue, returned XMOK, and the test below dropped straight out of the loop
  2590  (1930)      % without printing, reading or releasing it. See the note on the test.
  2591  (1931)      % -----------------------------------------------------------------------
  2592  (1932)      % PLANC HAS NO "WHILE cond DO ... ENDWHILE". WHILE is a CONTINUE-TEST
  2593  (1933)      % written INSIDE a DO ... ENDDO body: reaching it with a false condition
  2594  (1934)      % leaves the loop. ND-60.117.5 shows it that way ("continue the loop only
  2595  (1935)      % for negative array elements ... WHILE a(i)<0"), and writing the header
  2596  (1936)      % form gets WHILE NOT INSIDE LOOP followed by ILLEGAL SYNTAX "ENDWHILE".
  2597  (1937)      % -----------------------------------------------------------------------
  2598  (1938)      % Print an XMSG status with its name and meaning, then say where it came
  2599  (1939)      % from. Called on every path that gives up, so a failure never leaves just
  2600  (1940)      % a number - or worse, nothing at all.
  2601  (1941)      %
  2602  (1942)      % THE LIBRARY'S STATUS MODEL IS NOT THE KERNEL'S, and that difference cost
  2603  (1943)      % a whole evening. Through the XMP routines:
  2604  (1944)      %
  2605  (1945)      %   0                  XMOK - done. The kernel's own OK is 1; XMP-B02:DEFS
  2606  (1946)      %                      remaps it and says so: "NOTE change from XMSG OK=1".
  2607  (1947)      %   16896              XMXENTM - NOT TERMINATED. This is what an EMPTY port
  2608  (1948)      %                      answers, and it is NOT an error.
  2609  (1949)      %   16896 + n          an error, where n is the absolute value of the raw
  2610  (1950)      %                      kernel code. So the raw XEIBP = -6 appears here as
  2611  (1951)      %                      XMXEIBP = 16902.
  2612  (1952)      %   1 .. 6             a MESSAGE TYPE. Documented as a status from XFRCV,
  2613  (1953)      %                      but MEASURED 2026-08-18 the library answers XMOK and
  2614  (1954)      %                      puts the type in the msgType out-parameter instead.
  2615  (1955)      %                      Both forms are accepted on a receive for that reason.
  2616  (1956)      %
  2617  (1957)      % Which is why testing a receive with "> 0" is wrong: 16896 and every error
  2618  (1958)      % are positive too. Measured live: type=0 rel=16902, an empty port being
  2619  (1959)      % read as a message and then released, for ever.
  2620  (1960)      %
  2621  (1961)      % AND WHY TESTING IT WITH "1..6 ONLY" IS EQUALLY WRONG, which took longer to
  2622  (1962)      % find because it fails SILENTLY: XMPFRCV dequeues the message and returns
  2623  (1963)      % XMOK, the test rejects it, and the loop exits having printed nothing. A
  2624  (1964)      % receive must accept XMOK **or** 1..6 - see drainPort.
  2625  (1965)      %
  2626  (1966)      % The numbers are from XMP-B02:DEFS as extracted from the ND-10609 media;
  2627  (1967)      % the texts are the matching XE... comments in XMSG-PL-VALUES-L:INCL.
  2628  (1968)      % -----------------------------------------------------------------------
  2629  (1969)  
  2630  (1970)      % -----------------------------------------------------------------------
  2631  (1971)      % Switch this terminal's INPUT side in and out of no-wait.
  2632  (1972)      %
  2633  (1973)      % THIS IS THE THING THE POLL LOOP ALWAYS ASSUMED AND NOBODY EVER SWITCHED
  2634  (1974)      % ON. The loop below was written for a no-wait terminal - it catches
  2635  (1975)      % ROUTINEERROR from MON1 and reads ErrCode 3 as "nothing was typed" - and a
  2636  (1976)      % comment there claims "the terminal is in no-wait". It was not. Nothing in
  2637  (1977)      % this program ever asked for it, so MON1 BLOCKED, and the loop never got
  2638  (1978)      % back round to drainPort until the user pressed return.
  2639  (1979)      %
  2640  (1980)      % MEASURED ON D100, 2026-08-20: two people in a room, and neither saw the
  2641  (1981)      % other's line until they typed something themselves. The speaker always saw
  2642  (1982)      % their own words at once, because pressing return is what let the loop go
  2643  (1983)      % round. That is indistinguishable from a message that was never sent, and
  2644  (1984)      % it cost an afternoon of hunting a delivery fault in a server that was
  2645  (1985)      % delivering to everybody correctly.
  2646  (1986)      %
  2647  (1987)      % IT DID NOT NEED MAC AFTER ALL. The notes at the foot of this file weigh a
  2648  (1988)      % hand-written MAC interface routine for TNOWAIT (307B) against an XFWAK
  2649  (1989)      % experiment, because "TNOWAIT cannot be had here". Both are unnecessary:
  2650  (1990)      % MONITOR_CALL takes a call BY NAME and handles output parameters - CHATSV
  2651  (1991)      % has been calling MONITOR_CALL('TimeOut', ...) for exactly that reason -
  2652  (1992)      % and MON-CALL-1B-A00 is already in this client's LOAD list. NoWaitSwitch
  2653  (1993)      % (NOWT 36B) takes three parameters and ALL THREE ARE INPUTS, so there is
  2654  (1994)      % not even an output to get wrong.
  2655  (1995)      %
  2656  (1996)      % ALWAYS SWITCH IT BACK. A terminal left in no-wait is one the user's shell
  2657  (1997)      % has to live with after this program ends, so every exit path goes through
  2658  (1998)      % terminalWait - see the leave path at the end of the main loop.
  2659  (1999)      % -----------------------------------------------------------------------
  2660  (2000)      % EVERY ONE OF THESE IS GUARDED, AND THE FIRST VERSION WAS NOT.
  2661  (2001)      %
  2662  (2002)      % MEASURED ON D100, 2026-08-21. The unguarded call killed the client the
  2663  (2003)      % instant it joined:
  2664  (2004)      %
  2665  (2005)      %     @NDCHAT
  2666  (2006)      %     CHAT: you are OLAV  (/nick to change)
  2667  (2007)      %     CHAT: joining (LOBBY) - type and press return
  2668  (2008)      %     NO ROUTINEERROR HANDLER, ERRETURN=177777B
  2669  (2009)      %     @
  2670  (2010)      %
  2671  (2011)      % A MONITOR_CALL that SINTRAN refuses raises a ROUTINEERROR, and an
  2672  (2012)      % unhandled one unwinds the whole program - after the join has been sent,
  2673  (2013)      % so it also leaves a seat behind in the room. The server was fine; the
  2674  (2014)      % client shot itself.
  2675  (2015)      %
  2676  (2016)      % THE FALLBACK IS THE OLD BEHAVIOUR, WHICH IS WHY THIS IS SAFE. Without the
  2677  (2017)      % switch, MON1 blocks and the loop comes round when the user presses return
  2678  (2018)      % - the very thing this change is trying to improve, but a working client.
  2679  (2019)      % So a refusal is worth ONE LINE ON SCREEN and nothing more.
  2680  (2020)      %
  2681  (2021)      % WHICH NAME IS RIGHT IS NOT SETTLED. MONITOR_CALL by NAME works here -
  2682  (2022)      % CHATSV has been calling MONITOR_CALL('TimeOut', ...) for weeks - so the
  2683  (2023)      % mechanism is proved and it is the SPELLING that is in doubt. The Monitor
  2684  (2024)      % Calls manual gives two candidates and their short names:
  2685  (2025)      %     NoWaitSwitch   (NOWT   36B)  LDN, io flag, no-wait flag - ALL INPUTS
  2686  (2026)      %     TerminalNoWait (TNOWAI 307B) LDN, io flag, no-wait flag, status OUT
  2687  (2027)      % If the line below prints, try the other name, and then try inputFlag the
  2688  (2028)      % other way round - 0 for input is what this file has always claimed and
  2689  (2029)      % nothing has ever exercised it.
  2690  (2030)      % TWO NAMES TRIED, AND THE REASON PRINTED. One build, one answer.
  2691  (2031)      %
  2692  (2032)      % 'NoWaitSwitch' is refused on D100 - measured 2026-08-21, the client
  2693  (2033)      % printed its fallback line. But a refusal alone does not say WHETHER the
  2694  (2034)      % name is unknown or the PARAMETERS are wrong, and guessing between those
  2695  (2035)      % costs a build cycle each time. ErrCode is supplied by the runtime inside
  2696  (2036)      % the handler and it is the difference between the two, so it is printed.
  2697  (2037)      %
  2698  (2038)      % Then the other spelling is tried. The Monitor Calls manual offers both:
  2699  (2039)      %     NoWaitSwitch   (NOWT   36B)  LDN, io flag, no-wait flag       3 IN
  2700  (2040)      %     TerminalNoWait (TNOWAI 307B) LDN, io flag, no-wait flag, st   3 IN 1 OUT
  2701  (2041)      % MONITOR_CALL handles an output parameter - CHATSV passes one to TimeOut -
  2702  (2042)      % so the second form costs nothing to attempt.
  2703  (2043)      %
  2704  (2044)      % IF BOTH ARE REFUSED, the remaining suspect is ownTerminal. It is 1, the
  2705  (2045)      % SINTRAN "own terminal" file number, and what NoWaitSwitch wants is the
  2706  (2046)      % LDN OF A CHARACTER DEVICE, which is not obviously the same thing.
  2707  (2047)      ROUTINE VOID, VOID : terminalNoWait
  2708  (2048)          BOOLEAN : switchFailed
  2709  (2049)          INTEGER : nowaitStatus
  2710  (2050)  
  2711  (2051)          ON ROUTINEERROR DO
  2712  (2052)              TRUE =: switchFailed
  2713  (2053)              ErrCode =: firstErr
  2714  (2054)          ENDON
  2715  (2055)          FALSE =: switchFailed
  2716  (2056)          0 =: firstErr
  2717  (2057)  
  2718  (2058)          % THE NAME THAT WORKS GOES FIRST, and this used to be the other way
  2719  (2059)          % round. NoWaitSwitch is REFUSED on this machine - ErrCode -1, measured -
  2720  (2060)          % so trying it first meant printing
  2721  (2061)          %
  2722  (2062)          %     CHAT: NoWaitSwitch err     -1
  2723  (2063)          %
  2724  (2064)          % on EVERY start-up, before quietly succeeding under the other name. A
  2725  (2065)          % diagnostic for a call we already know will fail is not a diagnostic,
  2726  (2066)          % it is noise, and it made a working start-up look broken. terminalWait
  2727  (2067)          % has always tried TerminalNoWait first; the two must agree or the
  2728  (2068)          % restore does nothing.
  2729  (2069)          0 =: nowaitStatus
  2730  (2070)          MONITOR_CALL('TerminalNoWait', ownTerminal, inputFlag, noWaitOn, &
  2731  (2071)              nowaitStatus)
  2732  (2072)  
  2733  (2073)          IF switchFailed THEN
  2734  (2074)              % Fall back SILENTLY. A machine where the other name is the live
  2735  (2075)              % one is a possibility, not a fault worth reporting.
  2736  (2076)              ON ROUTINEERROR DO
  2737  (2077)                  TRUE =: switchFailed
  2738  (2078)                  ErrCode =: firstErr
  2739  (2079)              ENDON
  2740  (2080)              FALSE =: switchFailed
  2741  (2081)              0 =: firstErr
  2742  (2082)  
  2743  (2083)              MONITOR_CALL('NoWaitSwitch', ownTerminal, inputFlag, noWaitOn)
  2744  (2084)          ENDIF
  2745  (2085)  
  2746  (2086)          % ONLY IF BOTH WERE REFUSED is anything said, and then it says what the
  2747  (2087)          % user will SEE rather than which call failed - the number helps nobody
  2748  (2088)          % holding a keyboard.
  2749  (2089)          % A REFUSAL ARRIVES TWO DIFFERENT WAYS, AND BOTH MEAN THE SAME THING TO
  2750  (2090)          % WHOEVER IS HOLDING THE KEYBOARD.
  2751  (2091)          %
  2752  (2092)          %   NoWaitSwitch   (NOWT   36B)  RAISES          - ErrCode -1
  2753  (2093)          %   TerminalNoWait (TNOWAI 307B) RAISES NOTHING  - status -1
  2754  (2094)          %
  2755  (2095)          % MEASURED ON D100 2026-08-22 by printing the status, which until then
  2756  (2096)          % was captured into nowaitStatus and NEVER READ. That is why this was a
  2757  (2097)          % puzzle for so long: the call looked like it worked, because it did not
  2758  (2098)          % raise, and MON1 went on blocking anyway. AN ABSENT ERROR IS NOT A
  2759  (2099)          % SUCCESS - the earlier note here claimed TerminalNoWait "SUCCEEDS", and
  2760  (2100)          % that was inferred from the absence of a raise rather than measured.
  2761  (2101)          %
  2762  (2102)          % So no-wait terminal input is simply NOT AVAILABLE to this program on
  2763  (2103)          % this machine. That is a fact to design around, not a bug to keep
  2764  (2104)          % poking at, and in particular it is NOT worth experimenting with
  2765  (2105)          % inputFlag again - 1 was already measured as strictly worse. The
  2766  (2106)          % refusal is in the CALL, not the flag.
  2767  (2107)          %
  2768  (2108)          % The raw number is not printed any more. It has been read, understood
  2769  (2109)          % and written down; leaving it on the screen at every start-up would be
  2770  (2110)          % noise, which is the same mistake as the "NoWaitSwitch err -1" line
  2771  (2111)          % that used to greet every user.
  2772  (2112)          IF switchFailed OR nowaitStatus >< 0 THEN
  2773  (2113)              OUTPUT(1, 'AL38', '$new lines show when you press return$')
  2774  (2114)          ENDIF
  2775  (2115)      ENDROUTINE
  2776  (2116)  
  2777  (2117)      % Putting it BACK is silent whatever happens. If the switch never went on,
  2778  (2118)      % switching it off is a no-op; if it did, this is the only thing standing
  2779  (2119)      % between the user and a shell whose terminal does not wait for input.
  2780  (2120)      % PUT IT BACK WITH THE NAME THAT ACTUALLY WORKS.
  2781  (2121)      %
  2782  (2122)      % This used to call NoWaitSwitch, which is REFUSED on this machine with
  2783  (2123)      % ErrCode -1 - so the restore silently did nothing while the switch-on had
  2784  (2124)      % quietly succeeded under the other name. A terminal left in no-wait is one
  2785  (2125)      % the user's shell has to live with, so the two must use the SAME name.
  2786  (2126)      % TerminalNoWait is tried first here for that reason, with NoWaitSwitch kept
  2787  (2127)      % only as a fallback for a machine where the other one is the live one.
  2788  (2128)      ROUTINE VOID, VOID : terminalWait
  2789  (2129)          BOOLEAN : switchFailed
  2790  (2130)          INTEGER : nowaitStatus
  2791  (2131)  
  2792  (2132)          0 =: nowaitStatus
  2793  (2133)          ON ROUTINEERROR DO
  2794  (2134)              TRUE =: switchFailed
  2795  (2135)          ENDON
  2796  (2136)          FALSE =: switchFailed
  2797  (2137)  
  2798  (2138)          MONITOR_CALL('TerminalNoWait', ownTerminal, inputFlag, noWaitOff, &
  2799  (2139)              nowaitStatus)
  2800  (2140)  
  2801  (2141)          IF switchFailed THEN
  2802  (2142)              ON ROUTINEERROR DO
  2803  (2143)                  TRUE =: switchFailed
  2804  (2144)              ENDON
  2805  (2145)              FALSE =: switchFailed
  2806  (2146)              MONITOR_CALL('NoWaitSwitch', ownTerminal, inputFlag, noWaitOff)
  2807  (2147)          ENDIF
  2808  (2148)      ENDROUTINE
  2809  (2149)  
  2810  (2150)      % Give the machine back a moment. Called only when a pass found NOTHING -
  2811  (2151)      % no message waiting and no key pressed - so it never delays anything that
  2812  (2152)      % actually happened. Guarded for the same reason as the two above: a sleep
  2813  (2153)      % that cannot be had is not a reason to end the program.
  2814  (2154)      % -----------------------------------------------------------------------
  2815  (2155)      % Give the machine a moment when a pass found nothing.
  2816  (2156)      %
  2817  (2157)      % A GUARD THAT SETS A FLAG NOBODY READS IS NOT A GUARD, IT IS A SILENCER.
  2818  (2158)      % This routine set sleepFailed and never looked at it again, so a refused
  2819  (2159)      % TimeOut returned instantly and the main loop went round again with NO
  2820  (2160)      % SLEEP AT ALL - a SPIN against XMSG, invisible from the screen, the log and
  2821  (2161)      % the kernel tables alike. The comment beside sleepUnits already warns that
  2822  (2162)      % a bare loop here is the shape that burned the machine under CHATSV.
  2823  (2163)      %
  2824  (2164)      % That is exactly how GetUserName hid: guarded, refused, silent, and only
  2825  (2165)      % found because a diagnostic line was added on purpose. Every swallowed
  2826  (2166)      % failure in this program is a place the machine can be hurt without
  2827  (2167)      % anything saying so.
  2828  (2168)      %
  2829  (2169)      % SAID ONCE, NOT EVERY PASS. At a fifth of a second a per-pass message is a
  2830  (2170)      % flood that hides itself, so the first refusal speaks and the rest are
  2831  (2171)      % counted by their absence. If this line appears, the client has NO pacing
  2832  (2172)      % and should not be left running.
  2833  (2173)      % -----------------------------------------------------------------------
  2834  (2174)      ROUTINE VOID, VOID : idleSleep
  2835  (2175)          BOOLEAN : sleepFailed
  2836  (2176)          ON ROUTINEERROR DO
  2837  (2177)              TRUE =: sleepFailed
  2838  (2178)          ENDON
  2839  (2179)          FALSE =: sleepFailed
  2840  (2180)  
  2841  (2181)          MONITOR_CALL('TimeOut', sleepUnits, sleepKind, sleepWhy)
  2842  (2182)  
  2843  (2183)          IF sleepFailed AND NOT sleepBroken THEN
  2844  (2184)              TRUE =: sleepBroken
  2845  (2185)              OUTPUT(1, 'AL43', '$WARNING: cannot sleep - this client SPINS$')
  2846  (2186)          ENDIF
  2847  (2187)      ENDROUTINE
  2848  (2188)  
  2849  (2189)      ROUTINE VOID, VOID : drainPort
  2850  (2190)          XMMSGIDENTIFIER : msgIdent
  2851  (2191)          INTEGER : taken
  2852  (2192)  
  2853  (2193)          % THIS LOOP IS BOUNDED, and that is not caution for its own sake - the
  2854  (2194)          % unbounded version hung the client on the first live run. It kept being
  2855  (2195)          % handed a message, printed it, and asked again for ever; the terminal
  2856  (2196)          % filled with the same line until ESC broke it. Whether the message was
  2857  (2197)          % never really released or the peer kept re-offering it is not settled,
  2858  (2198)          % but either way a loop that only ends when the PEER says so is a loop
  2859  (2199)          % the peer can hang. One pass takes at most this many and then returns
  2860  (2200)          % to the keyboard; anything still waiting is taken on the next pass.
  2861  (2201)          0 =: taken
  2862  (2202)  
  2863  (2203)          DO
  2864  (2204)              xmpfrcv(0, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  2865  (2205)                  =: returnStatus
  2866  (2206)  
  2867  (2207)              % XMOK IS A SUCCESSFUL RECEIVE. THIS TEST MUST ACCEPT ZERO.
  2868  (2208)              %
  2869  (2209)              % It did not, and that single missing case is what silently ate the
  2870  (2210)              % welcome. MEASURED on D100 2026-08-18, end to end:
  2871  (2211)              %
  2872  (2212)              %   the server prints  SV: rcv st=  0  t=  2  len= 25
  2873  (2213)              %                                  ^ XMOK, with the type in msgType
  2874  (2214)              %
  2875  (2215)              %   the client's port  LIST-PORTS: port 13  Qhead 161641  Qlen 1
  2876  (2216)              %   one keystroke later                     Qhead 0       Qlen 0
  2877  (2217)              %   and the client printed NOTHING - not even the unconditional
  2878  (2218)              %   "type= / rel=" line below, which every taken message reaches.
  2879  (2219)              %
  2880  (2220)              % That is the whole story: XMPFRCV succeeded, returned XMOK, and
  2881  (2221)              % DEQUEUED the message - which is why Qlen fell to zero - and then
  2882  (2222)              % this continue-test read 0 >= XMTNO as false and left the loop
  2883  (2223)              % before a single byte was printed, before XMPFMST, before XMPFREA,
  2884  (2224)              % and before XMPFREL. The message was received and abandoned. It was
  2885  (2225)              % never returned to the sender either, which is why the server saw
  2886  (2226)              % no bounce.
  2887  (2227)              %
  2888  (2228)              % THE OLD COMMENT HERE ARGUED THE OPPOSITE and was wrong. It claimed
  2889  (2229)              % "a successful receive does not return zero", on the reasoning that
  2890  (2230)              % 0 means OK, 16896 means an empty port, and a bare "> 0" test is
  2891  (2231)              % true for both - all of which is correct ABOUT THE OTHER CALLS and
  2892  (2232)              % does not follow for XMPFRCV. The vendor sample in Appendix G tests
  2893  (2233)              % "IF RETURNSTATUS >< XMOK THEN bad status" and only then looks at
  2894  (2234)              % MSGTYPE, so XMOK is the success case and the TYPE lives in the
  2895  (2235)              % out-parameter, not in the status.
  2896  (2236)              %
  2897  (2237)              % The earlier "type=0 rel=16902" reading that seemed to prove the
  2898  (2238)              % old rule was an EMPTY port being read and then released - a real
  2899  (2239)              % fault, but a different one, and fixing it by excluding zero threw
  2900  (2240)              % out every genuine message with it.
  2901  (2241)              %
  2902  (2242)              % CHATSV was widened for exactly this reason and this client never
  2903  (2243)              % was. Both sides now spell the same rule, and the range is kept
  2904  (2244)              % beside XMOK rather than replaced by it, because which form turns
  2905  (2245)              % up is measured rather than assumed.
  2906  (2246)              %
  2907  (2247)              % 16896 (XMXENTM, "not terminated") is what an EMPTY port answers
  2908  (2248)              % and is still correctly excluded - it is neither XMOK nor 1..6.
  2909  (2249)              WHILE returnStatus = XMOK OR &
  2910  (2250)                    (returnStatus >= XMTNO AND returnStatus <= XMTPS)
  2911  (2251)  
  2912  (2252)              taken + 1 =: taken
  2913  (2253)              WHILE taken <= maxDrain
  2914  (2254)  
  2915  (2255)              xmpfmst(0, msgIdent, msgType, senderMagic, nBytes) =: returnStatus
  2916  (2256)  
  2917  (2257)              % CLAMP BEFORE READING. nBytes is the SENDER'S message size, handed
  2918  (2258)              % back by XMSG - not a size this program chose. inBuf holds
  2919  (2259)              % inBufSize bytes and PLANC checks no array bound, so passing nBytes
  2920  (2260)              % straight in lets anyone who sends a longer message write straight
  2921  (2261)              % past the end of it. That is a WRITE overflow and it happens before
  2922  (2262)              % a single field is parsed, so none of the checks in showArrived
  2923  (2263)              % could save it.
  2924  (2264)              nBytes =: readAmount
  2925  (2265)              IF readAmount > inBufSize THEN
  2926  (2266)                  inBufSize =: readAmount
  2927  (2267)              ENDIF
  2928  (2268)  
  2929  (2269)              xmpfrea(0, 0, &
  2930  (2270)                  ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  2931  (2271)                  0, readAmount, readLength) =: returnStatus
  2932  (2272)              % A RETURN MESSAGE IS OUR OWN LETTER COMING BACK UNDELIVERED.
  2933  (2273)              % XMTRE is the type XMSG uses for "abnormal condition", and the
  2934  (2274)              % commonest reason a join bounces is that the peer does not have us
  2935  (2275)              % as a friend - the same fault XRUNN and XRNRO report from the
  2936  (2276)              % other direction. Saying so here means the user is told once,
  2937  (2277)              % whichever way the machine chooses to complain.
  2938  (2278)              IF msgType = XMTRE THEN
  2939  (2279)                  OUTPUT(1, 'AL40', 'that message came BACK - undeliverable.$')
  2940  (2280)                  showFriendAdvice
  2941  (2281)              ENDIF
  2942  (2282)  
  2943  (2283)              xmpfrel(0, msgIdent) =: returnStatus
  2944  (2284)  
  2945  (2285)              % A "type= rel=" line used to print here on every message taken.
  2946  (2286)              % It was temporary, it said so, and it has done its job: the loop
  2947  (2287)              % that printed the same message for ever is understood and fixed
  2948  (2288)              % (see the ROUTINEERROR handler in the main loop), and the empty
  2949  (2289)              % port being read and released - the "type=0 rel=16902" reading -
  2950  (2290)              % is excluded by the continue-test above.
  2951  (2291)              %
  2952  (2292)              % What it proved is kept in the comments that surround it rather
  2953  (2293)              % than on the user's screen. Put it back if this loop ever misbehaves
  2954  (2294)              % again: msgType and returnStatus are the two numbers that say why.
  2955  (2295)  
  2956  (2296)              showArrived
  2957  (2297)          ENDDO
  2958  (2298)  
  2959  (2299)          % How many this pass printed, for the main loop's idle test. Nothing
  2960  (2300)          % else reads it, and it is a COUNT rather than a boolean so a future
  2961  (2301)          % question like "are we falling behind" has a number to look at.
  2962  (2302)          taken =: lastDrainCount
  2963  (2303)  
  2964  (2304)          % ---- DID THE PORT GO AWAY WHILE WE WERE NOT LOOKING? ---------------
  2965  (2305)          % The loop above ends on ANY status that is not a message, and until now
  2966  (2306)          % it ended silently on all of them. That is right for XMXENTM, which
  2967  (2307)          % just means the port is empty and is the normal way round; it is wrong
  2968  (2308)          % for XMXENRU, "XMSG is not running", because the client then sits at
  2969  (2309)          % its prompt looking perfectly connected to a room that no longer
  2970  (2310)          % exists, and everything typed goes nowhere.
  2971  (2311)          %
  2972  (2312)          % MEASURED 2026-08-18: XMSG went down under a running server. The
  2973  (2313)          % SERVER span at full speed on the same status (it waits with XFWTF, so
  2974  (2314)          % a receive that cannot block returns instantly for ever); this client
  2975  (2315)          % would not have spun, because its drain never waits - it would just
  2976  (2316)          % have gone quiet and told nobody. Two different failures from one
  2977  (2317)          % cause, which is why both programs needed their own answer.
  2978  (2318)          %
  2979  (2319)          % Stopping is the honest one here. There is no reconnect to attempt: a
  2980  (2320)          % port belongs to an XMSG that is gone, and when it comes back this
  2981  (2321)          % program has to open a new one and rejoin from the beginning - which
  2982  (2322)          % is exactly what starting it again does.
  2983  (2323)          IF returnStatus = XMXENRU THEN
  2984  (2324)              OUTPUT(1, 'AL27', 'XMSG has stopped - leaving$')
  2985  (2325)              FALSE =: joined
  2986  (2326)              0 =: serverMagic
  2987  (2327)              FALSE =: running
  2988  (2328)          ENDIF
  2989  (2329)      ENDROUTINE
  2990  (2330)  
  2991  (2331)      % -----------------------------------------------------------------------
  2992  (2332)      % Does the typed line begin with "/word"? Case is folded, so /WHO and /who
  2993  (2333)      % are the same command.
  2994  (2334)      %
  2995  (2335)      % typed(0) is the slash, so the word starts at 1. A match also requires the
  2996  (2336)      % character AFTER the word to be a space or the end of the line - without
  2997  (2337)      % that test "/nickname" would match "/nick" and the rest be read as an
  2998  (2338)      % argument.
  2999  (2339)      % -----------------------------------------------------------------------
  3000  (2340)      ROUTINE VOID, INTEGER (BYTES, INTEGER) : cmdIs(word, wordLen)
  3001  (2341)          INTEGER : i, c, w
  3002  (2342)  
  3003  (2343)          IF typedLen < wordLen + 1 THEN
  3004  (2344)              0 RETURN
  3005  (2345)          ENDIF
  3006  (2346)  
  3007  (2347)          FOR i IN 1:wordLen DO
  3008  (2348)              typed(i) =: c
  3009  (2349)              % Fold lower case to upper: 'a' is 97, 'z' is 122.
  3010  (2350)              IF c >= 97 AND c <= 122 THEN
  3011  (2351)                  c - 32 =: c
  3012  (2352)              ENDIF
  3013  (2353)              word(i - 1) =: w
  3014  (2354)              IF c >< w THEN
  3015  (2355)                  0 RETURN
  3016  (2356)              ENDIF
  3017  (2357)          ENDFOR
  3018  (2358)  
  3019  (2359)          % The word must END here - the next character is a space or nothing.
  3020  (2360)          IF typedLen = wordLen + 1 THEN
  3021  (2361)              1 RETURN
  3022  (2362)          ENDIF
  3023  (2363)  
  3024  (2364)          IF typed(wordLen + 1) = 32 THEN
  3025  (2365)              1 RETURN
  3026  (2366)          ENDIF
  3027  (2367)  
  3028  (2368)          0 RETURN
  3029  (2369)      ENDROUTINE
  3030  (2370)  
  3031  (2371)      % -----------------------------------------------------------------------
  3032  (2372)      % A line beginning with "/" is a command, not something to say.
  3033  (2373)      %
  3034  (2374)      % WHAT IS AND IS NOT IMPLEMENTED, and the difference matters. /nick, /leave
  3035  (2375)      % and /quit map onto message kinds that ALREADY EXIST on the wire - kRename
  3036  (2376)      % and kLeave - and /join re-sends the join CHAT already sends at startup, to
  3037  (2377)      % a different room name. None of those invent anything.
  3038  (2378)      %
  3039  (2379)      % /who does NOT map onto anything. There is no query kind in the format, and
  3040  (2380)      % the format is pinned byte-for-byte by ChatMessageGoldenBytesTests on the
  3041  (2381)      % C# side, so adding one is a change to BOTH ends in the same commit - not
  3042  (2382)      % something this file may do on its own. It says so rather than pretending.
  3043  (2383)      % -----------------------------------------------------------------------
  3044  (2384)      ROUTINE VOID, VOID : handleCommand
  3045  (2385)          INTEGER : at, argLen, i, length
  3046  (2386)  
  3047  (2387)          IF cmdIs('HELP', 4) = 1 THEN
  3048  (2388)              OUTPUT(1, 'AL15', 'CHAT commands:$')
  3049  (2389)              OUTPUT(1, 'AL11', 'you are in ')
  3050  (2390)              showRoom
  3051  (2391)              OUTPUT(1, 'AL1', '$')
  3052  (2392)              OUTPUT(1, 'AL47', '  /join <room>   join another room, short name$')
  3053  (2393)              OUTPUT(1, 'AL38', '  /nick <name>   change your nickname$')
  3054  (2394)              OUTPUT(1, 'AL37', '  /who           who is in this room$')
  3055  (2395)              OUTPUT(1, 'AL32', '  /leave         leave the room$')
  3056  (2396)              OUTPUT(1, 'AL32', '  /quit          leave and stop$')
  3057  (2397)              OUTPUT(1, 'AL36', '  anything else is said to the room$')
  3058  (2398)              RETURN
  3059  (2399)          ENDIF
  3060  (2400)  
  3061  (2401)          % /who - ask the room for its membership list.
  3062  (2402)          %
  3063  (2403)          % This used to print three lines saying the format had no kind for it.
  3064  (2404)          % It has one now: kWho = 11, added to ChatMessageKind.cs, CHATSV.PLNC
  3065  (2405)          % and here together, which is what those lines said the change needed.
  3066  (2406)          % The answer arrives later as an ordinary message and is printed by
  3067  (2407)          % showArrived - nothing waits here.
  3068  (2408)          IF cmdIs('WHO', 3) = 1 THEN
  3069  (2409)              IF NOT joined THEN
  3070  (2410)                  OUTPUT(1, 'AL34', 'not in a room yet - wait or /join$')
  3071  (2411)                  RETURN
  3072  (2412)              ENDIF
  3073  (2413)              buildOwn(kWho, 0) =: length
  3074  (2414)              sendToServer(length)
  3075  (2415)              RETURN
  3076  (2416)          ENDIF
  3077  (2417)  
  3078  (2418)          IF cmdIs('JOIN', 4) = 1 THEN
  3079  (2419)              6 =: at
  3080  (2420)              typedLen - at =: argLen
  3081  (2421)              IF argLen < 1 THEN
  3082  (2422)                  OUTPUT(1, 'AL24', '/join needs a room name$')
  3083  (2423)                  RETURN
  3084  (2424)              ENDIF
  3085  (2425)              IF argLen > maxNameLen THEN
  3086  (2426)                  OUTPUT(1, 'AL27', 'that room name is too long$')
  3087  (2427)                  RETURN
  3088  (2428)              ENDIF
  3089  (2429)  
  3090  (2430)              % LEAVE THE OLD ROOM FIRST. Without this the old room still counts
  3091  (2431)              % us as a member and still holds our seat: it never hears that we
  3092  (2432)              % went, and a room only gives a seat back on a clean leave or on a
  3093  (2433)              % reap. Two or three /joins and the room is full of people who are
  3094  (2434)              % not there. The reported "/join doesn't work" hid this one - the
  3095  (2435)              % join never reached a room, so the leak never had a chance to show.
  3096  (2436)              IF joined THEN
  3097  (2437)                  buildOwn(kLeave, 0) =: length
  3098  (2438)                  sendToServer(length)
  3099  (2439)              ENDIF
  3100  (2440)  
  3101  (2441)              % Re-point the room and send the join again. setRoom adds the
  3102  (2442)              % "CHAT-" prefix; the raw copy that stood here is the whole of the
  3103  (2443)              % /join defect.
  3104  (2444)              setRoom(at, argLen)
  3105  (2445)              FALSE =: joined
  3106  (2446)              0 =: serverMagic
  3107  (2447)              OUTPUT(1, 'AL8', 'joining ')
  3108  (2448)              showRoom
  3109  (2449)              OUTPUT(1, 'AL4', '...$')
  3110  (2450)              sendJoin
  3111  (2451)              RETURN
  3112  (2452)          ENDIF
  3113  (2453)  
  3114  (2454)          IF cmdIs('NICK', 4) = 1 THEN
  3115  (2455)              6 =: at
  3116  (2456)              typedLen - at =: argLen
  3117  (2457)              IF argLen < 1 THEN
  3118  (2458)                  OUTPUT(1, 'AL19', '/nick needs a name$')
  3119  (2459)                  RETURN
  3120  (2460)              ENDIF
  3121  (2461)              IF argLen > maxNameLen THEN
  3122  (2462)                  OUTPUT(1, 'AL22', 'that name is too long$')
  3123  (2463)                  RETURN
  3124  (2464)              ENDIF
  3125  (2465)              % NOT JOINED? THEN THIS IS NOT A RENAME - IT IS A RETRY.
  3126  (2466)              %
  3127  (2467)              % This used to answer "not in the room yet" and stop, which
  3128  (2468)              % left a refused user with NO WAY OUT: the server turns a
  3129  (2469)              % duplicate nickname away, and the client then refused the one
  3130  (2470)              % command that could fix it. The only escape was to quit and
  3131  (2471)              % edit CHAT:CNFG by hand, which no end user will do.
  3132  (2472)              % MEASURED 2026-08-20 with two terminals on one SINTRAN user:
  3133  (2473)              % both read the same CHAT:CNFG, both wanted the same name, and
  3134  (2474)              % the second was stuck.
  3135  (2475)              %
  3136  (2476)              % Both halves were individually right - the server should
  3137  (2477)              % refuse a duplicate, and a rename normally IS a message to a
  3138  (2478)              % room. The combination was the trap.
  3139  (2479)              %
  3140  (2480)              % With no room to tell, changing the name is purely local:
  3141  (2481)              % take the new name and knock again.
  3142  (2482)              % FROM HERE ON, ANY REFUSAL IS ABOUT A NAME THE USER PICKED.
  3143  (2483)              %
  3144  (2484)              % Set BEFORE the name is even validated, because the intent is what
  3145  (2485)              % matters: once somebody has typed /nick, "that name is taken" means
  3146  (2486)              % somebody else has it - NOT that they are in the room twice. See the
  3147  (2487)              % kReject handler, which switches its whole message on this.
  3148  (2488)              TRUE =: userChoseNick
  3149  (2489)  
  3150  (2490)              % DRAIN FIRST, THEN DECIDE. A WELCOME MAY BE SITTING UNREAD.
  3151  (2491)              %
  3152  (2492)              % MEASURED 2026-08-22 with the server running: typing /nick straight
  3153  (2493)              % after starting the client printed
  3154  (2494)              %
  3155  (2495)              %     joining (LOBBY) as SYSTEM
  3156  (2496)              %     trying TESTER
  3157  (2497)              %     you are TESTER  (/nick to change)
  3158  (2498)              %     cannot join as TESTER - already joined
  3159  (2499)              %
  3160  (2500)              % "trying" is printed by the retry branch BELOW, so that branch ran -
  3161  (2501)              % which means `joined` was still FALSE. It was false only because the
  3162  (2502)              % first join's kWelcome had not been PROCESSED yet; `joined` is set
  3163  (2503)              % where kWelcome is handled. So the client sent a SECOND join and the
  3164  (2504)              % server refused it, correctly, as already joined.
  3165  (2505)              %
  3166  (2506)              % Nothing was wrong with either branch. The state they switch on was
  3167  (2507)              % simply out of date, because the welcome was still in the port. That
  3168  (2508)              % is easy to hit here: the client only renders new lines when RETURN
  3169  (2509)              % is pressed, so a welcome can be waiting while the user is typing.
  3170  (2510)              %
  3171  (2511)              % One drain pass costs nothing and settles it. It is deliberately
  3172  (2512)              % BEFORE the NOT joined test rather than inside it - the same staleness
  3173  (2513)              % would make a rename look like a retry OR a retry look like a rename.
  3174  (2514)              drainPort
  3175  (2515)  
  3176  (2516)              IF NOT joined THEN
  3177  (2517)                  setMyName(at, argLen)
  3178  (2518)  
  3179  (2519)                  % "TRYING", NOT "YOU ARE" - WE ARE NOT THAT NAME YET. This is a
  3180  (2520)                  % retry: the name goes into a fresh join and the SERVER decides.
  3181  (2521)                  % Announcing it here and then printing the server's refusal two
  3182  (2522)                  % lines later is what put
  3183  (2523)                  %     you are ANNA
  3184  (2524)                  %     OLAV: that nickname is taken
  3185  (2525)                  % on the screen - the client claiming a name, the server denying
  3186  (2526)                  % a different one, and nothing to connect the two.
  3187  (2527)                  OUTPUT(1, 'AL7', 'trying ')
  3188  (2528)                  showMyName
  3189  (2529)                  OUTPUT(1, 'AL1', '$')
  3190  (2530)                  sendJoin
  3191  (2531)                  RETURN
  3192  (2532)              ENDIF
  3193  (2533)  
  3194  (2534)              % THE NEW NAME GOES IN THE NAME FIELD - see buildRename, which is
  3195  (2535)              % where the whole story of this being wrong the other way round is
  3196  (2536)              % written down. It reads the name straight out of typed, so there is
  3197  (2537)              % no shuffling to do here either.
  3198  (2538)              buildRename(at, argLen) =: length
  3199  (2539)              sendToServer(length)
  3200  (2540)  
  3201  (2541)              % Our own name changes only when the room says so, with kRenamed.
  3202  (2542)              RETURN
  3203  (2543)          ENDIF
  3204  (2544)  
  3205  (2545)          IF cmdIs('LEAVE', 5) = 1 THEN
  3206  (2546)              IF NOT joined THEN
  3207  (2547)                  OUTPUT(1, 'AL20', 'not in the room yet$')
  3208  (2548)                  RETURN
  3209  (2549)              ENDIF
  3210  (2550)              buildOwn(kLeave, 0) =: length
  3211  (2551)              sendToServer(length)
  3212  (2552)              FALSE =: joined
  3213  (2553)              0 =: serverMagic
  3214  (2554)              OUTPUT(1, 'AL14', 'left the room$')
  3215  (2555)              RETURN
  3216  (2556)          ENDIF
  3217  (2557)  
  3218  (2558)          IF cmdIs('QUIT', 4) = 1 THEN
  3219  (2559)              IF joined THEN
  3220  (2560)                  buildOwn(kLeave, 0) =: length
  3221  (2561)                  sendToServer(length)
  3222  (2562)              ENDIF
  3223  (2563)              FALSE =: running
  3224  (2564)              OUTPUT(1, 'AL4', 'bye$')
  3225  (2565)              RETURN
  3226  (2566)          ENDIF
  3227  (2567)  
  3228  (2568)          OUTPUT(1, 'AL28', 'no such command - try /help$')
  3229  (2569)      ENDROUTINE
  3230  (2570)  
  3231  (2571)      % -----------------------------------------------------------------------
  3232  (2572)      % The program.
  3233  (2573)      % -----------------------------------------------------------------------
  3234  (2574)      % -----------------------------------------------------------------------
  3235  (2575)      % The prompt: WHO you are and WHERE you are, on the line you type into.
  3236  (2576)      %
  3237  (2577)      %     [OLAV]           before any room has been entered
  3238  (2578)      %     [OLAV/LOBBY]     once the server has welcomed us into one
  3239  (2579)      %
  3240  (2580)      % A prompt is not decoration here. Without one the program gives no sign it
  3241  (2581)      % is waiting, and with arriving lines landing on the same screen there was
  3242  (2582)      % nothing to tell a typed line from a received one.
  3243  (2583)      %
  3244  (2584)      % NOT YET: [OLAV/Private:ANNA] for a private channel with one other user.
  3245  (2585)      % There is no private channel in this client to be in - no /msg, no second
  3246  (2586)      % conversation - so a prompt claiming one would be inventing a state that
  3247  (2587)      % does not exist. It goes in when the thing it names does.
  3248  (2588)      %
  3249  (2589)      % showRoom is NOT used here: it wraps the name in parentheses for prose
  3250  (2590)      % like "joining (LOBBY)", and "[OLAV/(LOBBY)]" is one bracket too many.
  3251  (2591)      % -----------------------------------------------------------------------
  3252  (2592)      ROUTINE VOID, VOID : showPrompt
  3253  (2593)          INTEGER : i
  3254  (2594)  
  3255  (2595)          OUTPUT(1, 'AL1', '[')
  3256  (2596)          showMyName
  3257  (2597)          IF joined THEN
  3258  (2598)              OUTPUT(1, 'AL1', '/')
  3259  (2599)              FOR i IN 1:lenRoomName DO
  3260  (2600)                  roomName(i - 1) =: oneChar(0)
  3261  (2601)                  OUTPUT(1, 'AL1', oneChar)
  3262  (2602)              ENDFOR
  3263  (2603)          ENDIF
  3264  (2604)          OUTPUT(1, 'AL2', '] ')
  3265  (2605)  
  3266  (2606)          % PUT BACK WHAT WAS ALREADY TYPED.
  3267  (2607)          %
  3268  (2608)          % An arriving line is printed on the line being typed into - there is
  3269  (2609)          % one cursor and the room does not wait for anyone to finish a
  3270  (2610)          % sentence. Without this, a message arriving mid-sentence silently eats
  3271  (2611)          % half of it: the characters are still in the buffer and will still be
  3272  (2612)          % sent, but the screen shows an empty prompt, so the user retypes what
  3273  (2613)          % they had and sends it twice.
  3274  (2614)          FOR i IN 1:typedLen DO
  3275  (2615)              typed(i - 1) =: oneChar(0)
  3276  (2616)              OUTPUT(1, 'AL1', oneChar)
  3277  (2617)          ENDFOR
  3278  (2618)      ENDROUTINE
  3279  (2619)  
  3280  (2620)      PROGRAM : chatClient
  3281  (2621)          XMMSGIDENTIFIER : msgIdent
  3282  (2622)          INTEGER : length
  3283  (2623)          INTEGER : i                   % the start-up room copy below uses it
  3284  (2624)  
  3285  (2625)          INISTACK stack
  3286  (2626)  
  3287  (2627)          xmpfopn(0, myPort) =: returnStatus
  3288  (2628)          IF returnStatus >< XMOK THEN
  3289  (2629)              showStatus('xmpfopn', returnStatus)
  3290  (2630)              RETURN
  3291  (2631)          ENDIF
  3292  (2632)  
  3293  (2633)          % A "port = N magic= M st= S" line used to print here, from a XMPFP2M
  3294  (2634)          % call kept only to feed it. It was there to answer one question: the
  3295  (2635)          % server was receiving the join, parsing it exactly right and answering
  3296  (2636)          % with status 0, and nothing was arriving back - so was the reply going
  3297  (2637)          % to the wrong address?
  3298  (2638)          %
  3299  (2639)          % IT WAS NOT. The reply address was never the bug. The two magic numbers
  3300  (2640)          % matched, which is what sent the search to the receive test in drainPort
  3301  (2641)          % where the real fault was: XMPFRCV returned XMOK, the test excluded
  3302  (2642)          % zero, and the welcome was dequeued and dropped. That is the whole
  3303  (2643)          % reason this diagnostic earned its keep, and the reason it can now go.
  3304  (2644)          %
  3305  (2645)          % XMPFP2M went with it. Nothing else read myMagic.
  3306  (2646)  
  3307  (2647)          % ===================================================================
  3308  (2648)          % HOW THIS CLIENT WATCHES TWO THINGS WITHOUT A NO-WAIT TERMINAL.
  3309  (2649)          %
  3310  (2650)          % The obvious design polls both: switch the terminal to no-wait with
  3311  (2651)          % TNOWAIT (307B) so INBT stops blocking, then spin on keyboard and port
  3312  (2652)          % together.
  3313  (2653)          %
  3314  (2654)          % ============================================================ SOLVED ==
  3315  (2655)          % EVERYTHING BELOW THIS LINE IS KEPT AS A RECORD OF A WRONG CONCLUSION.
  3316  (2656)          % It argued at length that a no-wait terminal could not be had here, and
  3317  (2657)          % that the client should therefore let the keyboard block. That decision
  3318  (2658)          % is what made an arriving line invisible until the user pressed return,
  3319  (2659)          % which on 2026-08-20 looked exactly like a broadcast reaching nobody
  3320  (2660)          % and cost an afternoon.
  3321  (2661)          %
  3322  (2662)          % THE WAY THROUGH IS MONITOR_CALL BY NAME, which the reasoning below
  3323  (2663)          % dismisses because "the MON-CALL-NAMES file was not found". That file
  3324  (2664)          % is supplied by MON-CALL-1B-A00, which is now INSTALLED and is already
  3325  (2665)          % in this client's LOAD list - CHATSV has been calling
  3326  (2666)          % MONITOR_CALL('TimeOut', ...) with it for weeks. And the call wanted is
  3327  (2667)          % not TNOWAIT (307B) at all but NoWaitSwitch (NOWT 36B), whose three
  3328  (2668)          % parameters are ALL INPUTS, so there is not even an output to get
  3329  (2669)          % wrong. See terminalNoWait and terminalWait above.
  3330  (2670)          %
  3331  (2671)          % The lesson is the one that keeps recurring on this project: a "cannot"
  3332  (2672)          % written down once outlives the thing that made it true. This note
  3333  (2673)          % survived the installation of the very package that answers it.
  3334  (2674)          % ======================================================================
  3335  (2675)          %
  3336  (2676)          % The old reasoning, for the record:
  3337  (2677)          %
  3338  (2678)          %   THE PORT IS DRAINED WITHOUT WAITING - xmpfrcv with flags ZERO.
  3339  (2679)          %   That is XMSG'S OWN no-wait and has nothing to do with the terminal:
  3340  (2680)          %   without XFWTF the call returns at once whether or not a message was
  3341  (2681)          %   there. So everything waiting can be taken and printed in a tight
  3342  (2682)          %   loop that never blocks.
  3343  (2683)          %
  3344  (2684)          %   THE KEYBOARD IS ALLOWED TO BLOCK - MON1, one character at a time,
  3345  (2685)          %   until carriage return.
  3346  (2686)          %
  3347  (2687)          % The one thing it costs: arriving lines are shown when you finish
  3348  (2688)          % yours, not the instant they land. Press RETURN on an empty line to
  3349  (2689)          % look. That is the whole price, and it buys a client that needs no
  3350  (2690)          % missing product, no assembler and no interface routine.
  3351  (2691)          %
  3352  (2692)          % Reading the keyboard needs INBT (1B). Getting a NO-WAIT terminal
  3353  (2693)          % would additionally need TNOWAIT (307B), and that is the one that
  3354  (2694)          % cannot be had:
  3355  (2695)          %
  3356  (2696)          % MONITOR_CALL IS THE WRONG TOOL, both ways round, and both were tried:
  3357  (2697)          %
  3358  (2698)          %   By NAME - Monitor_Call('InByte', ...), the form the Monitor Calls
  3359  (2699)          %   manual prints for PLANC - needs the MON-CALL-NAMES file. The
  3360  (2700)          %   compiler answers THE MON-CALL-NAMES FILE WAS NOT FOUND, and no such
  3361  (2701)          %   file exists under any of the nine users on this machine.
  3362  (2702)          %
  3363  (2703)          %   By NUMBER - MONITOR_CALL(1B, ...) - compiles and then does not
  3364  (2704)          %   link: it generates a call to 5MON_P, which is in neither
  3365  (2705)          %   PLANC-1BANK-F00 nor PLANC-2BANK-F00 (LIST-ENTRIES-UNDEFINED after
  3366  (2706)          %   loading both).
  3367  (2707)          %
  3368  (2708)          % WHAT THE PLANC MANUAL ACTUALLY SAYS (ND-60.117.5, appendix 0.2,
  3369  (2709)          % "Monitor Calls Available on the ND-100 and the ND-500"): the runtime
  3370  (2710)          % provides monitor calls as ORDINARY ROUTINES, one per call, named MONn
  3371  (2711)          % and IMPORTed like anything else -
  3372  (2712)          %
  3373  (2713)          %     ROUTINE VOID, BYTE (INTEGER) : MON1 (dev)      % INBIT
  3374  (2714)          %
  3375  (2715)          % which is why the COSMOS guide's own sample opens with
  3376  (2716)          % IMPORT (ROUTINE VOID, VOID: MONO) - that is MON0, LEAVE. These are
  3377  (2717)          % the MN1, MN122, MN310 ... units sitting in PLANC-1BANK-F00. So INBT
  3378  (2718)          % is reachable, correctly, as MON1(1) - no MONITOR_CALL, no names file,
  3379  (2719)          % no 5MON_P.
  3380  (2720)          %
  3381  (2721)          % TNOWAIT IS NOT. The appendix lists MON 0,1,2,3,4,11,12,17,21,45,47,
  3382  (2722)          % 50,54,62,63,64,65,104,113,114,117,120,144,161,162,167,263 - and 307
  3383  (2723)          % is not among them. The manual says what to do about that in as many
  3384  (2724)          % words: "Any monitor calls not listed here, may be called from a PLANC
  3385  (2725)          % routine if a suitable interface routine is constructed by the user.
  3386  (2726)          % If this is done, the user must load the interface routine BEFORE the
  3387  (2727)          % PLANC runtime library."
  3388  (2728)          %
  3389  (2729)          % A hand-written interface routine for MON 307B, loaded ahead of
  3390  (2730)          % PLANC-1BANK-F00, is what the manual says to do about that.
  3391  (2731)          %
  3392  (2732)          % THIS COMMENT USED TO SAY THAT WAS IMPOSSIBLE HERE. It claimed "D100 has
  3393  (2733)          % neither MAC nor NPL installed (LIST-FILES found only MACM-AREA:DATA)".
  3394  (2734)          % BOTH HALVES ARE WRONG, and the way they were wrong is worth keeping.
  3395  (2735)          %
  3396  (2736)          % LIST-FILES IS THE WRONG COMMAND FOR THIS QUESTION. Compilers and other
  3397  (2737)          % subsystems are loaded into shared memory across users, not kept as :PROG
  3398  (2738)          % files in anybody's area, so LIST-FILES was never going to find one and
  3399  (2739)          % its silence proved nothing. The command that answers it is
  3400  (2740)          % LIST-REENTRANT. On D100, 2026-08-18:
  3401  (2741)          %
  3402  (2742)          %   START RESTART SEGMENT   NAME
  3403  (2743)          %  177777B 177776B    107B   MAC
  3404  (2744)          %      0B      1B    110B   NPL
  3405  (2745)          %    752B    752B    111B   PLANC-100
  3406  (2746)          %     0B      0B    112B   PED
  3407  (2747)          %    11B     11B    113B   FORTRAN-100
  3408  (2748)          %
  3409  (2749)          % MAC and NPL are BOTH there, alongside the PLANC that builds this program.
  3410  (2750)          % @MAC answers "- MAC -".
  3411  (2751)          %
  3412  (2752)          % So the door the manual describes is open: any monitor call outside the
  3413  (2753)          % runtime's ready-made MONn set can be reached with an interface routine
  3414  (2754)          % assembled in MAC and loaded BEFORE the PLANC library. TNOWAIT (307B) is
  3415  (2755)          % the one this program wanted, and with it the loop below could stop being
  3416  (2756)          % a busy one - see "what is not finished" at the foot of the file.
  3417  (2757)          %
  3418  (2758)          % The design below still stands on its own: it needs no interface routine,
  3419  (2759)          % and it works. But it is now a CHOICE rather than the only option, and
  3420  (2760)          % nobody should read this comment and conclude the machine cannot do it.
  3421  (2761)          % ===================================================================
  3422  (2762)  
  3423  (2763)          % SETTLE THE NAME BEFORE THE JOIN, because the join CARRIES it and
  3424  (2764)          % there is no second chance to put one in. Nothing is asked of the
  3425  (2765)          % user - see setupName.
  3426  (2766)          setupName
  3427  (2767)  
  3428  (2768)          % THE DEFAULT ROOM, BUILT BY THE SAME RULE AS A TYPED /join.
  3429  (2769)          %
  3430  (2770)          % This client joins a room at start-up whether or not the user asked
  3431  (2771)          % for one, and the bug report was right that nothing said so. It is
  3432  (2772)          % said now, with the name in parentheses.
  3433  (2773)          %
  3434  (2774)          % The short name goes through "typed" because setRoom reads from there.
  3435  (2775)          % That is deliberate: the prefix is then added in ONE place for both
  3436  (2776)          % paths, and the start-up name cannot drift from the /join name.
  3437  (2777)          FOR i IN 1:lenHomeRoom DO
  3438  (2778)              homeRoom(i - 1) =: typed(i - 1)
  3439  (2779)          ENDFOR
  3440  (2780)          setRoom(0, lenHomeRoom)
  3441  (2781)  
  3442  (2782)          % WHAT IS BEING ATTEMPTED, not what has been achieved. The name here is
  3443  (2783)          % the one the join CARRIES; whether we get to keep it is the server's
  3444  (2784)          % answer, printed when the welcome arrives.
  3445  (2785)          OUTPUT(1, 'AL8', 'joining ')
  3446  (2786)          showRoom
  3447  (2787)          OUTPUT(1, 'AL4', ' as ')
  3448  (2788)          showMyName
  3449  (2789)          OUTPUT(1, 'AL1', '$')
  3450  (2790)          sendJoin
  3451  (2791)  
  3452  (2792)          % ONE LINE, NOT THE WHOLE COMMAND LIST. Printing all ten commands at
  3453  (2793)          % start-up buries the two lines that actually matter under a screen
  3454  (2794)          % nobody asked for.
  3455  (2795)          OUTPUT(1, 'AL37', 'Type /HELP for help and command list$')
  3456  (2796)  
  3457  (2797)          % showPrompt re-echoes whatever is in the typed buffer, so the buffer
  3458  (2798)          % has to MEAN something before the first prompt. Nothing above sets it,
  3459  (2799)          % and PLANC does not promise a module variable starts at zero.
  3460  (2800)          0 =: typedLen
  3461  (2801)          showPrompt
  3462  (2802)  
  3463  (2803)          % FROM HERE THE TERMINAL IS IN NO-WAIT, so MON1 stops blocking and the
  3464  (2804)          % loop below can look at the port and the keyboard in turn. Switched on
  3465  (2805)          % AFTER the join is sent, so nothing above has to care, and switched off
  3466  (2806)          % again on the way out - see the end of the loop.
  3467  (2807)          terminalNoWait
  3468  (2808)  
  3469  (2809)          DO
  3470  (2810)              % ---- take everything the port is holding, without waiting -------
  3471  (2811)              drainPort
  3472  (2812)  
  3473  (2813)              % ---- then take whatever HAS been typed, without waiting ---------
  3474  (2814)              % MON1 CAN RAISE A ROUTINEERROR, AND IT MUST BE CAUGHT HERE.
  3475  (2815)              %
  3476  (2816)              % Measured on D100: without this handler the client printed the
  3477  (2817)              % same arriving message for ever and ESC broke it out of a SPIN,
  3478  (2818)              % not out of a wait - so MON1 was not blocking at all. The terminal
  3479  (2819)              % is in no-wait BECAUSE terminalNoWait ABOVE PUT IT THERE, and that
  3480  (2820)              % call is new: for a long time this comment asserted the no-wait
  3481  (2821)              % state while nothing in the program ever asked for it, so MON1
  3482  (2822)              % really did block and the loop only came round when the user
  3483  (2823)              % pressed return. The Monitor Calls manual says what no-wait means:
  3484  (2824)              % "In No Wait, the program does not wait for input or output to
  3485  (2825)              % complete. Monitor calls like InByte return ERROR CODE 3 instead."
  3486  (2826)              % In PLANC that arrives as a ROUTINEERROR, and an unhandled one
  3487  (2827)              % unwinds the program - which re-entered, re-sent the join, and
  3488  (2828)              % produced another undeliverable letter coming back. One missing
  3489  (2829)              % handler, three symptoms.
  3490  (2830)              %
  3491  (2831)              % Caught, it is exactly the poll the design wanted: ErrCode 3 means
  3492  (2832)              % nothing was typed, so leave ch at zero and let the loop go round
  3493  (2833)              % to look at the port again. ErrCode is supplied by the runtime and
  3494  (2834)              % must NOT be declared.
  3495  (2835)              % lineReady stays FALSE until RETURN is seen. typedLen is NOT reset
  3496  (2836)              % here: a line half typed when the port needs draining has to
  3497  (2837)              % survive the trip round the outer loop, so it is only cleared once
  3498  (2838)              % the line has been dealt with.
  3499  (2839)              FALSE =: lineReady
  3500  (2840)              DO
  3501  (2841)                  0 =: ch
  3502  (2842)                  ON ROUTINEERROR DO
  3503  (2843)                      IF ErrCode >< emptyInput THEN
  3504  (2844)                          OUTPUT(1, 'AL21', 'terminal read failed$')
  3505  (2845)                      ENDIF
  3506  (2846)                      0 =: rawCh
  3507  (2847)                  ENDON
  3508  (2848)                  MON1(ownTerminal) =: rawCh
  3509  (2849)                  % PARITY. Terminal input carries an even-parity bit in bit 7,
  3510  (2850)                  % so carriage return arrives as 141, NOT 13. Compare without
  3511  (2851)                  % masking and the client never sees the user press return and
  3512  (2852)                  % looks hung rather than wrong.
  3513  (2853)                  rawCh =: ch
  3514  (2854)                  ch AND parityMask =: ch
  3515  (2855)  
  3516  (2856)                  IF ch = carriageRet THEN
  3517  (2857)                      TRUE =: lineReady
  3518  (2858)  
  3519  (2859)                      % A CARRIAGE RETURN IS NOT A NEW LINE ON THIS TERMINAL. It
  3520  (2860)                      % returns the cursor to column one of the line just typed
  3521  (2861)                      % and nothing moves it down, so whatever is printed next
  3522  (2862)                      % lands ON TOP of what the user wrote. That is what put
  3523  (2863)                      %     /whoIT-PROOF-LINE
  3524  (2864)                      % on the screen - "/who" with the next arriving line
  3525  (2865)                      % written over it - and it reads as the program mangling
  3526  (2866)                      % the input when in fact it simply never ended the line.
  3527  (2867)                      % One end-of-line here, the instant return is pressed.
  3528  (2868)                      OUTPUT(1, 'AL1', '$')
  3529  (2869)                  ENDIF
  3530  (2870)  
  3531  (2871)                  % Leave the moment the keyboard runs dry (ch = 0, nothing was
  3532  (2872)                  % typed) or the line is finished. Going round again on an empty
  3533  (2873)                  % buffer is what turns this into a spin instead of a poll.
  3534  (2874)                  WHILE ch >< 0 AND NOT lineReady
  3535  (2875)  
  3536  (2876)                  IF ch > 31 THEN
  3537  (2877)                      % The bound. A full line stops accepting characters rather
  3538  (2878)                      % than writing past the end of typed - PLANC checks no array
  3539  (2879)                      % bound, so this test is the only thing between a held-down
  3540  (2880)                      % key and the variables laid out after it.
  3541  (2881)                      IF typedLen < maxTyped THEN
  3542  (2882)                          ch =: typed(typedLen)
  3543  (2883)                          typedLen + 1 =: typedLen
  3544  (2884)                      ENDIF
  3545  (2885)                  ENDIF
  3546  (2886)              ENDDO
  3547  (2887)  
  3548  (2888)              IF lineReady AND typedLen > 0 THEN
  3549  (2889)                  % NOTHING IS SENT BEFORE THE WELCOME. serverMagic is not known
  3550  (2890)                  % until then, so sending here would post the line to address
  3551  (2891)                  % zero. ChatClient.Say refuses the same way; this is that test.
  3552  (2892)                  % A LEADING SLASH MAKES IT A COMMAND, not something to say.
  3553  (2893)                  IF typed(0) = 47 THEN
  3554  (2894)                      handleCommand
  3555  (2895)                  ELSE
  3556  (2896)                      IF joined THEN
  3557  (2897)                          buildOwn(kSay, typedLen) =: length
  3558  (2898)                          sendToServer(length)
  3559  (2899)                      ELSE
  3560  (2900)                          OUTPUT(1, 'AL20', 'not in the room yet$')
  3561  (2901)                      ENDIF
  3562  (2902)                  ENDIF
  3563  (2903)              ENDIF
  3564  (2904)  
  3565  (2905)              % Cleared only once the finished line has been dealt with, so a
  3566  (2906)              % line still being typed is not thrown away by a drain pass.
  3567  (2907)              IF lineReady THEN
  3568  (2908)                  0 =: typedLen
  3569  (2909)              ENDIF
  3570  (2910)  
  3571  (2911)              % PUT THE PROMPT BACK WHENEVER SOMETHING HAS BEEN WRITTEN OVER IT -
  3572  (2912)              % a command that has just been dealt with, or lines that arrived
  3573  (2913)              % from the room. Not on an idle pass, or an untouched screen would
  3574  (2914)              % fill with prompts a fifth of a second apart.
  3575  (2915)              IF lineReady OR lastDrainCount > 0 THEN
  3576  (2916)                  showPrompt
  3577  (2917)              ENDIF
  3578  (2918)  
  3579  (2919)              % ---- NOTHING HAPPENED? THEN GIVE THE MACHINE A MOMENT -----------
  3580  (2920)              % With the terminal in no-wait, MON1 returns at once whether or not
  3581  (2921)              % anything was typed, so a pass that found no message AND no key is
  3582  (2922)              % a pass that would otherwise go straight round again at full speed.
  3583  (2923)              % That is a SPIN, and it is the same shape that burned the machine
  3584  (2924)              % under CHATSV when XMSG died - the note beside sleepUnits carries
  3585  (2925)              % the measurement.
  3586  (2926)              %
  3587  (2927)              % The sleep is skipped whenever ANYTHING happened, so a busy room
  3588  (2928)              % and a fast typist both stay immediate; only an idle client waits,
  3589  (2929)              % and then only a fifth of a second.
  3590  (2930)              IF lastDrainCount = 0 AND typedLen = 0 AND NOT lineReady THEN
  3591  (2931)                  idleSleep
  3592  (2932)              ENDIF
  3593  (2933)  
  3594  (2934)              % /quit clears this. The continue-test goes LAST so the leave
  3595  (2935)              % message it sends is on its way before the loop ends.
  3596  (2936)              WHILE running
  3597  (2937)          ENDDO
  3598  (2938)  
  3599  (2939)          % PUT THE TERMINAL BACK. Anything that leaves this loop - /quit, or the
  3600  (2940)          % port going away when XMSG dies - hands the terminal back to the user's
  3601  (2941)          % shell, and it must be handed back in the state it was lent in. A
  3602  (2942)          % terminal left in no-wait is one every later program has to live with.
  3603  (2943)          terminalWait
  3604  (2944)      ENDROUTINE
  3605  (2945)  
  3606  (2946)  ENDMODULE
  3607  (2947)  
  3608  (2948)  % NO $EOF HERE, deliberately, and it is not an oversight - an earlier version
  3609  (2949)  % had one and it broke the build.
  3610  (2950)  %
  3611  (2951)  % $EOF belongs at the end of an INCLUDED source, where it stops the compiler
  3612  (2952)  % reading past the file's end and calling that the end of the whole
  3613  (2953)  % compilation. XMPIMP:INCL has one for exactly that reason, and so does the
  3614  (2954)  % shipped (UTILITY)XMSG-PL-VALUES-L:INCL.
  3615  (2955)  %
  3616  (2956)  % In the MAIN source it does something else: it ends the compiler SESSION. The
  3617  (2957)  % compiler links and returns to SINTRAN there and then, so every command after
  3618  (2958)  % the COMPILE - the EXIT, and any LOAD - is handed to SINTRAN instead, which
  3619  (2959)  % answers ILLEGAL COMMAND and aborts the batch job. Measured on D100: the LOAD
  3620  (2960)  % line arrived at the shell as "L".
  3621  (2961)  %
  3622  (2962)  % The library is brought in afterwards by BRF-LINKER-C01. See CHATCC:MODE.
  3623  (2963)  
  3624  (2964)  % ---------------------------------------------------------------------------
  3625  (2965)  % WHAT IS NOT FINISHED:
  3626  (2966)  %
  3627  (2967)  %  1. TWO ITEMS THAT USED TO BE ON THIS LIST WERE STALE, and they are recorded
  3628  (2968)  %     here rather than quietly deleted, because a list of open problems that
  3629  (2969)  %     keeps solved ones on it is worse than no list: it sends the next person
  3630  (2970)  %     to work that is already done.
  3631  (2971)  %
  3632  (2972)  %       "Nothing has been compiled."   It compiles and it runs. See the header.
  3633  (2973)  %
  3634  (2974)  %       "No way to leave. kLeave is declared and never sent."   /leave and
  3635  (2975)  %       /quit both send it - handleCommand, which was written after this line
  3636  (2976)  %       and never came back to cross it off.
  3637  (2977)  %
  3638  (2978)  %     The remaining items below were re-read against the code on 2026-08-18 and
  3639  (2979)  %     are still true.
  3640  (2980)  %
  3641  (2981)  %  2. THE LOOP IS A BUSY ONE. It reads the keyboard and the port as fast as the
  3642  (2982)  %     machine will go, which on a shared SINTRAN is antisocial. The server does
  3643  (2983)  %     not have this problem - it BLOCKS on XFWTF - but a client watching two
  3644  (2984)  %     things cannot block on either one.
  3645  (2985)  %
  3646  (2986)  %     THE EXPERIMENT TO RUN, which is one specific thing rather than a research
  3647  (2987)  %     project. Both halves have a documented wake:
  3648  (2988)  %
  3649  (2989)  %       the terminal   after a no-wait call, "SuspendProgram or WaitForRestart
  3650  (2990)  %                      may passivate the program afterwards. The program
  3651  (2991)  %                      restarts when input or output to the device is
  3652  (2992)  %                      completed."          (Monitor Calls, NoWaitSwitch)
  3653  (2993)  %
  3654  (2994)  %       the port       XMPFRCV with XFWAK and WITHOUT XFWTF returns at once and
  3655  (2995)  %                      ARMS a wake: "the next transmission to this port will
  3656  (2996)  %                      lead to a wake up of the receiver task". Note that "when
  3657  (2997)  %                      the wake up is done, the message is not received, and so
  3658  (2998)  %                      the receiving must be repeated."   (COSMOS guide, XFWAK)
  3659  (2999)  %
  3660  (3000)  %     So the shape to try is: arm the port with XFWAK, then WaitForRestart, and
  3661  (3001)  %     on waking re-issue the receive and re-read the keyboard, because either
  3662  (3002)  %     could be what woke us.
  3663  (3003)  %
  3664  (3004)  %     AND THE OTHER ROUTE IS OPEN AFTER ALL: MAC and NPL are BOTH installed on
  3665  (3005)  %     D100 (verified 2026-08-18 with LIST-REENTRANT, which is the command that
  3666  (3006)  %     answers this - subsystems live in shared memory, not as :PROG files, so
  3667  (3007)  %     LIST-FILES finding nothing proved nothing). So TNOWAIT (307B) can be reached
  3668  (3008)  %     the way the PLANC manual says: an interface routine assembled in MAC and
  3669  (3009)  %     loaded BEFORE PLANC-1BANK-F00. That is now a real option to weigh against the XFWAK
  3670  (3010)  %     experiment below, not a closed door.
  3671  (3011)  %
  3672  (3012)  %     WHAT IS NOT ESTABLISHED is whether an XMSG wake-up actually restarts a
  3673  (3013)  %     BACKGROUND PROGRAM passivated that way. The call that makes the wake-up
  3674  (3014)  %     context explicit, XMPFWDF, is for DRIVERS - the guide says so, and adds
  3675  (3015)  %     "not permitted for RT-programs". So this is one measurement, not a
  3676  (3016)  %     deduction, and until it is made the loop stays as it is: honest and rude.
  3677  (3017)  %     A short HOLD is the fallback if the wake does not arrive.
  3678  (3018)  %
  3679  (3019)  %  3. THE NAME IS NO LONGER FIXED AT RONNY, and this item is kept in corrected
  3680  (3020)  %     form because it went through a wrong shape on the way.
  3681  (3021)  %
  3682  (3022)  %     It was briefly a PROMPT at start-up, and that was a mistake: on a machine
  3683  (3023)  %     where you have already told SINTRAN who you are by logging in, being
  3684  (3024)  %     asked your name again on every run is nagging. It is now read from
  3685  (3025)  %     CHAT:CNFG in your own file area, changed with /nick, and saved only when
  3686  (3026)  %     the ROOM confirms the rename - never when the request is sent, because
  3687  (3027)  %     the room can refuse it.
  3688  (3028)  %
  3689  (3029)  %     WHAT IS STILL MISSING is the right fallback for somebody who has never
  3690  (3030)  %     renamed: it should be the SINTRAN user name and it is still RONNY.
  3691  (3031)  %     GetUserName is GUSNA 214B, and the PLANC runtime provides no MON214 -
  3692  (3032)  %     the same gap CreateFile 221B falls into, which is why creating CHAT:CNFG
  3693  (3033)  %     goes through MON70 instead. There is no command-level way round 214, so
  3694  (3034)  %     it needs the route the PLANC manual describes in as many words: an
  3695  (3035)  %     interface routine assembled in MAC and loaded BEFORE the PLANC runtime
  3696  (3036)  %     library. MAC is installed here - LIST-REENTRANT shows it - so this is
  3697  (3037)  %     work, not a wall.
  3698  (3038)  %
  3699  (3039)  %  4. The ON ROUTINEERROR form is taken from the Monitor Calls manual's own
  3700  (3040)  %     PLANC example for InByte. That ErrCode 3 specifically means "nothing was
  3701  (3041)  %     typed" is from the NoWaitSwitch entry, which says so for no-wait calls
  3702  (3042)  %     generally rather than for InByte in particular. If some other code turns
  3703  (3043)  %     up in practice, the handler above prints and carries on rather than
  3704  (3044)  %     mistaking it for a keystroke.
  3705  (3045)  % ---------------------------------------------------------------------------
  3706  (3046)  