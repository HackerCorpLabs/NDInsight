    81    (41)  CONSTANT XFCLS=11            % Close port
    82    (42)  CONSTANT XFSND=12            % Send message to a remote port
    83    (43)  CONSTANT XFRCV=13            % Receive a message on a given port
    84    (44)  CONSTANT XFPST=14            % Get local port status
    85    (45)  CONSTANT XFGST=15            % General status or wait
    86    (46)  CONSTANT XFSIN=16            % Service initialisation function
    87    (47)  %        XFSRL=17            % Service release function (obsolete)
    88    (48)  CONSTANT XFABR=18            % Absolute read block from POF area
    89    (49)  %        XFABW=19            % Absolute write block to POF area (obsolete)
    90    (50)  %        XFMLK=20            % Lock message system (obsolete)
    91    (51)  %        XFMUL=21            % Unlock message system (obsolete)
    92    (52)  CONSTANT XFM2P=22            % Magic number to port id.
    93    (53)  CONSTANT XFP2M=23            % Port to magic number
    94    (54)  %        XFRIN=24            % Routing initialise (obsolete)
    95    (55)  CONSTANT XFCRD=25            % Create driver with context
    96    (56)  CONSTANT XFSTD=26            % Start driver
    97    (57)  %        XFDIB=27            % Define indirect buffer (obsolete)
    98    (58)  %        XFRIB=28            % Read from indirect buffer (obsolete)
    99    (59)  %        XFWIB=29            % Write to indirect buffer (obsolete)
   100    (60)  CONSTANT XFPRV=30            % Request privilege
   101    (61)  CONSTANT XFRTN=31            % Write word 0 and return message
   102    (62)  CONSTANT XFRRH=32            % Receive message and read word 0
   103    (63)  CONSTANT XFDUB=33            % Define user buffer area for current message
   104    (64)  CONSTANT XFWDF=34            % Define wake-up context (drivers only!)
   105    (65)  CONSTANT XFDBK=35            % Define bank no (drivers only)
   106    (66)  CONSTANT XFSMC=36            % start multi-function call
   107    (67)  CONSTANT XFDMM=37            % define max memory for a task
   108    (68)  CONSTANT XFALM=38            % allocate messages to a task
   109    (69)  CONSTANT XFFRM=39            % free allocated messages
   110    (70)  CONSTANT XFLMP=40            % list messages and ports
   111    (71)  CONSTANT XFRRE=41            % receive and read message 
   112    (72)  CONSTANT XFCPV=42            % check system and/or user privileges
   113    (73)  CONSTANT X5FUN=43            % == END MARKER == LEAVE ME HERE PLEASE
