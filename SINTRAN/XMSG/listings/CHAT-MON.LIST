   702    (42)  
   703    (43)      % MON1 IS INBIT - read one byte from a device. The PLANC runtime carries it
   704    (44)      % as a MONn routine, but it still has to be DECLARED here or the compiler
   705    (45)      % answers ILLEGAL SYNTAX at the call site. Same declaration CHAT.PLNC uses.
   706    (46)      IMPORT ( ROUTINE VOID, BYTE (INTEGER) : MON1 )
   707    (47)  
   708    (48)      INTEGER ARRAY : stack(0:600)
   709    (49)  
   710    (50)      % ---------------------------------------------------------------
   711    (51)      % The message kinds. These MUST match DOC/protocols/chat-wire.json
   712    (52)      % and ChatMessageKind.cs - all three move in the same commit, which
   713    (53)      % is constraint 5 of the federation design.
   714    (54)      %
   715    (55)      % 32 and up are ADMIN and belong on the command port. They share the
   716    (56)      % room's numbering on purpose: a second vocabulary would mean a
   717    (57)      % second decoder bound, and that bound has already been left behind
   718    (58)      % twice, silently both times.
   719    (59)      % ---------------------------------------------------------------
   720    (60)      INTEGER : kAdmStat := 32
   721    (61)      INTEGER : kAdmRepl := 33
   722    (62)      INTEGER : kAdmStop := 34
   723    (63)  
   724    (64)      % Trunk configuration. All three are answered with kAdmRepl, the same kind
   725    (65)      % STATUS uses, so showAnswer needs no new decoding - which is why three new
   726    (66)      % verbs cost no change to the wire format. These MUST match CHATSV.PLNC and
   727    (67)      % DOC/protocols/chat-wire.json; all three move in the same commit.
   728    (68)      INTEGER : kAdmTrunk  := 35
   729    (69)      INTEGER : kAdmUntrnk := 36
   730    (70)      INTEGER : kAdmTrunks := 37
   731    (71)  
   732    (72)      % INITIALIZE <room> <n> - how many messages a room remembers. Answered with
   733    (73)      % kAdmRepl like the rest, so it too costs no wire change.
   734    (74)      INTEGER : kAdmInit   := 38
   735    (75)  
   736    (76)      % SET-NAME <name> - what this machine calls itself.
   737    (77)      INTEGER : kAdmName   := 39
   738    (78)  
   739    (79)      % LOCK-TRUNKS / UNLOCK-TRUNKS - may the server learn a machine nobody
   740    (80)      % configured? Open is the default and always has been; locking is how an
   741    (81)      % operator says these are the machines, once the lab is up.
   742    (82)      INTEGER : kAdmLock   := 40
   743    (83)      INTEGER : kAdmOpen   := 41
   744    (84)  
   745    (85)      % DROP-MEMBER <name> - free a seat on the server and tell nobody.
   746    (86)      % A TEST VERB, and the server's own declaration of kAdmDrop says why:
   747    (87)      % it is the only way to create the machine-disagreement that kTrkDBad
   748    (88)      % answers, because every ordinary way of leaving keeps both ends in step.
   749    (89)      INTEGER : kAdmDrop   := 42
   750    (90)  
   751    (91)      % LIST-MEMBER - who is seated on the server right now, and which room.
   752    (92)      % The other half of DROP-MEMBER: that acts on a seat, this shows them.
   753    (93)      INTEGER : kAdmMbrs   := 43
   754    (94)  
   755    (95)      % The server's command port, by name. XROUT turns this into an
   756    (96)      % address; nothing here knows or wants the number.
   757    (97)      BYTES : admName := 'CHAT-ADMIN'
   758    (98)      INTEGER : lenAdmName := 10
   759    (99)  
   760   (100)      % Who is asking. Carried in the nickname field so the server's log can
   761   (101)      % say who stopped it - an unattributed STOP is not worth much.
   762   (102)      BYTES : operName := 'OPER'
   763   (103)      INTEGER : lenOperName := 4
   764   (104)  
   765   (105)      INTEGER : myPort
   766   (106)      INTEGER : returnStatus
   767   (107)      % THE SYSTEM NAME IS BYTES, NOT AN INTEGER, and an EMPTY one means the LOCAL
   768   (108)      % system - which is what we want, since CHAT-ADMIN is on this machine.
   769   (109)      % Declaring it INTEGER drew
   770   (110)      %   *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
   771   (111)      % on the CALL rather than on the declaration, which sends you looking at the
   772   (112)      % arguments you changed instead of the one you copied wrong. CHAT.PLNC has
   773   (113)      % the same declaration. Measured on D100, 2026-08-20.
   774   (114)      BYTES : hereSystem := ''
   775   (115)      INTEGER : offSet
   776   (116)      INTEGER : uLength
   777   (117)      INTEGER : wLength
   778   (118)      INTEGER : length
   779   (119)      INTEGER : msgType
   780   (120)      INTEGER : remotePortHash
   781   (121)      INTEGER : nBytes
   782   (122)      INTEGER : waitFlags
   783   (123)      INTEGER : replyKind
   784   (124)      INTEGER : replyTextLen
   785   (125)      INTEGER : replyNameLen
   786   (126)      BOOLEAN : leaving
   787   (127)  
   788   (128)      % The command words. Held as BYTES so isVerb can compare byte by byte.
   789   (129)      BYTES : vExit       := 'EXIT'
   790   (130)      BYTES : vHelp       := '?'
   791   (131)      BYTES : vHelpWord   := 'HELP'
   792   (132)      BYTES : vStatus     := 'STATUS'
   793   (133)      BYTES : vStop       := 'STOP'
   794   (134)      BYTES : vStart      := 'START'
   795   (135)      BYTES : vRestart    := 'RESTART'
   796   (136)      BYTES : vStartTrunk := 'START-TRUNK'
   797   (137)      BYTES : vStopTrunk  := 'STOP-TRUNK'
   798   (138)      BYTES : vRestTrunk  := 'RESTART-TRUNK'
   799   (139)      BYTES : vListTrunks := 'LIST-TRUNKS'
   800   (140)      BYTES : vInit       := 'INITIALIZE'
   801   (141)      BYTES : vSetName    := 'SET-NAME'
   802   (142)      BYTES : vLockTrunks := 'LOCK-TRUNKS'
   803   (143)      BYTES : vUnlockTrk  := 'UNLOCK-TRUNKS'
   804   (144)      BYTES : vDropMbr    := 'DROP-MEMBER'
   805   (145)      BYTES : vListMbr    := 'LIST-MEMBER'
   806   (146)      INTEGER : i
   807   (147)  
   808   (148)      % ONE NUMBER PER COMMAND. The matcher below finds WHICH command was typed
   809   (149)      % before deciding what to do about it, so dispatch is a plain choice on a
   810   (150)      % number rather than a ladder of tests whose ORDER carries meaning. That
   811   (151)      % ordering was a standing trap: LIST-TRUNKS, RESTART-TRUNK and START-TRUNK
   812   (152)      % all had to be tested before the shorter words they begin with, and every
   813   (153)      % new verb had to be inserted in exactly the right place or it was
   814   (154)      % swallowed. With a match count the order no longer matters at all.
   815   (155)      INTEGER : cNone        := 0
   816   (156)      INTEGER : cExit        := 1
   817   (157)      INTEGER : cHelp        := 2
   818   (158)      INTEGER : cStatus      := 3
   819   (159)      INTEGER : cStop        := 4
   820   (160)      INTEGER : cStart       := 5
   821   (161)      INTEGER : cRestart     := 6
   822   (162)      INTEGER : cStartTrunk  := 7
   823   (163)      INTEGER : cStopTrunk   := 8
   824   (164)      INTEGER : cRestTrunk   := 9
   825   (165)      INTEGER : cListTrunks  := 10
   826   (166)      INTEGER : cInit        := 11
   827   (167)      INTEGER : cSetName     := 12
   828   (168)      INTEGER : cLockTrunks  := 13
   829   (169)      INTEGER : cUnlockTrk   := 14
   830   (170)      INTEGER : cDropMbr     := 15
   831   (171)      INTEGER : cListMbr     := 16
   832   (172)  
   833   (173)      % The RT program that IS the chat server. This is the PROGRAM unit's name
   834   (174)      % from CHATSV.PLNC - "PROGRAM : chatServer" - not the file name, and it is
   835   (175)      % what CHANGE-RT-DESCRIPTION and @RT CHATSER both use.
   836   (176)      BYTES : rtProgName := 'CHATSER'
   837   (177)      INTEGER : rtAddr
   838   (178)  
   839   (179)      INTEGER : cmdId          % which command matched, when exactly one did
   840   (180)      INTEGER : cmdCount       % how many matched - 0 unknown, >1 ambiguous
   841   (181)      INTEGER : cmdWordLen     % length of the typed word, up to the first space
   842   (182)      INTEGER : hyphenCh := 45 % '-', the separator inside a compound command
   843   (183)      INTEGER : spaceCh  := 32
   844   (184)      INTEGER : questCh  := 63 % '?'
   845   (185)  
   846   (186)      % Only the PROGRAM's line reader uses these. buildAdmin and showAnswer
   847   (187)      % keep their OWN cursors as locals - a shared cursor across routines is a
   848   (188)      % latent bug waiting for the day the call order changes.
   849   (189)      INTEGER : at
   850   (190)      INTEGER : ch
   851   (191)      INTEGER : maxLine := 80
   852   (192)      BOOLEAN : lineReady
   853   (193)      BYTE : rawCh
   854   (194)  
   855   (195)      % Terminal reading. Same values and same reasons as the client's reader.
   856   (196)      INTEGER : ownTerminal := 1        % device number of your own terminal
   857   (197)      INTEGER : parityMask  := 127      % strip the even-parity bit, see below
   858   (198)      INTEGER : carriageRet := 13
   859   (199)      INTEGER : emptyInput  := 3        % InByte in no-wait: nothing was typed
   860   (200)  
   861   (201)      BYTES : letterBuf(0:63)
   862   (202)      BYTES : outBuf(0:255)
   863   (203)      BYTES : inBuf(0:511)
   864   (204)      BYTES : lineBuf(0:79)
   865   (205)      % AN INITIALISER IS WHAT GIVES A BYTES ITS LENGTH. Declared bare, the
   866   (206)      % compiler answers "ARRAY BOUNDS MISSING" and then, further down, warns the
   867   (207)      % name was never declared - two diagnostics from one omission. CHATSV's
   868   (208)      % spaceByte is the same idiom.
   869   (209)      BYTES : oneByte := ' '
   870   (210)  
   871   (211)      % THE LINE BREAK INSIDE A REPLY. The server separates the elements of a
   872   (212)      % listing with LF because the whole answer travels as ONE kAdmRepl message;
   873   (213)      % showAnswer turns each one into a CRLF. Must match lineBreak in
   874   (214)      % CHATSV.PLNC - the two move together.
   875   (215)      INTEGER : lineBreak := 10
   876   (216)  
   877   (217)      % -----------------------------------------------------------------------
   878   (218)      % Print a status number beside the call that produced it. A bare number
   879   (219)      % with no name attached is what makes an XMSG failure take an hour.
   880   (220)      % -----------------------------------------------------------------------
   881   (221)      ROUTINE VOID, VOID (BYTES, INTEGER) : showStatus(what, status)
   882   (222)          OUTPUT(1, 'AL', what)
   883   (223)          OUTPUT(1, 'AL6', ' st = ')
   884   (224)          OUTPUT(1, 'I6', status)
   885   (225)          OUTPUT(1, 'AL1', '$')
   886   (226)      ENDROUTINE
   887   (227)  
   888   (228)      % -----------------------------------------------------------------------
   889   (229)      % Build one admin message into outBuf.
   890   (230)      %
   891   (231)      % The format is the room's own, unchanged: kind, then a one-byte name
   892   (232)      % length and that many bytes of name, then a TWO-byte big-endian text
   893   (233)      % length and that many bytes of text. Admin messages cost no wire change
   894   (234)      % precisely because they need no new fields - a request carries empty
   895   (235)      % text, and the answer puts readable text where a Said would put what
   896   (236)      % somebody said.
   897   (237)      % -----------------------------------------------------------------------
   898   (238)      ROUTINE VOID, INTEGER (INTEGER) : buildAdmin(kind)
   899   (239)          INTEGER : n
   900   (240)          INTEGER : p
   901   (241)          kind =: outBuf(0)
   902   (242)          lenOperName =: outBuf(1)
   903   (243)          FOR n IN 0:lenOperName - 1 DO
   904   (244)              operName(n) =: outBuf(2 + n)
   905   (245)          ENDFOR
   906   (246)          2 + lenOperName =: p
   907   (247)          % Text length, high byte then low. Always zero on a request.
   908   (248)          0 =: outBuf(p)
   909   (249)          0 =: outBuf(p + 1)
   910   (250)          p + 2 RETURN
   911   (251)      ENDROUTINE
   912   (252)  
   913   (253)      % -----------------------------------------------------------------------
   914   (254)      % Send one admin message to CHAT-ADMIN, addressed BY NAME through XROUT.
   915   (255)      %
   916   (256)      % By name rather than by address because nothing here knows the server's
   917   (257)      % port number, and the whole point of a registered name is that it does
   918   (258)      % not have to. This is the same letter mechanism the client uses to join,
   919   (259)      % against a NORMAL named port rather than a connection port - which is
   920   (260)      % what keeps it from spending a seat.
   921   (261)      % -----------------------------------------------------------------------
   922   (262)      ROUTINE VOID, VOID (INTEGER) : sendAdmin(kind)
   923   (263)          XMMSGIDENTIFIER : msgIdent
   924   (264)  
   925   (265)          % XMPBLET takes the port name as BYTES and appends it as parameter 1
   926   (266)          % of the letter. A PLANC BYTES argument carries its own length, so
   927   (267)          % handing over the whole declared array would ask XROUT for a name
   928   (268)          % with the leftovers on the end. The subarray is exactly the name.
   929   (269)          % NO SUBARRAY HERE, and that is the difference from the client's join.
   930   (270)          %
   931   (271)          % CHAT.PLNC declares roomName with explicit bounds (0:20) and fills it at
   932   (272)          % runtime, so it MUST hand XMPBLET a subarray or the letter would carry
   933   (273)          % eleven bytes of leftovers. admName is declared with an INITIALISER, so
   934   (274)          % its implicit length is already exactly 'CHAT-ADMIN' and the whole array
   935   (275)          % is the name. Writing admName(0:lenAdmName - 1) anyway drew
   936   (276)          %   830 (170)/SENDADMIN *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
   937   (277)          % - a variable subarray of a literal-initialised BYTES is not something
   938   (278)          % this compiler will take. Measured on D100, 2026-08-20.
   939   (279)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, admName) =: returnStatus
   940   (280)          IF returnStatus >< XMOK THEN
   941   (281)              % THIS IS THE NAME LOOKUP, and it is the failure an operator will
   942   (282)              % meet most often by a long way: CHAT-ADMIN is not registered
   943   (283)              % because nothing is running to register it. The status number
   944   (284)              % stays - it is what a second pair of eyes needs - but a number on
   945   (285)              % its own is not an answer to somebody who just wants the server
   946   (286)              % up, so say the likely cause and the command that fixes it.
   947   (287)              showStatus('xmpblet', returnStatus)
   948   (288)              OUTPUT(1, 'AL44', 'the chat server does not answer - try START$')
   949   (289)              RETURN
   950   (290)          ENDIF
   951   (291)  
   952   (292)          xmpfget(0, 200, msgIdent) =: returnStatus
   953   (293)          IF returnStatus >< XMOK THEN
   954   (294)              showStatus('xmpfget', returnStatus)
   955   (295)              RETURN
   956   (296)          ENDIF
   957   (297)  
   958   (298)          % The letter header first...
   959   (299)          offSet =: uLength
   960   (300)          xmpfwri(0, 0, &
   961   (301)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
   962   (302)              0, uLength, wLength) =: returnStatus
   963   (303)  
   964   (304)          % ...then our own message after it. XROUT reads only the header and
   965   (305)          % forwards the rest untouched, so this is where the command rides.
   966   (306)          buildAdmin(kind) =: length
   967   (307)          xmpfwri(0, wLength, &
   968   (308)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
   969   (309)              0, length, offSet) =: returnStatus
   970   (310)  
   971   (311)          xmprout(0, msgIdent, myPort) =: returnStatus
   972   (312)          IF returnStatus >< XMOK THEN
   973   (313)              showStatus('xmprout', returnStatus)
   974   (314)          ENDIF
   975   (315)      ENDROUTINE
   976   (316)  
   977   (317)      % -----------------------------------------------------------------------
   978   (318)      % The same message, but carrying WHAT THE OPERATOR TYPED AFTER THE VERB.
   979   (319)      %
   980   (320)      % START-TRUNK and STOP-TRUNK need a system number, and the argument is
   981   (321)      % simply the rest of the typed line: everything after the verb and the one
   982   (322)      % space behind it. It is sent as TEXT and the server parses it - this end
   983   (323)      % does not need to know that a trunk is named by a number, only that the
   984   (324)      % verb takes an argument.
   985   (325)      %
   986   (326)      % A MISSING ARGUMENT IS SENT AS AN EMPTY TEXT rather than refused here. The
   987   (327)      % server already has to handle a peer sending nonsense, so it owns the
   988   (328)      % complaint, and there is then ONE place that decides what a valid trunk
   989   (329)      % argument is instead of two that can disagree.
   990   (330)      % -----------------------------------------------------------------------
   991   (331)      ROUTINE VOID, INTEGER (INTEGER) : bldArgMsg(kind)
   992   (332)          INTEGER : n, p, argAt, argLen
   993   (333)  
   994   (334)          kind =: outBuf(0)
   995   (335)          lenOperName =: outBuf(1)
   996   (336)          FOR n IN 0:lenOperName - 1 DO
   997   (337)              operName(n) =: outBuf(2 + n)
   998   (338)          ENDFOR
   999   (339)          2 + lenOperName =: p
  1000   (340)  
  1001   (341)          % cmdWordLen is the verb; one space follows it; the rest is the
  1002   (342)          % argument. "at" is how much was typed altogether.
  1003   (343)          cmdWordLen + 1 =: argAt
  1004   (344)          at - argAt =: argLen
  1005   (345)          IF argLen < 0 THEN
  1006   (346)              0 =: argLen
  1007   (347)          ENDIF
  1008   (348)  
  1009   (349)          0 =: outBuf(p)                        % text length, high byte
  1010   (350)          argLen =: outBuf(p + 1)               % low byte - a typed line is short
  1011   (351)          p + 2 =: p
  1012   (352)          FOR n IN 1:argLen DO
  1013   (353)              lineBuf(argAt + n - 1) =: outBuf(p)
  1014   (354)              p + 1 =: p
  1015   (355)          ENDFOR
  1016   (356)          p RETURN
  1017   (357)      ENDROUTINE
  1018   (358)  
  1019   (359)      % -----------------------------------------------------------------------
  1020   (360)      % Send an admin message that carries the typed argument.
  1021   (361)      %
  1022   (362)      % Identical to sendAdmin except for which builder it calls. Kept as its own
  1023   (363)      % routine rather than adding a flag to sendAdmin, because the two differ in
  1024   (364)      % exactly one line and a flag would put a branch in the middle of the letter
  1025   (365)      % sequence that is worth keeping straight.
  1026   (366)      % -----------------------------------------------------------------------
  1027   (367)      ROUTINE VOID, VOID (INTEGER) : sndArgMsg(kind)
  1028   (368)          XMMSGIDENTIFIER : msgIdent
  1029   (369)  
  1030   (370)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, admName) =: returnStatus
  1031   (371)          IF returnStatus >< XMOK THEN
  1032   (372)              showStatus('xmpblet', returnStatus)
  1033   (373)              OUTPUT(1, 'AL44', 'the chat server does not answer - try START$')
  1034   (374)              RETURN
  1035   (375)          ENDIF
  1036   (376)  
  1037   (377)          xmpfget(0, 200, msgIdent) =: returnStatus
  1038   (378)          IF returnStatus >< XMOK THEN
  1039   (379)              showStatus('xmpfget', returnStatus)
  1040   (380)              RETURN
  1041   (381)          ENDIF
  1042   (382)  
  1043   (383)          offSet =: uLength
  1044   (384)          xmpfwri(0, 0, &
  1045   (385)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
  1046   (386)              0, uLength, wLength) =: returnStatus
  1047   (387)  
  1048   (388)          bldArgMsg(kind) =: length
  1049   (389)          xmpfwri(0, wLength, &
  1050   (390)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  1051   (391)              0, length, offSet) =: returnStatus
  1052   (392)  
  1053   (393)          xmprout(0, msgIdent, myPort) =: returnStatus
  1054   (394)          IF returnStatus >< XMOK THEN
  1055   (395)              showStatus('xmprout', returnStatus)
  1056   (396)          ENDIF
  1057   (397)      ENDROUTINE
  1058   (398)  
  1059   (399)      % -----------------------------------------------------------------------
  1060   (400)      % Wait for the server's answer and print it.
  1061   (401)      %
  1062   (402)      % BLOCKING on purpose - XFWTF. This program has nothing else to do and a
  1063   (403)      % poll would burn the machine for nothing. It is also the one place where
  1064   (404)      % blocking is safe: unlike the server, CHATMON holds exactly one port.
  1065   (405)      % -----------------------------------------------------------------------
  1066   (406)      ROUTINE VOID, VOID : showAnswer
  1067   (407)          XMMSGIDENTIFIER : msgIdent
  1068   (408)          INTEGER : p
  1069   (409)  
  1070   (410)          xmpfrcv(waitFlags, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  1071   (411)              =: returnStatus
  1072   (412)  
  1073   (413)          % A RECEIVE IS A MESSAGE ONLY WHEN THE STATUS IS A MESSAGE TYPE.
  1074   (414)          % Not "= XMOK" and not "> 0": zero is OK for other calls but is not a
  1075   (415)          % message type, and every error is positive too, so "> 0" would accept
  1076   (416)          % an empty port. XMTNO=1 through XMTPS=6 are the message types.
  1077   (417)          % XMOK IS A SUCCESSFUL RECEIVE, AND THIS TEST MUST ACCEPT ZERO.
  1078   (418)          %
  1079   (419)          % MEASURED on D100 2026-08-20: this printed "xmpfrcv st = 0" and threw
  1080   (420)          % the message away. Zero is XMOK, the type lives in the msgType
  1081   (421)          % out-parameter, and the vendor's Appendix G sample tests
  1082   (422)          % "IF RETURNSTATUS >< XMOK THEN bad status" before looking at the type.
  1083   (423)          %
  1084   (424)          % This is the SAME defect CHAT.PLNC's header records at length - it ate
  1085   (425)          % the welcome there and cost a day. Writing "1..6 only" a second time,
  1086   (426)          % in a new program, with the warning already written down, is exactly
  1087   (427)          % the trap that comment exists to prevent.
  1088   (428)          %
  1089   (429)          % An EMPTY port answers XMXENTM (16896), which is neither XMOK nor 1..6
  1090   (430)          % and is still correctly rejected here.
  1091   (431)          IF returnStatus >< XMOK AND &
  1092   (432)             (returnStatus < XMTNO OR returnStatus > XMTPS) THEN
  1093   (433)              showStatus('xmpfrcv', returnStatus)
  1094   (434)              RETURN
  1095   (435)          ENDIF
  1096   (436)  
  1097   (437)          xmpfrea(0, 0, &
  1098   (438)              ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  1099   (439)              0, nBytes, length) =: returnStatus
  1100   (440)          IF returnStatus >< XMOK THEN
  1101   (441)              showStatus('xmpfrea', returnStatus)
  1102   (442)              RETURN
  1103   (443)          ENDIF
  1104   (444)  
  1105   (445)          inBuf(0) =: replyKind
  1106   (446)          IF replyKind >< kAdmRepl THEN
  1107   (447)              OUTPUT(1, 'AL17', 'unexpected kind $')
  1108   (448)              RETURN
  1109   (449)          ENDIF
  1110   (450)  
  1111   (451)          % Walk it. The name is variable-length, so the text length cannot be
  1112   (452)          % read from a fixed offset - this format must be WALKED, not indexed.
  1113   (453)          inBuf(1) =: replyNameLen
  1114   (454)          2 + replyNameLen =: p
  1115   (455)          inBuf(p) * 256 + inBuf(p + 1) =: replyTextLen
  1116   (456)          p + 2 =: p
  1117   (457)  
  1118   (458)          % NO "CHAT-MON:" IN FRONT OF THE ANSWER. The prompt already says C-M:,
  1119   (459)          % so every reply repeating the program's own name was noise stacked on
  1120   (460)          % top of the one line the operator actually asked for.
  1121   (461)          FOR i IN 0:replyTextLen - 1 DO
  1122   (462)              % AN LF IN THE TEXT IS A LINE BREAK, not a character to print.
  1123   (463)              %
  1124   (464)              % A listing - LIST-TRUNKS and anything else the server answers with
  1125   (465)              % kAdmRepl - arrives as ONE message with its elements separated by
  1126   (466)              % LF, because there is no second kind and no room in the format for
  1127   (467)              % one. Turning it into a CRLF here is what puts one element per
  1128   (468)              % line, and it does so for EVERY listing at once rather than only
  1129   (469)              % the one that was reported.
  1130   (470)              %
  1131   (471)              % Printing the byte instead would send a bare LF to the terminal,
  1132   (472)              % which drops a line without returning the carriage and leaves the
  1133   (473)              % next line marching to the right.
  1134   (474)              IF inBuf(p + i) = lineBreak THEN
  1135   (475)                  OUTPUT(1, 'AL1', '$')
  1136   (476)              ELSE
  1137   (477)                  % One byte at a time through a one-element BYTES. A string
  1138   (478)                  % literal cannot be stored into a BYTES element, and 'ALn'
  1139   (479)                  % formats a STRING - handing it a byte prints the byte's NUMBER.
  1140   (480)                  inBuf(p + i) =: oneByte
  1141   (481)                  OUTPUT(1, 'AL1', oneByte)
  1142   (482)              ENDIF
  1143   (483)          ENDFOR
  1144   (484)          OUTPUT(1, 'AL1', '$')
  1145   (485)      ENDROUTINE
  1146   (486)  
  1147   (487)      % -----------------------------------------------------------------------
  1148   (488)      % Read one command line from the terminal into lineBuf, length in at.
  1149   (489)      %
  1150   (490)      % PARITY. Terminal input carries an even-parity bit in bit 7, so carriage
  1151   (491)      % return arrives as 141, NOT 13. Compare without masking and this never
  1152   (492)      % sees the user press return and looks HUNG rather than wrong.
  1153   (493)      %
  1154   (494)      % MON1 CAN RAISE A ROUTINEERROR and it must be caught - an unhandled one
  1155   (495)      % takes the program down instead of ending the line.
  1156   (496)      % -----------------------------------------------------------------------
  1157   (497)      ROUTINE VOID, VOID : readLine
  1158   (498)          0 =: at
  1159   (499)          FALSE =: lineReady
  1160   (500)          DO
  1161   (501)              0 =: ch
  1162   (502)              ON ROUTINEERROR DO
  1163   (503)                  IF ErrCode >< emptyInput THEN
  1164   (504)                      OUTPUT(1, 'AL12', 'read failed$')
  1165   (505)                  ENDIF
  1166   (506)                  0 =: rawCh
  1167   (507)              ENDON
  1168   (508)              MON1(ownTerminal) =: rawCh
  1169   (509)              rawCh =: ch
  1170   (510)              ch AND parityMask =: ch
  1171   (511)  
  1172   (512)              IF ch = carriageRet THEN
  1173   (513)                  TRUE =: lineReady
  1174   (514)  
  1175   (515)                  % A CARRIAGE RETURN IS NOT A NEW LINE ON THIS TERMINAL. It puts
  1176   (516)                  % the cursor back at column ONE of the line just typed, and
  1177   (517)                  % nothing moves it down. So every answer this program printed
  1178   (518)                  % landed ON TOP of the command that asked for it - "CHAT-MON:
  1179   (519)                  % stop sent" written straight over "STOP" - and the screen read
  1180   (520)                  % like the program had mangled the input. It had not; it simply
  1181   (521)                  % never ended the line. One end-of-line here, the moment the
  1182   (522)                  % user presses return, and the answer starts on a line of its
  1183   (523)                  % own.
  1184   (524)                  OUTPUT(1, 'AL1', '$')
  1185   (525)              ENDIF
  1186   (526)  
  1187   (527)              % Leave the moment the keyboard runs dry or the line is finished.
  1188   (528)              % Going round again on an empty buffer is a spin, not a poll.
  1189   (529)              WHILE ch >< 0 AND NOT lineReady
  1190   (530)  
  1191   (531)              IF ch > 31 THEN
  1192   (532)                  % PLANC checks no array bound, so this test is the only thing
  1193   (533)                  % between a held-down key and the variables laid out after it.
  1194   (534)                  IF at < maxLine THEN
  1195   (535)                      ch =: lineBuf(at)
  1196   (536)                      at + 1 =: at
  1197   (537)                  ENDIF
  1198   (538)              ENDIF
  1199   (539)          ENDDO
  1200   (540)      ENDROUTINE
  1201   (541)  
  1202   (542)      % -----------------------------------------------------------------------
  1203   (543)      % Print the command list. Reached by ? the way X-C does it.
  1204   (544)      % -----------------------------------------------------------------------
  1205   (545)      ROUTINE VOID, VOID : showHelp
  1206   (546)          OUTPUT(1, 'AL19', 'CHAT-MON commands:$')
  1207   (547)          OUTPUT(1, 'AL38', '  STATUS                how it stands$')
  1208   (548)          OUTPUT(1, 'AL40', '  STOP                  stop the server$')
  1209   (549)          OUTPUT(1, 'AL29', '  ? or HELP             this$')
  1210   (550)          OUTPUT(1, 'AL30', '  EXIT                  leave$')
  1211   (551)          OUTPUT(1, 'AL40', '  START                 use @RT CHATSER$')
  1212   (552)          OUTPUT(1, 'AL38', '  RESTART               stops it only$')
  1213   (553)          OUTPUT(1, 'AL40', '  START-TRUNK <sys>     trunk to a peer$')
  1214   (554)          OUTPUT(1, 'AL41', '  STOP-TRUNK <sys>      forget that peer$')
  1215   (555)          OUTPUT(1, 'AL43', '  RESTART-TRUNK <sys>   stop then start it$')
  1216   (556)          OUTPUT(1, 'AL41', '  LIST-TRUNKS           peers and states$')
  1217   (557)          OUTPUT(1, 'AL49', '  INITIALIZE <room> <n> how much that room keeps$')
  1218   (558)          OUTPUT(1, 'AL', '  SET-NAME <name>      what this machine is called$')
  1219   (559)          % NO WIDTH ON THESE. 'ALn' is a FIELD, not a maximum: a count one short
  1220   (560)          % truncates the line and one too long pads it with asterisks, and both
  1221   (561)          % build clean. The bare descriptor sizes itself.
  1222   (562)          OUTPUT(1, 'AL', '  LOCK-TRUNKS          learn no NEW machines$')
  1223   (563)          OUTPUT(1, 'AL', '  DROP-MEMBER <name>   free a seat, tell NOBODY (test)$')
  1224   (564)          OUTPUT(1, 'AL', '  LIST-MEMBER          who is seated, and which room$')
  1225   (565)          OUTPUT(1, 'AL', '  UNLOCK-TRUNKS        learn any machine again$')
  1226   (566)          OUTPUT(1, 'AL1',  '$')
  1227   (567)          OUTPUT(1, 'AL', 'Shorten each part: LI-T is LIST-TRUNKS, LO-T is LOCK-TRUNKS.$')
  1228   (568)          OUTPUT(1, 'AL37', 'Upper or lower case, either is fine.$')
  1229   (569)          OUTPUT(1, 'AL53', 'A trunk is a BELIEF a peer is reachable, not a link.$')
  1230   (570)      ENDROUTINE
  1231   (571)  
  1232   (572)      % -----------------------------------------------------------------------
  1233   (573)      % Say plainly that a command is known but not built yet.
  1234   (574)      %
  1235   (575)      % A SHELL THAT SILENTLY DOES NOTHING IS WORSE THAN ONE THAT REFUSES. The
  1236   (576)      % trunk verbs are declared so the command set is visible and a mode file
  1237   (577)      % can be written against it, but their wire kinds and the server half
  1238   (578)      % arrive with phase B. "Not built yet" is the honest answer; a cheerful
  1239   (579)      % "Ok" that changed nothing would be a lie an operator would act on.
  1240   (580)      % -----------------------------------------------------------------------
  1241   (581)      ROUTINE VOID, VOID : notYet
  1242   (582)          OUTPUT(1, 'AL21', 'known, not built yet$')
  1243   (583)      ENDROUTINE
  1244   (584)  
  1245   (585)      % -----------------------------------------------------------------------
  1246   (586)      % Fold one character to upper case.
  1247   (587)      %
  1248   (588)      % TYPING IN LOWER CASE IS NOT A MISTAKE AND MUST NOT BE TREATED AS ONE.
  1249   (589)      % The old matcher compared raw bytes against upper-case keywords, so
  1250   (590)      % "status" was answered "no such command" while "STATUS" worked. Nothing
  1251   (591)      % about this program needs the shift key held down.
  1252   (592)      % -----------------------------------------------------------------------
  1253   (593)      ROUTINE VOID, INTEGER (INTEGER) : upper(c)
  1254   (594)          IF c >= 97 AND c <= 122 THEN
  1255   (595)              c - 32 RETURN
  1256   (596)          ENDIF
  1257   (597)          c RETURN
  1258   (598)      ENDROUTINE
  1259   (599)  
  1260   (600)      % -----------------------------------------------------------------------
  1261   (601)      % How long is the typed command word? It ends at the first space, so an
  1262   (602)      % argument after it does not spoil the match.
  1263   (603)      % -----------------------------------------------------------------------
  1264   (604)      ROUTINE VOID, INTEGER : verbLength
  1265   (605)          INTEGER : n
  1266   (606)          0 =: n
  1267   (607)          DO
  1268   (608)              WHILE n < at AND lineBuf(n) >< spaceCh
  1269   (609)              n + 1 =: n
  1270   (610)          ENDDO
  1271   (611)          n RETURN
  1272   (612)      ENDROUTINE
  1273   (613)  
  1274   (614)      % -----------------------------------------------------------------------
  1275   (615)      % SINTRAN'S OWN ABBREVIATION RULE, and nothing more clever than it.
  1276   (616)      %
  1277   (617)      % A command is a run of parts separated by '-'. What you type must give
  1278   (618)      % EVERY part, and each typed part must be a PREFIX of the matching keyword
  1279   (619)      % part. So LIST-TRUNKS answers to L-T, LI-TRU, LIST-T and LIST-TRUNKS, and
  1280   (620)      % that is exactly how every SINTRAN command has always behaved.
  1281   (621)      %
  1282   (622)      % A BARE "L" DOES NOT MATCH IT. The parts are not optional - dropping one
  1283   (623)      % is a different command, not a shorter spelling of this one. That is what
  1284   (624)      % keeps L-T from colliding with a future LIST verb.
  1285   (625)      %
  1286   (626)      % This routine only answers yes or no about ONE keyword. Deciding what the
  1287   (627)      % typed word MEANS needs the count across all of them, because a prefix
  1288   (628)      % that fits two commands is ambiguous and must be refused rather than
  1289   (629)      % guessed - see matchAll.
  1290   (630)      % -----------------------------------------------------------------------
  1291   (631)      ROUTINE VOID, BOOLEAN (BYTES, INTEGER) : abbrevMatch(word, wordLen)
  1292   (632)          INTEGER : ti          % cursor in what was typed
  1293   (633)          INTEGER : ki          % cursor in the keyword
  1294   (634)          INTEGER : partLen     % characters given for the part in hand
  1295   (635)          BOOLEAN : bad
  1296   (636)          BOOLEAN : done
  1297   (637)  
  1298   (638)          0 =: ti
  1299   (639)          0 =: ki
  1300   (640)          FALSE =: bad
  1301   (641)          FALSE =: done
  1302   (642)  
  1303   (643)          DO
  1304   (644)              WHILE NOT bad AND NOT done
  1305   (645)  
  1306   (646)              % ---- the typed part must run down the keyword part ------------
  1307   (647)              0 =: partLen
  1308   (648)              DO
  1309   (649)                  WHILE NOT bad AND ti < cmdWordLen AND lineBuf(ti) >< hyphenCh
  1310   (650)                  IF ki >= wordLen THEN
  1311   (651)                      TRUE =: bad                 % typed past the end of it
  1312   (652)                  ELSE
  1313   (653)                      IF word(ki) = hyphenCh THEN
  1314   (654)                          TRUE =: bad             % this keyword part is shorter
  1315   (655)                      ELSE
  1316   (656)                          IF upper(lineBuf(ti)) >< word(ki) THEN
  1317   (657)                              TRUE =: bad
  1318   (658)                          ELSE
  1319   (659)                              ti + 1 =: ti
  1320   (660)                              ki + 1 =: ki
  1321   (661)                              partLen + 1 =: partLen
  1322   (662)                          ENDIF
  1323   (663)                      ENDIF
  1324   (664)                  ENDIF
  1325   (665)              ENDDO
  1326   (666)  
  1327   (667)              % An empty part - "-T", or "L--T" - is not an abbreviation.
  1328   (668)              IF NOT bad AND partLen = 0 THEN
  1329   (669)                  TRUE =: bad
  1330   (670)              ENDIF
  1331   (671)  
  1332   (672)              IF NOT bad THEN
  1333   (673)                  % Run the keyword on to the end of ITS part.
  1334   (674)                  DO
  1335   (675)                      WHILE ki < wordLen AND word(ki) >< hyphenCh
  1336   (676)                      ki + 1 =: ki
  1337   (677)                  ENDDO
  1338   (678)  
  1339   (679)                  IF ti >= cmdWordLen THEN
  1340   (680)                      % Nothing more was typed, so the keyword must be finished
  1341   (681)                      % too. If it is not, a part was left out.
  1342   (682)                      IF ki < wordLen THEN
  1343   (683)                          TRUE =: bad
  1344   (684)                      ENDIF
  1345   (685)                      TRUE =: done
  1346   (686)                  ELSE
  1347   (687)                      % More was typed: both sides are sitting on a '-'.
  1348   (688)                      IF ki >= wordLen THEN
  1349   (689)                          TRUE =: bad
  1350   (690)                      ELSE
  1351   (691)                          ti + 1 =: ti
  1352   (692)                          ki + 1 =: ki
  1353   (693)                      ENDIF
  1354   (694)                  ENDIF
  1355   (695)              ENDIF
  1356   (696)          ENDDO
  1357   (697)  
  1358   (698)          IF bad THEN
  1359   (699)              FALSE RETURN
  1360   (700)          ENDIF
  1361   (701)          TRUE RETURN
  1362   (702)      ENDROUTINE
  1363   (703)  
  1364   (704)      % -----------------------------------------------------------------------
  1365   (705)      % Count one keyword against what was typed, remembering the last hit.
  1366   (706)      % -----------------------------------------------------------------------
  1367   (707)      % THE LENGTH IS NOT A PARAMETER - THE KEYWORD IS ASKED FOR IT.
  1368   (708)      %
  1369   (709)      % Every caller passes one of the vXxx keywords declared above, and each one
  1370   (710)      % used to hand the count in beside it: fifteen hand-typed numbers that
  1371   (711)      % nothing could check. Rename a command and the number beside it is silently
  1372   (712)      % wrong, the build is clean, and the abbreviation matcher then compares the
  1373   (713)      % wrong number of characters - so a command matches when it should not, or
  1374   (714)      % stops matching at all.
  1375   (715)      %
  1376   (716)      % MAXINDEX(word, 1) is the DECLARED UPPER BOUND of the parameter and a
  1377   (717)      % string subscripts from ZERO, so the length is that plus one. A STANDARD
  1378   (718)      % routine the compiler provides - no IMPORT - and it works on an array
  1379   (719)      % parameter, which is what this is.
  1380   (720)      ROUTINE VOID, VOID (BYTES, INTEGER) : tryCmd(word, id)
  1381   (721)          INTEGER : wordLen
  1382   (722)          MAXINDEX(word, 1) + 1 =: wordLen
  1383   (723)          IF abbrevMatch(word, wordLen) THEN
  1384   (724)              cmdCount + 1 =: cmdCount
  1385   (725)              id =: cmdId
  1386   (726)          ENDIF
  1387   (727)      ENDROUTINE
  1388   (728)  
  1389   (729)      % -----------------------------------------------------------------------
  1390   (730)      % Print one keyword if it matched - used to say WHICH commands an
  1391   (731)      % ambiguous abbreviation could have meant. Being told "ambiguous" without
  1392   (732)      % being told between what is a riddle, not an error message.
  1393   (733)      % -----------------------------------------------------------------------
  1394   (734)      % The length is derived here for the same reason as in tryCmd above - the
  1395   (735)      % keyword knows how long it is, and a hand-typed number beside it is one
  1396   (736)      % more thing that can quietly disagree with the string.
  1397   (737)      ROUTINE VOID, VOID (BYTES) : showIfMatch(word)
  1398   (738)          INTEGER : wordLen
  1399   (739)          MAXINDEX(word, 1) + 1 =: wordLen
  1400   (740)          IF abbrevMatch(word, wordLen) THEN
  1401   (741)              OUTPUT(1, 'AL2', '  ')
  1402   (742)              OUTPUT(1, 'AL', word)
  1403   (743)              OUTPUT(1, 'AL1', '$')
  1404   (744)          ENDIF
  1405   (745)      ENDROUTINE
  1406   (746)  
  1407   (747)      % -----------------------------------------------------------------------
  1408   (748)      % Try every keyword. Afterwards cmdCount says what happened: 0 means no
  1409   (749)      % such command, 1 means cmdId is it, more than 1 means ambiguous.
  1410   (750)      %
  1411   (751)      % ORDER IS DELIBERATELY IRRELEVANT HERE. Every keyword is tried, always.
  1412   (752)      % -----------------------------------------------------------------------
  1413   (753)      ROUTINE VOID, VOID : matchAll
  1414   (754)          0 =: cmdCount
  1415   (755)          cNone =: cmdId
  1416   (756)          tryCmd(vExit, cExit)
  1417   (757)          tryCmd(vHelpWord, cHelp)
  1418   (758)          tryCmd(vStatus, cStatus)
  1419   (759)          tryCmd(vStop, cStop)
  1420   (760)          tryCmd(vStart, cStart)
  1421   (761)          tryCmd(vRestart, cRestart)
  1422   (762)          tryCmd(vStartTrunk, cStartTrunk)
  1423   (763)          tryCmd(vStopTrunk, cStopTrunk)
  1424   (764)          tryCmd(vRestTrunk, cRestTrunk)
  1425   (765)          tryCmd(vListTrunks, cListTrunks)
  1426   (766)          tryCmd(vInit, cInit)
  1427   (767)          tryCmd(vSetName, cSetName)
  1428   (768)          tryCmd(vLockTrunks, cLockTrunks)
  1429   (769)          tryCmd(vUnlockTrk, cUnlockTrk)
  1430   (770)          tryCmd(vDropMbr, cDropMbr)
  1431   (771)          tryCmd(vListMbr, cListMbr)
  1432   (772)      ENDROUTINE
  1433   (773)  
  1434   (774)      % -----------------------------------------------------------------------
  1435   (775)      % List what an ambiguous abbreviation could have meant.
  1436   (776)      % -----------------------------------------------------------------------
  1437   (777)      ROUTINE VOID, VOID : showAmbiguous
  1438   (778)          OUTPUT(1, 'AL22', 'ambiguous - could be:$')
  1439   (779)          showIfMatch(vExit)
  1440   (780)          showIfMatch(vHelpWord)
  1441   (781)          showIfMatch(vStatus)
  1442   (782)          showIfMatch(vStop)
  1443   (783)          showIfMatch(vStart)
  1444   (784)          showIfMatch(vRestart)
  1445   (785)          showIfMatch(vStartTrunk)
  1446   (786)          showIfMatch(vStopTrunk)
  1447   (787)          showIfMatch(vRestTrunk)
  1448   (788)          showIfMatch(vListTrunks)
  1449   (789)          showIfMatch(vInit)
  1450   (790)          showIfMatch(vSetName)
  1451   (791)          % THESE THREE WERE MISSING. tryCmd knows them, so an abbreviation CAN be
  1452   (792)          % ambiguous between them, and this list is what the person is shown when
  1453   (793)          % it is - leaving them out turns a helpful message into a wrong one.
  1454   (794)          showIfMatch(vLockTrunks)
  1455   (795)          showIfMatch(vUnlockTrk)
  1456   (796)          showIfMatch(vDropMbr)
  1457   (797)          showIfMatch(vListMbr)
  1458   (798)      ENDROUTINE
  1459   (799)  
  1460   (800)      % -----------------------------------------------------------------------
  1461   (801)      % One command.
  1462   (802)      %
  1463   (803)      % ORDER MATTERS WHERE ONE KEYWORD IS A PREFIX OF ANOTHER. LIST-TRUNKS,
  1464   (804)      % UNTRUNK and RETRUNK are all tested before TRUNK, or the shorter word would
  1465   (805)      % swallow the longer ones.
  1466   (806)      % -----------------------------------------------------------------------
  1467   (807)      % -----------------------------------------------------------------------
  1468   (808)      % START THE SERVER. This is NOT a message, and that is why it was missing.
  1469   (809)      %
  1470   (810)      % STOP is a message to a RUNNING server. START cannot be - there is nothing
  1471   (811)      % running to receive it - so it has to be an RT start from THIS side, the
  1472   (812)      % same thing @RT CHATSER does.
  1473   (813)      %
  1474   (814)      % TWO CALLS, NOT ONE. StartRTProgram (RT 100B) takes the ADDRESS of an RT
  1475   (815)      % description, not a name: "Address of RT description. Use 0 for your own".
  1476   (816)      % GetRTAddress (GRTDA 151B) is what turns CHATSER into that address -
  1477   (817)      % name in, address out. Reaching for StartRTProgram alone and passing it a
  1478   (818)      % name would compile, and start whatever RT description happened to live at
  1479   (819)      % the address those bytes make.
  1480   (820)      %
  1481   (821)      % BOTH ARE REACHED BY NAME through MON-CALL-1B-A00, which CHATMN:MODE now
  1482   (822)      % loads. It did not before, because MON1 was this program's only monitor
  1483   (823)      % call and MON1 is one of the runtime's own MONn routines.
  1484   (824)      %
  1485   (825)      % WHAT THIS CANNOT FIX, and an operator needs to know it: an RT program that
  1486   (826)      % uses XMSG must be RT-LOADED AGAIN after every XMSG restart. Starting one
  1487   (827)      % that was linked BEFORE the restart puts it straight into PASSIVE with zero
  1488   (828)      % CPU and not a line in its log. If START says it started and STATUS still
  1489   (829)      % says nothing is there, that is what happened - use tools\rt-load.ps1.
  1490   (830)      % -----------------------------------------------------------------------
  1491   (831)      ROUTINE VOID, BOOLEAN : startServer
  1492   (832)          BOOLEAN : failed
  1493   (833)  
  1494   (834)          0 =: rtAddr
  1495   (835)  
  1496   (836)          ON ROUTINEERROR DO
  1497   (837)              TRUE =: failed
  1498   (838)          ENDON
  1499   (839)          FALSE =: failed
  1500   (840)  
  1501   (841)          MONITOR_CALL('GetRTAddress', rtProgName, rtAddr)
  1502   (842)  
  1503   (843)          % Clear the handler before anything else can raise under it.
  1504   (844)          ON ROUTINEERROR DO
  1505   (845)          ENDON
  1506   (846)  
  1507   (847)          IF failed OR rtAddr = 0 THEN
  1508   (848)              OUTPUT(1, 'AL31', 'cannot find RT program CHATSER$')
  1509   (849)              FALSE RETURN
  1510   (850)          ENDIF
  1511   (851)  
  1512   (852)          ON ROUTINEERROR DO
  1513   (853)              TRUE =: failed
  1514   (854)          ENDON
  1515   (855)          FALSE =: failed
  1516   (856)  
  1517   (857)          MONITOR_CALL('StartRTProgram', rtAddr)
  1518   (858)  
  1519   (859)          ON ROUTINEERROR DO
  1520   (860)          ENDON
  1521   (861)  
  1522   (862)          IF failed THEN
  1523   (863)              OUTPUT(1, 'AL24', 'could not start CHATSER$')
  1524   (864)              FALSE RETURN
  1525   (865)          ENDIF
  1526   (866)  
  1527   (867)          TRUE RETURN
  1528   (868)      ENDROUTINE
  1529   (869)  
  1530   (870)      ROUTINE VOID, VOID : dispatch
  1531   (871)          IF at = 0 THEN
  1532   (872)              RETURN
  1533   (873)          ENDIF
  1534   (874)  
  1535   (875)          verbLength =: cmdWordLen
  1536   (876)          IF cmdWordLen = 0 THEN
  1537   (877)              RETURN
  1538   (878)          ENDIF
  1539   (879)  
  1540   (880)          % ? IS NOT AN ABBREVIATION OF ANYTHING and must not go near the
  1541   (881)          % matcher. X-C answers ?, and a person coming from anywhere else types
  1542   (882)          % HELP, so both are taken.
  1543   (883)          IF cmdWordLen = 1 AND lineBuf(0) = questCh THEN
  1544   (884)              showHelp
  1545   (885)              RETURN
  1546   (886)          ENDIF
  1547   (887)  
  1548   (888)          matchAll
  1549   (889)  
  1550   (890)          IF cmdCount = 0 THEN
  1551   (891)              OUTPUT(1, 'AL16', 'no such command$')
  1552   (892)              RETURN
  1553   (893)          ENDIF
  1554   (894)  
  1555   (895)          % REFUSE, DO NOT GUESS. "S" fits STATUS, STOP and START, and picking
  1556   (896)          % one of them because it happened to be tested last is how an operator
  1557   (897)          % stops a server they meant to ask about.
  1558   (898)          IF cmdCount > 1 THEN
  1559   (899)              showAmbiguous
  1560   (900)              RETURN
  1561   (901)          ENDIF
  1562   (902)  
  1563   (903)          IF cmdId = cExit THEN
  1564   (904)              TRUE =: leaving
  1565   (905)              RETURN
  1566   (906)          ENDIF
  1567   (907)  
  1568   (908)          IF cmdId = cHelp THEN
  1569   (909)              showHelp
  1570   (910)              RETURN
  1571   (911)          ENDIF
  1572   (912)  
  1573   (913)          IF cmdId = cStatus THEN
  1574   (914)              sendAdmin(kAdmStat)
  1575   (915)              showAnswer
  1576   (916)              RETURN
  1577   (917)          ENDIF
  1578   (918)  
  1579   (919)          IF cmdId = cStop THEN
  1580   (920)              sendAdmin(kAdmStop)
  1581   (921)              % A STOP gets no answer - the server is gone by the time one could
  1582   (922)              % be written. Waiting for a reply that is never coming is how a
  1583   (923)              % tool ends up looking hung when it worked.
  1584   (924)              OUTPUT(1, 'AL10', 'stop sent$')
  1585   (925)              RETURN
  1586   (926)          ENDIF
  1587   (927)  
  1588   (928)          % START IS BACK TO NOT BUILT, AND THE REASON IS MEASURED.
  1589   (929)          %
  1590   (930)          % StartRTProgram (RT 100B) is REFUSED from here. Typing START answered
  1591   (931)          %
  1592   (932)          %     ERROR 00 AT  12156; ILLEGAL MONITOR CALL
  1593   (933)          %       100
  1594   (934)          %
  1595   (935)          % and took CHAT-MON down with it. GetRTAddress (151B) got through, so it
  1596   (936)          % is 100B specifically - it needs a privilege this program does not have
  1597   (937)          % running as an ordinary background program. The manual's parameter list
  1598   (938)          % was read and its PERMISSION COLUMNS were not.
  1599   (939)          %
  1600   (940)          % AND THE GUARD DOES NOT HELP. ON ROUTINEERROR does NOT catch an ILLEGAL
  1601   (941)          % MONITOR CALL - that is a system trap, not a ROUTINEERROR - so wrapping
  1602   (942)          % it more carefully changes nothing. A command that kills the program is
  1603   (943)          % worse than one that admits it does nothing, so it admits it.
  1604   (944)          %
  1605   (945)          % AND THE MANUAL SAYS SO PLAINLY. ND-860228-2-EN SINTRAN III Monitor
  1606   (946)          % Calls, the availability line under StartRTProgram:
  1607   (947)          %
  1608   (948)          %     | ND-100 and ND-500 | User RT and user SYSTEM | RT programs |
  1609   (949)          %
  1610   (950)          % Three columns: which machine, which USER, and which PROGRAM TYPE. We
  1611   (951)          % are user SYSTEM, which is allowed. We are a BACKGROUND program, which
  1612   (952)          % is not. Page 5 of the same manual states the rule in general - "Other
  1613   (953)          % monitor calls may be used only in RT programs or only in background
  1614   (954)          % programs."
  1615   (955)          %
  1616   (956)          % SO THIS IS NOT A BUG TO BE FIXED, IT IS A CONSTRAINT. An interactive
  1617   (957)          % operator shell IS a background program; making CHAT-MON an RT program
  1618   (958)          % to win this one command would cost it its terminal. @RT CHATSER typed
  1619   (959)          % at SINTRAN works because SINTRAN itself does the starting.
  1620   (960)          %
  1621   (961)          % The honest thing, and what RESTART now does, is to tell the operator
  1622   (962)          % the command rather than pretend to run it.
  1623   (963)          %
  1624   (964)          % Note the ERR column for 100B is BLANK - the call has NO error return,
  1625   (965)          % which is why it traps as ILLEGAL MONITOR CALL instead of handing back
  1626   (966)          % a status, and why no amount of guarding could have caught it.
  1627   (967)          IF cmdId = cStart THEN
  1628   (968)              OUTPUT(1, 'AL32', 'SINTRAN only - type @RT CHATSER$')
  1629   (969)              RETURN
  1630   (970)          ENDIF
  1631   (971)  
  1632   (972)          % RESTART IS STOP THEN START, and the two halves travel by different
  1633   (973)          % roads: the stop is a message to the running server, the start is an RT
  1634   (974)          % start from here. The server has to notice the stop and terminate
  1635   (975)          % before the start can take, and nothing here waits for it - so this
  1636   (976)          % says what it did rather than claiming the server is up.
  1637   (977)          % RESTART is STOP then START, and START is refused - see above. The stop
  1638   (978)          % half works, so it does that and says plainly what is left to do by
  1639   (979)          % hand rather than pretending the server is coming back.
  1640   (980)          IF cmdId = cRestart THEN
  1641   (981)              sendAdmin(kAdmStop)
  1642   (982)              OUTPUT(1, 'AL10', 'stop sent$')
  1643   (983)              OUTPUT(1, 'AL31', 'start it yourself: @RT CHATSER$')
  1644   (984)              RETURN
  1645   (985)          ENDIF
  1646   (986)  
  1647   (987)          % ---- THE TRUNK VERBS ------------------------------------------------
  1648   (988)          %
  1649   (989)          % These were declared long before they did anything, so the command set
  1650   (990)          % and its abbreviations could be settled and a mode file written against
  1651   (991)          % them. The server half exists now.
  1652   (992)          %
  1653   (993)          % All three answer with kAdmRepl, the same kind STATUS uses, so showAnswer
  1654   (994)          % needs no new decoding - the server sends readable text and this prints
  1655   (995)          % it. That is why adding three verbs costs no wire change.
  1656   (996)          IF cmdId = cStartTrunk THEN
  1657   (997)              sndArgMsg(kAdmTrunk)
  1658   (998)              showAnswer
  1659   (999)              RETURN
  1660  (1000)          ENDIF
  1661  (1001)  
  1662  (1002)          % INITIALIZE <room> <n> - how many messages that room remembers.
  1663  (1003)          %
  1664  (1004)          % TWO FIELDS IN ONE ARGUMENT, and this end does not take them apart.
  1665  (1005)          % sndArgMsg sends everything after the verb as text and the SERVER
  1666  (1006)          % splits it, for the same reason START-TRUNK does not parse its system
  1667  (1007)          % number here: one place decides what a valid argument is, so there are
  1668  (1008)          % never two that can disagree about it.
  1669  (1009)          IF cmdId = cInit THEN
  1670  (1010)              sndArgMsg(kAdmInit)
  1671  (1011)              showAnswer
  1672  (1012)              RETURN
  1673  (1013)          ENDIF
  1674  (1014)  
  1675  (1015)          % DROP-MEMBER <name> - free that seat on the server and tell nobody.
  1676  (1016)          %
  1677  (1017)          % sndArgMsg like the other verbs that carry an argument: the name goes
  1678  (1018)          % across as text and the SERVER decides what a valid one is, so there is
  1679  (1019)          % only ever one place that can be wrong about it.
  1680  (1020)          %
  1681  (1021)          % THIS IS A TEST VERB AND THE HELP LINE SAYS SO. It exists to reach
  1682  (1022)          % kTrkDBad on purpose - see the comment on kAdmDrop in CHATSV.PLNC.
  1683  (1023)          % Used on a live room it silently unseats somebody, and the room is
  1684  (1024)          % never told, which is exactly what makes it useful and exactly what
  1685  (1025)          % makes it wrong for anything else.
  1686  (1026)          IF cmdId = cDropMbr THEN
  1687  (1027)              sndArgMsg(kAdmDrop)
  1688  (1028)              showAnswer
  1689  (1029)              RETURN
  1690  (1030)          ENDIF
  1691  (1031)  
  1692  (1032)          % SET-NAME <name> - what this machine calls itself.
  1693  (1033)          %
  1694  (1034)          % TYPICALLY THE MACHINE'S OWN NAME, and that is the point of it: a room
  1695  (1035)          % that spans machines shows ANNA@D102 today, which is a number a person
  1696  (1036)          % has to translate. With a name set it shows ANNA@FJELL.
  1697  (1037)          %
  1698  (1038)          % SET-NAME with nothing after it CLEARS the name, and the machine goes
  1699  (1039)          % back to being called D<number> everywhere - which is what it was
  1700  (1040)          % before names existed, so there is a way back from a typo that does
  1701  (1041)          % not need a restart.
  1702  (1042)          %
  1703  (1043)          % NOT PARSED HERE. sndArgMsg sends everything after the verb and the
  1704  (1044)          % SERVER decides what a valid name is, for the same reason START-TRUNK
  1705  (1045)          % does not parse its system number at this end: one place decides, so
  1706  (1046)          % there are never two that can disagree.
  1707  (1047)          %
  1708  (1048)          % IT IS NOT WRITTEN TO DISK. Put it in this machine's boot mode file
  1709  (1049)          % beside START-TRUNK and it is set on every cold start.
  1710  (1050)          IF cmdId = cSetName THEN
  1711  (1051)              sndArgMsg(kAdmName)
  1712  (1052)              showAnswer
  1713  (1053)              RETURN
  1714  (1054)          ENDIF
  1715  (1055)  
  1716  (1056)          % LOCK-TRUNKS / UNLOCK-TRUNKS carry no argument, so they go out with
  1717  (1057)          % sendAdmin rather than sndArgMsg. The server answers with kAdmRepl like
  1718  (1058)          % every other admin verb, so showAnswer needs no new decoding.
  1719  (1059)          IF cmdId = cLockTrunks THEN
  1720  (1060)              sendAdmin(kAdmLock)
  1721  (1061)              showAnswer
  1722  (1062)              RETURN
  1723  (1063)          ENDIF
  1724  (1064)  
  1725  (1065)          IF cmdId = cUnlockTrk THEN
  1726  (1066)              sendAdmin(kAdmOpen)
  1727  (1067)              showAnswer
  1728  (1068)              RETURN
  1729  (1069)          ENDIF
  1730  (1070)  
  1731  (1071)          IF cmdId = cStopTrunk THEN
  1732  (1072)              sndArgMsg(kAdmUntrnk)
  1733  (1073)              showAnswer
  1734  (1074)              RETURN
  1735  (1075)          ENDIF
  1736  (1076)  
  1737  (1077)          IF cmdId = cListTrunks THEN
  1738  (1078)              sendAdmin(kAdmTrunks)
  1739  (1079)              showAnswer
  1740  (1080)              RETURN
  1741  (1081)          ENDIF
  1742  (1082)  
  1743  (1083)          % LIST-MEMBER - no argument, carries no NEW state, so this is
  1744  (1084)          % sendAdmin like LIST-TRUNKS and not sndArgMsg like DROP-MEMBER.
  1745  (1085)          IF cmdId = cListMbr THEN
  1746  (1086)              sendAdmin(kAdmMbrs)
  1747  (1087)              showAnswer
  1748  (1088)              RETURN
  1749  (1089)          ENDIF
  1750  (1090)  
  1751  (1091)          % RESTART-TRUNK is STOP-TRUNK then START-TRUNK against the same system.
  1752  (1092)          % Both halves are ordinary messages here - unlike RESTART above, which
  1753  (1093)          % needs an RT start this program is not allowed to make - so it really
  1754  (1094)          % does both and says so.
  1755  (1095)          IF cmdId = cRestTrunk THEN
  1756  (1096)              sndArgMsg(kAdmUntrnk)
  1757  (1097)              showAnswer
  1758  (1098)              sndArgMsg(kAdmTrunk)
  1759  (1099)              showAnswer
  1760  (1100)              RETURN
  1761  (1101)          ENDIF
  1762  (1102)  
  1763  (1103)          notYet
  1764  (1104)      ENDROUTINE
  1765  (1105)  
  1766  (1106)      % -----------------------------------------------------------------------
  1767  (1107)      % The program.
  1768  (1108)      % -----------------------------------------------------------------------
  1769  (1109)      PROGRAM : chatMonitor
  1770  (1110)          INISTACK stack
  1771  (1111)  
  1772  (1112)          % The flags WORD from its bit position. XFWTF is a BIT NUMBER in the
  1773  (1113)          % values file, not a mask - 2**XFWTF is what the call wants.
  1774  (1114)          2**XFWTF =: waitFlags
  1775  (1115)  
  1776  (1116)          xmpfopn(0, myPort) =: returnStatus
  1777  (1117)          IF returnStatus >< XMOK THEN
  1778  (1118)              showStatus('xmpfopn', returnStatus)
  1779  (1119)              RETURN
  1780  (1120)          ENDIF
  1781  (1121)  
  1782  (1122)          OUTPUT(1, 'AL31', 'CHAT-MON - type ? for commands$')
  1783  (1123)  
  1784  (1124)          % ---- THE COMMAND LOOP -------------------------------------------
  1785  (1125)          %
  1786  (1126)          % A SHELL, NOT A ONE-SHOT. This used to read one line, send it and
  1787  (1127)          % exit, so an operator had to restart the program for every command
  1788  (1128)          % and could not use it the way X-C is used. It now prompts, dispatches
  1789  (1129)          % and prompts again until EXIT - the same feel as X-C, and the same
  1790  (1130)          % shape a boot mode file can drive line by line.
  1791  (1131)          FALSE =: leaving
  1792  (1132)          DO
  1793  (1133)              OUTPUT(1, 'AL5', 'C-M: ')
  1794  (1134)              readLine
  1795  (1135)              dispatch
  1796  (1136)              WHILE NOT leaving
  1797  (1137)          ENDDO
  1798  (1138)      ENDROUTINE
  1799  (1139)  
  1800  (1140)  ENDMODULE
  1801  (1141)  