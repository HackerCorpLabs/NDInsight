   761   (101)  
   762   (102)  % ---------------------------------------------------------------------------
   763   (103)  % FILE MONITOR CALLS, for the log. Same three CHAT.PLNC uses for CHAT:CNFG,
   764   (104)  % declared the same way, because that pair has been working on D100 since
   765   (105)  % 2026-08-19 and a second spelling of a proven call is a second thing to get
   766   (106)  % wrong.
   767   (107)  %
   768   (108)  %   MON50  OpenFile   name, type, access -> device number. RAISES ROUTINEERROR
   769   (109)  %                     on failure, and leaves 46 in the device number when the
   770   (110)  %                     file is not there - NOT zero. Never test the number.
   771   (111)  %   MON2   OutByte    the byte is the IN-VALUE: "b MON2(dev)".
   772   (112)  %   MON43  CloseFile  and it is 43, not 54 - 54 is DELETE.
   773   (113)  %
   774   (114)  % They come from MON-CALL-1B-A00, which this program already links for
   775   (115)  % MONITOR_CALL - see the LOAD line in CHATSV:MODE.
   776   (116)  % ---------------------------------------------------------------------------
   777   (117)  IMPORT ( ROUTINE VOID, INTEGER (BYTES, BYTES, INTEGER) : MON50 )
   778   (118)  IMPORT ( ROUTINE BYTE, VOID (INTEGER) : MON2 )
   779   (119)  IMPORT ( ROUTINE VOID, VOID (INTEGER) : MON43 )
   780   (120)  
   781   (121)  % MN113 CLOCK - seven elements, and it is the ND's OWN date and time.
   782   (122)  % 0 basic units, 1 sec, 2 min, 3 hour, 4 day, 5 month, 6 year - and the
   783   (123)  % year is the FULL 1998, not 98. Nothing here converts it to an epoch or
   784   (124)  % to text: the words are stored as the machine gives them and are read
   785   (125)  % back the same way, which is Ronny's call and also the only form that
   786   (126)  % cannot drift with somebody's idea of a date format.
   787   (127)  IMPORT ( ROUTINE VOID, VOID (INTEGER ARRAY WRITE) : MN113 )
   788   (128)  
   789   (129)  % MON11 TIME - basic time units, a fiftieth of a second each, as an
   790   (130)  % INTEGER4. Signature from ND-60.117.5 page 13445: ROUTINE VOID,INTEGER4.
   791   (131)  % THE TICK HAS TO COME OFF THE CLOCK once the sleep can be cut short by a
   792   (132)  % wake-up - counting sleeps only measures seconds while every sleep runs
   793   (133)  % its full length. See the main loop.
   794   (134)  IMPORT ( ROUTINE VOID, INTEGER4 : MON11 )
   795   (135)  
   796   (136)  % ---------------------------------------------------------------------------
   797   (137)  % RANDOM BLOCK ACCESS, for the per-room history ring.
   798   (138)  %
   799   (139)  %   MN117  ReadFromFile  (RFILE 117B)
   800   (140)  %   MN120  WriteToFile   (WFILE 120B)
   801   (141)  %
   802   (142)  %     (dev, zero, dadr, bl, words)
   803   (143)  %      dev    the device number MON50 gave back
   804   (144)  %      zero   the WAIT flag: 0 suspends until the transfer is done, which is
   805   (145)  %             what we want - anything else means checking with AwaitFileTransfer
   806   (146)  %      dadr   the buffer, an INTEGER ARRAY. WORDS, not bytes.
   807   (147)  %      bl     the block to start at. The FIRST BLOCK IS 0, and -1 means "the
   808   (148)  %             next one".
   809   (149)  %      words  how many words to move.
   810   (150)  %
   811   (151)  % THE NAME LOSES ITS "O" ABOVE 76, and this is not a typo. Asked the library
   812   (152)  % itself rather than guessed:
   813   (153)  %
   814   (154)  %   Brl: LIST-BRF-ENTRIES PLANC-1BANK-F00,,
   815   (155)  %        ... MON73 MON74 MON75 MON76  MN104 MN113 MN114 MN117 MN120 MN122 ...
   816   (156)  %
   817   (157)  % "MON104" would be six characters and an ND symbol is five, so the O goes.
   818   (158)  % The PLANC manual's appendix looks self-contradictory for the same reason -
   819   (159)  % its HEADING says "MON117" and the routine it declares is "MN117". The
   820   (160)  % routine name is the one to import. One command settled it; the alternative
   821   (161)  % was a guessed name and a four-minute compile to find out.
   822   (162)  %
   823   (163)  % WHY RANDOM AND NOT THE SEQUENTIAL PAIR ABOVE: MON1/MON2 move one byte and
   824   (164)  % cannot overwrite in place, so a ring built on them means rewriting the whole
   825   (165)  % file - on every message, or on every N with a compaction step. One message
   826   (166)  % per 512-byte block makes an append a SINGLE MN120 at block (id MOD N): no
   827   (167)  % read-modify-write, no compaction, and a file whose size is fixed the day the
   828   (168)  % room is created.
   829   (169)  % ---------------------------------------------------------------------------
   830   (170)  IMPORT ( ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER ARRAY, INTEGER, &
   831   (171)      INTEGER) : MN117 )
   832   (172)  IMPORT ( ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER ARRAY, INTEGER, &
   833   (173)      INTEGER) : MN120 )
   834   (174)  
   835   (175)      % ----- message kinds, mirroring ChatMessageKind.cs ----------------------
   836   (176)      % ---- THE MESSAGE KINDS COME FROM CHATLIB -------------------------
   837   (177)      %
   838   (178)      % They used to be declared here AND in the other program - twenty of
   839   (179)      % them, agreeing only because somebody kept checking. Nothing made
   840   (180)      % them agree, and an unhandled kind is SILENT, which is the worst
   841   (181)      % failure this product has. Imported from one place, a drift is a
   842   (182)      % LINK error instead, and LIST-ENTRIES-UNDEFINED already runs in every
   843   (183)      % link.
   844   (184)      %
   845   (185)      % TWO NAMES CHANGED because they could not cross a BRF boundary -
   846   (186)      % names are unique in SEVEN characters there, so kRename/kRenamed both
   847   (187)      % read KRENAME and kDirect/kDirected both read KDIRECT. kRenamed is now
   848   (188)      % kRenOk and kDirected is now kDirGot. The WIRE NUMBERS are unchanged.
   849   (189)      IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER, BYTES, INTEGER, BYTES, &
   850   (190)              INTEGER, INTEGER, INTEGER) : cmEncAt)
   851   (191)  
   852   (192)      % THE DECODERS, so the header is read in ONE place rather than parsed by
   853   (193)      % hand at each arrival. See the same note in CHAT.PLNC.
   854   (194)      %
   855   (195)      % THESE ARE FOR THE CHAT HEADER ONLY. The server also parses a TRUNK RELAY
   856   (196)      % header (origin, hops, relay id) and an XROUT LETTER header (service byte,
   857   (197)      % payload offset), and those are DIFFERENT FORMATS that happen to be read
   858   (198)      % out of the same buffer. Do not reach for cmNmLen there - inBuf(1) means
   859   (199)      % something else in each of them.
   860   (200)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmKind)
   861   (201)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmNmLen)
   862   (202)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmTxAt)
   863   (203)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : cmTxLen)
   864   (204)  
   865   (205)      % THE RELAY HEADER. trHLen answers how many bytes a kind carries - 0 for
   866   (206)      % anything that is not relayed - so the receive loop asks it about every
   867   (207)      % message and needs no special case. trStrip takes the header off and
   868   (208)      % leaves an ordinary chat frame behind, which is why cmNmLen is correct
   869   (209)      % AFTER it and would be nonsense before.
   870   (210)      IMPORT (ROUTINE VOID, INTEGER (INTEGER) : trHLen)
   871   (211)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : trOrig)
   872   (212)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : trHops)
   873   (213)      IMPORT (ROUTINE VOID, INTEGER (BYTES) : trId)
   874   (214)      IMPORT (ROUTINE VOID, INTEGER (BYTES, INTEGER, INTEGER) : trStrip)
   875   (215)  
   876   (216)      % THE TRUNK KINDS. Declared in CHATLIB so the relay codec and this
   877   (217)      % server cannot disagree about a number that crosses a wire between
   878   (218)      % MACHINES - the far end may be running an older build.
   879   (219)      %
   880   (220)      % THEY MUST BE HERE, not beside the comments that explain them further
   881   (221)      % down: PLANC answers MISPLACED STATEMENT for an IMPORT that follows an
   882   (222)      % ordinary declaration, and every IMPORT belongs in this one block.
   883   (223)      IMPORT (INTEGER : kTrkHello)
   884   (224)      IMPORT (INTEGER : trkAsk)
   885   (225)      IMPORT (INTEGER : trkAnswer)
   886   (226)      IMPORT (INTEGER : kTrkWho)
   887   (227)      IMPORT (INTEGER : kTrkMbrs)
   888   (228)      IMPORT (INTEGER : kTrkSaid)
   889   (229)      IMPORT (INTEGER : kTrkRly)
   890   (230)      IMPORT (INTEGER : maxHops)
   891   (231)      IMPORT (INTEGER : kTrkRlId)
   892   (232)      IMPORT (INTEGER : kTrkDir)
   893   (233)      IMPORT (INTEGER : kTrkDBad)
   894   (234)      IMPORT (INTEGER : kJoin)
   895   (235)      IMPORT (INTEGER : kWelcome)
   896   (236)      IMPORT (INTEGER : kReject)
   897   (237)      IMPORT (INTEGER : kSay)
   898   (238)      IMPORT (INTEGER : kSaid)
   899   (239)      IMPORT (INTEGER : kLeave)
   900   (240)      IMPORT (INTEGER : kJoined)
   901   (241)      IMPORT (INTEGER : kLeft)
   902   (242)      IMPORT (INTEGER : kRename)
   903   (243)      IMPORT (INTEGER : kRenOk)
   904   (244)      IMPORT (INTEGER : kWho)
   905   (245)      IMPORT (INTEGER : kMap)
   906   (246)      IMPORT (INTEGER : kRooms)
   907   (247)      IMPORT (INTEGER : kTopic)
   908   (248)      IMPORT (INTEGER : kAllWho)
   909   (249)      IMPORT (INTEGER : kHist)
   910   (250)      IMPORT (INTEGER : kDirect)
   911   (251)      IMPORT (INTEGER : kDirGot)
   912   (252)      IMPORT (INTEGER : kDirSent)
   913   (253)      IMPORT (INTEGER : kDirBad)
   914   (254)  
   915   (255)  
   916   (256)      % ONE KIND, BOTH DIRECTIONS: the member asks with an empty text, the room
   917   (257)      % answers with the same kind and the names in the text. See buildWho.
   918   (258)  
   919   (259)      % ALSO ONE KIND BOTH DIRECTIONS, same shape as kWho.
   920   (260)      %
   921   (261)      % kTopic  ask: empty text.  set: the new topic in the text.
   922   (262)      %         answer: the ROOM NAME in the name field, the topic in the text.
   923   (263)      %         A SET is broadcast to the room; an ASK goes to the asker alone.
   924   (264)      % kRooms  ask: empty text. answer: "NAME(count)" per room, space separated.
   925   (265)      %
   926   (266)      % Room kinds live in 1..31 and admin starts at 32 - see the note there.
   927   (267)      % These MUST match DOC/protocols/chat-wire.json and ChatMessageKind.cs, and
   928   (268)      % all three move in the same commit.
   929   (269)      % 12 IS NOT FREE - it is Map, reserved for /map (task #77). The registry
   930   (270)      % had already allocated all three when this was written, and taking 12 for
   931   (271)      % the topic would have put /topic and /map on the same number. Read
   932   (272)      % DOC/protocols/chat-wire.json BEFORE picking a kind, not after.
   933   (273)      % /map - the machines and their trunks, for an ordinary member. A ROOM kind
   934   (274)      % and not an admin one on purpose: SEEING how the network is wired is not
   935   (275)      % the same right as REWIRING it. Reserved here since 2026-08-20; built
   936   (276)      % 2026-08-22. See buildMap.
   937   (277)  
   938   (278)  
   939   (279)      % THE ANSWER TO /who WHEN THE ASKER IS IN NO ROOM.
   940   (280)      %
   941   (281)      % Ronny, 2026-08-22: "running /who when not in a room should list all rooms
   942   (282)      % and all people in the rooms." A person who has left, or who was refused a
   943   (283)      % nickname, has no seat and therefore no room to filter by - and the useful
   944   (284)      % answer to them is the whole house, not silence.
   945   (285)      %
   946   (286)      % A SEPARATE KIND, NOT kWho, because the client LABELS a kWho answer with
   947   (287)      % the room it thinks it is in - "in (LOBBY): ..." - and putting every room's
   948   (288)      % people under that label would print something FALSE, which is the exact
   949   (289)      % mistake /who itself made until 2026-08-22 (see buildWho). A different kind
   950   (290)      % costs one number and makes the label impossible to get wrong.
   951   (291)      %
   952   (292)      % ONE DIRECTION ONLY, unlike its neighbours: the client never sends 15. It
   953   (293)      % sends kWho and the SERVER decides which answer fits, because the server is
   954   (294)      % the one that knows whether the asker has a seat.
   955   (295)  
   956   (296)      % REPLAYED HISTORY - one of these per remembered message, sent to a joiner
   957   (297)      % before the room hears they arrived.
   958   (298)      %
   959   (299)      % A DISTINCT KIND AND NOT kSaid, decided 2026-08-22 and written into the
   960   (300)      % registry with the reason. Replaying kSaid would be less code and the
   961   (301)      % client already renders it - but then a client CANNOT TELL history from
   962   (302)      % live traffic, and the difference matters the moment it timestamps, beeps
   963   (303)      % or counts unread. Taking the cheap option here would be choosing to make
   964   (304)      % those features wrong later.
   965   (305)      %
   966   (306)      % Same shape as kSaid otherwise: the speaker in the name field, what they
   967   (307)      % said in the text.
   968   (308)  
   969   (309)      % ----- DIRECT MESSAGES, one person to one person -----------------------
   970   (310)      %
   971   (311)      % These four are 17..20, inside the ROOM block (1..31), because a direct
   972   (312)      % message is ordinary member traffic on the service port - it configures
   973   (313)      % nothing, so it is not an admin kind.
   974   (314)      %
   975   (315)      % kDirect   client to server. The TARGET rides in the TEXT before a '/',
   976   (316)      %           exactly as kSay's room does on a trunk - one layout for the
   977   (317)      %           whole family rather than a special case per direction. The
   978   (318)      %           target is either a bare alias (RONNY) or one qualified by
   979   (319)      %           machine (D102!RONNY).
   980   (320)      % kDirGot server to the TARGET. The name field holds the sender
   981   (321)      %           QUALIFIED - D102!KARI, never a bare KARI - because what is
   982   (322)      %           shown has to be what can be typed back, and a bare name is
   983   (323)      %           ambiguous the moment two machines each hold one. The text is
   984   (324)      %           the message alone: the target is whoever is reading it.
   985   (325)      % kDirSent  server to the SENDER, naming who it actually went to. Sent on
   986   (326)      %           EVERY delivery and not only on ambiguous ones - refusing an
   987   (327)      %           ambiguous alias protects the sender when the collision is
   988   (328)      %           visible, this protects them when it is not, and it costs one
   989   (329)      %           line to make a wrong delivery visible at once.
   990   (330)      % kDirBad   server to the SENDER: not delivered, and why. The name field
   991   (331)      %           holds the target that was tried, the text the reason - and for
   992   (332)      %           an ambiguous alias the CANDIDATES, so they can be retyped
   993   (333)      %           straight off the screen.
   994   (334)      %
   995   (335)      % THERE IS DELIBERATELY NO STORE AND FORWARD. "not logged in" is a refusal,
   996   (336)      % not a queue. A message that waits for somebody is a mailbox - a different
   997   (337)      % product with different rules, and SINTRAN already has mail for that.
   998   (338)  
   999   (339)      % ADMIN kinds - 32 and up, and they belong on the command port. These MUST
  1000   (340)      % match DOC/protocols/chat-wire.json and ChatMessageKind.cs; all three move
  1001   (341)      % in the same commit, which is constraint 5 of the federation design.
  1002   (342)      INTEGER : kAdmStat := 32
  1003   (343)      INTEGER : kAdmRepl := 33
  1004   (344)      INTEGER : kAdmStop := 34
  1005   (345)  
  1006   (346)      % Trunk configuration, from CHAT-MON on the command port. These CONFIGURE the
  1007   (347)      % network, which is why they are admin kinds and not room kinds - seeing how
  1008   (348)      % the network is wired (/map, kind 12) is not the same right as rewiring it.
  1009   (349)      % All three answer with kAdmRepl, so CHAT-MON needs no new decoding.
  1010   (350)      INTEGER : kAdmTrunk   := 35
  1011   (351)      INTEGER : kAdmUntrnk  := 36
  1012   (352)  
  1013   (353)      % INITIALIZE <room> <n> - how many messages a room remembers.
  1014   (354)      %
  1015   (355)      % An ADMIN kind because it configures the server, and it is the one thing
  1016   (356)      % the history design asked for that the ring itself did not provide: "a
  1017   (357)      % CONSTANT, default around 50 messages per room, CONFIGURABLE PER ROOM ...
  1018   (358)      % not a hard-coded 50 buried in the source".
  1019   (359)      INTEGER : kAdmInit    := 38
  1020   (360)  
  1021   (361)      % SET-NAME <name> from CHAT-MON. What this machine calls itself.
  1022   (362)      %
  1023   (363)      % An ADMIN kind because it configures the server. Answered with kAdmRepl
  1024   (364)      % like every other admin verb, so CHAT-MON needs no new decoding.
  1025   (365)      INTEGER : kAdmName    := 39
  1026   (366)      INTEGER : kAdmTrunks  := 37
  1027   (367)  
  1028   (368)      % LOCK-PEERS and OPEN-PEERS from CHAT-MON.
  1029   (369)      %
  1030   (370)      % A server learns a peer from any system that reaches its trunk port, which
  1031   (371)      % is what makes a lab easy to set up and is the default. It also means the
  1032   (372)      % server believes whatever that system says about who is speaking on it - a
  1033   (373)      % trunk line is delivered as NAME@thatsystem - so an operator needs a way to
  1034   (374)      % say "these are the machines, take no more".
  1035   (375)      %
  1036   (376)      % TWO KINDS RATHER THAN ONE WITH AN ARGUMENT. Every other admin verb here is
  1037   (377)      % its own number, and a verb whose meaning depends on parsing its text is
  1038   (378)      % the one that gets typed wrong at three in the morning.
  1039   (379)      INTEGER : kAdmLock    := 40
  1040   (380)      INTEGER : kAdmOpen    := 41
  1041   (381)  
  1042   (382)      % DROP-MEMBER <name> - RELEASE A SEAT AND TELL NOBODY.
  1043   (383)      %
  1044   (384)      % THIS EXISTS TO TEST kTrkDBad, and it is the only way to reach that code
  1045   (385)      % path on purpose. kTrkDBad fires when THIS machine is asked to deliver a
  1046   (386)      % private message to somebody a PEER still believes is seated here. Every
  1047   (387)      % ordinary way of ending a session keeps the two machines in step, which is
  1048   (388)      % exactly right for the product and leaves the refusal unreachable by hand:
  1049   (389)      %
  1050   (390)      %   /quit          sends kLeave, which broadcasts kLeft and calls tellMbrs
  1051   (391)      %   /nick          crosses the trunk, so the peer follows the new name
  1052   (392)      %   an RT-load     empties the table, but the orphaned client REJOINS
  1053   (393)      %   a peer restart makes the other side purge what it knew
  1054   (394)      %
  1055   (395)      % MEASURED 2026-08-30: all four were tried against D100/D102 and every one
  1056   (396)      % of them self-healed, so all four refusals came back as the LOCAL one
  1057   (397)      % ("nobody of that name is here now") and the trunk path never ran. The
  1058   (398)      % reason string is the only thing that tells the two apart.
  1059   (399)      %
  1060   (400)      % So this verb frees the seat and does NOTHING ELSE - no kLeft to the room,
  1061   (401)      % no tellMbrs to the peers. That is precisely the disagreement kTrkDBad was
  1062   (402)      % written for, and it is a state the machine can otherwise only reach by
  1063   (403)      % losing a race.
  1064   (404)      INTEGER : kAdmDrop    := 42
  1065   (405)  
  1066   (406)      % LIST-MEMBER - who is seated here right now, and which room. The other
  1067   (407)      % half of the DROP-MEMBER pair Ronny asked for: DROP-MEMBER acts on a seat,
  1068   (408)      % LIST-MEMBER shows them. Answered with kAdmRepl, same as LIST-TRUNKS.
  1069   (409)      INTEGER : kAdmMbrs    := 43
  1070   (410)  
  1071   (411)      % SERVER TO SERVER, on the trunk port. 48 and up, left clear of the admin
  1072   (412)      % block so a future admin verb cannot collide with a trunk one.
  1073   (413)      %
  1074   (414)      % ONE KIND, BOTH DIRECTIONS, and the TEXT'S FIRST BYTE says which way: 0 is
  1075   (415)      % "I am here, are you?" and 1 is "I am here, and I am answering you". Without
  1076   (416)      % that byte two servers answering each other's HELLO would say hello for
  1077   (417)      % ever. An ANSWER is never answered.
  1078   (418)      % (imported at the top of the module - see the IMPORT block)
  1079   (419)      % (imported at the top of the module - see the IMPORT block)
  1080   (420)      % (imported at the top of the module - see the IMPORT block)
  1081   (421)  
  1082   (422)      % Phase C - "tell me who is on you" and the answer.
  1083   (423)      %
  1084   (424)      % TWO KINDS, NOT ONE, unlike the hello. The hello could share a kind because
  1085   (425)      % its two directions carry the same thing; these do not - the ask is empty
  1086   (426)      % and the answer is a list - so a receiver would have to look at the length
  1087   (427)      % to know which it had. A kind per direction is cheaper to read and cannot
  1088   (428)      % be got wrong.
  1089   (429)      %
  1090   (430)      % THE ANSWER'S TEXT is "NAME/ROOM NAME/ROOM ...", space between people and a
  1091   (431)      % slash between a person and their room. Readable on a trace, and it needs
  1092   (432)      % no length table - the same shape /who already sends to a client.
  1093   (433)      % (imported at the top of the module - see the IMPORT block)
  1094   (434)      % (imported at the top of the module - see the IMPORT block)
  1095   (435)  
  1096   (436)      % Phase D - somebody spoke on another machine.
  1097   (437)      %
  1098   (438)      % NAME field = the speaker, unqualified, as their own machine knows them.
  1099   (439)      % TEXT = "ROOM/what they said". The receiving machine adds the "@Dnnn",
  1100   (440)      % because only IT knows which system the letter came from - taken from the
  1101   (441)      % magic, not from anything the sender claimed. A speaker cannot forge the
  1102   (442)      % machine they are on.
  1103   (443)      %
  1104   (444)      % NOT RELAYED ONWARD. A message received on a trunk is delivered to local
  1105   (445)      % members and stops. With two machines that is complete; with three it will
  1106   (446)      % need a hop count and an origin, which is the rest of phase D and is not
  1107   (447)      % built. Forwarding blindly now would loop the moment a third machine
  1108   (448)      % appeared.
  1109   (449)      % (imported at the top of the module - see the IMPORT block)
  1110   (450)      % A line being RELAYED onward. Same shape as kTrkSaid with three bytes in
  1111   (451)      % front: the origin system, big-endian, then how many hops it may still
  1112   (452)      % take. A SEPARATE kind rather than extra fields on kTrkSaid so a server
  1113   (453)      % that has not been upgraded keeps handling its direct trunks unchanged -
  1114   (454)      % these machines are upgraded one at a time.
  1115   (455)      % (imported at the top of the module - see the IMPORT block)
  1116   (456)      % How far a line may travel from the machine it was typed on. Three is
  1117   (457)      % ample for D100/D102/D103 and bounds the damage if a future mesh ever
  1118   (458)      % loops: the count is what makes the loop terminate, not the topology.
  1119   (459)      % (imported at the top of the module - see the IMPORT block)
  1120   (460)      % A relayed line that also carries the number its ORIGIN gave it. Same
  1121   (461)      % shape as kTrkRly with two more bytes after the hop count.
  1122   (462)      %
  1123   (463)      % THE ID MUST COME FROM THE ORIGIN. It cannot be handed out by a relay: a
  1124   (464)      % machine with two peers sends one line to both, each would stamp its own
  1125   (465)      % number, and a machine further out would see two names for one line and
  1126   (466)      % show it twice - which is the very thing this exists to stop.
  1127   (467)      %
  1128   (468)      % A SEPARATE kind rather than a longer kTrkRly header, for the same
  1129   (469)      % reason kTrkRly is separate from kTrkSaid: a server that has not been
  1130   (470)      % upgraded would read the two extra bytes as a name length and a name and
  1131   (471)      % show its users rubbish. A kind it does not know it just ignores.
  1132   (472)      % (imported at the top of the module - see the IMPORT block)
  1133   (473)  
  1134   (474)      % A DIRECT MESSAGE CROSSING A TRUNK. Same six-byte header as kTrkRlId -
  1135   (475)      % origin system, hops remaining, line id - so it is relayed and de-duplicated
  1136   (476)      % by the machinery that already exists rather than by a second mechanism.
  1137   (477)      %
  1138   (478)      % The difference is what the text holds: kTrkRlId packs ROOM/message, this
  1139   (479)      % packs TARGET/message, which leaves the name field free for the SENDER -
  1140   (480)      % the one thing the far end has to display.
  1141   (481)      % (imported at the top of the module - see the IMPORT block)
  1142   (482)      % How many recent lines we remember in order to spot a repeat. A second
  1143   (483)      % copy arrives within a hop or two of the first, so a short window is
  1144   (484)      % enough, and a FIXED one cannot be made to grow by a peer sending us
  1145   (485)      % traffic.
  1146   (486)      INTEGER : maxSeen     := 64
  1147   (487)  
  1148   (488)      % Set by an AdminStop. Checked at the bottom of the loop rather than acted
  1149   (489)      % on where it arrives, so the reply path and the reaping finish first - a
  1150   (490)      % stop that abandons a half-sent message is not a clean stop.
  1151   (491)      BOOLEAN : stopWanted := FALSE
  1152   (492)  
  1153   (493)      % THERE IS NO ELEVENTH KIND, and the reason is worth keeping.
  1154   (494)      %
  1155   (495)      % A kHello was invented here on 2026-08-18 to answer the connect on its own,
  1156   (496)      % on the belief that a connection port is handed "4 bytes with byte 0 = 0"
  1157   (497)      % and that the joiner's nickname could only follow as a second, ordinary
  1158   (498)      % message. That belief was wrong, and it was wrong because this program was
  1159   (499)      % reading the WRONG BYTES: the connect arrives with the XSLET letter header
  1160   (500)      % still in front of it, and byte 0 of that header is the serial number.
  1161   (501)      %
  1162   (502)      % The nickname was in the very first arrival all along. See the header skip
  1163   (503)      % in the receive loop for the layout and the manual reference. The join is
  1164   (504)      % ONE step, exactly as the Programmer Guide describes it: the letter carries
  1165   (505)      % the user data, the server answers it, and "thereby gives away its own
  1166   (506)      % magic number" - the welcome IS the answer, so no extra kind is needed.
  1167   (507)  
  1168   (508)      % XFWTF is the BIT POSITION (15). The flags word is 2 to that power - the
  1169   (509)      % sample programs in Appendix G both write "2**XFWTF =: FLAGS". Passing 15
  1170   (510)      % itself would set bits 0 to 3, four unrelated options, and the wait would
  1171   (511)      % not happen at all.
  1172   (512)      % XFWTF COMES FROM XMP-B02:DEFS - do NOT declare it here. Declaring our own
  1173   (513)      % drew IDENTIFIER ALREADY SPECIFIED/DECLARED "XFWTF", and the compiler then
  1174   (514)      % fell over with ASSERT VIOLATION AT 136747B and took the batch job with it.
  1175   (515)      % A redeclaration is not a warning you can carry on past in this compiler.
  1176   (516)      % ZERO, and it stays zero - see the PROGRAM body for the measurement. Flags
  1177   (517)      % zero is XMSG's own no-wait: XFRCV returns at once whether or not a message
  1178   (518)      % was there, which is the only way one loop can poll TWO ports.
  1179   (519)      INTEGER : waitFlags := 0
  1180   (520)  
  1181   (521)      % 2**XFSEC, computed at start. SECURE, and the reason is a measurement.
  1182   (522)      %
  1183   (523)      % These sends used to carry flags ZERO, and the guide is explicit about what
  1184   (524)      % that costs: "Non-secure messages are discarded and released by XMSG if they
  1185   (525)      % cannot be delivered." So a member whose terminal died was written to for
  1186   (526)      % ever, in silence.
  1187   (527)      %
  1188   (528)      % THE OBVIOUS ALTERNATIVE WAS TRIED FIRST AND IS REFUTED. XMPSEND is handed a
  1189   (529)      % magic number, and a magic carries a generation, so it looked as though XMSG
  1190   (530)      % would refuse one naming a closed port on the spot - XMXEIMA, "Invalid magic
  1191   (531)      % number". MEASURED 2026-08-18 on D100: two clients in the room, one killed
  1192   (532)      % with ESC ("USER BREAK AT 17202B"), the other spoke. The broadcast to the
  1193   (533)      % dead port returned XMOK. Not one status printed, the seat stayed spent, and
  1194   (534)      % LIST-NAMES held at 14. XMPSEND DOES NOT VALIDATE THE DESTINATION.
  1195   (535)      %
  1196   (536)      % So the return has to come back as a MESSAGE, which is what XFSEC buys:
  1197   (537)      % "The message will be returned to the sending port if it cannot be
  1198   (538)      % delivered, or if the receiving port is closed (e.g., if the receiving task
  1199   (539)      % terminates)". It arrives as msgType XMTRE and is handled in the receive
  1200   (540)      % loop.
  1201   (541)      %
  1202   (542)      % MEASURED WITH THE FLAG SET, same two clients, same kill: the bounce came
  1203   (543)      % back carrying reason 16915 - which is XMXEIMA, the very code the refuted
  1204   (544)      % attempt was watching for. It was never the send's status; it is the reason
  1205   (545)      % on the return. CHAT-LOBBY went 16 free, 14 with both joined, back to 15
  1206   (546)      % once the dead one was reaped.
  1207   (547)      INTEGER : sendFlags := 0
  1208   (548)  
  1209   (549)      % ----- the room ---------------------------------------------------------
  1210   (550)      % maxSeats is what XMPOPCN is given, so XROUT turns the SEVENTEENTH joiner
  1211   (551)      % away before this program sees them. The array bounds and that argument are
  1212   (552)      % the same number on purpose.
  1213   (553)      %
  1214   (554)      % THE CLIENT DOES NOT KNOW THIS NUMBER AND MUST NOT. Neither CHAT.PLNC nor
  1215   (555)      % ChatClient.cs mentions it anywhere - XROUT does the admission itself, before
  1216   (556)      % this program is woken, so a client that is turned away simply gets a refusal
  1217   (557)      % it has to handle in any case. The room's size is the room's business, and
  1218   (558)      % raising it is this file alone. The C# ChatRoom has no seat limit at all.
  1219   (559)      %
  1220   (560)      % Raised from 8 to 16 on 2026-08-18. Nothing else has to move with it: the
  1221   (561)      % four arrays below and every FOR loop are written in terms of maxSeats, and
  1222   (562)      % the only literal bounds are the array declarations, which are next to it.
  1223   (563)      INTEGER : maxSeats := 16
  1224   (564)      INTEGER : nameLen  := 16
  1225   (565)  
  1226   (566)      INTEGER4 ARRAY : memberMagic(1:16)
  1227   (567)  
  1228   (568)      % A two-dimensional BYTES array: sixteen names of sixteen bytes. Legal PLANC -
  1229   (569)      % the reference gives BYTES ARRAY : b1(1:2,0:3) directly.
  1230   (570)      %
  1231   (571)      % Note that memberName(slot) with the LAST subscript omitted refers to the
  1232   (572)      % WHOLE string, which is tempting for copying a name in one statement. It is
  1233   (573)      % NOT used here, because a name is variable length and a whole-row copy would
  1234   (574)      % carry the sixteen bytes including whatever follows the name. The explicit
  1235   (575)      % loops are longer and right.
  1236   (576)      % SIXTEEN BYTES PER NAME, and the number is named because the wire decides
  1237   (577)      % how many bytes arrive. A nickname length is one byte, so a peer can ask for
  1238   (578)      % up to 255 - and PLANC checks no array bound. Copying an unchecked length in
  1239   (579)      % here writes straight through the other seven members' names and out the far
  1240   (580)      % side of the array. See the guard at the top of handleMessage.
  1241   (581)      INTEGER        : maxNameLen := 16
  1242   (582)  
  1243   (583)      % LAYOUT OF A LISTING, and both of these are named rather than typed.
  1244   (584)      %
  1245   (585)      % idWide is the column the machine NUMBER sits in - six, which holds the
  1246   (586)      % five digits of 19999 and a space after it. The NAME column is not here:
  1247   (587)      % it is maxNameLen above, asked of the buffer the names live in, so the two
  1248   (588)      % cannot drift apart.
  1249   (589)      INTEGER        : idWide := 6
  1250   (590)  
  1251   (591)      % THE LINE BREAK INSIDE A REPLY. A listing travels as ONE message and
  1252   (592)      % CHAT-MON prints it byte by byte, so a break between elements has to be a
  1253   (593)      % byte the printer knows: LF, which showAnswer turns into a CRLF. 10 is
  1254   (594)      % written once, here, instead of appearing as a bare number in the middle
  1255   (595)      % of a builder.
  1256   (596)      INTEGER        : lineBreak := 10
  1257   (597)      % NAMES ARE UNIQUE IN THEIR FIRST TEN CHARACTERS, and that is not a style
  1258   (598)      % note - it is what the compiler enforces. memberName and memberNameLen both
  1259   (599)      % start MEMBERNAME, so the second silently became a redeclaration of the
  1260   (600)      % first: IDENTIFIER ALREADY SPECIFIED/DECLARED "MEMBERNAME", and then every
  1261   (601)      % memberName(slot, i) drew MORE SUBSCRIPTS THAN IN THE ARRAY DECLARATION,
  1262   (602)      % because the name now referred to the one-dimensional array. Four errors,
  1263   (603)      % one cause, and none of them mention the length. The listing gives it away:
  1264   (604)      % it prints the TRUNCATED names - BUILDRENAM, BUILDFROMS, REASONNICK.
  1265   (605)      BYTES ARRAY    : memberName(1:16, 1:16)
  1266   (606)      INTEGER ARRAY  : memberLen(1:16)
  1267   (607)      INTEGER ARRAY  : memberUsed(1:16)
  1268   (608)  
  1269   (609)      % Seats whose member has VANISHED - the terminal was killed, the client was
  1270   (610)      % aborted with ESC, the task died. Marked by sendTo when a send comes back
  1271   (611)      % saying the port is gone, and cleared by reapDead.
  1272   (612)      %
  1273   (613)      % A MARK IS NOT AN EVICTION, and the separation is the whole point of this
  1274   (614)      % array rather than a nicety. sendTo is called from inside broadcast's loop,
  1275   (615)      % and evicting there would have to announce the departure - which means
  1276   (616)      % building a message into outBuf while broadcast is still part way through
  1277   (617)      % sending the outBuf it built. One shared buffer, so the message everybody
  1278   (618)      % else is waiting for would be overwritten mid-broadcast and the room would
  1279   (619)      % receive the departure notice instead of what was said. Marking is the only
  1280   (620)      % thing safe to do at that depth; the acting happens back at the top.
  1281   (621)      INTEGER ARRAY  : memberDead(1:16)
  1282   (622)  
  1283   (623)      % ---- WHICH ROOM EACH MEMBER IS IN ------------------------------------
  1284   (624)      %
  1285   (625)      % The room used to be a PORT NAME - the client built "CHAT-" plus the room
  1286   (626)      % and addressed that - so the server never had to know: whoever reached
  1287   (627)      % this port was, by definition, in this room. One port now, so the room is
  1288   (628)      % a field in the Join and the server has to remember it per member.
  1289   (629)      %
  1290   (630)      % Sixteen characters, same as a nickname. A room is a name a person types.
  1291   (631)      BYTES ARRAY    : mbrRoom(1:16, 1:16)
  1292   (632)      INTEGER ARRAY  : lenMbrRoom(1:16)
  1293   (633)  
  1294   (634)      % Where a member goes when the Join names no room - see copyRoomIn.
  1295   (635)      BYTES          : homeRoom := 'LOBBY'
  1296   (636)      INTEGER        : lenHomeRoom := 5
  1297   (637)  
  1298   (638)      % ---- WHICH BUILD EACH MEMBER IS RUNNING -------------------------------
  1299   (639)      %
  1300   (640)      % Added 2026-08-31 chasing a bug that turned out NOT to be a version
  1301   (641)      % mismatch - but there was no cheap way to see that without reading
  1302   (642)      % FILE-STATISTICS on the machine by hand. A client now rides its own
  1303   (643)      % build stamp in on the Join, after the room name and a '|'; an older
  1304   (644)      % client that has never heard of this sends no separator and the whole
  1305   (645)      % text is read as the room, exactly as before - see findJoinSep.
  1306   (646)      %
  1307   (647)      % EIGHT characters, same as clientVersion in CHAT.PLNC. The two must
  1308   (648)      % agree or a version this long gets clipped and LIST-MEMBER lies.
  1309   (649)      INTEGER : maxVerLen := 8
  1310   (650)      BYTES ARRAY    : memberVer(1:16, 1:8)
  1311   (651)      INTEGER ARRAY  : memberVerLen(1:16)
  1312   (652)  
  1313   (653)      % This server's OWN build stamp, printed by STATUS - so a stale CLIENT
  1314   (654)      % and a fresh SERVER (or the other way round) show up side by side in one
  1315   (655)      % command instead of two FILE-STATISTICS calls compared by eye.
  1316   (656)      BYTES : serverVersion := 'S31-0854'
  1317   (657)      INTEGER : lenServerVer := 8
  1318   (658)  
  1319   (659)      % Same byte as CHAT.PLNC's verSepByte - the two must agree or a version
  1320   (660)      % never parses out of the room field at all.
  1321   (661)      BYTES : verSepByte := '|'
  1322   (662)  
  1323   (663)      % ---- ROOM TOPICS -----------------------------------------------------
  1324   (664)      %
  1325   (665)      % A SEPARATE TABLE, NOT A COLUMN IN THE MEMBER TABLE, and the reason is
  1326   (666)      % that a topic OUTLIVES the people who set it. Hanging it off a seat would
  1327   (667)      % throw it away the moment the last person left, which is exactly when a
  1328   (668)      % topic is doing its job: telling the next person what the room is for.
  1329   (669)      %
  1330   (670)      % Keyed by ROOM NAME, because that is all a room is here - there is no room
  1331   (671)      % id and no room record. An entry is made the first time somebody sets a
  1332   (672)      % topic, and once made it stays for the life of the server.
  1333   (673)      %
  1334   (674)      % EIGHT rooms, not sixteen. Sixteen seats could in principle be sixteen
  1335   (675)      % rooms of one person each, so this table CAN fill up - and when it does,
  1336   (676)      % setTopic refuses in the open rather than silently dropping the topic. A
  1337   (677)      % refusal a user can read beats a feature that quietly does nothing.
  1338   (678)      INTEGER        : maxTopics := 8
  1339   (679)      BYTES ARRAY    : topicRoom(1:8, 1:16)
  1340   (680)      INTEGER ARRAY  : topicRmLen(1:8)
  1341   (681)  
  1342   (682)      % 64 characters. The whole message must fit outBuf's 250-byte text field
  1343   (683)      % alongside the room name, and a topic is a headline, not an essay.
  1344   (684)      INTEGER        : maxTopicLen := 64
  1345   (685)      BYTES ARRAY    : topicText(1:8, 1:64)
  1346   (686)      INTEGER ARRAY  : topicTextLen(1:8)
  1347   (687)  
  1348   (688)      % ----- the per-room history ring ---------------------------------------
  1349   (689)      %
  1350   (690)      % Ronny, 2026-08-20: somebody joining should see what was just said instead
  1351   (691)      % of an empty screen, and it should survive the server being stopped.
  1352   (692)      %
  1353   (693)      % IT SHARES THE TOPIC TABLE'S SLOTS, AND THAT IS THE WHOLE STRUCTURE. The
  1354   (694)      % design note used to say this needed a room table first, because rooms are
  1355   (695)      % DERIVED from the seats and there is no per-room anything. There already
  1356   (696)      % is one: topicRoom/topicRmLen with findTopic and claimTopic is a room
  1357   (697)      % table under another name. Using the same index for history means the two
  1358   (698)      % can never disagree about what a room is - and a room that has neither a
  1359   (699)      % topic nor a history needs no entry at all.
  1360   (700)      %
  1361   (701)      % ONE 512-BYTE BLOCK PER MESSAGE, block = id MOD histSize. An append is a
  1362   (702)      % single MN120 - no read-modify-write, no compaction, and the file's size is
  1363   (703)      % fixed the day the room is created. See the note beside the imports.
  1364   (704)      %
  1365   (705)      % THE FILE IS NAMED FROM THE INDEX, NEVER THE ROOM NAME: CHATH1:DATA up to
  1366   (706)      % CHATH8:DATA. Room names are chosen by users and a SINTRAN file name is
  1367   (707)      % short, case-folded and must be unique - deriving one from arbitrary text
  1368   (708)      % invites collisions and illegal names with no good failure mode. The room
  1369   (709)      % NAME is written into block 0 so the file is still self-describing.
  1370   (710)      INTEGER        : maxHistRooms := 8
  1371   (711)  
  1372   (712)      % The next id to be written, per room. IT ONLY EVER GOES UP: it is what
  1373   (713)      % makes "block = id MOD size" a ring, and it is the same number the unread
  1374   (714)      % count will need - the server reports the room's latest, the client
  1375   (715)      % subtracts its own anchor. One number doing two jobs, so it has to be right.
  1376   (716)      INTEGER ARRAY  : histNext(1:8)
  1377   (717)  
  1378   (718)      % How many messages this room keeps. Per room, not one constant for the
  1379   (719)      % whole server, because that is what was asked for. 50 until CHAT-MON can
  1380   (720)      % set it.
  1381   (721)      % 200, Ronny 2026-08-23. It is also maxHistSize, so the default IS the
  1382   (722)      % ceiling and INITIALIZE can only ever lower a room - which is the right way
  1383   (723)      % round: the limit exists to stop a typo asking for megabytes, not to stop
  1384   (724)      % anybody keeping what they meant to keep.
  1385   (725)      %
  1386   (726)      % 200 messages is 200 blocks is 100KB a room, and eight rooms is 800KB -
  1387   (727)      % the same figure the no-total decision was taken against, so the bound has
  1388   (728)      % not moved. It is now the ordinary case rather than the worst one.
  1389   (729)      INTEGER        : histDefault := 200
  1390   (730)  
  1391   (731)      % AND A CEILING, because INITIALIZE takes a number from an operator and a
  1392   (732)      % ring of 30000 blocks is 15 megabytes of disk asked for by a typo. 200 is
  1393   (733)      % well past anything a room needs to show a new arrival and still only
  1394   (734)      % 100KB a room.
  1395   (735)      INTEGER        : maxHistSize := 200
  1396   (736)      INTEGER ARRAY  : histSize(1:8)
  1397   (737)  
  1398   (738)      % CreateFile's page count. INTEGER4 because that is what 221B's parameter
  1399   (739)      % is - startAddr beside it is INTEGER4 for the same reason, and passing a
  1400   (740)      % plain INTEGER to a call that wants a double word is the kind of mistake
  1401   (741)      % that compiles and then writes somewhere unintended.
  1402   (742)      INTEGER4       : histPages := 0
  1403   (743)  
  1404   (744)      % The open file, or 0 for "not opened yet". Opened once and left open: a
  1405   (745)      % room is written to on every message, and opening per message would put a
  1406   (746)      % file open and close in the path of every line anybody types.
  1407   (747)      INTEGER ARRAY  : histDev(1:8)
  1408   (748)  
  1409   (749)      % One block, as WORDS, because that is what MN117 and MN120 move.
  1410   (750)      % 256 words = 512 bytes = one SINTRAN block.
  1411   (751)      INTEGER        : histWords := 256
  1412   (752)      INTEGER ARRAY  : histBlock(0:255)
  1413   (753)  
  1414   (754)      % ---- WHEN A LINE WAS SAID, AND HOW AN OLD FILE STILL READS -------
  1415   (755)      %
  1416   (756)      % A replayed line used to be stamped with the moment it was REPLAYED,
  1417   (757)      % so a whole backlog shared one time and could not say what happened
  1418   (758)      % when. The block had nowhere to put the real one: word 0 is the id,
  1419   (759)      % 1 and 2 are the two lengths, and the name started at 3.
  1420   (760)      %
  1421   (761)      % THE OLD FILES ON THE THREE MACHINES MUST STILL REPLAY, so the new
  1422   (762)      % layout is marked rather than assumed. Word 3 is now a MARKER:
  1423   (763)      %
  1424   (764)      %   histBlock(3) = histStamp  ->  words 4..9 are the ND calendar and
  1425   (765)      %                                 the name starts at 10
  1426   (766)      %   anything else             ->  an OLD block: no time, name at 3
  1427   (767)      %
  1428   (768)      % IT IS SAFE BECAUSE WORD 3 USED TO HOLD THE FIRST CHARACTER OF A
  1429   (769)      % NAME. Names are ASCII, so that word was always small and positive;
  1430   (770)      % 27127 cannot be a character and so cannot be mistaken for one. No
  1431   (771)      % migration, no history thrown away, and a machine still running the
  1432   (772)      % old build writes blocks this one reads correctly as timeless.
  1433   (773)      INTEGER        : histStamp := 27127
  1434   (774)      INTEGER        : histHdrNew := 10     % name starts here when stamped
  1435   (775)      INTEGER        : histHdrOld := 3      % ...and here when it is not
  1436   (776)  
  1437   (777)      % The ND calendar as MN113 fills it - see the IMPORT at the top.
  1438   (778)      INTEGER ARRAY  : histCal(0:6)
  1439   (779)  
  1440   (780)      % The file name being built.
  1441   (781)      %
  1442   (782)      % IT NAMES THE USER, AND THAT IS NOT DECORATION: "(SYSTEM)CHATH1".
  1443   (783)      %
  1444   (784)      % MEASURED ON D100, 2026-08-23. With a bare "CHATH1" the server created
  1445   (785)      % nothing and opened nothing - and after (SYSTEM)CHATH1:DATA was created BY
  1446   (786)      % HAND from the terminal, 50 pages, FILE-STATISTICS still said
  1447   (787)      % "OPENED 0 TIMES". The program was looking somewhere that is not SYSTEM.
  1448   (788)      %
  1449   (789)      % Which somewhere is not settled: an RT program does not run as the user
  1450   (790)      % who loaded it, and "CREATE-FILE (RT)CHATH1:DATA,50" typed as SYSTEM is
  1451   (791)      % refused with NOT DIRECTORY ACCESS, so that guess cannot even be tested
  1452   (792)      % from a terminal.
  1453   (793)      %
  1454   (794)      % NAMING THE USER REMOVES THE QUESTION rather than answering it. A server
  1455   (795)      % that keeps its files somewhere definite is better than one that depends
  1456   (796)      % on whatever user SINTRAN decides an RT program is - and the files then
  1457   (797)      % sit beside CHATSV:PROG where anybody looking for them would look.
  1458   (798)      %
  1459   (799)      % 22 bytes: "(SYSTEM)CHATH1" is 14, and the quoted form that means CREATE
  1460   (800)      % is 16. Room to spare rather than a count that has to be re-derived if the
  1461   (801)      % stem ever changes.
  1462   (802)      BYTES          : histName(0:21)
  1463   (803)      BYTES          : histUser := '(SYSTEM)'
  1464   (804)      INTEGER        : lenHistUser := 8
  1465   (805)      BYTES          : histStem := 'CHATH'
  1466   (806)      BYTES          : histType := 'DATA'
  1467   (807)  
  1468   (808)      % Is there anything to reap? Kept so the common case - nothing died - costs
  1469   (809)      % one compare per message instead of a walk of the whole room.
  1470   (810)      INTEGER        : deadFound := 0
  1471   (811)  
  1472   (812)      % ----- knowing when to give up ------------------------------------------
  1473   (813)      % How many receives in a ROW have failed. Cleared by any good one, so this
  1474   (814)      % counts a run of trouble rather than trouble over a lifetime.
  1475   (815)      INTEGER        : badRuns := 0
  1476   (816)  
  1477   (817)      % Twenty in a row is not a bad moment, it is a broken machine. Small enough
  1478   (818)      % that a spin is caught in under a second, large enough that a burst of
  1479   (819)      % something transient is ridden out rather than treated as fatal.
  1480   (820)      INTEGER        : maxBadRuns := 20
  1481   (821)  
  1482   (822)      % Print at most this many of them. The fault that made all this necessary
  1483   (823)      % was ONE message repeated as fast as the terminal could take it, and a
  1484   (824)      % diagnostic with no limit buries the line that says what happened.
  1485   (825)      INTEGER        : maxNoisy := 5
  1486   (826)  
  1487   (827)      INTEGER ARRAY : stack(0:1000)
  1488   (828)  
  1489   (829)      % SIZE OF inBuf, named because the read must clamp against it. XMSG reports
  1490   (830)      % the SENDER'S message size; nothing stops that being larger than this
  1491   (831)      % array, and PLANC checks no bound.
  1492   (832)      INTEGER : inBufSize := 256
  1493   (833)      BYTES : inBuf(0:255)
  1494   (834)      % A MEMBER'S NAME, FLAT. memberName is two-dimensional and the library
  1495   (835)      % takes BYTES, so the name is copied here on the way out - see
  1496   (836)      % buildFromSlot for why a row subarray is avoided.
  1497   (837)      BYTES : nameFlat(0:15)
  1498   (838)  
  1499   (839)      BYTES : outBuf(0:255)
  1500   (840)  
  1501   (841)      % ONE SPACE, AS A BYTE. buildWho puts a separator between names, and
  1502   (842)      % "' ' =: outBuf(at)" does not compile: 'x' is a STRING and an element of a
  1503   (843)      % BYTES array is a BYTE. Held as a one-element BYTES so the copy is
  1504   (844)      % byte-to-byte.
  1505   (845)      BYTES : spaceByte := ' '
  1506   (846)  
  1507   (847)      % Same trick, for the room counts /list writes - "LOBBY(2)". Brackets are
  1508   (848)      % held as one-element BYTES for exactly the reason spaceByte is.
  1509   (849)      BYTES : openParen  := '('
  1510   (850)      BYTES : closeParen := ')'
  1511   (851)  
  1512   (852)      % '@', for qualifying a remote member - "ANNA@D102". Two machines can each
  1513   (853)      % have an ANNA, and a bare name would make them look like one person.
  1514   (854)      BYTES : atByte     := '@'
  1515   (855)  
  1516   (856)      % '0' as a NUMBER, because a digit is computed rather than copied: the
  1517   (857)      % count is arithmetic, so the character is digitZero + the value. Held as
  1518   (858)      % an INTEGER and not a BYTES for that reason - it is added to, not copied.
  1519   (859)      INTEGER : digitZero := 48
  1520   (860)  
  1521   (861)      % Same reason as spaceByte: a string literal cannot be stored into a BYTES
  1522   (862)      % element, so every literal character this program writes into a buffer
  1523   (863)      % lives in a one-element BYTES and is copied byte to byte.
  1524   (864)      % A LOCAL CANNOT CARRY AN INITIALISER. "BYTES : oneByte := ' '" inside
  1525   (865)      % showName drew *** ERROR - INITIAL VALUE ILLEGAL HERE, while the identical
  1526   (866)      % line at MODULE level compiles - which is why the same declaration works in
  1527   (867)      % CHATMON and failed here. Module level it is, beside the others.
  1528   (868)      BYTES : oneByte   := ' '
  1529   (869)      BYTES : slashByte := '/'
  1530   (870)      BYTES : zeroByte  := '0'
  1531   (871)  
  1532   (872)      % '!', between a MACHINE and a PERSON in a direct message - D102!RONNY.
  1533   (873)      %
  1534   (874)      % NOT '@', and the choice is deliberate rather than a matter of taste. '@'
  1535   (875)      % is the client's short command prefix, so @RONNY@D100 would need a parser
  1536   (876)      % that counts at-signs and decides which one it meant. 'machine!alias'
  1537   (877)      % reads left to right as route-then-person and has precedent in the UUCP
  1538   (878)      % addressing of the same era. The byte is pinned as 0x21 by the C# test
  1539   (879)      % AQualifiedTargetKeepsItsMachineSeparator, so the two ends cannot drift.
  1540   (880)      %
  1541   (881)      % Note that '@' still qualifies a name for DISPLAY - "ANNA@D102" in /who.
  1542   (882)      % Display and addressing are different jobs: one is read by a person, the
  1543   (883)      % other is typed by one.
  1544   (884)      BYTES : bangByte  := '!'
  1545   (885)  
  1546   (886)      % ':', for the all-rooms /who - "LOBBY: TESTER OLAV". Same reason as every
  1547   (887)      % other single character in this list: a string literal cannot be stored
  1548   (888)      % into a BYTES element, so it lives in a one-element BYTES and is copied.
  1549   (889)      BYTES : colonByte := ':'
  1550   (890)  
  1551   (891)      % '"', and it is not decoration: quoting a file name is how you say CREATE
  1552   (892)      % to MON50, which would otherwise require the file to exist already. See
  1553   (893)      % histOpen, where the plain name is tried first and the quoted one only if
  1554   (894)      % that fails.
  1555   (895)      BYTES : quoteByte := '"'
  1556   (896)  
  1557   (897)      % The fixed part of the status line. Held as bytes for the same reason.
  1558   (898)      BYTES : statusWord := 'SEATS '
  1559   (899)  
  1560   (900)      INTEGER  : myPort
  1561   (901)      INTEGER  : msgType
  1562   (902)  
  1563   (903)      % ---- COUNTED, NOT PRINTED ---------------------------------------------
  1564   (904)      % These three used to print a line each, every time, straight to terminal 1.
  1565   (905)      % Two of them are EXPECTED events, so the terminal filled with them and the
  1566   (906)      % rare interesting line was buried:
  1567   (907)      %
  1568   (908)      %   nEmptyLet  a routed letter with no payload. XROUT's ANSWER to a seat
  1569   (909)      %              return arrives on our own port looking exactly like this, so
  1570   (910)      %              there is one per seat returned - see the note by the drop.
  1571   (911)      %   nBounced   a message that came home because nobody was there. One per
  1572   (912)      %              dead client, and clients die in bursts when a terminal goes.
  1573   (913)      %   nRefused   a join we turned away, whatever the reason.
  1574   (914)      %
  1575   (915)      % A count answers the question the flood was trying to answer - "is this
  1576   (916)      % happening more than it should" - and STATUS shows all three on demand.
  1577   (917)      %
  1578   (918)      % WHAT A RISING nEmptyLet ACTUALLY MEANS - measured 2026-08-24 from a hub
  1579   (919)      % capture, and it is NOT a fault. The trunk exchanges a burst of about 24
  1580   (920)      % frames every 2 to 3 minutes when nobody is typing at all: kTrkHello, then
  1581   (921)      % kTrkWho, then kTrkMbrs, both directions. Every letter we send that way
  1582   (922)      % draws an XROUT answer back onto our own port with no payload, so the count
  1583   (923)      % tracks the TRUNK's idle cycle, not the clients. 712 on D100 after an
  1584   (924)      % afternoon with one idle client is normal.
  1585   (925)      %
  1586   (926)      % So read it as a liveness number: climbing steadily means the trunk is up.
  1587   (927)      % FLAT while a trunk is supposed to be up is the interesting case.
  1588   (928)      INTEGER  : nEmptyLet
  1589   (929)      INTEGER  : nBounced
  1590   (930)      INTEGER  : nRefused
  1591   (931)      % How many lines this machine has passed ON to a further peer. A machine in
  1592   (932)      % the MIDDLE of a chain should show this climbing; an end machine should
  1593   (933)      % show it flat at zero, and a non-zero count on an end machine means the
  1594   (934)      % topology is not what somebody thinks it is.
  1595   (935)      INTEGER  : nRelayed
  1596   (936)  
  1597   (937)      % LINES A LOCAL SPEAKER SENT ONWARD TO A PEER, and how many of those sends
  1598   (938)      % were REFUSED.
  1599   (939)      %
  1600   (940)      % These did not exist, and their absence cost a whole evening. nRelayed
  1601   (941)      % counts only lines arriving from a trunk and passed on - so when a locally
  1602   (942)      % typed line failed to cross, `relay` sat still and looked like proof that
  1603   (943)      % nothing was forwarded. It was proof of nothing at all: the two paths are
  1604   (944)      % different routines and only one of them had a counter.
  1605   (945)      %
  1606   (946)      % nFwdBad is the more valuable of the pair. forwardSaid stored sendToName's
  1607   (947)      % status into a variable and never looked at it, so a refused letter was
  1608   (948)      % perfectly silent - the one failure shape that cannot be seen from either
  1609   (949)      % end.
  1610   (950)      INTEGER  : nForwarded
  1611   (951)      INTEGER  : nFwdBad
  1612   (952)  
  1613   (953)      % How many repeats we recognised and threw away. On a CHAIN this stays at
  1614   (954)      % ZERO for ever - there is only one path between any two machines, so no
  1615   (955)      % line can arrive twice. It only starts moving once somebody wires a
  1616   (956)      % second path, and that is exactly when you want to see it moving.
  1617   (957)      INTEGER  : nDupes
  1618   (958)  
  1619   (959)      % The number we put on the next line typed HERE. Only this machine ever
  1620   (960)      % sets it; a relay passes an id on untouched.
  1621   (961)      %
  1622   (962)      % It wraps at 65536 and that is harmless: a number can only be mistaken
  1623   (963)      % for a live one if we sent 65536 lines while the first was still inside
  1624   (964)      % a 64-entry window, which cannot happen.
  1625   (965)      INTEGER  : myLineId
  1626   (966)  
  1627   (967)      % The lines we have already seen, as two parallel rows - the machine it
  1628   (968)      % came from and the number that machine gave it. BOTH are needed: every
  1629   (969)      % machine numbers from its own counter, so id 1 exists on all of them at
  1630   (970)      % once, and matching on the id alone would silently swallow other
  1631   (971)      % machines' lines.
  1632   (972)      INTEGER ARRAY  : seenSys(1:64)
  1633   (973)      INTEGER ARRAY  : seenId(1:64)
  1634   (974)      % Where the next one goes, 1..maxSeen, and how many rows are real.
  1635   (975)      % seenUsed matters because a fresh table is all zeros, and (0,0) is a pair
  1636   (976)      % a real line could otherwise be mistaken for.
  1637   (977)      INTEGER  : seenAt
  1638   (978)      INTEGER  : seenUsed
  1639   (979)  
  1640   (980)      % ---- THE COMMAND PORT, AND WHY THE LOOP HAD TO CHANGE ------------------
  1641   (981)      %
  1642   (982)      % XFRCV RECEIVES ON ONE NAMED PORT. There is no receive-on-any-port form -
  1643   (983)      % ND-60.134.2 section 4.3.2.10. This program used to block on myPort with
  1644   (984)      % XFWTF, and a server that keeps doing that NEVER SEES a message on a
  1645   (985)      % second port. Not failing, not logging: sitting in the lobby wait while
  1646   (986)      % CHATMON waits for an answer that cannot come.
  1647   (987)      %
  1648   (988)      % The manual's answer is XFWAK: a non-blocking receive arms a wake-up
  1649   (989)      % instead, and "this 'wake up' option can be enabled on more than one port
  1650   (990)      % at a time". MON 100B is StartRTProgram, so that wake-up RT-STARTS this
  1651   (991)      % program - which means there is no wait to choose at all. Drain both
  1652   (992)      % ports, and when both are empty, TERMINATE. A transmission to either one
  1653   (993)      % starts us again.
  1654   (994)      %
  1655   (995)      % AND THE TRAP FROM THE SAME PARAGRAPH: "when the 'wake up' is done, the
  1656   (996)      % message is not received, and so the receive must be repeated." The
  1657   (997)      % wake-up is a DOORBELL, NOT A DELIVERY.
  1658   (998)      INTEGER  : adminPort
  1659   (999)  
  1660  (1000)      % CHAT-ADMIN is a NORMAL named port (XMPOPNM), NOT a connection port.
  1661  (1001)      % CHAT-LOBBY is a connection port and every arrival there spends one of the
  1662  (1002)      % free connections - a seat a human then cannot have. An operator asking
  1663  (1003)      % for STATUS must not cost the room a seat, and must still get in when the
  1664  (1004)      % room is full, which is exactly when they would want to ask.
  1665  (1005)      BYTES    : admName := 'CHAT-ADMIN'
  1666  (1006)      INTEGER  : lenAdmName := 10
  1667  (1007)  
  1668  (1008)      % ---- THE TRUNK PORT, AND WHY IT IS A THIRD PORT --------------------------
  1669  (1009)      %
  1670  (1010)      % Server-to-server traffic. Also XMPOPNM, and for the SAME reason the command
  1671  (1011)      % port is: a trunk must cost the room NO SEATS. A peer that is switched off
  1672  (1012)      % gets a HELLO every so often for as long as it is away, and if that spent a
  1673  (1013)      % free connection each time the room would fill up with machines that are not
  1674  (1014)      % there. The design calls this constraint 1: the trunk must never point at
  1675  (1015)      % the room port.
  1676  (1016)      %
  1677  (1017)      % A TRUNK IS NOT A CONNECTION. XMSG named ports are message passing - there is
  1678  (1018)      % no session to open, nothing to hold, and nothing that drops. A trunk is a
  1679  (1019)      % BELIEF that a peer is reachable, held as soft state and refreshed. Neither
  1680  (1020)      % side is the client: each is a server when a letter arrives and a client when
  1681  (1021)      % it sends one.
  1682  (1022)      BYTES    : trkName := 'CHAT-TRUNK'
  1683  (1023)      INTEGER  : lenTrkName := 10
  1684  (1024)      INTEGER  : trunkPort
  1685  (1025)  
  1686  (1026)      % The XSLET letter header XMPBLET builds when this server ORIGINATES a
  1687  (1027)      % message to another machine. Replies do not need it - they go straight to
  1688  (1028)      % the magic the message arrived with - so this exists only for trunks.
  1689  (1029)      BYTES    : letterBuf(0:63)
  1690  (1030)  
  1691  (1031)      % The peer's SYSTEM NAME, built at runtime from its number: 'D' and the
  1692  (1032)      % decimal digits. XMPBLET's system parameter is a NAME as BYTES, never a
  1693  (1033)      % number - see the long note on sendToName for the three compile cycles that
  1694  (1034)      % established it. Declared with explicit BOUNDS because it is filled at
  1695  (1035)      % runtime, which is also why it is passed as a subarray.
  1696  (1036)      % WHAT THIS MACHINE CALLS ITSELF, set by SET-NAME from CHAT-MON.
  1697  (1037)      %
  1698  (1038)      % EMPTY MEANS NO NAME, and then everything falls back to D<number> - which
  1699  (1039)      % is exactly what this server did before names existed. That fallback is
  1700  (1040)      % the whole reason this can go onto three running machines one at a time.
  1701  (1041)      %
  1702  (1042)      % It is NOT written to disk. The boot mode file already drives CHAT-MON and
  1703  (1043)      % already starts the trunks, so SET-NAME belongs beside those - one place
  1704  (1044)      % per machine, visible in the same file as the rest of its configuration,
  1705  (1045)      % and no new file handling in a server that has none.
  1706  (1046)      BYTES    : sysName(0:15)
  1707  (1047)      INTEGER  : lenSysName := 0
  1708  (1048)  
  1709  (1049)      % peerName is NOT that. It is the XROUT ADDRESS a letter is sent to -
  1710  (1050)      % 'D102' - and it must stay a D and a number whatever anybody is called,
  1711  (1051)      % or the trunks stop working. Named apart on purpose.
  1712  (1052)      BYTES    : peerName(0:15)
  1713  (1053)      BYTES    : dByte := 'D'
  1714  (1054)  
  1715  (1055)      % ---- THE PEER TABLE ------------------------------------------------------
  1716  (1056)      %
  1717  (1057)      % One row per trunked machine. SOFT STATE: nothing here is a connection, it
  1718  (1058)      % is what we currently BELIEVE about a peer, and the belief is refreshed by
  1719  (1059)      % anything arriving from it.
  1720  (1060)      %
  1721  (1061)      % EIGHT is plenty and the bound is deliberate. Trunks are configured by an
  1722  (1062)      % operator one at a time, not discovered, so a table that cannot overflow
  1723  (1063)      % quietly is worth more than a big one. TRUNK refuses out loud when it is
  1724  (1064)      % full.
  1725  (1065)      INTEGER        : maxPeers := 8
  1726  (1066)      INTEGER ARRAY  : peerSystem(1:8)      % XMSG system number, 0 = free row
  1727  (1067)  
  1728  (1068)      % WHAT EACH PEER CALLS ITSELF, learned from the name it puts in its Hello.
  1729  (1069)      % Empty until one arrives, and then D<number> is used for that peer exactly
  1730  (1070)      % as before - so a machine running the older build is simply a machine
  1731  (1071)      % without a name, not a machine that breaks anything.
  1732  (1072)      BYTES ARRAY    : pName(1:8, 1:16)
  1733  (1073)      INTEGER ARRAY  : pNameLen(1:8)
  1734  (1074)      INTEGER ARRAY  : peerState(1:8)       % see the three constants below
  1735  (1075)      INTEGER ARRAY  : peerHeard(1:8)       % loop ticks since we last heard from it
  1736  (1076)  
  1737  (1077)      % ---- WHO PUT THIS PEER HERE: the operator, or the wire? ----------------
  1738  (1078)      %
  1739  (1079)      % 1 for a row an operator asked for with START-TRUNK, 0 for one this server
  1740  (1080)      % LEARNED because a message arrived from a system it had never seen.
  1741  (1081)      %
  1742  (1082)      % WHY THE DISTINCTION EXISTS. markPeerUp adds any unknown system on first
  1743  (1083)      % contact, so the eight rows can be filled entirely by machines nobody
  1744  (1084)      % configured - and then a real START-TRUNK answers "no room for another
  1745  (1085)      % trunk". The note above this table says a table that cannot overflow
  1746  (1086)      % quietly is worth more than a big one, and that was only half true: the
  1747  (1087)      % OPERATOR path refuses out loud, the LEARNING path filled it in silence.
  1748  (1088)      %
  1749  (1089)      % With this flag an operator can always get a row - addPeer takes one back
  1750  (1090)      % from a learned peer rather than refusing - so the table stays small and
  1751  (1091)      % the loud refusal is reserved for the case where every row was asked for.
  1752  (1092)      INTEGER ARRAY  : peerFixed(1:8)
  1753  (1093)      INTEGER        : peerLearned := 0
  1754  (1094)      INTEGER        : peerAsked   := 1
  1755  (1095)  
  1756  (1096)      % ---- MAY THIS SERVER LEARN A PEER IT WAS NEVER TOLD ABOUT? -------------
  1757  (1097)      %
  1758  (1098)      % TRUE by default, which is exactly what the server has always done: any
  1759  (1099)      % system that reaches the trunk port becomes a peer. That keeps setting up
  1760  (1100)      % a lab easy - no list of friends to type - and nothing that works today
  1761  (1101)      % stops working.
  1762  (1102)      %
  1763  (1103)      % BE CLEAR ABOUT WHAT IT COSTS. An open server believes whatever a peer
  1764  (1104)      % says about who is speaking on it: a line arriving on the trunk port is
  1765  (1105)      % delivered as NAME@thatsystem, and the only thing standing between a
  1766  (1106)      % stranger and impersonating anybody is whether XMSG would carry their
  1767  (1107)      % letter at all. LOCK-PEERS is how an operator ends that once the lab is
  1768  (1108)      % up: the peers that are already known keep working, and no new one is
  1769  (1109)      % ever learned.
  1770  (1110)      %
  1771  (1111)      % It is deliberately NOT saved anywhere. A lock is a statement about the
  1772  (1112)      % running system, and a server that came back from a reboot silently
  1773  (1113)      % refusing its own trunks would be a worse failure than the one this
  1774  (1114)      % prevents.
  1775  (1115)      BOOLEAN        : peersOpen := TRUE
  1776  (1116)  
  1777  (1117)      % Peer states. NOT a BOOLEAN pair, because "we have never heard from it" and
  1778  (1118)      % "we heard from it and then it went quiet" are different things to an
  1779  (1119)      % operator reading LIST-TRUNKS: the first is probably a configuration
  1780  (1120)      % mistake, the second is a machine that went away.
  1781  (1121)      INTEGER        : peerUnknown := 0
  1782  (1122)      INTEGER        : peerUp      := 1
  1783  (1123)      INTEGER        : peerDown    := 2
  1784  (1124)  
  1785  (1125)      % How many idle loop ticks before a peer we have heard nothing from is
  1786  (1126)      % declared Down, and how often we say HELLO to one that is not Up.
  1787  (1127)      %
  1788  (1128)      % BACKOFF IS REQUIRED, NOT OPTIONAL - a machine that is switched off must not
  1789  (1129)      % be probed every few seconds for a week. This first cut uses a flat retry;
  1790  (1130)      % the design asks for 15s/30s/60s/5min and that is worth doing once the flat
  1791  (1131)      % one is proved on the wire. Written down here so it is not forgotten.
  1792  (1132)      % Seconds of silence before a peer we HAD is declared Down.
  1793  (1133)      INTEGER        : peerDeadAfter := 60
  1794  (1134)  
  1795  (1135)      % ---- BACKOFF, AND WHY IT IS NOT A FIXED INTERVAL ------------------------
  1796  (1136)      %
  1797  (1137)      % "Backoff is required, not optional" - the design, and it is right: a
  1798  (1138)      % machine that is switched off must not be probed every few seconds for a
  1799  (1139)      % week. Two peers left down over a weekend at a flat 20s would be about
  1800  (1140)      % 30,000 pointless letters.
  1801  (1141)      %
  1802  (1142)      % So the wait DOUBLES after every unanswered try, from 15 seconds up to a
  1803  (1143)      % cap of five minutes: 15, 30, 60, 120, 240, 300, 300, ... A machine that
  1804  (1144)      % comes back is found within five minutes at worst, and usually far sooner
  1805  (1145)      % because ITS OWN hello reaches us the moment it starts - the retry is the
  1806  (1146)      % fallback, not the mechanism.
  1807  (1147)      %
  1808  (1148)      % RESET ON EVERY transition to Up, not just the first, so a peer that flaps
  1809  (1149)      % does not inherit a five-minute wait from its last absence.
  1810  (1150)      INTEGER        : peerFirstWait := 15
  1811  (1151)      INTEGER        : peerMaxWait   := 300
  1812  (1152)      INTEGER ARRAY  : peerWait(1:8)        % seconds to wait before the next try
  1813  (1153)      INTEGER ARRAY  : peerCount(1:8)       % seconds left of that wait
  1814  (1154)  
  1815  (1155)      % ---- WHO IS ON THE OTHER MACHINES ---------------------------------------
  1816  (1156)      %
  1817  (1157)      % Phase C. A copy of what each peer last told us about its members, so /who
  1818  (1158)      % can answer across machines.
  1819  (1159)      %
  1820  (1160)      % ENTIRELY DERIVED, NEVER AUTHORITATIVE. Every row here was sent by the
  1821  (1161)      % machine that owns it, and is replaced wholesale the next time that machine
  1822  (1162)      % speaks. We never add, edit or reason about another machine's members - if
  1823  (1163)      % this disagrees with the far end, the far end is right and this is stale.
  1824  (1164)      %
  1825  (1165)      % KEYED BY THE OWNING SYSTEM so a peer going away can have all of its rows
  1826  (1166)      % dropped in one pass. A peer that is Down must not leave people apparently
  1827  (1167)      % chatting from a machine that is not there.
  1828  (1168)      INTEGER        : maxRemote := 32
  1829  (1169)      INTEGER ARRAY  : rmtSystem(1:32)      % owning machine, 0 = free row
  1830  (1170)      BYTES ARRAY    : rmtName(1:32, 1:16)
  1831  (1171)      INTEGER ARRAY  : rmtNameLen(1:32)
  1832  (1172)      BYTES ARRAY    : rmtRoom(1:32, 1:16)
  1833  (1173)      INTEGER ARRAY  : rmtRoomLen(1:32)
  1834  (1174)  
  1835  (1175)      % ---- THE PRESENCE DIFF, 2026-09-02 --------------------------------------
  1836  (1176)      %
  1837  (1177)      % A kTrkMbrs replaces a peer's rows WHOLESALE, and until tonight it did so
  1838  (1178)      % in silence: a person joining or leaving on another machine changed the
  1839  (1179)      % tables and told no local client anything, so the room's count and its
  1840  (1180)      % "has joined"/"has left" notices only ever covered THIS machine. These
  1841  (1181)      % arrays hold a snapshot of one peer's rows from BEFORE the replace, so
  1842  (1182)      % the difference can be announced to local seats as ordinary kJoined and
  1843  (1183)      % kLeft - the kinds the client already renders and counts. oldUsed is 1
  1844  (1184)      % for a snapshot row, and 2 once the diff has matched it to a new row.
  1845  (1185)      INTEGER ARRAY  : oldUsed(1:32)
  1846  (1186)      BYTES ARRAY    : oldNm(1:32, 1:16)
  1847  (1187)      INTEGER ARRAY  : oldNmLen(1:32)
  1848  (1188)      BYTES ARRAY    : oldRm(1:32, 1:16)
  1849  (1189)      INTEGER ARRAY  : oldRmLen(1:32)
  1850  (1190)  
  1851  (1191)      % One announcement's name and room, copied FLAT so a single announceGo
  1852  (1192)      % serves both directions of the diff - the joined side reads the rmt
  1853  (1193)      % tables, the left side reads the snapshot, and neither 2-D row can be
  1854  (1194)      % passed to a routine.
  1855  (1195)      BYTES          : annName(0:15)
  1856  (1196)      INTEGER        : annNameLen := 0
  1857  (1197)      BYTES          : annRoom(0:15)
  1858  (1198)      INTEGER        : annRoomLen := 0
  1859  (1199)  
  1860  (1200)      % Quiet seconds on an UP trunk before a keepalive hello goes out - see
  1861  (1201)      % peerTick. Two of these fit inside peerDeadAfter with room to spare.
  1862  (1202)      INTEGER        : peerPingAt := 20
  1863  (1203)  
  1864  (1204)      % TRUE once the ports are open. MODULE data lives in the RT segment and
  1865  (1205)      % SURVIVES the terminate above - the member table, the port numbers and the
  1866  (1206)      % magic are all still here on the next start. INISTACK is not: it runs
  1867  (1207)      % every time. So the opening work must happen ONCE, or the second start
  1868  (1208)      % tries to re-open a name this program already holds and fails.
  1869  (1209)      BOOLEAN  : portsOpen := FALSE
  1870  (1210)  
  1871  (1211)      % Which port the message being handled arrived on. Admin kinds are refused
  1872  (1212)      % on the lobby and room kinds on the command port - sharing one vocabulary
  1873  (1213)      % is not sharing the authority to use any of it anywhere.
  1874  (1214)      BOOLEAN  : fromAdmin := FALSE
  1875  (1215)  
  1876  (1216)      % Same idea for the trunk port. A kTrkHello arriving on the ROOM port is not
  1877  (1217)      % a trunk message, it is a member sending something they should not, and the
  1878  (1218)      % handler drops it rather than trusting it.
  1879  (1219)      BOOLEAN  : fromTrunk := FALSE
  1880  (1220)  
  1881  (1221)      % Which SYSTEM the message being handled came from, taken apart from the
  1882  (1222)      % sender's magic number with XMPFM2P. The trunk needs it because a peer is
  1883  (1223)      % identified by system number, and because an unsolicited HELLO has to be
  1884  (1224)      % answerable without anything having been configured first.
  1885  (1225)      INTEGER  : senderSystem := 0
  1886  (1226)      INTEGER  : senderPortNo := 0
  1887  (1227)      INTEGER  : senderRtInfo := 0
  1888  (1228)      INTEGER  : senderExtra  := 0
  1889  (1229)  
  1890  (1230)      % OUR OWN system number, taken apart from our own magic at startup.
  1891  (1231)      %
  1892  (1232)      % NEEDED BECAUSE WE HEAR OURSELVES. A hello addressed to a machine that has
  1893  (1233)      % no CHAT-TRUNK name comes straight BACK, arrives on our own trunk port
  1894  (1234)      % carrying OUR magic, and without this test the server adds a peer row for
  1895  (1235)      % itself and calls it up. MEASURED on D100 2026-08-22, the first time a
  1896  (1236)      % trunk was ever configured:
  1897  (1237)      %
  1898  (1238)      %     C-M: START-TRUNK 102
  1899  (1239)      %     C-M: LIST-TRUNKS   ->   102 unknown 100 up
  1900  (1240)      %
  1901  (1241)      % 100 is this machine. Nothing was up; a letter had bounced.
  1902  (1242)      INTEGER  : mySystem := 0
  1903  (1243)  
  1904  (1244)      % Direct messages delivered, and direct messages refused. On the STATUS
  1905  (1245)      % line beside the other counters, because a screen cannot tell you either
  1906  (1246)      % of these - a refusal is seen only by the one person who got it, and a
  1907  (1247)      % delivery is seen only by two.
  1908  (1248)      %
  1909  (1249)      % A CLIMBING refuse count with a flat sent count is the shape of a client
  1910  (1250)      % or a user getting the address form wrong, which is worth knowing without
  1911  (1251)      % having to ask anybody.
  1912  (1252)      INTEGER  : dmSent := 0
  1913  (1253)      INTEGER  : dmBad  := 0
  1914  (1254)  
  1915  (1255)      % WHAT AN ALIAS RESOLVED TO. Four answers, so they are variables and not a
  1916  (1256)      % return value - PLANC returns one thing.
  1917  (1257)      %
  1918  (1258)      %   dirCount   how many people matched. 0 refuses, 2 or more refuses with
  1919  (1259)      %              the candidates, exactly 1 is delivered.
  1920  (1260)      %   dirLocal   the local seat, or 0
  1921  (1261)      %   dirRemote  the row in the remote table, or 0
  1922  (1262)      %   dirSystem  the machine the one match is on
  1923  (1263)      INTEGER  : dirCount  := 0
  1924  (1264)      INTEGER  : dirLocal  := 0
  1925  (1265)      INTEGER  : dirRemote := 0
  1926  (1266)      INTEGER  : dirSystem := 0
  1927  (1267)  
  1928  (1268)      % For the idle sleep - see the empty-drain branch of the main loop.
  1929  (1269)      % sleepWhy comes back 0 when the time simply elapsed, 1 when a break
  1930  (1270)      % restarted us. Neither changes what this loop does next, but the call
  1931  (1271)      % needs somewhere to put it.
  1932  (1272)      INTEGER  : sleepUnits
  1933  (1273)      INTEGER  : sleepKind
  1934  (1274)      INTEGER  : sleepWhy
  1935  (1275)  
  1936  (1276)      % ---- THE TICK COMES OFF THE CLOCK, NOT OFF THE SLEEPS -------------
  1937  (1277)      %
  1938  (1278)      % peerTick has to run ONCE A SECOND: every counter it touches is in
  1939  (1279)      % seconds - peerHeard against peerDeadAfter, and peerWait doubling to a
  1940  (1280)      % five-minute ceiling. Ticking it too fast ages a quiet trunk out early
  1941  (1281)      % and re-dials it too often, which is a healthy trunk that looks like a
  1942  (1282)      % flapping one.
  1943  (1283)      %
  1944  (1284)      % IT USED TO BE COUNTED IN SLEEPS - ten sleeps of 100 ms to a second -
  1945  (1285)      % and that only measures time while EVERY SLEEP RUNS ITS FULL LENGTH.
  1946  (1286)      % The doorbell below breaks exactly that assumption: a wake-up cuts the
  1947  (1287)      % sleep short, so on a busy server ten "sleeps" could pass in a few
  1948  (1288)      % milliseconds and every trunk timeout would run fast. The counter had
  1949  (1289)      % to go before the doorbell could arrive.
  1950  (1290)      %
  1951  (1291)      % So the tick is now a CLOCK COMPARISON. MON11 is the machine's own
  1952  (1292)      % basic-unit counter; when 50 units (one second) have gone by since the
  1953  (1293)      % last tick, tick. This is right whatever the sleep does.
  1954  (1294)      % ALL THREE INTEGER4, DELIBERATELY. MON11 hands back an INTEGER4, and
  1955  (1295)      % ND-60.117.5 section 5.4 says a relational operator needs both operands
  1956  (1296)      % of the SAME data type - allowing modified integers to be mixed, which
  1957  (1297)      % probably covers this. "Probably" is a twenty-minute compile to test, and
  1958  (1298)      % the one shape PROVED to build on D100 keeps every term the same type:
  1959  (1299)      % CHATUI.PLNC declares lastAdd, nowTime AND addEvery as INTEGER4 for the
  1960  (1300)      % identical "IF nowTime - lastAdd >= addEvery" comparison. Copy what
  1961  (1301)      % compiled rather than what the manual permits.
  1962  (1302)      INTEGER4 : lastTick  := 0
  1963  (1303)      INTEGER4 : nowTicks  := 0
  1964  (1304)      INTEGER4 : tickUnits := 50
  1965  (1305)  
  1966  (1306)      % ---- THE DOORBELL, AND THE THING THAT TURNS IT OFF ----------------
  1967  (1307)      %
  1968  (1308)      % XFWAK arms a wake-up on a port: when a message lands, XMSG performs
  1969  (1309)      % an RT-start on this program. @RT's own rule 3 (ND-60.128.5, the entry
  1970  (1310)      % for @RT, whose related monitor call is RT/MON 100) says a program in
  1971  (1311)      % HOLD "is removed from that state", and TimeOut documents a restart
  1972  (1312)      % cause of -1 for exactly this. So the wake-up cuts the sleep short and
  1973  (1313)      % says so in sleepWhy. That is the whole point: one second of sleep for
  1974  (1314)      % a machine that is doing nothing, and no wait at all when a message
  1975  (1315)      % actually arrives.
  1976  (1316)      %
  1977  (1317)      % WHAT IS NOT PROVED, AND WHY THE COUNTER BELOW EXISTS: nothing we have
  1978  (1318)      % read says whether the restart flag is CLEARED when TimeOut consumes
  1979  (1319)      % it. If it is sticky, every following TimeOut returns instantly, the
  1980  (1320)      % sleep stops sleeping, and this program burns the machine - which is
  1981  (1321)      % the one outcome that must not happen while nobody is watching.
  1982  (1322)      %
  1983  (1323)      % So the doorbell disarms itself. Every wake with cause -1 that finds
  1984  (1324)      % all three ports still empty counts; a real message resets the count.
  1985  (1325)      % Twenty in a row is not a busy server, it is a flag that will not
  1986  (1326)      % clear - so drop back to flags 0 and the old 100 ms poll, log it, and
  1987  (1327)      % carry on. The product keeps working either way; the log says which
  1988  (1328)      % path it took.
  1989  (1329)      INTEGER  : wakeSpin    := 0
  1990  (1330)      INTEGER  : wakeSpinMax := 20
  1991  (1331)      BOOLEAN  : doorbellOn  := TRUE
  1992  (1332)  
  1993  (1333)      % XMROU, "routed message (via XROUT)", is what msgType carries when a letter
  1994  (1334)      % arrives. It is the ONLY thing that says a SEAT was spent: XROUT takes one
  1995  (1335)      % free connection to forward a letter, before this program has seen a byte
  1996  (1336)      % of it.
  1997  (1337)      %
  1998  (1338)      % SETTLED FROM ND'S OWN SAMPLE SERVERS, both of them, in the COSMOS
  1999  (1339)      % Programmer Guide (ND-60.164.3) appendix of sample programs. Each waits for
  2000  (1340)      % the forwarded letter and then refuses anything else:
  2001  (1341)      %
  2002  (1342)      %   PLANC     IF MSGTYPE >< XMROU THEN
  2003  (1343)      %                 OUTPUT(1, 'A', 'WRONG MESSAGE TYPE ')
  2004  (1344)      %
  2005  (1345)      %   FORTRAN   IF (MSGTYPE .NE. XMROU) THEN
  2006  (1346)      %                 WRITE(1,*)'WRONG MESSAGE TYPE'
  2007  (1347)      %
  2008  (1348)      % Both then read the CLIENT's magic number out of the arrived message to
  2009  (1349)      % answer it directly - which is the other half of the same fact, and the
  2010  (1350)      % reason the sender field is the client rather than XROUT.
  2011  (1351)      %
  2012  (1352)      % The name is used bare here, not declared as a literal, because the PLANC
  2013  (1353)      % sample uses it bare under the same two includes this file has.
  2014  (1354)  
  2015  (1355)      % Was the sender in the room BEFORE this message was handled? The seat
  2016  (1356)      % accounting below needs the answer from before, so it is taken early.
  2017  (1357)      INTEGER  : wasMember
  2018  (1358)      % Is the sender a member AFTER the letter was handled? That single question
  2019  (1359)      % decides whether the seat XROUT spent on the arrival goes back.
  2020  (1360)      INTEGER  : nowMember
  2021  (1361)      % Byte 1 of a routed arrival, kept BEFORE the payload is shifted down. 65
  2022  (1362)      % (XSLET) means a client sent it and a seat was spent; anything else is
  2023  (1363)      % XROUT answering one of our own calls, which spent nothing.
  2024  (1364)      INTEGER  : letterService
  2025  (1365)  
  2026  (1366)      % XSLET (65) IS NOT DECLARED HERE. It is already a CONSTANT in XMP-B02:DEFS
  2027  (1367)      % - "CONSTANT XSLET=65  % Send a letter" - and declaring our own would be a
  2028  (1368)      % redeclaration, which in this compiler is not a warning: it drew
  2029  (1369)      % IDENTIFIER ALREADY SPECIFIED and then ASSERT VIOLATION AT 136747B and took
  2030  (1370)      % the whole batch job with it. Checked against the listing before writing
  2031  (1371)      % this, not assumed.
  2032  (1372)      INTEGER  : remotePortHash
  2033  (1373)      INTEGER  : nBytes
  2034  (1374)      % What XMPFRCV put in nBytes, kept before XMPFMST overwrites it. It is the
  2035  (1375)      % message length normally and the REASON FOR RETURN on an XMTRE.
  2036  (1376)      INTEGER  : receiveStat
  2037  (1377)      INTEGER  : readLength
  2038  (1378)      INTEGER  : readAmount
  2039  (1379)      % An INTEGER dumpAmount clamped the 48-byte arrival dump. Both are gone;
  2040  (1380)      % see the note in the receive loop for what that dump found.
  2041  (1381)      % Where the chat message starts inside a letter that came via XROUT - that
  2042  (1382)      % is, the first byte after the XSLET header. Derived from the header's own
  2043  (1383)      % length word on every arrival, never assumed.
  2044  (1384)      INTEGER  : payloadAt
  2045  (1385)      INTEGER  : writtenLength
  2046  (1386)      INTEGER  : returnStatus
  2047  (1387)      INTEGER4 : senderMagic
  2048  (1388)  
  2049  (1389)      % OUR OWN port's magic number, read once with XMPFP2M after the port opens.
  2050  (1390)      % Kept only so an arrival can be tested against it, because the thing that
  2051  (1391)      % actually happened - our own answer arriving back at this very port - is not
  2052  (1392)      % something any amount of reading the guide would have suggested, and without
  2053  (1393)      % this comparison it cannot be told apart from a real peer's message.
  2054  (1394)      INTEGER4 : myMagic := 0
  2055  (1395)      BOOLEAN  : uniqueName := TRUE
  2056  (1396)  
  2057  (1397)      % -----------------------------------------------------------------------
  2058  (1398)      % THE LOG. An RT program has no terminal, so every OUTPUT(1, ...) in this
  2059  (1399)      % file goes NOWHERE once CHATSER is started with @RT.
  2060  (1400)      %
  2061  (1401)      % That is not a tidiness problem, it is why a whole afternoon was spent
  2062  (1402)      % guessing on 2026-08-20. Two clients sat in one room and neither heard
  2063  (1403)      % the other; the one line that would have said why - "SV: snd failed st="
  2064  (1404)      % from sendTo - was printed to a device that is not there. The fault was
  2065  (1405)      % looked for in the room table, the wire, the seat counter and the build,
  2066  (1406)      % in that order, because the program's own account of itself was thrown
  2067  (1407)      % away.
  2068  (1408)      %
  2069  (1409)      % SO EVERY DIAGNOSTIC GOES TO A FILE AS WELL AS THE TERMINAL. Run as
  2070  (1410)      % @CHATSV you see it on screen AND in the file; run as @RT CHATSER the
  2071  (1411)      % screen half goes nowhere and the file is all there is.
  2072  (1412)      %
  2073  (1413)      % OPEN, WRITE, CLOSE PER LINE - and that is deliberate, not laziness.
  2074  (1414)      % A crash leaves an open file's block buffer unwritten, so anything still
  2075  (1415)      % in it is lost - which is exactly the moment the log has to survive. One
  2076  (1416)      % line per open costs a file system round trip, and these lines are only
  2077  (1417)      % written on errors and at startup, so the cost is paid when something is
  2078  (1418)      % already wrong.
  2079  (1419)      %
  2080  (1420)      % ACCESS 5 IS SEQUENTIAL WRITE APPEND, from the OpenFile table in
  2081  (1421)      % ND-860228-2-EN. Access 0 would truncate at CLOSE and each line would
  2082  (1422)      % erase the one before it - and it truncates at CLOSE rather than at OPEN,
  2083  (1423)      % which is the trap CHAT.PLNC already carries a note about.
  2084  (1424)      %
  2085  (1425)      % AN RT PROGRAM'S DEFAULT USER IS RT, NOT SYSTEM. The file is named
  2086  (1426)      % without a user, so it resolves against RT first and then SYSTEM. If it
  2087  (1427)      % is never created, logging simply does nothing - see logBroken.
  2088  (1428)      % -----------------------------------------------------------------------
  2089  (1429)      % CHATLG2, NOT CHATLOG, AND THE REASON MATTERS. The first log this server
  2090  (1430)      % ever wrote went out as plain 7-bit ASCII, before logPut existed. Access 5
  2091  (1431)      % APPENDS, so the parity-correct lines written afterwards landed BEHIND 107
  2092  (1432)      % bytes SINTRAN's own utilities refuse to read, and LIST-FILE stopped at the
  2093  (1433)      % first of them without a word - the whole file reads as empty. The file
  2094  (1434)      % belongs to user RT and SYSTEM has no directory access to delete it, so the
  2095  (1435)      % only way out is a name that has never been written the wrong way.
  2096  (1436)      % Measured on D100, 2026-08-20.
  2097  (1437)      BYTES   : logName := 'CHATLG2'
  2098  (1438)      BYTES   : logType := 'SYMB'
  2099  (1439)  
  2100  (1440)      % Sequential write APPEND. See above - 0 would truncate.
  2101  (1441)      INTEGER : logAppend := 5
  2102  (1442)  
  2103  (1443)      % Set once the log has failed, and never cleared. A server that cannot
  2104  (1444)      % write its log must not spend a file system call per diagnostic finding
  2105  (1445)      % that out again, and must certainly not fail because of it.
  2106  (1446)      BOOLEAN : logBroken := FALSE
  2107  (1447)  
  2108  (1448)      % Digits, LEAST significant first as they are produced, written out in
  2109  (1449)      % reverse. Ten is enough for any 16-bit value with room to spare.
  2110  (1450)      BYTES   : logDigits(0:9)
  2111  (1451)  
  2112  (1452)      % Single characters the log writes, as NUMBERS. A carriage return has no
  2113  (1453)      % spelling inside a PLANC string literal, and CHAT.PLNC already carries
  2114  (1454)      % its carriageRet the same way, so all three are written alike rather
  2115  (1455)      % than two one way and one the other.
  2116  (1456)      INTEGER : logMinus := 45
  2117  (1457)      INTEGER : logCr    := 13
  2118  (1458)      INTEGER : logLf    := 10
  2119  (1459)  
  2120  (1460)      % The full filespec, for the create. CreateFile takes the WHOLE thing in
  2121  (1461)      % one 64-byte buffer, unlike MON50 which takes name and type separately.
  2122  (1462)      BYTES   : logFull     := 'CHATLG2:SYMB'
  2123  (1463)      INTEGER : lenLogFull  := 12
  2124  (1464)      INTEGER : sizeNameBuf := 64
  2125  (1465)      BYTES   : nameBuf(0:63)
  2126  (1466)      BYTES   : blankByte   := ' '
  2127  (1467)      INTEGER4 : startAddr  := 0
  2128  (1468)      INTEGER4 : noOfPages  := 0
  2129  (1469)  
  2130  (1470)      % -----------------------------------------------------------------------
  2131  (1471)      % Ask SINTRAN to create CHATLOG:SYMB.
  2132  (1472)      %
  2133  (1473)      % MON50 CANNOT CREATE A FILE - measured in CHAT.PLNC, where quoting the
  2134  (1474)      % name did nothing at all. CreateFile is 221B and it is a separate call.
  2135  (1475)      % It has no MONn routine, which is why it goes through MONITOR_CALL; that
  2136  (1476)      % works here because MON-CALL-1B-A00 supplies 5MON_P, and this program
  2137  (1477)      % already relies on it for TimeOut.
  2138  (1478)      %
  2139  (1479)      % The buffer is filled with SPACES first and the filespec copied over the
  2140  (1480)      % front, so whatever was in the rest is never read as part of the name.
  2141  (1481)      % Both size parameters are zero: an ordinary indexed file that grows as
  2142  (1482)      % it is written, which is what a log wants.
  2143  (1483)      % -----------------------------------------------------------------------
  2144  (1484)      ROUTINE VOID, VOID : makeLog
  2145  (1485)          INTEGER : i
  2146  (1486)          FOR i IN 1:sizeNameBuf DO
  2147  (1487)              blankByte(0) =: nameBuf(i - 1)
  2148  (1488)          ENDFOR
  2149  (1489)          FOR i IN 1:lenLogFull DO
  2150  (1490)              logFull(i - 1) =: nameBuf(i - 1)
  2151  (1491)          ENDFOR
  2152  (1492)          MONITOR_CALL(221B, nameBuf, startAddr, noOfPages)
  2153  (1493)      ENDROUTINE
  2154  (1494)  
  2155  (1495)      % -----------------------------------------------------------------------
  2156  (1496)      % Open the log for append, creating it the first time.
  2157  (1497)      %
  2158  (1498)      % Returns the device number, or 0 when the log is not usable. THE CALLER
  2159  (1499)      % MUST TEST THE BOOLEAN, not the number - a failed MON50 leaves 46 in it,
  2160  (1500)      % SINTRAN's "no such file", which is the defect CHAT.PLNC records at
  2161  (1501)      % length. This routine turns that into a plain 0 so no caller can repeat
  2162  (1502)      % it.
  2163  (1503)      %
  2164  (1504)      % THE FLAG IS CLEARED AFTER THE ON BLOCK, NOT BEFORE. Measured in
  2165  (1505)      % CHAT.PLNC on 2026-08-19: cleared before, the handler body had already
  2166  (1506)      % run and every open reported failure while returning a good device.
  2167  (1507)      % -----------------------------------------------------------------------
  2168  (1508)      ROUTINE VOID, INTEGER : logOpen
  2169  (1509)          INTEGER : dev
  2170  (1510)          BOOLEAN : openFailed
  2171  (1511)  
  2172  (1512)          IF logBroken THEN
  2173  (1513)              0 RETURN
  2174  (1514)          ENDIF
  2175  (1515)  
  2176  (1516)          0 =: dev
  2177  (1517)          ON ROUTINEERROR DO
  2178  (1518)              TRUE =: openFailed
  2179  (1519)          ENDON
  2180  (1520)          FALSE =: openFailed
  2181  (1521)  
  2182  (1522)          MON50(logName, logType, logAppend) =: dev
  2183  (1523)  
  2184  (1524)          IF openFailed THEN
  2185  (1525)              % Not there yet. Make it and open it for real. A create that
  2186  (1526)              % fails needs no message of its own - the second open fails too
  2187  (1527)              % and that is what sets logBroken.
  2188  (1528)              ON ROUTINEERROR DO
  2189  (1529)              ENDON
  2190  (1530)              makeLog
  2191  (1531)  
  2192  (1532)              ON ROUTINEERROR DO
  2193  (1533)                  TRUE =: openFailed
  2194  (1534)              ENDON
  2195  (1535)              FALSE =: openFailed
  2196  (1536)              MON50(logName, logType, logAppend) =: dev
  2197  (1537)          ENDIF
  2198  (1538)  
  2199  (1539)          IF openFailed THEN
  2200  (1540)              TRUE =: logBroken
  2201  (1541)              0 RETURN
  2202  (1542)          ENDIF
  2203  (1543)  
  2204  (1544)          dev RETURN
  2205  (1545)      ENDROUTINE
  2206  (1546)  
  2207  (1547)      % -----------------------------------------------------------------------
  2208  (1548)      % Write one line: a tag, a number, and an end of line.
  2209  (1549)      %
  2210  (1550)      % The tag is passed as a slice of a BYTES with its length, the same shape
  2211  (1551)      % every other routine here uses, because PLANC's OUTPUT needs the width in
  2212  (1552)      % the format string and a routine cannot have a literal one.
  2213  (1553)      %
  2214  (1554)      % NOTHING HERE IS ALLOWED TO KILL THE SERVER. Every failure sets the flag
  2215  (1555)      % and returns. A logger that can take down the thing it is watching is
  2216  (1556)      % worse than no logger.
  2217  (1557)      % -----------------------------------------------------------------------
  2218  (1558)      % -----------------------------------------------------------------------
  2219  (1559)      % Write one byte to the log. PLAIN 7-BIT ASCII, and the parity version of
  2220  (1560)      % this routine has been TAKEN OUT.
  2221  (1561)      %
  2222  (1562)      % IT USED TO SET EVEN PARITY IN BIT 7, on a conclusion that was WRONG. The
  2223  (1563)      % reasoning was: the log filled up correctly - 107 bytes, five opens, every
  2224  (1564)      % size right - and then
  2225  (1565)      %
  2226  (1566)      %   @LIST-FILE SVLOG:SYMB,,     printed the header and NOTHING ELSE
  2227  (1567)      %   @QED  R SVLOG:SYMB          PARITY ERROR AT LINE 1, thirteen times
  2228  (1568)      %
  2229  (1569)      % which reads as "the bytes are there and the tools refuse them", so the
  2230  (1570)      % bytes must be at fault.
  2231  (1571)      %
  2232  (1572)      % THE CONTROL RUN THAT WAS NEVER DONE. The same two commands against
  2233  (1573)      % CHATSV:MODE - the build file @MODE compiles this whole server from, which
  2234  (1574)      % is unquestionably good - answer EXACTLY THE SAME WAY: LIST-FILE prints the
  2235  (1575)      % header and nothing else, QED cries PARITY ERROR thirteen times. Both tools
  2236  (1576)      % do this to every file our FA push puts on the machine. They were never
  2237  (1577)      % evidence about the log at all.
  2238  (1578)      %
  2239  (1579)      % And the parity code did not even do what it claimed: measured on the wire,
  2240  (1580)      % EVERY byte came back with bit 7 set - S as 0xD3, T as 0xD4, space as 0xA0,
  2241  (1581)      % CR as 0x8D - so the "is the count odd" test was true every time. It was
  2242  (1582)      % wrong code justifying itself with a wrong measurement.
  2243  (1583)      %
  2244  (1584)      % TO READ THIS LOG, PULL IT OFF THE MACHINE AND LOOK AT THE BYTES:
  2245  (1585)      %
  2246  (1586)      %   @COPY-FILE "SVLOG2:SYMB",(RT)CHATLG2:SYMB     (RT owns it; SYSTEM cannot
  2247  (1587)      %                                                  delete or chmod it)
  2248  (1588)      %   Xmsg.Live.Runner --config topology-d19999-hdlc-server.json \
  2249  (1589)      %       --pull 'SVLOG2:SYMB' --pull-from 100 --pull-to svlog2.raw \
  2250  (1590)      %       --originate-from-seed
  2251  (1591)      %
  2252  (1592)      % That works, and it is how the broadcast question was finally answered.
  2253  (1593)      % -----------------------------------------------------------------------
  2254  (1594)      ROUTINE VOID, VOID (INTEGER, INTEGER) : logPut(dev, value)
  2255  (1595)          BYTE : b
  2256  (1596)  
  2257  (1597)          % Masked to seven bits so a stray high bit in a caller's value cannot
  2258  (1598)          % put a character in the file that nothing will render.
  2259  (1599)          value AND 127 =: b
  2260  (1600)          b MON2(dev)
  2261  (1601)      ENDROUTINE
  2262  (1602)  
  2263  (1603)      % The tag length is DERIVED, not passed - see buildAdmText for the whole
  2264  (1604)      % argument. Nineteen callers used to type the count beside the literal.
  2265  (1605)      ROUTINE VOID, VOID (BYTES, INTEGER) : logLine(tag, value)
  2266  (1606)          INTEGER : dev, i, left, rest, digit, digitCount, tagLen
  2267  (1607)          BYTE    : b
  2268  (1608)          BOOLEAN : writeFailed
  2269  (1609)  
  2270  (1610)          MAXINDEX(tag, 1) + 1 =: tagLen
  2271  (1611)          logOpen =: dev
  2272  (1612)          IF dev = 0 THEN
  2273  (1613)              RETURN
  2274  (1614)          ENDIF
  2275  (1615)  
  2276  (1616)          % ONE FLAG FOR THE WHOLE LINE, not a message per byte. CHAT.PLNC
  2277  (1617)          % learned that the hard way: a handler round a write loop that prints
  2278  (1618)          % inside it says the same thing once per character.
  2279  (1619)          ON ROUTINEERROR DO
  2280  (1620)              TRUE =: writeFailed
  2281  (1621)          ENDON
  2282  (1622)          FALSE =: writeFailed
  2283  (1623)  
  2284  (1624)          FOR i IN 1:tagLen DO
  2285  (1625)              tag(i - 1) =: b
  2286  (1626)              logPut(dev, b)
  2287  (1627)          ENDFOR
  2288  (1628)  
  2289  (1629)          % The number, most significant digit first. Built backwards into
  2290  (1630)          % logDigits and then written forwards, because dividing gives the
  2291  (1631)          % LAST digit first and a log line read by a person wants them the
  2292  (1632)          % other way round.
  2293  (1633)          %
  2294  (1634)          % Negative values are printed with a minus and then their magnitude.
  2295  (1635)          % A status word can be negative on this wire and "-34" is readable
  2296  (1636)          % where the unsigned form is not.
  2297  (1637)          value =: left
  2298  (1638)          IF left < 0 THEN
  2299  (1639)              logPut(dev, logMinus)
  2300  (1640)              0 - left =: left
  2301  (1641)          ENDIF
  2302  (1642)  
  2303  (1643)          % NO "MOD" - it appears nowhere in this file and is not going to be
  2304  (1644)          % introduced on a guess. putNumber above gets its digits by dividing
  2305  (1645)          % and subtracting, so this does the same.
  2306  (1646)          0 =: digitCount
  2307  (1647)          % A do-while shape, so zero prints as "0" rather than as nothing.
  2308  (1648)          DO
  2309  (1649)              left / 10 =: rest
  2310  (1650)              left - rest * 10 =: digit
  2311  (1651)              zeroByte(0) + digit =: logDigits(digitCount)
  2312  (1652)              digitCount + 1 =: digitCount
  2313  (1653)              rest =: left
  2314  (1654)              WHILE left > 0
  2315  (1655)          ENDDO
  2316  (1656)  
  2317  (1657)          FOR i IN 1:digitCount DO
  2318  (1658)              logDigits(digitCount - i) =: b
  2319  (1659)              logPut(dev, b)
  2320  (1660)          ENDFOR
  2321  (1661)  
  2322  (1662)          % THE CARRIAGE RETURN MATTERS - a SINTRAN text file is expected to
  2323  (1663)          % have one, and without it every line runs into the next. It carries
  2324  (1664)          % parity like every other byte; QED counts it as part of the line.
  2325  (1665)          logPut(dev, logCr)
  2326  (1666)          logPut(dev, logLf)
  2327  (1667)  
  2328  (1668)          % CLOSE, ALWAYS, including after a failed write - see the note on the
  2329  (1669)          % open. An unclosed file keeps its old contents.
  2330  (1670)          MON43(dev)
  2331  (1671)  
  2332  (1672)          IF writeFailed THEN
  2333  (1673)              TRUE =: logBroken
  2334  (1674)          ENDIF
  2335  (1675)      ENDROUTINE
  2336  (1676)  
  2337  (1677)      % -----------------------------------------------------------------------
  2338  (1678)      % Compare a name in the room against one in a buffer, ignoring case.
  2339  (1679)      %
  2340  (1680)      % ChatRoom.cs compares ignoring case, so this does too - the two doors into
  2341  (1681)      % one room must not disagree about whether ANNA and anna are the same
  2342  (1682)      % person.
  2343  (1683)      % -----------------------------------------------------------------------
  2344  (1684)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : sameName(slot, at, length)
  2345  (1685)          INTEGER : j, a, b
  2346  (1686)          IF memberLen(slot) >< length THEN
  2347  (1687)              0 RETURN
  2348  (1688)          ENDIF
  2349  (1689)          FOR j IN 1:length DO
  2350  (1690)              memberName(slot, j) =: a
  2351  (1691)              inBuf(at + j - 1) =: b
  2352  (1692)              IF a > 96 THEN a - 32 =: a ENDIF        % fold lower case to upper
  2353  (1693)              IF b > 96 THEN b - 32 =: b ENDIF
  2354  (1694)              IF a >< b THEN
  2355  (1695)                  0 RETURN
  2356  (1696)              ENDIF
  2357  (1697)          ENDFOR
  2358  (1698)          1 RETURN
  2359  (1699)      ENDROUTINE
  2360  (1700)  
  2361  (1701)      ROUTINE VOID, INTEGER (INTEGER4) : findByMagic(magic)
  2362  (1702)          INTEGER : i
  2363  (1703)          FOR i IN 1:maxSeats DO
  2364  (1704)              IF memberUsed(i) >< 0 THEN
  2365  (1705)                  IF memberMagic(i) = magic THEN
  2366  (1706)                      i RETURN
  2367  (1707)                  ENDIF
  2368  (1708)              ENDIF
  2369  (1709)          ENDFOR
  2370  (1710)          0 RETURN
  2371  (1711)      ENDROUTINE
  2372  (1712)  
  2373  (1713)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findByName(at, length)
  2374  (1714)          INTEGER : i
  2375  (1715)          FOR i IN 1:maxSeats DO
  2376  (1716)              IF memberUsed(i) >< 0 THEN
  2377  (1717)                  IF sameName(i, at, length) = 1 THEN
  2378  (1718)                      i RETURN
  2379  (1719)                  ENDIF
  2380  (1720)              ENDIF
  2381  (1721)          ENDFOR
  2382  (1722)          0 RETURN
  2383  (1723)      ENDROUTINE
  2384  (1724)  
  2385  (1725)      ROUTINE VOID, INTEGER : freeSlot
  2386  (1726)          INTEGER : i
  2387  (1727)          FOR i IN 1:maxSeats DO
  2388  (1728)              IF memberUsed(i) = 0 THEN
  2389  (1729)                  i RETURN
  2390  (1730)              ENDIF
  2391  (1731)          ENDFOR
  2392  (1732)          0 RETURN
  2393  (1733)      ENDROUTINE
  2394  (1734)  
  2395  (1735)      % -----------------------------------------------------------------------
  2396  (1736)      % Build a message into outBuf. Returns its total length.
  2397  (1737)      % -----------------------------------------------------------------------
  2398  (1738)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER) : &
  2399  (1739)              buildMessage(kind, nameAt, nameLength, textAt, textLength)
  2400  (1740)          INTEGER : i, at
  2401  (1741)          kind =: outBuf(0)
  2402  (1742)          nameLength =: outBuf(1)
  2403  (1743)          2 =: at
  2404  (1744)          FOR i IN 1:nameLength DO
  2405  (1745)              inBuf(nameAt + i - 1) =: outBuf(at)
  2406  (1746)              at + 1 =: at
  2407  (1747)          ENDFOR
  2408  (1748)          0 =: outBuf(at)                       % text length, high byte
  2409  (1749)          textLength =: outBuf(at + 1)          % text length, low byte
  2410  (1750)          at + 2 =: at
  2411  (1751)          FOR i IN 1:textLength DO
  2412  (1752)              inBuf(textAt + i - 1) =: outBuf(at)
  2413  (1753)              at + 1 =: at
  2414  (1754)          ENDFOR
  2415  (1755)          at RETURN
  2416  (1756)      ENDROUTINE
  2417  (1757)  
  2418  (1758)      % -----------------------------------------------------------------------
  2419  (1759)      % Print a name that arrived in inBuf, one byte at a time.
  2420  (1760)      %
  2421  (1761)      % Byte by byte because 'ALn' formats a STRING: handing it a single byte
  2422  (1762)      % prints the byte's NUMBER, not the character. A one-element BYTES is the
  2423  (1763)      % way across, the same trick the space separator in buildWho uses.
  2424  (1764)      % -----------------------------------------------------------------------
  2425  (1765)      % -----------------------------------------------------------------------
  2426  (1766)      % Write a small number into outBuf as decimal digits, advancing at.
  2427  (1767)      %
  2428  (1768)      % By hand because there is no formatter that writes into a BYTES array -
  2429  (1769)      % OUTPUT goes to a device, not a buffer. Handles 0..999, which covers a
  2430  (1770)      % seat count and every counter this status line is likely to grow.
  2431  (1771)      % -----------------------------------------------------------------------
  2432  (1772)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : putNumber(value, at)
  2433  (1773)          INTEGER : left, digit, p
  2434  (1774)          BOOLEAN : started
  2435  (1775)  
  2436  (1776)          % RETURNS THE NEW CURSOR rather than writing through an INTEGER WRITE
  2437  (1777)          % parameter. The WRITE form was assumed to advance the CALLER's variable
  2438  (1778)          % and did not: the status line came out "SEATS 016" instead of
  2439  (1779)          % "SEATS 0/16" - the separator was written where the previous digit had
  2440  (1780)          % gone, and the length came out short. MEASURED on D100 2026-08-20.
  2441  (1781)          %
  2442  (1782)          % Returning the cursor is the idiom buildMessage and buildWho already
  2443  (1783)          % use in this file ("at RETURN"), and it cannot be got wrong by the
  2444  (1784)          % caller in the same silent way.
  2445  (1785)          at =: p
  2446  (1786)          value =: left
  2447  (1787)          FALSE =: started
  2448  (1788)  
  2449  (1789)          % Leading digits are skipped until a non-zero one appears, so 7
  2450  (1790)          % prints as "7" and not "00007". Zero itself still has to print, which
  2451  (1791)          % the final digit below always does.
  2452  (1792)          %
  2453  (1793)          % FIVE DIGITS, NOT THREE. Until 2026-09-02 this started at the hundreds,
  2454  (1794)          % and a counter past 999 printed its "hundreds digit" as value/100 -
  2455  (1795)          % 63 for 6345 - added to '0', which is the letter 'o'. STATUS on D100
  2456  (1796)          % read "empty o45" and, an hour later, "empty r36": a climbing count
  2457  (1797)          % disguised as a mystery letter. An INTEGER is 16-bit signed, so 32767
  2458  (1798)          % is the most this can ever be asked to print, and five digits cover it.
  2459  (1799)          left / 10000 =: digit
  2460  (1800)          IF digit > 0 THEN
  2461  (1801)              zeroByte(0) + digit =: outBuf(p)
  2462  (1802)              p + 1 =: p
  2463  (1803)              TRUE =: started
  2464  (1804)              left - digit * 10000 =: left
  2465  (1805)          ENDIF
  2466  (1806)  
  2467  (1807)          left / 1000 =: digit
  2468  (1808)          IF digit > 0 OR started THEN
  2469  (1809)              zeroByte(0) + digit =: outBuf(p)
  2470  (1810)              p + 1 =: p
  2471  (1811)              TRUE =: started
  2472  (1812)              left - digit * 1000 =: left
  2473  (1813)          ENDIF
  2474  (1814)  
  2475  (1815)          left / 100 =: digit
  2476  (1816)          IF digit > 0 OR started THEN
  2477  (1817)              zeroByte(0) + digit =: outBuf(p)
  2478  (1818)              p + 1 =: p
  2479  (1819)              TRUE =: started
  2480  (1820)              left - digit * 100 =: left
  2481  (1821)          ENDIF
  2482  (1822)  
  2483  (1823)          left / 10 =: digit
  2484  (1824)          IF digit > 0 OR started THEN
  2485  (1825)              zeroByte(0) + digit =: outBuf(p)
  2486  (1826)              p + 1 =: p
  2487  (1827)              left - digit * 10 =: left
  2488  (1828)          ENDIF
  2489  (1829)  
  2490  (1830)          zeroByte(0) + left =: outBuf(p)
  2491  (1831)          p + 1 =: p
  2492  (1832)          p RETURN
  2493  (1833)      ENDROUTINE
  2494  (1834)  
  2495  (1835)      % -----------------------------------------------------------------------
  2496  (1836)      % Write a system number into peerName and return the new cursor.
  2497  (1837)      %
  2498  (1838)      % A SEPARATE ROUTINE FROM putNumber, and not a tidiness failure: putNumber
  2499  (1839)      % writes into outBuf, which is the message being built. A system name is not
  2500  (1840)      % part of any message - it goes to XMPBLET - so it needs its own buffer, and
  2501  (1841)      % a routine that took the buffer as a parameter would be handing a BYTES
  2502  (1842)      % formal parameter around, which this compiler is fussy about in exactly the
  2503  (1843)      % area that already cost three cycles here.
  2504  (1844)      % -----------------------------------------------------------------------
  2505  (1845)      % =======================================================================
  2506  (1846)      % WHAT TO CALL A MACHINE
  2507  (1847)      %
  2508  (1848)      % The name if we know one, and D<number> if we do not. Four places used to
  2509  (1849)      % write the D and the digits by hand and they are now all this routine, so
  2510  (1850)      % a machine cannot be called one thing in /who and another in the chat.
  2511  (1851)      %
  2512  (1852)      % THE NUMBER IS STILL WHAT DECIDES WHICH MACHINE IT IS. A name is only a
  2513  (1853)      % LABEL looked up from that number, and the number comes from the kernel's
  2514  (1854)      % own magic, never from anything a sender claims. So a machine can choose
  2515  (1855)      % what it is called and still cannot claim to BE another machine - which is
  2516  (1856)      % the property the trunk protocol was built around and must not lose.
  2517  (1857)      %
  2518  (1858)      % THE PEER SCAN IS WRITTEN OUT HERE rather than calling findPeer, and that
  2519  (1859)      % is not laziness: findPeer is declared 1800 lines further down, and PLANC
  2520  (1860)      % wants a routine declared before it is called. Two of the four callers sit
  2521  (1861)      % above it.
  2522  (1862)      % =======================================================================
  2523  (1863)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : putSysLabel(sysNum, at)
  2524  (1864)          INTEGER : p, i, j, row
  2525  (1865)  
  2526  (1866)          at =: p
  2527  (1867)  
  2528  (1868)          IF sysNum = mySystem THEN
  2529  (1869)              IF lenSysName > 0 THEN
  2530  (1870)                  FOR i IN 1:lenSysName DO
  2531  (1871)                      sysName(i - 1) =: outBuf(p)
  2532  (1872)                      p + 1 =: p
  2533  (1873)                  ENDFOR
  2534  (1874)                  p RETURN
  2535  (1875)              ENDIF
  2536  (1876)          ELSE
  2537  (1877)              0 =: row
  2538  (1878)              FOR i IN 1:maxPeers DO
  2539  (1879)                  IF peerSystem(i) = sysNum THEN
  2540  (1880)                      IF row = 0 THEN
  2541  (1881)                          i =: row
  2542  (1882)                      ENDIF
  2543  (1883)                  ENDIF
  2544  (1884)              ENDFOR
  2545  (1885)              IF row > 0 THEN
  2546  (1886)                  IF pNameLen(row) > 0 THEN
  2547  (1887)                      FOR j IN 1:pNameLen(row) DO
  2548  (1888)                          pName(row, j) =: outBuf(p)
  2549  (1889)                          p + 1 =: p
  2550  (1890)                      ENDFOR
  2551  (1891)                      p RETURN
  2552  (1892)                  ENDIF
  2553  (1893)              ENDIF
  2554  (1894)          ENDIF
  2555  (1895)  
  2556  (1896)          % Nobody has said what it is called. The number is what the kernel
  2557  (1897)          % vouches for, so that is what gets printed.
  2558  (1898)          dByte(0) =: outBuf(p)
  2559  (1899)          p + 1 =: p
  2560  (1900)          putNumber(sysNum, p) =: p
  2561  (1901)          p RETURN
  2562  (1902)      ENDROUTINE
  2563  (1903)  
  2564  (1904)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : putPeerDigits(value, at)
  2565  (1905)          INTEGER : left, digit, p
  2566  (1906)          BOOLEAN : started
  2567  (1907)  
  2568  (1908)          at =: p
  2569  (1909)          value =: left
  2570  (1910)          FALSE =: started
  2571  (1911)  
  2572  (1912)          left / 10000 =: digit
  2573  (1913)          IF digit > 0 THEN
  2574  (1914)              zeroByte(0) + digit =: peerName(p)
  2575  (1915)              p + 1 =: p
  2576  (1916)              TRUE =: started
  2577  (1917)              left - digit * 10000 =: left
  2578  (1918)          ENDIF
  2579  (1919)  
  2580  (1920)          left / 1000 =: digit
  2581  (1921)          IF digit > 0 OR started THEN
  2582  (1922)              zeroByte(0) + digit =: peerName(p)
  2583  (1923)              p + 1 =: p
  2584  (1924)              TRUE =: started
  2585  (1925)              left - digit * 1000 =: left
  2586  (1926)          ENDIF
  2587  (1927)  
  2588  (1928)          left / 100 =: digit
  2589  (1929)          IF digit > 0 OR started THEN
  2590  (1930)              zeroByte(0) + digit =: peerName(p)
  2591  (1931)              p + 1 =: p
  2592  (1932)              TRUE =: started
  2593  (1933)              left - digit * 100 =: left
  2594  (1934)          ENDIF
  2595  (1935)  
  2596  (1936)          left / 10 =: digit
  2597  (1937)          IF digit > 0 OR started THEN
  2598  (1938)              zeroByte(0) + digit =: peerName(p)
  2599  (1939)              p + 1 =: p
  2600  (1940)              left - digit * 10 =: left
  2601  (1941)          ENDIF
  2602  (1942)  
  2603  (1943)          zeroByte(0) + left =: peerName(p)
  2604  (1944)          p + 1 =: p
  2605  (1945)          p RETURN
  2606  (1946)      ENDROUTINE
  2607  (1947)  
  2608  (1948)      % -----------------------------------------------------------------------
  2609  (1949)      % Write a fixed word into outBuf and return the new cursor.
  2610  (1950)      %
  2611  (1951)      % Same "at RETURN" idiom as putNumber, and for the same reason: a WRITE
  2612  (1952)      % parameter looks like it advances the caller's cursor and does not.
  2613  (1953)      %
  2614  (1954)      % SUBSCRIPT FROM ZERO - a BYTES from a literal starts at index 0. See
  2615  (1955)      % buildAdmText.
  2616  (1956)      % -----------------------------------------------------------------------
  2617  (1957)      % The length is DERIVED, not passed - see buildAdmText for the whole
  2618  (1958)      % argument. Twenty-nine callers used to type the count beside the literal.
  2619  (1959)      ROUTINE VOID, INTEGER (BYTES, INTEGER) : putWord(text, at)
  2620  (1960)          INTEGER : i, p, textLen
  2621  (1961)          MAXINDEX(text, 1) + 1 =: textLen
  2622  (1962)          at =: p
  2623  (1963)          FOR i IN 1:textLen DO
  2624  (1964)              text(i - 1) =: outBuf(p)
  2625  (1965)              p + 1 =: p
  2626  (1966)          ENDFOR
  2627  (1967)          p RETURN
  2628  (1968)      ENDROUTINE
  2629  (1969)  
  2630  (1970)      ROUTINE VOID, VOID (INTEGER, INTEGER) : showName(nameAt, nameLength)
  2631  (1971)          INTEGER : i
  2632  (1972)          FOR i IN 1:nameLength DO
  2633  (1973)              inBuf(nameAt + i - 1) =: oneByte
  2634  (1974)              OUTPUT(1, 'AL1', oneByte)
  2635  (1975)          ENDFOR
  2636  (1976)      ENDROUTINE
  2637  (1977)  
  2638  (1978)      % -----------------------------------------------------------------------
  2639  (1979)      % Build the answer to an AdminStatus: how the room stands, as readable
  2640  (1980)      % text.
  2641  (1981)      %
  2642  (1982)      % TEXT, NOT A STRUCT OF COUNTERS, and that is a decision rather than
  2643  (1983)      % laziness. What is worth reporting grows with every phase of federation -
  2644  (1984)      % peers, trunk states, hop counts - and a text answer lets it grow without
  2645  (1985)      % changing the wire and re-pinning the golden bytes each time.
  2646  (1986)      %
  2647  (1987)      % The name field is EMPTY: the server is answering, not a member.
  2648  (1988)      % -----------------------------------------------------------------------
  2649  (1989)      ROUTINE VOID, INTEGER : buildStatus
  2650  (1990)          INTEGER : i, j, at, seated, textAt, textLen
  2651  (1991)          % kbTotal counts BLOCKS while it is being summed and is turned into KB
  2652  (1992)          % once, at the end. held is how many messages a room actually has.
  2653  (1993)          INTEGER : kbTotal, held
  2654  (1994)  
  2655  (1995)          0 =: seated
  2656  (1996)          FOR i IN 1:maxSeats DO
  2657  (1997)              IF memberUsed(i) = 1 THEN
  2658  (1998)                  seated + 1 =: seated
  2659  (1999)              ENDIF
  2660  (2000)          ENDFOR
  2661  (2001)  
  2662  (2002)          kAdmRepl =: outBuf(0)
  2663  (2003)          0 =: outBuf(1)                        % no name: the SERVER is answering
  2664  (2004)          2 =: at
  2665  (2005)          0 =: outBuf(at)                       % text length, high byte
  2666  (2006)          0 =: outBuf(at + 1)                   % text length, low byte, filled below
  2667  (2007)          at + 2 =: textAt
  2668  (2008)          textAt =: at
  2669  (2009)  
  2670  (2010)          % "SEATS n/m" - taken and offered. Two numbers, because "3 seats used"
  2671  (2011)          % does not say whether the room is full, and full is the case an
  2672  (2012)          % operator is asking about.
  2673  (2013)          FOR j IN 0:5 DO
  2674  (2014)              statusWord(j) =: outBuf(at)
  2675  (2015)              at + 1 =: at
  2676  (2016)          ENDFOR
  2677  (2017)          putNumber(seated, at) =: at
  2678  (2018)          slashByte(0) =: outBuf(at)
  2679  (2019)          at + 1 =: at
  2680  (2020)          putNumber(maxSeats, at) =: at
  2681  (2021)  
  2682  (2022)          % THIS SERVER'S OWN BUILD - beside the seat count so a stale client
  2683  (2023)          % and a fresh server show up together in one command, not two
  2684  (2024)          % FILE-STATISTICS calls compared by eye.
  2685  (2025)          putWord('  build ', at) =: at
  2686  (2026)          FOR j IN 1:lenServerVer DO
  2687  (2027)              serverVersion(j - 1) =: outBuf(at)
  2688  (2028)              at + 1 =: at
  2689  (2029)          ENDFOR
  2690  (2030)  
  2691  (2031)          % ---- AND WHAT THE HISTORY IS DOING ---------------------------------
  2692  (2032)          %
  2693  (2033)          % Ronny asked for three things here, 2026-08-23: what each room keeps
  2694  (2034)          % and holds, what a NEW room would get, and how much disk it all comes
  2695  (2035)          % to. He chose reporting over a total that refuses - eight rooms at the
  2696  (2036)          % 200 ceiling is 800KB, which is nothing on this disk, and a second
  2697  (2037)          % limit is a second thing that can turn down a reasonable request.
  2698  (2038)          %
  2699  (2039)          %   SEATS 2/16  default 50  disk 31KB  LOBBY 50/12 GENERAL 20/3
  2700  (2040)          %
  2701  (2041)          % BLOCKS ARE COUNTED, NOT FILE SIZES. A ring's file is its full size
  2702  (2042)          % from the day it is made, so asking the file system would report what
  2703  (2043)          % was RESERVED. What an operator wants to know is what it will cost,
  2704  (2044)          % and that is size x 512 whether the ring is full yet or not.
  2705  (2045)          %
  2706  (2046)          % HELD is "how many are actually in there" - histNext when the ring has
  2707  (2047)          % not wrapped, the size once it has. Two numbers because 50/12 says a
  2708  (2048)          % room is a quarter full, where 12 alone does not say what of.
  2709  (2049)          putWord('  default ', at) =: at
  2710  (2050)          putNumber(histDefault, at) =: at
  2711  (2051)  
  2712  (2052)          0 =: kbTotal
  2713  (2053)          FOR i IN 1:maxHistRooms DO
  2714  (2054)              IF topicRmLen(i) > 0 THEN
  2715  (2055)                  kbTotal + histSize(i) =: kbTotal
  2716  (2056)              ENDIF
  2717  (2057)          ENDFOR
  2718  (2058)          putWord('  disk ', at) =: at
  2719  (2059)          putNumber(kbTotal / 2, at) =: at        % blocks of 512 bytes -> KB
  2720  (2060)          putWord('KB', at) =: at
  2721  (2061)  
  2722  (2062)          % ---- THE THREE COUNTS THAT USED TO BE A FLOOD ----------------------
  2723  (2063)          % empty  routed letters with no payload. One per seat returned, because
  2724  (2064)          %        XROUT's answer comes back on our own port looking like that.
  2725  (2065)          %        Climbing while the room is quiet is the seat feedback loop.
  2726  (2066)          % bounce messages that came home with nobody there - dead clients.
  2727  (2067)          % refuse joins turned away, whatever the reason.
  2728  (2068)          % relay  lines passed ON to a further peer. A machine in the MIDDLE of
  2729  (2069)          %        a chain shows this climbing; an END machine shows it flat at
  2730  (2070)          %        zero, so a non-zero count on an end machine means the topology
  2731  (2071)          %        is not what somebody believes it is.
  2732  (2072)          %
  2733  (2073)          % Before this they printed a line each, every time, and the terminal
  2734  (2074)          % filled with the two that are expected. A number you can ask for beats
  2735  (2075)          % a line you cannot avoid.
  2736  (2076)          putWord('  empty ', at) =: at
  2737  (2077)          putNumber(nEmptyLet, at) =: at
  2738  (2078)          putWord(' bounce ', at) =: at
  2739  (2079)          putNumber(nBounced, at) =: at
  2740  (2080)          putWord(' relay ', at) =: at
  2741  (2081)          putNumber(nRelayed, at) =: at
  2742  (2082)  
  2743  (2083)          % FWD is what a LOCAL speaker sent onward; BAD is how many of those the
  2744  (2084)          % send refused. relay above is a different path entirely - see the note
  2745  (2085)          % on nForwarded.
  2746  (2086)          putWord(' fwd ', at) =: at
  2747  (2087)          putNumber(nForwarded, at) =: at
  2748  (2088)          putWord(' fwdbad ', at) =: at
  2749  (2089)          putNumber(nFwdBad, at) =: at
  2750  (2090)          putWord(' dupe ', at) =: at
  2751  (2091)          putNumber(nDupes, at) =: at
  2752  (2092)          putWord(' refuse ', at) =: at
  2753  (2093)          putNumber(nRefused, at) =: at
  2754  (2094)  
  2755  (2095)          FOR i IN 1:maxHistRooms DO
  2756  (2096)              IF topicRmLen(i) > 0 THEN
  2757  (2097)                  % Bounded like every other builder here: a name plus two
  2758  (2098)                  % numbers is at most 25 bytes, and outBuf's text field is 250.
  2759  (2099)                  IF at - textAt < 215 THEN
  2760  (2100)                      spaceByte(0) =: outBuf(at)
  2761  (2101)                      at + 1 =: at
  2762  (2102)                      FOR j IN 1:topicRmLen(i) DO
  2763  (2103)                          topicRoom(i, j) =: outBuf(at)
  2764  (2104)                          at + 1 =: at
  2765  (2105)                      ENDFOR
  2766  (2106)                      spaceByte(0) =: outBuf(at)
  2767  (2107)                      at + 1 =: at
  2768  (2108)                      putNumber(histSize(i), at) =: at
  2769  (2109)                      slashByte(0) =: outBuf(at)
  2770  (2110)                      at + 1 =: at
  2771  (2111)  
  2772  (2112)                      histNext(i) =: held
  2773  (2113)                      IF held > histSize(i) THEN
  2774  (2114)                          histSize(i) =: held     % wrapped: it holds a full ring
  2775  (2115)                      ENDIF
  2776  (2116)                      putNumber(held, at) =: at
  2777  (2117)                  ENDIF
  2778  (2118)              ENDIF
  2779  (2119)          ENDFOR
  2780  (2120)  
  2781  (2121)          at - textAt =: textLen
  2782  (2122)          textLen =: outBuf(3)                  % low byte; it cannot reach 256
  2783  (2123)          at RETURN
  2784  (2124)      ENDROUTINE
  2785  (2125)  
  2786  (2126)      % -----------------------------------------------------------------------
  2787  (2127)      % Build a kAdmRepl carrying one fixed sentence.
  2788  (2128)      %
  2789  (2129)      % SUBSCRIPT FROM ZERO. A BYTES declared from a literal has its first
  2790  (2130)      % character at index 0, so "text(i)" for i in 1:len drops the first letter
  2791  (2131)      % and reads one byte past the end. That defect turned RONNY into ONNY on the
  2792  (2132)      % wire once already; see the note in refuse().
  2793  (2133)      % -----------------------------------------------------------------------
  2794  (2134)      % THE LENGTH IS NOT A PARAMETER - THE STRING IS ASKED FOR IT.
  2795  (2135)      %
  2796  (2136)      % Every caller passes a literal, and each one used to hand the count in
  2797  (2137)      % beside it. Eighteen hand-typed numbers that nothing could check: change a
  2798  (2138)      % word in a message and the number beside it is silently wrong, the build is
  2799  (2139)      % clean, and the reply goes out truncated or padded. That is the same trap
  2800  (2140)      % as an 'ALn' field width, which cost five wrong widths in one sitting.
  2801  (2141)      %
  2802  (2142)      % MAXINDEX(text, 1) is the DECLARED UPPER BOUND of the parameter, and a
  2803  (2143)      % string literal subscripts from ZERO, so the length is that plus one. It is
  2804  (2144)      % a STANDARD routine the compiler provides - no IMPORT - and it works on an
  2805  (2145)      % array parameter, which is exactly what this is. (It is NOT available in a
  2806  (2146)      % STANDARD routine, the FORTRAN calling sequence; this is an ordinary PLANC
  2807  (2147)      % one, so it is fine.)
  2808  (2148)      ROUTINE VOID, INTEGER (BYTES) : buildAdmText(text)
  2809  (2149)          INTEGER : i, at, textLen
  2810  (2150)          MAXINDEX(text, 1) + 1 =: textLen
  2811  (2151)          kAdmRepl =: outBuf(0)
  2812  (2152)          0 =: outBuf(1)                        % no name: the SERVER is answering
  2813  (2153)          2 =: at
  2814  (2154)          0 =: outBuf(at)
  2815  (2155)          textLen =: outBuf(at + 1)
  2816  (2156)          at + 2 =: at
  2817  (2157)          FOR i IN 1:textLen DO
  2818  (2158)              text(i - 1) =: outBuf(at)
  2819  (2159)              at + 1 =: at
  2820  (2160)          ENDFOR
  2821  (2161)          at RETURN
  2822  (2162)      ENDROUTINE
  2823  (2163)  
  2824  (2164)      % -----------------------------------------------------------------------
  2825  (2165)      % Read a decimal system number out of an arrived message. 0 means "that was
  2826  (2166)      % not a number", which the caller reports rather than acting on.
  2827  (2167)      %
  2828  (2168)      % NO SIGN AND NO SPACES. An operator types "TRUNK 102"; anything else is a
  2829  (2169)      % mistake worth refusing out loud rather than interpreting generously.
  2830  (2170)      % -----------------------------------------------------------------------
  2831  (2171)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : trunkNumber(at, length)
  2832  (2172)          INTEGER : i, d, value
  2833  (2173)          IF length < 1 THEN
  2834  (2174)              0 RETURN
  2835  (2175)          ENDIF
  2836  (2176)          0 =: value
  2837  (2177)          FOR i IN 1:length DO
  2838  (2178)              inBuf(at + i - 1) =: d
  2839  (2179)              IF d < 48 THEN
  2840  (2180)                  0 RETURN
  2841  (2181)              ENDIF
  2842  (2182)              IF d > 57 THEN
  2843  (2183)                  0 RETURN
  2844  (2184)              ENDIF
  2845  (2185)              (value * 10) + (d - 48) =: value
  2846  (2186)          ENDFOR
  2847  (2187)          value RETURN
  2848  (2188)      ENDROUTINE
  2849  (2189)  
  2850  (2190)  
  2851  (2191)      % -----------------------------------------------------------------------
  2852  (2192)      % LIST-TRUNKS: every configured peer and what we believe about it.
  2853  (2193)      %
  2854  (2194)      % "102 up" / "103 down" / "200 unknown". UNKNOWN and DOWN are kept apart
  2855  (2195)      % deliberately - the first usually means the trunk was never answered and is
  2856  (2196)      % probably a configuration mistake, the second means a machine that was
  2857  (2197)      % there and went away. Collapsing them would hide the difference exactly
  2858  (2198)      % when an operator needs it.
  2859  (2199)      % -----------------------------------------------------------------------
  2860  (2200)      % The answer to SET-NAME, in words. buildAdmText cannot do this one - it
  2861  (2201)      % takes a literal and a length, and this has a variable in the middle.
  2862  (2202)      % THE WELCOME NOW SAYS WHICH MACHINE THE CLIENT IS ON.
  2863  (2203)      %
  2864  (2204)      % It used to carry the joiner's name and an EMPTY text, and the client
  2865  (2205)      % ignored the text entirely - so filling it in is backward compatible: an
  2866  (2206)      % older client reads the name, reads a length, and does nothing with what
  2867  (2207)      % follows.
  2868  (2208)      %
  2869  (2209)      % WHY IT HAS TO COME FROM HERE. A client has NO WAY of knowing which
  2870  (2210)      % machine it is on. /map says so, but in a sentence written for a person to
  2871  (2211)      % read, and parsing prose to find out a fact is how a client ends up wrong
  2872  (2212)      % in a way nobody can explain. The server knows for certain - it asked the
  2873  (2213)      % kernel - so it says so at the one moment the client is guaranteed to be
  2874  (2214)      % listening.
  2875  (2215)      %
  2876  (2216)      % This is what lets a full-screen client put ANNA@FJELL in its corner
  2877  (2217)      % instead of leaving it blank or, worse, guessing.
  2878  (2218)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : buildWelcome(nameAt, nameLength)
  2879  (2219)          INTEGER : i, at, textAt, textLen
  2880  (2220)  
  2881  (2221)          kWelcome =: outBuf(0)
  2882  (2222)          nameLength =: outBuf(1)
  2883  (2223)          2 =: at
  2884  (2224)          FOR i IN 1:nameLength DO
  2885  (2225)              inBuf(nameAt + i - 1) =: outBuf(at)
  2886  (2226)              at + 1 =: at
  2887  (2227)          ENDFOR
  2888  (2228)  
  2889  (2229)          0 =: outBuf(at)
  2890  (2230)          0 =: outBuf(at + 1)
  2891  (2231)          at + 2 =: textAt
  2892  (2232)          textAt =: at
  2893  (2233)  
  2894  (2234)          putSysLabel(mySystem, at) =: at
  2895  (2235)  
  2896  (2236)          at - textAt =: textLen
  2897  (2237)          textLen =: outBuf(textAt - 1)
  2898  (2238)          at RETURN
  2899  (2239)      ENDROUTINE
  2900  (2240)  
  2901  (2241)      ROUTINE VOID, INTEGER : buildNameReply
  2902  (2242)          INTEGER : i, at, textAt, textLen
  2903  (2243)  
  2904  (2244)          kAdmRepl =: outBuf(0)
  2905  (2245)          0 =: outBuf(1)
  2906  (2246)          2 =: at
  2907  (2247)          0 =: outBuf(at)
  2908  (2248)          0 =: outBuf(at + 1)
  2909  (2249)          at + 2 =: textAt
  2910  (2250)          textAt =: at
  2911  (2251)  
  2912  (2252)          IF lenSysName > 0 THEN
  2913  (2253)              putWord('this machine is now ', at) =: at
  2914  (2254)              FOR i IN 1:lenSysName DO
  2915  (2255)                  sysName(i - 1) =: outBuf(at)
  2916  (2256)                  at + 1 =: at
  2917  (2257)              ENDFOR
  2918  (2258)          ELSE
  2919  (2259)              putWord('this machine has no name - it answers to ', at) =: at
  2920  (2260)              putSysLabel(mySystem, at) =: at
  2921  (2261)          ENDIF
  2922  (2262)  
  2923  (2263)          at - textAt =: textLen
  2924  (2264)          textLen =: outBuf(3)
  2925  (2265)          at RETURN
  2926  (2266)      ENDROUTINE
  2927  (2267)  
  2928  (2268)      % ONE TRUNK PER LINE, IN FIXED COLUMNS.
  2929  (2269)      %
  2930  (2270)      % This used to run every trunk together on one line separated by a single
  2931  (2271)      % space - "100 FJELL up 103 SKOGEN down" - with both fields as wide as
  2932  (2272)      % whatever happened to be in them, so nothing lined up and two trunks read
  2933  (2273)      % as one sentence. Reported by Ronny 2026-08-31.
  2934  (2274)      %
  2935  (2275)      % THE LINE BREAK IS A BYTE IN THE TEXT, not a second message. The whole
  2936  (2276)      % answer travels as ONE kAdmRepl and CHAT-MON prints it byte by byte, so a
  2937  (2277)      % break has to be something the PRINTER recognises: an LF, which showAnswer
  2938  (2278)      % turns into a CRLF. That costs no new kind and no wire change, and it fixes
  2939  (2279)      % EVERY listing carried on kAdmRepl rather than only this one.
  2940  (2280)      %
  2941  (2281)      % THE WIDTHS ARE NAMED, and the name field is ASKED OF THE DATA rather than
  2942  (2282)      % typed: maxNameLen is what pName is declared to hold, so the column cannot
  2943  (2283)      % drift from the buffer the way a hand-written 16 would.
  2944  (2284)      ROUTINE VOID, INTEGER : buildTrunks
  2945  (2285)          INTEGER : i, j, at, textAt, textLen, st, fieldAt
  2946  (2286)  
  2947  (2287)          kAdmRepl =: outBuf(0)
  2948  (2288)          0 =: outBuf(1)
  2949  (2289)          2 =: at
  2950  (2290)          0 =: outBuf(at)
  2951  (2291)          0 =: outBuf(at + 1)
  2952  (2292)          at + 2 =: textAt
  2953  (2293)          textAt =: at
  2954  (2294)  
  2955  (2295)          FOR i IN 1:maxPeers DO
  2956  (2296)              IF peerSystem(i) >< 0 THEN
  2957  (2297)                  % A BREAK BEFORE EVERY LINE BUT THE FIRST, so the text never
  2958  (2298)                  % ENDS with one - a trailing break prints a blank line under
  2959  (2299)                  % every listing.
  2960  (2300)                  IF at - textAt > 0 THEN
  2961  (2301)                      lineBreak =: outBuf(at)
  2962  (2302)                      at + 1 =: at
  2963  (2303)                  ENDIF
  2964  (2304)  
  2965  (2305)                  % The system number, in a field of its own.
  2966  (2306)                  at =: fieldAt
  2967  (2307)                  putNumber(peerSystem(i), at) =: at
  2968  (2308)                  DO
  2969  (2309)                      WHILE at - fieldAt < idWide
  2970  (2310)                      spaceByte(0) =: outBuf(at)
  2971  (2311)                      at + 1 =: at
  2972  (2312)                  ENDDO
  2973  (2313)  
  2974  (2314)                  % The name, padded to the widest this server can hold, so the
  2975  (2315)                  % state word starts at the same column on every line - including
  2976  (2316)                  % the lines where the peer has no name yet.
  2977  (2317)                  at =: fieldAt
  2978  (2318)                  IF pNameLen(i) > 0 THEN
  2979  (2319)                      FOR j IN 1:pNameLen(i) DO
  2980  (2320)                          pName(i, j) =: outBuf(at)
  2981  (2321)                          at + 1 =: at
  2982  (2322)                      ENDFOR
  2983  (2323)                  ENDIF
  2984  (2324)                  DO
  2985  (2325)                      WHILE at - fieldAt < maxNameLen + 1
  2986  (2326)                      spaceByte(0) =: outBuf(at)
  2987  (2327)                      at + 1 =: at
  2988  (2328)                  ENDDO
  2989  (2329)  
  2990  (2330)                  peerState(i) =: st
  2991  (2331)                  IF st = peerUp THEN
  2992  (2332)                      putWord('up', at) =: at
  2993  (2333)                  ENDIF
  2994  (2334)                  IF st = peerDown THEN
  2995  (2335)                      putWord('down', at) =: at
  2996  (2336)                  ENDIF
  2997  (2337)                  IF st = peerUnknown THEN
  2998  (2338)                      putWord('unknown', at) =: at
  2999  (2339)                  ENDIF
  3000  (2340)  
  3001  (2341)                  % WHO PUT IT THERE. Only the LEARNED ones are marked, so the
  3002  (2342)                  % ordinary case - every trunk asked for by an operator - reads
  3003  (2343)                  % exactly as it always did. A "(learned)" beside a system
  3004  (2344)                  % nobody remembers configuring is the whole point: until now
  3005  (2345)                  % there was no way to tell the two apart at all.
  3006  (2346)                  IF peerFixed(i) = peerLearned THEN
  3007  (2347)                      spaceByte(0) =: outBuf(at)
  3008  (2348)                      at + 1 =: at
  3009  (2349)                      putWord('(learned)', at) =: at
  3010  (2350)                  ENDIF
  3011  (2351)              ENDIF
  3012  (2352)          ENDFOR
  3013  (2353)  
  3014  (2354)          IF at = textAt THEN
  3015  (2355)              putWord('no trunks', at) =: at
  3016  (2356)          ENDIF
  3017  (2357)  
  3018  (2358)          % AND WHETHER MORE CAN STILL ARRIVE. An operator reading this list needs
  3019  (2359)          % to know it is the whole list and not just the part that has turned up
  3020  (2360)          % so far - "locked" is the difference between a network and a snapshot.
  3021  (2361)          IF NOT peersOpen THEN
  3022  (2362)              % ON A LINE OF ITS OWN, and that is not decoration. This marker is
  3023  (2363)              % about the WHOLE LIST, not about one trunk. While the listing ran
  3024  (2364)              % everything together on one line that was clear enough; one trunk
  3025  (2365)              % per line puts it hard against the last entry, where it reads as
  3026  (2366)              % if THAT machine were the locked one. Seen on D102 the first time
  3027  (2367)              % the new layout ran:
  3028  (2368)              %
  3029  (2369)              %     100   FJELL            up
  3030  (2370)              %     103   SKOGEN           up [locked]
  3031  (2371)              %
  3032  (2372)              % A break costs one byte and removes the wrong reading.
  3033  (2373)              IF at - textAt > 0 THEN
  3034  (2374)                  lineBreak =: outBuf(at)
  3035  (2375)                  at + 1 =: at
  3036  (2376)              ENDIF
  3037  (2377)              putWord('[locked]', at) =: at
  3038  (2378)          ENDIF
  3039  (2379)  
  3040  (2380)          at - textAt =: textLen
  3041  (2381)          textLen =: outBuf(3)
  3042  (2382)          at RETURN
  3043  (2383)      ENDROUTINE
  3044  (2384)  
  3045  (2385)      % -----------------------------------------------------------------------
  3046  (2386)      % LIST-MEMBER - who is seated here right now, and which room.
  3047  (2387)      %
  3048  (2388)      % SAME COLUMN DISCIPLINE AS buildTrunks: the name padded to maxNameLen+1
  3049  (2389)      % so the room column lines up under every seat, ONE seat per line with
  3050  (2390)      % lineBreak between them, no trailing break. An operator's own listing -
  3051  (2391)      % dispatched only IF fromAdmin, same guard as DROP-MEMBER and LIST-TRUNKS.
  3052  (2392)      %
  3053  (2393)      % memberName/memberLen are the SAME arrays findByName searches and
  3054  (2394)      % DROP-MEMBER clears, so this listing is always what DROP-MEMBER can act
  3055  (2395)      % on - never a stale copy of it.
  3056  (2396)      % -----------------------------------------------------------------------
  3057  (2397)      ROUTINE VOID, INTEGER : buildSeats
  3058  (2398)          INTEGER : i, j, at, textAt, textLen, fieldAt
  3059  (2399)  
  3060  (2400)          kAdmRepl =: outBuf(0)
  3061  (2401)          0 =: outBuf(1)
  3062  (2402)          2 =: at
  3063  (2403)          0 =: outBuf(at)
  3064  (2404)          0 =: outBuf(at + 1)
  3065  (2405)          at + 2 =: textAt
  3066  (2406)          textAt =: at
  3067  (2407)  
  3068  (2408)          FOR i IN 1:maxSeats DO
  3069  (2409)              IF memberUsed(i) = 1 THEN
  3070  (2410)                  IF at - textAt > 0 THEN
  3071  (2411)                      lineBreak =: outBuf(at)
  3072  (2412)                      at + 1 =: at
  3073  (2413)                  ENDIF
  3074  (2414)  
  3075  (2415)                  % The name, padded to the widest this server can hold, so the
  3076  (2416)                  % room column starts at the same place on every line.
  3077  (2417)                  at =: fieldAt
  3078  (2418)                  IF memberLen(i) > 0 THEN
  3079  (2419)                      FOR j IN 1:memberLen(i) DO
  3080  (2420)                          memberName(i, j) =: outBuf(at)
  3081  (2421)                          at + 1 =: at
  3082  (2422)                      ENDFOR
  3083  (2423)                  ENDIF
  3084  (2424)                  DO
  3085  (2425)                      WHILE at - fieldAt < maxNameLen + 1
  3086  (2426)                      spaceByte(0) =: outBuf(at)
  3087  (2427)                      at + 1 =: at
  3088  (2428)                  ENDDO
  3089  (2429)  
  3090  (2430)                  % The room, padded the same way, so the version column also
  3091  (2431)                  % starts at the same place on every line.
  3092  (2432)                  at =: fieldAt
  3093  (2433)                  IF lenMbrRoom(i) > 0 THEN
  3094  (2434)                      FOR j IN 1:lenMbrRoom(i) DO
  3095  (2435)                          mbrRoom(i, j) =: outBuf(at)
  3096  (2436)                          at + 1 =: at
  3097  (2437)                      ENDFOR
  3098  (2438)                  ENDIF
  3099  (2439)                  DO
  3100  (2440)                      WHILE at - fieldAt < maxNameLen + 1
  3101  (2441)                      spaceByte(0) =: outBuf(at)
  3102  (2442)                      at + 1 =: at
  3103  (2443)                  ENDDO
  3104  (2444)  
  3105  (2445)                  % THE BUILD VERSION - blank for a client old enough to carry
  3106  (2446)                  % none, which is worth SEEING rather than hiding: a blank
  3107  (2447)                  % column is the visible difference between "matches" and
  3108  (2448)                  % "cannot say".
  3109  (2449)                  IF memberVerLen(i) > 0 THEN
  3110  (2450)                      FOR j IN 1:memberVerLen(i) DO
  3111  (2451)                          memberVer(i, j) =: outBuf(at)
  3112  (2452)                          at + 1 =: at
  3113  (2453)                      ENDFOR
  3114  (2454)                  ENDIF
  3115  (2455)              ENDIF
  3116  (2456)          ENDFOR
  3117  (2457)  
  3118  (2458)          IF at = textAt THEN
  3119  (2459)              putWord('no members', at) =: at
  3120  (2460)          ENDIF
  3121  (2461)  
  3122  (2462)          at - textAt =: textLen
  3123  (2463)          textLen =: outBuf(3)
  3124  (2464)          at RETURN
  3125  (2465)      ENDROUTINE
  3126  (2466)  
  3127  (2467)      % -----------------------------------------------------------------------
  3128  (2468)      % /map - the same picture, for somebody who is not an operator.
  3129  (2469)      %
  3130  (2470)      %     this is D100 - 102 up  103 down
  3131  (2471)      %     this is D100 - on its own
  3132  (2472)      %
  3133  (2473)      % Ronny, 2026-08-20: end users should be able to see how the network is
  3134  (2474)      % configured. The registry has held kind 12 for it ever since.
  3135  (2475)      %
  3136  (2476)      % WHY IT IS NOT JUST LIST-TRUNKS WITH A DIFFERENT NAME, and this is the
  3137  (2477)      % whole reason it is a ROOM kind rather than an admin one:
  3138  (2478)      %
  3139  (2479)      %   SEEING how the network is wired is not the same right as REWIRING it.
  3140  (2480)      %   LIST-TRUNKS arrives on the ADMIN port, from CHAT-MON, alongside
  3141  (2481)      %   START-TRUNK and STOP-TRUNK - the verbs that change things. /map arrives
  3142  (2482)      %   on the room port from an ordinary member and can change nothing.
  3143  (2483)      %
  3144  (2484)      % IT NAMES THIS MACHINE FIRST. A trunk list on its own is ambiguous the
  3145  (2485)      % moment there is more than one machine: "102 up" read on D102 would be
  3146  (2486)      % nonsense, and a user who has just been told they are "ANNA@D102" needs to
  3147  (2487)      % know which end they are looking from. mySystem comes from xmpfm2p on our
  3148  (2488)      % own magic at start-up, so it is what the KERNEL says we are, not what a
  3149  (2489)      % configuration file claims.
  3150  (2490)      %
  3151  (2491)      % Peers are two spaces apart and the number and state one, the same shape
  3152  (2492)      % the all-rooms /who uses, so the groups read apart at a glance.
  3153  (2493)      % -----------------------------------------------------------------------
  3154  (2494)      ROUTINE VOID, INTEGER : buildMap
  3155  (2495)          INTEGER : i, at, textAt, textLen, st, headAt
  3156  (2496)  
  3157  (2497)          kMap =: outBuf(0)
  3158  (2498)          0 =: outBuf(1)                        % no name: the SERVER is answering
  3159  (2499)          2 =: at
  3160  (2500)          0 =: outBuf(at)
  3161  (2501)          0 =: outBuf(at + 1)
  3162  (2502)          at + 2 =: textAt
  3163  (2503)          textAt =: at
  3164  (2504)  
  3165  (2505)          putWord('this is ', at) =: at
  3166  (2506)          putSysLabel(mySystem, at) =: at
  3167  (2507)          putWord(' - ', at) =: at
  3168  (2508)  
  3169  (2509)          % REMEMBER WHERE THE HEADER ENDED, do not compute it.
  3170  (2510)          %
  3171  (2511)          % This was first written as "IF at - textAt > 15", 15 being the length
  3172  (2512)          % of "this is D100 - ". That is only true for a THREE-DIGIT system
  3173  (2513)          % number: on D19999 the header is 17 and the test would put two spaces
  3174  (2514)          % before the first peer and then still claim there were none. A length
  3175  (2515)          % that depends on data is not a constant, however constant it looks in
  3176  (2516)          % the machine you are sitting at.
  3177  (2517)          at =: headAt
  3178  (2518)  
  3179  (2519)          FOR i IN 1:maxPeers DO
  3180  (2520)              IF peerSystem(i) >< 0 THEN
  3181  (2521)                  IF at > headAt THEN
  3182  (2522)                      spaceByte(0) =: outBuf(at)
  3183  (2523)                      at + 1 =: at
  3184  (2524)                      spaceByte(0) =: outBuf(at)
  3185  (2525)                      at + 1 =: at
  3186  (2526)                  ENDIF
  3187  (2527)                  putSysLabel(peerSystem(i), at) =: at
  3188  (2528)                  spaceByte(0) =: outBuf(at)
  3189  (2529)                  at + 1 =: at
  3190  (2530)                  peerState(i) =: st
  3191  (2531)                  IF st = peerUp THEN
  3192  (2532)                      putWord('up', at) =: at
  3193  (2533)                  ENDIF
  3194  (2534)                  IF st = peerDown THEN
  3195  (2535)                      putWord('down', at) =: at
  3196  (2536)                  ENDIF
  3197  (2537)                  IF st = peerUnknown THEN
  3198  (2538)                      putWord('unknown', at) =: at
  3199  (2539)                  ENDIF
  3200  (2540)              ENDIF
  3201  (2541)          ENDFOR
  3202  (2542)  
  3203  (2543)          % NO TRUNKS IS A REAL ANSWER AND IS SAID IN WORDS. "on its own" is what
  3204  (2544)          % a person wants to read; an empty list after a dash is what a program
  3205  (2545)          % would print. Same reason /topic spells out an absent topic.
  3206  (2546)          IF at = headAt THEN
  3207  (2547)              putWord('on its own', at) =: at
  3208  (2548)          ENDIF
  3209  (2549)  
  3210  (2550)          at - textAt =: textLen
  3211  (2551)          textLen =: outBuf(3)
  3212  (2552)          at RETURN
  3213  (2553)      ENDROUTINE
  3214  (2554)  
  3215  (2555)      % -----------------------------------------------------------------------
  3216  (2556)      % Forget everything a peer told us. Called when it goes Down, and before
  3217  (2557)      % storing a fresh list from it.
  3218  (2558)      %
  3219  (2559)      % WHOLESALE, NEVER MERGED. A peer that comes back has almost certainly
  3220  (2560)      % restarted, so anything we remember about its members is stale - the design
  3221  (2561)      % says treat Up as "start again". Merging would leave ghosts of people who
  3222  (2562)      % left while the machine was away, and nothing would ever remove them.
  3223  (2563)      % -----------------------------------------------------------------------
  3224  (2564)      ROUTINE VOID, VOID (INTEGER) : forgetRemote(system)
  3225  (2565)          INTEGER : i
  3226  (2566)          FOR i IN 1:maxRemote DO
  3227  (2567)              IF rmtSystem(i) = system THEN
  3228  (2568)                  0 =: rmtSystem(i)
  3229  (2569)                  0 =: rmtNameLen(i)
  3230  (2570)                  0 =: rmtRoomLen(i)
  3231  (2571)              ENDIF
  3232  (2572)          ENDFOR
  3233  (2573)      ENDROUTINE
  3234  (2574)  
  3235  (2575)      % -----------------------------------------------------------------------
  3236  (2576)      % Build the answer to a peer's "who is on you": our own seated members as
  3237  (2577)      % "NAME/ROOM NAME/ROOM ...".
  3238  (2578)      %
  3239  (2579)      % OUR OWN MEMBERS ONLY. What we know about OTHER machines is theirs to
  3240  (2580)      % report, not ours to relay - passing it on would let a wrong entry echo
  3241  (2581)      % around a ring of machines with nothing to stop it. Every machine speaks
  3242  (2582)      % only for itself; that is what makes the state converge.
  3243  (2583)      % -----------------------------------------------------------------------
  3244  (2584)      ROUTINE VOID, INTEGER : buildMembers
  3245  (2585)          INTEGER : i, j, at, textAt, textLen, need
  3246  (2586)  
  3247  (2587)          kTrkMbrs =: outBuf(0)
  3248  (2588)          0 =: outBuf(1)                        % no name: a MACHINE is answering
  3249  (2589)          2 =: at
  3250  (2590)          0 =: outBuf(at)
  3251  (2591)          0 =: outBuf(at + 1)
  3252  (2592)          at + 2 =: textAt
  3253  (2593)          textAt =: at
  3254  (2594)          0 =: textLen
  3255  (2595)  
  3256  (2596)          FOR i IN 1:maxSeats DO
  3257  (2597)              IF memberUsed(i) = 1 THEN
  3258  (2598)                  % name + '/' + room, and a space if anything is there already
  3259  (2599)                  memberLen(i) + lenMbrRoom(i) + 1 =: need
  3260  (2600)                  IF textLen > 0 THEN
  3261  (2601)                      need + 1 =: need
  3262  (2602)                  ENDIF
  3263  (2603)  
  3264  (2604)                  IF textLen + need <= 250 THEN
  3265  (2605)                      IF textLen > 0 THEN
  3266  (2606)                          spaceByte(0) =: outBuf(at)
  3267  (2607)                          at + 1 =: at
  3268  (2608)                          textLen + 1 =: textLen
  3269  (2609)                      ENDIF
  3270  (2610)                      FOR j IN 1:memberLen(i) DO
  3271  (2611)                          memberName(i, j) =: outBuf(at)
  3272  (2612)                          at + 1 =: at
  3273  (2613)                      ENDFOR
  3274  (2614)                      slashByte(0) =: outBuf(at)
  3275  (2615)                      at + 1 =: at
  3276  (2616)                      FOR j IN 1:lenMbrRoom(i) DO
  3277  (2617)                          mbrRoom(i, j) =: outBuf(at)
  3278  (2618)                          at + 1 =: at
  3279  (2619)                      ENDFOR
  3280  (2620)                      textLen + need =: textLen
  3281  (2621)                  ENDIF
  3282  (2622)              ENDIF
  3283  (2623)          ENDFOR
  3284  (2624)  
  3285  (2625)          textLen =: outBuf(3)
  3286  (2626)          at RETURN
  3287  (2627)      ENDROUTINE
  3288  (2628)  
  3289  (2629)      % -----------------------------------------------------------------------
  3290  (2630)      % Store what a peer just told us. Replaces everything we held for it.
  3291  (2631)      %
  3292  (2632)      % Parses "NAME/ROOM NAME/ROOM ..." out of inBuf. A malformed entry - no
  3293  (2633)      % slash, or a name longer than a name can be - is DROPPED and the parse
  3294  (2634)      % carries on. One bad entry from a peer must not cost us the rest of its
  3295  (2635)      % list, and must certainly not write past the end of a table.
  3296  (2636)      % -----------------------------------------------------------------------
  3297  (2637)      % NO LABEL AND NO GO. A "skip this entry" jump would read more naturally,
  3298  (2638)      % but PLANC's label form is not something this file has ever used and a
  3299  (2639)      % guess costs a ten-minute build cycle. A BOOLEAN says the same thing and
  3300  (2640)      % cannot be got wrong.
  3301  (2641)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : &
  3302  (2642)              takeMembers(system, at, length)
  3303  (2643)          INTEGER : p, stop, nameAt, nameLen2, roomAt, roomLen2, row, i
  3304  (2644)          BOOLEAN : good
  3305  (2645)  
  3306  (2646)          forgetRemote(system)
  3307  (2647)  
  3308  (2648)          at =: p
  3309  (2649)          at + length =: stop
  3310  (2650)  
  3311  (2651)          DO
  3312  (2652)              WHILE p < stop
  3313  (2653)  
  3314  (2654)              % skip separators
  3315  (2655)              DO
  3316  (2656)                  WHILE p < stop AND inBuf(p) = spaceByte(0)
  3317  (2657)                  p + 1 =: p
  3318  (2658)              ENDDO
  3319  (2659)  
  3320  (2660)              % the name, up to a slash or a space
  3321  (2661)              p =: nameAt
  3322  (2662)              DO
  3323  (2663)                  WHILE p < stop AND inBuf(p) >< slashByte(0) AND &
  3324  (2664)                        inBuf(p) >< spaceByte(0)
  3325  (2665)                  p + 1 =: p
  3326  (2666)              ENDDO
  3327  (2667)              p - nameAt =: nameLen2
  3328  (2668)  
  3329  (2669)              % A SLASH MUST FOLLOW. Anything else is a malformed entry - the room
  3330  (2670)              % is left empty, the entry fails the test below and is dropped, and
  3331  (2671)              % the loop carries on with the next one. One bad entry from a peer
  3332  (2672)              % must not cost us the rest of its list.
  3333  (2673)              FALSE =: good
  3334  (2674)              0 =: roomLen2
  3335  (2675)              IF p < stop THEN
  3336  (2676)                  IF inBuf(p) = slashByte(0) THEN
  3337  (2677)                      p + 1 =: p
  3338  (2678)                      p =: roomAt
  3339  (2679)                      DO
  3340  (2680)                          WHILE p < stop AND inBuf(p) >< spaceByte(0)
  3341  (2681)                          p + 1 =: p
  3342  (2682)                      ENDDO
  3343  (2683)                      p - roomAt =: roomLen2
  3344  (2684)                      TRUE =: good
  3345  (2685)                  ENDIF
  3346  (2686)              ENDIF
  3347  (2687)  
  3348  (2688)              IF good THEN
  3349  (2689)                  IF nameLen2 > 0 AND nameLen2 <= maxNameLen AND &
  3350  (2690)                     roomLen2 > 0 AND roomLen2 <= maxNameLen THEN
  3351  (2691)                      0 =: row
  3352  (2692)                      FOR i IN 1:maxRemote DO
  3353  (2693)                          IF rmtSystem(i) = 0 THEN
  3354  (2694)                              IF row = 0 THEN
  3355  (2695)                                  i =: row
  3356  (2696)                              ENDIF
  3357  (2697)                          ENDIF
  3358  (2698)                      ENDFOR
  3359  (2699)                      IF row >< 0 THEN
  3360  (2700)                          system =: rmtSystem(row)
  3361  (2701)                          FOR i IN 1:nameLen2 DO
  3362  (2702)                              inBuf(nameAt + i - 1) =: rmtName(row, i)
  3363  (2703)                          ENDFOR
  3364  (2704)                          nameLen2 =: rmtNameLen(row)
  3365  (2705)                          FOR i IN 1:roomLen2 DO
  3366  (2706)                              inBuf(roomAt + i - 1) =: rmtRoom(row, i)
  3367  (2707)                          ENDFOR
  3368  (2708)                          roomLen2 =: rmtRoomLen(row)
  3369  (2709)                      ENDIF
  3370  (2710)                  ENDIF
  3371  (2711)              ENDIF
  3372  (2712)          ENDDO
  3373  (2713)      ENDROUTINE
  3374  (2714)  
  3375  (2715)      % Is this member in the same room as that one?
  3376  (2716)      %
  3377  (2717)      % Compared byte by byte on the stored name. A room is only "the same room"
  3378  (2718)      % if it is spelled the same - there is no room id, because a room is not a
  3379  (2719)      % registered thing any more, just a name people agree on.
  3380  (2720)      %
  3381  (2721)      % DECLARED HERE, ABOVE buildWho, AND THAT POSITION IS LOAD-BEARING. It used
  3382  (2722)      % to sit next to broadcast, 250 lines further down; PLANC needs a routine
  3383  (2723)      % declared before it is called, so buildWho could not have used it even if
  3384  (2724)      % somebody had thought to. Moved up 2026-08-22 when /who was fixed.
  3385  (2725)      ROUTINE VOID, BOOLEAN (INTEGER, INTEGER) : sameRoom(slotA, slotB)
  3386  (2726)          INTEGER : i
  3387  (2727)          IF lenMbrRoom(slotA) >< lenMbrRoom(slotB) THEN
  3388  (2728)              FALSE RETURN
  3389  (2729)          ENDIF
  3390  (2730)          FOR i IN 1:lenMbrRoom(slotA) DO
  3391  (2731)              IF mbrRoom(slotA, i) >< mbrRoom(slotB, i) THEN
  3392  (2732)                  FALSE RETURN
  3393  (2733)              ENDIF
  3394  (2734)          ENDFOR
  3395  (2735)          TRUE RETURN
  3396  (2736)      ENDROUTINE
  3397  (2737)  
  3398  (2738)      % -----------------------------------------------------------------------
  3399  (2739)      % Which topic entry belongs to this member's room? 0 if the room has never
  3400  (2740)      % had a topic set.
  3401  (2741)      %
  3402  (2742)      % Compared the same way sameRoom compares: byte for byte on the spelling.
  3403  (2743)      % A room IS its name here, so LOBBY and lobby are two rooms, and the topic
  3404  (2744)      % table has to agree with the broadcast about that or a topic would show up
  3405  (2745)      % in a room that cannot hear the messages.
  3406  (2746)      % -----------------------------------------------------------------------
  3407  (2747)      ROUTINE VOID, INTEGER (INTEGER) : findTopic(slot)
  3408  (2748)          INTEGER : t, i
  3409  (2749)          BOOLEAN : match
  3410  (2750)  
  3411  (2751)          FOR t IN 1:maxTopics DO
  3412  (2752)              IF topicRmLen(t) = lenMbrRoom(slot) THEN
  3413  (2753)                  TRUE =: match
  3414  (2754)                  FOR i IN 1:topicRmLen(t) DO
  3415  (2755)                      IF topicRoom(t, i) >< mbrRoom(slot, i) THEN
  3416  (2756)                          FALSE =: match
  3417  (2757)                      ENDIF
  3418  (2758)                  ENDFOR
  3419  (2759)                  IF match THEN
  3420  (2760)                      t RETURN
  3421  (2761)                  ENDIF
  3422  (2762)              ENDIF
  3423  (2763)          ENDFOR
  3424  (2764)          0 RETURN
  3425  (2765)      ENDROUTINE
  3426  (2766)  
  3427  (2767)      % -----------------------------------------------------------------------
  3428  (2768)      % Claim a topic entry for this member's room, or 0 if the table is full.
  3429  (2769)      %
  3430  (2770)      % An unused entry is one with topicRmLen 0 - a room name is never empty,
  3431  (2771)      % so zero cannot collide with a real one.
  3432  (2772)      % -----------------------------------------------------------------------
  3433  (2773)      ROUTINE VOID, INTEGER (INTEGER) : claimTopic(slot)
  3434  (2774)          INTEGER : t, i
  3435  (2775)  
  3436  (2776)          findTopic(slot) =: t
  3437  (2777)          IF t >< 0 THEN
  3438  (2778)              t RETURN                          % already has one; reuse it
  3439  (2779)          ENDIF
  3440  (2780)  
  3441  (2781)          FOR t IN 1:maxTopics DO
  3442  (2782)              IF topicRmLen(t) = 0 THEN
  3443  (2783)                  FOR i IN 1:lenMbrRoom(slot) DO
  3444  (2784)                      mbrRoom(slot, i) =: topicRoom(t, i)
  3445  (2785)                  ENDFOR
  3446  (2786)                  lenMbrRoom(slot) =: topicRmLen(t)
  3447  (2787)                  0 =: topicTextLen(t)
  3448  (2788)  
  3449  (2789)                  % TAKE A COPY OF THE DEFAULT AS IT IS NOW. This is what makes
  3450  (2790)                  % "INITIALIZE 20" apply to rooms created LATER without reaching
  3451  (2791)                  % back into rooms that already have messages - the copy is
  3452  (2792)                  % taken once, here, at the moment the room comes into being.
  3453  (2793)                  histDefault =: histSize(t)
  3454  (2794)                  0 =: histNext(t)
  3455  (2795)                  t RETURN
  3456  (2796)              ENDIF
  3457  (2797)          ENDFOR
  3458  (2798)          0 RETURN                              % full - the caller must say so
  3459  (2799)      ENDROUTINE
  3460  (2800)  
  3461  (2801)      % -----------------------------------------------------------------------
  3462  (2802)      % Find a room entry BY NAME, out of the incoming buffer, or 0.
  3463  (2803)      %
  3464  (2804)      % A SEPARATE ROUTINE FROM findTopic, which looks a room up by the SEAT of
  3465  (2805)      % somebody in it. This one is for an operator naming a room they are not in
  3466  (2806)      % - and may not even exist yet. One routine taking "which kind of thing is
  3467  (2807)      % this" would be a flag deciding what the code means, which is the same
  3468  (2808)      % mistake sameRoom and sameRoomAs were deliberately kept apart to avoid.
  3469  (2809)      % -----------------------------------------------------------------------
  3470  (2810)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findRoomNamed(at, len)
  3471  (2811)          INTEGER : t, i
  3472  (2812)          BOOLEAN : match
  3473  (2813)  
  3474  (2814)          IF len < 1 THEN
  3475  (2815)              0 RETURN
  3476  (2816)          ENDIF
  3477  (2817)          FOR t IN 1:maxTopics DO
  3478  (2818)              IF topicRmLen(t) = len THEN
  3479  (2819)                  TRUE =: match
  3480  (2820)                  FOR i IN 1:len DO
  3481  (2821)                      IF topicRoom(t, i) >< inBuf(at + i - 1) THEN
  3482  (2822)                          FALSE =: match
  3483  (2823)                      ENDIF
  3484  (2824)                  ENDFOR
  3485  (2825)                  IF match THEN
  3486  (2826)                      t RETURN
  3487  (2827)                  ENDIF
  3488  (2828)              ENDIF
  3489  (2829)          ENDFOR
  3490  (2830)          0 RETURN
  3491  (2831)      ENDROUTINE
  3492  (2832)  
  3493  (2833)      % -----------------------------------------------------------------------
  3494  (2834)      % Claim a room entry for a NAMED room, or 0 if the table is full.
  3495  (2835)      %
  3496  (2836)      % Lets a room be configured BEFORE anybody is in it, which is the useful
  3497  (2837)      % case: an operator sets up the room's history and the first person to
  3498  (2838)      % arrive gets the size that was intended rather than the default.
  3499  (2839)      % -----------------------------------------------------------------------
  3500  (2840)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : claimRoomNamed(at, len)
  3501  (2841)          INTEGER : t, i
  3502  (2842)  
  3503  (2843)          findRoomNamed(at, len) =: t
  3504  (2844)          IF t >< 0 THEN
  3505  (2845)              t RETURN
  3506  (2846)          ENDIF
  3507  (2847)          IF len < 1 THEN
  3508  (2848)              0 RETURN
  3509  (2849)          ENDIF
  3510  (2850)          IF len > 16 THEN
  3511  (2851)              0 RETURN                          % a room name cannot be longer
  3512  (2852)          ENDIF
  3513  (2853)  
  3514  (2854)          FOR t IN 1:maxTopics DO
  3515  (2855)              IF topicRmLen(t) = 0 THEN
  3516  (2856)                  FOR i IN 1:len DO
  3517  (2857)                      inBuf(at + i - 1) =: topicRoom(t, i)
  3518  (2858)                  ENDFOR
  3519  (2859)                  len =: topicRmLen(t)
  3520  (2860)                  0 =: topicTextLen(t)
  3521  (2861)  
  3522  (2862)                  % Same copy as claimTopic, for the same reason - see the note
  3523  (2863)                  % there. A room configured by name before anybody is in it is
  3524  (2864)                  % still a room being CREATED.
  3525  (2865)                  histDefault =: histSize(t)
  3526  (2866)                  0 =: histNext(t)
  3527  (2867)                  t RETURN
  3528  (2868)              ENDIF
  3529  (2869)          ENDFOR
  3530  (2870)          0 RETURN
  3531  (2871)      ENDROUTINE
  3532  (2872)  
  3533  (2873)      % -----------------------------------------------------------------------
  3534  (2874)      % Open this room's history file, creating it the first time.
  3535  (2875)      %
  3536  (2876)      % Returns the device number, or 0 if it could not be had. A history that
  3537  (2877)      % cannot be opened is NOT a reason to refuse the room: the chat carries on
  3538  (2878)      % without it, and that is deliberate - losing the record of a conversation
  3539  (2879)      % is bad, losing the conversation is worse.
  3540  (2880)      %
  3541  (2881)      % OPENED ONCE AND LEFT OPEN. A room is written on every line anybody types,
  3542  (2882)      % and an open plus a close in that path would put two file operations
  3543  (2883)      % between a keystroke and the room hearing it.
  3544  (2884)      %
  3545  (2885)      % TRY THE PLAIN OPEN FIRST, CREATE ONLY IF IT FAILS. A create at a name
  3546  (2886)      % that already exists is refused (SINTRAN error 62), so create-first fails
  3547  (2887)      % on every run after the first - which is every run that matters.
  3548  (2888)      %
  3549  (2889)      % ACCESS CODE 2 IS RANDOM READ/WRITE, and it has to be: MN117 and MN120
  3550  (2890)      % require it, and the whole ring depends on addressing a block directly.
  3551  (2891)      % -----------------------------------------------------------------------
  3552  (2892)      % -----------------------------------------------------------------------
  3553  (2893)      % Ask SINTRAN to create this room's history file.
  3554  (2894)      %
  3555  (2895)      % The same shape as makeLog, and for the same reason: MON50 cannot create,
  3556  (2896)      % CreateFile (221B) is a separate call, and it has no MONn routine - which
  3557  (2897)      % is why it goes through MONITOR_CALL. That works here because
  3558  (2898)      % MON-CALL-1B-A00 supplies 5MON_P and this program already needs it for
  3559  (2899)      % TimeOut.
  3560  (2900)      %
  3561  (2901)      % The name carried here is the FULL specification WITH the type -
  3562  (2902)      % "(SYSTEM)CHATH1:DATA" - where MON50 takes the name and the type as two
  3563  (2903)      % separate strings. Two calls, two conventions.
  3564  (2904)      % -----------------------------------------------------------------------
  3565  (2905)      ROUTINE VOID, VOID (INTEGER) : makeHistFile(t)
  3566  (2906)          INTEGER : i, at
  3567  (2907)  
  3568  (2908)          FOR i IN 1:sizeNameBuf DO
  3569  (2909)              blankByte(0) =: nameBuf(i - 1)
  3570  (2910)          ENDFOR
  3571  (2911)  
  3572  (2912)          0 =: at
  3573  (2913)          FOR i IN 1:lenHistUser DO
  3574  (2914)              histUser(i - 1) =: nameBuf(at)
  3575  (2915)              at + 1 =: at
  3576  (2916)          ENDFOR
  3577  (2917)          FOR i IN 1:5 DO
  3578  (2918)              histStem(i - 1) =: nameBuf(at)
  3579  (2919)              at + 1 =: at
  3580  (2920)          ENDFOR
  3581  (2921)          digitZero + t =: nameBuf(at)
  3582  (2922)          at + 1 =: at
  3583  (2923)          colonByte(0) =: nameBuf(at)
  3584  (2924)          at + 1 =: at
  3585  (2925)          FOR i IN 1:4 DO
  3586  (2926)              histType(i - 1) =: nameBuf(at)
  3587  (2927)              at + 1 =: at
  3588  (2928)          ENDFOR
  3589  (2929)  
  3590  (2930)          % One page per block, and the ring addresses histSize of them.
  3591  (2931)          histSize(t) =: histPages
  3592  (2932)          MONITOR_CALL(221B, nameBuf, startAddr, histPages)
  3593  (2933)      ENDROUTINE
  3594  (2934)  
  3595  (2935)      ROUTINE VOID, INTEGER (INTEGER) : histOpen(t)
  3596  (2936)          INTEGER : dev, i
  3597  (2937)          BOOLEAN : failed
  3598  (2938)  
  3599  (2939)          IF t < 1 THEN
  3600  (2940)              0 RETURN
  3601  (2941)          ENDIF
  3602  (2942)          IF histDev(t) >< 0 THEN
  3603  (2943)              histDev(t) RETURN                 % already open
  3604  (2944)          ENDIF
  3605  (2945)  
  3606  (2946)          % "(SYSTEM)CHATH" + the table index as one digit. The index is 1..8 so
  3607  (2947)          % a single digit always fits, and digitZero + t is the character for it.
  3608  (2948)          %
  3609  (2949)          % BUILT WITH A LOOP, not eight assignments. The first version of this
  3610  (2950)          % copied the five stem bytes out one at a time, which was five chances
  3611  (2951)          % to type the wrong subscript and would have needed rewriting the moment
  3612  (2952)          % the name changed - which it then did, on the very next build.
  3613  (2953)          FOR i IN 1:lenHistUser DO
  3614  (2954)              histUser(i - 1) =: histName(i - 1)
  3615  (2955)          ENDFOR
  3616  (2956)          FOR i IN 1:5 DO
  3617  (2957)              histStem(i - 1) =: histName(lenHistUser + i - 1)
  3618  (2958)          ENDFOR
  3619  (2959)          digitZero + t =: histName(lenHistUser + 5)
  3620  (2960)  
  3621  (2961)          % A FLAG, NOT THE DEVICE NUMBER. This file's own header says it in as
  3622  (2962)          % many words - "leaves 46 in the device number when the file is not
  3623  (2963)          % there - NOT zero. Never test the number".
  3624  (2964)          %
  3625  (2965)          % AND THE FLAG IS CLEARED AFTER THE ON BLOCK, NOT BEFORE. logOpen right
  3626  (2966)          % above records why, measured in CHAT.PLNC on 2026-08-19: "cleared
  3627  (2967)          % before, the handler body had already run and every open reported
  3628  (2968)          % failure while returning a good device". The first version of this
  3629  (2969)          % routine cleared it before - so a PERFECTLY GOOD open was reported as
  3630  (2970)          % a failure, the create branch ran, and the final "IF failed THEN
  3631  (2971)          % 0 =: dev" then threw away the device it had just been given.
  3632  (2972)          0 =: dev
  3633  (2973)          ON ROUTINEERROR DO
  3634  (2974)              TRUE =: failed
  3635  (2975)          ENDON
  3636  (2976)          FALSE =: failed
  3637  (2977)  
  3638  (2978)          MON50(histName(0:lenHistUser + 5), histType, 2) =: dev
  3639  (2979)  
  3640  (2980)          IF failed THEN
  3641  (2981)              % ---- MON50 CANNOT CREATE A FILE --------------------------------
  3642  (2982)              %
  3643  (2983)              % Quoting the name does NOTHING - measured in CHAT.PLNC and written
  3644  (2984)              % down beside makeLog above: "CreateFile is 221B and it is a
  3645  (2985)              % separate call". The first version of this routine quoted the name
  3646  (2986)              % and believed it, so no history file was ever created and the only
  3647  (2987)              % one that ever worked was the one made BY HAND from a terminal.
  3648  (2988)              %
  3649  (2989)              % Same shape as makeLog: fill the buffer with SPACES first so
  3650  (2990)              % whatever was in the rest is never read as part of the name, then
  3651  (2991)              % copy the full specification INCLUDING the type over the front.
  3652  (2992)              %
  3653  (2993)              % PAGES = THE RING'S SIZE, so every block the ring will ever
  3654  (2994)              % address exists from the start. A file that grows as it is written
  3655  (2995)              % would work for an append, but this writes block (id MOD size)
  3656  (2996)              % straight away and the last block is touched long before the ones
  3657  (2997)              % before it.
  3658  (2998)              makeHistFile(t)
  3659  (2999)  
  3660  (3000)              ON ROUTINEERROR DO
  3661  (3001)                  TRUE =: failed
  3662  (3002)              ENDON
  3663  (3003)              FALSE =: failed
  3664  (3004)              MON50(histName(0:lenHistUser + 5), histType, 2) =: dev
  3665  (3005)          ENDIF
  3666  (3006)  
  3667  (3007)          % STILL FAILED MEANS NO HISTORY, AND THAT MUST LEAVE ZERO BEHIND -
  3668  (3008)          % not 46, not whatever MON50 happened to write. Everything downstream
  3669  (3009)          % tests histDev against 0 to decide whether there is a file at all.
  3670  (3010)          IF failed THEN
  3671  (3011)              0 =: dev
  3672  (3012)          ENDIF
  3673  (3013)  
  3674  (3014)          % NO histNext RECOVERY SCAN. A version on 2026-09-02 tried to rebuild
  3675  (3015)          % histNext by reading every block's stored id, so on-disk history
  3676  (3016)          % would survive an RT-load. It is REMOVED because it is UNSAFE on a
  3677  (3017)          % CONTINUOUS file: the unwritten pages are NOT guaranteed zero, and a
  3678  (3018)          % garbage block whose first word happens to equal its own block number
  3679  (3019)          % was counted as a real message - MEASURED as a fresh room reporting
  3680  (3020)          % held=23 after two lines. Surviving a reload needs histNext persisted,
  3681  (3021)          % or a much stricter block-validity test (id AND a sane name AND
  3682  (3022)          % lengths); until one is written and PROVED, history is best-effort and
  3683  (3023)          % starts empty after a reload, which is the behaviour that shipped
  3684  (3024)          % before the scan.
  3685  (3025)  
  3686  (3026)          dev =: histDev(t)
  3687  (3027)          dev RETURN
  3688  (3028)      ENDROUTINE
  3689  (3029)  
  3690  (3030)      % -----------------------------------------------------------------------
  3691  (3031)      % Write one message into the ring.
  3692  (3032)      %
  3693  (3033)      % ONE BYTE PER WORD, AND NO PACKING. A block is 256 words and the biggest
  3694  (3034)      % message is a 16-byte name plus 200 bytes of text - 219 words with three
  3695  (3035)      % words of header, which fits with room to spare. Packing two bytes to a
  3696  (3036)      % word would save space in a block that is already mostly empty, and would
  3697  (3037)      % buy a shift-and-mask on every byte in both directions for it. The block
  3698  (3038)      % is the unit the machine gives us; there is nothing to gain by filling it.
  3699  (3039)      %
  3700  (3040)      %   word 0   the id
  3701  (3041)      %   word 1   how many bytes of name
  3702  (3042)      %   word 2   how many bytes of text
  3703  (3043)      %   then     the name, then the text
  3704  (3044)      %
  3705  (3045)      % The id goes in the block as well as in the table because the table does
  3706  (3046)      % not survive a restart and the file does. Reading a block back and finding
  3707  (3047)      % an id that is not the one the ring expects is how a half-written or
  3708  (3048)      % never-written block is told from a real one.
  3709  (3049)      % -----------------------------------------------------------------------
  3710  (3050)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER, INTEGER) : &
  3711  (3051)              histSave(t, slot, textAt, textLength)
  3712  (3052)          INTEGER : dev, i, at, id, blk, nLen, tLen
  3713  (3053)  
  3714  (3054)          IF t < 1 THEN
  3715  (3055)              RETURN
  3716  (3056)          ENDIF
  3717  (3057)          % ---- SAY WHAT HAPPENED, INTO THE LOG --------------------------------
  3718  (3058)          %
  3719  (3059)          % Three builds have now gone to the machine on a THEORY about why no
  3720  (3060)          % history file appears - the filename, then the user, then the create
  3721  (3061)          % call - and each time the only evidence was "OPENED 0 TIMES", which
  3722  (3062)          % says nothing about WHICH step failed or whether this code ran at all.
  3723  (3063)          %
  3724  (3064)          % One log line ends that, the same way printing the LDN and the status
  3725  (3065)          % ended the no-wait hunt in the client. It costs one line per message
  3726  (3066)          % and comes out the moment the answer is known.
  3727  (3067)          histOpen(t) =: dev
  3728  (3068)          logLine('SV hist slot      ', t)
  3729  (3069)          logLine('SV hist dev       ', dev)
  3730  (3070)  
  3731  (3071)          IF dev = 0 THEN
  3732  (3072)              RETURN                            % no history; the room still works
  3733  (3073)          ENDIF
  3734  (3074)  
  3735  (3075)          memberLen(slot) =: nLen
  3736  (3076)          textLength =: tLen
  3737  (3077)  
  3738  (3078)          % BOUNDED, because PLANC checks no array bound and a long name plus a
  3739  (3079)          % long text written past the end of histBlock would corrupt whatever
  3740  (3080)          % the loader put after it.
  3741  (3081)          IF nLen > 16 THEN
  3742  (3082)              16 =: nLen
  3743  (3083)          ENDIF
  3744  (3084)          % histHdrNew, not 3: the stamp and the six calendar words sit in
  3745  (3085)          % front of the name now, so the text has that much less room.
  3746  (3086)          IF histHdrNew + nLen + tLen > histWords THEN
  3747  (3087)              histWords - histHdrNew - nLen =: tLen
  3748  (3088)          ENDIF
  3749  (3089)  
  3750  (3090)          histNext(t) =: id
  3751  (3091)          id =: histBlock(0)
  3752  (3092)          nLen =: histBlock(1)
  3753  (3093)          tLen =: histBlock(2)
  3754  (3094)  
  3755  (3095)          % ---- WHEN, ASKED ONCE AND STORED AS THE MACHINE GIVES IT -----
  3756  (3096)          % Read HERE rather than passed in, because this is the moment the
  3757  (3097)          % line is kept - a time taken earlier and carried down would be
  3758  (3098)          % the time of something else.
  3759  (3099)          MN113(histCal)
  3760  (3100)          histStamp =: histBlock(3)
  3761  (3101)          histCal(1) =: histBlock(4)        % second
  3762  (3102)          histCal(2) =: histBlock(5)        % minute
  3763  (3103)          histCal(3) =: histBlock(6)        % hour
  3764  (3104)          histCal(4) =: histBlock(7)        % day
  3765  (3105)          histCal(5) =: histBlock(8)        % month
  3766  (3106)          histCal(6) =: histBlock(9)        % FULL year, 1998 not 98
  3767  (3107)          histHdrNew =: at
  3768  (3108)  
  3769  (3109)          FOR i IN 1:nLen DO
  3770  (3110)              memberName(slot, i) =: histBlock(at)
  3771  (3111)              at + 1 =: at
  3772  (3112)          ENDFOR
  3773  (3113)          FOR i IN 1:tLen DO
  3774  (3114)              inBuf(textAt + i - 1) =: histBlock(at)
  3775  (3115)              at + 1 =: at
  3776  (3116)          ENDFOR
  3777  (3117)  
  3778  (3118)          % THE RING, and it is this one line. No compaction, no rewrite, no
  3779  (3119)          % check for "is it full" - block id MOD size is where this message
  3780  (3120)          % lives and the one it displaces is the one N messages ago.
  3781  (3121)          id - ((id / histSize(t)) * histSize(t)) =: blk
  3782  (3122)  
  3783  (3123)          ON ROUTINEERROR DO
  3784  (3124)              0 =: dev                          % a failed write must not unwind
  3785  (3125)          ENDON
  3786  (3126)          MN120(dev, 0, histBlock, blk, histWords)
  3787  (3127)  
  3788  (3128)          id + 1 =: histNext(t)
  3789  (3129)      ENDROUTINE
  3790  (3130)  
  3791  (3131)      %
  3792  (3132)      % A separate routine from sameRoom because the two read from DIFFERENT
  3793  (3133)      % TABLES. One routine taking "which table" would be a flag deciding what the
  3794  (3134)      % code means - it reads fine and goes wrong in silence the day a caller
  3795  (3135)      % passes the wrong one.
  3796  (3136)      %
  3797  (3137)      % DECLARED HERE, ABOVE buildWho, because PLANC needs it declared before it
  3798  (3138)      % is called - the same reason sameRoom had to move up when /who was fixed.
  3799  (3139)      % -----------------------------------------------------------------------
  3800  (3140)      ROUTINE VOID, BOOLEAN (INTEGER, INTEGER) : sameRoomAs(slot, row)
  3801  (3141)          INTEGER : i
  3802  (3142)          IF lenMbrRoom(slot) >< rmtRoomLen(row) THEN
  3803  (3143)              FALSE RETURN
  3804  (3144)          ENDIF
  3805  (3145)          FOR i IN 1:lenMbrRoom(slot) DO
  3806  (3146)              IF mbrRoom(slot, i) >< rmtRoom(row, i) THEN
  3807  (3147)                  FALSE RETURN
  3808  (3148)              ENDIF
  3809  (3149)          ENDFOR
  3810  (3150)          TRUE RETURN
  3811  (3151)      ENDROUTINE
  3812  (3152)  
  3813  (3153)      % -----------------------------------------------------------------------
  3814  (3154)      % Build the answer to /who: every seated member's name, one space between.
  3815  (3155)      %
  3816  (3156)      % The name field is EMPTY - the room is answering, not a member - and the
  3817  (3157)      % names all go in the text. One message, not one per member: a message each
  3818  (3158)      % would multiply the scarcest thing XMSG has by the size of the room. The
  3819  (3159)      % measurement is in DOC/BRINGUP-ORDER-AND-TRAPS-2026-08-18.md: "Data
  3820  (3160)      % transmit blocks" has a limit of TEN and a 20-user burst hits it.
  3821  (3161)      %
  3822  (3162)      % BOUNDED, AND THE BOUND IS NOT DECORATION. outBuf holds 256 bytes and the
  3823  (3163)      % header eats four, so 252 are left; sixteen seats of sixteen characters
  3824  (3164)      % plus separators come to 271. A full room of long names would therefore
  3825  (3165)      % write past the end of outBuf, and PLANC checks no array bound - it would
  3826  (3166)      % simply corrupt whatever the loader put next. Names that do not fit are
  3827  (3167)      % dropped, which is a worse answer than a longer buffer would give and a
  3828  (3168)      % far better one than a corrupted program.
  3829  (3169)      % -----------------------------------------------------------------------
  3830  (3170)      ROUTINE VOID, INTEGER (INTEGER) : buildWho(askerSlot)
  3831  (3171)          INTEGER : i, j, at, textAt, textLen, room
  3832  (3172)  
  3833  (3173)          kWho =: outBuf(0)
  3834  (3174)          0 =: outBuf(1)                        % no name: the ROOM is answering
  3835  (3175)          2 =: at
  3836  (3176)          0 =: outBuf(at)                       % text length, high byte
  3837  (3177)          0 =: outBuf(at + 1)                   % text length, low byte, filled in below
  3838  (3178)          at + 2 =: textAt
  3839  (3179)          textAt =: at
  3840  (3180)          0 =: textLen
  3841  (3181)  
  3842  (3182)          FOR i IN 1:maxSeats DO
  3843  (3183)              % THE ASKER'S ROOM ONLY - and this test was MISSING until
  3844  (3184)              % 2026-08-22, which made /who the one thing on this server that
  3845  (3185)              % crossed a room boundary. Measured on D100: TESTER alone in LOBBY,
  3846  (3186)              % ANNA in GENERAL, and TESTER's /who answered
  3847  (3187)              %     CHAT: in (LOBBY): TESTER ANNA
  3848  (3188)              % The client's "in (LOBBY)" label made the answer not merely too
  3849  (3189)              % long but FALSE - it named a room ANNA was not in. Messages were
  3850  (3190)              % isolated the whole time; only the roster leaked, which is why
  3851  (3191)              % this survived a two-room test that watched what people SAID.
  3852  (3192)              %
  3853  (3193)              % sameRoom is the same compare the broadcast uses. Using it here
  3854  (3194)              % rather than a fresh loop is the point: the roster and the
  3855  (3195)              % broadcast must never disagree about who is in the room.
  3856  (3196)              IF memberUsed(i) = 1 THEN
  3857  (3197)                IF sameRoom(i, askerSlot) THEN
  3858  (3198)                  % What this name needs: a separator if it is not the first,
  3859  (3199)                  % then the name itself.
  3860  (3200)                  memberLen(i) =: room
  3861  (3201)                  IF textLen > 0 THEN
  3862  (3202)                      room + 1 =: room
  3863  (3203)                  ENDIF
  3864  (3204)  
  3865  (3205)                  IF textLen + room <= 250 THEN
  3866  (3206)                      IF textLen > 0 THEN
  3867  (3207)                          % A BYTE FROM A BYTES ARRAY, not a string literal.
  3868  (3208)                          % "' ' =: outBuf(at)" is what stood here and the
  3869  (3209)                          % compiler answered
  3870  (3210)                          %   1082 (422)/BUILDWHO *** ERROR
  3871  (3211)                          %        - ILLEGAL DATA TYPE "OUTBUF"
  3872  (3212)                          % because 'x' is a STRING and outBuf(at) is a BYTE.
  3873  (3213)                          % Copying out of a one-byte BYTES gives the element the
  3874  (3214)                          % type it wants - the same move oneChar uses on the
  3875  (3215)                          % client side for printing.
  3876  (3216)                          spaceByte(0) =: outBuf(at)
  3877  (3217)                          at + 1 =: at
  3878  (3218)                          textLen + 1 =: textLen
  3879  (3219)                      ENDIF
  3880  (3220)                      FOR j IN 1:memberLen(i) DO
  3881  (3221)                          memberName(i, j) =: outBuf(at)
  3882  (3222)                          at + 1 =: at
  3883  (3223)                      ENDFOR
  3884  (3224)                      textLen + memberLen(i) =: textLen
  3885  (3225)                  ENDIF
  3886  (3226)                ENDIF
  3887  (3227)              ENDIF
  3888  (3228)          ENDFOR
  3889  (3229)  
  3890  (3230)          % ---- AND THE PEOPLE ON THE OTHER MACHINES --------------------------
  3891  (3231)          %
  3892  (3232)          % Phase C. Same room, but on a peer, shown QUALIFIED - "ANNA@D102" -
  3893  (3233)          % because two machines can each have an ANNA and a bare name would make
  3894  (3234)          % them look like one person. The qualification is what makes a federated
  3895  (3235)          % room honest rather than merely bigger.
  3896  (3236)          %
  3897  (3237)          % ROOM MATCHED THE SAME WAY as the local test: byte for byte on the
  3898  (3238)          % spelling, because a room IS its name. The comparison is against the
  3899  (3239)          % ASKER's room, not against anything the peer said about rooms.
  3900  (3240)          FOR i IN 1:maxRemote DO
  3901  (3241)              IF rmtSystem(i) >< 0 THEN
  3902  (3242)                  IF sameRoomAs(askerSlot, i) THEN
  3903  (3243)                      % name + '@' + 'D' + up to 5 digits, plus a separator
  3904  (3244)                      rmtNameLen(i) + 8 =: room
  3905  (3245)                      IF textLen + room <= 250 THEN
  3906  (3246)                          IF textLen > 0 THEN
  3907  (3247)                              spaceByte(0) =: outBuf(at)
  3908  (3248)                              at + 1 =: at
  3909  (3249)                              textLen + 1 =: textLen
  3910  (3250)                          ENDIF
  3911  (3251)                          FOR j IN 1:rmtNameLen(i) DO
  3912  (3252)                              rmtName(i, j) =: outBuf(at)
  3913  (3253)                              at + 1 =: at
  3914  (3254)                          ENDFOR
  3915  (3255)                          atByte(0) =: outBuf(at)
  3916  (3256)                          at + 1 =: at
  3917  (3257)                          putSysLabel(rmtSystem(i), at) =: at
  3918  (3258)                          at - textAt =: textLen
  3919  (3259)                      ENDIF
  3920  (3260)                  ENDIF
  3921  (3261)              ENDIF
  3922  (3262)          ENDFOR
  3923  (3263)  
  3924  (3264)          % Now the length is known. It cannot exceed 250, so the high byte the
  3925  (3265)          % format carries stays zero.
  3926  (3266)          at - textAt =: textLen
  3927  (3267)          textLen =: outBuf(3)
  3928  (3268)          at RETURN
  3929  (3269)      ENDROUTINE
  3930  (3270)  
  3931  (3271)  
  3932  (3272)      % -----------------------------------------------------------------------
  3933  (3273)      % Build the answer to /topic: the ROOM NAME in the name field, the topic in
  3934  (3274)      % the text. An empty text means the room has no topic yet - the client says
  3935  (3275)      % so in words rather than showing a blank line.
  3936  (3276)      %
  3937  (3277)      % The room name goes in the NAME field on purpose. It is the one message
  3938  (3278)      % that is about a room rather than about a person, and putting the room
  3939  (3279)      % where a nickname normally sits means the client can label it without
  3940  (3280)      % having to remember which room it asked about - which matters, because a
  3941  (3281)      % /join can land between the question and the answer.
  3942  (3282)      % -----------------------------------------------------------------------
  3943  (3283)      ROUTINE VOID, INTEGER (INTEGER) : buildTopic(slot)
  3944  (3284)          INTEGER : i, at, t, len
  3945  (3285)  
  3946  (3286)          kTopic =: outBuf(0)
  3947  (3287)          lenMbrRoom(slot) =: outBuf(1)
  3948  (3288)          2 =: at
  3949  (3289)          FOR i IN 1:lenMbrRoom(slot) DO
  3950  (3290)              mbrRoom(slot, i) =: outBuf(at)
  3951  (3291)              at + 1 =: at
  3952  (3292)          ENDFOR
  3953  (3293)  
  3954  (3294)          findTopic(slot) =: t
  3955  (3295)          0 =: len
  3956  (3296)          IF t >< 0 THEN
  3957  (3297)              topicTextLen(t) =: len
  3958  (3298)          ENDIF
  3959  (3299)  
  3960  (3300)          0 =: outBuf(at)                       % text length, high byte
  3961  (3301)          len =: outBuf(at + 1)                  % low byte; len <= 64
  3962  (3302)          at + 2 =: at
  3963  (3303)          IF t >< 0 THEN
  3964  (3304)              FOR i IN 1:len DO
  3965  (3305)                  topicText(t, i) =: outBuf(at)
  3966  (3306)                  at + 1 =: at
  3967  (3307)              ENDFOR
  3968  (3308)          ENDIF
  3969  (3309)          at RETURN
  3970  (3310)      ENDROUTINE
  3971  (3311)  
  3972  (3312)      % -----------------------------------------------------------------------
  3973  (3313)      % Build the answer to /list: every room that somebody is sitting in, with
  3974  (3314)      % how many people are in it - "LOBBY(2) GENERAL(1)".
  3975  (3315)      %
  3976  (3316)      % THE ROOM LIST IS DERIVED FROM THE SEATS, NOT KEPT. There is no room
  3977  (3317)      % table to go stale: a room exists exactly as long as somebody is in it,
  3978  (3318)      % which is the same rule the broadcast already follows. A room with a topic
  3979  (3319)      % and nobody in it does NOT appear - it is not a place you can talk to.
  3980  (3320)      %
  3981  (3321)      % The walk is O(seats squared) and that is fine at sixteen: for each seat,
  3982  (3322)      % look back over the earlier seats and skip it if its room has already been
  3983  (3323)      % counted. No temporary room table, so nothing to size wrong.
  3984  (3324)      %
  3985  (3325)      % BOUNDED like buildWho, and for the same reason - see the note there.
  3986  (3326)      % Rooms that do not fit are dropped rather than written past the end.
  3987  (3327)      % -----------------------------------------------------------------------
  3988  (3328)      ROUTINE VOID, INTEGER : buildRooms
  3989  (3329)          INTEGER : i, j, at, textLen, count, need, tens, ones
  3990  (3330)          BOOLEAN : already
  3991  (3331)  
  3992  (3332)          kRooms =: outBuf(0)
  3993  (3333)          0 =: outBuf(1)                        % no name: the SERVER is answering
  3994  (3334)          2 =: at
  3995  (3335)          0 =: outBuf(at)                       % text length, high byte
  3996  (3336)          0 =: outBuf(at + 1)                   % low byte, filled in below
  3997  (3337)          at + 2 =: at
  3998  (3338)          0 =: textLen
  3999  (3339)  
  4000  (3340)          FOR i IN 1:maxSeats DO
  4001  (3341)              IF memberUsed(i) = 1 THEN
  4002  (3342)                  % Has an earlier seat already named this room?
  4003  (3343)                  %
  4004  (3344)                  % GUARDED, because seat 1 has no earlier seats and "FOR j IN
  4005  (3345)                  % 1:0" is an EMPTY RANGE. This compiler checks nothing, so an
  4006  (3346)                  % empty FOR is not a thing to rely on - the first room would be
  4007  (3347)                  % compared against seat 0, which is outside the array.
  4008  (3348)                  FALSE =: already
  4009  (3349)                  IF i > 1 THEN
  4010  (3350)                      FOR j IN 1:(i - 1) DO
  4011  (3351)                          IF memberUsed(j) = 1 THEN
  4012  (3352)                              IF sameRoom(i, j) THEN
  4013  (3353)                                  TRUE =: already
  4014  (3354)                              ENDIF
  4015  (3355)                          ENDIF
  4016  (3356)                      ENDFOR
  4017  (3357)                  ENDIF
  4018  (3358)  
  4019  (3359)                  IF NOT already THEN
  4020  (3360)                      % Count everybody in it, including seat i itself.
  4021  (3361)                      0 =: count
  4022  (3362)                      FOR j IN 1:maxSeats DO
  4023  (3363)                          IF memberUsed(j) = 1 THEN
  4024  (3364)                              IF sameRoom(i, j) THEN
  4025  (3365)                                  count + 1 =: count
  4026  (3366)                              ENDIF
  4027  (3367)                          ENDIF
  4028  (3368)                      ENDFOR
  4029  (3369)  
  4030  (3370)                      % name + "(" + up to two digits + ")" + a leading space
  4031  (3371)                      % once there is something to separate from.
  4032  (3372)                      lenMbrRoom(i) + 4 =: need
  4033  (3373)                      IF textLen > 0 THEN
  4034  (3374)                          need + 1 =: need
  4035  (3375)                      ENDIF
  4036  (3376)  
  4037  (3377)                      IF textLen + need <= 250 THEN
  4038  (3378)                          IF textLen > 0 THEN
  4039  (3379)                              spaceByte(0) =: outBuf(at)
  4040  (3380)                              at + 1 =: at
  4041  (3381)                              textLen + 1 =: textLen
  4042  (3382)                          ENDIF
  4043  (3383)                          FOR j IN 1:lenMbrRoom(i) DO
  4044  (3384)                              mbrRoom(i, j) =: outBuf(at)
  4045  (3385)                              at + 1 =: at
  4046  (3386)                          ENDFOR
  4047  (3387)                          textLen + lenMbrRoom(i) =: textLen
  4048  (3388)  
  4049  (3389)                          openParen(0) =: outBuf(at)
  4050  (3390)                          at + 1 =: at
  4051  (3391)                          textLen + 1 =: textLen
  4052  (3392)  
  4053  (3393)                          % At most sixteen seats, so at most two digits. Written
  4054  (3394)                          % straight out rather than through a general routine -
  4055  (3395)                          % a loop for a number that cannot exceed 16 would be
  4056  (3396)                          % more code than the thing it replaces.
  4057  (3397)                          count / 10 =: tens
  4058  (3398)                          count - (tens * 10) =: ones
  4059  (3399)                          IF tens > 0 THEN
  4060  (3400)                              digitZero + tens =: outBuf(at)
  4061  (3401)                              at + 1 =: at
  4062  (3402)                              textLen + 1 =: textLen
  4063  (3403)                          ENDIF
  4064  (3404)                          digitZero + ones =: outBuf(at)
  4065  (3405)                          at + 1 =: at
  4066  (3406)                          textLen + 1 =: textLen
  4067  (3407)  
  4068  (3408)                          closeParen(0) =: outBuf(at)
  4069  (3409)                          at + 1 =: at
  4070  (3410)                          textLen + 1 =: textLen
  4071  (3411)                      ENDIF
  4072  (3412)                  ENDIF
  4073  (3413)              ENDIF
  4074  (3414)          ENDFOR
  4075  (3415)  
  4076  (3416)          textLen =: outBuf(3)
  4077  (3417)          at RETURN
  4078  (3418)      ENDROUTINE
  4079  (3419)  
  4080  (3420)      % -----------------------------------------------------------------------
  4081  (3421)      % Build the answer to /who FROM SOMEBODY WITH NO SEAT: every room, and the
  4082  (3422)      % people in each.
  4083  (3423)      %
  4084  (3424)      %     LOBBY: TESTER OLAV  GENERAL: ANNA@D102
  4085  (3425)      %
  4086  (3426)      % Rooms separated by TWO spaces, people inside a room by one. No parsing on
  4087  (3427)      % the client side at all - it prints the text as it stands. That is on
  4088  (3428)      % purpose: a format nobody parses cannot be parsed wrongly, and this answer
  4089  (3429)      % exists to be READ by a person who has just been told they are nowhere.
  4090  (3430)      %
  4091  (3431)      % THE ROOM WALK IS buildRooms', DELIBERATELY. Same O(seats squared) skip of
  4092  (3432)      % rooms an earlier seat already named, same rule that a room exists exactly
  4093  (3433)      % as long as somebody is in it. If the two ever disagree, /list and /who
  4094  (3434)      % would name different sets of rooms, which is the kind of small lie that
  4095  (3435)      % takes an afternoon to chase.
  4096  (3436)      %
  4097  (3437)      % REMOTE PEOPLE ARE INCLUDED, qualified - "ANNA@D102" - and their room comes
  4098  (3438)      % from the peer's own report. A remote room with nobody local in it WILL
  4099  (3439)      % therefore be missed, because the walk starts from local seats. That is a
  4100  (3440)      % known gap, not an oversight: fixing it means walking the remote table for
  4101  (3441)      % rooms too and de-duplicating across both, and it is not worth the code
  4102  (3442)      % until somebody has actually sat alone in a room on another machine.
  4103  (3443)      %
  4104  (3444)      % BOUNDED at 250 like its neighbours - see the note on buildWho. What does
  4105  (3445)      % not fit is dropped, never written past the end of outBuf.
  4106  (3446)      % -----------------------------------------------------------------------
  4107  (3447)      ROUTINE VOID, INTEGER : buildAllWho
  4108  (3448)          INTEGER : i, j, k, at, textAt, textLen, need
  4109  (3449)          BOOLEAN : already
  4110  (3450)  
  4111  (3451)          kAllWho =: outBuf(0)
  4112  (3452)          0 =: outBuf(1)                        % no name: the SERVER is answering
  4113  (3453)          2 =: at
  4114  (3454)          0 =: outBuf(at)                       % text length, high byte
  4115  (3455)          0 =: outBuf(at + 1)                   % low byte, filled in below
  4116  (3456)          at + 2 =: textAt
  4117  (3457)          textAt =: at
  4118  (3458)          0 =: textLen
  4119  (3459)  
  4120  (3460)          FOR i IN 1:maxSeats DO
  4121  (3461)              IF memberUsed(i) = 1 THEN
  4122  (3462)  
  4123  (3463)                  % Has an earlier seat already named this room? Guarded for the
  4124  (3464)                  % same reason buildRooms guards it: seat 1 has no earlier seats
  4125  (3465)                  % and an empty FOR range is not a thing this compiler promises.
  4126  (3466)                  FALSE =: already
  4127  (3467)                  IF i > 1 THEN
  4128  (3468)                      FOR j IN 1:(i - 1) DO
  4129  (3469)                          IF memberUsed(j) = 1 THEN
  4130  (3470)                              IF sameRoom(i, j) THEN
  4131  (3471)                                  TRUE =: already
  4132  (3472)                              ENDIF
  4133  (3473)                          ENDIF
  4134  (3474)                      ENDFOR
  4135  (3475)                  ENDIF
  4136  (3476)  
  4137  (3477)                  IF NOT already THEN
  4138  (3478)                      % ---- the room name, then a colon ----------------------
  4139  (3479)                      % Two spaces before it once there is something to separate
  4140  (3480)                      % from, so the groups read apart at a glance.
  4141  (3481)                      lenMbrRoom(i) + 1 =: need
  4142  (3482)                      IF textLen > 0 THEN
  4143  (3483)                          need + 2 =: need
  4144  (3484)                      ENDIF
  4145  (3485)  
  4146  (3486)                      IF textLen + need <= 250 THEN
  4147  (3487)                          IF textLen > 0 THEN
  4148  (3488)                              spaceByte(0) =: outBuf(at)
  4149  (3489)                              at + 1 =: at
  4150  (3490)                              spaceByte(0) =: outBuf(at)
  4151  (3491)                              at + 1 =: at
  4152  (3492)                          ENDIF
  4153  (3493)                          FOR j IN 1:lenMbrRoom(i) DO
  4154  (3494)                              mbrRoom(i, j) =: outBuf(at)
  4155  (3495)                              at + 1 =: at
  4156  (3496)                          ENDFOR
  4157  (3497)                          colonByte(0) =: outBuf(at)
  4158  (3498)                          at + 1 =: at
  4159  (3499)                          at - textAt =: textLen
  4160  (3500)  
  4161  (3501)                          % ---- everybody local in it ------------------------
  4162  (3502)                          FOR j IN 1:maxSeats DO
  4163  (3503)                              IF memberUsed(j) = 1 THEN
  4164  (3504)                                  IF sameRoom(i, j) THEN
  4165  (3505)                                      memberLen(j) + 1 =: need
  4166  (3506)                                      IF textLen + need <= 250 THEN
  4167  (3507)                                          spaceByte(0) =: outBuf(at)
  4168  (3508)                                          at + 1 =: at
  4169  (3509)                                          FOR k IN 1:memberLen(j) DO
  4170  (3510)                                              memberName(j, k) =: outBuf(at)
  4171  (3511)                                              at + 1 =: at
  4172  (3512)                                          ENDFOR
  4173  (3513)                                          at - textAt =: textLen
  4174  (3514)                                      ENDIF
  4175  (3515)                                  ENDIF
  4176  (3516)                              ENDIF
  4177  (3517)                          ENDFOR
  4178  (3518)  
  4179  (3519)                          % ---- and everybody remote in it -------------------
  4180  (3520)                          % sameRoomAs compares a SEAT's room against a remote
  4181  (3521)                          % row, and seat i is in this room by construction, so
  4182  (3522)                          % it is the right thing to compare against.
  4183  (3523)                          FOR j IN 1:maxRemote DO
  4184  (3524)                              IF rmtSystem(j) >< 0 THEN
  4185  (3525)                                  IF sameRoomAs(i, j) THEN
  4186  (3526)                                      % name + '@' + 'D' + up to 5 digits + space
  4187  (3527)                                      rmtNameLen(j) + 8 =: need
  4188  (3528)                                      IF textLen + need <= 250 THEN
  4189  (3529)                                          spaceByte(0) =: outBuf(at)
  4190  (3530)                                          at + 1 =: at
  4191  (3531)                                          FOR k IN 1:rmtNameLen(j) DO
  4192  (3532)                                              rmtName(j, k) =: outBuf(at)
  4193  (3533)                                              at + 1 =: at
  4194  (3534)                                          ENDFOR
  4195  (3535)                                          atByte(0) =: outBuf(at)
  4196  (3536)                                          at + 1 =: at
  4197  (3537)                                          putSysLabel(rmtSystem(j), at) =: at
  4198  (3538)                                          at - textAt =: textLen
  4199  (3539)                                      ENDIF
  4200  (3540)                                  ENDIF
  4201  (3541)                              ENDIF
  4202  (3542)                          ENDFOR
  4203  (3543)                      ENDIF
  4204  (3544)                  ENDIF
  4205  (3545)              ENDIF
  4206  (3546)          ENDFOR
  4207  (3547)  
  4208  (3548)          % An EMPTY text is a real answer here and the client says so in words:
  4209  (3549)          % it means nobody is anywhere, which is different from "I could not
  4210  (3550)          % tell you". Leaving the length at zero is the whole implementation.
  4211  (3551)          at - textAt =: textLen
  4212  (3552)          textLen =: outBuf(3)
  4213  (3553)          at RETURN
  4214  (3554)      ENDROUTINE
  4215  (3555)  
  4216  (3556)      % -----------------------------------------------------------------------
  4217  (3557)      % Build a message whose name comes from a member slot rather than from the
  4218  (3558)      % incoming buffer - used for Said, where the speaker is named by the room
  4219  (3559)      % and NOT by whatever the sender claimed.
  4220  (3560)      % -----------------------------------------------------------------------
  4221  (3561)      % ONE OF OUR MESSAGES, built by the LIBRARY.
  4222  (3562)      %
  4223  (3563)      % The sixteen lines that wrote the kind, the name length, the name, a
  4224  (3564)      % two-byte length and the text are gone; cmEncAt does exactly that and is
  4225  (3565)      % checked by CHATTST on every build, so the encoder that SHIPS is the
  4226  (3566)      % encoder that is TESTED. The client's buildOwn was changed the same way.
  4227  (3567)      %
  4228  (3568)      % THE NAME IS COPIED FLAT FIRST, and that is not laziness. memberName is
  4229  (3569)      % TWO-DIMENSIONAL - memberName(slot, i) - and the library takes BYTES.
  4230  (3570)      % Taking a row as memberName(slot, 1:n) would be a subarray with computed
  4231  (3571)      % bounds, and this project has a measured case of that form compiling
  4232  (3572)      % clean, running, and writing NOTHING AT ALL (see drawBar in CHAT.PLNC).
  4233  (3573)      % Three obvious lines beat a form that is not understood.
  4234  (3574)      %
  4235  (3575)      % nameFlat, outBuf and inBuf are THREE DIFFERENT ARRAYS, which the library
  4236  (3576)      % requires: two subarrays of one array passed to a single routine corrupts
  4237  (3577)      % both and compiles clean.
  4238  (3578)      %
  4239  (3579)      % The text length is now written as two real bytes rather than a zero and
  4240  (3580)      % one, so a line of 256 characters or more no longer goes out mis-stated.
  4241  (3581)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER) : &
  4242  (3582)              buildFromSlot(kind, slot, textAt, textLength)
  4243  (3583)          INTEGER : i
  4244  (3584)  
  4245  (3585)          FOR i IN 1:memberLen(slot) DO
  4246  (3586)              memberName(slot, i) =: nameFlat(i - 1)
  4247  (3587)          ENDFOR
  4248  (3588)  
  4249  (3589)          cmEncAt(outBuf, kind, nameFlat, memberLen(slot), &
  4250  (3590)                  inBuf, textAt, textLength, 256) RETURN
  4251  (3591)      ENDROUTINE
  4252  (3592)  
  4253  (3593)      % -----------------------------------------------------------------------
  4254  (3594)      % Copy a name out of the incoming buffer into a member slot.
  4255  (3595)      % -----------------------------------------------------------------------
  4256  (3596)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : copyNameIn(slot, at, length)
  4257  (3597)          INTEGER : i
  4258  (3598)          FOR i IN 1:length DO
  4259  (3599)              inBuf(at + i - 1) =: memberName(slot, i)
  4260  (3600)          ENDFOR
  4261  (3601)          length =: memberLen(slot)
  4262  (3602)      ENDROUTINE
  4263  (3603)  
  4264  (3604)      % -----------------------------------------------------------------------
  4265  (3605)      % Remember which room a member joined.
  4266  (3606)      %
  4267  (3607)      % The room arrives in the JOIN'S TEXT FIELD - the client puts it there
  4268  (3608)      % because there is one port now and the room can no longer be inferred from
  4269  (3609)      % which port the message came in on.
  4270  (3610)      %
  4271  (3611)      % A JOIN WITH NO ROOM IS PUT IN THE HOME ROOM rather than refused. An older
  4272  (3612)      % client that predates this change sends an empty text, and refusing it
  4273  (3613)      % would take the room out from under somebody whose only crime is not having
  4274  (3614)      % been rebuilt yet. LOBBY is where they used to be, so LOBBY is where they
  4275  (3615)      % go.
  4276  (3616)      %
  4277  (3617)      % Bounded at sixteen, the width of the column. PLANC checks no array bound,
  4278  (3618)      % so this test is the only thing between a long room name and whatever the
  4279  (3619)      % loader put next.
  4280  (3620)      % -----------------------------------------------------------------------
  4281  (3621)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : copyRoomIn(slot, at, length)
  4282  (3622)          INTEGER : i, take
  4283  (3623)  
  4284  (3624)          length =: take
  4285  (3625)          IF take > 16 THEN
  4286  (3626)              16 =: take
  4287  (3627)          ENDIF
  4288  (3628)  
  4289  (3629)          IF take <= 0 THEN
  4290  (3630)              FOR i IN 1:lenHomeRoom DO
  4291  (3631)                  homeRoom(i - 1) =: mbrRoom(slot, i)
  4292  (3632)              ENDFOR
  4293  (3633)              lenHomeRoom =: lenMbrRoom(slot)
  4294  (3634)              RETURN
  4295  (3635)          ENDIF
  4296  (3636)  
  4297  (3637)          FOR i IN 1:take DO
  4298  (3638)              inBuf(at + i - 1) =: mbrRoom(slot, i)
  4299  (3639)          ENDFOR
  4300  (3640)          take =: lenMbrRoom(slot)
  4301  (3641)      ENDROUTINE
  4302  (3642)  
  4303  (3643)      % A CLIENT OLD ENOUGH TO CARRY NO VERSION LEAVES THIS EMPTY, on purpose -
  4304  (3644)      % an unknown build reads as "unknown", not as a guess.
  4305  (3645)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : copyVersionIn(slot, at, length)
  4306  (3646)          INTEGER : i, take
  4307  (3647)  
  4308  (3648)          0 =: memberVerLen(slot)
  4309  (3649)          length =: take
  4310  (3650)          IF take > maxVerLen THEN
  4311  (3651)              maxVerLen =: take
  4312  (3652)          ENDIF
  4313  (3653)          IF take <= 0 THEN
  4314  (3654)              RETURN
  4315  (3655)          ENDIF
  4316  (3656)  
  4317  (3657)          FOR i IN 1:take DO
  4318  (3658)              inBuf(at + i - 1) =: memberVer(slot, i)
  4319  (3659)          ENDFOR
  4320  (3660)          take =: memberVerLen(slot)
  4321  (3661)      ENDROUTINE
  4322  (3662)  
  4323  (3663)      % WHERE THE ROOM ENDS AND THE VERSION BEGINS, inside a Join's text field -
  4324  (3664)      % the first '|', searched only within THIS message's own text so a room
  4325  (3665)      % name that runs into whatever inBuf held before it is never read.
  4326  (3666)      %
  4327  (3667)      % Returns -1 when there is none, which is exactly what an OLDER client's
  4328  (3668)      % Join looks like: the whole field is the room name and nothing rides
  4329  (3669)      % after it.
  4330  (3670)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findJoinSep(at, length)
  4331  (3671)          INTEGER : i
  4332  (3672)          IF length > 0 THEN
  4333  (3673)              FOR i IN 0:length - 1 DO
  4334  (3674)                  IF inBuf(at + i) = verSepByte(0) THEN
  4335  (3675)                      at + i RETURN
  4336  (3676)                  ENDIF
  4337  (3677)              ENDFOR
  4338  (3678)          ENDIF
  4339  (3679)          0 - 1 RETURN
  4340  (3680)      ENDROUTINE
  4341  (3681)  
  4342  (3682)      % -----------------------------------------------------------------------
  4343  (3683)      % Build the Renamed announcement. Returns its total length.
  4344  (3684)      %
  4345  (3685)      % The NEW name goes in the name field and the OLD one in the text. That is
  4346  (3686)      % not a choice made here - ChatMessageKind.cs states it, and the reason is
  4347  (3687)      % that everybody has a transcript on screen under the old name and no way to
  4348  (3688)      % connect the two without it. CALL THIS BEFORE the slot is changed, while
  4349  (3689)      % the old name is still in it.
  4350  (3690)      % -----------------------------------------------------------------------
  4351  (3691)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : &
  4352  (3692)              buildRenamed(slot, newAt, newLength)
  4353  (3693)          INTEGER : i, at
  4354  (3694)          kRenOk =: outBuf(0)
  4355  (3695)          newLength =: outBuf(1)
  4356  (3696)          2 =: at
  4357  (3697)          FOR i IN 1:newLength DO
  4358  (3698)              inBuf(newAt + i - 1) =: outBuf(at)
  4359  (3699)              at + 1 =: at
  4360  (3700)          ENDFOR
  4361  (3701)  
  4362  (3702)          % The old name as the text.
  4363  (3703)          0 =: outBuf(at)
  4364  (3704)          memberLen(slot) =: outBuf(at + 1)
  4365  (3705)          at + 2 =: at
  4366  (3706)          FOR i IN 1:memberLen(slot) DO
  4367  (3707)              memberName(slot, i) =: outBuf(at)
  4368  (3708)              at + 1 =: at
  4369  (3709)          ENDFOR
  4370  (3710)          at RETURN
  4371  (3711)      ENDROUTINE
  4372  (3712)  
  4373  (3713)      % -----------------------------------------------------------------------
  4374  (3714)      % Send outBuf to one magic number.
  4375  (3715)      %
  4376  (3716)      % XMPFGET reserves a buffer and makes it CURRENT; XMPFWRI writes into the
  4377  (3717)      % current message; XMPFSND sends it. Note the userAddress coercion - the
  4378  (3718)      % guide's own examples write ADDR(buf(0)) FORCE XMUSERADDRESS.
  4379  (3719)      % -----------------------------------------------------------------------
  4380  (3720)      ROUTINE VOID, VOID (INTEGER4, INTEGER) : sendTo(magic, length)
  4381  (3721)          XMMSGIDENTIFIER : ident
  4382  (3722)          INTEGER : deadSlot
  4383  (3723)          % Each of the three steps below printed its status on EVERY send while
  4384  (3724)          % the room was being brought up - three lines per message, per member.
  4385  (3725)          % They now speak only when a step fails, which is the case that was
  4386  (3726)          % actually worth seeing: a send that half-succeeds is how a member ends
  4387  (3727)          % up in the room and hearing nothing.
  4388  (3728)          xmpfget(0, length, ident) =: returnStatus
  4389  (3729)          IF returnStatus >< XMOK THEN
  4390  (3730)              OUTPUT(1, 'AL18', 'SV: get failed st=')
  4391  (3731)              OUTPUT(1, 'I6', returnStatus)
  4392  (3732)              OUTPUT(1, 'AL1', '$')
  4393  (3733)              logLine('SV get failed st= ', returnStatus)
  4394  (3734)              RETURN
  4395  (3735)          ENDIF
  4396  (3736)          xmpfwri(0, 0, &
  4397  (3737)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  4398  (3738)              0, length, writtenLength) =: returnStatus
  4399  (3739)          IF returnStatus >< XMOK THEN
  4400  (3740)              OUTPUT(1, 'AL18', 'SV: wri failed st=')
  4401  (3741)              OUTPUT(1, 'I6', returnStatus)
  4402  (3742)              OUTPUT(1, 'AL1', '$')
  4403  (3743)              logLine('SV wri failed st= ', returnStatus)
  4404  (3744)          ENDIF
  4405  (3745)          IF returnStatus >< XMOK THEN
  4406  (3746)              xmpfrel(0, ident) =: returnStatus
  4407  (3747)              RETURN
  4408  (3748)          ENDIF
  4409  (3749)          % XMPSEND, NOT XMPFSND - and this is the whole bug, not a tidy-up.
  4410  (3750)          %
  4411  (3751)          % XMPFSND takes no message parameter. The guide says which one it picks:
  4412  (3752)          % "the current (default) message buffer is assumed, namely the 'port
  4413  (3753)          % current' message if one exists, or, if none, the 'task current'
  4414  (3754)          % message" (ND-60.164.3, XMPFSND, EXPLANATION). XMPFGET above only makes
  4415  (3755)          % the new buffer TASK current - it has no port parameter and cannot make
  4416  (3756)          % it port current. This port has just received a message, so a 'port
  4417  (3757)          % current' message may well still exist, and XMPFSND would send THAT
  4418  (3758)          % instead of the reply we just built. The guide never says whether
  4419  (3759)          % XMPFREL clears the port-current pointer, so relying on it would be a
  4420  (3760)          % guess.
  4421  (3761)          %
  4422  (3762)          % XMPSEND("Send message, not necessarily current") removes the question:
  4423  (3763)          % "The message specified by msgIdentifier is set as 'task current'
  4424  (3764)          % message and as 'port current' message for localPort. Then the message
  4425  (3765)          % will be sent as described under routine XMPFSND."
  4426  (3766)          %
  4427  (3767)          % Appendix G's SERVER gets away with XMPFSND only because it never calls
  4428  (3768)          % XMPFGET - it replies in the very buffer that arrived, which is already
  4429  (3769)          % both port and task current. We cannot copy that: a broadcast needs one
  4430  (3770)          % fresh buffer per member.
  4431  (3771)          xmpsend(sendFlags, ident, myPort, magic) =: returnStatus
  4432  (3772)          IF returnStatus >< XMOK THEN
  4433  (3773)              OUTPUT(1, 'AL18', 'SV: snd failed st=')
  4434  (3774)              OUTPUT(1, 'I6', returnStatus)
  4435  (3775)              OUTPUT(1, 'AL1', '$')
  4436  (3776)              logLine('SV snd failed st= ', returnStatus)
  4437  (3777)  
  4438  (3778)              % ---- A MEMBER WHO IS NO LONGER THERE, IF WE ARE EVER TOLD HERE --
  4439  (3779)              % Two statuses would mean the seat is holding somebody who has gone.
  4440  (3780)              % Both are read off XMP-B02:DEFS rather than guessed:
  4441  (3781)              %
  4442  (3782)              %   XMXEIMA 16915  Invalid magic number
  4443  (3783)              %   XMXEPCL 16932  Remote port closed while message queued
  4444  (3784)              %
  4445  (3785)              % NEITHER OF THEM ACTUALLY TURNS UP for a client killed on this
  4446  (3786)              % machine - measured, see the note on sendFlags. XMPSEND took the
  4447  (3787)              % message for a closed port and answered XMOK. This test is kept
  4448  (3788)              % rather than deleted because it costs one compare and it is right
  4449  (3789)              % if a status ever does arrive - a remote member across a link is
  4450  (3790)              % the obvious untested case - but it is NOT what fixes the leak.
  4451  (3791)              % The XMTRE branch in the receive loop is.
  4452  (3792)              %
  4453  (3793)              % ONLY THESE TWO, and deliberately not "any failure". XMXEMFL
  4454  (3794)              % (message space full) is a bad moment, not a dead member, and
  4455  (3795)              % throwing somebody out of the room because the machine was briefly
  4456  (3796)              % short of buffers would be worse than the bug being fixed. Every
  4457  (3797)              % other status still prints above.
  4458  (3798)              IF returnStatus = XMXEIMA OR returnStatus = XMXEPCL THEN
  4459  (3799)                  findByMagic(magic) =: deadSlot
  4460  (3800)                  IF deadSlot >< 0 THEN
  4461  (3801)                      1 =: memberDead(deadSlot)
  4462  (3802)                      1 =: deadFound
  4463  (3803)                  ENDIF
  4464  (3804)              ENDIF
  4465  (3805)          ENDIF
  4466  (3806)      ENDROUTINE
  4467  (3807)  
  4468  (3808)      % -----------------------------------------------------------------------
  4469  (3809)      % Replay what this room remembers, to ONE person, oldest first.
  4470  (3810)      %
  4471  (3811)      % Sent to the JOINER ALONE - the room has not changed, so nobody else has
  4472  (3812)      % anything to learn. Oldest first because that is the order it was said in;
  4473  (3813)      % a screen that fills backwards is a puzzle, not a transcript.
  4474  (3814)      %
  4475  (3815)      % WHERE TO START: the ring holds at most histSize messages, so the oldest
  4476  (3816)      % still present is next - size, or 0 if fewer than size have ever been
  4477  (3817)      % said. Nothing here has to know whether the ring has wrapped; the
  4478  (3818)      % arithmetic gives the same answer either way.
  4479  (3819)      %
  4480  (3820)      % A BLOCK WHOSE ID IS NOT THE ONE EXPECTED IS SKIPPED, and that is what
  4481  (3821)      % makes a half-written or never-written block harmless. It happens for real
  4482  (3822)      % on a file created and not yet filled: SINTRAN gives back whatever the
  4483  (3823)      % blocks held, and without this test the room would replay rubbish as
  4484  (3824)      % though somebody had said it.
  4485  (3825)      %
  4486  (3826)      % NOT SENT ACROSS A TRUNK, and that is deliberate - see the registry.
  4487  (3827)      % Somebody joining on D102 sees what was said ON D102. Relaying history
  4488  (3828)      % would mean deciding whose copy is authoritative and merging rings across
  4489  (3829)      % machines whose clocks differ.
  4490  (3830)      % -----------------------------------------------------------------------
  4491  (3831)      % INTEGER4 for the magic, because that is what sendTo takes. An
  4492  (3832)      % XMMSGIDENTIFIER is what xmpfget fills in and is a different thing; the
  4493  (3833)      % magic is the ADDRESS a reply goes to, and it is 32 bits.
  4494  (3834)      ROUTINE VOID, VOID (INTEGER, INTEGER4) : histReplay(t, magic)
  4495  (3835)          INTEGER : dev, id, first, blk, i, at, nLen, tLen, length
  4496  (3836)          INTEGER : base
  4497  (3837)  
  4498  (3838)          IF t < 1 THEN
  4499  (3839)              RETURN
  4500  (3840)          ENDIF
  4501  (3841)          histOpen(t) =: dev
  4502  (3842)          IF dev = 0 THEN
  4503  (3843)              RETURN
  4504  (3844)          ENDIF
  4505  (3845)  
  4506  (3846)          histNext(t) - histSize(t) =: first
  4507  (3847)          IF first < 0 THEN
  4508  (3848)              0 =: first
  4509  (3849)          ENDIF
  4510  (3850)  
  4511  (3851)          FOR id IN first:(histNext(t) - 1) DO
  4512  (3852)              id - ((id / histSize(t)) * histSize(t)) =: blk
  4513  (3853)  
  4514  (3854)              ON ROUTINEERROR DO
  4515  (3855)                  -1 =: histBlock(0)            % unreadable: cannot match an id
  4516  (3856)              ENDON
  4517  (3857)              MN117(dev, 0, histBlock, blk, histWords)
  4518  (3858)  
  4519  (3859)              IF histBlock(0) = id THEN
  4520  (3860)                  histBlock(1) =: nLen
  4521  (3861)                  histBlock(2) =: tLen
  4522  (3862)  
  4523  (3863)                  % ---- WHICH LAYOUT IS THIS BLOCK IN? ------------------
  4524  (3864)                  % A block written before the time was stored has the first
  4525  (3865)                  % character of the NAME in word 3, and a name is ASCII, so
  4526  (3866)                  % it can never equal histStamp. See the note beside the
  4527  (3867)                  % declaration - this is what lets the history already on
  4528  (3868)                  % the three machines go on replaying instead of being
  4529  (3869)                  % thrown away or read as rubbish.
  4530  (3870)                  %
  4531  (3871)                  % base is the word BEFORE the name, so the loops below read
  4532  (3872)                  % base + i exactly as they always did.
  4533  (3873)                  histHdrOld - 1 =: base
  4534  (3874)                  IF histBlock(3) = histStamp THEN
  4535  (3875)                      histHdrNew - 1 =: base
  4536  (3876)                  ENDIF
  4537  (3877)  
  4538  (3878)                  % A BLOCK CAN HOLD RUBBISH AND STILL MATCH ITS ID. The lengths
  4539  (3879)                  % come off the disk, so they are bounded here before they are
  4540  (3880)                  % used as loop limits - a stale block claiming a 30000-byte
  4541  (3881)                  % name would otherwise write clean off the end of outBuf, and
  4542  (3882)                  % PLANC checks no array bound.
  4543  (3883)                  IF nLen < 0 THEN
  4544  (3884)                      0 =: nLen
  4545  (3885)                  ENDIF
  4546  (3886)                  IF nLen > 16 THEN
  4547  (3887)                      16 =: nLen
  4548  (3888)                  ENDIF
  4549  (3889)                  IF tLen < 0 THEN
  4550  (3890)                      0 =: tLen
  4551  (3891)                  ENDIF
  4552  (3892)                  IF tLen > 200 THEN
  4553  (3893)                      200 =: tLen
  4554  (3894)                  ENDIF
  4555  (3895)  
  4556  (3896)                  % AND THE PAIR MUST FIT THE BLOCK. Each length is bounded
  4557  (3897)                  % on its own above, but a stale block can claim two that
  4558  (3898)                  % are each legal and together run off the end - PLANC
  4559  (3899)                  % checks no array bound, so the read would walk into
  4560  (3900)                  % whatever the loader put after histBlock.
  4561  (3901)                  IF base + nLen + tLen > histWords - 1 THEN
  4562  (3902)                      histWords - 1 - base - nLen =: tLen
  4563  (3903)                      IF tLen < 0 THEN
  4564  (3904)                          0 =: tLen
  4565  (3905)                      ENDIF
  4566  (3906)                  ENDIF
  4567  (3907)  
  4568  (3908)                  % FOR, NOT WHILE. PLANC has no WHILE...ENDWHILE: WHILE is a
  4569  (3909)                  % CONTINUE-TEST inside DO ... ENDDO, so "WHILE c DO ... ENDWHILE"
  4570  (3910)                  % is two errors, and the second one - ENDWHILE - is reported as
  4571  (3911)                  % ILLEGAL SYNTAX, which reads like punctuation and is not. The
  4572  (3912)                  % linter caught this before it reached the machine; it would
  4573  (3913)                  % otherwise have cost a four-minute compile to be told.
  4574  (3914)                  kHist =: outBuf(0)
  4575  (3915)  
  4576  (3916)                  % ---- WHEN IT WAS SAID, IN FRONT OF THE NAME --------------
  4577  (3917)                  %
  4578  (3918)                  % Seven bytes in the place a relay header sits, so CHATLIB's
  4579  (3919)                  % trHLen and trStrip handle them with no new code and the
  4580  (3920)                  % frame underneath stays an ordinary chat message.
  4581  (3921)                  %
  4582  (3922)                  % ALL ZERO WHEN THE BLOCK NEVER HELD A TIME. The history
  4583  (3923)                  % already on the three machines was written before there was
  4584  (3924)                  % anywhere to put one, and those blocks still replay - they
  4585  (3925)                  % just cannot say when. Zero is how the client is told that,
  4586  (3926)                  % so it can leave the column blank instead of inventing a
  4587  (3927)                  % moment, which is the whole defect this fixes.
  4588  (3928)                  0 =: outBuf(1)
  4589  (3929)                  0 =: outBuf(2)
  4590  (3930)                  0 =: outBuf(3)
  4591  (3931)                  0 =: outBuf(4)
  4592  (3932)                  0 =: outBuf(5)
  4593  (3933)                  0 =: outBuf(6)
  4594  (3934)                  0 =: outBuf(7)
  4595  (3935)                  IF base = histHdrNew - 1 THEN
  4596  (3936)                      histBlock(4) =: outBuf(1)          % second
  4597  (3937)                      histBlock(5) =: outBuf(2)          % minute
  4598  (3938)                      histBlock(6) =: outBuf(3)          % hour
  4599  (3939)                      histBlock(7) =: outBuf(4)          % day
  4600  (3940)                      histBlock(8) =: outBuf(5)          % month
  4601  (3941)                      histBlock(9) / 256 =: outBuf(6)    % year, HIGH byte
  4602  (3942)                      histBlock(9) MOD 256 =: outBuf(7)  % year, low byte
  4603  (3943)                  ENDIF
  4604  (3944)  
  4605  (3945)                  nLen =: outBuf(8)
  4606  (3946)                  9 =: at
  4607  (3947)                  FOR i IN 1:nLen DO
  4608  (3948)                      histBlock(base + i) =: outBuf(at)
  4609  (3949)                      at + 1 =: at
  4610  (3950)                  ENDFOR
  4611  (3951)                  0 =: outBuf(at)
  4612  (3952)                  tLen =: outBuf(at + 1)
  4613  (3953)                  at + 2 =: at
  4614  (3954)                  FOR i IN 1:tLen DO
  4615  (3955)                      histBlock(base + nLen + i) =: outBuf(at)
  4616  (3956)                      at + 1 =: at
  4617  (3957)                  ENDFOR
  4618  (3958)  
  4619  (3959)                  at =: length
  4620  (3960)                  sendTo(magic, length)
  4621  (3961)              ENDIF
  4622  (3962)          ENDFOR
  4623  (3963)      ENDROUTINE
  4624  (3964)  
  4625  (3965)      % -----------------------------------------------------------------------
  4626  (3966)      % Send to everybody in one room, optionally leaving one member out.
  4627  (3967)      %
  4628  (3968)      % ROOM-AWARE NOW, AND IT HAS TO BE. With one port every member of every
  4629  (3969)      % room sits in this one table, so an unfiltered broadcast would put
  4630  (3970)      % GENERAL's traffic on LOBBY's screens. Under the old port-per-room model
  4631  (3971)      % that could not happen - a separate port meant a separate server table -
  4632  (3972)      % which is why this routine had no room test until today.
  4633  (3973)      %
  4634  (3974)      % TWO PARAMETERS, NOT ONE, AND THAT IS THE WHOLE FIX.
  4635  (3975)      %
  4636  (3976)      % There was one slot number doing two unrelated jobs: naming the room to
  4637  (3977)      % send to, AND naming the member to leave out. Slot 0 cannot mean both
  4638  (3978)      % "no room" and "leave nobody out", and it was read as the first while
  4639  (3979)      % every Say, Rename and Leave passed it meaning the second - so the guard
  4640  (3980)      % at the top returned before sending a single letter.
  4641  (3981)      %
  4642  (3982)      % MEASURED ON D100, 2026-08-20, with two clients in LOBBY: neither saw a
  4643  (3983)      % word the other said, while /who listed them both and the Joined notice
  4644  (3984)      % arrived. Those two are exactly the paths that do NOT go through here
  4645  (3985)      % with a zero - /who answers the asker directly, and Joined passes a real
  4646  (3986)      % slot. The room table was never wrong; nothing was ever sent.
  4647  (3987)      %
  4648  (3988)      % So they are separate now and neither is overloaded:
  4649  (3989)      %   roomOfSlot  whose room defines the audience. 0 sends to nobody,
  4650  (3990)      %               because "everybody in the same room as nobody" is nobody.
  4651  (3991)      %   skipSlot    one member to leave out, or 0 to leave nobody out.
  4652  (3992)      %
  4653  (3993)      % roomOfSlot's own seat may already be empty - a member is removed from
  4654  (3994)      % the room BEFORE the room is told they left - and that still works,
  4655  (3995)      % because sameRoom reads only the stored room name, which nothing clears.
  4656  (3996)      % -----------------------------------------------------------------------
  4657  (3997)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : broadcast(length, roomOfSlot, skipSlot)
  4658  (3998)          INTEGER : i, sent
  4659  (3999)          IF roomOfSlot = 0 THEN
  4660  (4000)              % Worth a line of its own. "Nobody was in the room" and "this was
  4661  (4001)              % never called" look identical from outside, and telling them apart
  4662  (4002)              % is most of the work when a message does not arrive.
  4663  (4003)              logLine('SV bcast NO ROOM  ', skipSlot)
  4664  (4004)              RETURN
  4665  (4005)          ENDIF
  4666  (4006)  
  4667  (4007)          0 =: sent
  4668  (4008)          FOR i IN 1:maxSeats DO
  4669  (4009)              IF memberUsed(i) >< 0 THEN
  4670  (4010)                  IF i >< skipSlot THEN
  4671  (4011)                      IF sameRoom(i, roomOfSlot) THEN
  4672  (4012)                          sendTo(memberMagic(i), length)
  4673  (4013)                          sent + 1 =: sent
  4674  (4014)                      ENDIF
  4675  (4015)                  ENDIF
  4676  (4016)              ENDIF
  4677  (4017)          ENDFOR
  4678  (4018)  
  4679  (4019)          % HOW MANY IT CHOSE, every time, and this is the instrument the whole
  4680  (4020)          % afternoon of 2026-08-20 was missing. A zero here says the room filter
  4681  (4021)          % rejected everybody; a number with nothing arriving says the sends are
  4682  (4022)          % the problem; no line at all says broadcast was never reached. Three
  4683  (4023)          % different faults that all look the same from a terminal.
  4684  (4024)          logLine('SV bcast sent to  ', sent)
  4685  (4025)      ENDROUTINE
  4686  (4026)  
  4687  (4027)      % -----------------------------------------------------------------------
  4688  (4028)      % Empty the seats of members who have vanished, and give each seat back.
  4689  (4029)      %
  4690  (4030)      % CALLED FROM THE TOP OF THE RECEIVE LOOP, never from inside a broadcast -
  4691  (4031)      % see the note on memberDead for why that is not a style choice.
  4692  (4032)      %
  4693  (4033)      % A vanished member costs TWO things and they are not the same thing:
  4694  (4034)      %
  4695  (4035)      %   the seat in this program  memberUsed, which decides who is in the room;
  4696  (4036)      %   the seat in XROUT         the free-connection counter, which decides
  4697  (4037)      %                             whether a new joiner's letter is forwarded at
  4698  (4038)      %                             all. XROUT decremented it to deliver the join
  4699  (4039)      %                             and only the port's owner - this program -
  4700  (4040)      %                             ever puts one back, with XMPINFC.
  4701  (4041)      %
  4702  (4042)      % Clearing only the first leaves the room looking empty in LIST-NAMES while
  4703  (4043)      % it refuses everybody. MEASURED 2026-08-18, before this routine existed:
  4704  (4044)      % CHAT-LOBBY went 16 free to 15 when a client was aborted with ESC
  4705  (4045)      % ("USER BREAK AT 16665B") and stayed at 15 for good.
  4706  (4046)      % -----------------------------------------------------------------------
  4707  (4047)      ROUTINE VOID, VOID : reapDead
  4708  (4048)          INTEGER : round, i, length
  4709  (4049)  
  4710  (4050)          % Cleared FIRST, not last. A broadcast below can discover another dead
  4711  (4051)          % member - telling the room somebody left is exactly when the next dead
  4712  (4052)          % port gets found - and clearing at the end would throw that mark away.
  4713  (4053)          % Cleared here, a mark raised during our own broadcasts simply re-arms
  4714  (4054)          % this routine for the next message.
  4715  (4055)          0 =: deadFound
  4716  (4056)  
  4717  (4057)          % Bounded rather than a WHILE. Each pass empties at least one seat and a
  4718  (4058)          % pass can only mark members still in the room, so maxSeats passes empty
  4719  (4059)          % the worst room there is. An unbounded loop here would be taking on
  4720  (4060)          % trust that a broadcast to a dying room always terminates, and this
  4721  (4061)          % program has no way to recover if it does not.
  4722  (4062)          FOR round IN 1:maxSeats DO
  4723  (4063)              FOR i IN 1:maxSeats DO
  4724  (4064)                  IF memberDead(i) >< 0 THEN
  4725  (4065)                      0 =: memberDead(i)
  4726  (4066)                      IF memberUsed(i) >< 0 THEN
  4727  (4067)                          % Same order as the kLeave path: build the announcement
  4728  (4068)                          % while the name is still in the slot, empty the seat,
  4729  (4069)                          % THEN tell the room - so the departing member is not
  4730  (4070)                          % sent their own Left notice at a port already gone,
  4731  (4071)                          % which would only mark them dead all over again.
  4732  (4072)                          buildFromSlot(kLeft, i, 0, 0) =: length
  4733  (4073)                          0 =: memberUsed(i)
  4734  (4074)                          broadcast(length, i, i)   % their room, not them
  4735  (4075)  
  4736  (4076)                          xmpinfc(0, myPort, 1, 0) =: returnStatus
  4737  (4077)                          IF returnStatus >< XMOK THEN
  4738  (4078)                              OUTPUT(1, 'AL18', 'SV: infc failed st')
  4739  (4079)                              OUTPUT(1, 'I6', returnStatus)
  4740  (4080)                              OUTPUT(1, 'AL1', '$')
  4741  (4081)                              logLine('SV infc faild st= ', returnStatus)
  4742  (4082)                          ENDIF
  4743  (4083)  
  4744  (4084)                          % Worth one line: an operator watching the room needs to
  4745  (4085)                          % be able to tell "they left" from "they died", because
  4746  (4086)                          % only the second is evidence of anything.
  4747  (4087)                          OUTPUT(1, 'AL21', 'SV: reaped dead slot ')
  4748  (4088)                          OUTPUT(1, 'I6', i)
  4749  (4089)                          OUTPUT(1, 'AL1', '$')
  4750  (4090)                          logLine('SV reaped slot    ', i)
  4751  (4091)                      ENDIF
  4752  (4092)                  ENDIF
  4753  (4093)              ENDFOR
  4754  (4094)          ENDFOR
  4755  (4095)      ENDROUTINE
  4756  (4096)  
  4757  (4097)      % ----- the refusal reasons, worded exactly as ChatRoom.cs words them ----
  4758  (4098)      % Carried on the wire so a client shows the same sentence whichever door it
  4759  (4099)      % came in by. If these and ChatRoom ever diverge, one of the two is wrong.
  4760  (4100)      %
  4761  (4101)      % EACH LENGTH IS WRITTEN OUT beside its string, and that is deliberate. An
  4762  (4102)      % earlier version called LENGTH(reason) - PLANC has no such routine. The one
  4763  (4103)      % it does have is SIZE, whose syntax is "SIZE ident =: var" with no
  4764  (4104)      % parentheses, and which returns the STORAGE size; what that means for a
  4765  (4105)      % BYTES value passed as a routine parameter is not established. Passing the
  4766  (4106)      % count removes the question rather than trading one guess for another.
  4767  (4107)      %
  4768  (4108)      % The cost is that a string and its number must be changed together. That is
  4769  (4109)      % a real risk and it is why they are on adjacent lines.
  4770  (4110)      BYTES : reasonNeedNick := 'a nickname is required'
  4771  (4111)      INTEGER : lenNeedNick := 22
  4772  (4112)      % THE NICK REFUSAL NAMES THE NICK, so it is built rather than stored -
  4773  (4113)      % see refuseNick below. What used to sit here was
  4774  (4114)      %
  4775  (4115)      %     'that nickname is taken'
  4776  (4116)      %
  4777  (4117)      % and "that" is the reader being asked to remember what they typed. They
  4778  (4118)      % may have typed it on a machine across the room ten minutes ago.
  4779  (4119)      BYTES : quoteMark := ''''
  4780  (4120)      BYTES : reasonAlreadyIn    := 'already joined'
  4781  (4121)      INTEGER : lenAlreadyIn := 14
  4782  (4122)      BYTES : reasonRoomFull     := 'the room is full'
  4783  (4123)      INTEGER : lenRoomFull := 16
  4784  (4124)      BYTES : reasonTopicFull    := 'too many rooms have topics'
  4785  (4125)      INTEGER : lenTopicFull := 26
  4786  (4126)  
  4787  (4127)      % -----------------------------------------------------------------------
  4788  (4128)      % Send outBuf to a NAMED PORT ON ANOTHER SYSTEM, through XROUT.
  4789  (4129)      %
  4790  (4130)      % THIS SERVER HAS NEVER ORIGINATED A LETTER BEFORE. Everything it sends is a
  4791  (4131)      % reply to a magic number that arrived with a message - sendTo above. A trunk
  4792  (4132)      % is different: we address a machine that has not spoken to us, and may never
  4793  (4133)      % have, so there is no magic to reply to.
  4794  (4134)      %
  4795  (4135)      % The sequence is the COSMOS Programmer Guide's worked example (page 99) and
  4796  (4136)      % is exactly what CHAT.PLNC's sendJoin does:
  4797  (4137)      %
  4798  (4138)      %   XMPBLET   build an XSLET letter header naming SYSTEM and PORT NAME
  4799  (4139)      %   XMPFGET   reserve an XMSG buffer
  4800  (4140)      %   XMPFWRI   write the header, then OUR bytes after it
  4801  (4141)      %   XMPROUT   hand the whole thing to XROUT, which does the lookup
  4802  (4142)      %
  4803  (4143)      % ADDRESSED BY NAME, NEVER BY A REMEMBERED MAGIC. A magic carries a
  4804  (4144)      % generation, so one kept from before the peer restarted is stale in a way
  4805  (4145)      % nothing reports until a send quietly fails. Looking the name up every time
  4806  (4146)      % is what lets a machine that has been switched off for a day come back with
  4807  (4147)      % nobody touching either end.
  4808  (4148)      %
  4809  (4149)      % A NON-ZERO STATUS IS NOT A FAULT HERE. The peer being absent is the normal
  4810  (4150)      % case a trunk exists to survive; the caller records "still not up".
  4811  (4151)      %
  4812  (4152)      % THE SYSTEM IS A NAME, AS BYTES - NOT A NUMBER. That is the whole of this
  4813  (4153)      % trap and it cost THREE compile cycles, all reporting the same thing:
  4814  (4154)      %
  4815  (4155)      %     2521 (1861)/SENDTONAME *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
  4816  (4156)      %
  4817  (4157)      % The error names the CALL, so the first two attempts went looking at the
  4818  (4158)      % PORT NAME argument - was it sliced, was it a parameter - and neither was
  4819  (4159)      % the problem. It is parameter 5, the SYSTEM: XMPBLET wants the system's
  4820  (4160)      % NAME as BYTES ('D102'), and an INTEGER 102 is refused.
  4821  (4161)      %
  4822  (4162)      % CHATMON.PLNC says so in as many words, from 2026-08-20:
  4823  (4163)      %
  4824  (4164)      %     "THE SYSTEM NAME IS BYTES, NOT AN INTEGER ... Declaring it INTEGER
  4825  (4165)      %      drew *** ERROR - ILLEGAL DATA TYPE "XMPBLET" on the CALL rather than
  4826  (4166)      %      on the declaration, which sends you looking at the arguments you
  4827  (4167)      %      changed instead of the one you copied wrong."
  4828  (4168)      %
  4829  (4169)      % It even predicted how the search would go wrong, and it went exactly that
  4830  (4170)      % way. READ THE NOTE THAT NAMES YOUR ERROR before changing anything.
  4831  (4171)      %
  4832  (4172)      % So the number is turned into a name here - 'D' and the decimal digits,
  4833  (4173)      % which is the convention every DEFINE-REMOTE-NAME on these machines uses
  4834  (4174)      % (DEFINE-REMOTE-NAME,,D102,102). peerName is declared with explicit BOUNDS
  4835  (4175)      % and filled at RUNTIME, so it MUST be passed as a subarray saying how much
  4836  (4176)      % of itself is the name - the same shape as the client's roomName.
  4837  (4177)      % -----------------------------------------------------------------------
  4838  (4178)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : sendToName(system, length)
  4839  (4179)          XMMSGIDENTIFIER : ident
  4840  (4180)          INTEGER : offSet, uLength, wLength, st, nmAt
  4841  (4181)  
  4842  (4182)          % 'D' then the digits - D100, D102, D103.
  4843  (4183)          dByte(0) =: peerName(0)
  4844  (4184)          putPeerDigits(system, 1) =: nmAt
  4845  (4185)  
  4846  (4186)          xmpblet(letterBuf, 64, offSet, 123, peerName(0:nmAt - 1), trkName) =: st
  4847  (4187)          IF st >< XMOK THEN
  4848  (4188)              st RETURN
  4849  (4189)          ENDIF
  4850  (4190)  
  4851  (4191)          xmpfget(0, 200, ident) =: st
  4852  (4192)          IF st >< XMOK THEN
  4853  (4193)              st RETURN
  4854  (4194)          ENDIF
  4855  (4195)  
  4856  (4196)          % The header first...
  4857  (4197)          offSet =: uLength
  4858  (4198)          xmpfwri(0, 0, &
  4859  (4199)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
  4860  (4200)              0, uLength, wLength) =: st
  4861  (4201)  
  4862  (4202)          % ...then our own bytes after it. XROUT reads only the header and
  4863  (4203)          % forwards the rest untouched.
  4864  (4204)          xmpfwri(0, wLength, &
  4865  (4205)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  4866  (4206)              0, length, offSet) =: st
  4867  (4207)  
  4868  (4208)          xmprout(0, ident, trunkPort) =: st
  4869  (4209)          st RETURN
  4870  (4210)      ENDROUTINE
  4871  (4211)  
  4872  (4212)      % -----------------------------------------------------------------------
  4873  (4213)      % Which peer row holds this system, or 0.
  4874  (4214)      % -----------------------------------------------------------------------
  4875  (4215)      ROUTINE VOID, INTEGER (INTEGER) : findPeer(system)
  4876  (4216)          INTEGER : i
  4877  (4217)          FOR i IN 1:maxPeers DO
  4878  (4218)              IF peerSystem(i) = system THEN
  4879  (4219)                  i RETURN
  4880  (4220)              ENDIF
  4881  (4221)          ENDFOR
  4882  (4222)          0 RETURN
  4883  (4223)      ENDROUTINE
  4884  (4224)  
  4885  (4225)      % -----------------------------------------------------------------------
  4886  (4226)      % Say HELLO to one peer.
  4887  (4227)      %
  4888  (4228)      % ADDRESSED BY NAME THROUGH XROUT, not by a magic number we remember. A
  4889  (4229)      % magic carries a generation, so one kept from before the peer restarted is
  4890  (4230)      % stale in a way that is invisible until a send fails. The name is looked up
  4891  (4231)      % fresh every time, which is exactly what makes a peer that has been away
  4892  (4232)      % come back without anybody touching either machine.
  4893  (4233)      %
  4894  (4234)      % A FAILED SEND IS NOT AN ERROR HERE. A peer that is switched off is the
  4895  (4235)      % normal case this routine exists to handle - the status is recorded by the
  4896  (4236)      % caller as "still not up", not reported as a fault.
  4897  (4237)      % -----------------------------------------------------------------------
  4898  (4238)      % A HELLO NOW CARRIES WHAT THIS MACHINE IS CALLED, after the direction
  4899  (4239)      % byte that was always there.
  4900  (4240)      %
  4901  (4241)      % BACKWARD COMPATIBLE, and that is not a hope - it is measured from the
  4902  (4242)      % receiving code. The old handler reads inBuf(textAt) and NOTHING ELSE, so
  4903  (4243)      % a server that has not been upgraded takes the direction byte and ignores
  4904  (4244)      % every byte after it. That is the same property kTrkRly was given, and
  4905  (4245)      % it is what lets three running machines be upgraded one at a time.
  4906  (4246)      %
  4907  (4247)      % A machine with no name sends the one byte exactly as before.
  4908  (4248)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : sendHello(system, direction)
  4909  (4249)          INTEGER : at, st, i
  4910  (4250)  
  4911  (4251)          kTrkHello =: outBuf(0)
  4912  (4252)          0 =: outBuf(1)                        % no name: a MACHINE is speaking
  4913  (4253)          2 =: at
  4914  (4254)          0 =: outBuf(at)                       % text length, high byte
  4915  (4255)          1 + lenSysName =: outBuf(at + 1)      % direction byte, then our name
  4916  (4256)          at + 2 =: at
  4917  (4257)          direction =: outBuf(at)               % trkAsk or trkAnswer
  4918  (4258)          at + 1 =: at
  4919  (4259)          IF lenSysName > 0 THEN
  4920  (4260)              FOR i IN 1:lenSysName DO
  4921  (4261)                  sysName(i - 1) =: outBuf(at)
  4922  (4262)                  at + 1 =: at
  4923  (4263)              ENDFOR
  4924  (4264)          ENDIF
  4925  (4265)  
  4926  (4266)          sendToName(system, at) =: st
  4927  (4267)          st RETURN
  4928  (4268)      ENDROUTINE
  4929  (4269)  
  4930  (4270)      % -----------------------------------------------------------------------
  4931  (4271)      % A peer's member spoke. Show it to our own people in that room.
  4932  (4272)      %
  4933  (4273)      % SENT ONE BY ONE rather than through broadcast(), because broadcast picks
  4934  (4274)      % its audience from a SLOT - "everybody in the same room as this member" -
  4935  (4275)      % and the speaker has no slot here. They are not on this machine.
  4936  (4276)      %
  4937  (4277)      % The room arrives as text and is compared against each member's stored
  4938  (4278)      % room, byte for byte, the same rule as everywhere else: a room IS its name.
  4939  (4279)      % -----------------------------------------------------------------------
  4940  (4280)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER) : &
  4941  (4281)              deliverRemoteSaid(system, nameAt, nameLength, textAt, textLength)
  4942  (4282)          INTEGER : i, j, at, roomAt, roomLen2, msgAt, msgLen, p, textStart
  4943  (4283)          BOOLEAN : match
  4944  (4284)  
  4945  (4285)          % Split "ROOM/message" at the FIRST slash. A message may well contain
  4946  (4286)          % slashes of its own; the room cannot, so the first one is the divider.
  4947  (4287)          textAt =: roomAt
  4948  (4288)          textAt =: p
  4949  (4289)          DO
  4950  (4290)              WHILE p < textAt + textLength AND inBuf(p) >< slashByte(0)
  4951  (4291)              p + 1 =: p
  4952  (4292)          ENDDO
  4953  (4293)          p - roomAt =: roomLen2
  4954  (4294)  
  4955  (4295)          % No slash at all is a malformed forward - drop it rather than deliver
  4956  (4296)          % something to a room nobody named.
  4957  (4297)          IF p >= textAt + textLength THEN
  4958  (4298)              RETURN
  4959  (4299)          ENDIF
  4960  (4300)          p + 1 =: msgAt
  4961  (4301)          textAt + textLength - msgAt =: msgLen
  4962  (4302)  
  4963  (4303)          FOR i IN 1:maxSeats DO
  4964  (4304)              IF memberUsed(i) = 1 THEN
  4965  (4305)                  TRUE =: match
  4966  (4306)                  IF lenMbrRoom(i) >< roomLen2 THEN
  4967  (4307)                      FALSE =: match
  4968  (4308)                  ELSE
  4969  (4309)                      FOR j IN 1:roomLen2 DO
  4970  (4310)                          IF mbrRoom(i, j) >< inBuf(roomAt + j - 1) THEN
  4971  (4311)                              FALSE =: match
  4972  (4312)                          ENDIF
  4973  (4313)                      ENDFOR
  4974  (4314)                  ENDIF
  4975  (4315)  
  4976  (4316)                  IF match THEN
  4977  (4317)                      % "NAME@Dnnn" in the name field, so a client that already
  4978  (4318)                      % prints "<name>: <text>" needs no change at all.
  4979  (4319)                      kSaid =: outBuf(0)
  4980  (4320)                      2 =: at
  4981  (4321)                      FOR j IN 1:nameLength DO
  4982  (4322)                          inBuf(nameAt + j - 1) =: outBuf(at)
  4983  (4323)                          at + 1 =: at
  4984  (4324)                      ENDFOR
  4985  (4325)                      atByte(0) =: outBuf(at)
  4986  (4326)                      at + 1 =: at
  4987  (4327)                      putSysLabel(system, at) =: at
  4988  (4328)                      at - 2 =: outBuf(1)       % the name length, now known
  4989  (4329)  
  4990  (4330)                      0 =: outBuf(at)
  4991  (4331)                      0 =: outBuf(at + 1)
  4992  (4332)                      at + 2 =: at
  4993  (4333)                      at =: textStart
  4994  (4334)                      FOR j IN 1:msgLen DO
  4995  (4335)                          IF at < 250 THEN
  4996  (4336)                              inBuf(msgAt + j - 1) =: outBuf(at)
  4997  (4337)                              at + 1 =: at
  4998  (4338)                          ENDIF
  4999  (4339)                      ENDFOR
  5000  (4340)                      at - textStart =: outBuf(textStart - 1)
  5001  (4341)  
  5002  (4342)                      sendTo(memberMagic(i), at)
  5003  (4343)                  ENDIF
  5004  (4344)              ENDIF
  5005  (4345)          ENDFOR
  5006  (4346)      ENDROUTINE
  5007  (4347)  
  5008  (4348)      % -----------------------------------------------------------------------
  5009  (4349)      % THE PRESENCE DIFF - 2026-09-02. Three small routines that turn a peer's
  5010  (4350)      % silent kTrkMbrs table replace into the kJoined / kLeft notices local
  5011  (4351)      % clients already render and count. See the note by oldUsed.
  5012  (4352)      % -----------------------------------------------------------------------
  5013  (4353)  
  5014  (4354)      % Copy every row we hold for one peer into the snapshot, before the
  5015  (4355)      % replace throws them away.
  5016  (4356)      ROUTINE VOID, VOID (INTEGER) : snapshotRem(system)
  5017  (4357)          INTEGER : r, i
  5018  (4358)          FOR r IN 1:maxRemote DO
  5019  (4359)              0 =: oldUsed(r)
  5020  (4360)              IF rmtSystem(r) = system THEN
  5021  (4361)                  1 =: oldUsed(r)
  5022  (4362)                  rmtNameLen(r) =: oldNmLen(r)
  5023  (4363)                  FOR i IN 1:rmtNameLen(r) DO
  5024  (4364)                      rmtName(r, i) =: oldNm(r, i)
  5025  (4365)                  ENDFOR
  5026  (4366)                  rmtRoomLen(r) =: oldRmLen(r)
  5027  (4367)                  FOR i IN 1:rmtRoomLen(r) DO
  5028  (4368)                      rmtRoom(r, i) =: oldRm(r, i)
  5029  (4369)                  ENDFOR
  5030  (4370)              ENDIF
  5031  (4371)          ENDFOR
  5032  (4372)      ENDROUTINE
  5033  (4373)  
  5034  (4374)      % Announce annName@<machine> as joined or left, to every LOCAL seat in
  5035  (4375)      % annRoom. Modeled on deliverRemoteSaid: the person has no seat here, so
  5036  (4376)      % the audience is picked by comparing room names byte for byte, and the
  5037  (4377)      % label comes from putSysLabel exactly as a relayed line's does.
  5038  (4378)      ROUTINE VOID, VOID (INTEGER, INTEGER) : announceGo(kind, system)
  5039  (4379)          INTEGER : i, j, at
  5040  (4380)          BOOLEAN : match
  5041  (4381)  
  5042  (4382)          FOR i IN 1:maxSeats DO
  5043  (4383)              IF memberUsed(i) = 1 THEN
  5044  (4384)                  TRUE =: match
  5045  (4385)                  IF lenMbrRoom(i) >< annRoomLen THEN
  5046  (4386)                      FALSE =: match
  5047  (4387)                  ELSE
  5048  (4388)                      FOR j IN 1:annRoomLen DO
  5049  (4389)                          IF mbrRoom(i, j) >< annRoom(j - 1) THEN
  5050  (4390)                              FALSE =: match
  5051  (4391)                          ENDIF
  5052  (4392)                      ENDFOR
  5053  (4393)                  ENDIF
  5054  (4394)  
  5055  (4395)                  IF match THEN
  5056  (4396)                      kind =: outBuf(0)
  5057  (4397)                      2 =: at
  5058  (4398)                      FOR j IN 1:annNameLen DO
  5059  (4399)                          annName(j - 1) =: outBuf(at)
  5060  (4400)                          at + 1 =: at
  5061  (4401)                      ENDFOR
  5062  (4402)                      atByte(0) =: outBuf(at)
  5063  (4403)                      at + 1 =: at
  5064  (4404)                      putSysLabel(system, at) =: at
  5065  (4405)                      at - 2 =: outBuf(1)       % the name length, now known
  5066  (4406)  
  5067  (4407)                      0 =: outBuf(at)           % no text on a presence notice
  5068  (4408)                      0 =: outBuf(at + 1)
  5069  (4409)                      at + 2 =: at
  5070  (4410)  
  5071  (4411)                      sendTo(memberMagic(i), at)
  5072  (4412)                  ENDIF
  5073  (4413)              ENDIF
  5074  (4414)          ENDFOR
  5075  (4415)      ENDROUTINE
  5076  (4416)  
  5077  (4417)      % Compare the snapshot against what the replace left, and announce the
  5078  (4418)      % difference. Matching is on NAME AND ROOM, so somebody who changed room
  5079  (4419)      % on their own machine reads here as a leave from the old room and a join
  5080  (4420)      % to the new one - which is exactly what the people in each room saw.
  5081  (4421)      ROUTINE VOID, VOID (INTEGER) : announceDiff(system)
  5082  (4422)          INTEGER : r, k, i
  5083  (4423)          BOOLEAN : match
  5084  (4424)  
  5085  (4425)          % New rows with no snapshot twin: they JOINED.
  5086  (4426)          FOR r IN 1:maxRemote DO
  5087  (4427)              IF rmtSystem(r) = system THEN
  5088  (4428)                  FALSE =: match
  5089  (4429)                  FOR k IN 1:maxRemote DO
  5090  (4430)                      IF oldUsed(k) = 1 THEN
  5091  (4431)                          IF oldNmLen(k) = rmtNameLen(r) AND &
  5092  (4432)                             oldRmLen(k) = rmtRoomLen(r) THEN
  5093  (4433)                              TRUE =: match
  5094  (4434)                              FOR i IN 1:rmtNameLen(r) DO
  5095  (4435)                                  IF oldNm(k, i) >< rmtName(r, i) THEN
  5096  (4436)                                      FALSE =: match
  5097  (4437)                                  ENDIF
  5098  (4438)                              ENDFOR
  5099  (4439)                              FOR i IN 1:rmtRoomLen(r) DO
  5100  (4440)                                  IF oldRm(k, i) >< rmtRoom(r, i) THEN
  5101  (4441)                                      FALSE =: match
  5102  (4442)                                  ENDIF
  5103  (4443)                              ENDFOR
  5104  (4444)                              IF match THEN
  5105  (4445)                                  2 =: oldUsed(k)       % claimed by this row
  5106  (4446)                              ENDIF
  5107  (4447)                          ENDIF
  5108  (4448)                      ENDIF
  5109  (4449)                      WHILE NOT match
  5110  (4450)                  ENDFOR
  5111  (4451)  
  5112  (4452)                  IF NOT match THEN
  5113  (4453)                      rmtNameLen(r) =: annNameLen
  5114  (4454)                      FOR i IN 1:rmtNameLen(r) DO
  5115  (4455)                          rmtName(r, i) =: annName(i - 1)
  5116  (4456)                      ENDFOR
  5117  (4457)                      rmtRoomLen(r) =: annRoomLen
  5118  (4458)                      FOR i IN 1:rmtRoomLen(r) DO
  5119  (4459)                          rmtRoom(r, i) =: annRoom(i - 1)
  5120  (4460)                      ENDFOR
  5121  (4461)                      announceGo(kJoined, system)
  5122  (4462)                  ENDIF
  5123  (4463)              ENDIF
  5124  (4464)          ENDFOR
  5125  (4465)  
  5126  (4466)          % Snapshot rows nothing claimed: they LEFT.
  5127  (4467)          FOR k IN 1:maxRemote DO
  5128  (4468)              IF oldUsed(k) = 1 THEN
  5129  (4469)                  oldNmLen(k) =: annNameLen
  5130  (4470)                  FOR i IN 1:oldNmLen(k) DO
  5131  (4471)                      oldNm(k, i) =: annName(i - 1)
  5132  (4472)                  ENDFOR
  5133  (4473)                  oldRmLen(k) =: annRoomLen
  5134  (4474)                  FOR i IN 1:oldRmLen(k) DO
  5135  (4475)                      oldRm(k, i) =: annRoom(i - 1)
  5136  (4476)                  ENDFOR
  5137  (4477)                  announceGo(kLeft, system)
  5138  (4478)              ENDIF
  5139  (4479)          ENDFOR
  5140  (4480)      ENDROUTINE
  5141  (4481)  
  5142  (4482)      % -----------------------------------------------------------------------
  5143  (4483)      % Send what a local member just said to every peer we believe is up.
  5144  (4484)      %
  5145  (4485)      % ONLY TO PEERS THAT ARE UP. A peer that is Unknown or Down gets nothing:
  5146  (4486)      % the letter would bounce, and a bounce per message per absent machine is a
  5147  (4487)      % lot of noise for something we already know.
  5148  (4488)      %
  5149  (4489)      % The text is rebuilt as "ROOM/message" rather than sent as two fields,
  5150  (4490)      % which keeps it the same shape as the member list and readable on a trace.
  5151  (4491)      % -----------------------------------------------------------------------
  5152  (4492)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : &
  5153  (4493)              forwardSaid(slot, textAt, textLength)
  5154  (4494)          INTEGER : i, j, at, st, textStart
  5155  (4495)  
  5156  (4496)          % STAMPED ONCE, HERE, and the same number goes to every peer. That is
  5157  (4497)          % what lets a machine two hops away tell one line arriving twice from
  5158  (4498)          % two different lines. Stamping inside the loop would give each peer a
  5159  (4499)          % different number and defeat the whole thing.
  5160  (4500)          myLineId + 1 =: myLineId
  5161  (4501)          % WRAPS AT 32000, NOT 65535. A PLANC INTEGER on the ND-100 is SIXTEEN
  5162  (4502)          % BITS SIGNED, so it stops at 32767 - counting past that gives a
  5163  (4503)          % NEGATIVE number, and a negative id would be written out as two
  5164  (4504)          % nonsense bytes. 32000 leaves plenty of room and is obviously safe.
  5165  (4505)          % The window is 64 entries, so a number is long forgotten before it
  5166  (4506)          % can come round again.
  5167  (4507)          IF myLineId > 32000 THEN
  5168  (4508)              1 =: myLineId
  5169  (4509)          ENDIF
  5170  (4510)  
  5171  (4511)          FOR i IN 1:maxPeers DO
  5172  (4512)              IF peerSystem(i) >< 0 THEN
  5173  (4513)                  IF peerState(i) = peerUp THEN
  5174  (4514)  
  5175  (4515)                      % REBUILT FOR EVERY PEER, not built once outside the loop.
  5176  (4516)                      % sendToName hands outBuf to XMPFWRI, and building it once
  5177  (4517)                      % would be fine today - but the moment anything in the send
  5178  (4518)                      % path touches outBuf this becomes a bug that only shows up
  5179  (4519)                      % with two peers, which is the worst kind to find.
  5180  (4520)                      % KIND 53, not 51: it carries who we are and the number we
  5181  (4521)                      % just gave this line, so a machine further out can spot a
  5182  (4522)                      % repeat. hops is one less than the ceiling because this
  5183  (4523)                      % send IS the first hop.
  5184  (4524)                      kTrkRlId =: outBuf(0)
  5185  (4525)                      mySystem / 256 =: outBuf(1)
  5186  (4526)                      mySystem MOD 256 =: outBuf(2)
  5187  (4527)                      maxHops - 1 =: outBuf(3)
  5188  (4528)                      myLineId / 256 =: outBuf(4)
  5189  (4529)                      myLineId MOD 256 =: outBuf(5)
  5190  (4530)                      memberLen(slot) =: outBuf(6)
  5191  (4531)                      7 =: at
  5192  (4532)                      FOR j IN 1:memberLen(slot) DO
  5193  (4533)                          memberName(slot, j) =: outBuf(at)
  5194  (4534)                          at + 1 =: at
  5195  (4535)                      ENDFOR
  5196  (4536)  
  5197  (4537)                      0 =: outBuf(at)
  5198  (4538)                      0 =: outBuf(at + 1)       % low byte, filled in below
  5199  (4539)                      at + 2 =: at
  5200  (4540)                      at =: textStart
  5201  (4541)  
  5202  (4542)                      FOR j IN 1:lenMbrRoom(slot) DO
  5203  (4543)                          mbrRoom(slot, j) =: outBuf(at)
  5204  (4544)                          at + 1 =: at
  5205  (4545)                      ENDFOR
  5206  (4546)                      slashByte(0) =: outBuf(at)
  5207  (4547)                      at + 1 =: at
  5208  (4548)  
  5209  (4549)                      % CLAMPED. The text arrived from a client and outBuf is 256
  5210  (4550)                      % bytes; the room and the name have already taken some of
  5211  (4551)                      % it. PLANC checks no bound, so anything long enough would
  5212  (4552)                      % write straight past the end.
  5213  (4553)                      FOR j IN 1:textLength DO
  5214  (4554)                          IF at < 250 THEN
  5215  (4555)                              inBuf(textAt + j - 1) =: outBuf(at)
  5216  (4556)                              at + 1 =: at
  5217  (4557)                          ENDIF
  5218  (4558)                      ENDFOR
  5219  (4559)  
  5220  (4560)                      at - textStart =: outBuf(textStart - 1)
  5221  (4561)  
  5222  (4562)                      % THE STATUS IS READ, not just stored. It was assigned to
  5223  (4563)                      % st and never tested, which made a refused forward the
  5224  (4564)                      % quietest failure in the program: the speaker sees their
  5225  (4565)                      % own echo, the room here is correct, and the line simply
  5226  (4566)                      % never reaches the other machine.
  5227  (4567)                      sendToName(peerSystem(i), at) =: st
  5228  (4568)                      IF st = XMOK THEN
  5229  (4569)                          nForwarded + 1 =: nForwarded
  5230  (4570)                      ELSE
  5231  (4571)                          nFwdBad + 1 =: nFwdBad
  5232  (4572)                      ENDIF
  5233  (4573)                  ENDIF
  5234  (4574)              ENDIF
  5235  (4575)          ENDFOR
  5236  (4576)      ENDROUTINE
  5237  (4577)  
  5238  (4578)      % -----------------------------------------------------------------------
  5239  (4579)      % Pass a line on to every peer EXCEPT the one it came from.
  5240  (4580)      %
  5241  (4581)      % THIS IS THE WHOLE OF PHASE D. D102 and D103 have no trunk between them -
  5242  (4582)      % D100 is the only machine either can reach - so a line typed on D103 gets
  5243  (4583)      % to D102 only if D100 forwards it. Measured on 2026-08-24, with a control:
  5244  (4584)      % a line from D103 reached D100 and did NOT reach D102, while a line from
  5245  (4585)      % D100 reached D102 seconds later on the same client.
  5246  (4586)      %
  5247  (4587)      % TWO THINGS STOP IT LOOPING FOR EVER, and both are needed:
  5248  (4588)      %
  5249  (4589)      %   never back to the sender  a two-machine trunk would otherwise bounce
  5250  (4590)      %                             the same line between the pair immediately;
  5251  (4591)      %   the hop count             a RING would come back round the other way,
  5252  (4592)      %                             where the sender test does not help at all.
  5253  (4593)      %
  5254  (4594)      % WHAT THIS DOES NOT DO, and the difference matters: the hop count makes a
  5255  (4595)      % ring TERMINATE, it does not make it DELIVER ONCE. Trace three machines
  5256  (4596)      % all trunked to each other and a line arrives at some of them twice - once
  5257  (4597)      % direct, once relayed - and the count only stops that repeating for ever.
  5258  (4598)      % De-duplication is Phase E of CHAT-FEDERATION-DESIGN.md and is not written.
  5259  (4599)      % It costs nothing today because the real topology is a CHAIN: D102 and
  5260  (4600)      % D103 each have exactly one trunk, both to D100, so no line reaches either
  5261  (4601)      % of them by two routes.
  5262  (4602)      %
  5263  (4603)      % The ORIGIN travels rather than being taken from the letter. A receiver
  5264  (4604)      % normally qualifies the speaker with the system the letter arrived from,
  5265  (4605)      % and on a forwarded line that is the RELAY - so without this D102 would
  5266  (4606)      % show a D103 user as being on D100.
  5267  (4607)      % -----------------------------------------------------------------------
  5268  (4608)      % -----------------------------------------------------------------------
  5269  (4609)      % Have we seen this line before? Records it if not.
  5270  (4610)      %
  5271  (4611)      % ONE routine that both asks and records, deliberately. Two - a check and
  5272  (4612)      % a separate remember - invite the bug where a caller tests, forgets to
  5273  (4613)      % record, and every copy looks new, which is a dedup that does nothing.
  5274  (4614)      %
  5275  (4615)      % Answers 1 for a line we have not seen (and remembers it), 0 for a
  5276  (4616)      % repeat (and changes nothing).
  5277  (4617)      %
  5278  (4618)      % A line older than the window is treated as NEW again. That is the
  5279  (4619)      % deliberate limit of a fixed window, written down here so it is not read
  5280  (4620)      % as a fault later: a repeat arrives within a hop or two of the original,
  5281  (4621)      % so it is always well inside 64.
  5282  (4622)      % -----------------------------------------------------------------------
  5283  (4623)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : lineIsNew(fromSys, id)
  5284  (4624)          INTEGER : i
  5285  (4625)  
  5286  (4626)          FOR i IN 1:seenUsed DO
  5287  (4627)              IF seenSys(i) = fromSys THEN
  5288  (4628)                  IF seenId(i) = id THEN
  5289  (4629)                      0 RETURN
  5290  (4630)                  ENDIF
  5291  (4631)              ENDIF
  5292  (4632)          ENDFOR
  5293  (4633)  
  5294  (4634)          fromSys =: seenSys(seenAt)
  5295  (4635)          id =: seenId(seenAt)
  5296  (4636)  
  5297  (4637)          seenAt + 1 =: seenAt
  5298  (4638)          IF seenAt > maxSeen THEN
  5299  (4639)              1 =: seenAt
  5300  (4640)          ENDIF
  5301  (4641)          IF seenUsed < maxSeen THEN
  5302  (4642)              seenUsed + 1 =: seenUsed
  5303  (4643)          ENDIF
  5304  (4644)  
  5305  (4645)          1 RETURN
  5306  (4646)      ENDROUTINE
  5307  (4647)  
  5308  (4648)      % SEVEN parameters, so SEVEN types. Getting this wrong is not caught by the
  5309  (4649)      % eye: the compiler answers EXPECTS ")" at the first name it has no type
  5310  (4650)      % for, which reads like a bracket fault rather than a counting fault.
  5311  (4651)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER, INTEGER, &
  5312  (4652)              INTEGER, INTEGER) : &
  5313  (4653)              relayOn(fromSys, originSys, lineId, hopsLeft, nmAt, nmLen, &
  5314  (4654)              txAt, txLen)
  5315  (4655)          INTEGER : i, j, at, st, textStart
  5316  (4656)  
  5317  (4657)          % Nothing to do once the count runs out. Said plainly rather than
  5318  (4658)          % guarded at the call site, so every caller gets the rule.
  5319  (4659)          IF hopsLeft <= 0 THEN
  5320  (4660)              RETURN
  5321  (4661)          ENDIF
  5322  (4662)  
  5323  (4663)          FOR i IN 1:maxPeers DO
  5324  (4664)              IF peerSystem(i) >< 0 THEN
  5325  (4665)                  IF peerState(i) = peerUp THEN
  5326  (4666)                      IF peerSystem(i) >< fromSys THEN
  5327  (4667)  
  5328  (4668)                          % THE ID IS PASSED ON UNTOUCHED. Renumbering it here
  5329  (4669)                          % would make one line look like two to anybody who
  5330  (4670)                          % can reach us by a second path - which is the whole
  5331  (4671)                          % fault dedup exists to stop.
  5332  (4672)                          kTrkRlId =: outBuf(0)
  5333  (4673)                          originSys / 256 =: outBuf(1)
  5334  (4674)                          originSys MOD 256 =: outBuf(2)
  5335  (4675)                          hopsLeft =: outBuf(3)
  5336  (4676)                          lineId / 256 =: outBuf(4)
  5337  (4677)                          lineId MOD 256 =: outBuf(5)
  5338  (4678)                          nmLen =: outBuf(6)
  5339  (4679)                          7 =: at
  5340  (4680)                          FOR j IN 1:nmLen DO
  5341  (4681)                              inBuf(nmAt + j - 1) =: outBuf(at)
  5342  (4682)                              at + 1 =: at
  5343  (4683)                          ENDFOR
  5344  (4684)  
  5345  (4685)                          0 =: outBuf(at)
  5346  (4686)                          0 =: outBuf(at + 1)     % low byte, filled in below
  5347  (4687)                          at + 2 =: at
  5348  (4688)                          at =: textStart
  5349  (4689)  
  5350  (4690)                          % CLAMPED, for the same reason forwardSaid is: the text
  5351  (4691)                          % came from a stranger and outBuf is 256 bytes. PLANC
  5352  (4692)                          % checks no bound, so a long enough line would write
  5353  (4693)                          % straight past the end of it.
  5354  (4694)                          FOR j IN 1:txLen DO
  5355  (4695)                              IF at < 250 THEN
  5356  (4696)                                  inBuf(txAt + j - 1) =: outBuf(at)
  5357  (4697)                                  at + 1 =: at
  5358  (4698)                              ENDIF
  5359  (4699)                          ENDFOR
  5360  (4700)  
  5361  (4701)                          at - textStart =: outBuf(textStart - 1)
  5362  (4702)                          sendToName(peerSystem(i), at) =: st
  5363  (4703)                          nRelayed + 1 =: nRelayed
  5364  (4704)                      ENDIF
  5365  (4705)                  ENDIF
  5366  (4706)              ENDIF
  5367  (4707)          ENDFOR
  5368  (4708)      ENDROUTINE
  5369  (4709)  
  5370  (4710)      % -----------------------------------------------------------------------
  5371  (4711)      % One second has passed. Age every trunk.
  5372  (4712)      %
  5373  (4713)      % Called ONLY from the idle sleep, so a tick really is a second. Hanging it
  5374  (4714)      % off the message loop would make a busy room time peers out faster, which
  5375  (4715)      % is exactly backwards.
  5376  (4716)      %
  5377  (4717)      % TWO THINGS HAPPEN HERE and they are deliberately separate:
  5378  (4718)      %
  5379  (4719)      %   a peer we HAD goes quiet    -> declare it Down and DROP ITS PEOPLE, so
  5380  (4720)      %                                  nobody is shown chatting from a machine
  5381  (4721)      %                                  that is not answering;
  5382  (4722)      %   a peer that is not Up       -> say hello again, on a doubling wait.
  5383  (4723)      %
  5384  (4724)      % A DOWN PEER KEEPS BEING GREETED. That is the automatic re-join: nobody has
  5385  (4725)      % to notice the machine came back, and no operator command is needed. The
  5386  (4726)      % peer's own hello usually arrives first anyway.
  5387  (4727)      % -----------------------------------------------------------------------
  5388  (4728)      % =======================================================================
  5389  (4729)      % DIRECT MESSAGES
  5390  (4730)      %
  5391  (4731)      % THE ADDRESS FORMS, and what each one costs to resolve:
  5392  (4732)      %
  5393  (4733)      %   RONNY            a bare alias. Looked for on THIS machine and on every
  5394  (4734)      %                    machine we hold a member list for. Exactly one match
  5395  (4735)      %                    is delivered; two or more are REFUSED with the list.
  5396  (4736)      %   D102!RONNY       qualified. Looked for on that machine alone.
  5397  (4737)      %
  5398  (4738)      % A BARE ALIAS MATCHING TWO PEOPLE IS NEVER GUESSED AT. Two machines can
  5399  (4739)      % each hold a RONNY long before they are ever trunked together, so no
  5400  (4740)      % global uniqueness rule could have been applied even in principle - and a
  5401  (4741)      % private message delivered to the wrong person is a privacy failure, not
  5402  (4742)      % an inconvenience. The refusal carries both candidates so the sender can
  5403  (4743)      % retype one of them off the screen.
  5404  (4744)      % =======================================================================
  5405  (4745)  
  5406  (4746)      % Where the '/' is that separates the target from the message, counted
  5407  (4747)      % from "at". -1 if there is none.
  5408  (4748)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findSlash(at, length)
  5409  (4749)          INTEGER : i
  5410  (4750)          IF length < 1 THEN
  5411  (4751)              0 - 1 RETURN
  5412  (4752)          ENDIF
  5413  (4753)          FOR i IN 0:length - 1 DO
  5414  (4754)              IF inBuf(at + i) = slashByte(0) THEN
  5415  (4755)                  i RETURN
  5416  (4756)              ENDIF
  5417  (4757)          ENDFOR
  5418  (4758)          0 - 1 RETURN
  5419  (4759)      ENDROUTINE
  5420  (4760)  
  5421  (4761)      % Where the '!' is inside a target, counted from "at". -1 if there is none,
  5422  (4762)      % which is what says "this is a bare alias".
  5423  (4763)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findBang(at, length)
  5424  (4764)          INTEGER : i
  5425  (4765)          IF length < 1 THEN
  5426  (4766)              0 - 1 RETURN
  5427  (4767)          ENDIF
  5428  (4768)          FOR i IN 0:length - 1 DO
  5429  (4769)              IF inBuf(at + i) = bangByte(0) THEN
  5430  (4770)                  i RETURN
  5431  (4771)              ENDIF
  5432  (4772)          ENDFOR
  5433  (4773)          0 - 1 RETURN
  5434  (4774)      ENDROUTINE
  5435  (4775)  
  5436  (4776)      % "D102" or "102" as the number 102.
  5437  (4777)      %
  5438  (4778)      % trunkNumber already parses digits and is used for the admin commands, but
  5439  (4779)      % it REFUSES anything that is not a digit - so it answers 0 for "D102",
  5440  (4780)      % which is exactly how people write a machine. Leading letters are skipped
  5441  (4781)      % here rather than changing trunkNumber, because the admin commands take a
  5442  (4782)      % bare number and loosening that would let a typo through there.
  5443  (4783)      %
  5444  (4784)      % Answers 0 for anything with no digits at all, and 0 is not a machine.
  5445  (4785)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : machineNum(at, length)
  5446  (4786)          INTEGER : i, d, value, seen
  5447  (4787)          0 =: value
  5448  (4788)          0 =: seen
  5449  (4789)          IF length < 1 THEN
  5450  (4790)              0 RETURN
  5451  (4791)          ENDIF
  5452  (4792)          FOR i IN 1:length DO
  5453  (4793)              inBuf(at + i - 1) =: d
  5454  (4794)              IF d >= 48 THEN
  5455  (4795)                  IF d <= 57 THEN
  5456  (4796)                      (value * 10) + (d - 48) =: value
  5457  (4797)                      1 =: seen
  5458  (4798)                  ENDIF
  5459  (4799)              ENDIF
  5460  (4800)          ENDFOR
  5461  (4801)          IF seen = 0 THEN
  5462  (4802)              0 RETURN
  5463  (4803)          ENDIF
  5464  (4804)          value RETURN
  5465  (4805)      ENDROUTINE
  5466  (4806)  
  5467  (4807)      % A MACHINE BY ITS NAME - "FJELL" or "VIDDA" - answering its number.
  5468  (4808)      %
  5469  (4809)      % WHY THIS EXISTS: this server PRINTS machines by name. A direct message
  5470  (4810)      % from somebody on this machine arrives labelled FJELL!BOB, and one from a
  5471  (4811)      % peer arrives VIDDA!SYSTEM, because a name reads far better than D100. But
  5472  (4812)      % the target parser only ever understood DIGITS, so the very label the
  5473  (4813)      % server had just printed could not be typed back at it:
  5474  (4814)      %
  5475  (4815)      %     NOT sent to FJELL!BOB: that machine has no number in it
  5476  (4816)      %
  5477  (4817)      % MEASURED on D100 2026-08-26, and it is the one thing that stopped a reply
  5478  (4818)      % typed in a conversation window from arriving. A product that shows a name
  5479  (4819)      % it will not accept is asking a person to translate for it.
  5480  (4820)      %
  5481  (4821)      % Case folded, exactly as sameRmt does for a person: a name that works in
  5482  (4822)      % one case and fails in the other is a maddening thing to report.
  5483  (4823)      %
  5484  (4824)      % Answers 0 for a name nobody has, and 0 is not a machine.
  5485  (4825)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : machineByName(at, length)
  5486  (4826)          INTEGER : i, j, a, b, same
  5487  (4827)  
  5488  (4828)          IF length < 1 THEN
  5489  (4829)              0 RETURN
  5490  (4830)          ENDIF
  5491  (4831)  
  5492  (4832)          % OURSELVES FIRST. A local conversation is the common case, and it is
  5493  (4833)          % also the one that has to work when no trunk has ever come up.
  5494  (4834)          IF lenSysName = length THEN
  5495  (4835)              1 =: same
  5496  (4836)              FOR j IN 1:length DO
  5497  (4837)                  sysName(j - 1) =: a
  5498  (4838)                  inBuf(at + j - 1) =: b
  5499  (4839)                  IF a > 96 THEN
  5500  (4840)                      a - 32 =: a
  5501  (4841)                  ENDIF
  5502  (4842)                  IF b > 96 THEN
  5503  (4843)                      b - 32 =: b
  5504  (4844)                  ENDIF
  5505  (4845)                  IF a >< b THEN
  5506  (4846)                      0 =: same
  5507  (4847)                  ENDIF
  5508  (4848)              ENDFOR
  5509  (4849)              IF same >< 0 THEN
  5510  (4850)                  mySystem RETURN
  5511  (4851)              ENDIF
  5512  (4852)          ENDIF
  5513  (4853)  
  5514  (4854)          % Then the peers we have been told the names of. A peer that has never
  5515  (4855)          % said its name has pNameLen 0 and simply does not match.
  5516  (4856)          FOR i IN 1:maxPeers DO
  5517  (4857)              IF peerSystem(i) >< 0 THEN
  5518  (4858)                  IF pNameLen(i) = length THEN
  5519  (4859)                      1 =: same
  5520  (4860)                      FOR j IN 1:length DO
  5521  (4861)                          pName(i, j) =: a
  5522  (4862)                          inBuf(at + j - 1) =: b
  5523  (4863)                          IF a > 96 THEN
  5524  (4864)                              a - 32 =: a
  5525  (4865)                          ENDIF
  5526  (4866)                          IF b > 96 THEN
  5527  (4867)                              b - 32 =: b
  5528  (4868)                          ENDIF
  5529  (4869)                          IF a >< b THEN
  5530  (4870)                              0 =: same
  5531  (4871)                          ENDIF
  5532  (4872)                      ENDFOR
  5533  (4873)                      IF same >< 0 THEN
  5534  (4874)                          peerSystem(i) RETURN
  5535  (4875)                      ENDIF
  5536  (4876)                  ENDIF
  5537  (4877)              ENDIF
  5538  (4878)          ENDFOR
  5539  (4879)  
  5540  (4880)          0 RETURN
  5541  (4881)      ENDROUTINE
  5542  (4882)  
  5543  (4883)      % Does the person we hold in remote row "row" have this name?
  5544  (4884)      %
  5545  (4885)      % Case folded exactly as sameName does for a local seat. A direct message
  5546  (4886)      % that works for a local RONNY and fails for a remote ronny would be a
  5547  (4887)      % maddening thing to report and an obvious thing to prevent.
  5548  (4888)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : sameRmt(row, at, length)
  5549  (4889)          INTEGER : j, a, b
  5550  (4890)          IF rmtNameLen(row) >< length THEN
  5551  (4891)              0 RETURN
  5552  (4892)          ENDIF
  5553  (4893)          FOR j IN 1:length DO
  5554  (4894)              rmtName(row, j) =: a
  5555  (4895)              inBuf(at + j - 1) =: b
  5556  (4896)              IF a > 96 THEN a - 32 =: a ENDIF
  5557  (4897)              IF b > 96 THEN b - 32 =: b ENDIF
  5558  (4898)              IF a >< b THEN
  5559  (4899)                  0 RETURN
  5560  (4900)              ENDIF
  5561  (4901)          ENDFOR
  5562  (4902)          1 RETURN
  5563  (4903)      ENDROUTINE
  5564  (4904)  
  5565  (4905)      % Who does this alias mean? Answers into the four dir* variables rather
  5566  (4906)      % than returning, because it has four things to say and PLANC returns one.
  5567  (4907)      %
  5568  (4908)      % wantSys = 0 means "any machine"; otherwise only that one is searched.
  5569  (4909)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : &
  5570  (4910)              resolveTo(at, length, wantSys)
  5571  (4911)          INTEGER : i
  5572  (4912)          0 =: dirCount
  5573  (4913)          0 =: dirLocal
  5574  (4914)          0 =: dirRemote
  5575  (4915)          0 =: dirSystem
  5576  (4916)  
  5577  (4917)          IF wantSys = 0 OR wantSys = mySystem THEN
  5578  (4918)              FOR i IN 1:maxSeats DO
  5579  (4919)                  IF memberUsed(i) = 1 THEN
  5580  (4920)                      IF sameName(i, at, length) = 1 THEN
  5581  (4921)                          dirCount + 1 =: dirCount
  5582  (4922)                          IF dirLocal = 0 THEN
  5583  (4923)                              i =: dirLocal
  5584  (4924)                              mySystem =: dirSystem
  5585  (4925)                          ENDIF
  5586  (4926)                      ENDIF
  5587  (4927)                  ENDIF
  5588  (4928)              ENDFOR
  5589  (4929)          ENDIF
  5590  (4930)  
  5591  (4931)          FOR i IN 1:maxRemote DO
  5592  (4932)              IF rmtSystem(i) >< 0 THEN
  5593  (4933)                  IF wantSys = 0 OR wantSys = rmtSystem(i) THEN
  5594  (4934)                      IF sameRmt(i, at, length) = 1 THEN
  5595  (4935)                          dirCount + 1 =: dirCount
  5596  (4936)                          IF dirRemote = 0 THEN
  5597  (4937)                              IF dirLocal = 0 THEN
  5598  (4938)                                  i =: dirRemote
  5599  (4939)                                  rmtSystem(i) =: dirSystem
  5600  (4940)                              ENDIF
  5601  (4941)                          ENDIF
  5602  (4942)                      ENDIF
  5603  (4943)                  ENDIF
  5604  (4944)              ENDIF
  5605  (4945)          ENDFOR
  5606  (4946)      ENDROUTINE
  5607  (4947)  
  5608  (4948)      % Put "FJELL!" - or "Dnnn!" when nothing is named. Answers the new cursor.
  5609  (4949)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : putMachine(sysNum, at)
  5610  (4950)          INTEGER : p
  5611  (4951)          putSysLabel(sysNum, at) =: p
  5612  (4952)          bangByte(0) =: outBuf(p)
  5613  (4953)          p + 1 =: p
  5614  (4954)          p RETURN
  5615  (4955)      ENDROUTINE
  5616  (4956)  
  5617  (4957)      % "Dnnn!NAME" from a LOCAL seat. Answers the new cursor.
  5618  (4958)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : &
  5619  (4959)              putQualSlot(sysNum, slot, at)
  5620  (4960)          INTEGER : i, p
  5621  (4961)          putMachine(sysNum, at) =: p
  5622  (4962)          FOR i IN 1:memberLen(slot) DO
  5623  (4963)              memberName(slot, i) =: outBuf(p)
  5624  (4964)              p + 1 =: p
  5625  (4965)          ENDFOR
  5626  (4966)          p RETURN
  5627  (4967)      ENDROUTINE
  5628  (4968)  
  5629  (4969)      % "Dnnn!NAME" where the name is sitting in inBuf. Answers the new cursor.
  5630  (4970)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER) : &
  5631  (4971)              putQualIn(sysNum, nameAt, nmLen, at)
  5632  (4972)          INTEGER : i, p
  5633  (4973)          putMachine(sysNum, at) =: p
  5634  (4974)          FOR i IN 1:nmLen DO
  5635  (4975)              inBuf(nameAt + i - 1) =: outBuf(p)
  5636  (4976)              p + 1 =: p
  5637  (4977)          ENDFOR
  5638  (4978)          p RETURN
  5639  (4979)      ENDROUTINE
  5640  (4980)  
  5641  (4981)      % REFUSED, and here is why.
  5642  (4982)      %
  5643  (4983)      % The reason's length comes from MAXINDEX rather than being typed beside
  5644  (4984)      % the literal - a hand-counted length builds clean and shows only as a
  5645  (4985)      % truncated sentence on somebody else's screen.
  5646  (4986)      ROUTINE VOID, VOID (INTEGER4, INTEGER, INTEGER, BYTES) : &
  5647  (4987)              sendDirBad(magic, tgtAt, tgtLen, reason)
  5648  (4988)          INTEGER : i, at, textStart, reasonLen
  5649  (4989)  
  5650  (4990)          kDirBad =: outBuf(0)
  5651  (4991)          tgtLen =: outBuf(1)
  5652  (4992)          2 =: at
  5653  (4993)          FOR i IN 1:tgtLen DO
  5654  (4994)              inBuf(tgtAt + i - 1) =: outBuf(at)
  5655  (4995)              at + 1 =: at
  5656  (4996)          ENDFOR
  5657  (4997)  
  5658  (4998)          0 =: outBuf(at)
  5659  (4999)          0 =: outBuf(at + 1)
  5660  (5000)          at + 2 =: at
  5661  (5001)          at =: textStart
  5662  (5002)  
  5663  (5003)          MAXINDEX(reason, 1) + 1 =: reasonLen
  5664  (5004)          FOR i IN 1:reasonLen DO
  5665  (5005)              IF at < 250 THEN
  5666  (5006)                  reason(i - 1) =: outBuf(at)
  5667  (5007)                  at + 1 =: at
  5668  (5008)              ENDIF
  5669  (5009)          ENDFOR
  5670  (5010)  
  5671  (5011)          at - textStart =: outBuf(textStart - 1)
  5672  (5012)          dmBad + 1 =: dmBad
  5673  (5013)          sendTo(magic, at)
  5674  (5014)      ENDROUTINE
  5675  (5015)  
  5676  (5016)      % REFUSED BECAUSE THE NAME MEANS MORE THAN ONE PERSON, and here they are.
  5677  (5017)      %
  5678  (5018)      % Carrying the candidates is what makes this usable rather than merely
  5679  (5019)      % annoying: the sender retypes one of them straight off their screen. The
  5680  (5020)      % table is walked a second time - resolveTo only kept the FIRST match,
  5681  (5021)      % because keeping all of them would need a list for a case that is rare.
  5682  (5022)      ROUTINE VOID, VOID (INTEGER4, INTEGER, INTEGER) : &
  5683  (5023)              sendDirAmbig(magic, aliasAt, aliasLen)
  5684  (5024)          INTEGER : i, j, at, textStart, first
  5685  (5025)  
  5686  (5026)          kDirBad =: outBuf(0)
  5687  (5027)          aliasLen =: outBuf(1)
  5688  (5028)          2 =: at
  5689  (5029)          FOR i IN 1:aliasLen DO
  5690  (5030)              inBuf(aliasAt + i - 1) =: outBuf(at)
  5691  (5031)              at + 1 =: at
  5692  (5032)          ENDFOR
  5693  (5033)  
  5694  (5034)          0 =: outBuf(at)
  5695  (5035)          0 =: outBuf(at + 1)
  5696  (5036)          at + 2 =: at
  5697  (5037)          at =: textStart
  5698  (5038)  
  5699  (5039)          putWord('which one? ', at) =: at
  5700  (5040)          1 =: first
  5701  (5041)  
  5702  (5042)          FOR i IN 1:maxSeats DO
  5703  (5043)              IF memberUsed(i) = 1 THEN
  5704  (5044)                  IF sameName(i, aliasAt, aliasLen) = 1 THEN
  5705  (5045)                      IF first = 0 THEN
  5706  (5046)                          putWord(', ', at) =: at
  5707  (5047)                      ENDIF
  5708  (5048)                      0 =: first
  5709  (5049)                      IF at < 200 THEN
  5710  (5050)                          putQualSlot(mySystem, i, at) =: at
  5711  (5051)                      ENDIF
  5712  (5052)                  ENDIF
  5713  (5053)              ENDIF
  5714  (5054)          ENDFOR
  5715  (5055)  
  5716  (5056)          FOR i IN 1:maxRemote DO
  5717  (5057)              IF rmtSystem(i) >< 0 THEN
  5718  (5058)                  IF sameRmt(i, aliasAt, aliasLen) = 1 THEN
  5719  (5059)                      IF first = 0 THEN
  5720  (5060)                          putWord(', ', at) =: at
  5721  (5061)                      ENDIF
  5722  (5062)                      0 =: first
  5723  (5063)                      IF at < 200 THEN
  5724  (5064)                          putMachine(rmtSystem(i), at) =: at
  5725  (5065)                          FOR j IN 1:rmtNameLen(i) DO
  5726  (5066)                              rmtName(i, j) =: outBuf(at)
  5727  (5067)                              at + 1 =: at
  5728  (5068)                          ENDFOR
  5729  (5069)                      ENDIF
  5730  (5070)                  ENDIF
  5731  (5071)              ENDIF
  5732  (5072)          ENDFOR
  5733  (5073)  
  5734  (5074)          at - textStart =: outBuf(textStart - 1)
  5735  (5075)          dmBad + 1 =: dmBad
  5736  (5076)          sendTo(magic, at)
  5737  (5077)      ENDROUTINE
  5738  (5078)  
  5739  (5079)      % DELIVERED - and this says to whom, in the form it can be typed back in.
  5740  (5080)      %
  5741  (5081)      % Sent on EVERY delivery and not only the ambiguous ones. Refusing an
  5742  (5082)      % ambiguous alias protects the sender when the collision is visible; this
  5743  (5083)      % protects them when it is NOT - a machine that just went down, a second
  5744  (5084)      % RONNY who logged in a moment ago, a trunk that came back with a different
  5745  (5085)      % user list. A wrong delivery becomes visible at once instead of days
  5746  (5086)      % later, and it costs one line.
  5747  (5087)      ROUTINE VOID, VOID (INTEGER4, INTEGER, INTEGER, INTEGER) : &
  5748  (5088)              sendDirSent(magic, sysNum, nameAt, nmLen)
  5749  (5089)          INTEGER : at
  5750  (5090)  
  5751  (5091)          kDirSent =: outBuf(0)
  5752  (5092)          0 =: outBuf(1)                     % filled in below
  5753  (5093)          2 =: at
  5754  (5094)          putQualIn(sysNum, nameAt, nmLen, at) =: at
  5755  (5095)          at - 2 =: outBuf(1)
  5756  (5096)  
  5757  (5097)          % AN EMPTY TEXT STILL WRITES BOTH LENGTH BYTES. Leaving them out makes
  5758  (5098)          % the message one byte short and the reader takes the next field from
  5759  (5099)          % the wrong offset - which looks like a corrupt name rather than a
  5760  (5100)          % missing length. Pinned by the C# golden test.
  5761  (5101)          0 =: outBuf(at)
  5762  (5102)          0 =: outBuf(at + 1)
  5763  (5103)          at + 2 =: at
  5764  (5104)  
  5765  (5105)          dmSent + 1 =: dmSent
  5766  (5106)          sendTo(magic, at)
  5767  (5107)      ENDROUTINE
  5768  (5108)  
  5769  (5109)      % HAND IT TO SOMEBODY ON THIS MACHINE.
  5770  (5110)      %
  5771  (5111)      % The sender is named by their SEAT and never by anything in the message -
  5772  (5112)      % otherwise anyone could send a direct message as anyone. That is the same
  5773  (5113)      % rule kSay already follows, and it matters more here, not less.
  5774  (5114)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER, INTEGER) : &
  5775  (5115)              deliverLocal(fromSlot, toSlot, msgAt, msgLen)
  5776  (5116)          INTEGER : i, at, textStart
  5777  (5117)  
  5778  (5118)          kDirGot =: outBuf(0)
  5779  (5119)          0 =: outBuf(1)
  5780  (5120)          2 =: at
  5781  (5121)          putQualSlot(mySystem, fromSlot, at) =: at
  5782  (5122)          at - 2 =: outBuf(1)
  5783  (5123)  
  5784  (5124)          0 =: outBuf(at)
  5785  (5125)          0 =: outBuf(at + 1)
  5786  (5126)          at + 2 =: at
  5787  (5127)          at =: textStart
  5788  (5128)  
  5789  (5129)          % CLAMPED. The text came from a client and outBuf is 256 bytes; the
  5790  (5130)          % qualified sender has already taken some of it. PLANC checks no bound,
  5791  (5131)          % so a long enough message would write straight past the end.
  5792  (5132)          FOR i IN 1:msgLen DO
  5793  (5133)              IF at < 250 THEN
  5794  (5134)                  inBuf(msgAt + i - 1) =: outBuf(at)
  5795  (5135)                  at + 1 =: at
  5796  (5136)              ENDIF
  5797  (5137)          ENDFOR
  5798  (5138)  
  5799  (5139)          at - textStart =: outBuf(textStart - 1)
  5800  (5140)          sendTo(memberMagic(toSlot), at)
  5801  (5141)      ENDROUTINE
  5802  (5142)  
  5803  (5143)      % SEND IT ACROSS A TRUNK.
  5804  (5144)      %
  5805  (5145)      % Same six-byte header as a relayed room line, so the far end can
  5806  (5146)      % de-duplicate it with the machinery that already exists. The text is
  5807  (5147)      % TARGET/message where a room line carries ROOM/message, which leaves the
  5808  (5148)      % name field for the SENDER - the one thing the far end has to display.
  5809  (5149)      %
  5810  (5150)      % THE TARGET GOES OUT UNQUALIFIED. The letter is addressed to that machine
  5811  (5151)      % already, so repeating the machine inside the text would only give the two
  5812  (5152)      % copies a chance to disagree.
  5813  (5153)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER, &
  5814  (5154)                             INTEGER) : &
  5815  (5155)              sendDirTrunk(fromSlot, toSys, aliasAt, aliasLen, msgAt, msgLen)
  5816  (5156)          INTEGER : j, at, st, textStart
  5817  (5157)  
  5818  (5158)          % STAMPED HERE, exactly as forwardSaid stamps a room line and for the
  5819  (5159)          % same reason: the number has to come from the ORIGIN, or a machine two
  5820  (5160)          % hops out cannot tell one message arriving twice from two messages.
  5821  (5161)          myLineId + 1 =: myLineId
  5822  (5162)          IF myLineId > 32000 THEN
  5823  (5163)              1 =: myLineId
  5824  (5164)          ENDIF
  5825  (5165)  
  5826  (5166)          kTrkDir =: outBuf(0)
  5827  (5167)          mySystem / 256 =: outBuf(1)
  5828  (5168)          mySystem MOD 256 =: outBuf(2)
  5829  (5169)          maxHops - 1 =: outBuf(3)
  5830  (5170)          myLineId / 256 =: outBuf(4)
  5831  (5171)          myLineId MOD 256 =: outBuf(5)
  5832  (5172)          memberLen(fromSlot) =: outBuf(6)
  5833  (5173)          7 =: at
  5834  (5174)          FOR j IN 1:memberLen(fromSlot) DO
  5835  (5175)              memberName(fromSlot, j) =: outBuf(at)
  5836  (5176)              at + 1 =: at
  5837  (5177)          ENDFOR
  5838  (5178)  
  5839  (5179)          0 =: outBuf(at)
  5840  (5180)          0 =: outBuf(at + 1)
  5841  (5181)          at + 2 =: at
  5842  (5182)          at =: textStart
  5843  (5183)  
  5844  (5184)          FOR j IN 1:aliasLen DO
  5845  (5185)              inBuf(aliasAt + j - 1) =: outBuf(at)
  5846  (5186)              at + 1 =: at
  5847  (5187)          ENDFOR
  5848  (5188)          slashByte(0) =: outBuf(at)
  5849  (5189)          at + 1 =: at
  5850  (5190)  
  5851  (5191)          FOR j IN 1:msgLen DO
  5852  (5192)              IF at < 250 THEN
  5853  (5193)                  inBuf(msgAt + j - 1) =: outBuf(at)
  5854  (5194)                  at + 1 =: at
  5855  (5195)              ENDIF
  5856  (5196)          ENDFOR
  5857  (5197)  
  5858  (5198)          at - textStart =: outBuf(textStart - 1)
  5859  (5199)          sendToName(toSys, at) =: st
  5860  (5200)          st RETURN
  5861  (5201)      ENDROUTINE
  5862  (5202)  
  5863  (5203)      % =======================================================================
  5864  (5204)      % A DIRECT MESSAGE COULD NOT BE DELIVERED HERE - TELL THE SENDER'S MACHINE
  5865  (5205)      %
  5866  (5206)      % kTrkDBad, kind 55. Without it a direct message that crosses a trunk and
  5867  (5207)      % finds nobody at the far end DISAPPEARS: the sender was already told
  5868  (5208)      % kDirSent by their own server, so a person who logged out - or renamed - in
  5869  (5209)      % the gap between the two ends agreeing loses the line with nobody told.
  5870  (5210)      %
  5871  (5211)      % THE ORIGIN FIELD IS **US**, not the sender's machine. Every other kind
  5872  (5212)      % uses that field for the machine the line was TYPED on, and lineIsNew
  5873  (5213)      % dedups on the pair (origin, id) - so a refusal we compose is ours. Nothing
  5874  (5214)      % routes by it: the refusal reaches the sender's machine because sendToName
  5875  (5215)      % is told where to put it, not because of anything in the header.
  5876  (5216)      %
  5877  (5217)      % THE ID IS THE FAILED MESSAGE'S, passed straight through. That is what lets
  5878  (5218)      % the far end say WHICH message, and it is why the id has to be handed to
  5879  (5219)      % takeRemDirect rather than left in handleMessage where it is parsed.
  5880  (5220)      %
  5881  (5221)      % The text is TARGET/reason, which is exactly the shape kDirBad already uses
  5882  (5222)      % locally - so the machine that receives this hands it to code it already
  5883  (5223)      % has, and no client changes at all.
  5884  (5224)      % =======================================================================
  5885  (5225)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER, &
  5886  (5226)                             INTEGER, BYTES) : &
  5887  (5227)              sendTrkBad(toSys, lineId, senderAt, senderLen, tgtAt, tgtLen, why)
  5888  (5228)          INTEGER : j, at, st, textStart, whyLen
  5889  (5229)  
  5890  (5230)          kTrkDBad =: outBuf(0)
  5891  (5231)          mySystem / 256 =: outBuf(1)
  5892  (5232)          mySystem MOD 256 =: outBuf(2)
  5893  (5233)          maxHops - 1 =: outBuf(3)
  5894  (5234)          lineId / 256 =: outBuf(4)
  5895  (5235)          lineId MOD 256 =: outBuf(5)
  5896  (5236)          senderLen =: outBuf(6)
  5897  (5237)          7 =: at
  5898  (5238)  
  5899  (5239)          FOR j IN 1:senderLen DO
  5900  (5240)              inBuf(senderAt + j - 1) =: outBuf(at)
  5901  (5241)              at + 1 =: at
  5902  (5242)          ENDFOR
  5903  (5243)  
  5904  (5244)          0 =: outBuf(at)
  5905  (5245)          0 =: outBuf(at + 1)
  5906  (5246)          at + 2 =: at
  5907  (5247)          at =: textStart
  5908  (5248)  
  5909  (5249)          FOR j IN 1:tgtLen DO
  5910  (5250)              IF at < 250 THEN
  5911  (5251)                  inBuf(tgtAt + j - 1) =: outBuf(at)
  5912  (5252)                  at + 1 =: at
  5913  (5253)              ENDIF
  5914  (5254)          ENDFOR
  5915  (5255)          slashByte(0) =: outBuf(at)
  5916  (5256)          at + 1 =: at
  5917  (5257)  
  5918  (5258)          % The length comes from MAXINDEX and is never typed beside the literal -
  5919  (5259)          % a hand-counted length builds clean and shows only as a truncated
  5920  (5260)          % sentence on somebody else's screen.
  5921  (5261)          MAXINDEX(why, 1) + 1 =: whyLen
  5922  (5262)          FOR j IN 1:whyLen DO
  5923  (5263)              IF at < 250 THEN
  5924  (5264)                  why(j - 1) =: outBuf(at)
  5925  (5265)                  at + 1 =: at
  5926  (5266)              ENDIF
  5927  (5267)          ENDFOR
  5928  (5268)  
  5929  (5269)          at - textStart =: outBuf(textStart - 1)
  5930  (5270)          sendToName(toSys, at) =: st
  5931  (5271)          st RETURN
  5932  (5272)      ENDROUTINE
  5933  (5273)  
  5934  (5274)      % =======================================================================
  5935  (5275)      % A DIRECT MESSAGE ARRIVES FROM A CLIENT
  5936  (5276)      %
  5937  (5277)      % The text is TARGET/message. Everything that can go wrong is answered with
  5938  (5278)      % kDirBad and a sentence, because the person who typed it is the only one
  5939  (5279)      % who can put it right and they cannot see this machine.
  5940  (5280)      % =======================================================================
  5941  (5281)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : &
  5942  (5282)              handleDirect(slot, textAt, textLength)
  5943  (5283)          INTEGER : cut, tgtAt, tgtLen, msgAt, msgLen
  5944  (5284)          INTEGER : bang, sysNum, aliasAt, aliasLen, row, st
  5945  (5285)  
  5946  (5286)          findSlash(textAt, textLength) =: cut
  5947  (5287)          IF cut < 1 THEN
  5948  (5288)              sendDirBad(memberMagic(slot), textAt, 0, &
  5949  (5289)                  'a direct message is NAME/text - a name, a slash, then what to say')
  5950  (5290)              RETURN
  5951  (5291)          ENDIF
  5952  (5292)  
  5953  (5293)          textAt =: tgtAt
  5954  (5294)          cut =: tgtLen
  5955  (5295)          textAt + cut + 1 =: msgAt
  5956  (5296)          textLength - cut - 1 =: msgLen
  5957  (5297)          IF msgLen < 1 THEN
  5958  (5298)              sendDirBad(memberMagic(slot), tgtAt, tgtLen, &
  5959  (5299)                  'there was nothing after the slash to send')
  5960  (5300)              RETURN
  5961  (5301)          ENDIF
  5962  (5302)  
  5963  (5303)          % Qualified by machine, or a bare alias?
  5964  (5304)          findBang(tgtAt, tgtLen) =: bang
  5965  (5305)          IF bang < 0 THEN
  5966  (5306)              tgtAt =: aliasAt
  5967  (5307)              tgtLen =: aliasLen
  5968  (5308)              0 =: sysNum
  5969  (5309)          ELSE
  5970  (5310)              machineNum(tgtAt, bang) =: sysNum
  5971  (5311)  
  5972  (5312)              % NO DIGITS? THEN TRY IT AS A NAME. This is what makes the label
  5973  (5313)              % the server itself printed - FJELL!BOB, VIDDA!SYSTEM - typeable
  5974  (5314)              % straight back, which is what a reply in a conversation window
  5975  (5315)              % does. Digits are still tried FIRST so D102!RONNY is unaffected
  5976  (5316)              % and costs nothing.
  5977  (5317)              IF sysNum = 0 THEN
  5978  (5318)                  machineByName(tgtAt, bang) =: sysNum
  5979  (5319)              ENDIF
  5980  (5320)  
  5981  (5321)              tgtAt + bang + 1 =: aliasAt
  5982  (5322)              tgtLen - bang - 1 =: aliasLen
  5983  (5323)              IF sysNum = 0 THEN
  5984  (5324)                  sendDirBad(memberMagic(slot), tgtAt, tgtLen, &
  5985  (5325)                      'no machine of that name or number - try D102!RONNY')
  5986  (5326)                  RETURN
  5987  (5327)              ENDIF
  5988  (5328)              IF aliasLen < 1 THEN
  5989  (5329)                  sendDirBad(memberMagic(slot), tgtAt, tgtLen, &
  5990  (5330)                      'there is a machine but no name after it - try D102!RONNY')
  5991  (5331)                  RETURN
  5992  (5332)              ENDIF
  5993  (5333)          ENDIF
  5994  (5334)  
  5995  (5335)          resolveTo(aliasAt, aliasLen, sysNum)
  5996  (5336)  
  5997  (5337)          IF dirCount = 0 THEN
  5998  (5338)              % NOT A QUEUE. There is deliberately no store and forward: a
  5999  (5339)              % message that waits for somebody is a mailbox, a different product
  6000  (5340)              % with different rules, and SINTRAN already has mail for that.
  6001  (5341)              sendDirBad(memberMagic(slot), tgtAt, tgtLen, &
  6002  (5342)                  'nobody of that name is here now, and nothing is kept for later')
  6003  (5343)              RETURN
  6004  (5344)          ENDIF
  6005  (5345)  
  6006  (5346)          IF dirCount > 1 THEN
  6007  (5347)              % NEVER GUESSED AT. Two machines can each hold a RONNY long before
  6008  (5348)              % they are ever trunked together, so no uniqueness rule could have
  6009  (5349)              % been applied even in principle - and a private message delivered
  6010  (5350)              % to the wrong person is a privacy failure, not an inconvenience.
  6011  (5351)              sendDirAmbig(memberMagic(slot), aliasAt, aliasLen)
  6012  (5352)              RETURN
  6013  (5353)          ENDIF
  6014  (5354)  
  6015  (5355)          IF dirLocal > 0 THEN
  6016  (5356)              deliverLocal(slot, dirLocal, msgAt, msgLen)
  6017  (5357)              sendDirSent(memberMagic(slot), mySystem, aliasAt, aliasLen)
  6018  (5358)              RETURN
  6019  (5359)          ENDIF
  6020  (5360)  
  6021  (5361)          % ---- ON ANOTHER MACHINE -------------------------------------------
  6022  (5362)          %
  6023  (5363)          % ONE HOP ONLY, AND THAT IS A DELIBERATE FIRST CUT.
  6024  (5364)          %
  6025  (5365)          % A room line is FLOODED to every peer and de-duplicated at the far
  6026  (5366)          % end. A private message must NOT be: flooding one hands it to machines
  6027  (5367)          % that have no business seeing it, which is a privacy failure dressed
  6028  (5368)          % up as routing. So this sends only to the machine that holds the
  6029  (5369)          % person, and refuses when that machine is not a direct peer.
  6030  (5370)          %
  6031  (5371)          % On the D102 - D100 - D103 chain that means D100 reaches both ends and
  6032  (5372)          % each end reaches only D100. THAT LIMIT IS REAL AND IT IS VISIBLE: the
  6033  (5373)          % sender is told in words rather than the message quietly vanishing.
  6034  (5374)          % Routing onward by the target machine - each hop forwarding to the
  6035  (5375)          % peer that matches - is the next step, and it needs a way to carry a
  6036  (5376)          % refusal back, which no kind does yet.
  6037  (5377)          findPeer(dirSystem) =: row
  6038  (5378)          IF row = 0 THEN
  6039  (5379)              sendDirBad(memberMagic(slot), tgtAt, tgtLen, &
  6040  (5380)                  'they are on a machine this one has no trunk to')
  6041  (5381)              RETURN
  6042  (5382)          ENDIF
  6043  (5383)          IF peerState(row) >< peerUp THEN
  6044  (5384)              sendDirBad(memberMagic(slot), tgtAt, tgtLen, &
  6045  (5385)                  'the trunk to their machine is down just now')
  6046  (5386)              RETURN
  6047  (5387)          ENDIF
  6048  (5388)  
  6049  (5389)          sendDirTrunk(slot, dirSystem, aliasAt, aliasLen, msgAt, msgLen) =: st
  6050  (5390)          sendDirSent(memberMagic(slot), dirSystem, aliasAt, aliasLen)
  6051  (5391)      ENDROUTINE
  6052  (5392)  
  6053  (5393)      % A DIRECT MESSAGE THAT ARRIVED OVER A TRUNK, addressed to somebody here.
  6054  (5394)      %
  6055  (5395)      % The text is TARGET/message with the target UNQUALIFIED - the letter was
  6056  (5396)      % addressed to this machine, so the machine is not repeated inside it.
  6057  (5397)      %
  6058  (5398)      % THE SENDER IS QUALIFIED WITH THE ORIGIN, not with the machine the letter
  6059  (5399)      % came from. On a relayed message those are different, and naming the relay
  6060  (5400)      % would tell the reader to type a reply to the wrong place. The origin
  6061  (5401)      % travels in the header for exactly this reason.
  6062  (5402)      %
  6063  (5403)      % NOT FOUND HERE MEANS DROPPED, and that is worth being honest about: the
  6064  (5404)      % sender was already told DirectSent by their own server, so a person who
  6065  (5405)      % logged out in the second between the two ends disagreeing loses the
  6066  (5406)      % message with nobody told. Closing that needs a refusal that can travel
  6067  (5407)      % back over a trunk, and no kind carries one yet.
  6068  (5408)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER, &
  6069  (5409)                          INTEGER) : &
  6070  (5410)              takeRemDirect(origSys, lineId, nameAt, nameLength, textAt, &
  6071  (5411)                            textLength)
  6072  (5412)          INTEGER : cut, tgtAt, tgtLen, msgAt, msgLen, i, at, textStart, st
  6073  (5413)  
  6074  (5414)          findSlash(textAt, textLength) =: cut
  6075  (5415)          IF cut < 1 THEN
  6076  (5416)              RETURN
  6077  (5417)          ENDIF
  6078  (5418)          textAt =: tgtAt
  6079  (5419)          cut =: tgtLen
  6080  (5420)          textAt + cut + 1 =: msgAt
  6081  (5421)          textLength - cut - 1 =: msgLen
  6082  (5422)          IF msgLen < 1 THEN
  6083  (5423)              RETURN
  6084  (5424)          ENDIF
  6085  (5425)  
  6086  (5426)          % THIS MACHINE ONLY. Asking for any machine would find the sender's own
  6087  (5427)          % entry in our remote table and send the message straight back where it
  6088  (5428)          % came from.
  6089  (5429)          resolveTo(tgtAt, tgtLen, mySystem)
  6090  (5430)          IF dirLocal = 0 THEN
  6091  (5431)              % NOT FOUND HERE, AND NOW WE SAY SO. This used to be a bare RETURN
  6092  (5432)              % and the comment above it admitted the message was lost with
  6093  (5433)              % nobody told. The sender's own machine gets a kTrkDBad carrying the
  6094  (5434)              % target we tried and why, and turns it into an ordinary kDirBad for
  6095  (5435)              % the person who typed it.
  6096  (5436)              sendTrkBad(origSys, lineId, nameAt, nameLength, tgtAt, tgtLen, &
  6097  (5437)                         'not logged in') =: st
  6098  (5438)              RETURN
  6099  (5439)          ENDIF
  6100  (5440)  
  6101  (5441)          kDirGot =: outBuf(0)
  6102  (5442)          0 =: outBuf(1)
  6103  (5443)          2 =: at
  6104  (5444)          putQualIn(origSys, nameAt, nameLength, at) =: at
  6105  (5445)          at - 2 =: outBuf(1)
  6106  (5446)  
  6107  (5447)          0 =: outBuf(at)
  6108  (5448)          0 =: outBuf(at + 1)
  6109  (5449)          at + 2 =: at
  6110  (5450)          at =: textStart
  6111  (5451)  
  6112  (5452)          FOR i IN 1:msgLen DO
  6113  (5453)              IF at < 250 THEN
  6114  (5454)                  inBuf(msgAt + i - 1) =: outBuf(at)
  6115  (5455)                  at + 1 =: at
  6116  (5456)              ENDIF
  6117  (5457)          ENDFOR
  6118  (5458)  
  6119  (5459)          at - textStart =: outBuf(textStart - 1)
  6120  (5460)          sendTo(memberMagic(dirLocal), at)
  6121  (5461)      ENDROUTINE
  6122  (5462)  
  6123  (5463)      % =======================================================================
  6124  (5464)      % A REFUSAL COMES BACK OVER A TRUNK - TELL THE PERSON WHO TYPED IT
  6125  (5465)      %
  6126  (5466)      % The far end could not deliver, and this is the other half of kTrkDBad.
  6127  (5467)      % The name field holds the SENDER, who is one of ours; the text is
  6128  (5468)      % TARGET/reason.
  6129  (5469)      %
  6130  (5470)      % It becomes an ordinary kDirBad, which is the entire point: the sentence a
  6131  (5471)      % person sees for a failure two machines away is the same sentence, in the
  6132  (5472)      % same shape, as the one they see for a failure on their own machine. No
  6133  (5473)      % client changes at all.
  6134  (5474)      %
  6135  (5475)      % IF THE SENDER HAS GONE, THE REFUSAL IS DROPPED, and that is honest rather
  6136  (5476)      % than lazy: there is nobody to tell. It is also the hole this kind does not
  6137  (5477)      % close - the sender is found by NAME, so somebody who renamed between
  6138  (5478)      % sending and this arriving is not found. Closing THAT needs an identity
  6139  (5479)      % that outlives a rename, which is a bigger change than this one.
  6140  (5480)      % =======================================================================
  6141  (5481)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER, INTEGER) : &
  6142  (5482)              takeRemBad(nameAt, nameLength, textAt, textLength)
  6143  (5483)          INTEGER : cut, tgtAt, tgtLen, whyAt, whyLen, i, at, textStart
  6144  (5484)  
  6145  (5485)          findSlash(textAt, textLength) =: cut
  6146  (5486)          IF cut < 1 THEN
  6147  (5487)              RETURN
  6148  (5488)          ENDIF
  6149  (5489)          textAt =: tgtAt
  6150  (5490)          cut =: tgtLen
  6151  (5491)          textAt + cut + 1 =: whyAt
  6152  (5492)          textLength - cut - 1 =: whyLen
  6153  (5493)          IF whyLen < 1 THEN
  6154  (5494)              RETURN
  6155  (5495)          ENDIF
  6156  (5496)  
  6157  (5497)          % THE SENDER, not the target - this message is addressed to whoever
  6158  (5498)          % typed the line that failed.
  6159  (5499)          resolveTo(nameAt, nameLength, mySystem)
  6160  (5500)          IF dirLocal = 0 THEN
  6161  (5501)              RETURN
  6162  (5502)          ENDIF
  6163  (5503)  
  6164  (5504)          kDirBad =: outBuf(0)
  6165  (5505)          tgtLen =: outBuf(1)
  6166  (5506)          2 =: at
  6167  (5507)          FOR i IN 1:tgtLen DO
  6168  (5508)              inBuf(tgtAt + i - 1) =: outBuf(at)
  6169  (5509)              at + 1 =: at
  6170  (5510)          ENDFOR
  6171  (5511)  
  6172  (5512)          0 =: outBuf(at)
  6173  (5513)          0 =: outBuf(at + 1)
  6174  (5514)          at + 2 =: at
  6175  (5515)          at =: textStart
  6176  (5516)  
  6177  (5517)          FOR i IN 1:whyLen DO
  6178  (5518)              IF at < 250 THEN
  6179  (5519)                  inBuf(whyAt + i - 1) =: outBuf(at)
  6180  (5520)                  at + 1 =: at
  6181  (5521)              ENDIF
  6182  (5522)          ENDFOR
  6183  (5523)  
  6184  (5524)          at - textStart =: outBuf(textStart - 1)
  6185  (5525)          dmBad + 1 =: dmBad
  6186  (5526)          sendTo(memberMagic(dirLocal), at)
  6187  (5527)      ENDROUTINE
  6188  (5528)  
  6189  (5529)      ROUTINE VOID, VOID : peerTick
  6190  (5530)          INTEGER : i, st
  6191  (5531)  
  6192  (5532)          FOR i IN 1:maxPeers DO
  6193  (5533)              IF peerSystem(i) >< 0 THEN
  6194  (5534)  
  6195  (5535)                  peerHeard(i) + 1 =: peerHeard(i)
  6196  (5536)  
  6197  (5537)                  % ---- has a peer we had gone quiet? -------------------------
  6198  (5538)                  IF peerState(i) = peerUp THEN
  6199  (5539)                      IF peerHeard(i) > peerDeadAfter THEN
  6200  (5540)                          peerDown =: peerState(i)
  6201  (5541)  
  6202  (5542)                          % TELL THE ROOM WHO WENT WITH IT - 2026-09-02. The
  6203  (5543)                          % snapshot-and-diff against a table the forget has
  6204  (5544)                          % just emptied announces every one of its members as
  6205  (5545)                          % left, through the same path a kTrkMbrs change uses.
  6206  (5546)                          snapshotRem(peerSystem(i))
  6207  (5547)                          forgetRemote(peerSystem(i))
  6208  (5548)                          announceDiff(peerSystem(i))
  6209  (5549)  
  6210  (5550)                          peerFirstWait =: peerWait(i)
  6211  (5551)                          peerFirstWait =: peerCount(i)
  6212  (5552)                          logLine('SV trunk down sys ', peerSystem(i))
  6213  (5553)                      ELSE
  6214  (5554)                          % ---- THE KEEPALIVE, 2026-09-02 ---------------------
  6215  (5555)                          %
  6216  (5556)                          % Nothing else speaks on an idle trunk, so before this
  6217  (5557)                          % line existed a quiet minute GUARANTEED the down
  6218  (5558)                          % branch above: down, forget, greet, up, every ~75
  6219  (5559)                          % seconds, for ever - the endless "trunk down/up"
  6220  (5560)                          % pairs in the log, and the remote tables wiped on
  6221  (5561)                          % every lap. Two hellos fit inside peerDeadAfter, so
  6222  (5562)                          % one lost letter does not cost the trunk.
  6223  (5563)                          IF peerHeard(i) = peerPingAt OR &
  6224  (5564)                             peerHeard(i) = peerPingAt + peerPingAt THEN
  6225  (5565)                              sendHello(peerSystem(i), trkAsk) =: st
  6226  (5566)                          ENDIF
  6227  (5567)                      ENDIF
  6228  (5568)                  ENDIF
  6229  (5569)  
  6230  (5570)                  % ---- and greet anything that is not up ---------------------
  6231  (5571)                  IF peerState(i) >< peerUp THEN
  6232  (5572)                      peerCount(i) - 1 =: peerCount(i)
  6233  (5573)                      IF peerCount(i) <= 0 THEN
  6234  (5574)                          sendHello(peerSystem(i), trkAsk) =: st
  6235  (5575)  
  6236  (5576)                          % DOUBLE, THEN CAP. The multiply is done before the
  6237  (5577)                          % test so the cap is a ceiling on the WAIT, not on the
  6238  (5578)                          % number of tries - a peer away for a week keeps being
  6239  (5579)                          % greeted every five minutes for ever, which is what
  6240  (5580)                          % makes it come back by itself.
  6241  (5581)                          peerWait(i) * 2 =: peerWait(i)
  6242  (5582)                          IF peerWait(i) > peerMaxWait THEN
  6243  (5583)                              peerMaxWait =: peerWait(i)
  6244  (5584)                          ENDIF
  6245  (5585)                          peerWait(i) =: peerCount(i)
  6246  (5586)                      ENDIF
  6247  (5587)                  ENDIF
  6248  (5588)              ENDIF
  6249  (5589)          ENDFOR
  6250  (5590)      ENDROUTINE
  6251  (5591)  
  6252  (5592)      % -----------------------------------------------------------------------
  6253  (5593)      % Ask one peer who is on it. Empty text - the kind IS the question.
  6254  (5594)      % -----------------------------------------------------------------------
  6255  (5595)      ROUTINE VOID, INTEGER (INTEGER) : askWho(system)
  6256  (5596)          INTEGER : at, st
  6257  (5597)  
  6258  (5598)          kTrkWho =: outBuf(0)
  6259  (5599)          0 =: outBuf(1)                        % no name: a MACHINE is asking
  6260  (5600)          2 =: at
  6261  (5601)          0 =: outBuf(at)
  6262  (5602)          0 =: outBuf(at + 1)
  6263  (5603)          at + 2 =: at
  6264  (5604)  
  6265  (5605)          sendToName(system, at) =: st
  6266  (5606)          st RETURN
  6267  (5607)      ENDROUTINE
  6268  (5608)  
  6269  (5609)      % -----------------------------------------------------------------------
  6270  (5610)      % TELL EVERY PEER WHO IS ON US NOW, WITHOUT BEING ASKED.
  6271  (5611)      %
  6272  (5612)      % THE FAULT THIS FIXES, MEASURED 2026-08-28. A member renamed on D103 and
  6273  (5613)      % D102 went on advertising the OLD name in /who for as long as it was
  6274  (5614)      % watched. Everything else followed from that one fact: a private message
  6275  (5615)      % addressed to the name D102 was showing was sent correctly, found nobody
  6276  (5616)      % of that name at the far end, and was DROPPED WITH NOBODY TOLD.
  6277  (5617)      %
  6278  (5618)      % WHY IT DRIFTED. The member list only ever moved in ONE place - as the
  6279  (5619)      % reply to kTrkWho - and kTrkWho is only ever asked when a HELLO arrives.
  6280  (5620)      % So between two hellos a peer's picture of us is frozen, and any change
  6281  (5621)      % to our membership is invisible to it until the trunk cycles.
  6282  (5622)      %
  6283  (5623)      % NO NEW WIRE KIND, ON PURPOSE. The receiver's kTrkMbrs handler does not
  6284  (5624)      % require having asked - it accepts the list and REPLACES that peer's rows
  6285  (5625)      % wholesale - so sending one unasked is already legal and already handled
  6286  (5626)      % at both ends. A new kind would have meant a registry entry, golden bytes
  6287  (5627)      % and a parser on a machine that may still be running last week's build;
  6288  (5628)      % this works against every build that already understands kTrkMbrs.
  6289  (5629)      %
  6290  (5630)      % AND BECAUSE IT REPLACES RATHER THAN PATCHES, it is idempotent and
  6291  (5631)      % self-healing: it repairs any drift, not only the change that triggered
  6292  (5632)      % it. Sending one too many costs a message; sending one too few costs a
  6293  (5633)      % private message that vanishes.
  6294  (5634)      %
  6295  (5635)      % ONLY TO PEERS THAT ARE UP, like forwardSaid - a letter to a peer that is
  6296  (5636)      % Down or Unknown only bounces.
  6297  (5637)      %
  6298  (5638)      % REBUILT INSIDE THE LOOP, also like forwardSaid: sendToName hands outBuf
  6299  (5639)      % to XMPFWRI, and building it once outside would be fine today but becomes
  6300  (5640)      % a two-peer-only bug the moment anything in the send path touches outBuf.
  6301  (5641)      % -----------------------------------------------------------------------
  6302  (5642)      ROUTINE VOID, VOID : tellMbrs
  6303  (5643)          INTEGER : i, length, st
  6304  (5644)          FOR i IN 1:maxPeers DO
  6305  (5645)              IF peerSystem(i) >< 0 THEN
  6306  (5646)                  IF peerState(i) = peerUp THEN
  6307  (5647)                      buildMembers =: length
  6308  (5648)                      sendToName(peerSystem(i), length) =: st
  6309  (5649)                  ENDIF
  6310  (5650)              ENDIF
  6311  (5651)          ENDFOR
  6312  (5652)      ENDROUTINE
  6313  (5653)  
  6314  (5654)      % -----------------------------------------------------------------------
  6315  (5655)      % Mark a peer heard-from. Called for ANY arrival on the trunk port.
  6316  (5656)      %
  6317  (5657)      % AN UNKNOWN SYSTEM IS ADDED, not ignored. If a machine trunks to us we want
  6318  (5658)      % the trunk to work in both directions without an operator having to type the
  6319  (5659)      % matching TRUNK here - the design's "whichever machine boots second brings
  6320  (5660)      % the trunk up". If the table is full the greeting is simply dropped; a full
  6321  (5661)      % peer table is an operator problem, not something to fail a message over.
  6322  (5662)      % -----------------------------------------------------------------------
  6323  (5663)      ROUTINE VOID, VOID (INTEGER) : markPeerUp(system)
  6324  (5664)          INTEGER : row, i
  6325  (5665)  
  6326  (5666)          % OURSELVES IS NOT A PEER. A hello to a machine with no CHAT-TRUNK name
  6327  (5667)          % bounces back to this very port wearing our own magic, and without this
  6328  (5668)          % the server adds a row for itself and reports it up. Measured the first
  6329  (5669)          % time a trunk was configured - see the note on mySystem.
  6330  (5670)          IF system = mySystem THEN
  6331  (5671)              RETURN
  6332  (5672)          ENDIF
  6333  (5673)          IF system = 0 THEN
  6334  (5674)              RETURN
  6335  (5675)          ENDIF
  6336  (5676)  
  6337  (5677)          findPeer(system) =: row
  6338  (5678)  
  6339  (5679)          % ---- A SYSTEM WE HAVE NEVER SEEN --------------------------------
  6340  (5680)          %
  6341  (5681)          % Learning one is how a trunk comes up without an operator on both
  6342  (5682)          % ends, and it is the default. When the table has been LOCKED it is
  6343  (5683)          % also how a stranger would get in, so the answer is simply to stop
  6344  (5684)          % here: a peer already in the table keeps working, because findPeer
  6345  (5685)          % found it above and this branch is not taken at all.
  6346  (5686)          %
  6347  (5687)          % Dropped in silence on purpose. Anything that reaches this point sent
  6348  (5688)          % a message on the trunk port, and answering a stranger tells them a
  6349  (5689)          % server is here.
  6350  (5690)          IF row = 0 THEN
  6351  (5691)              IF NOT peersOpen THEN
  6352  (5692)                  RETURN
  6353  (5693)              ENDIF
  6354  (5694)              FOR i IN 1:maxPeers DO
  6355  (5695)                  IF peerSystem(i) = 0 THEN
  6356  (5696)                      IF row = 0 THEN
  6357  (5697)                          system =: peerSystem(i)
  6358  (5698)                          % LEARNED, not asked for. This is the row addPeer is
  6359  (5699)                          % allowed to take back when an operator needs one.
  6360  (5700)                          peerLearned =: peerFixed(i)
  6361  (5701)                          i =: row
  6362  (5702)                      ENDIF
  6363  (5703)                  ENDIF
  6364  (5704)              ENDFOR
  6365  (5705)          ENDIF
  6366  (5706)          IF row >< 0 THEN
  6367  (5707)              peerUp =: peerState(row)
  6368  (5708)              0 =: peerHeard(row)
  6369  (5709)  
  6370  (5710)              % RESET THE BACKOFF ON EVERY TRANSITION TO UP, not just the first.
  6371  (5711)              % A peer that flaps would otherwise inherit a five-minute wait from
  6372  (5712)              % its last absence and take five minutes to be missed again.
  6373  (5713)              peerFirstWait =: peerWait(row)
  6374  (5714)              peerFirstWait =: peerCount(row)
  6375  (5715)  
  6376  (5716)              logLine('SV trunk up sys   ', system)
  6377  (5717)          ENDIF
  6378  (5718)      ENDROUTINE
  6379  (5719)  
  6380  (5720)      % -----------------------------------------------------------------------
  6381  (5721)      % TRUNK <system>: remember the peer and greet it.
  6382  (5722)      % -----------------------------------------------------------------------
  6383  (5723)      ROUTINE VOID, VOID (INTEGER) : addPeer(system)
  6384  (5724)          INTEGER : row, i, length, st
  6385  (5725)  
  6386  (5726)          findPeer(system) =: row
  6387  (5727)          IF row = 0 THEN
  6388  (5728)              FOR i IN 1:maxPeers DO
  6389  (5729)                  IF peerSystem(i) = 0 THEN
  6390  (5730)                      IF row = 0 THEN
  6391  (5731)                          i =: row
  6392  (5732)                      ENDIF
  6393  (5733)                  ENDIF
  6394  (5734)              ENDFOR
  6395  (5735)          ENDIF
  6396  (5736)  
  6397  (5737)          % ---- STILL NO ROW: TAKE ONE BACK FROM A LEARNED PEER -------------
  6398  (5738)          %
  6399  (5739)          % An operator asking for a trunk must always be able to have one. Every
  6400  (5740)          % row can be occupied by a system nobody configured, because markPeerUp
  6401  (5741)          % adds any system that reaches the trunk port - so without this, eight
  6402  (5742)          % strangers are enough to stop the machine being given a real trunk,
  6403  (5743)          % and the operator is told "no room" by machines they never chose.
  6404  (5744)          %
  6405  (5745)          % A learned row is the right one to take: nobody asked for it, and if
  6406  (5746)          % that peer is genuinely there it will be learned again on its next
  6407  (5747)          % message. A row an operator asked for is never taken.
  6408  (5748)          IF row = 0 THEN
  6409  (5749)              FOR i IN 1:maxPeers DO
  6410  (5750)                  IF peerFixed(i) = peerLearned THEN
  6411  (5751)                      IF row = 0 THEN
  6412  (5752)                          i =: row
  6413  (5753)                      ENDIF
  6414  (5754)                  ENDIF
  6415  (5755)              ENDFOR
  6416  (5756)          ENDIF
  6417  (5757)  
  6418  (5758)          % Only when EVERY row was asked for is the refusal a true one - and
  6419  (5759)          % that is the case the table's small size is meant to make loud.
  6420  (5760)          IF row = 0 THEN
  6421  (5761)              buildAdmText('no room for another trunk') =: length
  6422  (5762)              sendTo(senderMagic, length)
  6423  (5763)              RETURN
  6424  (5764)          ENDIF
  6425  (5765)  
  6426  (5766)          % Set the row up, whether it was free, reclaimed, or already this peer.
  6427  (5767)          %
  6428  (5768)          % A ROW CHANGING HANDS MUST LOSE THE OLD PEER'S NAME. pName is learned
  6429  (5769)          % from a Hello, so a reclaimed row would otherwise report the machine
  6430  (5770)          % that used to be in it - LIST-TRUNKS would print the wrong name beside
  6431  (5771)          % a perfectly good system number, which is the kind of wrong that gets
  6432  (5772)          % believed.
  6433  (5773)          IF peerSystem(row) >< system THEN
  6434  (5774)              0 =: pNameLen(row)
  6435  (5775)          ENDIF
  6436  (5776)  
  6437  (5777)          system =: peerSystem(row)
  6438  (5778)          peerAsked =: peerFixed(row)
  6439  (5779)          IF peerState(row) >< peerUp THEN
  6440  (5780)              peerUnknown =: peerState(row)
  6441  (5781)              0 =: peerHeard(row)
  6442  (5782)              % Start the backoff clock, or peerTick would count down from an
  6443  (5783)              % uninitialised value and greet at random.
  6444  (5784)              peerFirstWait =: peerWait(row)
  6445  (5785)              peerFirstWait =: peerCount(row)
  6446  (5786)          ENDIF
  6447  (5787)  
  6448  (5788)          % Greet it now rather than waiting for the retry tick, so an operator
  6449  (5789)          % typing TRUNK sees the answer in seconds and not in half a minute.
  6450  (5790)          % A FAILURE HERE IS NOT REPORTED AS ONE - the peer being off is exactly
  6451  (5791)          % what the retry exists for.
  6452  (5792)          sendHello(system, trkAsk) =: st
  6453  (5793)  
  6454  (5794)          buildAdmText('trunk added') =: length
  6455  (5795)          sendTo(senderMagic, length)
  6456  (5796)      ENDROUTINE
  6457  (5797)  
  6458  (5798)      % -----------------------------------------------------------------------
  6459  (5799)      % UNTRUNK <system>: forget the peer.
  6460  (5800)      % -----------------------------------------------------------------------
  6461  (5801)      ROUTINE VOID, VOID (INTEGER) : dropPeer(system)
  6462  (5802)          INTEGER : row, length
  6463  (5803)  
  6464  (5804)          findPeer(system) =: row
  6465  (5805)          IF row = 0 THEN
  6466  (5806)              buildAdmText('no such trunk') =: length
  6467  (5807)              sendTo(senderMagic, length)
  6468  (5808)              RETURN
  6469  (5809)          ENDIF
  6470  (5810)  
  6471  (5811)          0 =: peerSystem(row)
  6472  (5812)          peerUnknown =: peerState(row)
  6473  (5813)          0 =: peerHeard(row)
  6474  (5814)  
  6475  (5815)          % AND ITS PEOPLE GO WITH IT. Leaving them behind would show somebody
  6476  (5816)          % chatting from a machine this server no longer talks to, and nothing
  6477  (5817)          % would ever come along to remove them.
  6478  (5818)          forgetRemote(system)
  6479  (5819)  
  6480  (5820)          buildAdmText('trunk removed') =: length
  6481  (5821)          sendTo(senderMagic, length)
  6482  (5822)      ENDROUTINE
  6483  (5823)  
  6484  (5824)      % -----------------------------------------------------------------------
  6485  (5825)      % Refuse the sender, echoing the name they asked for and naming the reason.
  6486  (5826)      %
  6487  (5827)      % The name is echoed so the asker can tell WHICH request failed when it has
  6488  (5828)      % more than one outstanding; the reason is carried so the wording is the
  6489  (5829)      % same on both doors.
  6490  (5830)      % -----------------------------------------------------------------------
  6491  (5831)      ROUTINE VOID, VOID (INTEGER, INTEGER, BYTES, INTEGER) : &
  6492  (5832)              refuse(nameAt, nameLength, reason, reasonLength)
  6493  (5833)          INTEGER : i, at
  6494  (5834)  
  6495  (5835)          % EVERY refusal passes through here - seven call sites do, and that is
  6496  (5836)          % why the count belongs here rather than at any of them. A join that
  6497  (5837)          % fails used to leave no trace at all: the client saw a reject and the
  6498  (5838)          % machine said nothing, so "it will not let me in" could not be told
  6499  (5839)          % from "it never heard me". STATUS answers that now.
  6500  (5840)          nRefused + 1 =: nRefused
  6501  (5841)  
  6502  (5842)          kReject =: outBuf(0)
  6503  (5843)          nameLength =: outBuf(1)
  6504  (5844)          2 =: at
  6505  (5845)          FOR i IN 1:nameLength DO
  6506  (5846)              inBuf(nameAt + i - 1) =: outBuf(at)
  6507  (5847)              at + 1 =: at
  6508  (5848)          ENDFOR
  6509  (5849)  
  6510  (5850)          0 =: outBuf(at)
  6511  (5851)          reasonLength =: outBuf(at + 1)
  6512  (5852)          at + 2 =: at
  6513  (5853)          % SUBSCRIPT FROM ZERO. A BYTES declared from a literal - which is what
  6514  (5854)          % every reason string above is - has its first character at index 0, so
  6515  (5855)          % "reason(i)" for i in 1:len silently drops the first letter and reads
  6516  (5856)          % one byte past the end. Same defect, same day, in CHAT.PLNC's buildOwn,
  6517  (5857)          % where it turned RONNY into ONNY on the wire and was only visible
  6518  (5858)          % because the raw bytes were dumped. Nothing warns; PLANC checks no
  6519  (5859)          % bound. Compare cmdIs in CHAT.PLNC, which has always used word(i - 1).
  6520  (5860)          FOR i IN 1:reasonLength DO
  6521  (5861)              reason(i - 1) =: outBuf(at)
  6522  (5862)              at + 1 =: at
  6523  (5863)          ENDFOR
  6524  (5864)  
  6525  (5865)          sendTo(senderMagic, at)
  6526  (5866)      ENDROUTINE
  6527  (5867)  
  6528  (5868)      % -----------------------------------------------------------------------
  6529  (5869)      % Decode one arrived message and apply the room rules.
  6530  (5870)      %
  6531  (5871)      % A transcription of Xmsg.Chat/ChatRoom.cs. Where that file refuses, this
  6532  (5872)      % refuses for the same reason and in the same order, because the two doors
  6533  (5873)      % lead into one room.
  6534  (5874)      % -----------------------------------------------------------------------
  6535  (5875)      % REFUSE A NICKNAME, AND SAY WHICH ONE.
  6536  (5876)      %
  6537  (5877)      %     refused: nickname 'RONNY' is taken
  6538  (5878)      %
  6539  (5879)      % rather than "that nickname is taken". The name is already in the reject's
  6540  (5880)      % NAME field, so a client could assemble this itself - but then the client
  6541  (5881)      % has to know which refusal it is looking at in order to phrase it, and
  6542  (5882)      % every client has to agree. The server knows, so the server says it, which
  6543  (5883)      % is the same rule the rest of this file follows: one place decides the
  6544  (5884)      % words.
  6545  (5885)      %
  6546  (5886)      % The quote marks are not decoration. A nickname can be anything the user
  6547  (5887)      % typed, including something with a space in it, and without them
  6548  (5888)      % "nickname my name is taken" reads as a sentence rather than a name.
  6549  (5889)      ROUTINE VOID, VOID (INTEGER, INTEGER) : refuseNick(nameAt, nameLength)
  6550  (5890)          INTEGER : i, at
  6551  (5891)  
  6552  (5892)          nRefused + 1 =: nRefused
  6553  (5893)  
  6554  (5894)          kReject =: outBuf(0)
  6555  (5895)          nameLength =: outBuf(1)
  6556  (5896)          2 =: at
  6557  (5897)          FOR i IN 1:nameLength DO
  6558  (5898)              inBuf(nameAt + i - 1) =: outBuf(at)
  6559  (5899)              at + 1 =: at
  6560  (5900)          ENDFOR
  6561  (5901)  
  6562  (5902)          0 =: outBuf(at)
  6563  (5903)          0 =: outBuf(at + 1)
  6564  (5904)          at + 2 =: at
  6565  (5905)  
  6566  (5906)          putWord('nickname ', at) =: at
  6567  (5907)          quoteMark(0) =: outBuf(at)
  6568  (5908)          at + 1 =: at
  6569  (5909)          FOR i IN 1:nameLength DO
  6570  (5910)              inBuf(nameAt + i - 1) =: outBuf(at)
  6571  (5911)              at + 1 =: at
  6572  (5912)          ENDFOR
  6573  (5913)          quoteMark(0) =: outBuf(at)
  6574  (5914)          at + 1 =: at
  6575  (5915)          putWord(' is taken', at) =: at
  6576  (5916)  
  6577  (5917)          % The text length, now that it is known. The two length bytes sit
  6578  (5918)          % immediately before the text.
  6579  (5919)          at - (2 + nameLength + 2) =: outBuf(2 + nameLength + 1)
  6580  (5920)  
  6581  (5921)          sendTo(senderMagic, at)
  6582  (5922)      ENDROUTINE
  6583  (5923)  
  6584  (5924)      ROUTINE VOID, VOID : handleMessage
  6585  (5925)          INTEGER : kind, nameLength, nameAt, textLength, textAt
  6586  (5926)          INTEGER : slot, taken, length
  6587  (5927)          % i is used by the topic copy, which is the only loop in this routine.
  6588  (5928)          INTEGER : i
  6589  (5929)          % The room's entry in the topic/history table. Named for what it is
  6590  (5930)          % used for here rather than for the table it comes from - the table is
  6591  (5931)          % called "topic" only because that was its first job.
  6592  (5932)          INTEGER : histSlot
  6593  (5933)          % Where the space between "room" and "count" was found in INITIALIZE.
  6594  (5934)          INTEGER : initSpace
  6595  (5935)          % A relayed line carries these three bytes in front of the usual shape.
  6596  (5936)          % Zero on every other kind, and zero is not a real system number, so a
  6597  (5937)          % handler that reads them by mistake gets an obviously wrong answer
  6598  (5938)          % rather than a plausible one.
  6599  (5939)          INTEGER : relayOrig
  6600  (5940)          INTEGER : relayHops
  6601  (5941)          % SET-NAME and the name on a Hello. Named apart from nameLength, which
  6602  (5942)          % is the MESSAGE's name field and is a different thing entirely.
  6603  (5943)          INTEGER : nameRow
  6604  (5944)          INTEGER : nameLen2
  6605  (5945)          % The number the ORIGIN gave this line, on a kind 53. Zero on
  6606  (5946)          % anything else, and zero is never a real line number - the
  6607  (5947)          % stamper starts at 1 - so a handler that reads it by mistake
  6608  (5948)          % gets an obviously wrong answer rather than a plausible one.
  6609  (5949)          INTEGER : relayId
  6610  (5950)          % Where the '|' splits a Join's room name from a client build
  6611  (5951)          % version - see findJoinSep.
  6612  (5952)          INTEGER : sepAt
  6613  (5953)  
  6614  (5954)          cmKind(inBuf) =: kind
  6615  (5955)  
  6616  (5956)          % TEMPORARY - chasing the 2026-09-01 "you are X on Y" bug. Every kind
  6617  (5957)          % that reaches this point, raw, before any dispatch touches it.
  6618  (5958)          logLine('SV raw kind       ', kind)
  6619  (5959)  
  6620  (5960)          % ---- A RELAYED LINE HAS A LONGER HEADER, so take it off HERE --------
  6621  (5961)          %
  6622  (5962)          % Every field below this point is read at a fixed offset - nameLength
  6623  (5963)          % at byte 1, the name at byte 2 - and a dozen handlers depend on that.
  6624  (5964)          % Rather than teach all of them about a second layout, the three extra
  6625  (5965)          % bytes are read off and the rest of the message is SLID DOWN to where
  6626  (5966)          % it would have been. From the next line on, a relayed line looks
  6627  (5967)          % exactly like any other and only its own handler knows the difference.
  6628  (5968)          %
  6629  (5969)          % The length test is not decoration: readLength is what actually
  6630  (5970)          % arrived, and a truncated relay header would otherwise be read as a
  6631  (5971)          % name length and produce a plausible-looking message out of rubbish.
  6632  (5972)          0 =: relayOrig
  6633  (5973)          0 =: relayHops
  6634  (5974)          0 =: relayId
  6635  (5975)          % ---- THE RELAY HEADER, READ AND TAKEN OFF BY THE LIBRARY ----------
  6636  (5976)          %
  6637  (5977)          % This was written out TWICE here - once for kind 52 and again for 53
  6638  (5978)          % and 54 - with the length tests, the slide and every byte offset
  6639  (5979)          % duplicated between them. CHATLIB owns the layout now, and CHATTST
  6640  (5980)          % proves it against HAND-BUILT headers rather than against its own
  6641  (5981)          % encoder, including the short ones.
  6642  (5982)          %
  6643  (5983)          % The short cases are the reason it matters. A truncated relay header
  6644  (5984)          % read as a chat frame builds a PLAUSIBLE-LOOKING message out of
  6645  (5985)          % rubbish, because the origin's high byte lands exactly where the name
  6646  (5986)          % length belongs. And a kind 53 needs SIX bytes where a 52 needs four -
  6647  (5987)          % a message long enough to satisfy the shorter test can still be too
  6648  (5988)          % short for the longer one, which is precisely the sort of thing two
  6649  (5989)          % hand-written copies drift apart on.
  6650  (5990)          %
  6651  (5991)          % READ THE FIELDS BEFORE STRIPPING. They are gone afterwards.
  6652  (5992)          IF trHLen(kind) > 0 THEN
  6653  (5993)              trOrig(inBuf) =: relayOrig
  6654  (5994)              trHops(inBuf) =: relayHops
  6655  (5995)              IF trHLen(kind) = 6 THEN
  6656  (5996)                  trId(inBuf) =: relayId
  6657  (5997)              ENDIF
  6658  (5998)          ENDIF
  6659  (5999)  
  6660  (6000)          % A kind carrying no relay header answers the length unchanged and
  6661  (6001)          % touches nothing, so this is called without a special case. -1 means
  6662  (6002)          % the message was too short to hold the header it claimed - drop it
  6663  (6003)          % rather than read past the end.
  6664  (6004)          trStrip(inBuf, readLength, kind) =: readLength
  6665  (6005)          IF readLength < 0 THEN
  6666  (6006)              RETURN
  6667  (6007)          ENDIF
  6668  (6008)  
  6669  (6009)          % THE RELAY HEADER, IF THERE WAS ONE, HAS ALREADY BEEN SLID OFF ABOVE -
  6670  (6010)          % so inBuf(1) is the chat name length again here, and cmNmLen is the
  6671  (6011)          % right reader for it. Above the slide it is the relay origin's high
  6672  (6012)          % byte, which is why that code parses by hand and must keep doing so.
  6673  (6013)          cmNmLen(inBuf) =: nameLength
  6674  (6014)          2 =: nameAt
  6675  (6015)  
  6676  (6016)          % A "parse k= nlen= rlen=" line printed here on EVERY message while the
  6677  (6017)          % join was being brought up. It said "remove once the join works", and
  6678  (6018)          % the join works - it was what showed the kind arriving as the XSLET
  6679  (6019)          % serial number instead of kJoin, which is how the missing header skip
  6680  (6020)          % was found.
  6681  (6021)          %
  6682  (6022)          % THE THREE "DROP" MESSAGES BELOW STAY. They are not the same thing: a
  6683  (6023)          % silent drop is right for a stranger on the wire but leaves the operator
  6684  (6024)          % unable to tell a refused message from a lost one, and each prints only
  6685  (6025)          % when something is actually wrong rather than once per message.
  6686  (6026)  
  6687  (6027)          % ---- TRUST NOTHING THAT ARRIVED ------------------------------------
  6688  (6028)          % Every field below is a byte a stranger chose. Two things have to hold
  6689  (6029)          % before any of them is used, and neither is checked by the language:
  6690  (6030)          %
  6691  (6031)          %   the name must FIT      memberName has maxNameLen bytes per seat, and
  6692  (6032)          %                          a length byte can say 255.
  6693  (6033)          %   the fields must be IN  the message actually read is readLength
  6694  (6034)          %   THE MESSAGE            bytes; a length that points past it would read
  6695  (6035)          %                          whatever the previous, longer message left in
  6696  (6036)          %                          inBuf and answer with it.
  6697  (6037)          %
  6698  (6038)          % Dropped in silence rather than refused: a refusal would need a name to
  6699  (6039)          % echo, and the name is the part that is not trustworthy. The seat is
  6700  (6040)          % settled by the receive loop either way, which is exactly why that
  6701  (6041)          % accounting does not live in here.
  6702  (6042)          %
  6703  (6043)          % The sixteen is a rule of the ROOM, not a detail of this program:
  6704  (6044)          % ChatRoom.MaxNicknameLength says the same number, so a name this side
  6705  (6045)          % must drop is one the other side refuses rather than admits. Otherwise
  6706  (6046)          % the two rooms would disagree about who is in them.
  6707  (6047)          IF nameLength > maxNameLen THEN
  6708  (6048)              OUTPUT(1, 'AL21', 'SV: DROP name too big')
  6709  (6049)              OUTPUT(1, 'AL1', '$')
  6710  (6050)              RETURN
  6711  (6051)          ENDIF
  6712  (6052)          IF nameAt + nameLength + 1 > readLength THEN
  6713  (6053)              OUTPUT(1, 'AL22', 'SV: DROP name past end')
  6714  (6054)              OUTPUT(1, 'AL1', '$')
  6715  (6055)              RETURN
  6716  (6056)          ENDIF
  6717  (6057)  
  6718  (6058)          % READ ONLY AFTER THE TWO GUARDS ABOVE - cmTxLen fetches the two bytes
  6719  (6059)          % at nameLength + 2, which is the over-read "name past end" prevents.
  6720  (6060)          cmTxLen(inBuf) =: textLength
  6721  (6061)          cmTxAt(inBuf) =: textAt
  6722  (6062)  
  6723  (6063)          IF textAt + textLength > readLength THEN
  6724  (6064)              OUTPUT(1, 'AL22', 'SV: DROP text past end')
  6725  (6065)              OUTPUT(1, 'AL1', '$')
  6726  (6066)              RETURN
  6727  (6067)          ENDIF
  6728  (6068)  
  6729  (6069)          % ---- ONE VOCABULARY IS NOT ONE AUTHORITY ---------------------------
  6730  (6070)          %
  6731  (6071)          % Admin kinds share the room's numbering on purpose - a second enum
  6732  (6072)          % would mean a second decoder bound, and that bound has been left
  6733  (6073)          % behind twice, silently both times. But sharing the words is not
  6734  (6074)          % sharing the right to use them anywhere: an admin kind arriving on
  6735  (6075)          % CHAT-LOBBY would let any client that can reach the room stop the
  6736  (6076)          % server, and a room kind on the command port would put a member in a
  6737  (6077)          % seat nobody counted.
  6738  (6078)          %
  6739  (6079)          % Refused in SILENCE rather than with a reason. A caller on the wrong
  6740  (6080)          % port is either confused or probing, and neither is owed a map.
  6741  (6081)          % THREE PORTS, THREE VOCABULARIES. Each kind belongs on exactly one of
  6742  (6082)          % them, and arriving on the wrong one is refused in silence.
  6743  (6083)          %
  6744  (6084)          %   48 and up   TRUNK    machine to machine, on CHAT-TRUNK
  6745  (6085)          %   32 .. 47    ADMIN    an operator, on CHAT-ADMIN
  6746  (6086)          %   below 32    ROOM     a member, on the room port
  6747  (6087)          %
  6748  (6088)          % The trunk test comes FIRST because trunk numbers are also >= kAdmStat,
  6749  (6089)          % and testing admin first would demand fromAdmin of a HELLO - which
  6750  (6090)          % arrives on the trunk port, where fromAdmin is false. That is exactly
  6751  (6091)          % how the first build of this swallowed every hello in silence.
  6752  (6092)          IF kind >= kTrkHello THEN
  6753  (6093)              IF NOT fromTrunk THEN
  6754  (6094)                  RETURN
  6755  (6095)              ENDIF
  6756  (6096)          ELSE
  6757  (6097)              IF kind >= kAdmStat THEN
  6758  (6098)                  IF NOT fromAdmin THEN
  6759  (6099)                      RETURN
  6760  (6100)                  ENDIF
  6761  (6101)              ELSE
  6762  (6102)                  IF fromAdmin THEN
  6763  (6103)                      RETURN
  6764  (6104)                  ENDIF
  6765  (6105)                  IF fromTrunk THEN
  6766  (6106)                      RETURN
  6767  (6107)                  ENDIF
  6768  (6108)              ENDIF
  6769  (6109)          ENDIF
  6770  (6110)  
  6771  (6111)          % ---- THE ADMIN COMMANDS --------------------------------------------
  6772  (6112)          % ---- TRUNK CONFIGURATION, from CHAT-MON on the command port ----------
  6773  (6113)          %
  6774  (6114)          % Guarded by fromAdmin like every other admin verb: rewiring the network
  6775  (6115)          % is not something a room member may do.
  6776  (6116)          % ---- LOCK-PEERS / OPEN-PEERS ---------------------------------------
  6777  (6117)          %
  6778  (6118)          % Both are guarded by fromAdmin like every other admin verb, and for a
  6779  (6119)          % sharper reason than most: a member who could unlock the peer table
  6780  (6120)          % could then introduce any machine they liked.
  6781  (6121)          %
  6782  (6122)          % Locking does NOT drop the peers already known - they were learned
  6783  (6123)          % before the operator drew the line, and cutting live trunks is not what
  6784  (6124)          % "take no more" means. STOP-TRUNK is how a peer is removed.
  6785  (6125)          IF kind = kAdmLock THEN
  6786  (6126)              IF NOT fromAdmin THEN
  6787  (6127)                  RETURN
  6788  (6128)              ENDIF
  6789  (6129)              FALSE =: peersOpen
  6790  (6130)              buildAdmText('trunks locked - no new machines will be learned') =: length
  6791  (6131)              sendTo(senderMagic, length)
  6792  (6132)              RETURN
  6793  (6133)          ENDIF
  6794  (6134)  
  6795  (6135)          IF kind = kAdmOpen THEN
  6796  (6136)              IF NOT fromAdmin THEN
  6797  (6137)                  RETURN
  6798  (6138)              ENDIF
  6799  (6139)              TRUE =: peersOpen
  6800  (6140)              buildAdmText('trunks unlocked - any machine may be learned') =: length
  6801  (6141)              sendTo(senderMagic, length)
  6802  (6142)              RETURN
  6803  (6143)          ENDIF
  6804  (6144)  
  6805  (6145)          % ---- DROP-MEMBER <name> - FREE A SEAT AND TELL NOBODY --------------
  6806  (6146)          %
  6807  (6147)          % See the comment on kAdmDrop where it is declared for WHY this exists.
  6808  (6148)          % In one line: it is the only way to put this machine and a peer into
  6809  (6149)          % the disagreement that kTrkDBad answers, because every ordinary way of
  6810  (6150)          % leaving keeps them in step.
  6811  (6151)          %
  6812  (6152)          % fromAdmin like every other verb here - a room member must not be able
  6813  (6153)          % to unseat anybody, least of all silently.
  6814  (6154)          %
  6815  (6155)          % NOTE WHAT IS DELIBERATELY MISSING, and compare it with kLeave below:
  6816  (6156)          % there is no buildFromSlot(kLeft...), no broadcast to the room, and no
  6817  (6157)          % tellMbrs to the peers. Freeing memberUsed is the WHOLE action. Adding
  6818  (6158)          % any of those back would defeat the only purpose this verb has.
  6819  (6159)          IF kind = kAdmDrop THEN
  6820  (6160)              IF NOT fromAdmin THEN
  6821  (6161)                  RETURN
  6822  (6162)              ENDIF
  6823  (6163)              findByName(textAt, textLength) =: taken
  6824  (6164)              IF taken = 0 THEN
  6825  (6165)                  buildAdmText('no member of that name is seated here') =: length
  6826  (6166)                  sendTo(senderMagic, length)
  6827  (6167)                  RETURN
  6828  (6168)              ENDIF
  6829  (6169)              0 =: memberUsed(taken)
  6830  (6170)              buildAdmText('seat freed - room and peers NOT told') =: length
  6831  (6171)              sendTo(senderMagic, length)
  6832  (6172)              RETURN
  6833  (6173)          ENDIF
  6834  (6174)  
  6835  (6175)          IF kind = kAdmTrunk THEN
  6836  (6176)              IF NOT fromAdmin THEN
  6837  (6177)                  RETURN
  6838  (6178)              ENDIF
  6839  (6179)              trunkNumber(textAt, textLength) =: taken
  6840  (6180)              IF taken = 0 THEN
  6841  (6181)                  buildAdmText('TRUNK needs a system number') =: length
  6842  (6182)                  sendTo(senderMagic, length)
  6843  (6183)                  RETURN
  6844  (6184)              ENDIF
  6845  (6185)              % NO "=: length" - addPeer is a VOID routine and sends its own
  6846  (6186)              % reply. Assigning from it drew ILLEGAL DATA TYPE "ADDPEER" at the
  6847  (6187)              % CALL, which reads like a problem with the argument.
  6848  (6188)              addPeer(taken)
  6849  (6189)              RETURN
  6850  (6190)          ENDIF
  6851  (6191)  
  6852  (6192)          % INITIALIZE <room> <n> - how many messages a room remembers.
  6853  (6193)          %
  6854  (6194)          % TWO FIELDS, unlike every other admin verb, so the text is split at the
  6855  (6195)          % first space: the room name, then the count. Split at the FIRST one
  6856  (6196)          % because a room name cannot contain a space and a trailing one would
  6857  (6197)          % otherwise become part of the number.
  6858  (6198)          %
  6859  (6199)          % REFUSED ONCE THE ROOM HAS HISTORY, and this is the part worth being
  6860  (6200)          % careful about. The ring is "block = id MOD size", so CHANGING size
  6861  (6201)          % moves where every existing id lands: the messages do not move, but
  6862  (6202)          % the arithmetic that finds them does, and the replay would hand back
  6863  (6203)          % other messages in the wrong order while looking perfectly healthy.
  6864  (6204)          % There is no cheap correct rewrite - it means reading the whole ring
  6865  (6205)          % out and writing it back in the new shape - so an empty room is the
  6866  (6206)          % only case allowed, and the refusal says exactly that. Setting a room
  6867  (6207)          % up BEFORE anybody speaks in it is the case this was asked for.
  6868  (6208)          IF kind = kAdmInit THEN
  6869  (6209)              IF NOT fromAdmin THEN
  6870  (6210)                  RETURN
  6871  (6211)              ENDIF
  6872  (6212)  
  6873  (6213)              % Find the space that separates the two fields.
  6874  (6214)              0 =: initSpace
  6875  (6215)              FOR i IN 1:textLength DO
  6876  (6216)                  IF initSpace = 0 THEN
  6877  (6217)                      IF inBuf(textAt + i - 1) = spaceByte(0) THEN
  6878  (6218)                          i =: initSpace
  6879  (6219)                      ENDIF
  6880  (6220)                  ENDIF
  6881  (6221)              ENDFOR
  6882  (6222)  
  6883  (6223)              % ---- NO ROOM NAMED: SET THIS MACHINE'S DEFAULT ------------------
  6884  (6224)              %
  6885  (6225)              % Ronny, 2026-08-23: "INITIALIZE without room sets the default
  6886  (6226)              % amount for this machine, spread out by rooms as the rooms may be
  6887  (6227)              % created later."
  6888  (6228)              %
  6889  (6229)              % So one field is a DEFAULT and two are one ROOM. It reads the way
  6890  (6230)              % an operator would say it - "INITIALIZE 20" is how much a room
  6891  (6231)              % keeps here, "INITIALIZE LOBBY 20" is how much LOBBY keeps.
  6892  (6232)              %
  6893  (6233)              % IT DOES NOT TOUCH ROOMS THAT ALREADY EXIST, and that is the whole
  6894  (6234)              % meaning of "as the rooms may be created later": claimTopic and
  6895  (6235)              % claimRoomNamed take a copy of histDefault when they allocate, so
  6896  (6236)              % a room created after this picks the new number up and one created
  6897  (6237)              % before it keeps what it was given. Reaching back into live rooms
  6898  (6238)              % would change a ring that already has messages in it, which is the
  6899  (6239)              % thing the per-room form refuses to do for good reason.
  6900  (6240)              IF initSpace = 0 THEN
  6901  (6241)                  trunkNumber(textAt, textLength) =: taken
  6902  (6242)                  IF taken < 1 THEN
  6903  (6243)                      buildAdmText('INITIALIZE needs a count above zero') &
  6904  (6244)                          =: length
  6905  (6245)                      sendTo(senderMagic, length)
  6906  (6246)                      RETURN
  6907  (6247)                  ENDIF
  6908  (6248)                  IF taken > maxHistSize THEN
  6909  (6249)                      buildAdmText('that is more than a room can keep') &
  6910  (6250)                          =: length
  6911  (6251)                      sendTo(senderMagic, length)
  6912  (6252)                      RETURN
  6913  (6253)                  ENDIF
  6914  (6254)                  taken =: histDefault
  6915  (6255)                  buildAdmText('default history size set') =: length
  6916  (6256)                  sendTo(senderMagic, length)
  6917  (6257)                  RETURN
  6918  (6258)              ENDIF
  6919  (6259)  
  6920  (6260)              trunkNumber(textAt + initSpace, textLength - initSpace) =: taken
  6921  (6261)              IF taken < 1 THEN
  6922  (6262)                  buildAdmText('INITIALIZE needs a count above zero') &
  6923  (6263)                      =: length
  6924  (6264)                  sendTo(senderMagic, length)
  6925  (6265)                  RETURN
  6926  (6266)              ENDIF
  6927  (6267)              IF taken > maxHistSize THEN
  6928  (6268)                  buildAdmText('that is more than a room can keep') =: length
  6929  (6269)                  sendTo(senderMagic, length)
  6930  (6270)                  RETURN
  6931  (6271)              ENDIF
  6932  (6272)  
  6933  (6273)              claimRoomNamed(textAt, initSpace - 1) =: histSlot
  6934  (6274)              IF histSlot = 0 THEN
  6935  (6275)                  buildAdmText('no room left in the table') =: length
  6936  (6276)                  sendTo(senderMagic, length)
  6937  (6277)                  RETURN
  6938  (6278)              ENDIF
  6939  (6279)  
  6940  (6280)              IF histNext(histSlot) > 0 THEN
  6941  (6281)                  buildAdmText('that room already has history') =: length
  6942  (6282)                  sendTo(senderMagic, length)
  6943  (6283)                  RETURN
  6944  (6284)              ENDIF
  6945  (6285)  
  6946  (6286)              taken =: histSize(histSlot)
  6947  (6287)              buildAdmText('room history size set') =: length
  6948  (6288)              sendTo(senderMagic, length)
  6949  (6289)              RETURN
  6950  (6290)          ENDIF
  6951  (6291)  
  6952  (6292)          IF kind = kAdmUntrnk THEN
  6953  (6293)              IF NOT fromAdmin THEN
  6954  (6294)                  RETURN
  6955  (6295)              ENDIF
  6956  (6296)              trunkNumber(textAt, textLength) =: taken
  6957  (6297)              IF taken = 0 THEN
  6958  (6298)                  buildAdmText('UNTRUNK needs a system number') =: length
  6959  (6299)                  sendTo(senderMagic, length)
  6960  (6300)                  RETURN
  6961  (6301)              ENDIF
  6962  (6302)              dropPeer(taken)
  6963  (6303)              RETURN
  6964  (6304)          ENDIF
  6965  (6305)  
  6966  (6306)          IF kind = kAdmTrunks THEN
  6967  (6307)              IF NOT fromAdmin THEN
  6968  (6308)                  RETURN
  6969  (6309)              ENDIF
  6970  (6310)              buildTrunks =: length
  6971  (6311)              sendTo(senderMagic, length)
  6972  (6312)              RETURN
  6973  (6313)          ENDIF
  6974  (6314)  
  6975  (6315)          IF kind = kAdmMbrs THEN
  6976  (6316)              IF NOT fromAdmin THEN
  6977  (6317)                  RETURN
  6978  (6318)              ENDIF
  6979  (6319)              buildSeats =: length
  6980  (6320)              sendTo(senderMagic, length)
  6981  (6321)              RETURN
  6982  (6322)          ENDIF
  6983  (6323)  
  6984  (6324)          % SET-NAME <name> - what this machine calls itself.
  6985  (6325)          %
  6986  (6326)          % AN EMPTY NAME CLEARS IT, and that is deliberate rather than an
  6987  (6327)          % oversight: a machine with no name falls back to D<number> everywhere,
  6988  (6328)          % which is exactly how it behaved before names existed. So there is a
  6989  (6329)          % way back from a name typed wrongly that does not need a restart.
  6990  (6330)          %
  6991  (6331)          % The peers are told at the next hello - the trunk sends one on its own
  6992  (6332)          % schedule and nothing has to be poked. An operator in a hurry can use
  6993  (6333)          % RESTART-TRUNK to make it happen now.
  6994  (6334)          IF kind = kAdmName THEN
  6995  (6335)              IF NOT fromAdmin THEN
  6996  (6336)                  RETURN
  6997  (6337)              ENDIF
  6998  (6338)  
  6999  (6339)              textLength =: nameLen2
  7000  (6340)              IF nameLen2 > maxNameLen THEN
  7001  (6341)                  maxNameLen =: nameLen2
  7002  (6342)              ENDIF
  7003  (6343)              IF nameLen2 > 0 THEN
  7004  (6344)                  FOR i IN 1:nameLen2 DO
  7005  (6345)                      inBuf(textAt + i - 1) =: sysName(i - 1)
  7006  (6346)                  ENDFOR
  7007  (6347)              ENDIF
  7008  (6348)              nameLen2 =: lenSysName
  7009  (6349)  
  7010  (6350)              buildNameReply =: length
  7011  (6351)              sendTo(senderMagic, length)
  7012  (6352)              RETURN
  7013  (6353)          ENDIF
  7014  (6354)  
  7015  (6355)          % ---- A HELLO FROM ANOTHER SERVER, on the trunk port -----------------
  7016  (6356)          %
  7017  (6357)          % ANYTHING ARRIVING FROM A PEER MARKS IT UP, including an unsolicited
  7018  (6358)          % HELLO from a machine we have not trunked. That is what lets whichever
  7019  (6359)          % machine boots second bring the trunk up without the first noticing.
  7020  (6360)          %
  7021  (6361)          % An ASK is answered, an ANSWER is not - see the note on trkAsk. Without
  7022  (6362)          % that the two servers would greet each other for ever.
  7023  (6363)          IF kind = kTrkHello THEN
  7024  (6364)              IF NOT fromTrunk THEN
  7025  (6365)                  RETURN
  7026  (6366)              ENDIF
  7027  (6367)  
  7028  (6368)              % A RETURNED LETTER IS NOT A PEER SAYING HELLO - IT IS THE OPPOSITE.
  7029  (6369)              %
  7030  (6370)              % XMTRE means the message came BACK: "If msgType is XMTRE,
  7031  (6371)              % msgLengthOrStat contains the error status". The design counts on
  7032  (6372)              % exactly this as the CHEAP way to learn a peer is absent - "the
  7033  (6373)              % letter comes straight back undeliverable ... Immediate, no
  7034  (6374)              % waiting" - so reading it as proof of life inverts the one signal
  7035  (6375)              % that costs nothing.
  7036  (6376)              %
  7037  (6377)              % The bounce does NOT say who it was addressed to, so there is
  7038  (6378)              % nobody specific to mark down here; it is simply not treated as
  7039  (6379)              % good news, and the peer stays whatever it was until the idle
  7040  (6380)              % count declares it down. Carrying the addressee in the hello text
  7041  (6381)              % would let this mark the right row immediately - worth doing when
  7042  (6382)              % the state machine grows.
  7043  (6383)              IF msgType = XMTRE THEN
  7044  (6384)                  logLine('SV trunk bounce   ', receiveStat)
  7045  (6385)                  RETURN
  7046  (6386)              ENDIF
  7047  (6387)  
  7048  (6388)              markPeerUp(senderSystem)
  7049  (6389)  
  7050  (6390)              % WHAT THAT MACHINE CALLS ITSELF, if it said. Anything after the
  7051  (6391)              % direction byte is its name.
  7052  (6392)              %
  7053  (6393)              % Taken on EVERY hello and not only the first, for the same reason
  7054  (6394)              % the member list is: a peer saying hello again has very likely
  7055  (6395)              % restarted, and a name it was given before the restart may not be
  7056  (6396)              % the one it has now.
  7057  (6397)              %
  7058  (6398)              % A NAME IS ONLY A LABEL ON A NUMBER. senderSystem comes from the
  7059  (6399)              % kernel's magic and is not something the sender can choose, so a
  7060  (6400)              % machine may call itself whatever it likes and still cannot claim
  7061  (6401)              % to BE another machine.
  7062  (6402)              IF textLength > 1 THEN
  7063  (6403)                  findPeer(senderSystem) =: nameRow
  7064  (6404)                  IF nameRow > 0 THEN
  7065  (6405)                      textLength - 1 =: nameLen2
  7066  (6406)                      IF nameLen2 > maxNameLen THEN
  7067  (6407)                          maxNameLen =: nameLen2
  7068  (6408)                      ENDIF
  7069  (6409)                      FOR i IN 1:nameLen2 DO
  7070  (6410)                          inBuf(textAt + i) =: pName(nameRow, i)
  7071  (6411)                      ENDFOR
  7072  (6412)                      nameLen2 =: pNameLen(nameRow)
  7073  (6413)                  ENDIF
  7074  (6414)              ENDIF
  7075  (6415)  
  7076  (6416)              IF textLength > 0 THEN
  7077  (6417)                  IF inBuf(textAt) = trkAsk THEN
  7078  (6418)                      sendHello(senderSystem, trkAnswer) =: taken
  7079  (6419)                  ENDIF
  7080  (6420)              ENDIF
  7081  (6421)  
  7082  (6422)              % PHASE C: A HELLO IS ALSO THE MOMENT TO ASK WHO IS THERE.
  7083  (6423)              %
  7084  (6424)              % Asked on EVERY hello, not only the first. A peer that says hello
  7085  (6425)              % again has very likely restarted, and everything we remember about
  7086  (6426)              % its members is then stale - the design's "treat Up as start
  7087  (6427)              % again". The answer REPLACES our rows for it, so asking twice
  7088  (6428)              % costs one message and can never leave a ghost.
  7089  (6429)              askWho(senderSystem) =: taken
  7090  (6430)              RETURN
  7091  (6431)          ENDIF
  7092  (6432)  
  7093  (6433)          % ---- A PEER ASKS WHO IS ON US ---------------------------------------
  7094  (6434)          IF kind = kTrkWho THEN
  7095  (6435)              IF NOT fromTrunk THEN
  7096  (6436)                  RETURN
  7097  (6437)              ENDIF
  7098  (6438)              IF msgType = XMTRE THEN
  7099  (6439)                  RETURN
  7100  (6440)              ENDIF
  7101  (6441)              buildMembers =: length
  7102  (6442)              sendToName(senderSystem, length) =: taken
  7103  (6443)              RETURN
  7104  (6444)          ENDIF
  7105  (6445)  
  7106  (6446)          % ---- SOMEBODY SPOKE ON ANOTHER MACHINE ------------------------------
  7107  (6447)          %
  7108  (6448)          % The text is "ROOM/what they said". The room decides who hears it here;
  7109  (6449)          % the speaker is shown qualified with the system the LETTER came from,
  7110  (6450)          % never with anything the sender put in the message.
  7111  (6451)          IF kind = kTrkSaid THEN
  7112  (6452)              IF NOT fromTrunk THEN
  7113  (6453)                  RETURN
  7114  (6454)              ENDIF
  7115  (6455)              IF msgType = XMTRE THEN
  7116  (6456)                  RETURN
  7117  (6457)              ENDIF
  7118  (6458)              markPeerUp(senderSystem)
  7119  (6459)              deliverRemoteSaid(senderSystem, nameAt, nameLength, &
  7120  (6460)                  textAt, textLength)
  7121  (6461)  
  7122  (6462)              % AND PASS IT ON. This is what makes a chain work without changing
  7123  (6463)              % what the SENDER does at all: the machine in the middle turns a
  7124  (6464)              % direct line into a relayed one. An older server simply does not
  7125  (6465)              % do this, which is why nothing had to be upgraded in step.
  7126  (6466)              %
  7127  (6467)              % The origin is senderSystem because this line came STRAIGHT from
  7128  (6468)              % the machine it was typed on - one hop so far.
  7129  (6469)              % Id ZERO: kind 51 carries none, because it comes from a server
  7130  (6470)              % that predates dedup. Passing zero on is honest - it says "this
  7131  (6471)              % line has no name" - and the receiver treats an unnamed line as
  7132  (6472)              % always new, which is exactly today's behaviour. Inventing a
  7133  (6473)              % number here would be worse than useless: a second relay would
  7134  (6474)              % invent a different one for the same line.
  7135  (6475)              relayOn(senderSystem, senderSystem, 0, maxHops - 1, &
  7136  (6476)                  nameAt, nameLength, textAt, textLength)
  7137  (6477)              RETURN
  7138  (6478)          ENDIF
  7139  (6479)  
  7140  (6480)          % ---- SOMEBODY SPOKE FURTHER AWAY ------------------------------------
  7141  (6481)          %
  7142  (6482)          % A line that has already been through at least one other machine. The
  7143  (6483)          % speaker is qualified with the ORIGIN THE LETTER CARRIES, not with the
  7144  (6484)          % system it arrived from - that one is the relay, and using it would
  7145  (6485)          % show a D103 user as being on D100.
  7146  (6486)          IF kind = kTrkRly THEN
  7147  (6487)              IF NOT fromTrunk THEN
  7148  (6488)                  RETURN
  7149  (6489)              ENDIF
  7150  (6490)              IF msgType = XMTRE THEN
  7151  (6491)                  RETURN
  7152  (6492)              ENDIF
  7153  (6493)  
  7154  (6494)              % The machine that PASSED it to us is alive; that is what we heard
  7155  (6495)              % from. Says nothing about the origin, which we may have no trunk
  7156  (6496)              % to at all - and that is the entire point of relaying.
  7157  (6497)              markPeerUp(senderSystem)
  7158  (6498)  
  7159  (6499)              deliverRemoteSaid(relayOrig, nameAt, nameLength, &
  7160  (6500)                  textAt, textLength)
  7161  (6501)  
  7162  (6502)              % On again, one hop shorter, never back the way it came.
  7163  (6503)              relayOn(senderSystem, relayOrig, 0, relayHops - 1, &
  7164  (6504)                  nameAt, nameLength, textAt, textLength)
  7165  (6505)              RETURN
  7166  (6506)          ENDIF
  7167  (6507)  
  7168  (6508)          % ---- SOMEBODY SPOKE FURTHER AWAY, AND THE LINE HAS A NAME ------------
  7169  (6509)          %
  7170  (6510)          % Same as kTrkRly above, with the one difference that matters: this
  7171  (6511)          % line carries the number its ORIGIN gave it, so we can tell a second
  7172  (6512)          % copy from a new line and show it once.
  7173  (6513)          IF kind = kTrkRlId THEN
  7174  (6514)              IF NOT fromTrunk THEN
  7175  (6515)                  RETURN
  7176  (6516)              ENDIF
  7177  (6517)              IF msgType = XMTRE THEN
  7178  (6518)                  RETURN
  7179  (6519)              ENDIF
  7180  (6520)  
  7181  (6521)              % The machine that PASSED it on is alive. Says nothing about the
  7182  (6522)              % origin, which we may have no trunk to at all.
  7183  (6523)              markPeerUp(senderSystem)
  7184  (6524)  
  7185  (6525)              % SEEN IT ALREADY? Then stop here - do not show it and do not pass
  7186  (6526)              % it on. Passing on a repeat would multiply it round a mesh even
  7187  (6527)              % though nobody would be shown it twice.
  7188  (6528)              IF lineIsNew(relayOrig, relayId) = 0 THEN
  7189  (6529)                  nDupes + 1 =: nDupes
  7190  (6530)                  RETURN
  7191  (6531)              ENDIF
  7192  (6532)  
  7193  (6533)              deliverRemoteSaid(relayOrig, nameAt, nameLength, &
  7194  (6534)                  textAt, textLength)
  7195  (6535)  
  7196  (6536)              % On again, one hop shorter, never back the way it came, and with
  7197  (6537)              % the id UNCHANGED.
  7198  (6538)              relayOn(senderSystem, relayOrig, relayId, relayHops - 1, &
  7199  (6539)                  nameAt, nameLength, textAt, textLength)
  7200  (6540)              RETURN
  7201  (6541)          ENDIF
  7202  (6542)  
  7203  (6543)          % ---- A PEER TELLS US WHO IS ON IT -----------------------------------
  7204  (6544)          % A DIRECT MESSAGE FROM ANOTHER MACHINE.
  7205  (6545)          %
  7206  (6546)          % Deduplicated by the same window as a relayed room line, because it
  7207  (6547)          % carries the same origin and id. NOT RELAYED ONWARD: a room line is
  7208  (6548)          % passed to every peer and sorted out at the far end, but doing that
  7209  (6549)          % with a private message would hand it to machines that have no
  7210  (6550)          % business seeing it. It arrived here because it was addressed here.
  7211  (6551)          IF kind = kTrkDir THEN
  7212  (6552)              IF NOT fromTrunk THEN
  7213  (6553)                  RETURN
  7214  (6554)              ENDIF
  7215  (6555)              IF msgType = XMTRE THEN
  7216  (6556)                  RETURN
  7217  (6557)              ENDIF
  7218  (6558)  
  7219  (6559)              markPeerUp(senderSystem)
  7220  (6560)  
  7221  (6561)              IF lineIsNew(relayOrig, relayId) = 0 THEN
  7222  (6562)                  nDupes + 1 =: nDupes
  7223  (6563)                  RETURN
  7224  (6564)              ENDIF
  7225  (6565)  
  7226  (6566)              takeRemDirect(relayOrig, relayId, nameAt, nameLength, &
  7227  (6567)                  textAt, textLength)
  7228  (6568)              RETURN
  7229  (6569)          ENDIF
  7230  (6570)  
  7231  (6571)          % A REFUSAL COMING HOME. Same guards as kTrkDir above, for the same
  7232  (6572)          % reasons: only from a trunk, never a returned letter, and never twice.
  7233  (6573)          % Not relayed onward - it was addressed here, like the message it is
  7234  (6574)          % about.
  7235  (6575)          IF kind = kTrkDBad THEN
  7236  (6576)              IF NOT fromTrunk THEN
  7237  (6577)                  RETURN
  7238  (6578)              ENDIF
  7239  (6579)              IF msgType = XMTRE THEN
  7240  (6580)                  RETURN
  7241  (6581)              ENDIF
  7242  (6582)  
  7243  (6583)              markPeerUp(senderSystem)
  7244  (6584)  
  7245  (6585)              IF lineIsNew(relayOrig, relayId) = 0 THEN
  7246  (6586)                  nDupes + 1 =: nDupes
  7247  (6587)                  RETURN
  7248  (6588)              ENDIF
  7249  (6589)  
  7250  (6590)              takeRemBad(nameAt, nameLength, textAt, textLength)
  7251  (6591)              RETURN
  7252  (6592)          ENDIF
  7253  (6593)  
  7254  (6594)          IF kind = kTrkMbrs THEN
  7255  (6595)              IF NOT fromTrunk THEN
  7256  (6596)                  RETURN
  7257  (6597)              ENDIF
  7258  (6598)              IF msgType = XMTRE THEN
  7259  (6599)                  RETURN
  7260  (6600)              ENDIF
  7261  (6601)              % Hearing from it is itself proof of life.
  7262  (6602)              markPeerUp(senderSystem)
  7263  (6603)  
  7264  (6604)              % SNAPSHOT, REPLACE, ANNOUNCE THE DIFFERENCE - 2026-09-02. The
  7265  (6605)              % replace itself is unchanged; what is new is that local seats
  7266  (6606)              % are told who appeared and who went, as ordinary kJoined and
  7267  (6607)              % kLeft, so the count and the notices finally cover the other
  7268  (6608)              % machines too.
  7269  (6609)              snapshotRem(senderSystem)
  7270  (6610)              takeMembers(senderSystem, textAt, textLength)
  7271  (6611)              announceDiff(senderSystem)
  7272  (6612)              RETURN
  7273  (6613)          ENDIF
  7274  (6614)  
  7275  (6615)          IF kind = kAdmStat THEN
  7276  (6616)              buildStatus =: length
  7277  (6617)              sendTo(senderMagic, length)
  7278  (6618)              RETURN
  7279  (6619)          ENDIF
  7280  (6620)  
  7281  (6621)          IF kind = kAdmStop THEN
  7282  (6622)              % Say who did it. An unattributed stop in a log is worth little,
  7283  (6623)              % and the asker's name rode in the nickname field for this.
  7284  (6624)              OUTPUT(1, 'AL19', 'CHATSV: stopped by ')
  7285  (6625)              showName(nameAt, nameLength)
  7286  (6626)              OUTPUT(1, 'AL1', '$')
  7287  (6627)              TRUE =: stopWanted
  7288  (6628)              RETURN
  7289  (6629)          ENDIF
  7290  (6630)  
  7291  (6631)          % The seat this sender already holds, or -1 if none. A "slot now=" line
  7292  (6632)          % used to print here on every message; it was part of the same bring-up
  7293  (6633)          % as the parse line above and went with it.
  7294  (6634)          findByMagic(senderMagic) =: slot
  7295  (6635)  
  7296  (6636)          IF kind = kJoin THEN
  7297  (6637)              % Order matches ChatRoom.TryJoin: empty name, then taken name, then
  7298  (6638)              % already joined.
  7299  (6639)              IF nameLength = 0 THEN
  7300  (6640)                  refuse(nameAt, nameLength, reasonNeedNick, lenNeedNick)
  7301  (6641)                  RETURN
  7302  (6642)              ENDIF
  7303  (6643)              findByName(nameAt, nameLength) =: taken
  7304  (6644)              IF taken >< 0 THEN
  7305  (6645)                  refuseNick(nameAt, nameLength)
  7306  (6646)                  RETURN
  7307  (6647)              ENDIF
  7308  (6648)              IF slot >< 0 THEN
  7309  (6649)                  refuse(nameAt, nameLength, reasonAlreadyIn, lenAlreadyIn)
  7310  (6650)                  RETURN
  7311  (6651)              ENDIF
  7312  (6652)  
  7313  (6653)              freeSlot =: slot
  7314  (6654)              IF slot = 0 THEN
  7315  (6655)                  % XROUT should have stopped this - the seat count it holds and
  7316  (6656)                  % maxSeats here are the same number. If it ever happens, the
  7317  (6657)                  % two have drifted apart and that is worth refusing loudly
  7318  (6658)                  % rather than overwriting a member.
  7319  (6659)                  refuse(nameAt, nameLength, reasonRoomFull, lenRoomFull)
  7320  (6660)                  RETURN
  7321  (6661)              ENDIF
  7322  (6662)  
  7323  (6663)              1 =: memberUsed(slot)
  7324  (6664)              senderMagic =: memberMagic(slot)
  7325  (6665)              copyNameIn(slot, nameAt, nameLength)
  7326  (6666)  
  7327  (6667)              % AND WHICH ROOM. The Join carries it in the TEXT field,
  7328  (6668)              % because with one port the room can no longer be told from
  7329  (6669)              % which port the message arrived on. Everything this member
  7330  (6670)              % says afterwards is broadcast only to the others in it.
  7331  (6671)              %
  7332  (6672)              % A BUILD VERSION MAY RIDE AFTER IT, split off here so copyRoomIn
  7333  (6673)              % never sees it and cannot mistake it for part of the room name.
  7334  (6674)              findJoinSep(textAt, textLength) =: sepAt
  7335  (6675)              IF sepAt >= 0 THEN
  7336  (6676)                  copyRoomIn(slot, textAt, sepAt - textAt)
  7337  (6677)                  copyVersionIn(slot, sepAt + 1, textAt + textLength - sepAt - 1)
  7338  (6678)              ELSE
  7339  (6679)                  copyRoomIn(slot, textAt, textLength)
  7340  (6680)                  0 =: memberVerLen(slot)
  7341  (6681)              ENDIF
  7342  (6682)  
  7343  (6683)              % The welcome goes only to the joiner; the room hears Joined.
  7344  (6684)              buildWelcome(nameAt, nameLength) =: length
  7345  (6685)              sendTo(senderMagic, length)
  7346  (6686)  
  7347  (6687)              % ---- WHAT THEY MISSED, BEFORE THE ROOM HEARS THEY ARRIVED -----
  7348  (6688)              %
  7349  (6689)              % ORDER MATTERS AND THIS IS THE RIGHT ONE. After the welcome,
  7350  (6690)              % because the client is not in the room until it has that and
  7351  (6691)              % would drop anything sent before it. Before the Joined broadcast,
  7352  (6692)              % so the transcript reads the way it happened: everything said
  7353  (6693)              % earlier, then "OLAV joined", then whatever is said next. Sending
  7354  (6694)              % history after the announcement would put old lines below the
  7355  (6695)              % arrival and read as though they were new.
  7356  (6696)              %
  7357  (6697)              % findTopic, NOT claimTopic - joining a room must not allocate a
  7358  (6698)              % history slot. A room nobody has ever spoken in has no history to
  7359  (6699)              % replay, and giving it a table entry on a join would let eight
  7360  (6700)              % people joining eight empty rooms fill the table with nothing.
  7361  (6701)              findTopic(slot) =: histSlot
  7362  (6702)              histReplay(histSlot, senderMagic)
  7363  (6703)  
  7364  (6704)              buildMessage(kJoined, nameAt, nameLength, 0, 0) =: length
  7365  (6705)              broadcast(length, slot, slot)        % their room, not them
  7366  (6706)  
  7367  (6707)              % AND TELL THE OTHER MACHINES SOMEBODY NEW IS HERE.
  7368  (6708)              % Without this a peer cannot see them until the next trunk
  7369  (6709)              % hello, so a private message addressed to them is refused
  7370  (6710)              % with 'nobody of that name is here now' while they sit in
  7371  (6711)              % the room. Same cause as the rename drift - see tellMbrs.
  7372  (6712)              tellMbrs
  7373  (6713)              RETURN
  7374  (6714)          ENDIF
  7375  (6715)  
  7376  (6716)          % ---- THE TWO THINGS A PERSON WITH NO SEAT MAY ASK ------------------
  7377  (6717)          %
  7378  (6718)          % Both are READ-ONLY and both are what somebody actually needs at the
  7379  (6719)          % moment they have no seat: they have just left, or been refused a
  7380  (6720)          % nickname, and the next question is always "what is there" or "who is
  7381  (6721)          % about". Answering silence to that is the client's worst behaviour.
  7382  (6722)          %
  7383  (6723)          % kRooms WAS SUPPOSED TO BE ALLOWED HERE ALREADY, and was not.
  7384  (6724)          % DOC/protocols/chat-wire.json has said since it was written:
  7385  (6725)          %
  7386  (6726)          %   "Allowed while UNJOINED, unlike Who: 'what rooms are there' is
  7387  (6727)          %    exactly what somebody asks after being refused a name, and the
  7388  (6728)          %    server needs no seat to answer it."
  7389  (6729)          %
  7390  (6730)          % The handler sat BELOW the membership guard, so /list from somebody
  7391  (6731)          % with no seat was dropped without a word. The registry described the
  7392  (6732)          % intention and the code never matched it - found 2026-08-22 by reading
  7393  (6733)          % the registry entry while building the /who case beside it.
  7394  (6734)          %
  7395  (6735)          % THE GUARD'S REASON STILL STANDS FOR EVERYTHING ELSE. Silence for a
  7396  (6736)          % stranger is deliberate: answering confirms the port is a chat server
  7397  (6737)          % to something that never joined. These two answers give up exactly
  7398  (6738)          % that one fact and nothing else - no seat is spent, no state changes,
  7399  (6739)          % and a roster is not a secret in a chat for one building. Saying and
  7400  (6740)          % joining and renaming stay behind the guard.
  7401  (6741)          IF kind = kRooms THEN
  7402  (6742)              buildRooms =: length
  7403  (6743)              sendTo(senderMagic, length)
  7404  (6744)              RETURN
  7405  (6745)          ENDIF
  7406  (6746)  
  7407  (6747)          % /map belongs here for the same reason /list does: it is READ-ONLY,
  7408  (6748)          % costs no seat, and is exactly what somebody asks when they cannot see
  7409  (6749)          % anyone - "is the other machine even there?". Refusing it to a person
  7410  (6750)          % with no seat would refuse it at the one moment it explains something.
  7411  (6751)          IF kind = kMap THEN
  7412  (6752)              buildMap =: length
  7413  (6753)              sendTo(senderMagic, length)
  7414  (6754)              RETURN
  7415  (6755)          ENDIF
  7416  (6756)  
  7417  (6757)          IF kind = kWho THEN
  7418  (6758)              IF slot = 0 THEN
  7419  (6759)                  % No seat means no room to filter by, so the answer is the
  7420  (6760)                  % whole house. A DIFFERENT KIND, because the client labels a
  7421  (6761)                  % kWho answer with the room it thinks it is in.
  7422  (6762)                  buildAllWho =: length
  7423  (6763)                  sendTo(senderMagic, length)
  7424  (6764)                  RETURN
  7425  (6765)              ENDIF
  7426  (6766)          ENDIF
  7427  (6767)  
  7428  (6768)          IF slot = 0 THEN
  7429  (6769)              RETURN
  7430  (6770)          ENDIF
  7431  (6771)  
  7432  (6772)          IF kind = kSay THEN
  7433  (6773)              % The speaker is named by the ROOM, never by what the sender put in
  7434  (6774)              % the message - otherwise anyone could speak as anyone.
  7435  (6775)              buildFromSlot(kSaid, slot, textAt, textLength) =: length
  7436  (6776)              broadcast(length, slot, 0)            % their room, speaker too
  7437  (6777)  
  7438  (6778)              % PHASE D: AND ON TO THE OTHER MACHINES.
  7439  (6779)              %
  7440  (6780)              % AFTER the local broadcast, deliberately. The people in the room
  7441  (6781)              % here are the ones waiting on this keystroke; a peer that is slow
  7442  (6782)              % or absent must not delay them. It also means a forward that fails
  7443  (6783)              % costs the local room nothing.
  7444  (6784)              %
  7445  (6785)              % forwardSaid reads inBuf, which still holds the arrival - the local
  7446  (6786)              % broadcast above only wrote outBuf.
  7447  (6787)              forwardSaid(slot, textAt, textLength)
  7448  (6788)  
  7449  (6789)              % ---- AND REMEMBER IT ----------------------------------------
  7450  (6790)              %
  7451  (6791)              % LAST, after the room and the peers have both been served, for
  7452  (6792)              % the same reason the forward goes after the broadcast: the people
  7453  (6793)              % waiting on this keystroke come first, and a disk write must never
  7454  (6794)              % sit between somebody pressing return and the room hearing it.
  7455  (6795)              %
  7456  (6796)              % claimTopic, despite the name - it is the room table, and history
  7457  (6797)              % shares its slots. It allocates on first use, so the file for a
  7458  (6798)              % room is created the first time anybody speaks in it rather than
  7459  (6799)              % when the room is invented, and a room nobody ever speaks in costs
  7460  (6800)              % nothing at all.
  7461  (6801)              %
  7462  (6802)              % A FULL TABLE RETURNS 0 AND histSave DOES NOTHING. Nine rooms
  7463  (6803)              % means the ninth keeps no history; it does not lose its messages.
  7464  (6804)              claimTopic(slot) =: histSlot
  7465  (6805)              histSave(histSlot, slot, textAt, textLength)
  7466  (6806)              RETURN
  7467  (6807)          ENDIF
  7468  (6808)  
  7469  (6809)          % A DIRECT MESSAGE. A SEAT IS REQUIRED - not because the target needs
  7470  (6810)          % to be in a room, they do not, but because the SENDER has to have a
  7471  (6811)          % name for the message to be from. This sits below the slot = 0 test
  7472  (6812)          % with kSay for that reason.
  7473  (6813)          IF kind = kDirect THEN
  7474  (6814)              handleDirect(slot, textAt, textLength)
  7475  (6815)              RETURN
  7476  (6816)          ENDIF
  7477  (6817)  
  7478  (6818)          IF kind = kRename THEN
  7479  (6819)              IF nameLength = 0 THEN
  7480  (6820)                  refuse(nameAt, nameLength, reasonNeedNick, lenNeedNick)
  7481  (6821)                  RETURN
  7482  (6822)              ENDIF
  7483  (6823)              IF sameName(slot, nameAt, nameLength) = 1 THEN
  7484  (6824)                  RETURN                            % already your name: not news
  7485  (6825)              ENDIF
  7486  (6826)              findByName(nameAt, nameLength) =: taken
  7487  (6827)              IF taken >< 0 THEN
  7488  (6828)                  refuseNick(nameAt, nameLength)
  7489  (6829)                  RETURN
  7490  (6830)              ENDIF
  7491  (6831)  
  7492  (6832)              % Renamed carries the NEW name and the OLD one as its text, so a
  7493  (6833)              % transcript on somebody's screen can be connected up. Built before
  7494  (6834)              % the slot changes, while the old name is still there.
  7495  (6835)              buildRenamed(slot, nameAt, nameLength) =: length
  7496  (6836)              copyNameIn(slot, nameAt, nameLength)
  7497  (6837)              broadcast(length, slot, 0)            % their room, asker too
  7498  (6838)  
  7499  (6839)              % AND ON TO THE OTHER MACHINES, or they go on advertising the
  7500  (6840)              % OLD name. AFTER the local broadcast for the same reason
  7501  (6841)              % forwardSaid is: the people in this room are the ones waiting,
  7502  (6842)              % and a peer that is slow or absent must not delay them.
  7503  (6843)              %
  7504  (6844)              % It sends the WHOLE list rather than a rename notice - see
  7505  (6845)              % tellMbrs - so a peer that missed an earlier change is repaired
  7506  (6846)              % by this one too.
  7507  (6847)              tellMbrs
  7508  (6848)              RETURN
  7509  (6849)          ENDIF
  7510  (6850)  
  7511  (6851)          % /who - answered to the ASKER ALONE, never broadcast. Everybody else
  7512  (6852)          % asking would then get a list they did not want, and the room would
  7513  (6853)          % spend a message on each of them.
  7514  (6854)          IF kind = kWho THEN
  7515  (6855)              % slot, not senderMagic: the answer is filtered to the ASKER'S
  7516  (6856)              % ROOM, so buildWho needs a seat to compare against.
  7517  (6857)              buildWho(slot) =: length
  7518  (6858)              sendTo(senderMagic, length)
  7519  (6859)              RETURN
  7520  (6860)          ENDIF
  7521  (6861)  
  7522  (6862)  
  7523  (6863)          % /list is NOT here any more - it moved ABOVE the membership guard,
  7524  (6864)          % where the registry always said it belonged. See the note there.
  7525  (6865)  
  7526  (6866)          % /topic - ask with an empty text, set with a non-empty one.
  7527  (6867)          %
  7528  (6868)          % A SET IS BROADCAST, AN ASK IS NOT. Everybody in the room needs to see
  7529  (6869)          % a topic change as it happens - it is a change to the room, not an
  7530  (6870)          % answer to one person - while an ask is nobody else's business.
  7531  (6871)          IF kind = kTopic THEN
  7532  (6872)              IF textLength = 0 THEN
  7533  (6873)                  buildTopic(slot) =: length
  7534  (6874)                  sendTo(senderMagic, length)
  7535  (6875)                  RETURN
  7536  (6876)              ENDIF
  7537  (6877)  
  7538  (6878)              % TRUNCATED, NOT REFUSED. The length arrives from the peer and
  7539  (6879)              % PLANC checks no array bound, so a long topic would write straight
  7540  (6880)              % through the rest of the table. The client already stops at 64, so
  7541  (6881)              % this only ever bites a peer that is not our client - which is
  7542  (6882)              % exactly the case a bound has to survive.
  7543  (6883)              IF textLength > maxTopicLen THEN
  7544  (6884)                  maxTopicLen =: textLength
  7545  (6885)              ENDIF
  7546  (6886)  
  7547  (6887)              claimTopic(slot) =: taken
  7548  (6888)              IF taken = 0 THEN
  7549  (6889)                  % The table is full. SAY SO rather than dropping it: a topic
  7550  (6890)                  % that silently does not stick is the kind of failure somebody
  7551  (6891)                  % retries for ten minutes. refuse() sends for itself.
  7552  (6892)                  refuse(nameAt, nameLength, reasonTopicFull, lenTopicFull)
  7553  (6893)                  RETURN
  7554  (6894)              ENDIF
  7555  (6895)  
  7556  (6896)              FOR i IN 1:textLength DO
  7557  (6897)                  inBuf(textAt + i - 1) =: topicText(taken, i)
  7558  (6898)              ENDFOR
  7559  (6899)              textLength =: topicTextLen(taken)
  7560  (6900)  
  7561  (6901)              buildTopic(slot) =: length
  7562  (6902)              broadcast(length, slot, 0)        % 0 = leave nobody out
  7563  (6903)              RETURN
  7564  (6904)          ENDIF
  7565  (6905)  
  7566  (6906)          IF kind = kLeave THEN
  7567  (6907)              buildFromSlot(kLeft, slot, 0, 0) =: length
  7568  (6908)              0 =: memberUsed(slot)
  7569  (6909)              broadcast(length, slot, slot)         % their room, not them
  7570  (6910)  
  7571  (6911)              % AND TELL THE OTHER MACHINES THEY HAVE GONE. AFTER the seat
  7572  (6912)              % is released above, so the list we build no longer holds
  7573  (6913)              % them - tellMbrs reports the table as it stands.
  7574  (6914)              %
  7575  (6915)              % A STALE ENTRY HERE IS THE WORSE DIRECTION: a peer that still
  7576  (6916)              % believes somebody is seated will accept a private message
  7577  (6917)              % for them and send it across the trunk. Since 6.3b the far end
  7578  (6918)              % no longer drops that in silence - takeRemDirect answers with
  7579  (6919)              % kTrkDBad and the sender is told - but a refusal after the fact
  7580  (6920)              % is a worse answer than not sending at all, so the peers are
  7581  (6921)              % still told at once.
  7582  (6922)              tellMbrs
  7583  (6923)  
  7584  (6924)              % Give the seat back to XROUT, or the room fills up permanently and
  7585  (6925)              % XROUT stops forwarding joins long after anybody left.
  7586  (6926)              xmpinfc(0, myPort, 1, 0) =: returnStatus
  7587  (6927)              RETURN
  7588  (6928)          ENDIF
  7589  (6929)      ENDROUTINE
  7590  (6930)  
  7591  (6931)      % -----------------------------------------------------------------------
  7592  (6932)      % The program.
  7593  (6933)      % -----------------------------------------------------------------------
  7594  (6934)      PROGRAM : chatServer
  7595  (6935)          XMMSGIDENTIFIER : msgIdent
  7596  (6936)          INTEGER : i
  7597  (6937)          % readStatus - 2026-09-01. returnStatus is one shared variable
  7598  (6938)          % reused by every XMSG call in this loop, so by the time anything
  7599  (6939)          % downstream could look at it, XMPFREL has already overwritten
  7600  (6940)          % whatever XMPFREA itself answered. Nothing checked the READ
  7601  (6941)          % succeeding before handleMessage trusted what it read into.
  7602  (6942)          INTEGER : readStatus
  7603  (6943)  
  7604  (6944)          % INISTACK RUNS EVERY START, and it must - the stack does not survive
  7605  (6945)          % the terminate. Everything below it is guarded instead.
  7606  (6946)          INISTACK stack
  7607  (6947)  
  7608  (6948)          % ---- THE HISTORY TABLE, CLEARED BY HAND -----------------------------
  7609  (6949)          %
  7610  (6950)          % PLANC DOES NOT PROMISE A MODULE VARIABLE STARTS AT ZERO, and this
  7611  (6951)          % file already carries one scar from assuming it did - see the note by
  7612  (6952)          % typedLen in the client. Three of these would be quietly fatal rather
  7613  (6953)          % than merely wrong:
  7614  (6954)          %
  7615  (6955)          %   histDev   a stale non-zero would be taken for an OPEN FILE and
  7616  (6956)          %             handed to MN120 as a device number;
  7617  (6957)          %   histSize  a stale ZERO is a DIVIDE BY ZERO the first time anybody
  7618  (6958)          %             speaks, because the ring is id MOD size;
  7619  (6959)          %   histNext  a stale value writes the first message into the middle of
  7620  (6960)          %             the ring and replays blocks that were never written.
  7621  (6961)          %
  7622  (6962)          %   topicRmLen  ADDED 2026-09-02, and it is the "empty list on join"
  7623  (6963)          %             bug. This is the marker claimTopic reads as "slot free"
  7624  (6964)          %             (zero) and findTopic reads as "which room". Left as
  7625  (6965)          %             garbage on a fresh RT segment, claimTopic finds no free
  7626  (6966)          %             slot and returns 0, so histSave does NOTHING and nothing
  7627  (6967)          %             is ever stored to replay - or findTopic mismatches and a
  7628  (6968)          %             real room never finds its history. The neighbours above
  7629  (6969)          %             were cleared; this one was missed, and it depends on what
  7630  (6970)          %             the freshly allocated segment happened to hold, which is
  7631  (6971)          %             why it reads as intermittent. topicTextLen goes with it,
  7632  (6972)          %             for the same reason a stale topic would otherwise show.
  7633  (6973)          %
  7634  (6974)          % Cleared here, before anything can be received.
  7635  (6975)          FOR i IN 1:maxHistRooms DO
  7636  (6976)              0 =: histDev(i)
  7637  (6977)              0 =: histNext(i)
  7638  (6978)              histDefault =: histSize(i)
  7639  (6979)          ENDFOR
  7640  (6980)          FOR i IN 1:maxTopics DO
  7641  (6981)              0 =: topicRmLen(i)
  7642  (6982)              0 =: topicTextLen(i)
  7643  (6983)          ENDFOR
  7644  (6984)  
  7645  (6985)          % ---- NEVER XFWTF. XFWAK ONLY AS A DOORBELL. -----------------------
  7646  (6986)          %
  7647  (6987)          % The history below is kept because both flags have been in this line
  7648  (6988)          % before and both took the server down. Read it before changing them.
  7649  (6989)          %
  7650  (6990)          % XFWTF was never right here: a task already blocked in XFRCV is ACTIVE,
  7651  (6991)          % and RT-starting an active program does not queue a second run, so a
  7652  (6992)          % wake-up arriving during a block is simply LOST.
  7653  (6993)          %
  7654  (6994)          % CORRECTED 2026-08-28: THE PARAGRAPH BELOW BLAMES THE WRONG FLAG.
  7655  (6995)          % Carved from git history - XFWAK appears ZERO times in the version
  7656  (6996)          % before 2026-08-21 and first entered this file on 2026-08-25, FOUR
  7657  (6997)          % DAYS AFTER the outage. That build had ONE xmpfrcv, on myPort, with
  7658  (6998)          % 2**XFWTF - the BLOCKING flag - and no admin receive at all. So the
  7659  (6999)          % server was parked by the BLOCKING receive, which is what the first
  7660  (7000)          % paragraph above already says. A non-blocking XFWAK parks nothing and
  7661  (7001)          % planc-lint no longer refuses it.
  7662  (7002)          %
  7663  (7003)          % STILL UNEXPLAINED, and worth re-checking before trusting a doorbell:
  7664  (7004)          % the LIST-PORTS capture quoted below shows WAK 1 on the admin port,
  7665  (7005)          % and the committed source of the day has neither an admin receive nor
  7666  (7006)          % XFWAK. Either the running build was uncommitted, or something else
  7667  (7007)          % sets that bit.
  7668  (7008)          %
  7669  (7009)          % BUT XFWAK IS ALSO WRONG NOW, AND IT HUNG THE SERVER. Measured on
  7670  (7010)          % D100, 2026-08-21, with one client trying to join:
  7671  (7011)          %
  7672  (7012)          %   X-C LIST-PORTS
  7673  (7013)          %    No  Address  Owner-task   Qhead  Qlen  Chain WAK
  7674  (7014)          %     6  160057 152616 BAK06  161762     1      0   0   <- the ROOM port
  7675  (7015)          %    14  160147 152616 BAK06       0     0      6   1   <- the ADMIN port
  7676  (7016)          %
  7677  (7017)          % A message SITTING on the room port, and the task parked on the admin
  7678  (7018)          % port's wake-up instead. The server had logged its two START lines and
  7679  (7019)          % then written nothing more; the client waited for ever at "not in a
  7680  (7020)          % room yet". XFRCV CANNOT WAIT ON TWO PORTS - arming a wake on each does
  7681  (7021)          % not make one call watch both, and the wake-up does NOT deliver the
  7682  (7022)          % message even when it fires.
  7683  (7023)          %
  7684  (7024)          % XFWAK WAS LEFT OVER FROM A DESIGN THAT NO LONGER EXISTS. It belonged
  7685  (7025)          % to the original loop, which RETURNED when both ports were empty and
  7686  (7026)          % relied on the next message RT-starting the program again. That was
  7687  (7027)          % replaced by the MON 267B sleep below - the program now STAYS ALIVE and
  7688  (7028)          % goes round - and once it stays alive there is nothing for a wake-up to
  7689  (7029)          % do. Keeping it bought nothing and cost the whole server.
  7690  (7030)          %
  7691  (7031)          % ---- AND NOW XFWAK IS BACK, FOR A DIFFERENT REASON ----------------
  7692  (7032)          %
  7693  (7033)          % Everything above stays true: XFWAK cannot make one XFRCV watch two
  7694  (7034)          % ports, and it does not deliver the message. It is a DOORBELL, and
  7695  (7035)          % nothing more. What changed is that there is now something for a
  7696  (7036)          % doorbell to ring: the program STAYS ALIVE in a one-second TimeOut
  7697  (7037)          % instead of terminating, and TimeOut's own restart cause (-1) is the
  7698  (7038)          % bell being heard. See the declarations of wakeSpin for the manual
  7699  (7039)          % lines this rests on, and for the counter that disarms it if the
  7700  (7040)          % restart flag turns out to be sticky.
  7701  (7041)          %
  7702  (7042)          % It is still NOT blocking - XFWTF is not set, so all three ports are
  7703  (7043)          % polled every pass exactly as before. Take this word out and the
  7704  (7044)          % server keeps working; it just waits up to a second again.
  7705  (7045)          IF doorbellOn THEN
  7706  (7046)              2**XFWAK =: waitFlags
  7707  (7047)          ELSE
  7708  (7048)              0 =: waitFlags
  7709  (7049)          ENDIF
  7710  (7050)          2**XFSEC =: sendFlags
  7711  (7051)  
  7712  (7052)          % ---- OPEN ONCE, NOT ONCE PER START ---------------------------------
  7713  (7053)          IF NOT portsOpen THEN
  7714  (7054)              FOR i IN 1:maxSeats DO
  7715  (7055)                  0 =: memberUsed(i)
  7716  (7056)                  0 =: memberDead(i)
  7717  (7057)              ENDFOR
  7718  (7058)  
  7719  (7059)              % A CONNECTION port: XROUT holds the free-connection counter and
  7720  (7060)              % turns the joiner past maxSeats away for us, before this program
  7721  (7061)              % is woken. That is the whole reason no client knows the number.
  7722  (7062)              % ONE PORT, CALLED *CHAT. Every service on this machine is starred
  7723  (7063)              % and short - *FA-SERVER, *XFTRA, *COSPO, *TADADM - and the chat
  7724  (7064)              % server is one of them.
  7725  (7065)              %
  7726  (7066)              % IT USED TO BE CHAT-LOBBY, and that was two mistakes in one name.
  7727  (7067)              % CHAT-LOBBY is a ROOM name doing duty as a SERVICE name, and the
  7728  (7068)              % client built a DIFFERENT port name per room - "CHAT-" plus the
  7729  (7069)              % room - so every room needed its own registered port. That made
  7730  (7070)              % the set of rooms XROUT's data rather than the server's, with no
  7731  (7071)              % call to read it back; it made a room expensive to create; it
  7732  (7072)              % fragmented the seat count per port; and it turned a federated
  7733  (7073)              % room into the SAME NAME registered on two machines, which is a
  7734  (7074)              % collision rather than shared state.
  7735  (7075)              %
  7736  (7076)              % Now: one port, and the ROOM TRAVELS IN THE MESSAGE. LOBBY goes
  7737  (7077)              % back to being an ordinary room. See the_room_model in
  7738  (7078)              % DOC/protocols/chat-wire.json.
  7739  (7079)              xmpopcn(0, '*CHAT', uniqueName, maxSeats, myPort) &
  7740  (7080)                  =: returnStatus
  7741  (7081)              IF returnStatus >< XMOK THEN
  7742  (7082)                  OUTPUT(1, 'AL29', 'CHATSV: cannot open the room$')
  7743  (7083)                  OUTPUT(1, 'AL11', 'SV: opn st=')
  7744  (7084)                  OUTPUT(1, 'I6', returnStatus)
  7745  (7085)                  OUTPUT(1, 'AL1', '$')
  7746  (7086)                  RETURN
  7747  (7087)              ENDIF
  7748  (7088)  
  7749  (7089)              % The command port. XMPOPNM - a NORMAL named port, so an operator
  7750  (7090)              % costs the room nothing. See the declaration for why that matters.
  7751  (7091)              xmpopnm(0, admName(0:lenAdmName - 1), adminPort) =: returnStatus
  7752  (7092)              IF returnStatus >< XMOK THEN
  7753  (7093)                  OUTPUT(1, 'AL28', 'CHATSV: no command port, st=')
  7754  (7094)                  OUTPUT(1, 'I6', returnStatus)
  7755  (7095)                  OUTPUT(1, 'AL1', '$')
  7756  (7096)                  % NOT fatal. A server that will not start because nobody can
  7757  (7097)                  % ask it for STATUS is worse than one that runs unattended.
  7758  (7098)              ENDIF
  7759  (7099)  
  7760  (7100)              % The trunk port. XMPOPNM for the same reason the command port is -
  7761  (7101)              % a peer that is switched off must cost the room nothing however
  7762  (7102)              % long it stays away.
  7763  (7103)              xmpopnm(0, trkName(0:lenTrkName - 1), trunkPort) =: returnStatus
  7764  (7104)              IF returnStatus >< XMOK THEN
  7765  (7105)                  OUTPUT(1, 'AL26', 'CHATSV: no trunk port, st=')
  7766  (7106)                  OUTPUT(1, 'I6', returnStatus)
  7767  (7107)                  OUTPUT(1, 'AL1', '$')
  7768  (7108)                  % NOT fatal, same judgement as the command port: a server that
  7769  (7109)                  % refuses to serve its own room because it cannot federate is
  7770  (7110)                  % worse than one that serves the room and cannot federate.
  7771  (7111)              ENDIF
  7772  (7112)  
  7773  (7113)              % Our own magic number, so an arrival can be tested against it.
  7774  (7114)              xmpfp2m(0, myPort, myMagic) =: returnStatus
  7775  (7115)              IF returnStatus >< XMOK THEN
  7776  (7116)                  OUTPUT(1, 'AL18', 'SV: p2m failed st=')
  7777  (7117)                  OUTPUT(1, 'I6', returnStatus)
  7778  (7118)                  OUTPUT(1, 'AL1', '$')
  7779  (7119)              ENDIF
  7780  (7120)  
  7781  (7121)              % ...and our own SYSTEM number out of it, so the trunk can tell our
  7782  (7122)              % own bounced letters from a peer saying hello. See mySystem.
  7783  (7123)              xmpfm2p(0, myMagic, senderPortNo, mySystem, &
  7784  (7124)                  senderRtInfo, senderExtra) =: returnStatus
  7785  (7125)  
  7786  (7126)              % ONE BANNER, AND IT STAYS. An operator has to be able to tell a
  7787  (7127)              % server that is waiting from one that never got its room, and the
  7788  (7128)              % port number is what LIST-PORTS is matched against when it does
  7789  (7129)              % not. It prints on the FIRST start only - this program is now
  7790  (7130)              % started again by every arrival, and a banner per message would
  7791  (7131)              % bury the machine.
  7792  (7132)              0 =: nEmptyLet
  7793  (7133)              0 =: nRelayed
  7794  (7134)              0 =: nForwarded
  7795  (7135)              0 =: nFwdBad
  7796  (7136)              0 =: nDupes
  7797  (7137)              0 =: myLineId
  7798  (7138)              1 =: seenAt
  7799  (7139)              0 =: seenUsed
  7800  (7140)              0 =: nBounced
  7801  (7141)              0 =: nRefused
  7802  (7142)  
  7803  (7143)              OUTPUT(1, 'AL24', 'CHATSV: room open, port ')
  7804  (7144)              OUTPUT(1, 'I6', myPort)
  7805  (7145)              OUTPUT(1, 'AL9', ' command ')
  7806  (7146)              OUTPUT(1, 'I6', adminPort)
  7807  (7147)              OUTPUT(1, 'AL7', ' trunk ')
  7808  (7148)              OUTPUT(1, 'I6', trunkPort)
  7809  (7149)              OUTPUT(1, 'AL1', '$')
  7810  (7150)              logLine('SV START room prt=', myPort)
  7811  (7151)              logLine('SV START admin prt', adminPort)
  7812  (7152)              logLine('SV START trunk prt', trunkPort)
  7813  (7153)  
  7814  (7154)              TRUE =: portsOpen
  7815  (7155)          ENDIF
  7816  (7156)  
  7817  (7157)          DO
  7818  (7158)              % WAIT. XFWTF is what makes this block rather than spin; an RT
  7819  (7159)              % program that polls burns the machine for nothing. Without the
  7820  (7160)              % flag the status would come back MXNEXTM when nothing is waiting.
  7821  (7161)              % ---- DRAIN BOTH PORTS, THEN TERMINATE --------------------------
  7822  (7162)              %
  7823  (7163)              % The lobby first, because that is the busy one. If it is empty,
  7824  (7164)              % the command port. If BOTH are empty, both wake-ups are now armed
  7825  (7165)              % and there is nothing to do: RETURN, and the next transmission to
  7826  (7166)              % either port RT-starts this program again.
  7827  (7167)              %
  7828  (7168)              % HOW "EMPTY" IS TOLD FROM "GOT ONE", which is the whole hazard of
  7829  (7169)              % dropping XFWTF and is MEASURED rather than reasoned:
  7830  (7170)              %
  7831  (7171)              %   XMOK (0)        a SUCCESSFUL receive, with the type in the
  7832  (7172)              %                   msgType out-parameter. Vendor Appendix G tests
  7833  (7173)              %                   "IF RETURNSTATUS >< XMOK THEN bad status", and
  7834  (7174)              %                   D100 printed "SV: rcv st= 0 t= 2 len= 25".
  7835  (7175)              %   XMTNO..XMTPS    also a successful receive.
  7836  (7176)              %   XMXENTM (16896) an EMPTY port. Neither of the above.
  7837  (7177)              %
  7838  (7178)              % The manual's "a zero status is returned" for an empty port
  7839  (7179)              % describes the RAW MON call. XMPFRCV remaps it - the library's
  7840  (7180)              % empty answer is 16896, not 0 - so zero is unambiguous here. Had
  7841  (7181)              % that not been so, this loop could not have told an empty port
  7842  (7182)              % from a message and would have terminated on live traffic.
  7843  (7183)              FALSE =: fromAdmin
  7844  (7184)              FALSE =: fromTrunk
  7845  (7185)              xmpfrcv(waitFlags, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  7846  (7186)                  =: returnStatus
  7847  (7187)  
  7848  (7188)              IF returnStatus = XMXENTM THEN
  7849  (7189)                  TRUE =: fromAdmin
  7850  (7190)                  xmpfrcv(waitFlags, adminPort, msgType, remotePortHash, &
  7851  (7191)                      msgIdent, nBytes) =: returnStatus
  7852  (7192)  
  7853  (7193)                  % ---- AND THEN THE TRUNK PORT ------------------------------
  7854  (7194)                  % Third in the round, and last on purpose: people in the room
  7855  (7195)                  % come before an operator, and an operator before a machine
  7856  (7196)                  % saying hello. Trunk traffic is the least urgent thing here.
  7857  (7197)                  IF returnStatus = XMXENTM THEN
  7858  (7198)                      FALSE =: fromAdmin
  7859  (7199)                      TRUE =: fromTrunk
  7860  (7200)                      xmpfrcv(waitFlags, trunkPort, msgType, remotePortHash, &
  7861  (7201)                          msgIdent, nBytes) =: returnStatus
  7862  (7202)                  ENDIF
  7863  (7203)  
  7864  (7204)                  IF returnStatus = XMXENTM THEN
  7865  (7205)                      % ---- BOTH EMPTY: SLEEP, DO NOT END ------------------
  7866  (7206)                      %
  7867  (7207)                      % THIS USED TO "RETURN", AND THAT WAS REFUTED ON THE
  7868  (7208)                      % MACHINE. MEASURED on D100 2026-08-20: @RT CHATSER ran,
  7869  (7209)                      % drained both empty ports, returned - and
  7870  (7210)                      % LIST-RT-DESCRIPTION then said PASSIVE with 0 CPU units
  7871  (7211)                      % while LIST-NAMES showed NEITHER CHAT-LOBBY NOR
  7872  (7212)                      % CHAT-ADMIN. SINTRAN CLOSES A TASK'S PORTS WHEN THE TASK
  7873  (7213)                      % TERMINATES, so the XFWAK wake-up had nothing left to
  7874  (7214)                      % arrive on and the server could never be restarted.
  7875  (7215)                      %
  7876  (7216)                      % The manual's wake-up mechanism is real, but it assumes a
  7877  (7217)                      % task that STAYS ALIVE to be woken. Both halves of that
  7878  (7218)                      % were already written down here and were not put together.
  7879  (7219)                      %
  7880  (7220)                      % So: sleep and go round. MON 267B suspends the program for
  7881  (7221)                      % a given time and continues after the call - no spin, no
  7882  (7222)                      % termination, ports stay open. Unit type 1 is basic time
  7883  (7223)                      % units of 1/50 second, so 50 is one second: long enough to
  7884  (7224)                      % cost nothing, short enough that an operator typing STATUS
  7885  (7225)                      % does not notice the wait.
  7886  (7226)                      %
  7887  (7227)                      % A BARE LOOP WITH NO SLEEP IS NOT AN OPTION. When XMSG
  7888  (7228)                      % died under this server the receive stopped blocking and
  7889  (7229)                      % this loop burned the machine until somebody pressed ESC.
  7890  (7230)                      % A FULL SECOND WHEN THE DOORBELL IS ARMED, because a
  7891  (7231)                      % wake-up is what ends it early; 100 ms when it is not,
  7892  (7232)                      % which is the poll this loop used before and the state it
  7893  (7233)                      % falls back to. sleepWhy comes back 0 for the time simply
  7894  (7234)                      % elapsing, 1 for a break, and -1 for the RT-start that a
  7895  (7235)                      % waiting message performs.
  7896  (7236)                      IF doorbellOn THEN
  7897  (7237)                          50 =: sleepUnits
  7898  (7238)                      ELSE
  7899  (7239)                          5 =: sleepUnits
  7900  (7240)                      ENDIF
  7901  (7241)                      1 =: sleepKind
  7902  (7242)                      MONITOR_CALL('TimeOut', sleepUnits, sleepKind, sleepWhy)
  7903  (7243)  
  7904  (7244)                      % ---- DID THE BELL RING, OR DID THE TIME RUN OUT? ------
  7905  (7245)                      %
  7906  (7246)                      % This is the measurement the whole change exists for, and
  7907  (7247)                      % it costs one comparison. A -1 here that found all three
  7908  (7248)                      % ports empty is a wake with nothing behind it; twenty in a
  7909  (7249)                      % row means the restart flag is not clearing, so disarm and
  7910  (7250)                      % go back to polling rather than spin.
  7911  (7251)                      IF doorbellOn AND sleepWhy < 0 THEN
  7912  (7252)                          wakeSpin + 1 =: wakeSpin
  7913  (7253)                          IF wakeSpin >= wakeSpinMax THEN
  7914  (7254)                              FALSE =: doorbellOn
  7915  (7255)                              0 =: waitFlags
  7916  (7256)                              logLine('SV doorbell off   ', wakeSpin)
  7917  (7257)                          ENDIF
  7918  (7258)                      ENDIF
  7919  (7259)  
  7920  (7260)                      % ---- HAS A SECOND GONE BY? AGE THE TRUNKS --------------
  7921  (7261)                      %
  7922  (7262)                      % Asked of the CLOCK, not of how many times we have been
  7923  (7263)                      % round here. That distinction used to not matter, because
  7924  (7264)                      % every sleep ran its full 100 ms and ten of them were a
  7925  (7265)                      % second by construction. A doorbell that cuts a sleep
  7926  (7266)                      % short destroys that, and a busy room must not make peers
  7927  (7267)                      % time out faster - so the question is now MON11's.
  7928  (7268)                      %
  7929  (7269)                      % It still lives inside the all-ports-empty branch: a
  7930  (7270)                      % server with traffic never sleeps, and its trunks are
  7931  (7271)                      % plainly alive, so there is nothing to age.
  7932  (7272)                      MON11 =: nowTicks
  7933  (7273)                      IF nowTicks - lastTick >= tickUnits THEN
  7934  (7274)                          nowTicks =: lastTick
  7935  (7275)                          peerTick
  7936  (7276)                      ENDIF
  7937  (7277)                  ENDIF
  7938  (7278)              ENDIF
  7939  (7279)  
  7940  (7280)              % ---- A REAL MESSAGE CLEARS THE DOORBELL'S SUSPICION ------------
  7941  (7281)              %
  7942  (7282)              % wakeSpin counts wake-ups that turned out to have nothing behind
  7943  (7283)              % them, and it must count them CONSECUTIVELY - otherwise a busy
  7944  (7284)              % server, where nearly every wake IS a message, would still reach
  7945  (7285)              % twenty eventually and disarm a doorbell that was working
  7946  (7286)              % perfectly. Anything other than an empty port is proof the
  7947  (7287)              % mechanism is delivering, so the count goes back to zero.
  7948  (7288)              IF returnStatus >< XMXENTM THEN
  7949  (7289)                  0 =: wakeSpin
  7950  (7290)              ENDIF
  7951  (7291)  
  7952  (7292)              % A RECEIVE IS A MESSAGE ONLY WHEN THE STATUS IS A MESSAGE TYPE.
  7953  (7293)              % Not "= XMOK" and not "> 0". The library remaps statuses: 0 is OK
  7954  (7294)              % for other calls but is NOT a message type, so comparing to it
  7955  (7295)              % here discards every message; and 16896 (XMXENTM, nothing there)
  7956  (7296)              % and every error are positive, so "> 0" accepts an empty port.
  7957  (7297)              % The constants file settles it - "Message types: Returned as
  7958  (7298)              % successfull status from XFRCV", XMTNO=1 through XMTPS=6.
  7959  (7299)              % PRINT THE STATUS OF EVERY RECEIVE, OUTSIDE THE TEST.
  7960  (7300)              %
  7961  (7301)              % This line is here because the test below threw the message away
  7962  (7302)              % and every diagnostic was INSIDE it, so the server looked as if it
  7963  (7303)              % had never woken at all. MEASURED 2026-08-18: CHAT-LOBBY went from
  7964  (7304)              % 8 free seats to 6 across two joins, which proves XROUT accepted
  7965  (7305)              % both letters and forwarded them here - "XROUT will decrement the
  7966  (7306)              % counter and forward the whole message to portName" - while this
  7967  (7307)              % program printed nothing and went straight back to waiting.
  7968  (7308)              %
  7969  (7309)              % A gate must never be the only thing that can tell you it closed.
  7970  (7310)              % This printed on EVERY receive during bring-up. It now prints only
  7971  (7311)              % when the receive is NOT one this server accepts - which is the case
  7972  (7312)              % the original comment was really about. A message that arrives and is
  7973  (7313)              % handled says so by what it does; a message thrown away by the test
  7974  (7314)              % below still has nothing else to speak for it.
  7975  (7315)              % ---- KNOW WHEN TO STOP -------------------------------------
  7976  (7316)              % MEASURED 2026-08-18, and it is why this block exists at all.
  7977  (7317)              % XMSG went down under a running server. XMPFRCV then stopped
  7978  (7318)              % blocking - there is nothing to wait ON - and returned 16933,
  7979  (7319)              % XMXENRU, "XMSG not running", instantly, for ever. This loop
  7980  (7320)              % printed that line as fast as the terminal could take it and
  7981  (7321)              % burned the machine until somebody pressed ESC.
  7982  (7322)              %
  7983  (7323)              % A WAIT THAT CANNOT WAIT IS A SPIN. The XFWTF flag is what makes
  7984  (7324)              % this loop cheap, and it quietly stops meaning anything the moment
  7985  (7325)              % the thing it waits on is gone. Any program built around a
  7986  (7326)              % blocking call needs an answer for that, and "print and go round
  7987  (7327)              % again" is not one.
  7988  (7328)              %
  7989  (7329)              % Two ways out, and they are different on purpose:
  7990  (7330)              %
  7991  (7331)              %   XMXENRU        STOP. Nothing this program can do brings XMSG
  7992  (7332)              %                  back - an operator has to restart it - so
  7993  (7333)              %                  retrying is not persistence, it is a busy loop
  7994  (7334)              %                  with no end. Say so plainly and leave.
  7995  (7335)              %
  7996  (7336)              %   anything else  RETRY, but not for ever. An unknown status may
  7997  (7337)              %                  well clear; the same one arriving maxBadRuns
  7998  (7338)              %                  times running has not cleared and will not.
  7999  (7339)              %
  8000  (7340)              % A GOOD RECEIVE CLEARS THE COUNT, so the limit is on a RUN of
  8001  (7341)              % failures rather than on failures for the life of the program. A
  8002  (7342)              % server that has been up for a week and sees twenty scattered odd
  8003  (7343)              % statuses is healthy; one that sees twenty in a row is not.
  8004  (7344)              IF returnStatus = XMOK OR &
  8005  (7345)                 (returnStatus >= XMTNO AND returnStatus <= XMTPS) THEN
  8006  (7346)                  0 =: badRuns
  8007  (7347)              ELSE
  8008  (7348)                  IF returnStatus >< XMXENTM THEN
  8009  (7349)                      badRuns + 1 =: badRuns
  8010  (7350)  
  8011  (7351)                      % Print the first few and then stop shouting. The whole
  8012  (7352)                      % fault above was a message repeated without limit, and a
  8013  (7353)                      % diagnostic that fills the screen hides the one line that
  8014  (7354)                      % matters.
  8015  (7355)                      IF badRuns <= maxNoisy THEN
  8016  (7356)                          OUTPUT(1, 'AL23', 'SV: receive refused st=')
  8017  (7357)                          OUTPUT(1, 'I6', returnStatus)
  8018  (7358)                          OUTPUT(1, 'AL1', '$')
  8019  (7359)                          logLine('SV rcv refused st=', returnStatus)
  8020  (7360)                      ENDIF
  8021  (7361)  
  8022  (7362)                      IF returnStatus = XMXENRU THEN
  8023  (7363)                          OUTPUT(1, 'AL31', 'CHATSV: XMSG is not running - $')
  8024  (7364)                          OUTPUT(1, 'AL31', 'CHATSV: stopping, restart XMSG$')
  8025  (7365)                          RETURN
  8026  (7366)                      ENDIF
  8027  (7367)  
  8028  (7368)                      IF badRuns > maxBadRuns THEN
  8029  (7369)                          OUTPUT(1, 'AL30', 'CHATSV: too many bad receives$')
  8030  (7370)                          OUTPUT(1, 'I6', returnStatus)
  8031  (7371)                          OUTPUT(1, 'AL1', '$')
  8032  (7372)                          RETURN
  8033  (7373)                      ENDIF
  8034  (7374)                  ENDIF
  8035  (7375)              ENDIF
  8036  (7376)  
  8037  (7377)              % ACCEPT XMOK TOO - Appendix G's SERVER does exactly this.
  8038  (7378)              %
  8039  (7379)              % The old test was the range XMTNO..XMTPS alone, defended by a
  8040  (7380)              % comment claiming 0 "is NOT a message type, so comparing to it here
  8041  (7381)              % discards every message". The vendor sample says otherwise: after
  8042  (7382)              % XMPFRCV it tests "IF RETURNSTATUS >< XMOK THEN ... bad status" and
  8043  (7383)              % only THEN looks at the MSGTYPE out-parameter to check for XMROU.
  8044  (7384)              % So XMOK is a successful receive, and the message type belongs in
  8045  (7385)              % msgType, not in the status.
  8046  (7386)              %
  8047  (7387)              % Both forms are accepted here rather than one being swapped for the
  8048  (7388)              % other, because the print above will say which one actually turns up
  8049  (7389)              % and guessing is what put the range test here in the first place.
  8050  (7390)              IF returnStatus = XMOK OR &
  8051  (7391)                 (returnStatus >= XMTNO AND returnStatus <= XMTPS) THEN
  8052  (7392)                  % The FULL magic number of the sender - XMPFRCV hands back only
  8053  (7393)                  % a hashed port, and we must be able to answer.
  8054  (7394)                  % A "got t= len=" line printed here to separate "never woke"
  8055  (7395)                  % from "woke, replied, reply lost". It said to remove it once the
  8056  (7396)                  % join works, and the join works.
  8057  (7397)                  % THE RECEIVE'S OWN nBytes, KEPT BEFORE ANYTHING OVERWRITES IT.
  8058  (7398)                  % For an ordinary message it is the length; for a RETURNED one
  8059  (7399)                  % the guide says it is something else entirely - "If msgType is
  8060  (7400)                  % XMTRE, msgLengthOrStat contains the error status" - and
  8061  (7401)                  % xmpfmst below writes over it either way.
  8062  (7402)                  nBytes =: receiveStat
  8063  (7403)  
  8064  (7404)                  xmpfmst(0, msgIdent, msgType, senderMagic, nBytes) =: returnStatus
  8065  (7405)  
  8066  (7406)                  % WHICH MACHINE SENT THIS. A magic number is a port and a system
  8067  (7407)                  % packed together, and XMPFM2P is the library's own way of taking
  8068  (7408)                  % it apart - "Take a magic number apart into port number and
  8069  (7409)                  % system number" (xmp-api.json, transcribed from XMP-B02:DEFS).
  8070  (7410)                  %
  8071  (7411)                  % The TRUNK needs it and nothing else does: a peer is identified
  8072  (7412)                  % by system number, and an unsolicited HELLO from a machine we
  8073  (7413)                  % have never been told about has to be answerable without any
  8074  (7414)                  % configuration having happened first. Reading it from the magic
  8075  (7415)                  % means there is nothing to remember and nothing to go stale.
  8076  (7416)                  0 =: senderSystem
  8077  (7417)                  xmpfm2p(0, senderMagic, senderPortNo, senderSystem, &
  8078  (7418)                      senderRtInfo, senderExtra) =: returnStatus
  8079  (7419)  
  8080  (7420)                  % CLAMP BEFORE READING. nBytes is the sender's message size,
  8081  (7421)                  % handed back by XMSG - not a size this program chose. Passing
  8082  (7422)                  % it straight in lets any peer that sends more than inBufSize
  8083  (7423)                  % bytes write past the end of inBuf. That is a WRITE overflow
  8084  (7424)                  % and it happens before a single field is parsed, so none of
  8085  (7425)                  % the careful field checks in handleMessage can save it.
  8086  (7426)                  nBytes =: readAmount
  8087  (7427)                  IF readAmount > inBufSize THEN
  8088  (7428)                      inBufSize =: readAmount
  8089  (7429)                  ENDIF
  8090  (7430)  
  8091  (7431)                  xmpfrea(0, 0, &
  8092  (7432)                      ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  8093  (7433)                      0, readAmount, readLength) =: returnStatus
  8094  (7434)                  returnStatus =: readStatus
  8095  (7435)  
  8096  (7436)                  xmpfrel(0, msgIdent) =: returnStatus
  8097  (7437)  
  8098  (7438)                  % A 48-BYTE RAW DUMP OF EVERY ARRIVAL STOOD HERE, and it is the
  8099  (7439)                  % single diagnostic that solved this program. It is worth saying
  8100  (7440)                  % what it did before it goes, because the lesson outlives it.
  8101  (7441)                  %
  8102  (7442)                  % It began at 8 bytes and printed nothing useful for the arrival
  8103  (7443)                  % that mattered. Widened to 48 it showed the join in full:
  8104  (7444)                  %
  8105  (7445)                  %   123  65  0 12 | 255 10 'CHAT-LOBBY' | 1 5 'RONNY' 0 0
  8106  (7446)                  %
  8107  (7447)                  % Byte 0 was 123 - the SERIAL NUMBER this program's own client
  8108  (7448)                  % hands to XMPBLET. So what arrives starts with the XSLET LETTER
  8109  (7449)                  % HEADER, and handleMessage had been reading that header as if it
  8110  (7450)                  % were a chat message all along. The header skip below is the fix,
  8111  (7451)                  % and the layout under it is read off those bytes.
  8112  (7452)                  %
  8113  (7453)                  % The general form: a dump of what actually arrived beat every
  8114  (7454)                  % re-reading of the code, and it beat the manual too - the manual
  8115  (7455)                  % was right and was being applied to the wrong offset.
  8116  (7456)  
  8117  (7457)                  % A "fromSelf YES/no" line printed here. It earned its place once:
  8118  (7458)                  % the answer came back YES, the server's own reply arriving
  8119  (7459)                  % straight back at this port, which no amount of reading the guide
  8120  (7460)                  % would have suggested. That is recorded rather than printed now.
  8121  (7461)                  % THE SENDER'S MAGIC NUMBER AND OUR OWN were printed side by side
  8122  (7462)                  % here, to answer one suspicion: the welcome was being sent with
  8123  (7463)                  % status 0 and never arriving, so was senderMagic - taken from
  8124  (7464)                  % XMPFMST on a letter that came via XROUT - an address we could
  8125  (7465)                  % actually send BACK to?
  8126  (7466)                  %
  8127  (7467)                  % IT WAS. The two numbers were consistent and the reply address
  8128  (7468)                  % was never the bug. What that ruled out is what sent the search
  8129  (7469)                  % to the CLIENT's receive test, where XMPFRCV was returning XMOK,
  8130  (7470)                  % a "1..6 only" test was rejecting it, and the welcome was being
  8131  (7471)                  % dequeued and dropped in silence.
  8132  (7472)                  %
  8133  (7473)                  % A diagnostic that clears a suspicion is worth as much as one
  8134  (7474)                  % that confirms it, and this one cost a push-and-compile round
  8135  (7475)                  % trip to add. That is why it is written down instead of deleted.
  8136  (7476)  
  8137  (7477)                  % ---- A LETTER ARRIVES WEARING ITS XROUT HEADER --------------
  8138  (7478)                  % XROUT forwards THE WHOLE MESSAGE, header included. So a letter
  8139  (7479)                  % that came via XROUT has the XSLET header in front of the chat
  8140  (7480)                  % message, and the chat message has to be found behind it.
  8141  (7481)                  %
  8142  (7482)                  % ND-60.164.3 EN COSMOS Programmer Guide, appendix B, "XROUT
  8143  (7483)                  % Message Format", states the layout - this is read from the
  8144  (7484)                  % manual, not inferred from one capture:
  8145  (7485)                  %
  8146  (7486)                  %   byte 0     serial number, echoed back unchanged by XROUT
  8147  (7487)                  %   byte 1     the service number (XSLET = 65); XROUT overwrites
  8148  (7488)                  %              it with the return status on a reply
  8149  (7489)                  %   bytes 2-3  LENGTH OF THE REMAINDER OF THE MESSAGE in bytes,
  8150  (7490)                  %              "followed by a sequence of parameter blocks"
  8151  (7491)                  %
  8152  (7492)                  % So the parameter blocks occupy exactly the bytes that length
  8153  (7493)                  % counts, and OUR data starts right after them:
  8154  (7494)                  %
  8155  (7495)                  %   payloadAt = 4 + the length word
  8156  (7496)                  %
  8157  (7497)                  % The manual is explicit that the user data is untouched: "The
  8158  (7498)                  % remainder of the message will not be looked at by XROUT ... thus
  8159  (7499)                  % the user data can be coded in any format legible to the
  8160  (7500)                  % receiving (server) task."
  8161  (7501)                  %
  8162  (7502)                  % MEASURED 2026-08-18, the 25-byte join, which agrees:
  8163  (7503)                  %   123  65  0 12 | 255 10 'CHAT-LOBBY' | 1 5 'RONNY' 0 0
  8164  (7504)                  %    ^serial ^len=12   ^param 1: string, 10 bytes  ^payload at 16
  8165  (7505)                  %
  8166  (7506)                  % DERIVED, NEVER HARD-CODED. 16 is only right for a ten-character
  8167  (7507)                  % room name; the parameter block moves with the name, and a
  8168  (7508)                  % constant here would break the moment /join names a longer room.
  8169  (7509)                  %
  8170  (7510)                  % The alternative reading - 6 + the name length - fits this one
  8171  (7511)                  % capture just as well and is WRONG in general: it cannot see a
  8172  (7512)                  % second parameter block, and XSLET has an optional third.
  8173  (7513)                  %
  8174  (7514)                  % The payload is slid down to offset 0 so that handleMessage
  8175  (7515)                  % parses one layout and one only. Every other route into it -
  8176  (7516)                  % an ordinary XMTNO message straight from a magic number - has no
  8177  (7517)                  % header at all, and this is the single place that knows that.
  8178  (7518)                  % ---- A MESSAGE OF OURS THAT COULD NOT BE DELIVERED ----------
  8179  (7519)                  % This is what XFSEC bought, and it has to be caught BEFORE
  8180  (7520)                  % handleMessage: the bytes in inBuf are our own outgoing Said or
  8181  (7521)                  % Joined coming home, so parsing them as an arrival would have
  8182  (7522)                  % the room answering itself.
  8183  (7523)                  %
  8184  (7524)                  % THE QUESTION THIS BRANCH WAS BUILT TO ANSWER, AND THE ANSWER.
  8185  (7525)                  %
  8186  (7526)                  % A returned message carries what WE wrote, and what we wrote
  8187  (7527)                  % names the SPEAKER, not the member it could not reach - so it
  8188  (7528)                  % was not obvious that anything here identifies the destination.
  8189  (7529)                  % XMPFMST hands back a magic number for an ordinary arrival; the
  8190  (7530)                  % guide never says what that field holds on a returned one.
  8191  (7531)                  %
  8192  (7532)                  % MEASURED 2026-08-18 on D100, and it IS the destination:
  8193  (7533)                  %
  8194  (7534)                  %   SV: returned msg, st=  16915
  8195  (7535)                  %   SV: it names slot          2
  8196  (7536)                  %   SV: reaped dead slot       2
  8197  (7537)                  %
  8198  (7538)                  % 16915 is XMXEIMA, "Invalid magic number" - the reason the
  8199  (7539)                  % message came home. Note where that code turned up: as the
  8200  (7540)                  % REASON ON A RETURN, not as the status of the send. The first
  8201  (7541)                  % attempt at this fix tested XMPSEND's own status for exactly
  8202  (7542)                  % that number and never fired, because XMPSEND answered XMOK and
  8203  (7543)                  % handed the message to a port that was already gone.
  8204  (7544)                  %
  8205  (7545)                  % The slot print stays. It costs nothing - a member has to die
  8206  (7546)                  % before it runs - and it separates "one of ours bounced" from
  8207  (7547)                  % "something bounced", which is the first thing an operator
  8208  (7548)                  % needs to know and the one thing the reap line cannot say.
  8209  (7549)                  IF msgType = XMTRE THEN
  8210  (7550)                      nBounced + 1 =: nBounced
  8211  (7551)                      logLine('SV bounced msg st=', receiveStat)
  8212  (7552)  
  8213  (7553)                      findByMagic(senderMagic) =: wasMember
  8214  (7554)  
  8215  (7555)                      % PRINT ONLY WHEN IT IS ONE OF OURS. The note above says the
  8216  (7556)                      % point of this line is to separate "one of ours bounced"
  8217  (7557)                      % from "something bounced", and only the first is worth
  8218  (7558)                      % waking an operator for - it means a member has died. The
  8219  (7559)                      % other case is now just a number in STATUS, because it was
  8220  (7560)                      % arriving often enough to bury everything else.
  8221  (7561)                      IF wasMember >< 0 THEN
  8222  (7562)                          OUTPUT(1, 'AL22', 'SV: returned msg, st= ')
  8223  (7563)                          OUTPUT(1, 'I6', receiveStat)
  8224  (7564)                          OUTPUT(1, 'AL1', '$')
  8225  (7565)                          OUTPUT(1, 'AL22', 'SV: it names slot     ')
  8226  (7566)                          OUTPUT(1, 'I6', wasMember)
  8227  (7567)                          OUTPUT(1, 'AL1', '$')
  8228  (7568)                      ENDIF
  8229  (7569)  
  8230  (7570)                      IF wasMember >< 0 THEN
  8231  (7571)                          1 =: memberDead(wasMember)
  8232  (7572)                          1 =: deadFound
  8233  (7573)                      ENDIF
  8234  (7574)                  ELSE
  8235  (7575)                  IF msgType = XMROU THEN
  8236  (7576)                      % THE SERVICE BYTE, TAKEN BEFORE ANYTHING MOVES. The payload
  8237  (7577)                      % is slid down to offset 0 below, so by the time the seat
  8238  (7578)                      % rule runs inBuf(1) is chat data, not the header. Reading
  8239  (7579)                      % it there is how the feedback loop went unnoticed in
  8240  (7580)                      % review - the test looked right and was inspecting the
  8241  (7581)                      % wrong bytes.
  8242  (7582)                      inBuf(1) =: letterService
  8243  (7583)  
  8244  (7584)                      4 + inBuf(2) * 256 + inBuf(3) =: payloadAt
  8245  (7585)  
  8246  (7586)                      % A letter with nothing behind the header is a connect this
  8247  (7587)                      % program has no answer for. Dropping it says so; the seat is
  8248  (7588)                      % already spent either way. Note this is >=, not >: a payload
  8249  (7589)                      % that starts exactly AT the end is an empty payload.
  8250  (7590)                      IF payloadAt >= readLength THEN
  8251  (7591)                          % COUNTED, NOT PRINTED. This is an EXPECTED arrival, not
  8252  (7592)                          % a fault: XROUT's answer to a seat return comes back on
  8253  (7593)                          % this very port as a routed message with no payload, so
  8254  (7594)                          % there is one of these per seat returned. Printing it
  8255  (7595)                          % each time buried the terminal - STATUS reports the
  8256  (7596)                          % count, and a count that climbs while the room is quiet
  8257  (7597)                          % is the feedback loop described below coming back.
  8258  (7598)                          nEmptyLet + 1 =: nEmptyLet
  8259  (7599)                      ELSE
  8260  (7600)                          % (the seat for this arrival is settled after
  8261  (7601)                          %  handleMessage, by the one rule below)
  8262  (7602)                          readLength - payloadAt =: readLength
  8263  (7603)                          FOR i IN 1:readLength DO
  8264  (7604)                              inBuf(payloadAt + i - 1) =: inBuf(i - 1)
  8265  (7605)                          ENDFOR
  8266  (7606)  
  8267  (7607)                          % ---- SEAT ACCOUNTING, and it belongs HERE ----------
  8268  (7608)                          % The seat is spent by the ARRIVAL of a routed message,
  8269  (7609)                          % not by any particular kind of message inside it. Doing
  8270  (7610)                          % it per kind is what the C# side got wrong: a letter
  8271  (7611)                          % carrying anything but a join, or a letter too damaged
  8272  (7612)                          % to decode at all, never reaches a handler - so no
  8273  (7613)                          % handler can give its seat back, and the room silently
  8274  (7614)                          % loses a seat for good.
  8275  (7615)                          %
  8276  (7616)                          % XROUT decremented its free-connection counter to get
  8277  (7617)                          % this letter here, so a seat is already spent by the
  8278  (7618)                          % time this line runs. There are now exactly two places
  8279  (7619)                          % that give one back, and between them they cover both
  8280  (7620)                          % ways a member can stop being one:
  8281  (7621)                          %
  8282  (7622)                          %   handleMessage, kLeave   they said goodbye;
  8283  (7623)                          %   reapDead                they did not, and a send to
  8284  (7624)                          %                           them came back saying the
  8285  (7625)                          %                           port is gone.
  8286  (7626)                          findByMagic(senderMagic) =: wasMember
  8287  (7627)  
  8288  (7628)                          % THE POINT OF readStatus. A read that did not
  8289  (7629)                          % actually succeed has not put anything new in
  8290  (7630)                          % inBuf - what is there is whatever the LAST
  8291  (7631)                          % successful read left, and dispatching it again is
  8292  (7632)                          % how one real message would come back as every
  8293  (7633)                          % arrival after it.
  8294  (7634)                          IF readStatus = XMOK THEN
  8295  (7635)                              handleMessage
  8296  (7636)                          ENDIF
  8297  (7637)                      ENDIF
  8298  (7638)  
  8299  (7639)                      % ---- THE SEAT BELONGS TO THE ARRIVAL, SO SETTLE IT HERE ----
  8300  (7640)                      % MEASURED 2026-08-18 by a load run: twenty C# clients joined
  8301  (7641)                      % at once and CHAT-LOBBY went from 16 free seats to 2 and
  8302  (7642)                      % stayed there, even though every welcomed member left again
  8303  (7643)                      % cleanly. Fourteen seats gone.
  8304  (7644)                      %
  8305  (7645)                      % The comment a few lines up has described this hole all
  8306  (7646)                      % along - "a letter carrying anything but a join, or a letter
  8307  (7647)                      % too damaged to decode at all, never reaches a handler - so
  8308  (7648)                      % no handler can give its seat back" - and named it as
  8309  (7649)                      % something the C# side got wrong. It was wrong HERE too. The
  8310  (7650)                      % code only ever returned a seat on a clean /leave or a reap,
  8311  (7651)                      % so an empty letter, a join refused because the name was
  8312  (7652)                      % taken, and a letter from a stranger each cost a seat for
  8313  (7653)                      % good. Under a burst that is most of them.
  8314  (7654)                      %
  8315  (7655)                      % ONE RULE, APPLIED TO EVERY LETTER: XROUT spent a seat to
  8316  (7656)                      % deliver this, so if the sender is not sitting in the room
  8317  (7657)                      % once we have finished with it, nobody is holding that seat
  8318  (7658)                      % and it must go straight back.
  8319  (7659)                      %
  8320  (7660)                      % This does NOT double-count with the /leave and reapDead
  8321  (7661)                      % paths. A leave arrives as an ORDINARY message, port to
  8322  (7662)                      % port, and never comes through this branch at all - only the
  8323  (7663)                      % JOIN is a letter. So each member's seat is returned exactly
  8324  (7664)                      % once, by whichever of the three applies.
  8325  (7665)                      %
  8326  (7666)                      % KNOWN GAP, said plainly rather than left to be discovered:
  8327  (7667)                      % a letter from somebody who IS already a member keeps its
  8328  (7668)                      % seat and should not. Clients send port to port after
  8329  (7669)                      % joining, so it does not arise in normal use, and guessing a
  8330  (7670)                      % fix for a case never seen would be worse than naming it.
  8331  (7671)                      % ---- ONLY A REAL LETTER SPENT A SEAT --------------------
  8332  (7672)                      % MEASURED, and it is the worst kind of bug: a FEEDBACK
  8333  (7673)                      % LOOP that this very block created. Four users joined and
  8334  (7674)                      % left, and CHAT-LOBBY went from 16 free seats to 3470 while
  8335  (7675)                      % the terminal filled with "DROP empty letter" for ever.
  8336  (7676)                      %
  8337  (7677)                      % Here is the loop. Returning a seat means sending XMPINFC
  8338  (7678)                      % to XROUT. XROUT ANSWERS, and its answer arrives back on
  8339  (7679)                      % this very port as a routed message with no chat payload -
  8340  (7680)                      % which the code above drops as an empty letter, and which
  8341  (7681)                      % this rule then read as "a letter whose sender is not a
  8342  (7682)                      % member", so it returned ANOTHER seat, which produced
  8343  (7683)                      % ANOTHER answer. The note at the foot of this file has
  8344  (7684)                      % warned since the first version that the XMPINFC reply
  8345  (7685)                      % "comes back later on our own port as an ordinary message"
  8346  (7686)                      % and that ignoring it was "safe by accident until somebody
  8347  (7687)                      % says so". It stopped being safe the moment this rule
  8348  (7688)                      % started acting on every routed arrival.
  8349  (7689)                      %
  8350  (7690)                      % THE DISCRIMINATOR IS BYTE 1. A client's letter carries the
  8351  (7691)                      % XSLET service number, 65. XROUT OVERWRITES that byte with
  8352  (7692)                      % a return status when it answers - the header comment in
  8353  (7693)                      % the receive loop says so, and it is the same test the C#
  8354  (7694)                      % load client uses to spot a refused letter. So a letter
  8355  (7695)                      % with 65 in byte 1 came from a client and spent a seat;
  8356  (7696)                      % anything else is XROUT talking to us and spent nothing.
  8357  (7697)                      IF letterService = XSLET THEN
  8358  (7698)                          findByMagic(senderMagic) =: nowMember
  8359  (7699)                          IF nowMember = 0 THEN
  8360  (7700)                              xmpinfc(0, myPort, 1, 0) =: returnStatus
  8361  (7701)                              IF returnStatus >< XMOK THEN
  8362  (7702)                                  OUTPUT(1, 'AL22', 'SV: seat return failed')
  8363  (7703)                                  OUTPUT(1, 'I6', returnStatus)
  8364  (7704)                                  OUTPUT(1, 'AL1', '$')
  8365  (7705)                                  logLine('SV seat back st=  ', returnStatus)
  8366  (7706)                              ENDIF
  8367  (7707)                          ENDIF
  8368  (7708)                      ENDIF
  8369  (7709)                  ELSE
  8370  (7710)                      % No header on this path: an ordinary message sent straight
  8371  (7711)                      % to our magic number is exactly the bytes the peer wrote.
  8372  (7712)                      % Same readStatus guard as the routed path above - see the
  8373  (7713)                      % note there.
  8374  (7714)                      IF readStatus = XMOK THEN
  8375  (7715)                          handleMessage
  8376  (7716)                      ENDIF
  8377  (7717)                  ENDIF
  8378  (7718)                  ENDIF
  8379  (7719)  
  8380  (7720)                  % ---- AND NOW BURY ANYBODY WHO TURNED OUT TO BE GONE ---------
  8381  (7721)                  % One place, after everything the arrival caused has finished,
  8382  (7722)                  % because that is the only depth at which outBuf is free. Both
  8383  (7723)                  % branches above lead here on purpose: a member can be found
  8384  (7724)                  % dead by any broadcast, and the routed and direct paths both
  8385  (7725)                  % broadcast.
  8386  (7726)                  IF deadFound >< 0 THEN
  8387  (7727)                      reapDead
  8388  (7728)                  ENDIF
  8389  (7729)  
  8390  (7730)                  % ---- AND STOP, IF AN OPERATOR ASKED ------------------------
  8391  (7731)                  % Here rather than where the AdminStop arrived, so the reply
  8392  (7732)                  % path and the reaping above finish first. A stop that abandons
  8393  (7733)                  % a half-sent message is not a clean stop.
  8394  (7734)                  %
  8395  (7735)                  % This RETURN is different from the one on an empty drain. That
  8396  (7736)                  % one goes to sleep and is woken by the next arrival; this one
  8397  (7737)                  % ends the program for good - the ports go with it and SINTRAN
  8398  (7738)                  % clears the names, measured 2026-08-18.
  8399  (7739)                  IF stopWanted THEN
  8400  (7740)                      OUTPUT(1, 'AL17', 'CHATSV: stopping$')
  8401  (7741)                      RETURN
  8402  (7742)                  ENDIF
  8403  (7743)              ENDIF
  8404  (7744)          ENDDO
  8405  (7745)      ENDROUTINE
  8406  (7746)  
  8407  (7747)  ENDMODULE
  8408  (7748)  
  8409  (7749)  % ---------------------------------------------------------------------------
  8410  (7750)  % STILL NOT DONE, and worth saying rather than leaving to be met:
  8411  (7751)  %
  8412  (7752)  %  1. THIS ITEM USED TO READ "Nothing has been compiled", and it is kept here
  8413  (7753)  %     in corrected form rather than deleted, because everything it worried about
  8414  (7754)  %     has now been settled by the compiler itself rather than by argument:
  8415  (7755)  %     INTEGER4, two-dimensional BYTES ARRAY, the implicit extra ARRAY keyword on
  8416  (7756)  %     a BYTES declaration, BOOLEAN := TRUE, and the XMMSGIDENTIFIER and
  8417  (7757)  %     XMUSERADDRESS names out of XMP-B02:IMPT. All of it compiles and runs.
  8418  (7758)  %
  8419  (7759)  %     The one thing the list did NOT anticipate is the one that cost the most:
  8420  (7760)  %     a letter arrives with its XSLET header still in front of it. No amount of
  8421  (7761)  %     checking declarations against a manual would have found that - only the
  8422  (7762)  %     raw dump did.
  8423  (7763)  %
  8424  (7764)  %  2. The seat returned on Leave uses XMPINFC(flags, portNumber, extraConn,
  8425  (7765)  %     serialNumber). Its reply comes back later on our own port as an ordinary
  8426  (7766)  %     message, which handleMessage will see and not understand. Decide what to
  8427  (7767)  %     do with it - ignoring an unknown kind is already the behaviour, so this
  8428  (7768)  %     is safe, but it is safe by accident until somebody says so.
  8429  (7769)  %
  8430  (7770)  %  3. Each reason string carries its length as a separate constant, because
  8431  (7771)  %     PLANC has no LENGTH routine and SIZE's meaning for a BYTES parameter is
  8432  (7772)  %     not established. A string and its number must be changed together.
  8433  (7773)  % ---------------------------------------------------------------------------
  8434  (7774)  