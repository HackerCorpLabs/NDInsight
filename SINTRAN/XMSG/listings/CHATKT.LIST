   362   (324)  CONSTANT XRXXX=16960   % Base for XROUT errors: 41100B
   363   (325)  CONSTANT XRSOK=0       % OK - not an error!
   364   (326)  CONSTANT XRISN=1       % Illegal service number
   365   (327)  CONSTANT XRUNN=2       % Unknown name (of server or system)
   366   (328)  CONSTANT XRDDF=3       % Another port already has this name
   367   (329)  CONSTANT XRNSP=4       % No space left for names
   368   (330)  CONSTANT XRIPT=5       % Illegal parameter type
   369   (331)  CONSTANT XRMMP=6       % Missing mandatory parameter
