   700    (40)  
   701    (41)      INTEGER ARRAY : stack(0:1000)
   702    (42)  
   703    (43)      % outB and inB are TWO DIFFERENT ARRAYS on purpose - two subarrays of
   704    (44)      % one array passed around corrupts both and compiles clean.
   705    (45)      BYTES : outB(0:255)
   706    (46)      BYTES : inB(0:255)
   707    (47)  
   708    (48)      % The letters the messages are filled with, indexed 0..5, and one
   709    (49)      % scrub byte. inB is filled with 'Z' before every receive so a short
   710    (50)      % or failed read cannot fake a pass off what the LAST read left.
   711    (51)      BYTES : abc := 'ABCDEF'
   712    (52)      BYTES : zByte := 'Z'
   713    (53)  
   714    (54)      INTEGER : myPort
   715    (55)      INTEGER4 : myMagic
   716    (56)      INTEGER : sendFlags
   717    (57)  
   718    (58)      % One module-level home per status, so a failure can name the call
   719    (59)      % that failed. returnStatus-style sharing is exactly what hid the
   720    (60)      % client's read status until 2026-09-01.
   721    (61)      INTEGER : getSt, wriSt, sndSt, rcvSt, reaSt, relSt
   722    (62)      INTEGER : msgType
   723    (63)      INTEGER : remotePortHash
   724    (64)      INTEGER : nBytes
   725    (65)      INTEGER : readAmount
   726    (66)      INTEGER : readLength
   727    (67)      INTEGER : writtenLength
   728    (68)      XMMSGIDENTIFIER : rcvIdent
   729    (69)  
   730    (70)      INTEGER : passed := 0
   731    (71)      INTEGER : failed := 0
   732    (72)  
   733    (73)      ROUTINE VOID, VOID (BYTES, INTEGER, INTEGER) : check(what, got, want)
   734    (74)          IF got = want THEN
   735    (75)              passed + 1 =: passed
   736    (76)              OUTPUT(1, 'AL', 'PASS ')
   737    (77)              OUTPUT(1, 'AL', what)
   738    (78)              OUTPUT(1, 'AL', '$')
   739    (79)              RETURN
   740    (80)          ENDIF
   741    (81)          failed + 1 =: failed
   742    (82)          OUTPUT(1, 'AL', 'FAIL ')
   743    (83)          OUTPUT(1, 'AL', what)
   744    (84)          OUTPUT(1, 'AL', '  got ')
   745    (85)          OUTPUT(1, 'I', got)
   746    (86)          OUTPUT(1, 'AL', '  want ')
   747    (87)          OUTPUT(1, 'I', want)
   748    (88)          OUTPUT(1, 'AL', '$')
   749    (89)      ENDROUTINE
   750    (90)  
   751    (91)      % Fill the first `count` bytes of outB with letter abc(k).
   752    (92)      ROUTINE VOID, VOID (INTEGER, INTEGER) : fillOut(k, count)
   753    (93)          INTEGER : i
   754    (94)          FOR i IN 0:count - 1 DO
   755    (95)              abc(k) =: outB(i)
   756    (96)          ENDFOR
   757    (97)      ENDROUTINE
   758    (98)  
   759    (99)      % Scrub inB so nothing from the previous read can survive into the
   760   (100)      % next check.
   761   (101)      ROUTINE VOID, VOID : scrubIn
   762   (102)          INTEGER : i
   763   (103)          FOR i IN 0:255 DO
   764   (104)              zByte(0) =: inB(i)
   765   (105)          ENDFOR
   766   (106)      ENDROUTINE
   767   (107)  
   768   (108)      % -------------------------------------------------------------------
   769   (109)      % THE SERVER'S SEND, verbatim from CHATSV.PLNC sendTo: get a fresh
   770   (110)      % buffer, write with NO message identifier (the current-message form),
   771   (111)      % send the identifier xmpfget handed back, secure. If xmpfwri writes
   772   (112)      % anywhere but that fresh buffer, what arrives is not what was built -
   773   (113)      % and only this test can tell, because sendTo checks STATUSES, and a
   774   (114)      % write into the wrong buffer succeeds.
   775   (115)      % -------------------------------------------------------------------
   776   (116)      ROUTINE VOID, VOID (INTEGER) : sendLikeSv(length)
   777   (117)          XMMSGIDENTIFIER : ident
   778   (118)          xmpfget(0, length, ident) =: getSt
   779   (119)          xmpfwri(0, 0, &
   780   (120)              ADDR(outB(0)) FORCE XMUSERADDRESS, &
   781   (121)              0, length, writtenLength) =: wriSt
   782   (122)          xmpsend(sendFlags, ident, myPort, myMagic) =: sndSt
   783   (123)      ENDROUTINE
   784   (124)  
   785   (125)      % -------------------------------------------------------------------
   786   (126)      % THE CLIENT'S RECEIVE, verbatim from CHAT.PLNC drainPort: receive,
   787   (127)      % clamp the kernel's length before trusting it, read with NO message
   788   (128)      % identifier, release. hold=1 skips the release so a caller can keep
   789   (129)      % the arrival current - which is what a server is doing the whole time
   790   (130)      % it handles a message.
   791   (131)      % -------------------------------------------------------------------
   792   (132)      ROUTINE VOID, VOID (INTEGER) : recvLikeCl(hold)
   793   (133)          scrubIn
   794   (134)          xmpfrcv(0, myPort, msgType, remotePortHash, rcvIdent, nBytes) &
   795   (135)              =: rcvSt
   796   (136)          nBytes =: readAmount
   797   (137)          IF readAmount > 256 THEN
   798   (138)              256 =: readAmount
   799   (139)          ENDIF
   800   (140)          xmpfrea(0, 0, &
   801   (141)              ADDR(inB(0)) FORCE XMUSERADDRESS, &
   802   (142)              0, readAmount, readLength) =: reaSt
   803   (143)          IF hold = 0 THEN
   804   (144)              xmpfrel(0, rcvIdent) =: relSt
   805   (145)          ENDIF
   806   (146)      ENDROUTINE
   807   (147)  
   808   (148)      % xmpfrcv answers XMOK *or* a message type 1..6 - both are success,
   809   (149)      % and a 1..6-only test once threw every welcome away. Normalise to 0.
   810   (150)      ROUTINE VOID, INTEGER : rcvOk
   811   (151)          IF rcvSt = XMOK THEN
   812   (152)              0 RETURN
   813   (153)          ENDIF
   814   (154)          IF rcvSt >= 1 AND rcvSt <= 6 THEN
   815   (155)              0 RETURN
   816   (156)          ENDIF
   817   (157)          rcvSt RETURN
   818   (158)      ENDROUTINE
   819   (159)  
   820   (160)      % One received message, checked whole: statuses, length, first and
   821   (161)      % last byte. gotFirst/gotLast go through INTEGER locals because a
   822   (162)      % BYTE element handed straight to check's INTEGER parameter is the
   823   (163)      % kind of conversion this project does not gamble on.
   824   (164)      %
   825   (165)      % The literal comes LAST so the linter's hand-counted-length check
   826   (166)      % (R121) does not read the letter index beside it as a length.
   827   (167)      ROUTINE VOID, VOID (INTEGER, INTEGER, BYTES) : checkMsg(k, length, what)
   828   (168)          INTEGER : gotFirst, gotLast, wantByte
   829   (169)          OUTPUT(1, 'AL', '-- ')
   830   (170)          OUTPUT(1, 'AL', what)
   831   (171)          OUTPUT(1, 'AL', '$')
   832   (172)          check('  rcv status ok', rcvOk, 0)
   833   (173)          check('  rea status ok', reaSt, XMOK)
   834   (174)          check('  length as sent', nBytes, length)
   835   (175)          inB(0) =: gotFirst
   836   (176)          inB(length - 1) =: gotLast
   837   (177)          abc(k) =: wantByte
   838   (178)          check('  first byte', gotFirst, wantByte)
   839   (179)          check('  last byte ', gotLast, wantByte)
   840   (180)      ENDROUTINE
   841   (181)  
   842   (182)      PROGRAM : chatKTest
   843   (183)          INTEGER : st
   844   (184)  
   845   (185)          INISTACK stack
   846   (186)  
   847   (187)          OUTPUT(1, 'AL', 'CHATKT - the kernel send/receive path, by loopback$')
   848   (188)  
   849   (189)          % Secure, exactly as the product sends - on receive a secure
   850   (190)          % message becomes PORT current as well as task current, and the
   851   (191)          % live system runs entirely on secure sends.
   852   (192)          2**XFSEC =: sendFlags
   853   (193)  
   854   (194)          xmpfopn(0, myPort) =: st
   855   (195)          check('open port', st, XMOK)
   856   (196)          xmpfp2m(0, myPort, myMagic) =: st
   857   (197)          check('own magic', st, XMOK)
   858   (198)  
   859   (199)          % ---- PHASE 1: three sequential round trips, distinct letter and
   860   (200)          % ---- length each. The quiet case: nothing else is current when
   861   (201)          % ---- the send is built. If THIS repeats, the whole product model
   862   (202)          % ---- is wrong, not just the busy case.
   863   (203)          OUTPUT(1, 'AL', '$')
   864   (204)          OUTPUT(1, 'AL', 'phase 1 - sequential, port quiet$')
   865   (205)  
   866   (206)          fillOut(0, 20)
   867   (207)          sendLikeSv(20)
   868   (208)          check('p1 A get', getSt, XMOK)
   869   (209)          check('p1 A wri', wriSt, XMOK)
   870   (210)          check('p1 A snd', sndSt, XMOK)
   871   (211)          recvLikeCl(0)
   872   (212)          checkMsg(0, 20, 'p1 msg A len 20')
   873   (213)  
   874   (214)          fillOut(1, 24)
   875   (215)          sendLikeSv(24)
   876   (216)          recvLikeCl(0)
   877   (217)          checkMsg(1, 24, 'p1 msg B len 24')
   878   (218)  
   879   (219)          fillOut(2, 28)
   880   (220)          sendLikeSv(28)
   881   (221)          recvLikeCl(0)
   882   (222)          checkMsg(2, 28, 'p1 msg C len 28')
   883   (223)  
   884   (224)          % ---- PHASE 2: two messages QUEUED before either is read. The
   885   (225)          % ---- second send is built while the first sits unreceived on the
   886   (226)          % ---- port - the shape of a busy room.
   887   (227)          OUTPUT(1, 'AL', '$')
   888   (228)          OUTPUT(1, 'AL', 'phase 2 - two queued before reading$')
   889   (229)  
   890   (230)          fillOut(3, 32)
   891   (231)          sendLikeSv(32)
   892   (232)          fillOut(4, 36)
   893   (233)          sendLikeSv(36)
   894   (234)          recvLikeCl(0)
   895   (235)          checkMsg(3, 32, 'p2 first out is D len 32')
   896   (236)          recvLikeCl(0)
   897   (237)          checkMsg(4, 36, 'p2 second out is E len 36')
   898   (238)  
   899   (239)          % ---- PHASE 3: THE SERVER'S REAL SITUATION. A message is received
   900   (240)          % ---- and HELD (task current, and - secure - port current) while
   901   (241)          % ---- replies are built and sent, exactly like a server that has
   902   (242)          % ---- not yet released the arrival it is answering, or any task
   903   (243)          % ---- whose release did not clear the current-message pointers.
   904   (244)          % ---- If xmpfwri prefers the held arrival over the fresh buffer,
   905   (245)          % ---- what arrives below is F's content (or rubbish), not A's -
   906   (246)          % ---- and the repeat-first-message bug is reproduced offline.
   907   (247)          OUTPUT(1, 'AL', '$')
   908   (248)          OUTPUT(1, 'AL', 'phase 3 - reply built while an arrival is HELD$')
   909   (249)  
   910   (250)          fillOut(5, 40)
   911   (251)          sendLikeSv(40)
   912   (252)          recvLikeCl(1)
   913   (253)          checkMsg(5, 40, 'p3 arrival F len 40 held')
   914   (254)  
   915   (255)          % Two replies while F is still held - a broadcast to two seats.
   916   (256)          fillOut(0, 44)
   917   (257)          sendLikeSv(44)
   918   (258)          check('p3 reply A get', getSt, XMOK)
   919   (259)          check('p3 reply A wri', wriSt, XMOK)
   920   (260)          check('p3 reply A snd', sndSt, XMOK)
   921   (261)          fillOut(1, 48)
   922   (262)          sendLikeSv(48)
   923   (263)  
   924   (264)          % Now let go of F, the way the server releases after handling.
   925   (265)          xmpfrel(0, rcvIdent) =: relSt
   926   (266)          check('p3 release F', relSt, XMOK)
   927   (267)  
   928   (268)          recvLikeCl(0)
   929   (269)          checkMsg(0, 44, 'p3 reply A len 44 intact')
   930   (270)          recvLikeCl(0)
   931   (271)          checkMsg(1, 48, 'p3 reply B len 48 intact')
   932   (272)  
   933   (273)          xmpfcls(0, myPort) =: st
   934   (274)  
   935   (275)          OUTPUT(1, 'AL', '$')
   936   (276)          OUTPUT(1, 'AL', 'passed ')
   937   (277)          OUTPUT(1, 'I', passed)
   938   (278)          OUTPUT(1, 'AL', '  failed ')
   939   (279)          OUTPUT(1, 'I', failed)
   940   (280)          OUTPUT(1, 'AL', '$')
   941   (281)          IF failed = 0 THEN
   942   (282)              OUTPUT(1, 'AL', 'kernel path is good - the bug is elsewhere$')
   943   (283)          ELSE
   944   (284)              OUTPUT(1, 'AL', 'KERNEL PATH MISBEHAVES - read which phase$')
   945   (285)          ENDIF
   946   (286)      ENDROUTINE
   947   (287)  ENDMODULE
   948   (288)  