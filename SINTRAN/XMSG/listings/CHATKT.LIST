   377   (339)  CONSTANT XRNEI=14      % Cannot define route to a neighbour
   378   (340)  CONSTANT XRNXM=15      % Invalid service request - no intersystem XMSG
   379   (341)  CONSTANT XRILN=16      % Illegal/Reserved Log. unit no. for link
   380   (342)  CONSTANT XRNXL=17      % No more XL-Blocks (Link Descriptors)
   381   (343)  CONSTANT XRNXD=18      % Not enough XD-Blocks for LKINI
   382   (344)  CONSTANT XRNTR=19      % No trace generated
   383   (345)  CONSTANT XRTRA=20      % Trace already active
   384   (346)  CONSTANT XRTRP=21      % Trace passive
   385   (347)  CONSTANT XRTFE=22      % Trace/dump file open error (see param 1)
   386   (348)  CONSTANT XRTRT=23      % Trace RT-prog (XTRACE) not found
   387   (349)  CONSTANT XRTIS=24      % Illegal trace system number
   388   (350)  CONSTANT XRBLK=25      % Bad link - open unsuccessful
   389   (351)  CONSTANT XRSYD=26      % Local system number already defined
   390   (352)  CONSTANT XRNLS=27      % No local system number defined yet
   391   (353)  CONSTANT XRTRE=28      % Too many remote names to this system
   392   (354)  CONSTANT XRRNA=29      % Old service calls (<64) cannot go remote
   393   (355)  CONSTANT XRBUS=30      % Service busy - try later!
   394   (356)  CONSTANT XRNSE=31      % This is not a service port
   395   (357)  CONSTANT XRRPN=32      % Remote port statically declared
   396   (358)  CONSTANT XRUKS=33      % Unknown remote system name
   397   (359)  CONSTANT XRMFL=34      % Not enough message table space in remote system
   398   (360)  CONSTANT XRROV=35      % Remote task space overflow when forwarding
   399   (361)  CONSTANT XRRFU=36      % Routing table space full (too many systems def.)
   400   (362)  CONSTANT XRNRB=37      % No remote batch service available here
   401   (363)  CONSTANT XRURT=38      % Unknown RT program name
   402   (364)  CONSTANT XRSNR=39      % This server is not running
   403   (365)  CONSTANT XRRND=40      % Netserver: remote system is not defined
   404   (366)  CONSTANT XRNNA=41      % Netserver: network not available
   405   (367)  CONSTANT XRISE=42      % Netserver: internal server error
   406   (368)  CONSTANT XRIRQ=43      % Netserver: invalid request
   407   (369)  CONSTANT XRNGA=44      % XMSG not congfigurated with gateway code
   408   (370)  CONSTANT XRRNL=45      % Remote system not on same LAN
   409   (371)  CONSTANT XRNCO=46      % No connection to this system (unknown status)
   410   (372)  CONSTANT XRAMB=47      % Ambiguous name
   411   (373)  CONSTANT XRFFU=48      % Friend system table full (too many friends)
   412   (374)  
   413   (375)  %-----------------------------------------------------------------------------%
   414   (376)  %                                                                             %
   415   (377)  %         X R O U T  /  F I L E   S E R V E R   -    E R R O R S              %
   416   (378)  %                                                                             %
   417   (379)  %                             A S                                             %
   418   (380)  %                                                                             %
   419   (381)  %                  S T A N D A R D   V A L U E S                              %
   420   (382)  %                                                                             %
   421   (383)  %             These are returned by the PLANC XMSG library                    %
   422   (384)  %             when the routine involves an XROUT service.                     %
   423   (385)  %                                                                             %
   424   (386)  %                 base value = XRXXX = 16960 = 41100B                         %
   425   (387)  %                                                                             %
   426   (388)  %-----------------------------------------------------------------------------%
   427   (389)  
   428   (390)  CONSTANT XMXRXXX= 16960      % BASE for STANDARD ERROR system
   429   (391)  
   430   (392)  CONSTANT XMXRISN= 16961      % Illegal service number
   431   (393)  CONSTANT XMXRUNN= 16962      % Unknown name (of server or system)
   432   (394)  CONSTANT XMXRDDF= 16963      % Another port already has this name
   433   (395)  CONSTANT XMXRNSP= 16964      % No space left for names
   434   (396)  CONSTANT XMXRIPT= 16965      % Illegal parameter type
   435   (397)  CONSTANT XMXRMMP= 16966      % Missing mandatory parameter
   436   (398)  CONSTANT XMXRUNM= 16967      % Unknown magic number
   437   (399)  CONSTANT XMXRMTL= 16968      % Too short message (or message buffer)
   438   (400)  CONSTANT XMXRSMF= 16969      % Standard message format not handled
   439   (401)  CONSTANT XMXRPRV= 16970      % Caller was not privileged
   440   (402)  CONSTANT XMXRISY= 16971      % Illegal system number parameter
   441   (403)  CONSTANT XMXRNRO= 16972      % No access to remote system
   442   (404)  CONSTANT XMXRIIV= 16973      % Illegal integer value
   443   (405)  CONSTANT XMXRNEI= 16974      % Cannot define route to a neighbour
   444   (406)  CONSTANT XMXRNXM= 16975      % Invalid service request - no intersystem XMSG
   445   (407)  CONSTANT XMXRILN= 16976      % Illegal/Reserved Log. unit no. for link
   446   (408)  CONSTANT XMXRNXL= 16977      % No more XL-Blocks (Link Descriptors)
   447   (409)  CONSTANT XMXRNXD= 16978      % Not enough XD-Blocks for LKINI
   448   (410)  CONSTANT XMXRNTR= 16979      % No trace generated
   449   (411)  CONSTANT XMXRTRA= 16980      % Trace already active
   450   (412)  CONSTANT XMXRTRP= 16981      % Trace passive
   451   (413)  CONSTANT XMXRTFE= 16982      % Trace/dump file open error (see param 1)
   452   (414)  CONSTANT XMXRTRT= 16983      % Trace RT-prog (XTRACE) not found
   453   (415)  CONSTANT XMXRTIS= 16984      % Illegal trace system number
   454   (416)  CONSTANT XMXRBLK= 16985      % Bad link - open unsuccessful
   455   (417)  CONSTANT XMXRSYD= 16986      % Local system number already defined
   456   (418)  CONSTANT XMXRNLS= 16987      % No local system number defined yet
   457   (419)  CONSTANT XMXRTRE= 16988      % Too many remote names to this system
   458   (420)  CONSTANT XMXRRNA= 16989      % Old service calls (<64) cannot go remote
   459   (421)  CONSTANT XMXRBUS= 16990      % Service busy - try later!
   460   (422)  CONSTANT XMXRNSE= 16991      % This is not a service port
   461   (423)  CONSTANT XMXRRPN= 16992      % Remote port statically declared
   462   (424)  CONSTANT XMXRUKS= 16993      % Unknown remote system name
   463   (425)  CONSTANT XMXRMFL= 16994      % Not enough message table space in remote system
   464   (426)  CONSTANT XMXRROV= 16995      % Remote task space overflow when forwarding
   465   (427)  CONSTANT XMXRRFU= 16996      % Routing table space full (too many systems def.)
   466   (428)  CONSTANT XMXRNRB= 16997      % No remote batch service available here
   467   (429)  CONSTANT XMXRURT= 16998      % Unknown RT-program name
   468   (430)  CONSTANT XMXRSNR= 16999      % this server is not running
   469   (431)  CONSTANT XMXRRND= 17000      % Netserver: remote system is not defined
   470   (432)  CONSTANT XMXRNNA= 17001      % Netserver: network not available
   471   (433)  CONSTANT XMXRISE= 17002      % Netserver: internal server error
   472   (434)  CONSTANT XMXRIRQ= 17003      % Netserver: invalid request
   473   (435)  CONSTANT XMXRNGA= 17004      % XMSG not configured with gateway code
   474   (436)  CONSTANT XMXRRNL= 17005      % remote system not on same LAN
   475   (437)  CONSTANT XMXRNCO= 17006      % no connection to this system(unknown status)
   476   (438)  CONSTANT XMXRAMB= 17007      % ambiguous name
   477   (439)  CONSTANT XMXRFFU= 17008      % friend system table full (too many friends)
   478   (440)  
   479   (441)  %-----------------------------------------------------------------------------%
   480   (442)  %                                                                             %
   481   (443)  %                    format of XROUT messages                                 %
   482   (444)  %                                                                             %
   483   (445)  %-----------------------------------------------------------------------------%
   484   (446)  
   485   (447)  %
   486   (448)  % maximum XMSG name length
   487   (449)  %
   488   (450)  CONSTANT XMMAXNameLength = 32          % actually installation-dependent!
   489   (451)  
   490   (452)  
   491   (453)                                         % XROUT header format
   492   (454)  TYPE XROUTHDR = RECORD PACK            % base record for variants
   493   (455)         BYTE: XRSerialNumber            % serial number for user's use
   494   (456)         BYTE: XRServiceNumber           % code for required service which is
   495   (457)         BYTE: XRStatus = XRServiceNumber% replaced with XROUT status code
   496   (458)         INTEGER2: XRBufferLength = XRServiceNumber % overlay for append routines
   497   (459)         INTEGER2: XRLengthMsg           % total length of following parameters
   498   (460)  ENDRECORD
   499   (461)                                         % parameter formats
   500   (462)  TYPE XROUTPARAMHDR = RECORD PACK       % base record for parameter variants
   501   (463)         BYTE: XRPCode                   % parameter code
   502   (464)         BYTE: XRPLength                 % parameter length
   503   (465)  ENDRECORD
   504   (466)  TYPE XROUTSTRING = XROUTPARAMHDR RECORD PACKED % string parameter format
   505   (467)         BYTES: XRPString(0:XMMAXNameLength-1)   % MAXIMUM length shown
   506   (468)  ENDRECORD
   507   (469)  TYPE XROUTINTEGER = XROUTPARAMHDR RECORD PACKED % integer parameter format
   508   (470)         INTEGER2: XRPInteger
   509   (471)  ENDRECORD
   510   (472)  TYPE XROUTDOUBLE = XROUTPARAMHDR RECORD PACKED % integer4 parameter format
   511   (473)         INTEGER4: XRPDouble
   512   (474)  ENDRECORD
   513   (475)  
   514   (476)  %-----------------------------------------------------------------------------%
   515   (477)  $EOF
