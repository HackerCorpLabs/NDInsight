   387   (312)  %          X R O U T  /  F I L E   S E R V E R   -    E R R O R S             %
   388   (313)  %                                                                             %
   389   (314)  %             Error values returned in byte 1 of return message               %
   390   (315)  %                                                                             %
   391   (316)  %                                                                             %
   392   (317)  %      These are the values in the message header itself which the            %
   393   (318)  %      user sees when the XROUT header is manipulated directly by the         %
   394   (319)  %      user.                                                                  %
   395   (320)  %      The PLANC XMSG library returns the STANDARD values (see later)         %
   396   (321)  %                                                                             %
   397   (322)  %-----------------------------------------------------------------------------%
   398   (323)  
   399   (324)  CONSTANT XRXXX=16960   % Base for XROUT errors: 41100B
   400   (325)  CONSTANT XRSOK=0       % OK - not an error!
   401   (326)  CONSTANT XRISN=1       % Illegal service number
   402   (327)  CONSTANT XRUNN=2       % Unknown name (of server or system)
   403   (328)  CONSTANT XRDDF=3       % Another port already has this name
   404   (329)  CONSTANT XRNSP=4       % No space left for names
   405   (330)  CONSTANT XRIPT=5       % Illegal parameter type
   406   (331)  CONSTANT XRMMP=6       % Missing mandatory parameter
   407   (332)  CONSTANT XRUNM=7       % Unknown magic number
   408   (333)  CONSTANT XRMTL=8       % Too short message (or message buffer)
   409   (334)  CONSTANT XRSMF=9       % Standard message format not handled
   410   (335)  CONSTANT XRPRV=10      % Caller was not privileged
   411   (336)  CONSTANT XRISY=11      % Illegal system number parameter
   412   (337)  CONSTANT XRNRO=12      % No access to remote system
   413   (338)  CONSTANT XRIIV=13      % Illegal integer value
   414   (339)  CONSTANT XRNEI=14      % Cannot define route to a neighbour
   415   (340)  CONSTANT XRNXM=15      % Invalid service request - no intersystem XMSG
   416   (341)  CONSTANT XRILN=16      % Illegal/Reserved Log. unit no. for link
   417   (342)  CONSTANT XRNXL=17      % No more XL-Blocks (Link Descriptors)
   418   (343)  CONSTANT XRNXD=18      % Not enough XD-Blocks for LKINI
   419   (344)  CONSTANT XRNTR=19      % No trace generated
   420   (345)  CONSTANT XRTRA=20      % Trace already active
   421   (346)  CONSTANT XRTRP=21      % Trace passive
   422   (347)  CONSTANT XRTFE=22      % Trace/dump file open error (see param 1)
   423   (348)  CONSTANT XRTRT=23      % Trace RT-prog (XTRACE) not found
   424   (349)  CONSTANT XRTIS=24      % Illegal trace system number
   425   (350)  CONSTANT XRBLK=25      % Bad link - open unsuccessful
   426   (351)  CONSTANT XRSYD=26      % Local system number already defined
   427   (352)  CONSTANT XRNLS=27      % No local system number defined yet
   428   (353)  CONSTANT XRTRE=28      % Too many remote names to this system
   429   (354)  CONSTANT XRRNA=29      % Old service calls (<64) cannot go remote
   430   (355)  CONSTANT XRBUS=30      % Service busy - try later!
   431   (356)  CONSTANT XRNSE=31      % This is not a service port
   432   (357)  CONSTANT XRRPN=32      % Remote port statically declared
   433   (358)  CONSTANT XRUKS=33      % Unknown remote system name
   434   (359)  CONSTANT XRMFL=34      % Not enough message table space in remote system
   435   (360)  CONSTANT XRROV=35      % Remote task space overflow when forwarding
   436   (361)  CONSTANT XRRFU=36      % Routing table space full (too many systems def.)
   437   (362)  CONSTANT XRNRB=37      % No remote batch service available here
   438   (363)  CONSTANT XRURT=38      % Unknown RT program name
   439   (364)  CONSTANT XRSNR=39      % This server is not running
   440   (365)  CONSTANT XRRND=40      % Netserver: remote system is not defined
   441   (366)  CONSTANT XRNNA=41      % Netserver: network not available
   442   (367)  CONSTANT XRISE=42      % Netserver: internal server error
   443   (368)  CONSTANT XRIRQ=43      % Netserver: invalid request
   444   (369)  CONSTANT XRNGA=44      % XMSG not congfigurated with gateway code
   445   (370)  CONSTANT XRRNL=45      % Remote system not on same LAN
   446   (371)  CONSTANT XRNCO=46      % No connection to this system (unknown status)
   447   (372)  CONSTANT XRAMB=47      % Ambiguous name
   448   (373)  CONSTANT XRFFU=48      % Friend system table full (too many friends)
   449   (374)  
   450   (375)  %-----------------------------------------------------------------------------%
   451   (376)  %                                                                             %
   452   (377)  %         X R O U T  /  F I L E   S E R V E R   -    E R R O R S              %
   453   (378)  %                                                                             %
   454   (379)  %                             A S                                             %
   455   (380)  %                                                                             %
   456   (381)  %                  S T A N D A R D   V A L U E S                              %
   457   (382)  %                                                                             %
   458   (383)  %             These are returned by the PLANC XMSG library                    %
   459   (384)  %             when the routine involves an XROUT service.                     %
   460   (385)  %                                                                             %
   461   (386)  %                 base value = XRXXX = 16960 = 41100B                         %
   462   (387)  %                                                                             %
   463   (388)  %-----------------------------------------------------------------------------%
   464   (389)  
   465   (390)  CONSTANT XMXRXXX= 16960      % BASE for STANDARD ERROR system
   466   (391)  
   467   (392)  CONSTANT XMXRISN= 16961      % Illegal service number
   468   (393)  CONSTANT XMXRUNN= 16962      % Unknown name (of server or system)
   469   (394)  CONSTANT XMXRDDF= 16963      % Another port already has this name
   470   (395)  CONSTANT XMXRNSP= 16964      % No space left for names
   471   (396)  CONSTANT XMXRIPT= 16965      % Illegal parameter type
   472   (397)  CONSTANT XMXRMMP= 16966      % Missing mandatory parameter
   473   (398)  CONSTANT XMXRUNM= 16967      % Unknown magic number
   474   (399)  CONSTANT XMXRMTL= 16968      % Too short message (or message buffer)
   475   (400)  CONSTANT XMXRSMF= 16969      % Standard message format not handled
   476   (401)  CONSTANT XMXRPRV= 16970      % Caller was not privileged
   477   (402)  CONSTANT XMXRISY= 16971      % Illegal system number parameter
   478   (403)  CONSTANT XMXRNRO= 16972      % No access to remote system
   479   (404)  CONSTANT XMXRIIV= 16973      % Illegal integer value
   480   (405)  CONSTANT XMXRNEI= 16974      % Cannot define route to a neighbour
   481   (406)  CONSTANT XMXRNXM= 16975      % Invalid service request - no intersystem XMSG
   482   (407)  CONSTANT XMXRILN= 16976      % Illegal/Reserved Log. unit no. for link
   483   (408)  CONSTANT XMXRNXL= 16977      % No more XL-Blocks (Link Descriptors)
   484   (409)  CONSTANT XMXRNXD= 16978      % Not enough XD-Blocks for LKINI
   485   (410)  CONSTANT XMXRNTR= 16979      % No trace generated
   486   (411)  CONSTANT XMXRTRA= 16980      % Trace already active
   487   (412)  CONSTANT XMXRTRP= 16981      % Trace passive
   488   (413)  CONSTANT XMXRTFE= 16982      % Trace/dump file open error (see param 1)
   489   (414)  CONSTANT XMXRTRT= 16983      % Trace RT-prog (XTRACE) not found
   490   (415)  CONSTANT XMXRTIS= 16984      % Illegal trace system number
   491   (416)  CONSTANT XMXRBLK= 16985      % Bad link - open unsuccessful
   492   (417)  CONSTANT XMXRSYD= 16986      % Local system number already defined
   493   (418)  CONSTANT XMXRNLS= 16987      % No local system number defined yet
   494   (419)  CONSTANT XMXRTRE= 16988      % Too many remote names to this system
   495   (420)  CONSTANT XMXRRNA= 16989      % Old service calls (<64) cannot go remote
   496   (421)  CONSTANT XMXRBUS= 16990      % Service busy - try later!
   497   (422)  CONSTANT XMXRNSE= 16991      % This is not a service port
   498   (423)  CONSTANT XMXRRPN= 16992      % Remote port statically declared
   499   (424)  CONSTANT XMXRUKS= 16993      % Unknown remote system name
   500   (425)  CONSTANT XMXRMFL= 16994      % Not enough message table space in remote system
   501   (426)  CONSTANT XMXRROV= 16995      % Remote task space overflow when forwarding
   502   (427)  CONSTANT XMXRRFU= 16996      % Routing table space full (too many systems def.)
   503   (428)  CONSTANT XMXRNRB= 16997      % No remote batch service available here
   504   (429)  CONSTANT XMXRURT= 16998      % Unknown RT-program name
   505   (430)  CONSTANT XMXRSNR= 16999      % this server is not running
   506   (431)  CONSTANT XMXRRND= 17000      % Netserver: remote system is not defined
   507   (432)  CONSTANT XMXRNNA= 17001      % Netserver: network not available
   508   (433)  CONSTANT XMXRISE= 17002      % Netserver: internal server error
   509   (434)  CONSTANT XMXRIRQ= 17003      % Netserver: invalid request
   510   (435)  CONSTANT XMXRNGA= 17004      % XMSG not configured with gateway code
   511   (436)  CONSTANT XMXRRNL= 17005      % remote system not on same LAN
   512   (437)  CONSTANT XMXRNCO= 17006      % no connection to this system(unknown status)
   513   (438)  CONSTANT XMXRAMB= 17007      % ambiguous name
   514   (439)  CONSTANT XMXRFFU= 17008      % friend system table full (too many friends)
   515   (440)  
   516   (441)  %-----------------------------------------------------------------------------%
   517   (442)  %                                                                             %
   518   (443)  %                    format of XROUT messages                                 %
   519   (444)  %                                                                             %
   520   (445)  %-----------------------------------------------------------------------------%
   521   (446)  
   522   (447)  %
   523   (448)  % maximum XMSG name length
   524   (449)  %
   525   (450)  CONSTANT XMMAXNameLength = 32          % actually installation-dependent!
   526   (451)  
   527   (452)  
   528   (453)                                         % XROUT header format
   529   (454)  TYPE XROUTHDR = RECORD PACK            % base record for variants
   530   (455)         BYTE: XRSerialNumber            % serial number for user's use
   531   (456)         BYTE: XRServiceNumber           % code for required service which is
   532   (457)         BYTE: XRStatus = XRServiceNumber% replaced with XROUT status code
   533   (458)         INTEGER2: XRBufferLength = XRServiceNumber % overlay for append routines
   534   (459)         INTEGER2: XRLengthMsg           % total length of following parameters
   535   (460)  ENDRECORD
   536   (461)                                         % parameter formats
   537   (462)  TYPE XROUTPARAMHDR = RECORD PACK       % base record for parameter variants
   538   (463)         BYTE: XRPCode                   % parameter code
   539   (464)         BYTE: XRPLength                 % parameter length
   540   (465)  ENDRECORD
   541   (466)  TYPE XROUTSTRING = XROUTPARAMHDR RECORD PACKED % string parameter format
   542   (467)         BYTES: XRPString(0:XMMAXNameLength-1)   % MAXIMUM length shown
   543   (468)  ENDRECORD
   544   (469)  TYPE XROUTINTEGER = XROUTPARAMHDR RECORD PACKED % integer parameter format
   545   (470)         INTEGER2: XRPInteger
   546   (471)  ENDRECORD
   547   (472)  TYPE XROUTDOUBLE = XROUTPARAMHDR RECORD PACKED % integer4 parameter format
   548   (473)         INTEGER4: XRPDouble
   549   (474)  ENDRECORD
   550   (475)  
   551   (476)  %-----------------------------------------------------------------------------%
   552   (477)  $EOF
