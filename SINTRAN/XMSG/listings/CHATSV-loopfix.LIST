   737    (77)  
   738    (78)      % ----- message kinds, mirroring ChatMessageKind.cs ----------------------
   739    (79)      INTEGER : kJoin    := 1
   740    (80)      INTEGER : kWelcome := 2
   741    (81)      INTEGER : kReject  := 3
   742    (82)      INTEGER : kSay     := 4
   743    (83)      INTEGER : kSaid    := 5
   744    (84)      INTEGER : kLeave   := 6
   745    (85)      INTEGER : kJoined  := 7
   746    (86)      INTEGER : kLeft    := 8
   747    (87)      INTEGER : kRename  := 9
   748    (88)      INTEGER : kRenamed := 10
   749    (89)  
   750    (90)      % THERE IS NO ELEVENTH KIND, and the reason is worth keeping.
   751    (91)      %
   752    (92)      % A kHello was invented here on 2026-08-18 to answer the connect on its own,
   753    (93)      % on the belief that a connection port is handed "4 bytes with byte 0 = 0"
   754    (94)      % and that the joiner's nickname could only follow as a second, ordinary
   755    (95)      % message. That belief was wrong, and it was wrong because this program was
   756    (96)      % reading the WRONG BYTES: the connect arrives with the XSLET letter header
   757    (97)      % still in front of it, and byte 0 of that header is the serial number.
   758    (98)      %
   759    (99)      % The nickname was in the very first arrival all along. See the header skip
   760   (100)      % in the receive loop for the layout and the manual reference. The join is
   761   (101)      % ONE step, exactly as the Programmer Guide describes it: the letter carries
   762   (102)      % the user data, the server answers it, and "thereby gives away its own
   763   (103)      % magic number" - the welcome IS the answer, so no extra kind is needed.
   764   (104)  
   765   (105)      % XFWTF is the BIT POSITION (15). The flags word is 2 to that power - the
   766   (106)      % sample programs in Appendix G both write "2**XFWTF =: FLAGS". Passing 15
   767   (107)      % itself would set bits 0 to 3, four unrelated options, and the wait would
   768   (108)      % not happen at all.
   769   (109)      % XFWTF COMES FROM XMP-B02:DEFS - do NOT declare it here. Declaring our own
   770   (110)      % drew IDENTIFIER ALREADY SPECIFIED/DECLARED "XFWTF", and the compiler then
   771   (111)      % fell over with ASSERT VIOLATION AT 136747B and took the batch job with it.
   772   (112)      % A redeclaration is not a warning you can carry on past in this compiler.
   773   (113)      INTEGER : waitFlags := 0       % 2**XFWTF, computed at start
   774   (114)  
   775   (115)      % 2**XFSEC, computed at start. SECURE, and the reason is a measurement.
   776   (116)      %
   777   (117)      % These sends used to carry flags ZERO, and the guide is explicit about what
   778   (118)      % that costs: "Non-secure messages are discarded and released by XMSG if they
   779   (119)      % cannot be delivered." So a member whose terminal died was written to for
   780   (120)      % ever, in silence.
   781   (121)      %
   782   (122)      % THE OBVIOUS ALTERNATIVE WAS TRIED FIRST AND IS REFUTED. XMPSEND is handed a
   783   (123)      % magic number, and a magic carries a generation, so it looked as though XMSG
   784   (124)      % would refuse one naming a closed port on the spot - XMXEIMA, "Invalid magic
   785   (125)      % number". MEASURED 2026-08-18 on D100: two clients in the room, one killed
   786   (126)      % with ESC ("USER BREAK AT 17202B"), the other spoke. The broadcast to the
   787   (127)      % dead port returned XMOK. Not one status printed, the seat stayed spent, and
   788   (128)      % LIST-NAMES held at 14. XMPSEND DOES NOT VALIDATE THE DESTINATION.
   789   (129)      %
   790   (130)      % So the return has to come back as a MESSAGE, which is what XFSEC buys:
   791   (131)      % "The message will be returned to the sending port if it cannot be
   792   (132)      % delivered, or if the receiving port is closed (e.g., if the receiving task
   793   (133)      % terminates)". It arrives as msgType XMTRE and is handled in the receive
   794   (134)      % loop.
   795   (135)      %
   796   (136)      % MEASURED WITH THE FLAG SET, same two clients, same kill: the bounce came
   797   (137)      % back carrying reason 16915 - which is XMXEIMA, the very code the refuted
   798   (138)      % attempt was watching for. It was never the send's status; it is the reason
   799   (139)      % on the return. CHAT-LOBBY went 16 free, 14 with both joined, back to 15
   800   (140)      % once the dead one was reaped.
   801   (141)      INTEGER : sendFlags := 0
   802   (142)  
   803   (143)      % ----- the room ---------------------------------------------------------
   804   (144)      % maxSeats is what XMPOPCN is given, so XROUT turns the SEVENTEENTH joiner
   805   (145)      % away before this program sees them. The array bounds and that argument are
   806   (146)      % the same number on purpose.
   807   (147)      %
   808   (148)      % THE CLIENT DOES NOT KNOW THIS NUMBER AND MUST NOT. Neither CHAT.PLNC nor
   809   (149)      % ChatClient.cs mentions it anywhere - XROUT does the admission itself, before
   810   (150)      % this program is woken, so a client that is turned away simply gets a refusal
   811   (151)      % it has to handle in any case. The room's size is the room's business, and
   812   (152)      % raising it is this file alone. The C# ChatRoom has no seat limit at all.
   813   (153)      %
   814   (154)      % Raised from 8 to 16 on 2026-08-18. Nothing else has to move with it: the
   815   (155)      % four arrays below and every FOR loop are written in terms of maxSeats, and
   816   (156)      % the only literal bounds are the array declarations, which are next to it.
   817   (157)      INTEGER : maxSeats := 16
   818   (158)      INTEGER : nameLen  := 16
   819   (159)  
   820   (160)      INTEGER4 ARRAY : memberMagic(1:16)
   821   (161)  
   822   (162)      % A two-dimensional BYTES array: sixteen names of sixteen bytes. Legal PLANC -
   823   (163)      % the reference gives BYTES ARRAY : b1(1:2,0:3) directly.
   824   (164)      %
   825   (165)      % Note that memberName(slot) with the LAST subscript omitted refers to the
   826   (166)      % WHOLE string, which is tempting for copying a name in one statement. It is
   827   (167)      % NOT used here, because a name is variable length and a whole-row copy would
   828   (168)      % carry the sixteen bytes including whatever follows the name. The explicit
   829   (169)      % loops are longer and right.
   830   (170)      % SIXTEEN BYTES PER NAME, and the number is named because the wire decides
   831   (171)      % how many bytes arrive. A nickname length is one byte, so a peer can ask for
   832   (172)      % up to 255 - and PLANC checks no array bound. Copying an unchecked length in
   833   (173)      % here writes straight through the other seven members' names and out the far
   834   (174)      % side of the array. See the guard at the top of handleMessage.
   835   (175)      INTEGER        : maxNameLen := 16
   836   (176)      % NAMES ARE UNIQUE IN THEIR FIRST TEN CHARACTERS, and that is not a style
   837   (177)      % note - it is what the compiler enforces. memberName and memberNameLen both
   838   (178)      % start MEMBERNAME, so the second silently became a redeclaration of the
   839   (179)      % first: IDENTIFIER ALREADY SPECIFIED/DECLARED "MEMBERNAME", and then every
   840   (180)      % memberName(slot, i) drew MORE SUBSCRIPTS THAN IN THE ARRAY DECLARATION,
   841   (181)      % because the name now referred to the one-dimensional array. Four errors,
   842   (182)      % one cause, and none of them mention the length. The listing gives it away:
   843   (183)      % it prints the TRUNCATED names - BUILDRENAM, BUILDFROMS, REASONNICK.
   844   (184)      BYTES ARRAY    : memberName(1:16, 1:16)
   845   (185)      INTEGER ARRAY  : memberLen(1:16)
   846   (186)      INTEGER ARRAY  : memberUsed(1:16)
   847   (187)  
   848   (188)      % Seats whose member has VANISHED - the terminal was killed, the client was
   849   (189)      % aborted with ESC, the task died. Marked by sendTo when a send comes back
   850   (190)      % saying the port is gone, and cleared by reapDead.
   851   (191)      %
   852   (192)      % A MARK IS NOT AN EVICTION, and the separation is the whole point of this
   853   (193)      % array rather than a nicety. sendTo is called from inside broadcast's loop,
   854   (194)      % and evicting there would have to announce the departure - which means
   855   (195)      % building a message into outBuf while broadcast is still part way through
   856   (196)      % sending the outBuf it built. One shared buffer, so the message everybody
   857   (197)      % else is waiting for would be overwritten mid-broadcast and the room would
   858   (198)      % receive the departure notice instead of what was said. Marking is the only
   859   (199)      % thing safe to do at that depth; the acting happens back at the top.
   860   (200)      INTEGER ARRAY  : memberDead(1:16)
   861   (201)  
   862   (202)      % Is there anything to reap? Kept so the common case - nothing died - costs
   863   (203)      % one compare per message instead of a walk of the whole room.
   864   (204)      INTEGER        : deadFound := 0
   865   (205)  
   866   (206)      % ----- knowing when to give up ------------------------------------------
   867   (207)      % How many receives in a ROW have failed. Cleared by any good one, so this
   868   (208)      % counts a run of trouble rather than trouble over a lifetime.
   869   (209)      INTEGER        : badRuns := 0
   870   (210)  
   871   (211)      % Twenty in a row is not a bad moment, it is a broken machine. Small enough
   872   (212)      % that a spin is caught in under a second, large enough that a burst of
   873   (213)      % something transient is ridden out rather than treated as fatal.
   874   (214)      INTEGER        : maxBadRuns := 20
   875   (215)  
   876   (216)      % Print at most this many of them. The fault that made all this necessary
   877   (217)      % was ONE message repeated as fast as the terminal could take it, and a
   878   (218)      % diagnostic with no limit buries the line that says what happened.
   879   (219)      INTEGER        : maxNoisy := 5
   880   (220)  
   881   (221)      INTEGER ARRAY : stack(0:1000)
   882   (222)  
   883   (223)      % SIZE OF inBuf, named because the read must clamp against it. XMSG reports
   884   (224)      % the SENDER'S message size; nothing stops that being larger than this
   885   (225)      % array, and PLANC checks no bound.
   886   (226)      INTEGER : inBufSize := 256
   887   (227)      BYTES : inBuf(0:255)
   888   (228)      BYTES : outBuf(0:255)
   889   (229)  
   890   (230)      INTEGER  : myPort
   891   (231)      INTEGER  : msgType
   892   (232)  
   893   (233)      % XMROU, "routed message (via XROUT)", is what msgType carries when a letter
   894   (234)      % arrives. It is the ONLY thing that says a SEAT was spent: XROUT takes one
   895   (235)      % free connection to forward a letter, before this program has seen a byte
   896   (236)      % of it.
   897   (237)      %
   898   (238)      % SETTLED FROM ND'S OWN SAMPLE SERVERS, both of them, in the COSMOS
   899   (239)      % Programmer Guide (ND-60.164.3) appendix of sample programs. Each waits for
   900   (240)      % the forwarded letter and then refuses anything else:
   901   (241)      %
   902   (242)      %   PLANC     IF MSGTYPE >< XMROU THEN
   903   (243)      %                 OUTPUT(1, 'A', 'WRONG MESSAGE TYPE ')
   904   (244)      %
   905   (245)      %   FORTRAN   IF (MSGTYPE .NE. XMROU) THEN
   906   (246)      %                 WRITE(1,*)'WRONG MESSAGE TYPE'
   907   (247)      %
   908   (248)      % Both then read the CLIENT's magic number out of the arrived message to
   909   (249)      % answer it directly - which is the other half of the same fact, and the
   910   (250)      % reason the sender field is the client rather than XROUT.
   911   (251)      %
   912   (252)      % The name is used bare here, not declared as a literal, because the PLANC
   913   (253)      % sample uses it bare under the same two includes this file has.
   914   (254)  
   915   (255)      % Was the sender in the room BEFORE this message was handled? The seat
   916   (256)      % accounting below needs the answer from before, so it is taken early.
   917   (257)      INTEGER  : wasMember
   918   (258)      % Is the sender a member AFTER the letter was handled? That single question
   919   (259)      % decides whether the seat XROUT spent on the arrival goes back.
   920   (260)      INTEGER  : nowMember
   921   (261)      % Byte 1 of a routed arrival, kept BEFORE the payload is shifted down. 65
   922   (262)      % (XSLET) means a client sent it and a seat was spent; anything else is
   923   (263)      % XROUT answering one of our own calls, which spent nothing.
   924   (264)      INTEGER  : letterService
   925   (265)  
   926   (266)      % XSLET (65) IS NOT DECLARED HERE. It is already a CONSTANT in XMP-B02:DEFS
   927   (267)      % - "CONSTANT XSLET=65  % Send a letter" - and declaring our own would be a
   928   (268)      % redeclaration, which in this compiler is not a warning: it drew
   929   (269)      % IDENTIFIER ALREADY SPECIFIED and then ASSERT VIOLATION AT 136747B and took
   930   (270)      % the whole batch job with it. Checked against the listing before writing
   931   (271)      % this, not assumed.
   932   (272)      INTEGER  : remotePortHash
   933   (273)      INTEGER  : nBytes
   934   (274)      % What XMPFRCV put in nBytes, kept before XMPFMST overwrites it. It is the
   935   (275)      % message length normally and the REASON FOR RETURN on an XMTRE.
   936   (276)      INTEGER  : receiveStat
   937   (277)      INTEGER  : readLength
   938   (278)      INTEGER  : readAmount
   939   (279)      % An INTEGER dumpAmount clamped the 48-byte arrival dump. Both are gone;
   940   (280)      % see the note in the receive loop for what that dump found.
   941   (281)      % Where the chat message starts inside a letter that came via XROUT - that
   942   (282)      % is, the first byte after the XSLET header. Derived from the header's own
   943   (283)      % length word on every arrival, never assumed.
   944   (284)      INTEGER  : payloadAt
   945   (285)      INTEGER  : writtenLength
   946   (286)      INTEGER  : returnStatus
   947   (287)      INTEGER4 : senderMagic
   948   (288)  
   949   (289)      % OUR OWN port's magic number, read once with XMPFP2M after the port opens.
   950   (290)      % Kept only so an arrival can be tested against it, because the thing that
   951   (291)      % actually happened - our own answer arriving back at this very port - is not
   952   (292)      % something any amount of reading the guide would have suggested, and without
   953   (293)      % this comparison it cannot be told apart from a real peer's message.
   954   (294)      INTEGER4 : myMagic := 0
   955   (295)      BOOLEAN  : uniqueName := TRUE
   956   (296)  
   957   (297)      % -----------------------------------------------------------------------
   958   (298)      % Compare a name in the room against one in a buffer, ignoring case.
   959   (299)      %
   960   (300)      % ChatRoom.cs compares ignoring case, so this does too - the two doors into
   961   (301)      % one room must not disagree about whether ANNA and anna are the same
   962   (302)      % person.
   963   (303)      % -----------------------------------------------------------------------
   964   (304)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : sameName(slot, at, length)
   965   (305)          INTEGER : j, a, b
   966   (306)          IF memberLen(slot) >< length THEN
   967   (307)              0 RETURN
   968   (308)          ENDIF
   969   (309)          FOR j IN 1:length DO
   970   (310)              memberName(slot, j) =: a
   971   (311)              inBuf(at + j - 1) =: b
   972   (312)              IF a > 96 THEN a - 32 =: a ENDIF        % fold lower case to upper
   973   (313)              IF b > 96 THEN b - 32 =: b ENDIF
   974   (314)              IF a >< b THEN
   975   (315)                  0 RETURN
   976   (316)              ENDIF
   977   (317)          ENDFOR
   978   (318)          1 RETURN
   979   (319)      ENDROUTINE
   980   (320)  
   981   (321)      ROUTINE VOID, INTEGER (INTEGER4) : findByMagic(magic)
   982   (322)          INTEGER : i
   983   (323)          FOR i IN 1:maxSeats DO
   984   (324)              IF memberUsed(i) >< 0 THEN
   985   (325)                  IF memberMagic(i) = magic THEN
   986   (326)                      i RETURN
   987   (327)                  ENDIF
   988   (328)              ENDIF
   989   (329)          ENDFOR
   990   (330)          0 RETURN
   991   (331)      ENDROUTINE
   992   (332)  
   993   (333)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findByName(at, length)
   994   (334)          INTEGER : i
   995   (335)          FOR i IN 1:maxSeats DO
   996   (336)              IF memberUsed(i) >< 0 THEN
   997   (337)                  IF sameName(i, at, length) = 1 THEN
   998   (338)                      i RETURN
   999   (339)                  ENDIF
  1000   (340)              ENDIF
  1001   (341)          ENDFOR
  1002   (342)          0 RETURN
  1003   (343)      ENDROUTINE
  1004   (344)  
  1005   (345)      ROUTINE VOID, INTEGER : freeSlot
  1006   (346)          INTEGER : i
  1007   (347)          FOR i IN 1:maxSeats DO
  1008   (348)              IF memberUsed(i) = 0 THEN
  1009   (349)                  i RETURN
  1010   (350)              ENDIF
  1011   (351)          ENDFOR
  1012   (352)          0 RETURN
  1013   (353)      ENDROUTINE
  1014   (354)  
  1015   (355)      % -----------------------------------------------------------------------
  1016   (356)      % Build a message into outBuf. Returns its total length.
  1017   (357)      % -----------------------------------------------------------------------
  1018   (358)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER) : &
  1019   (359)              buildMessage(kind, nameAt, nameLength, textAt, textLength)
  1020   (360)          INTEGER : i, at
  1021   (361)          kind =: outBuf(0)
  1022   (362)          nameLength =: outBuf(1)
  1023   (363)          2 =: at
  1024   (364)          FOR i IN 1:nameLength DO
  1025   (365)              inBuf(nameAt + i - 1) =: outBuf(at)
  1026   (366)              at + 1 =: at
  1027   (367)          ENDFOR
  1028   (368)          0 =: outBuf(at)                       % text length, high byte
  1029   (369)          textLength =: outBuf(at + 1)          % text length, low byte
  1030   (370)          at + 2 =: at
  1031   (371)          FOR i IN 1:textLength DO
  1032   (372)              inBuf(textAt + i - 1) =: outBuf(at)
  1033   (373)              at + 1 =: at
  1034   (374)          ENDFOR
  1035   (375)          at RETURN
  1036   (376)      ENDROUTINE
  1037   (377)  
  1038   (378)      % -----------------------------------------------------------------------
  1039   (379)      % Build a message whose name comes from a member slot rather than from the
  1040   (380)      % incoming buffer - used for Said, where the speaker is named by the room
  1041   (381)      % and NOT by whatever the sender claimed.
  1042   (382)      % -----------------------------------------------------------------------
  1043   (383)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER) : &
  1044   (384)              buildFromSlot(kind, slot, textAt, textLength)
  1045   (385)          INTEGER : i, at
  1046   (386)          kind =: outBuf(0)
  1047   (387)          memberLen(slot) =: outBuf(1)
  1048   (388)          2 =: at
  1049   (389)          FOR i IN 1:memberLen(slot) DO
  1050   (390)              memberName(slot, i) =: outBuf(at)
  1051   (391)              at + 1 =: at
  1052   (392)          ENDFOR
  1053   (393)          0 =: outBuf(at)
  1054   (394)          textLength =: outBuf(at + 1)
  1055   (395)          at + 2 =: at
  1056   (396)          FOR i IN 1:textLength DO
  1057   (397)              inBuf(textAt + i - 1) =: outBuf(at)
  1058   (398)              at + 1 =: at
  1059   (399)          ENDFOR
  1060   (400)          at RETURN
  1061   (401)      ENDROUTINE
  1062   (402)  
  1063   (403)      % -----------------------------------------------------------------------
  1064   (404)      % Copy a name out of the incoming buffer into a member slot.
  1065   (405)      % -----------------------------------------------------------------------
  1066   (406)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : copyNameIn(slot, at, length)
  1067   (407)          INTEGER : i
  1068   (408)          FOR i IN 1:length DO
  1069   (409)              inBuf(at + i - 1) =: memberName(slot, i)
  1070   (410)          ENDFOR
  1071   (411)          length =: memberLen(slot)
  1072   (412)      ENDROUTINE
  1073   (413)  
  1074   (414)      % -----------------------------------------------------------------------
  1075   (415)      % Build the Renamed announcement. Returns its total length.
  1076   (416)      %
  1077   (417)      % The NEW name goes in the name field and the OLD one in the text. That is
  1078   (418)      % not a choice made here - ChatMessageKind.cs states it, and the reason is
  1079   (419)      % that everybody has a transcript on screen under the old name and no way to
  1080   (420)      % connect the two without it. CALL THIS BEFORE the slot is changed, while
  1081   (421)      % the old name is still in it.
  1082   (422)      % -----------------------------------------------------------------------
  1083   (423)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : &
  1084   (424)              buildRenamed(slot, newAt, newLength)
  1085   (425)          INTEGER : i, at
  1086   (426)          kRenamed =: outBuf(0)
  1087   (427)          newLength =: outBuf(1)
  1088   (428)          2 =: at
  1089   (429)          FOR i IN 1:newLength DO
  1090   (430)              inBuf(newAt + i - 1) =: outBuf(at)
  1091   (431)              at + 1 =: at
  1092   (432)          ENDFOR
  1093   (433)  
  1094   (434)          % The old name as the text.
  1095   (435)          0 =: outBuf(at)
  1096   (436)          memberLen(slot) =: outBuf(at + 1)
  1097   (437)          at + 2 =: at
  1098   (438)          FOR i IN 1:memberLen(slot) DO
  1099   (439)              memberName(slot, i) =: outBuf(at)
  1100   (440)              at + 1 =: at
  1101   (441)          ENDFOR
  1102   (442)          at RETURN
  1103   (443)      ENDROUTINE
  1104   (444)  
  1105   (445)      % -----------------------------------------------------------------------
  1106   (446)      % Send outBuf to one magic number.
  1107   (447)      %
  1108   (448)      % XMPFGET reserves a buffer and makes it CURRENT; XMPFWRI writes into the
  1109   (449)      % current message; XMPFSND sends it. Note the userAddress coercion - the
  1110   (450)      % guide's own examples write ADDR(buf(0)) FORCE XMUSERADDRESS.
  1111   (451)      % -----------------------------------------------------------------------
  1112   (452)      ROUTINE VOID, VOID (INTEGER4, INTEGER) : sendTo(magic, length)
  1113   (453)          XMMSGIDENTIFIER : ident
  1114   (454)          INTEGER : deadSlot
  1115   (455)          % Each of the three steps below printed its status on EVERY send while
  1116   (456)          % the room was being brought up - three lines per message, per member.
  1117   (457)          % They now speak only when a step fails, which is the case that was
  1118   (458)          % actually worth seeing: a send that half-succeeds is how a member ends
  1119   (459)          % up in the room and hearing nothing.
  1120   (460)          xmpfget(0, length, ident) =: returnStatus
  1121   (461)          IF returnStatus >< XMOK THEN
  1122   (462)              OUTPUT(1, 'AL18', 'SV: get failed st=')
  1123   (463)              OUTPUT(1, 'I6', returnStatus)
  1124   (464)              OUTPUT(1, 'AL1', '$')
  1125   (465)              RETURN
  1126   (466)          ENDIF
  1127   (467)          xmpfwri(0, 0, &
  1128   (468)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  1129   (469)              0, length, writtenLength) =: returnStatus
  1130   (470)          IF returnStatus >< XMOK THEN
  1131   (471)              OUTPUT(1, 'AL18', 'SV: wri failed st=')
  1132   (472)              OUTPUT(1, 'I6', returnStatus)
  1133   (473)              OUTPUT(1, 'AL1', '$')
  1134   (474)          ENDIF
  1135   (475)          IF returnStatus >< XMOK THEN
  1136   (476)              xmpfrel(0, ident) =: returnStatus
  1137   (477)              RETURN
  1138   (478)          ENDIF
  1139   (479)          % XMPSEND, NOT XMPFSND - and this is the whole bug, not a tidy-up.
  1140   (480)          %
  1141   (481)          % XMPFSND takes no message parameter. The guide says which one it picks:
  1142   (482)          % "the current (default) message buffer is assumed, namely the 'port
  1143   (483)          % current' message if one exists, or, if none, the 'task current'
  1144   (484)          % message" (ND-60.164.3, XMPFSND, EXPLANATION). XMPFGET above only makes
  1145   (485)          % the new buffer TASK current - it has no port parameter and cannot make
  1146   (486)          % it port current. This port has just received a message, so a 'port
  1147   (487)          % current' message may well still exist, and XMPFSND would send THAT
  1148   (488)          % instead of the reply we just built. The guide never says whether
  1149   (489)          % XMPFREL clears the port-current pointer, so relying on it would be a
  1150   (490)          % guess.
  1151   (491)          %
  1152   (492)          % XMPSEND("Send message, not necessarily current") removes the question:
  1153   (493)          % "The message specified by msgIdentifier is set as 'task current'
  1154   (494)          % message and as 'port current' message for localPort. Then the message
  1155   (495)          % will be sent as described under routine XMPFSND."
  1156   (496)          %
  1157   (497)          % Appendix G's SERVER gets away with XMPFSND only because it never calls
  1158   (498)          % XMPFGET - it replies in the very buffer that arrived, which is already
  1159   (499)          % both port and task current. We cannot copy that: a broadcast needs one
  1160   (500)          % fresh buffer per member.
  1161   (501)          xmpsend(sendFlags, ident, myPort, magic) =: returnStatus
  1162   (502)          IF returnStatus >< XMOK THEN
  1163   (503)              OUTPUT(1, 'AL18', 'SV: snd failed st=')
  1164   (504)              OUTPUT(1, 'I6', returnStatus)
  1165   (505)              OUTPUT(1, 'AL1', '$')
  1166   (506)  
  1167   (507)              % ---- A MEMBER WHO IS NO LONGER THERE, IF WE ARE EVER TOLD HERE --
  1168   (508)              % Two statuses would mean the seat is holding somebody who has gone.
  1169   (509)              % Both are read off XMP-B02:DEFS rather than guessed:
  1170   (510)              %
  1171   (511)              %   XMXEIMA 16915  Invalid magic number
  1172   (512)              %   XMXEPCL 16932  Remote port closed while message queued
  1173   (513)              %
  1174   (514)              % NEITHER OF THEM ACTUALLY TURNS UP for a client killed on this
  1175   (515)              % machine - measured, see the note on sendFlags. XMPSEND took the
  1176   (516)              % message for a closed port and answered XMOK. This test is kept
  1177   (517)              % rather than deleted because it costs one compare and it is right
  1178   (518)              % if a status ever does arrive - a remote member across a link is
  1179   (519)              % the obvious untested case - but it is NOT what fixes the leak.
  1180   (520)              % The XMTRE branch in the receive loop is.
  1181   (521)              %
  1182   (522)              % ONLY THESE TWO, and deliberately not "any failure". XMXEMFL
  1183   (523)              % (message space full) is a bad moment, not a dead member, and
  1184   (524)              % throwing somebody out of the room because the machine was briefly
  1185   (525)              % short of buffers would be worse than the bug being fixed. Every
  1186   (526)              % other status still prints above.
  1187   (527)              IF returnStatus = XMXEIMA OR returnStatus = XMXEPCL THEN
  1188   (528)                  findByMagic(magic) =: deadSlot
  1189   (529)                  IF deadSlot >< 0 THEN
  1190   (530)                      1 =: memberDead(deadSlot)
  1191   (531)                      1 =: deadFound
  1192   (532)                  ENDIF
  1193   (533)              ENDIF
  1194   (534)          ENDIF
  1195   (535)      ENDROUTINE
  1196   (536)  
  1197   (537)      ROUTINE VOID, VOID (INTEGER, INTEGER) : broadcast(length, exceptSlot)
  1198   (538)          INTEGER : i
  1199   (539)          FOR i IN 1:maxSeats DO
  1200   (540)              IF memberUsed(i) >< 0 THEN
  1201   (541)                  IF i >< exceptSlot THEN
  1202   (542)                      sendTo(memberMagic(i), length)
  1203   (543)                  ENDIF
  1204   (544)              ENDIF
  1205   (545)          ENDFOR
  1206   (546)      ENDROUTINE
  1207   (547)  
  1208   (548)      % -----------------------------------------------------------------------
  1209   (549)      % Empty the seats of members who have vanished, and give each seat back.
  1210   (550)      %
  1211   (551)      % CALLED FROM THE TOP OF THE RECEIVE LOOP, never from inside a broadcast -
  1212   (552)      % see the note on memberDead for why that is not a style choice.
  1213   (553)      %
  1214   (554)      % A vanished member costs TWO things and they are not the same thing:
  1215   (555)      %
  1216   (556)      %   the seat in this program  memberUsed, which decides who is in the room;
  1217   (557)      %   the seat in XROUT         the free-connection counter, which decides
  1218   (558)      %                             whether a new joiner's letter is forwarded at
  1219   (559)      %                             all. XROUT decremented it to deliver the join
  1220   (560)      %                             and only the port's owner - this program -
  1221   (561)      %                             ever puts one back, with XMPINFC.
  1222   (562)      %
  1223   (563)      % Clearing only the first leaves the room looking empty in LIST-NAMES while
  1224   (564)      % it refuses everybody. MEASURED 2026-08-18, before this routine existed:
  1225   (565)      % CHAT-LOBBY went 16 free to 15 when a client was aborted with ESC
  1226   (566)      % ("USER BREAK AT 16665B") and stayed at 15 for good.
  1227   (567)      % -----------------------------------------------------------------------
  1228   (568)      ROUTINE VOID, VOID : reapDead
  1229   (569)          INTEGER : round, i, length
  1230   (570)  
  1231   (571)          % Cleared FIRST, not last. A broadcast below can discover another dead
  1232   (572)          % member - telling the room somebody left is exactly when the next dead
  1233   (573)          % port gets found - and clearing at the end would throw that mark away.
  1234   (574)          % Cleared here, a mark raised during our own broadcasts simply re-arms
  1235   (575)          % this routine for the next message.
  1236   (576)          0 =: deadFound
  1237   (577)  
  1238   (578)          % Bounded rather than a WHILE. Each pass empties at least one seat and a
  1239   (579)          % pass can only mark members still in the room, so maxSeats passes empty
  1240   (580)          % the worst room there is. An unbounded loop here would be taking on
  1241   (581)          % trust that a broadcast to a dying room always terminates, and this
  1242   (582)          % program has no way to recover if it does not.
  1243   (583)          FOR round IN 1:maxSeats DO
  1244   (584)              FOR i IN 1:maxSeats DO
  1245   (585)                  IF memberDead(i) >< 0 THEN
  1246   (586)                      0 =: memberDead(i)
  1247   (587)                      IF memberUsed(i) >< 0 THEN
  1248   (588)                          % Same order as the kLeave path: build the announcement
  1249   (589)                          % while the name is still in the slot, empty the seat,
  1250   (590)                          % THEN tell the room - so the departing member is not
  1251   (591)                          % sent their own Left notice at a port already gone,
  1252   (592)                          % which would only mark them dead all over again.
  1253   (593)                          buildFromSlot(kLeft, i, 0, 0) =: length
  1254   (594)                          0 =: memberUsed(i)
  1255   (595)                          broadcast(length, 0)
  1256   (596)  
  1257   (597)                          xmpinfc(0, myPort, 1, 0) =: returnStatus
  1258   (598)                          IF returnStatus >< XMOK THEN
  1259   (599)                              OUTPUT(1, 'AL18', 'SV: infc failed st')
  1260   (600)                              OUTPUT(1, 'I6', returnStatus)
  1261   (601)                              OUTPUT(1, 'AL1', '$')
  1262   (602)                          ENDIF
  1263   (603)  
  1264   (604)                          % Worth one line: an operator watching the room needs to
  1265   (605)                          % be able to tell "they left" from "they died", because
  1266   (606)                          % only the second is evidence of anything.
  1267   (607)                          OUTPUT(1, 'AL21', 'SV: reaped dead slot ')
  1268   (608)                          OUTPUT(1, 'I6', i)
  1269   (609)                          OUTPUT(1, 'AL1', '$')
  1270   (610)                      ENDIF
  1271   (611)                  ENDIF
  1272   (612)              ENDFOR
  1273   (613)          ENDFOR
  1274   (614)      ENDROUTINE
  1275   (615)  
  1276   (616)      % ----- the refusal reasons, worded exactly as ChatRoom.cs words them ----
  1277   (617)      % Carried on the wire so a client shows the same sentence whichever door it
  1278   (618)      % came in by. If these and ChatRoom ever diverge, one of the two is wrong.
  1279   (619)      %
  1280   (620)      % EACH LENGTH IS WRITTEN OUT beside its string, and that is deliberate. An
  1281   (621)      % earlier version called LENGTH(reason) - PLANC has no such routine. The one
  1282   (622)      % it does have is SIZE, whose syntax is "SIZE ident =: var" with no
  1283   (623)      % parentheses, and which returns the STORAGE size; what that means for a
  1284   (624)      % BYTES value passed as a routine parameter is not established. Passing the
  1285   (625)      % count removes the question rather than trading one guess for another.
  1286   (626)      %
  1287   (627)      % The cost is that a string and its number must be changed together. That is
  1288   (628)      % a real risk and it is why they are on adjacent lines.
  1289   (629)      BYTES : reasonNeedNick := 'a nickname is required'
  1290   (630)      INTEGER : lenNeedNick := 22
  1291   (631)      BYTES : reasonNickTaken    := 'that nickname is taken'
  1292   (632)      INTEGER : lenNickTaken := 22
  1293   (633)      BYTES : reasonAlreadyIn    := 'already joined'
  1294   (634)      INTEGER : lenAlreadyIn := 14
  1295   (635)      BYTES : reasonRoomFull     := 'the room is full'
  1296   (636)      INTEGER : lenRoomFull := 16
  1297   (637)  
  1298   (638)      % -----------------------------------------------------------------------
  1299   (639)      % Refuse the sender, echoing the name they asked for and naming the reason.
  1300   (640)      %
  1301   (641)      % The name is echoed so the asker can tell WHICH request failed when it has
  1302   (642)      % more than one outstanding; the reason is carried so the wording is the
  1303   (643)      % same on both doors.
  1304   (644)      % -----------------------------------------------------------------------
  1305   (645)      ROUTINE VOID, VOID (INTEGER, INTEGER, BYTES, INTEGER) : &
  1306   (646)              refuse(nameAt, nameLength, reason, reasonLength)
  1307   (647)          INTEGER : i, at
  1308   (648)          kReject =: outBuf(0)
  1309   (649)          nameLength =: outBuf(1)
  1310   (650)          2 =: at
  1311   (651)          FOR i IN 1:nameLength DO
  1312   (652)              inBuf(nameAt + i - 1) =: outBuf(at)
  1313   (653)              at + 1 =: at
  1314   (654)          ENDFOR
  1315   (655)  
  1316   (656)          0 =: outBuf(at)
  1317   (657)          reasonLength =: outBuf(at + 1)
  1318   (658)          at + 2 =: at
  1319   (659)          % SUBSCRIPT FROM ZERO. A BYTES declared from a literal - which is what
  1320   (660)          % every reason string above is - has its first character at index 0, so
  1321   (661)          % "reason(i)" for i in 1:len silently drops the first letter and reads
  1322   (662)          % one byte past the end. Same defect, same day, in CHAT.PLNC's buildOwn,
  1323   (663)          % where it turned RONNY into ONNY on the wire and was only visible
  1324   (664)          % because the raw bytes were dumped. Nothing warns; PLANC checks no
  1325   (665)          % bound. Compare cmdIs in CHAT.PLNC, which has always used word(i - 1).
  1326   (666)          FOR i IN 1:reasonLength DO
  1327   (667)              reason(i - 1) =: outBuf(at)
  1328   (668)              at + 1 =: at
  1329   (669)          ENDFOR
  1330   (670)  
  1331   (671)          sendTo(senderMagic, at)
  1332   (672)      ENDROUTINE
  1333   (673)  
  1334   (674)      % -----------------------------------------------------------------------
  1335   (675)      % Decode one arrived message and apply the room rules.
  1336   (676)      %
  1337   (677)      % A transcription of Xmsg.Chat/ChatRoom.cs. Where that file refuses, this
  1338   (678)      % refuses for the same reason and in the same order, because the two doors
  1339   (679)      % lead into one room.
  1340   (680)      % -----------------------------------------------------------------------
  1341   (681)      ROUTINE VOID, VOID : handleMessage
  1342   (682)          INTEGER : kind, nameLength, nameAt, textLength, textAt
  1343   (683)          INTEGER : slot, taken, length
  1344   (684)  
  1345   (685)          inBuf(0) =: kind
  1346   (686)          inBuf(1) =: nameLength
  1347   (687)          2 =: nameAt
  1348   (688)  
  1349   (689)          % A "parse k= nlen= rlen=" line printed here on EVERY message while the
  1350   (690)          % join was being brought up. It said "remove once the join works", and
  1351   (691)          % the join works - it was what showed the kind arriving as the XSLET
  1352   (692)          % serial number instead of kJoin, which is how the missing header skip
  1353   (693)          % was found.
  1354   (694)          %
  1355   (695)          % THE THREE "DROP" MESSAGES BELOW STAY. They are not the same thing: a
  1356   (696)          % silent drop is right for a stranger on the wire but leaves the operator
  1357   (697)          % unable to tell a refused message from a lost one, and each prints only
  1358   (698)          % when something is actually wrong rather than once per message.
  1359   (699)  
  1360   (700)          % ---- TRUST NOTHING THAT ARRIVED ------------------------------------
  1361   (701)          % Every field below is a byte a stranger chose. Two things have to hold
  1362   (702)          % before any of them is used, and neither is checked by the language:
  1363   (703)          %
  1364   (704)          %   the name must FIT      memberName has maxNameLen bytes per seat, and
  1365   (705)          %                          a length byte can say 255.
  1366   (706)          %   the fields must be IN  the message actually read is readLength
  1367   (707)          %   THE MESSAGE            bytes; a length that points past it would read
  1368   (708)          %                          whatever the previous, longer message left in
  1369   (709)          %                          inBuf and answer with it.
  1370   (710)          %
  1371   (711)          % Dropped in silence rather than refused: a refusal would need a name to
  1372   (712)          % echo, and the name is the part that is not trustworthy. The seat is
  1373   (713)          % settled by the receive loop either way, which is exactly why that
  1374   (714)          % accounting does not live in here.
  1375   (715)          %
  1376   (716)          % The sixteen is a rule of the ROOM, not a detail of this program:
  1377   (717)          % ChatRoom.MaxNicknameLength says the same number, so a name this side
  1378   (718)          % must drop is one the other side refuses rather than admits. Otherwise
  1379   (719)          % the two rooms would disagree about who is in them.
  1380   (720)          IF nameLength > maxNameLen THEN
  1381   (721)              OUTPUT(1, 'AL21', 'SV: DROP name too big')
  1382   (722)              OUTPUT(1, 'AL1', '$')
  1383   (723)              RETURN
  1384   (724)          ENDIF
  1385   (725)          IF nameAt + nameLength + 1 > readLength THEN
  1386   (726)              OUTPUT(1, 'AL22', 'SV: DROP name past end')
  1387   (727)              OUTPUT(1, 'AL1', '$')
  1388   (728)              RETURN
  1389   (729)          ENDIF
  1390   (730)  
  1391   (731)          nameAt + nameLength =: textAt
  1392   (732)          inBuf(textAt) * 256 + inBuf(textAt + 1) =: textLength
  1393   (733)          textAt + 2 =: textAt
  1394   (734)  
  1395   (735)          IF textAt + textLength > readLength THEN
  1396   (736)              OUTPUT(1, 'AL22', 'SV: DROP text past end')
  1397   (737)              OUTPUT(1, 'AL1', '$')
  1398   (738)              RETURN
  1399   (739)          ENDIF
  1400   (740)  
  1401   (741)          % The seat this sender already holds, or -1 if none. A "slot now=" line
  1402   (742)          % used to print here on every message; it was part of the same bring-up
  1403   (743)          % as the parse line above and went with it.
  1404   (744)          findByMagic(senderMagic) =: slot
  1405   (745)  
  1406   (746)          IF kind = kJoin THEN
  1407   (747)              % Order matches ChatRoom.TryJoin: empty name, then taken name, then
  1408   (748)              % already joined.
  1409   (749)              IF nameLength = 0 THEN
  1410   (750)                  refuse(nameAt, nameLength, reasonNeedNick, lenNeedNick)
  1411   (751)                  RETURN
  1412   (752)              ENDIF
  1413   (753)              findByName(nameAt, nameLength) =: taken
  1414   (754)              IF taken >< 0 THEN
  1415   (755)                  refuse(nameAt, nameLength, reasonNickTaken, lenNickTaken)
  1416   (756)                  RETURN
  1417   (757)              ENDIF
  1418   (758)              IF slot >< 0 THEN
  1419   (759)                  refuse(nameAt, nameLength, reasonAlreadyIn, lenAlreadyIn)
  1420   (760)                  RETURN
  1421   (761)              ENDIF
  1422   (762)  
  1423   (763)              freeSlot =: slot
  1424   (764)              IF slot = 0 THEN
  1425   (765)                  % XROUT should have stopped this - the seat count it holds and
  1426   (766)                  % maxSeats here are the same number. If it ever happens, the
  1427   (767)                  % two have drifted apart and that is worth refusing loudly
  1428   (768)                  % rather than overwriting a member.
  1429   (769)                  refuse(nameAt, nameLength, reasonRoomFull, lenRoomFull)
  1430   (770)                  RETURN
  1431   (771)              ENDIF
  1432   (772)  
  1433   (773)              1 =: memberUsed(slot)
  1434   (774)              senderMagic =: memberMagic(slot)
  1435   (775)              copyNameIn(slot, nameAt, nameLength)
  1436   (776)  
  1437   (777)              % The welcome goes only to the joiner; the room hears Joined.
  1438   (778)              buildMessage(kWelcome, nameAt, nameLength, 0, 0) =: length
  1439   (779)              sendTo(senderMagic, length)
  1440   (780)  
  1441   (781)              buildMessage(kJoined, nameAt, nameLength, 0, 0) =: length
  1442   (782)              broadcast(length, slot)
  1443   (783)              RETURN
  1444   (784)          ENDIF
  1445   (785)  
  1446   (786)          % Everything below requires membership. Silence for a stranger, exactly
  1447   (787)          % as ChatRoom does: answering would confirm the port is a chat server to
  1448   (788)          % something that never joined.
  1449   (789)          IF slot = 0 THEN
  1450   (790)              RETURN
  1451   (791)          ENDIF
  1452   (792)  
  1453   (793)          IF kind = kSay THEN
  1454   (794)              % The speaker is named by the ROOM, never by what the sender put in
  1455   (795)              % the message - otherwise anyone could speak as anyone.
  1456   (796)              buildFromSlot(kSaid, slot, textAt, textLength) =: length
  1457   (797)              broadcast(length, 0)                  % 0 = everybody, speaker too
  1458   (798)              RETURN
  1459   (799)          ENDIF
  1460   (800)  
  1461   (801)          IF kind = kRename THEN
  1462   (802)              IF nameLength = 0 THEN
  1463   (803)                  refuse(nameAt, nameLength, reasonNeedNick, lenNeedNick)
  1464   (804)                  RETURN
  1465   (805)              ENDIF
  1466   (806)              IF sameName(slot, nameAt, nameLength) = 1 THEN
  1467   (807)                  RETURN                            % already your name: not news
  1468   (808)              ENDIF
  1469   (809)              findByName(nameAt, nameLength) =: taken
  1470   (810)              IF taken >< 0 THEN
  1471   (811)                  refuse(nameAt, nameLength, reasonNickTaken, lenNickTaken)
  1472   (812)                  RETURN
  1473   (813)              ENDIF
  1474   (814)  
  1475   (815)              % Renamed carries the NEW name and the OLD one as its text, so a
  1476   (816)              % transcript on somebody's screen can be connected up. Built before
  1477   (817)              % the slot changes, while the old name is still there.
  1478   (818)              buildRenamed(slot, nameAt, nameLength) =: length
  1479   (819)              copyNameIn(slot, nameAt, nameLength)
  1480   (820)              broadcast(length, 0)                  % including the asker
  1481   (821)              RETURN
  1482   (822)          ENDIF
  1483   (823)  
  1484   (824)          IF kind = kLeave THEN
  1485   (825)              buildFromSlot(kLeft, slot, 0, 0) =: length
  1486   (826)              0 =: memberUsed(slot)
  1487   (827)              broadcast(length, 0)
  1488   (828)  
  1489   (829)              % Give the seat back to XROUT, or the room fills up permanently and
  1490   (830)              % XROUT stops forwarding joins long after anybody left.
  1491   (831)              xmpinfc(0, myPort, 1, 0) =: returnStatus
  1492   (832)              RETURN
  1493   (833)          ENDIF
  1494   (834)      ENDROUTINE
  1495   (835)  
  1496   (836)      % -----------------------------------------------------------------------
  1497   (837)      % The program.
  1498   (838)      % -----------------------------------------------------------------------
  1499   (839)      PROGRAM : chatServer
  1500   (840)          XMMSGIDENTIFIER : msgIdent
  1501   (841)          INTEGER : i
  1502   (842)  
  1503   (843)          INISTACK stack
  1504   (844)  
  1505   (845)          % The flags WORDS from their bit positions - see the note at the top.
  1506   (846)          2**XFWTF =: waitFlags
  1507   (847)          2**XFSEC =: sendFlags
  1508   (848)  
  1509   (849)          FOR i IN 1:maxSeats DO
  1510   (850)              0 =: memberUsed(i)
  1511   (851)              0 =: memberDead(i)
  1512   (852)          ENDFOR
  1513   (853)  
  1514   (854)          % A CONNECTION port: XROUT holds the free-connection counter and turns
  1515   (855)          % the joiner past maxSeats away for us, before this program is woken.
  1516   (856)          % That is the whole reason no client knows the number.
  1517   (857)          xmpopcn(0, 'CHAT-LOBBY', uniqueName, maxSeats, myPort) =: returnStatus
  1518   (858)          IF returnStatus >< XMOK THEN
  1519   (859)              OUTPUT(1, 'AL29', 'CHATSV: cannot open the room$')
  1520   (860)              OUTPUT(1, 'AL11', 'SV: opn st=')
  1521   (861)              OUTPUT(1, 'I6', returnStatus)
  1522   (862)              OUTPUT(1, 'AL1', '$')
  1523   (863)              RETURN
  1524   (864)          ENDIF
  1525   (865)  
  1526   (866)          % Our own magic number, so an arrival can be tested against it.
  1527   (867)          xmpfp2m(0, myPort, myMagic) =: returnStatus
  1528   (868)          IF returnStatus >< XMOK THEN
  1529   (869)              OUTPUT(1, 'AL18', 'SV: p2m failed st=')
  1530   (870)              OUTPUT(1, 'I6', returnStatus)
  1531   (871)              OUTPUT(1, 'AL1', '$')
  1532   (872)          ENDIF
  1533   (873)  
  1534   (874)          % ONE BANNER, AND IT STAYS. An operator has to be able to tell a server
  1535   (875)          % that is waiting from one that never got its room, and the port number
  1536   (876)          % is what LIST-PORTS is matched against when it does not.
  1537   (877)          OUTPUT(1, 'AL24', 'CHATSV: room open, port ')
  1538   (878)          OUTPUT(1, 'I6', myPort)
  1539   (879)          OUTPUT(1, 'AL1', '$')
  1540   (880)  
  1541   (881)          DO
  1542   (882)              % WAIT. XFWTF is what makes this block rather than spin; an RT
  1543   (883)              % program that polls burns the machine for nothing. Without the
  1544   (884)              % flag the status would come back MXNEXTM when nothing is waiting.
  1545   (885)              xmpfrcv(waitFlags, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  1546   (886)                  =: returnStatus
  1547   (887)              % A RECEIVE IS A MESSAGE ONLY WHEN THE STATUS IS A MESSAGE TYPE.
  1548   (888)              % Not "= XMOK" and not "> 0". The library remaps statuses: 0 is OK
  1549   (889)              % for other calls but is NOT a message type, so comparing to it
  1550   (890)              % here discards every message; and 16896 (XMXENTM, nothing there)
  1551   (891)              % and every error are positive, so "> 0" accepts an empty port.
  1552   (892)              % The constants file settles it - "Message types: Returned as
  1553   (893)              % successfull status from XFRCV", XMTNO=1 through XMTPS=6.
  1554   (894)              % PRINT THE STATUS OF EVERY RECEIVE, OUTSIDE THE TEST.
  1555   (895)              %
  1556   (896)              % This line is here because the test below threw the message away
  1557   (897)              % and every diagnostic was INSIDE it, so the server looked as if it
  1558   (898)              % had never woken at all. MEASURED 2026-08-18: CHAT-LOBBY went from
  1559   (899)              % 8 free seats to 6 across two joins, which proves XROUT accepted
  1560   (900)              % both letters and forwarded them here - "XROUT will decrement the
  1561   (901)              % counter and forward the whole message to portName" - while this
  1562   (902)              % program printed nothing and went straight back to waiting.
  1563   (903)              %
  1564   (904)              % A gate must never be the only thing that can tell you it closed.
  1565   (905)              % This printed on EVERY receive during bring-up. It now prints only
  1566   (906)              % when the receive is NOT one this server accepts - which is the case
  1567   (907)              % the original comment was really about. A message that arrives and is
  1568   (908)              % handled says so by what it does; a message thrown away by the test
  1569   (909)              % below still has nothing else to speak for it.
  1570   (910)              % ---- KNOW WHEN TO STOP -------------------------------------
  1571   (911)              % MEASURED 2026-08-18, and it is why this block exists at all.
  1572   (912)              % XMSG went down under a running server. XMPFRCV then stopped
  1573   (913)              % blocking - there is nothing to wait ON - and returned 16933,
  1574   (914)              % XMXENRU, "XMSG not running", instantly, for ever. This loop
  1575   (915)              % printed that line as fast as the terminal could take it and
  1576   (916)              % burned the machine until somebody pressed ESC.
  1577   (917)              %
  1578   (918)              % A WAIT THAT CANNOT WAIT IS A SPIN. The XFWTF flag is what makes
  1579   (919)              % this loop cheap, and it quietly stops meaning anything the moment
  1580   (920)              % the thing it waits on is gone. Any program built around a
  1581   (921)              % blocking call needs an answer for that, and "print and go round
  1582   (922)              % again" is not one.
  1583   (923)              %
  1584   (924)              % Two ways out, and they are different on purpose:
  1585   (925)              %
  1586   (926)              %   XMXENRU        STOP. Nothing this program can do brings XMSG
  1587   (927)              %                  back - an operator has to restart it - so
  1588   (928)              %                  retrying is not persistence, it is a busy loop
  1589   (929)              %                  with no end. Say so plainly and leave.
  1590   (930)              %
  1591   (931)              %   anything else  RETRY, but not for ever. An unknown status may
  1592   (932)              %                  well clear; the same one arriving maxBadRuns
  1593   (933)              %                  times running has not cleared and will not.
  1594   (934)              %
  1595   (935)              % A GOOD RECEIVE CLEARS THE COUNT, so the limit is on a RUN of
  1596   (936)              % failures rather than on failures for the life of the program. A
  1597   (937)              % server that has been up for a week and sees twenty scattered odd
  1598   (938)              % statuses is healthy; one that sees twenty in a row is not.
  1599   (939)              IF returnStatus = XMOK OR &
  1600   (940)                 (returnStatus >= XMTNO AND returnStatus <= XMTPS) THEN
  1601   (941)                  0 =: badRuns
  1602   (942)              ELSE
  1603   (943)                  IF returnStatus >< XMXENTM THEN
  1604   (944)                      badRuns + 1 =: badRuns
  1605   (945)  
  1606   (946)                      % Print the first few and then stop shouting. The whole
  1607   (947)                      % fault above was a message repeated without limit, and a
  1608   (948)                      % diagnostic that fills the screen hides the one line that
  1609   (949)                      % matters.
  1610   (950)                      IF badRuns <= maxNoisy THEN
  1611   (951)                          OUTPUT(1, 'AL23', 'SV: receive refused st=')
  1612   (952)                          OUTPUT(1, 'I6', returnStatus)
  1613   (953)                          OUTPUT(1, 'AL1', '$')
  1614   (954)                      ENDIF
  1615   (955)  
  1616   (956)                      IF returnStatus = XMXENRU THEN
  1617   (957)                          OUTPUT(1, 'AL31', 'CHATSV: XMSG is not running - $')
  1618   (958)                          OUTPUT(1, 'AL31', 'CHATSV: stopping, restart XMSG$')
  1619   (959)                          RETURN
  1620   (960)                      ENDIF
  1621   (961)  
  1622   (962)                      IF badRuns > maxBadRuns THEN
  1623   (963)                          OUTPUT(1, 'AL30', 'CHATSV: too many bad receives$')
  1624   (964)                          OUTPUT(1, 'I6', returnStatus)
  1625   (965)                          OUTPUT(1, 'AL1', '$')
  1626   (966)                          RETURN
  1627   (967)                      ENDIF
  1628   (968)                  ENDIF
  1629   (969)              ENDIF
  1630   (970)  
  1631   (971)              % ACCEPT XMOK TOO - Appendix G's SERVER does exactly this.
  1632   (972)              %
  1633   (973)              % The old test was the range XMTNO..XMTPS alone, defended by a
  1634   (974)              % comment claiming 0 "is NOT a message type, so comparing to it here
  1635   (975)              % discards every message". The vendor sample says otherwise: after
  1636   (976)              % XMPFRCV it tests "IF RETURNSTATUS >< XMOK THEN ... bad status" and
  1637   (977)              % only THEN looks at the MSGTYPE out-parameter to check for XMROU.
  1638   (978)              % So XMOK is a successful receive, and the message type belongs in
  1639   (979)              % msgType, not in the status.
  1640   (980)              %
  1641   (981)              % Both forms are accepted here rather than one being swapped for the
  1642   (982)              % other, because the print above will say which one actually turns up
  1643   (983)              % and guessing is what put the range test here in the first place.
  1644   (984)              IF returnStatus = XMOK OR &
  1645   (985)                 (returnStatus >= XMTNO AND returnStatus <= XMTPS) THEN
  1646   (986)                  % The FULL magic number of the sender - XMPFRCV hands back only
  1647   (987)                  % a hashed port, and we must be able to answer.
  1648   (988)                  % A "got t= len=" line printed here to separate "never woke"
  1649   (989)                  % from "woke, replied, reply lost". It said to remove it once the
  1650   (990)                  % join works, and the join works.
  1651   (991)                  % THE RECEIVE'S OWN nBytes, KEPT BEFORE ANYTHING OVERWRITES IT.
  1652   (992)                  % For an ordinary message it is the length; for a RETURNED one
  1653   (993)                  % the guide says it is something else entirely - "If msgType is
  1654   (994)                  % XMTRE, msgLengthOrStat contains the error status" - and
  1655   (995)                  % xmpfmst below writes over it either way.
  1656   (996)                  nBytes =: receiveStat
  1657   (997)  
  1658   (998)                  xmpfmst(0, msgIdent, msgType, senderMagic, nBytes) =: returnStatus
  1659   (999)  
  1660  (1000)                  % CLAMP BEFORE READING. nBytes is the sender's message size,
  1661  (1001)                  % handed back by XMSG - not a size this program chose. Passing
  1662  (1002)                  % it straight in lets any peer that sends more than inBufSize
  1663  (1003)                  % bytes write past the end of inBuf. That is a WRITE overflow
  1664  (1004)                  % and it happens before a single field is parsed, so none of
  1665  (1005)                  % the careful field checks in handleMessage can save it.
  1666  (1006)                  nBytes =: readAmount
  1667  (1007)                  IF readAmount > inBufSize THEN
  1668  (1008)                      inBufSize =: readAmount
  1669  (1009)                  ENDIF
  1670  (1010)  
  1671  (1011)                  xmpfrea(0, 0, &
  1672  (1012)                      ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  1673  (1013)                      0, readAmount, readLength) =: returnStatus
  1674  (1014)  
  1675  (1015)                  xmpfrel(0, msgIdent) =: returnStatus
  1676  (1016)  
  1677  (1017)                  % A 48-BYTE RAW DUMP OF EVERY ARRIVAL STOOD HERE, and it is the
  1678  (1018)                  % single diagnostic that solved this program. It is worth saying
  1679  (1019)                  % what it did before it goes, because the lesson outlives it.
  1680  (1020)                  %
  1681  (1021)                  % It began at 8 bytes and printed nothing useful for the arrival
  1682  (1022)                  % that mattered. Widened to 48 it showed the join in full:
  1683  (1023)                  %
  1684  (1024)                  %   123  65  0 12 | 255 10 'CHAT-LOBBY' | 1 5 'RONNY' 0 0
  1685  (1025)                  %
  1686  (1026)                  % Byte 0 was 123 - the SERIAL NUMBER this program's own client
  1687  (1027)                  % hands to XMPBLET. So what arrives starts with the XSLET LETTER
  1688  (1028)                  % HEADER, and handleMessage had been reading that header as if it
  1689  (1029)                  % were a chat message all along. The header skip below is the fix,
  1690  (1030)                  % and the layout under it is read off those bytes.
  1691  (1031)                  %
  1692  (1032)                  % The general form: a dump of what actually arrived beat every
  1693  (1033)                  % re-reading of the code, and it beat the manual too - the manual
  1694  (1034)                  % was right and was being applied to the wrong offset.
  1695  (1035)  
  1696  (1036)                  % A "fromSelf YES/no" line printed here. It earned its place once:
  1697  (1037)                  % the answer came back YES, the server's own reply arriving
  1698  (1038)                  % straight back at this port, which no amount of reading the guide
  1699  (1039)                  % would have suggested. That is recorded rather than printed now.
  1700  (1040)                  % THE SENDER'S MAGIC NUMBER AND OUR OWN were printed side by side
  1701  (1041)                  % here, to answer one suspicion: the welcome was being sent with
  1702  (1042)                  % status 0 and never arriving, so was senderMagic - taken from
  1703  (1043)                  % XMPFMST on a letter that came via XROUT - an address we could
  1704  (1044)                  % actually send BACK to?
  1705  (1045)                  %
  1706  (1046)                  % IT WAS. The two numbers were consistent and the reply address
  1707  (1047)                  % was never the bug. What that ruled out is what sent the search
  1708  (1048)                  % to the CLIENT's receive test, where XMPFRCV was returning XMOK,
  1709  (1049)                  % a "1..6 only" test was rejecting it, and the welcome was being
  1710  (1050)                  % dequeued and dropped in silence.
  1711  (1051)                  %
  1712  (1052)                  % A diagnostic that clears a suspicion is worth as much as one
  1713  (1053)                  % that confirms it, and this one cost a push-and-compile round
  1714  (1054)                  % trip to add. That is why it is written down instead of deleted.
  1715  (1055)  
  1716  (1056)                  % ---- A LETTER ARRIVES WEARING ITS XROUT HEADER --------------
  1717  (1057)                  % XROUT forwards THE WHOLE MESSAGE, header included. So a letter
  1718  (1058)                  % that came via XROUT has the XSLET header in front of the chat
  1719  (1059)                  % message, and the chat message has to be found behind it.
  1720  (1060)                  %
  1721  (1061)                  % ND-60.164.3 EN COSMOS Programmer Guide, appendix B, "XROUT
  1722  (1062)                  % Message Format", states the layout - this is read from the
  1723  (1063)                  % manual, not inferred from one capture:
  1724  (1064)                  %
  1725  (1065)                  %   byte 0     serial number, echoed back unchanged by XROUT
  1726  (1066)                  %   byte 1     the service number (XSLET = 65); XROUT overwrites
  1727  (1067)                  %              it with the return status on a reply
  1728  (1068)                  %   bytes 2-3  LENGTH OF THE REMAINDER OF THE MESSAGE in bytes,
  1729  (1069)                  %              "followed by a sequence of parameter blocks"
  1730  (1070)                  %
  1731  (1071)                  % So the parameter blocks occupy exactly the bytes that length
  1732  (1072)                  % counts, and OUR data starts right after them:
  1733  (1073)                  %
  1734  (1074)                  %   payloadAt = 4 + the length word
  1735  (1075)                  %
  1736  (1076)                  % The manual is explicit that the user data is untouched: "The
  1737  (1077)                  % remainder of the message will not be looked at by XROUT ... thus
  1738  (1078)                  % the user data can be coded in any format legible to the
  1739  (1079)                  % receiving (server) task."
  1740  (1080)                  %
  1741  (1081)                  % MEASURED 2026-08-18, the 25-byte join, which agrees:
  1742  (1082)                  %   123  65  0 12 | 255 10 'CHAT-LOBBY' | 1 5 'RONNY' 0 0
  1743  (1083)                  %    ^serial ^len=12   ^param 1: string, 10 bytes  ^payload at 16
  1744  (1084)                  %
  1745  (1085)                  % DERIVED, NEVER HARD-CODED. 16 is only right for a ten-character
  1746  (1086)                  % room name; the parameter block moves with the name, and a
  1747  (1087)                  % constant here would break the moment /join names a longer room.
  1748  (1088)                  %
  1749  (1089)                  % The alternative reading - 6 + the name length - fits this one
  1750  (1090)                  % capture just as well and is WRONG in general: it cannot see a
  1751  (1091)                  % second parameter block, and XSLET has an optional third.
  1752  (1092)                  %
  1753  (1093)                  % The payload is slid down to offset 0 so that handleMessage
  1754  (1094)                  % parses one layout and one only. Every other route into it -
  1755  (1095)                  % an ordinary XMTNO message straight from a magic number - has no
  1756  (1096)                  % header at all, and this is the single place that knows that.
  1757  (1097)                  % ---- A MESSAGE OF OURS THAT COULD NOT BE DELIVERED ----------
  1758  (1098)                  % This is what XFSEC bought, and it has to be caught BEFORE
  1759  (1099)                  % handleMessage: the bytes in inBuf are our own outgoing Said or
  1760  (1100)                  % Joined coming home, so parsing them as an arrival would have
  1761  (1101)                  % the room answering itself.
  1762  (1102)                  %
  1763  (1103)                  % THE QUESTION THIS BRANCH WAS BUILT TO ANSWER, AND THE ANSWER.
  1764  (1104)                  %
  1765  (1105)                  % A returned message carries what WE wrote, and what we wrote
  1766  (1106)                  % names the SPEAKER, not the member it could not reach - so it
  1767  (1107)                  % was not obvious that anything here identifies the destination.
  1768  (1108)                  % XMPFMST hands back a magic number for an ordinary arrival; the
  1769  (1109)                  % guide never says what that field holds on a returned one.
  1770  (1110)                  %
  1771  (1111)                  % MEASURED 2026-08-18 on D100, and it IS the destination:
  1772  (1112)                  %
  1773  (1113)                  %   SV: returned msg, st=  16915
  1774  (1114)                  %   SV: it names slot          2
  1775  (1115)                  %   SV: reaped dead slot       2
  1776  (1116)                  %
  1777  (1117)                  % 16915 is XMXEIMA, "Invalid magic number" - the reason the
  1778  (1118)                  % message came home. Note where that code turned up: as the
  1779  (1119)                  % REASON ON A RETURN, not as the status of the send. The first
  1780  (1120)                  % attempt at this fix tested XMPSEND's own status for exactly
  1781  (1121)                  % that number and never fired, because XMPSEND answered XMOK and
  1782  (1122)                  % handed the message to a port that was already gone.
  1783  (1123)                  %
  1784  (1124)                  % The slot print stays. It costs nothing - a member has to die
  1785  (1125)                  % before it runs - and it separates "one of ours bounced" from
  1786  (1126)                  % "something bounced", which is the first thing an operator
  1787  (1127)                  % needs to know and the one thing the reap line cannot say.
  1788  (1128)                  IF msgType = XMTRE THEN
  1789  (1129)                      OUTPUT(1, 'AL22', 'SV: returned msg, st= ')
  1790  (1130)                      OUTPUT(1, 'I6', receiveStat)
  1791  (1131)                      OUTPUT(1, 'AL1', '$')
  1792  (1132)  
  1793  (1133)                      findByMagic(senderMagic) =: wasMember
  1794  (1134)                      OUTPUT(1, 'AL22', 'SV: it names slot     ')
  1795  (1135)                      OUTPUT(1, 'I6', wasMember)
  1796  (1136)                      OUTPUT(1, 'AL1', '$')
  1797  (1137)  
  1798  (1138)                      IF wasMember >< 0 THEN
  1799  (1139)                          1 =: memberDead(wasMember)
  1800  (1140)                          1 =: deadFound
  1801  (1141)                      ENDIF
  1802  (1142)                  ELSE
  1803  (1143)                  IF msgType = XMROU THEN
  1804  (1144)                      % THE SERVICE BYTE, TAKEN BEFORE ANYTHING MOVES. The payload
  1805  (1145)                      % is slid down to offset 0 below, so by the time the seat
  1806  (1146)                      % rule runs inBuf(1) is chat data, not the header. Reading
  1807  (1147)                      % it there is how the feedback loop went unnoticed in
  1808  (1148)                      % review - the test looked right and was inspecting the
  1809  (1149)                      % wrong bytes.
  1810  (1150)                      inBuf(1) =: letterService
  1811  (1151)  
  1812  (1152)                      4 + inBuf(2) * 256 + inBuf(3) =: payloadAt
  1813  (1153)  
  1814  (1154)                      % A letter with nothing behind the header is a connect this
  1815  (1155)                      % program has no answer for. Dropping it says so; the seat is
  1816  (1156)                      % already spent either way. Note this is >=, not >: a payload
  1817  (1157)                      % that starts exactly AT the end is an empty payload.
  1818  (1158)                      IF payloadAt >= readLength THEN
  1819  (1159)                          OUTPUT(1, 'AL24', 'SV: DROP empty letter   ')
  1820  (1160)                          OUTPUT(1, 'AL1', '$')
  1821  (1161)                      ELSE
  1822  (1162)                          % (the seat for this arrival is settled after
  1823  (1163)                          %  handleMessage, by the one rule below)
  1824  (1164)                          readLength - payloadAt =: readLength
  1825  (1165)                          FOR i IN 1:readLength DO
  1826  (1166)                              inBuf(payloadAt + i - 1) =: inBuf(i - 1)
  1827  (1167)                          ENDFOR
  1828  (1168)  
  1829  (1169)                          % ---- SEAT ACCOUNTING, and it belongs HERE ----------
  1830  (1170)                          % The seat is spent by the ARRIVAL of a routed message,
  1831  (1171)                          % not by any particular kind of message inside it. Doing
  1832  (1172)                          % it per kind is what the C# side got wrong: a letter
  1833  (1173)                          % carrying anything but a join, or a letter too damaged
  1834  (1174)                          % to decode at all, never reaches a handler - so no
  1835  (1175)                          % handler can give its seat back, and the room silently
  1836  (1176)                          % loses a seat for good.
  1837  (1177)                          %
  1838  (1178)                          % XROUT decremented its free-connection counter to get
  1839  (1179)                          % this letter here, so a seat is already spent by the
  1840  (1180)                          % time this line runs. There are now exactly two places
  1841  (1181)                          % that give one back, and between them they cover both
  1842  (1182)                          % ways a member can stop being one:
  1843  (1183)                          %
  1844  (1184)                          %   handleMessage, kLeave   they said goodbye;
  1845  (1185)                          %   reapDead                they did not, and a send to
  1846  (1186)                          %                           them came back saying the
  1847  (1187)                          %                           port is gone.
  1848  (1188)                          findByMagic(senderMagic) =: wasMember
  1849  (1189)  
  1850  (1190)                          handleMessage
  1851  (1191)                      ENDIF
  1852  (1192)  
  1853  (1193)                      % ---- THE SEAT BELONGS TO THE ARRIVAL, SO SETTLE IT HERE ----
  1854  (1194)                      % MEASURED 2026-08-18 by a load run: twenty C# clients joined
  1855  (1195)                      % at once and CHAT-LOBBY went from 16 free seats to 2 and
  1856  (1196)                      % stayed there, even though every welcomed member left again
  1857  (1197)                      % cleanly. Fourteen seats gone.
  1858  (1198)                      %
  1859  (1199)                      % The comment a few lines up has described this hole all
  1860  (1200)                      % along - "a letter carrying anything but a join, or a letter
  1861  (1201)                      % too damaged to decode at all, never reaches a handler - so
  1862  (1202)                      % no handler can give its seat back" - and named it as
  1863  (1203)                      % something the C# side got wrong. It was wrong HERE too. The
  1864  (1204)                      % code only ever returned a seat on a clean /leave or a reap,
  1865  (1205)                      % so an empty letter, a join refused because the name was
  1866  (1206)                      % taken, and a letter from a stranger each cost a seat for
  1867  (1207)                      % good. Under a burst that is most of them.
  1868  (1208)                      %
  1869  (1209)                      % ONE RULE, APPLIED TO EVERY LETTER: XROUT spent a seat to
  1870  (1210)                      % deliver this, so if the sender is not sitting in the room
  1871  (1211)                      % once we have finished with it, nobody is holding that seat
  1872  (1212)                      % and it must go straight back.
  1873  (1213)                      %
  1874  (1214)                      % This does NOT double-count with the /leave and reapDead
  1875  (1215)                      % paths. A leave arrives as an ORDINARY message, port to
  1876  (1216)                      % port, and never comes through this branch at all - only the
  1877  (1217)                      % JOIN is a letter. So each member's seat is returned exactly
  1878  (1218)                      % once, by whichever of the three applies.
  1879  (1219)                      %
  1880  (1220)                      % KNOWN GAP, said plainly rather than left to be discovered:
  1881  (1221)                      % a letter from somebody who IS already a member keeps its
  1882  (1222)                      % seat and should not. Clients send port to port after
  1883  (1223)                      % joining, so it does not arise in normal use, and guessing a
  1884  (1224)                      % fix for a case never seen would be worse than naming it.
  1885  (1225)                      % ---- ONLY A REAL LETTER SPENT A SEAT --------------------
  1886  (1226)                      % MEASURED, and it is the worst kind of bug: a FEEDBACK
  1887  (1227)                      % LOOP that this very block created. Four users joined and
  1888  (1228)                      % left, and CHAT-LOBBY went from 16 free seats to 3470 while
  1889  (1229)                      % the terminal filled with "DROP empty letter" for ever.
  1890  (1230)                      %
  1891  (1231)                      % Here is the loop. Returning a seat means sending XMPINFC
  1892  (1232)                      % to XROUT. XROUT ANSWERS, and its answer arrives back on
  1893  (1233)                      % this very port as a routed message with no chat payload -
  1894  (1234)                      % which the code above drops as an empty letter, and which
  1895  (1235)                      % this rule then read as "a letter whose sender is not a
  1896  (1236)                      % member", so it returned ANOTHER seat, which produced
  1897  (1237)                      % ANOTHER answer. The note at the foot of this file has
  1898  (1238)                      % warned since the first version that the XMPINFC reply
  1899  (1239)                      % "comes back later on our own port as an ordinary message"
  1900  (1240)                      % and that ignoring it was "safe by accident until somebody
  1901  (1241)                      % says so". It stopped being safe the moment this rule
  1902  (1242)                      % started acting on every routed arrival.
  1903  (1243)                      %
  1904  (1244)                      % THE DISCRIMINATOR IS BYTE 1. A client's letter carries the
  1905  (1245)                      % XSLET service number, 65. XROUT OVERWRITES that byte with
  1906  (1246)                      % a return status when it answers - the header comment in
  1907  (1247)                      % the receive loop says so, and it is the same test the C#
  1908  (1248)                      % load client uses to spot a refused letter. So a letter
  1909  (1249)                      % with 65 in byte 1 came from a client and spent a seat;
  1910  (1250)                      % anything else is XROUT talking to us and spent nothing.
  1911  (1251)                      IF letterService = XSLET THEN
  1912  (1252)                          findByMagic(senderMagic) =: nowMember
  1913  (1253)                          IF nowMember = 0 THEN
  1914  (1254)                              xmpinfc(0, myPort, 1, 0) =: returnStatus
  1915  (1255)                              IF returnStatus >< XMOK THEN
  1916  (1256)                                  OUTPUT(1, 'AL22', 'SV: seat return failed')
  1917  (1257)                                  OUTPUT(1, 'I6', returnStatus)
  1918  (1258)                                  OUTPUT(1, 'AL1', '$')
  1919  (1259)                              ENDIF
  1920  (1260)                          ENDIF
  1921  (1261)                      ENDIF
  1922  (1262)                  ELSE
  1923  (1263)                      % No header on this path: an ordinary message sent straight
  1924  (1264)                      % to our magic number is exactly the bytes the peer wrote.
  1925  (1265)                      handleMessage
  1926  (1266)                  ENDIF
  1927  (1267)                  ENDIF
  1928  (1268)  
  1929  (1269)                  % ---- AND NOW BURY ANYBODY WHO TURNED OUT TO BE GONE ---------
  1930  (1270)                  % One place, after everything the arrival caused has finished,
  1931  (1271)                  % because that is the only depth at which outBuf is free. Both
  1932  (1272)                  % branches above lead here on purpose: a member can be found
  1933  (1273)                  % dead by any broadcast, and the routed and direct paths both
  1934  (1274)                  % broadcast.
  1935  (1275)                  IF deadFound >< 0 THEN
  1936  (1276)                      reapDead
  1937  (1277)                  ENDIF
  1938  (1278)              ENDIF
  1939  (1279)          ENDDO
  1940  (1280)      ENDROUTINE
  1941  (1281)  
  1942  (1282)  ENDMODULE
