   116    (41)  CONSTANT XFCLS=11            % Close port
   117    (42)  CONSTANT XFSND=12            % Send message to a remote port
   118    (43)  CONSTANT XFRCV=13            % Receive a message on a given port
   119    (44)  CONSTANT XFPST=14            % Get local port status
   120    (45)  CONSTANT XFGST=15            % General status or wait
   121    (46)  CONSTANT XFSIN=16            % Service initialisation function
   122    (47)  %        XFSRL=17            % Service release function (obsolete)
   123    (48)  CONSTANT XFABR=18            % Absolute read block from POF area
   124    (49)  %        XFABW=19            % Absolute write block to POF area (obsolete)
   125    (50)  %        XFMLK=20            % Lock message system (obsolete)
   126    (51)  %        XFMUL=21            % Unlock message system (obsolete)
   127    (52)  CONSTANT XFM2P=22            % Magic number to port id.
   128    (53)  CONSTANT XFP2M=23            % Port to magic number
   129    (54)  %        XFRIN=24            % Routing initialise (obsolete)
   130    (55)  CONSTANT XFCRD=25            % Create driver with context
   131    (56)  CONSTANT XFSTD=26            % Start driver
   132    (57)  %        XFDIB=27            % Define indirect buffer (obsolete)
   133    (58)  %        XFRIB=28            % Read from indirect buffer (obsolete)
   134    (59)  %        XFWIB=29            % Write to indirect buffer (obsolete)
   135    (60)  CONSTANT XFPRV=30            % Request privilege
   136    (61)  CONSTANT XFRTN=31            % Write word 0 and return message
   137    (62)  CONSTANT XFRRH=32            % Receive message and read word 0
