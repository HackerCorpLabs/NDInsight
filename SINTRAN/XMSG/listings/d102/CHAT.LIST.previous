   761   (172)         (ROUTINE VOID,INTEGER(BYTES,INTEGER READ WRITE,INTEGER4,INTEGER):&
   762   (173)          xmpbadb),&
   763   (174)         (ROUTINE VOID,INTEGER(BYTES,INTEGER READ WRITE,BYTES,INTEGER):&
   764   (175)          xmpbast)
   765   (176)  
   766   (177)  IMPORT (ROUTINE INTEGER,VOID(INTEGER WRITE):&
   767   (178)          xmpxets),&
   768   (179)         (ROUTINE INTEGER,VOID(INTEGER WRITE):&
   769   (180)          xmpxrts)
   770   (181)  
   771   (182)  %-----------------------------------------------------------------------------%
   772   (183)  $EOF
   773   (113)  
   774   (114)      % MON1 IS INBIT - read one byte from a device. This is how PLANC reaches a
   775   (115)      % monitor call: the runtime provides them as ordinary routines named MONn,
   776   (116)      % declared exactly like this, and the COSMOS guide's own sample does the
   777   (117)      % same thing one call along with IMPORT (ROUTINE VOID,VOID: MONO) for MON0.
   778   (118)      % The signature is copied from ND-60.117.5 appendix 0.2:
   779   (119)      %
   780   (120)      %     ROUTINE VOID, BYTE ( INTEGER ) : MON1 (dev)
   781   (121)      %
   782   (122)      % NOT MONITOR_CALL. That wants either a MON-CALL-NAMES file this machine
   783   (123)      % does not have, or generates 5MON_P which neither PLANC runtime defines.
   784   (124)      IMPORT ( ROUTINE VOID, BYTE (INTEGER) : MON1 )
   785   (125)  
   786   (126)      % ----- THE THREE MORE THAT CHAT:CNFG NEEDS ------------------------------
   787   (127)      % All copied from ND-60.117.5 EN PLANC Reference Manual, the MONn appendix,
   788   (128)      % which is the ONLY place these signatures are written down correctly:
   789   (129)      %
   790   (130)      %     ROUTINE VOID, INTEGER ( BYTES, BYTES, INTEGER ) : MON50 (file, default, code)
   791   (131)      %     ROUTINE BYTE, VOID ( INTEGER )                  : MON2  (dev)
   792   (132)      %     ROUTINE VOID, VOID ( INTEGER )                  : MON43 (dev)
   793   (133)      %
   794   (134)      % MON50 RETURNS THE DEVICE NUMBER and raises a ROUTINEERROR on failure - it
   795   (135)      % has no status out-parameter, so a missing file can only be learned by
   796   (136)      % catching the raise. MON2 takes the byte as its IN-VALUE, which is why it
   797   (137)      % is called "b MON2(dev)" and not "MON2(dev, b)".
   798   (138)      %
   799   (139)      % MON43 IS CLOSE, AND IT IS NOT 54. A note in this file used to list the
   800   (140)      % available calls as "50/54/1/2", which reads as though 54 were the close.
   801   (141)      % The manual's own table says otherwise: 43B is CloseFile and 54B is
   802   (142)      % DeleteFile. Getting that wrong would not have failed to compile - it
   803   (143)      % would have deleted the user's config file every time they set a nickname.
   804   (144)      IMPORT ( ROUTINE VOID, INTEGER (BYTES, BYTES, INTEGER) : MON50 )
   805   (145)      IMPORT ( ROUTINE BYTE, VOID (INTEGER) : MON2 )
   806   (146)      IMPORT ( ROUTINE VOID, VOID (INTEGER) : MON43 )
   807   (147)  
   808   (148)      % MON70 IS CALLCOMMAND - hand SINTRAN a line as if it had been typed.
   809   (149)      %
   810   (150)      %     ROUTINE VOID, VOID ( BYTES ) : MON70 (command)
   811   (151)      %
   812   (152)      % Needed because CREATING a file is its own monitor call, CreateFile /
   813   (153)      % CRALF 221B, and 221 is NOT among the MONn routines the PLANC runtime
   814   (154)      % provides - the appendix stops at MON263 and has no 221. MON50 opens what
   815   (155)      % exists; it has no size parameter and cannot make a file. See writeCnfg.
   816   (156)      IMPORT ( ROUTINE VOID, VOID (BYTES) : MON70 )
   817   (157)  
   818   (158)      % CreateFile, CRALF 221B - TESTED, AND IT IS NOT THERE.
   819   (159)      %
   820   (160)      %   Brl: LIST-ENTRIES-UNDEFINED
   821   (161)      %   MON221...10101 U
   822   (162)      %
   823   (163)      % The comment further down says 221 "is not among the MONn routines the PLANC
   824   (164)      % runtime provides", and the whole CREATE-FILE-through-MON70 detour rests on
   825   (165)      % it. That claim had never been TESTED - the list it came from is a floor
   826   (166)      % rather than a fence, since MON43 and MON70 are both missing from it and
   827   (167)      % both link - so it was worth one build to find out. It turns out to be
   828   (168)      % RIGHT: there is no MON221 on this machine, and the detour is justified.
   829   (169)      %
   830   (170)      % Measured on D100 2026-08-19, by importing each and reading the linker:
   831   (171)      %
   832   (172)      %   MON43  CloseFile        resolves      (absent from the documented list)
   833   (173)      %   MON70  CallCommand      resolves      (absent from the documented list)
   834   (174)      %   MON221 CreateFile       UNDEFINED
   835   (175)      %   MON317 ExecuteCommand   UNDEFINED
   836   (176)      %
   837   (177)      % So creating a file from PLANC on D100 needs the command route below, or
   838   (178)      % MON-CALL-1BANK:BRF linked in so Monitor_Call('CreateFile',...) works, or a
   839   (179)      % MAC interface routine for 221 loaded ahead of the runtime.
   840   (180)      %
   841   (181)      % The IMPORT is kept as a comment, not deleted, so nobody spends the cycle
   842   (182)      % again:
   843   (183)      %   IMPORT ( ROUTINE VOID, VOID (BYTES, INTEGER4, INTEGER4) : MON221 )
   844   (184)      %
   845   (185)      % Signature straight out of the VENDOR MANUAL - ND-860228-2-EN SINTRAN III
   846   (186)      % Monitor Calls, page 125, its own PLANC block:
   847   (187)      %
   848   (188)      %   INTEGER4 : StartAddress, NoOfPages
   849   (189)      %   BYTES : FileName(0:63)
   850   (190)      %   ON ROUTINEERROR DO
   851   (191)      %       IF ErrCode > 0 THEN ...
   852   (192)      %   ENDON
   853   (193)      %   Monitor_Call('CreateFile', FileName, StartAddress, NoOfPages)
   854   (194)      %
   855   (195)      % (Monitor_Call itself does not work on D100 - see PLANC-MONITOR-CALLS.md -
   856   (196)      % so the same three parameters go to MON221 instead.)
   857   (197)      %
   858   (198)      % A SIXTY-FOUR BYTE NAME BUFFER, for the same reason MON70 wants eighty: a
   859   (199)      % PLANC BYTES argument carries its own length, so a short literal hands the
   860   (200)      % call a short buffer. The manual's FORTRAN form agrees - CHARACTER
   861   (201)      % FileName*64.
   862   (202)      %
   863   (203)      % StartAddress 0 and NoOfPages 0 both mean "an ordinary indexed file that
   864   (204)      % grows as it is written", which is what a one-line config file wants. PLANC
   865   (205)      % cannot pass an INTEGER4 as a constant, so they are variables.
   866   (206)      %
   867   (207)      % ONE DISAGREEMENT WORTH KNOWING: the repo's own
   868   (208)      % Developer\MON\calls\221B_CreateFile.yaml lists both sizes as INTEGER2 in
   869   (209)      % its parameter table, while the MANUAL's PLANC, FORTRAN (INTEGER*4) and
   870   (210)      % COBOL (S9(10)) forms all say four bytes, and its MAC example calls the size
   871   (211)      % "a double word". The manual wins here; the YAML table looks like an
   872   (212)      % extraction slip.
   873   (213)      %
   874   (214)      % The IMPORT is commented out because MON221 does not link on this machine -
   875   (215)      % see the measurement above. Restore it if MON-CALL-1BANK:BRF is ever
   876   (216)      % installed, or if a MAC interface routine for 221 is written.
   877   (217)      %   IMPORT ( ROUTINE VOID, VOID (BYTES, INTEGER4, INTEGER4) : MON221 )
   878   (218)  
   879   (219)      % MON317 - ExecuteCommand, UECOM 317B - IS NOT AVAILABLE ON D100. TESTED.
   880   (220)      %
   881   (221)      % It was imported here and used instead of MON70, because the Monitor Calls
   882   (222)      % manual recommends it ("An error message is output if an error occurs. The
   883   (223)      % program does not terminate") and an error message is exactly what this
   884   (224)      % stubborn CREATE needed. The linker answered:
   885   (225)      %
   886   (226)      %   Brl: LIST-ENTRIES-UNDEFINED
   887   (227)      %   MON317...10020 U
   888   (228)      %
   889   (229)      % So the PLANC runtime on this machine carries no MON317, and the import is
   890   (230)      % left here as a COMMENT rather than deleted so nobody spends the cycle
   891   (231)      % again. Reaching UECOM would need a hand-written MAC interface routine
   892   (232)      % loaded ahead of PLANC-1BANK-F00.
   893   (233)      %
   894   (234)      % AND THE BUILD DID NOT FAIL. BRF-LINKER wrote a runnable CHAT:PROG with the
   895   (235)      % entry still undefined, @CHAT started it, and it behaved oddly in a way
   896   (236)      % that looked like evidence about the CREATE. It was not evidence about
   897   (237)      % anything. LIST-ENTRIES-UNDEFINED is in the build for this reason and its
   898   (238)      % output has to be READ - nothing else fails.
   899   (239)  
   900   (240)      % ----- message kinds, mirroring ChatMessageKind.cs ----------------------
   901   (241)      INTEGER : kJoin    := 1
   902   (242)      INTEGER : kWelcome := 2
   903   (243)      INTEGER : kReject  := 3
   904   (244)      INTEGER : kSay     := 4
   905   (245)      INTEGER : kSaid    := 5
   906   (246)      INTEGER : kLeave   := 6
   907   (247)      INTEGER : kJoined  := 7
   908   (248)      INTEGER : kLeft    := 8
   909   (249)      INTEGER : kRename  := 9
   910   (250)      INTEGER : kRenamed := 10
   911   (251)  
   912   (252)      % ONE KIND, BOTH DIRECTIONS. We send it with an empty text to ask; the room
   913   (253)      % answers with the same kind and the members' names in the text, separated
   914   (254)      % by single spaces. A second kind for the reply would buy nothing - we know
   915   (255)      % we asked, and a room never asks us.
   916   (256)      %
   917   (257)      % This is the eleventh kind, and the note that stood here saying there was
   918   (258)      % no eleventh kind is now wrong and has gone. What it warned about still
   919   (259)      % holds and is worth keeping in plain words: kHello lived here for one day
   920   (260)      % as half of a handshake we invented, and it was wrong because the sender's
   921   (261)      % address arrives WITH the message - there was nothing to hand shake about.
   922   (262)      % /who is different: the membership list is real information that only the
   923   (263)      % room has, so there is something to ask for.
   924   (264)      INTEGER : kWho     := 11
   925   (265)  
   926   (266)      INTEGER : ownTerminal := 1        % device number of your own terminal
   927   (267)      % BACK TO 0, AND 1 IS WORSE. BOTH VALUES MEASURED ON D100, 2026-08-21.
   928   (268)      %
   929   (269)      % With 0: TerminalNoWait SUCCEEDS - no error - and MON1 still blocks, so a
   930   (270)      % listener sees nothing until they press return, at which point the queued
   931   (271)      % lines all arrive at once:
   932   (272)      %
   933   (273)      %     ANNA:
   934   (274)      %     ANNA: NOWAIT-PROOF-LINE
   935   (275)      %
   936   (276)      % With 1: NOTHING IS SHOWN AT ALL, not even on return. The client still
   937   (277)      % joins - X-C LIST-NAMES showed its seat spent - and the server still sends
   938   (278)      % to it: its log recorded "SV bcast sent to  2" for the very lines that
   939   (279)      % never appeared. So the messages arrive at a client that displays none of
   940   (280)      % them, which is strictly worse than the press-return behaviour.
   941   (281)      %
   942   (282)      % 0 IS THEREFORE THE SAFE VALUE UNTIL THIS IS UNDERSTOOD. What 1 actually
   943   (283)      % does is UNVERIFIED - the obvious guess is that it switches the side the
   944   (284)      % terminal READ waits on and the loop then never blocks NOR draws, but
   945   (285)      % nothing has been measured to say so, and the guess that 0 meant "output"
   946   (286)      % has already been wrong once here.
   947   (287)      %
   948   (288)      % Note that terminalWait, the restore on exit, calls NoWaitSwitch - the name
   949   (289)      % that is REFUSED on this machine - so the terminal is never actually put
   950   (290)      % back. That wants fixing before any more experiments with this flag.
   951   (291)      INTEGER : inputFlag   := 0
   952   (292)      INTEGER : noWaitOn    := 1        % any non-zero switches no-wait ON
   953   (293)      INTEGER : noWaitOff   := 0        % and zero switches it back off again
   954   (294)      INTEGER : parityMask  := 127      % strip the even-parity bit, see above
   955   (295)      INTEGER : carriageRet := 13
   956   (296)      INTEGER : emptyInput  := 3        % InByte in no-wait: nothing was typed
   957   (297)  
   958   (298)      % The idle sleep, so the poll loop is a POLL and not a SPIN. Unit type 1 is
   959   (299)      % basic time units of 1/50 second, so 10 is a fifth of a second: fast enough
   960   (300)      % that an arriving line looks instant, slow enough to cost nothing.
   961   (301)      %
   962   (302)      % CHATSV carries the hard-won version of this note: a bare loop with no
   963   (303)      % sleep is not an option. When XMSG died under the server, its receive
   964   (304)      % stopped blocking and the loop burned the machine until somebody pressed
   965   (305)      % ESC. The same trap is waiting here the moment the terminal stops blocking.
   966   (306)      INTEGER : sleepUnits := 10
   967   (307)      INTEGER : sleepKind  := 1
   968   (308)      INTEGER : sleepWhy   := 0
   969   (309)  
   970   (310)      % How many messages the last drain pass printed. Set by drainPort, read by
   971   (311)      % the main loop to decide whether the pass found anything at all.
   972   (312)      INTEGER : lastDrainCount := 0
   973   (313)  
   974   (314)      % The ErrCode from the last refused no-wait switch. Module level because a
   975   (315)      % PLANC local cannot be read after its ON block has run, and the number is
   976   (316)      % the whole point of the attempt - see terminalNoWait.
   977   (317)      INTEGER : firstErr := 0
   978   (318)      % How many messages one drain pass will take before going back to the
   979   (319)      % keyboard. See drainPort: the unbounded version hung on the first run.
   980   (320)      INTEGER : maxDrain    := 32
   981   (321)  
   982   (322)      INTEGER ARRAY : stack(0:1000)
   983   (323)  
   984   (324)      BYTES : letterBuf(0:63)           % the XSLET header XMPBLET builds
   985   (325)      BYTES : outBuf(0:255)             % our own message, sent after the header
   986   (326)      % SIZE OF inBuf, named because the read below must clamp against it. XMSG
   987   (327)      % reports the sender's message size; nothing stops that being larger than
   988   (328)      % this array, and PLANC checks no bound.
   989   (329)      INTEGER : inBufSize := 256
   990   (330)      BYTES : inBuf(0:255)              % what arrives, inBufSize bytes
   991   (331)      % THE LINE BEING TYPED, and its size is a named constant because the loop
   992   (332)      % below has to test against it. PLANC does not check array bounds: without
   993   (333)      % the test, an 81st character is written past the end of this array and into
   994   (334)      % whatever the compiler laid out next - which here is roomName, typedLen,
   995   (335)      % serverMagic and joined. A user holding a key down would quietly corrupt
   996   (336)      % the program's own state.
   997   (337)      % THE LONGEST ROOM OR NICK NAME a command may carry. This was USED by
   998   (338)      % handleCommand and never DECLARED - the compiler answered ILLEGAL SYNTAX
   999   (339)      % "MAXNAMELEN" twice, the loader pass built CHAT:PROG regardless, and every
  1000   (340)      % /join and /nick then answered "too long" for any argument at all. A build
  1001   (341)      % with errors still produces a program; only the LISTING says otherwise.
  1002   (342)      INTEGER : maxNameLen := 16
  1003   (343)      INTEGER : maxTyped := 80
  1004   (344)      BYTES : typed(0:79)               % 0:maxTyped-1
  1005   (345)  
  1006   (346)      % One character wide, so a BYTE can be printed as a CHARACTER: 'ALn' formats
  1007   (347)      % a STRING, and handing it a byte prints the byte's NUMBER instead. See
  1008   (348)      % showArrived, where that turned RONNY into 8279787889 on screen.
  1009   (349)      BYTES : oneChar(0:0)
  1010   (350)  
  1011   (351)      % TWENTY-ONE BYTES OF STORAGE, NOT A LITERAL - and this was a live defect,
  1012   (352)      % not tidying. It was BYTES : roomName := 'CHAT-LOBBY', exactly ten bytes,
  1013   (353)      % while /join accepts an argument up to maxNameLen = 16 and copies it in
  1014   (354)      % here. Eleven characters onwards wrote past the end, into whatever the
  1015   (355)      % loader laid out next. The comment on "typed" above already warns that
  1016   (356)      % roomName is what an overlong typed line runs into; roomName had the same
  1017   (357)      % fault pointing at whatever follows IT.
  1018   (358)      %
  1019   (359)      % Twenty-one is the prefix (5) plus the room's own limit (16).
  1020   (360)      BYTES : roomName(0:20)
  1021   (361)      INTEGER : lenRoomName := 10
  1022   (362)  
  1023   (363)      % THE PREFIX EVERY ROOM'S REGISTERED NAME CARRIES, and forgetting it is
  1024   (364)      % why /join never worked.
  1025   (365)      %
  1026   (366)      % ChatRooms.NamePrefix in the C# library says "CHAT-", and ChatRooms.NameFor
  1027   (367)      % builds "CHAT-" + the room's short name in upper case. So the LOBBY room is
  1028   (368)      % registered with XROUT as CHAT-LOBBY. /join used to copy the typed argument
  1029   (369)      % in raw, so "/join GENERAL" asked XROUT for a name called GENERAL - which no
  1030   (370)      % room ever registers. XROUT answered "no such name" and the client sat in
  1031   (371)      % the room it was already in, which is exactly the reported symptom.
  1032   (372)      %
  1033   (373)      % The startup default below is built the same way, from the prefix and the
  1034   (374)      % short name, so there is one rule and not two.
  1035   (375)      % THE SERVICE NAME. A CONSTANT - it is not built from the room any more.
  1036   (376)      %
  1037   (377)      % This used to be roomPrefix := 'CHAT-', and setRoom pasted the typed room
  1038   (378)      % onto it to make a PORT NAME, so joining a room meant addressing a
  1039   (379)      % different port. One port now; the room rides in the message. See
  1040   (380)      % the_room_model in DOC/protocols/chat-wire.json.
  1041   (381)      BYTES : servName := '*CHAT'
  1042   (382)      INTEGER : lenServName := 5
  1043   (383)  
  1044   (384)      % The room joined at start-up when nobody says otherwise. SHORT name: the
  1045   (385)      % prefix is added by setRoom, the same as for a typed /join.
  1046   (386)      BYTES : homeRoom := 'LOBBY'
  1047   (387)      INTEGER : lenHomeRoom := 5
  1048   (388)      BYTES : hereSystem := ''          % length 0 means the LOCAL system
  1049   (389)      INTEGER : lenHereSystem := 0
  1050   (390)  
  1051   (391)      % SIXTEEN BYTES OF STORAGE, NOT A LITERAL, and the change is not cosmetic.
  1052   (392)      %
  1053   (393)      % This was BYTES : myName := 'RONNY', which reserves five bytes and exactly
  1054   (394)      % five. Asking for a longer name would have written past the end of it into
  1055   (395)      % whatever the loader happened to put next, with nothing to stop it - PLANC
  1056   (396)      % checks no array bound. The same defect, in the other direction, is what
  1057   (397)      % the guard in CHATSV.handleMessage exists for.
  1058   (398)      %
  1059   (399)      % Sixteen is the ROOM's number: ChatRoom.MaxNicknameLength says sixteen and
  1060   (400)      % CHATSV drops anything longer, so a name this side cannot send is one the
  1061   (401)      % other side would refuse anyway.
  1062   (402)      BYTES : myName(0:15)
  1063   (403)      INTEGER : lenMyName := 5
  1064   (404)  
  1065   (405)      % The name used when nobody types one AND nothing was remembered. Kept as a
  1066   (406)      % separate literal because myName is now a buffer and has to be filled at
  1067   (407)      % start-up rather than declared full - see setupName.
  1068   (408)      BYTES : defaultName := 'RONNY'
  1069   (409)      INTEGER : lenDefault := 5
  1070   (410)  
  1071   (411)      % ----- CHAT:CNFG, the remembered nickname -------------------------------
  1072   (412)      % IN THE USER'S OWN FILE AREA, which is the whole point: OLAV and ANNA log
  1073   (413)      % in as themselves and each gets their own. Nothing here names a user -
  1074   (414)      % SINTRAN resolves an unqualified name against whoever is logged in, so the
  1075   (415)      % separation is free and cannot be got wrong.
  1076   (416)      %
  1077   (417)      % MEASURED 2026-08-18 on D100: user OLAV, "@CREATE-FILE CHAT:CNFG,1"
  1078   (418)      % succeeded and "@CHAT" ran from that user's terminal, so both halves - a
  1079   (419)      % writable file of one's own, and permission to run the client - are real
  1080   (420)      % rather than assumed.
  1081   (421)      %
  1082   (422)      % THE FILE IS ONE LINE: the nickname, ended by a carriage return.
  1083   (423)      % Deliberately not a key=value format. There is one setting, a reader that
  1084   (424)      % has to parse nothing cannot misparse anything, and a person can fix it
  1085   (425)      % with any editor on the machine.
  1086   (426)      BYTES : cnfgName   := 'CHAT'
  1087   (427)      BYTES : cnfgType   := 'CNFG'
  1088   (428)  
  1089   (429)      % MAKING THE FILE IS A COMMAND, NOT AN OPEN, and that cost a build cycle.
  1090   (430)      %
  1091   (431)      % The first version passed the name QUOTED to MON50 - '"CHAT"' - on the
  1092   (432)      % rule that quoting is what asks SINTRAN to create. MEASURED 2026-08-18 as
  1093   (433)      % user ANNA, who had no config file: the open did not fail loudly, but
  1094   (434)      % every MON2 after it raised, and afterwards LIST-FILES showed ANNA still
  1095   (435)      % owned no files at all. Nothing was created.
  1096   (436)      %
  1097   (437)      % The reason is in the manual rather than in the quoting: creating a file
  1098   (438)      % is its OWN monitor call, CreateFile / CRALF 221B, and 221 is not among
  1099   (439)      % the MONn routines the PLANC runtime provides. MON50 opens; it has no size
  1100   (440)      % parameter and cannot make a file that is not there.
  1101   (441)      %
  1102   (442)      % So the file is made the way a person would make it, by handing SINTRAN
  1103   (443)      % the command - MON70, CallCommand. One page, which is far more than one
  1104   (444)      % line needs.
  1105   (445)      %
  1106   (446)      % NO QUOTES, AND THE QUOTES ARE WHY THIS NEVER WORKED.
  1107   (447)      %
  1108   (448)      % This read 'CREATE-FILE "CHAT:CNFG",1' from the day it was written, and
  1109   (449)      % measured on D100 2026-08-19 that command answers
  1110   (450)      %
  1111   (451)      %   @CREATE-FILE "CHAT:CNFG",1
  1112   (452)      %   ILLEGAL CHARACTER IN PARAMETER
  1113   (453)      %
  1114   (454)      % while the unquoted form succeeds silently. So the file was NEVER created,
  1115   (455)      % every save failed, and CHAT:CNFG did not exist for any user.
  1116   (456)      %
  1117   (457)      % THE TRAP IS THAT QUOTES MEAN OPPOSITE THINGS ON THE TWO ROUTES:
  1118   (458)      %
  1119   (459)      %   MON50(file, ...)   quoting the name means CREATE IT IF ABSENT
  1120   (460)      %   CREATE-FILE <name> quoting the name is an ILLEGAL CHARACTER
  1121   (461)      %
  1122   (462)      % The quotes here were carried over from the MON50 attempt described above,
  1123   (463)      % where they were correct, into the command that replaced it, where they are
  1124   (464)      % fatal. A local filespec takes no quotes; the quoting rule is for REMOTE
  1125   (465)      % ones, where the name goes to another machine's command processor.
  1126   (466)      %
  1127   (467)      % AND THE COMMAND MUST END WITH AN APOSTROPHE, which is the second half of
  1128   (468)      % why this never worked. Removing the quotes alone was not enough - measured
  1129   (469)      % on D100 2026-08-19, CHAT:CNFG still did not appear.
  1130   (470)      %
  1131   (471)      % The Monitor Calls manual's own worked example gives the rule, in its
  1132   (472)      % ASSEMBLY-500 section under CallCommand:
  1133   (473)      %
  1134   (474)      %   Command : STRINGDATA 'CLOSE-FILE 102'''
  1135   (475)      %
  1136   (476)      % - that trailing triple apostrophe is the string's closing quote plus ONE
  1137   (477)      % apostrophe character, so the command handed to SINTRAN is
  1138   (478)      % "CLOSE-FILE 102'". The apostrophe TERMINATES the command; without it the
  1139   (479)      % command processor keeps reading past the end of the buffer into whatever
  1140   (480)      % follows, and the command never runs as written.
  1141   (481)      %
  1142   (482)      % In PLANC an apostrophe inside a literal is written doubled, so the line
  1143   (483)      % below is CREATE-FILE CHAT:CNFG,1 followed by one apostrophe.
  1144   (484)      BYTES : cnfgMake := 'CREATE-FILE CHAT:CNFG,1'''
  1145   (485)  
  1146   (486)      % EIGHTY BYTES, BECAUSE THAT IS THE BUFFER MON70 IS DEFINED TO TAKE - and
  1147   (487)      % this, not the quoting and not the terminator, is why the file was never
  1148   (488)      % created. Both earlier fixes were real and neither changed the outcome.
  1149   (489)      %
  1150   (490)      % The Monitor Calls manual gives the PLANC form of CallCommand as
  1151   (491)      %
  1152   (492)      %   BYTES : Command(0:79)
  1153   (493)      %
  1154   (494)      % an EIGHTY-BYTE ARRAY. A PLANC BYTES argument carries its own length, so
  1155   (495)      % handing MON70 a 25-byte literal hands it a 25-byte buffer where it expects
  1156   (496)      % eighty - the same defect that made XROUT look up a room name with eleven
  1157   (497)      % bytes of leftovers on the end, in the other direction.
  1158   (498)      %
  1159   (499)      % So the command is COPIED into a full-size buffer, apostrophe-terminated,
  1160   (500)      % and the rest left as spaces. See makeCnfg.
  1161   (501)      INTEGER : lenCnfgMake := 24
  1162   (502)      BYTES : cmdBuf(0:79)
  1163   (503)      INTEGER : cmdBufSize := 80
  1164   (504)      BYTES : spaceChar := ' '
  1165   (505)  
  1166   (506)      % ----- CreateFile, the direct route -------------------------------------
  1167   (507)      % The FULL filespec, name and type together - the manual's example creates
  1168   (508)      % 'NAME-STORAGE:DATA' in one string - in the 64-byte buffer MON221 expects.
  1169   (509)      BYTES : cnfgFull := 'CHAT:CNFG'
  1170   (510)      INTEGER : lenCnfgFull := 9
  1171   (511)      BYTES : nameBuf(0:63)
  1172   (512)      INTEGER : nameBufSize := 64
  1173   (513)      INTEGER4 : startAddr := 0         % 0 = let SINTRAN place it
  1174   (514)      INTEGER4 : noOfPages := 0         % 0 = indexed, grows when written
  1175   (515)  
  1176   (516)      % Access codes for MON50, from the Monitor Calls manual's own table:
  1177   (517)      %   0  sequential write
  1178   (518)      %   1  sequential read
  1179   (519)      INTEGER : openRead  := 1
  1180   (520)      INTEGER : openWrite := 0
  1181   (521)  
  1182   (522)      % A "nameRemembered" BOOLEAN stood here, to word the prompt differently for
  1183   (523)      % a remembered name than for the built-in one. It was set and never read.
  1184   (524)      % The prompt shows the actual name either way, which answers the same
  1185   (525)      % question better than a different wording would have.
  1186   (526)  
  1187   (527)      INTEGER : myPort
  1188   (528)      INTEGER : returnStatus
  1189   (529)      INTEGER : offSet, uLength, wLength
  1190   (530)      INTEGER : msgType, remotePortHash, nBytes, readLength, readAmount
  1191   (531)      INTEGER : typedLen := 0
  1192   (532)      INTEGER : ch
  1193   (533)      % MON1's out-value is a BYTE, so it lands here first and is widened into ch
  1194   (534)      % before the parity bit is masked off.
  1195   (535)      BYTE : rawCh
  1196   (536)      INTEGER4 : senderMagic
  1197   (537)      % ZERO until the welcome arrives and reveals the real address. It is set
  1198   (538)      % explicitly rather than left to whatever the loader put there, because the
  1199   (539)      % joined test below is what keeps it from ever being used - and a guard is
  1200   (540)      % worth more when the thing it guards is a known value.
  1201   (541)      INTEGER4 : serverMagic := 0
  1202   (542)      % An INTEGER4 myMagic lived here to hold our own port's magic number, read
  1203   (543)      % with XMPFP2M purely so a diagnostic could print it. Both are gone - see
  1204   (544)      % the note in chatClient for what they settled (the reply address was
  1205   (545)      % correct all along) and why that ended the need for them.
  1206   (546)      BOOLEAN : joined := FALSE
  1207   (547)      % TRUE once RETURN has been seen, so a line half typed when the port
  1208   (548)      % needs draining survives the trip round the outer loop.
  1209   (549)      BOOLEAN : lineReady := FALSE
  1210   (550)      BOOLEAN : running := TRUE
  1211   (551)  
  1212   (552)      % -----------------------------------------------------------------------
  1213   (553)      % Build one of our messages into outBuf. Returns its total length.
  1214   (554)      %
  1215   (555)      % Same layout as ChatMessage.cs, which is the only specification it has:
  1216   (556)      % kind, name length, name, two length bytes, text.
  1217   (557)      %
  1218   (558)      % THE EXACT BYTES ARE PINNED in
  1219   (559)      % SRC/Xmsg.Chat.Tests/ChatMessageGoldenBytesTests.cs - a Said, a Renamed, a
  1220   (560)      % Join and a 300-character line that proves the text length is big-endian.
  1221   (561)      % There is no shared code between that and this, only those goldens, so if
  1222   (562)      % the layout ever changes both sides change in the SAME commit or they
  1223   (563)      % disagree in silence.
  1224   (564)      % -----------------------------------------------------------------------
  1225   (565)      % -----------------------------------------------------------------------
  1226   (566)      % Build the JOIN. Same layout as any other message - kind, nickname, text -
  1227   (567)      % but the TEXT carries the ROOM this time.
  1228   (568)      %
  1229   (569)      % THAT IS WHY THIS COSTS NO WIRE CHANGE. A Join always had an empty text
  1230   (570)      % field; only what goes in it is new. message_prefix does not move and the
  1231   (571)      % golden bytes keep their shape - just their content for Join.
  1232   (572)      % -----------------------------------------------------------------------
  1233   (573)      ROUTINE VOID, INTEGER : buildJoin
  1234   (574)          INTEGER : i, at
  1235   (575)          kJoin =: outBuf(0)
  1236   (576)          lenMyName =: outBuf(1)
  1237   (577)          2 =: at
  1238   (578)          FOR i IN 1:lenMyName DO
  1239   (579)              myName(i - 1) =: outBuf(at)
  1240   (580)              at + 1 =: at
  1241   (581)          ENDFOR
  1242   (582)          % Text length, high byte then low. A room name is far short of 256.
  1243   (583)          0 =: outBuf(at)
  1244   (584)          lenRoomName =: outBuf(at + 1)
  1245   (585)          at + 2 =: at
  1246   (586)          FOR i IN 1:lenRoomName DO
  1247   (587)              roomName(i - 1) =: outBuf(at)
  1248   (588)              at + 1 =: at
  1249   (589)          ENDFOR
  1250   (590)          at RETURN
  1251   (591)      ENDROUTINE
  1252   (592)  
  1253   (593)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : buildOwn(kind, textLength)
  1254   (594)          INTEGER : i, at
  1255   (595)          kind =: outBuf(0)
  1256   (596)          lenMyName =: outBuf(1)
  1257   (597)          2 =: at
  1258   (598)          % SUBSCRIPT FROM ZERO. myName is a BYTES declared from a literal, so its
  1259   (599)          % first character is at index 0. This said myName(i) and that is why the
  1260   (600)          % server saw the nickname as ONNY, not RONNY: the R was skipped and one
  1261   (601)          % byte was read past the end of the string. MEASURED 2026-08-18 in a raw
  1262   (602)          % dump of the arriving letter - the length byte said 5 and the five bytes
  1263   (603)          % were 'O','N','N','Y',0. Nothing reports this; PLANC checks no bound,
  1264   (604)          % and a wrong name is not an error to anyone. Compare cmdIs below, which
  1265   (605)          % has always had it right with word(i - 1).
  1266   (606)          FOR i IN 1:lenMyName DO
  1267   (607)              myName(i - 1) =: outBuf(at)
  1268   (608)              at + 1 =: at
  1269   (609)          ENDFOR
  1270   (610)          0 =: outBuf(at)
  1271   (611)          textLength =: outBuf(at + 1)
  1272   (612)          at + 2 =: at
  1273   (613)          FOR i IN 1:textLength DO
  1274   (614)              typed(i - 1) =: outBuf(at)
  1275   (615)              at + 1 =: at
  1276   (616)          ENDFOR
  1277   (617)          % The out-value goes BEFORE the keyword. ND-60.117.5 prints it as
  1278   (618)          % "result RETURN" in the complex-addition example; writing "RETURN at"
  1279   (619)          % makes the compiler read RETURN as a type and answer
  1280   (620)          % ILLEGAL DATA TYPE "RETURN".
  1281   (621)          at RETURN
  1282   (622)      ENDROUTINE
  1283   (623)  
  1284   (624)      % -----------------------------------------------------------------------
  1285   (625)      % Build a RENAME, which does NOT have the same shape as every other
  1286   (626)      % message and is the one place buildOwn cannot be used.
  1287   (627)      %
  1288   (628)      % THE NEW NAME GOES IN THE NAME FIELD, and the text is empty. This client
  1289   (629)      % had it the other way round - new name in the TEXT, current name in the
  1290   (630)      % NAME field - and the rename was thrown away in silence every time.
  1291   (631)      %
  1292   (632)      % MEASURED 2026-08-18 on D100: "/nick OLAV" was accepted by the client,
  1293   (633)      % sent, and changed nothing; the room went on saying RONNY. Nothing was
  1294   (634)      % printed by either side, because the path it took is a deliberate
  1295   (635)      % do-nothing:
  1296   (636)      %
  1297   (637)      %   the server reads the new name from the NAME field;
  1298   (638)      %   the client had put the CURRENT name there;
  1299   (639)      %   so sameName(slot, ...) matched, and the server took its
  1300   (640)      %   "already your name: not news" RETURN, which prints nothing.
  1301   (641)      %
  1302   (642)      % TWO WRONG THINGS AGREEING TO DO NOTHING. Each side was self-consistent
  1303   (643)      % and the pair was broken, which is why it survived a working build.
  1304   (644)      %
  1305   (645)      % THE C# PAIR IS THE ARBITER and it is unambiguous - ChatClient.Rename
  1306   (646)      % sends "new ChatMessage(ChatMessageKind.Rename, nickname, string.Empty)",
  1307   (647)      % the NEW nickname in the name field and an EMPTY text, and
  1308   (648)      % ChatServer.HandleRename reads it back with _room.TryRename(id,
  1309   (649)      % message.Nickname, ...). The PLANC SERVER already matched that. Only this
  1310   (650)      % side did not.
  1311   (651)      %
  1312   (652)      % The sender is identified by its MAGIC NUMBER, not by the name it sends -
  1313   (653)      % findByMagic(senderMagic) is what picks the seat - so the name field is
  1314   (654)      % free to carry the new name and nothing is lost by not sending the old one.
  1315   (655)      %
  1316   (656)      % myName is deliberately NOT changed here. Our own name changes when the
  1317   (657)      % room says so with kRenamed, so a refused rename leaves us as we were.
  1318   (658)      % -----------------------------------------------------------------------
  1319   (659)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : buildRename(nameFrom, newLength)
  1320   (660)          INTEGER : i, at
  1321   (661)          kRename =: outBuf(0)
  1322   (662)          newLength =: outBuf(1)
  1323   (663)          2 =: at
  1324   (664)          FOR i IN 1:newLength DO
  1325   (665)              typed(nameFrom + i - 1) =: outBuf(at)
  1326   (666)              at + 1 =: at
  1327   (667)          ENDFOR
  1328   (668)          % An empty text, spelled out as its two length bytes.
  1329   (669)          0 =: outBuf(at)
  1330   (670)          0 =: outBuf(at + 1)
  1331   (671)          at + 2 =: at
  1332   (672)          at RETURN
  1333   (673)      ENDROUTINE
  1334   (674)  
  1335   (675)      % -----------------------------------------------------------------------
  1336   (676)      % Say what "no access" actually means, because the number alone sends
  1337   (677)      % people to the wire.
  1338   (678)      %
  1339   (679)      % XRUNN and XRNRO are the same fault seen from two sides, and BOTH mean the
  1340   (680)      % peer has not been told to trust this system. XRUNN reads "unknown name of
  1341   (681)      % server or system" and it is the SYSTEM half of that phrase - not the
  1342   (682)      % server half - which is what sent two earlier investigations chasing
  1343   (683)      % *CHATSV when the room was fine.
  1344   (684)      %
  1345   (685)      % Everything else looks healthy while this is wrong: the peer lists the
  1346   (686)      % system, LIST-SYSTEMS says ON NET, LIST-LINKS says State Run with
  1347   (687)      % thousands of frames received. Nothing comes back because the rejection
  1348   (688)      % happens before XROUT is asked, so there is no error to send.
  1349   (689)      % -----------------------------------------------------------------------
  1350   (690)      ROUTINE VOID, VOID : showFriendAdvice
  1351   (691)          OUTPUT(1, 'AL54', 'CHAT: the PEER has not defined us as a FRIEND system.$')
  1352   (692)          OUTPUT(1, 'AL32', 'CHAT: on that machine:  @X-COMM$')
  1353   (693)          OUTPUT(1, 'AL53', 'CHAT:   X-C: DEFINE-FRIEND-SYSTEM   System? <our no>$')
  1354   (694)          OUTPUT(1, 'AL50', 'CHAT: check it with LIST-ROUTING-INFO - it prints$')
  1355   (695)          OUTPUT(1, 'AL46', 'CHAT:   "T: *, but no access to system NNNNN"$')
  1356   (696)          OUTPUT(1, 'AL51', 'CHAT: NOTE: DEF-REMOTE CLEARS the friend entry, so$')
  1357   (697)          OUTPUT(1, 'AL52', 'CHAT: the name comes first and the friend AFTER it.$')
  1358   (698)      ENDROUTINE
  1359   (699)  
  1360   (700)      ROUTINE VOID, VOID (BYTES, INTEGER) : showStatus(where, code)
  1361   (701)          % NOT "offset" - the module already has a global offSet for the letter, and
  1362   (702)          % PLANC ignores case, so that spelling collided with it and the compiler
  1363   (703)          % said IDENTIFIER ALREADY SPECIFIED/DECLARED.
  1364   (704)          %
  1365   (705)          % AND IT IS A RANGE, NOT A PLAIN INTEGER, because this is what CASE
  1366   (706)          % selects on. ND-60.117.5 section 6.3: the CASE expression "may have a
  1367   (707)          % maximum of 256 different values, and must be either an enumeration
  1368   (708)          % with a maximum of 256 different values, or integers ranging between 0
  1369   (709)          % and 255", with the note that an INTEGER RANGE used this way must have
  1370   (710)          % a lower bound of 0. A plain INTEGER spans -32768..32767, so the
  1371   (711)          % compiler answered OUT OF RANGE on both CASE statements - a WARNING,
  1372   (712)          % which is exactly the kind that gets skimmed past.
  1373   (713)          INTEGER RANGE (0:255) : xmxOffset
  1374   (714)  
  1375   (715)          OUTPUT(1, 'AL6', 'CHAT: ')
  1376   (716)          OUTPUT(1, 'AL24', where)
  1377   (717)          OUTPUT(1, 'AL8', ' status ')
  1378   (718)          OUTPUT(1, 'I6', code)
  1379   (719)          OUTPUT(1, 'AL1', ' ')
  1380   (720)  
  1381   (721)          IF code = XMOK THEN
  1382   (722)              OUTPUT(1, 'AL12', 'XMOK - done$')
  1383   (723)              RETURN
  1384   (724)          ENDIF
  1385   (725)  
  1386   (726)          IF code < 0 THEN
  1387   (727)              OUTPUT(1, 'AL36', 'raw kernel error, not a library one$')
  1388   (728)              RETURN
  1389   (729)          ENDIF
  1390   (730)  
  1391   (731)          IF code < XMXKXXX THEN
  1392   (732)              OUTPUT(1, 'AL27', 'message type, not an error$')
  1393   (733)              RETURN
  1394   (734)          ENDIF
  1395   (735)  
  1396   (736)          % XROUT ERRORS SIT ABOVE THE KERNEL ONES, at their own base
  1397   (737)          % XRXXX = 16960 = 41100B, so this test has to come FIRST - the XMX
  1398   (738)          % block below would otherwise decode 16972 as XMX offset 76 and say
  1399   (739)          % nothing useful. Two of these are the same fault wearing two names,
  1400   (740)          % and it is the one that costs a whole evening every time, so it gets
  1401   (741)          % told in full rather than named.
  1402   (742)          IF code >= XRXXX THEN
  1403   (743)              code - XRXXX =: xmxOffset
  1404   (744)              CASE xmxOffset
  1405   (745)                  INCASE 2
  1406   (746)                      OUTPUT(1, 'AL39', 'XRUNN unknown name of server OR SYSTEM$')
  1407   (747)                      showFriendAdvice
  1408   (748)                  INCASE 12
  1409   (749)                      OUTPUT(1, 'AL33', 'XRNRO no access to remote system$')
  1410   (750)                      showFriendAdvice
  1411   (751)                  INCASE 0
  1412   (752)                      OUTPUT(1, 'AL24', 'XRSOK ok - not an error$')
  1413   (753)                  INCASE 1
  1414   (754)                      OUTPUT(1, 'AL29', 'XRISN illegal service number$')
  1415   (755)                  INCASE 3
  1416   (756)                      OUTPUT(1, 'AL41', 'XRDDF another port already has this name$')
  1417   (757)                  INCASE 4
  1418   (758)                      OUTPUT(1, 'AL30', 'XRNSP no space left for names$')
  1419   (759)                  INCASE 7
  1420   (760)                      OUTPUT(1, 'AL27', 'XRUNM unknown magic number$')
  1421   (761)                  INCASE 10
  1422   (762)                      OUTPUT(1, 'AL32', 'XRPRV caller was not privileged$')
  1423   (763)                  INCASE 11
  1424   (764)                      OUTPUT(1, 'AL38', 'XRISY illegal system number parameter$')
  1425   (765)                  ELSE
  1426   (766)                      OUTPUT(1, 'AL23', 'XROUT error, XR offset ')
  1427   (767)                      OUTPUT(1, 'I6', xmxOffset)
  1428   (768)                      OUTPUT(1, 'AL1', '$')
  1429   (769)              ENDCASE
  1430   (770)              RETURN
  1431   (771)          ENDIF
  1432   (772)  
  1433   (773)          code - XMXKXXX =: xmxOffset
  1434   (774)          CASE xmxOffset
  1435   (775)              INCASE 0
  1436   (776)                  OUTPUT(1, 'AL39', 'XMXENTM not terminated - nothing there$')
  1437   (777)              INCASE 1
  1438   (778)                  OUTPUT(1, 'AL31', 'XMXENOT no more XT-blocks free$')
  1439   (779)              INCASE 2
  1440   (780)                  OUTPUT(1, 'AL38', 'XMXEIRM non-local remote port illegal$')
  1441   (781)              INCASE 4
  1442   (782)                  OUTPUT(1, 'AL36', 'XMXETMM task allowed no more memory$')
  1443   (783)              INCASE 5
  1444   (784)                  OUTPUT(1, 'AL33', 'XMXENIM facility not implemented$')
  1445   (785)              INCASE 6
  1446   (786)                  OUTPUT(1, 'AL39', 'XMXEIBP illegal message buffer pointer$')
  1447   (787)              INCASE 7
  1448   (788)                  OUTPUT(1, 'AL33', 'XMXEBNY message buffer not yours$')
  1449   (789)              INCASE 8
  1450   (790)                  OUTPUT(1, 'AL41', 'XMXEIRT illegal function for RT programs$')
  1451   (791)              INCASE 9
  1452   (792)                  OUTPUT(1, 'AL32', 'XMXENOP no more ports available$')
  1453   (793)              INCASE 10
  1454   (794)                  OUTPUT(1, 'AL42', 'XMXEIDR function not available to drivers$')
  1455   (795)              INCASE 11
  1456   (796)                  OUTPUT(1, 'AL27', 'XMXENDM no default message$')
  1457   (797)              INCASE 12
  1458   (798)                  OUTPUT(1, 'AL35', 'XMXEMCH message is already chained$')
  1459   (799)              INCASE 13
  1460   (800)                  OUTPUT(1, 'AL30', 'XMXEBFC message is in a queue$')
  1461   (801)              INCASE 14
  1462   (802)                  OUTPUT(1, 'AL35', 'XMXEAIN kernel already initialised$')
  1463   (803)              INCASE 15
  1464   (804)                  OUTPUT(1, 'AL35', 'XMXEBNC return of a bounce message$')
  1465   (805)              INCASE 16
  1466   (806)                  OUTPUT(1, 'AL26', 'XMXEWNA write not allowed$')
  1467   (807)              INCASE 17
  1468   (808)                  OUTPUT(1, 'AL33', 'XMXENVI no valid indirect buffer$')
  1469   (809)              INCASE 18
  1470   (810)                  OUTPUT(1, 'AL30', 'XMXEILF illegal function code$')
  1471   (811)              INCASE 19
  1472   (812)                  OUTPUT(1, 'AL29', 'XMXEIMA invalid magic number$')
  1473   (813)              INCASE 20
  1474   (814)                  OUTPUT(1, 'AL27', 'XMXEMFL message space full$')
  1475   (815)              INCASE 21
  1476   (816)                  OUTPUT(1, 'AL29', 'XMXEILM illegal message size$')
  1477   (817)              INCASE 22
  1478   (818)                  OUTPUT(1, 'AL28', 'XMXEIPN illegal port number$')
  1479   (819)              INCASE 23
  1480   (820)                  OUTPUT(1, 'AL42', 'XMXEPRV privileged function, no privilege$')
  1481   (821)              INCASE 24
  1482   (822)                  OUTPUT(1, 'AL34', 'XMXEPVR privilege request refused$')
  1483   (823)              INCASE 25
  1484   (824)                  OUTPUT(1, 'AL36', 'XMXERNA remote system not available$')
  1485   (825)              ELSE
  1486   (826)                  OUTPUT(1, 'AL26', 'library error, XMX offset ')
  1487   (827)                  OUTPUT(1, 'I6', xmxOffset)
  1488   (828)                  OUTPUT(1, 'AL1', '$')
  1489   (829)          ENDCASE
  1490   (830)      ENDROUTINE
  1491   (831)  
  1492   (832)      % -----------------------------------------------------------------------
  1493   (833)      % Read the remembered nickname out of CHAT:CNFG into myName.
  1494   (834)      %
  1495   (835)      % A MISSING FILE IS NOT AN ERROR and must not look like one. The first time
  1496   (836)      % anybody runs this there is no file, and that is the ordinary case rather
  1497   (837)      % than a fault - so a failed open leaves myName alone and says nothing. The
  1498   (838)      % caller has already put RONNY there.
  1499   (839)      %
  1500   (840)      % ROUTINEERROR IS THE ONLY WAY TO LEARN THE OPEN FAILED. MON50 does not
  1501   (841)      % return a status; it returns a device number and raises on failure, the
  1502   (842)      % same as MON1 does at end of file. Without the handler a first run - which
  1503   (843)      % is every user's first run - would unwind the program before it joined.
  1504   (844)      % -----------------------------------------------------------------------
  1505   (845)      ROUTINE VOID, VOID : readCnfg
  1506   (846)          INTEGER : dev, n
  1507   (847)          INTEGER : c
  1508   (848)          BOOLEAN : openFailed
  1509   (849)  
  1510   (850)          % A FLAG, NOT A MAGIC VALUE OF dev - see the long note in writeCnfg.
  1511   (851)          % A failed open leaves 46 in dev, not 0, so "IF dev = 0" never fired and
  1512   (852)          % this routine went on to READ from a device it had never opened.
  1513   (853)          0 =: dev
  1514   (854)          ON ROUTINEERROR DO
  1515   (855)              % No file, no name, nothing to say.
  1516   (856)              TRUE =: openFailed
  1517   (857)          ENDON
  1518   (858)          FALSE =: openFailed
  1519   (859)          MON50(cnfgName, cnfgType, openRead) =: dev
  1520   (860)  
  1521   (861)          IF openFailed THEN
  1522   (862)              RETURN
  1523   (863)          ENDIF
  1524   (864)  
  1525   (865)          0 =: n
  1526   (866)          ON ROUTINEERROR DO
  1527   (867)              % End of file arrives this way, and on a one-line file it is the
  1528   (868)              % NORMAL ending rather than a fault: a name with no carriage
  1529   (869)              % return after it is still a name. Zero stops the loop below.
  1530   (870)              0 =: c
  1531   (871)          ENDON
  1532   (872)          DO
  1533   (873)              0 =: c
  1534   (874)              MON1(dev) =: c
  1535   (875)              c AND parityMask =: c
  1536   (876)  
  1537   (877)              % Stop at the end of the line. Everything after it is somebody
  1538   (878)              % else's business - a second line, or a comment they added.
  1539   (879)              IF c < 32 THEN
  1540   (880)                  0 =: c
  1541   (881)              ENDIF
  1542   (882)  
  1543   (883)              IF c >< 0 THEN
  1544   (884)                  IF n < maxNameLen THEN
  1545   (885)                      c =: myName(n)
  1546   (886)                      n + 1 =: n
  1547   (887)                  ENDIF
  1548   (888)              ENDIF
  1549   (889)              WHILE c >< 0
  1550   (890)          ENDDO
  1551   (891)  
  1552   (892)          MON43(dev)
  1553   (893)  
  1554   (894)          % A FILE THAT EXISTS BUT IS EMPTY KEEPS THE DEFAULT. It is the state a
  1555   (895)          % bare CREATE-FILE leaves behind, so it is a state real users will have.
  1556   (896)          IF n > 0 THEN
  1557   (897)              n =: lenMyName
  1558   (898)          ENDIF
  1559   (899)      ENDROUTINE
  1560   (900)  
  1561   (901)      % -----------------------------------------------------------------------
  1562   (902)      % Write myName back to CHAT:CNFG, so the next run offers it.
  1563   (903)      %
  1564   (904)      % PLAIN OPEN FIRST, CREATE ONLY IF THAT FAILS, and the order is the point.
  1565   (905)      % A quoted name asks SINTRAN to CREATE, and a create at a name that already
  1566   (906)      % exists is refused - measured on the FA wire as SINTRAN error 62, "File
  1567   (907)      % already exists". Trying the create first would therefore fail on every
  1568   (908)      % run after the first. Trying the plain open first fails only on the very
  1569   (909)      % first, which is exactly when a create is what we want.
  1570   (910)      %
  1571   (911)      % NOTHING HERE IS FATAL. A user with no space, or a read-only area, still
  1572   (912)      % gets a working chat - they just get asked their name every time. Saying
  1573   (913)      % so once is better than either failing or pretending it worked.
  1574   (914)      % -----------------------------------------------------------------------
  1575   (915)      % -----------------------------------------------------------------------
  1576   (916)      % Ask SINTRAN to create CHAT:CNFG, through a FULL-SIZE command buffer.
  1577   (917)      %
  1578   (918)      % MON70 takes BYTES(0:79) - see the note on cmdBuf. The command text is
  1579   (919)      % copied in, the rest filled with spaces, and the apostrophe already on the
  1580   (920)      % end of cnfgMake terminates it so the padding is never read as parameters.
  1581   (921)      % -----------------------------------------------------------------------
  1582   (922)      ROUTINE VOID, VOID : makeCnfg
  1583   (923)          INTEGER : i
  1584   (924)  
  1585   (925)          % CREATE THE FILE WITH THE CALL THAT CREATES FILES.
  1586   (926)          %
  1587   (927)          % The command-processor detour is gone. It existed because CreateFile
  1588   (928)          % 221B has no MONn routine - measured, MON221...10101 U - and the only
  1589   (929)          % other route needed a library that was not on the machine.
  1590   (930)          %
  1591   (931)          % IT IS ON THE MACHINE NOW: MON-CALL-1B-A00:BRF, the SINTRAN III Monitor
  1592   (932)          % Call Package (ND-210913), installed 2026-08-19 and added to the LOAD
  1593   (933)          % line in CHATCC:MODE between this program and PLANC-1BANK-F00. That
  1594   (934)          % library supplies 5MON_P, which is what MONITOR_CALL compiles into, so
  1595   (935)          % every one of the 230 monitor calls is now reachable - not just the 54
  1596   (936)          % with a MONn routine.
  1597   (937)          %
  1598   (938)          % Parameters per ND-860228-2-EN page 125: the FULL filespec in a 64-byte
  1599   (939)          % buffer, then StartAddress and NoOfPages, both INTEGER4. Zero and zero
  1600   (940)          % mean an ordinary indexed file that grows as it is written.
  1601   (941)          FOR i IN 1:nameBufSize DO
  1602   (942)              spaceChar(0) =: nameBuf(i - 1)
  1603   (943)          ENDFOR
  1604   (944)  
  1605   (945)          FOR i IN 1:lenCnfgFull DO
  1606   (946)              cnfgFull(i - 1) =: nameBuf(i - 1)
  1607   (947)          ENDFOR
  1608   (948)  
  1609   (949)          MONITOR_CALL(221B, nameBuf, startAddr, noOfPages)
  1610   (950)      ENDROUTINE
  1611   (951)  
  1612   (952)      ROUTINE VOID, VOID : writeCnfg
  1613   (953)          INTEGER : dev, i
  1614   (954)          BYTE : b
  1615   (955)          BOOLEAN : saveFailed
  1616   (956)          BOOLEAN : openFailed
  1617   (957)  
  1618   (958)          % A FLAG, NOT A MAGIC VALUE OF dev - AND THIS WAS THE BUG.
  1619   (959)          %
  1620   (960)          % This used to be "0 =: dev" in the handler and "IF dev = 0 THEN create"
  1621   (961)          % below. MEASURED 2026-08-19, printing dev straight after a failed open
  1622   (962)          % on a file that does not exist:
  1623   (963)          %
  1624   (964)          %   CNFG: open1 dev=    46
  1625   (965)          %
  1626   (966)          % FORTY-SIX, not zero. 46 is SINTRAN's "no such file" - the Monitor Calls
  1627   (967)          % manual's own PASCAL example tests exactly that: "IF ErrCode = 46 THEN
  1628   (968)          % ... CreateFile(...)". So the test for "the open failed" never fired,
  1629   (969)          % the create was NEVER REACHED, and the program went straight on to
  1630   (970)          % write bytes to a device number it had never been given.
  1631   (971)          %
  1632   (972)          % That is the whole of the CHAT:CNFG defect. The quoting, the apostrophe
  1633   (973)          % terminator and the command buffer size were all real faults in a create
  1634   (974)          % that was never called in the first place.
  1635   (975)          %
  1636   (976)          % A BOOLEAN cannot be confused with a device number, which is the point.
  1637   (977)          %
  1638   (978)          % AND THE FLAG IS CLEARED **AFTER** THE ON BLOCK, NOT BEFORE IT.
  1639   (979)          % Measured 2026-08-19 with the flag cleared before: both opens reported
  1640   (980)          % failure while returning a perfectly good device number -
  1641   (981)          %
  1642   (982)          %   CNFG: open1 dev=    69
  1643   (983)          %   CNFG: open2 dev=    69
  1644   (984)          %   CHAT: cannot save the nickname
  1645   (985)          %
  1646   (986)          % - so the handler body had run even though nothing failed. Clearing
  1647   (987)          % after the block is correct whichever way the ON statement behaves: if
  1648   (988)          % the body only runs on an error it is unchanged, and if it also runs
  1649   (989)          % once where it stands, the clear undoes it before the call.
  1650   (990)          0 =: dev
  1651   (991)          ON ROUTINEERROR DO
  1652   (992)              TRUE =: openFailed
  1653   (993)          ENDON
  1654   (994)          FALSE =: openFailed
  1655   (995)  
  1656   (996)          MON50(cnfgName, cnfgType, openWrite) =: dev
  1657   (997)  
  1658   (998)          IF openFailed THEN
  1659   (999)              % Not there yet. Make it, then open it for real.
  1660  (1000)              ON ROUTINEERROR DO
  1661  (1001)                  % A create that fails is not worth its own message - the open
  1662  (1002)                  % below will fail too, and that one already has one.
  1663  (1003)              ENDON
  1664  (1004)              makeCnfg
  1665  (1005)  
  1666  (1006)              ON ROUTINEERROR DO
  1667  (1007)                  TRUE =: openFailed
  1668  (1008)              ENDON
  1669  (1009)              FALSE =: openFailed
  1670  (1010)              MON50(cnfgName, cnfgType, openWrite) =: dev
  1671  (1011)          ENDIF
  1672  (1012)  
  1673  (1013)          IF openFailed THEN
  1674  (1014)              OUTPUT(1, 'AL31', 'CHAT: cannot save the nickname$')
  1675  (1015)              RETURN
  1676  (1016)          ENDIF
  1677  (1017)  
  1678  (1018)          % ONE MESSAGE, NOT ONE PER BYTE. The first version put this handler
  1679  (1019)          % around the write loop and printed inside it, so a failed save said
  1680  (1020)          % "nickname not fully saved" five times - once per character of ANNA
  1681  (1021)          % plus the carriage return. A handler that fires per byte must not
  1682  (1022)          % print per byte; it sets a flag and the caller speaks once.
  1683  (1023)          ON ROUTINEERROR DO
  1684  (1024)              TRUE =: saveFailed
  1685  (1025)          ENDON
  1686  (1026)          FALSE =: saveFailed
  1687  (1027)  
  1688  (1028)          FOR i IN 1:lenMyName DO
  1689  (1029)              myName(i - 1) =: b
  1690  (1030)              b MON2(dev)
  1691  (1031)          ENDFOR
  1692  (1032)  
  1693  (1033)          % THE CARRIAGE RETURN MATTERS. readCnfg stops at the first byte below
  1694  (1034)          % 32, and a SINTRAN text file is expected to have one - without it the
  1695  (1035)          % last line runs into whatever follows.
  1696  (1036)          carriageRet =: b
  1697  (1037)          b MON2(dev)
  1698  (1038)  
  1699  (1039)          % CLOSE, ALWAYS - including after a failed write. A file opened for
  1700  (1040)          % sequential write is truncated at CLOSE, not at OPEN, so a program
  1701  (1041)          % that opens and never closes leaves the OLD contents in place and the
  1702  (1042)          % save silently does nothing.
  1703  (1043)          MON43(dev)
  1704  (1044)  
  1705  (1045)          IF saveFailed THEN
  1706  (1046)              OUTPUT(1, 'AL31', 'CHAT: nickname not fully saved$')
  1707  (1047)          ENDIF
  1708  (1048)      ENDROUTINE
  1709  (1049)  
  1710  (1050)      % -----------------------------------------------------------------------
  1711  (1051)      % Settle who we are, before the join goes out. NOTHING IS ASKED.
  1712  (1052)      %
  1713  (1053)      % THE PROMPT THAT USED TO BE HERE IS GONE, and the reason is worth keeping
  1714  (1054)      % because it was a real design mistake rather than a bug. It asked
  1715  (1055)      % "nickname?" on every single run, which is the wrong shape for a chat
  1716  (1056)      % client on a machine where you have already told SINTRAN who you are by
  1717  (1057)      % logging in. Being asked your name again, every time, by a program running
  1718  (1058)      % in your own file area, is nagging.
  1719  (1059)      %
  1720  (1060)      % The order of preference is now:
  1721  (1061)      %
  1722  (1062)      %   1. CHAT:CNFG in your own file area - what /nick last settled on;
  1723  (1063)      %   2. the built-in fallback, for a user who has never renamed.
  1724  (1064)      %
  1725  (1065)      % THE FALLBACK SHOULD BE THE SINTRAN USER NAME and is not yet. That needs
  1726  (1066)      % GetUserName (GUSNA 214B), and 214 is NOT among the MONn routines the
  1727  (1067)      % PLANC runtime provides - the appendix stops at MON263 and has no 214, the
  1728  (1068)      % same gap that CreateFile 221B falls into. The manual gives the way round
  1729  (1069)      % it: "Any monitor calls not listed here, may be called from a PLANC
  1730  (1070)      % routine if a suitable interface routine is constructed by the user. If
  1731  (1071)      % this is done, the user must load the interface routine BEFORE the PLANC
  1732  (1072)      % runtime library." MAC is installed on this machine, so that door is open
  1733  (1073)      % - it is the next piece of work, not a closed one.
  1734  (1074)      %
  1735  (1075)      % Changing the name is /nick, and the room has to agree to it: the save
  1736  (1076)      % happens when the SERVER confirms with kRenamed, never when the request is
  1737  (1077)      % sent. See showArrived.
  1738  (1078)      % -----------------------------------------------------------------------
  1739  (1079)      ROUTINE VOID, VOID : setupName
  1740  (1080)          INTEGER : i
  1741  (1081)  
  1742  (1082)          % The fallback first, then whatever CHAT:CNFG remembers on top of it.
  1743  (1083)          % That way readCnfg can fail, or find an empty file, and simply leave a
  1744  (1084)          % good name in place - it never has to know what to fall back to, and
  1745  (1085)          % no path reaches the join with an empty name.
  1746  (1086)          FOR i IN 1:lenDefault DO
  1747  (1087)              defaultName(i - 1) =: myName(i - 1)
  1748  (1088)          ENDFOR
  1749  (1089)          lenDefault =: lenMyName
  1750  (1090)  
  1751  (1091)          readCnfg
  1752  (1092)  
  1753  (1093)          % SAY WHO YOU ARE, ONCE. Not a question - a statement, so somebody who
  1754  (1094)          % expected a different name knows immediately that /nick is what fixes
  1755  (1095)          % it, rather than discovering it when the room greets a stranger.
  1756  (1096)          OUTPUT(1, 'AL14', 'CHAT: you are ')
  1757  (1097)          FOR i IN 1:lenMyName DO
  1758  (1098)              myName(i - 1) =: oneChar(0)
  1759  (1099)              OUTPUT(1, 'AL1', oneChar)
  1760  (1100)          ENDFOR
  1761  (1101)          OUTPUT(1, 'AL20', '  (/nick to change)$')
  1762  (1102)      ENDROUTINE
  1763  (1103)  
  1764  (1104)      % -----------------------------------------------------------------------
  1765  (1105)      % Point at a room, given its name - "LOBBY".
  1766  (1106)      %
  1767  (1107)      % THE PREFIX IS GONE, and with it the bug it existed to fix. This routine
  1768  (1108)      % used to paste "CHAT-" in front, because the room name WAS a port name and
  1769  (1109)      % the port is registered as CHAT-GENERAL rather than GENERAL. /join copied
  1770  (1110)      % the typed argument straight in, asked XROUT for a name that does not
  1771  (1111)      % exist, and the client stayed where it was - "/join doesn't work".
  1772  (1112)      %
  1773  (1113)      % There is no port name to build now. One port, *CHAT, and the room is
  1774  (1114)      % carried in the message, so the room name is just the room name. The whole
  1775  (1115)      % class of mistake goes with it.
  1776  (1116)      %
  1777  (1117)      % shortAt is an index into "typed"; a caller with the name somewhere else
  1778  (1118)      % copies it into typed first. That keeps this routine to one source and one
  1779  (1119)      % rule, which is the whole point of having it.
  1780  (1120)      % -----------------------------------------------------------------------
  1781  (1121)      ROUTINE VOID, VOID (INTEGER, INTEGER) : setRoom (shortAt, shortLen)
  1782  (1122)          INTEGER : i
  1783  (1123)  
  1784  (1124)          FOR i IN 1:shortLen DO
  1785  (1125)              typed(shortAt + i - 1) =: roomName(i - 1)
  1786  (1126)          ENDFOR
  1787  (1127)          shortLen =: lenRoomName
  1788  (1128)      ENDROUTINE
  1789  (1129)  
  1790  (1130)      % -----------------------------------------------------------------------
  1791  (1131)      % Say which room we are in, IN PARENTHESES.
  1792  (1132)      %
  1793  (1133)      % The client joins a room at start-up whether or not anybody asked it to,
  1794  (1134)      % and until now nothing on screen said which one - so every line you typed
  1795  (1135)      % went somewhere you had not been told about. The short name is shown, the
  1796  (1136)      % prefix left off: "CHAT-" is on every room and carries no information.
  1797  (1137)      % -----------------------------------------------------------------------
  1798  (1138)      ROUTINE VOID, VOID : showRoom
  1799  (1139)          INTEGER : i
  1800  (1140)  
  1801  (1141)          OUTPUT(1, 'AL1', '(')
  1802  (1142)          FOR i IN 1:lenRoomName DO
  1803  (1143)              roomName(i - 1) =: oneChar(0)
  1804  (1144)              OUTPUT(1, 'AL1', oneChar)
  1805  (1145)          ENDFOR
  1806  (1146)          OUTPUT(1, 'AL1', ')')
  1807  (1147)      ENDROUTINE
  1808  (1148)  
  1809  (1149)      % -----------------------------------------------------------------------
  1810  (1150)      % Send the join, as a LETTER through XROUT.
  1811  (1151)      %
  1812  (1152)      % The room is reached by NAME - XROUT looks it up and forwards, and this is
  1813  (1153)      % also where the seat is taken, before the server ever sees us. Everything
  1814  (1154)      % after the join goes port to port with no name lookup at all, which is why
  1815  (1155)      % the server's magic number is kept from its first reply.
  1816  (1156)      % -----------------------------------------------------------------------
  1817  (1157)      % ------------------------------------------------------------------
  1818  (1158)      % Take a new nickname LOCALLY, from typed. No message goes anywhere.
  1819  (1159)      %
  1820  (1160)      % Used when a join was refused for a duplicate name: there is no room
  1821  (1161)      % to announce a rename to, so this just changes who we will say we are
  1822  (1162)      % the next time we knock.
  1823  (1163)      %
  1824  (1164)      % Bounded by maxNameLen, checked by the caller. PLANC checks no array
  1825  (1165)      % bound, so that check is the only thing between a long name and
  1826  (1166)      % whatever the compiler laid out after myName.
  1827  (1167)      % ------------------------------------------------------------------
  1828  (1168)      ROUTINE VOID, VOID (INTEGER, INTEGER) : setMyName(nameAt, nameLen)
  1829  (1169)          INTEGER : i
  1830  (1170)          FOR i IN 1:nameLen DO
  1831  (1171)              typed(nameAt + i - 1) =: myName(i - 1)
  1832  (1172)          ENDFOR
  1833  (1173)          nameLen =: lenMyName
  1834  (1174)      ENDROUTINE
  1835  (1175)  
  1836  (1176)      % -----------------------------------------------------------------------
  1837  (1177)      % Say who we are now. Called after a LOCAL rename, so the user can see the
  1838  (1178)      % name the next knock will use.
  1839  (1179)      %
  1840  (1180)      % THIS ROUTINE WAS CALLED AND NEVER EXISTED. The /nick recovery path has
  1841  (1181)      % read
  1842  (1182)      %
  1843  (1183)      %     setMyName(at, argLen)
  1844  (1184)      %     showMyName
  1845  (1185)      %     sendJoin
  1846  (1186)      %
  1847  (1187)      % since the day it was written, and there was no showMyName anywhere in the
  1848  (1188)      % file. PLANC answered
  1849  (1189)      %
  1850  (1190)      %     2494  (1834)/HANDLECOMM  *** ERROR   - ILLEGAL SYNTAX "SHOWMYNAME"
  1851  (1191)      %
  1852  (1192)      % every time - and nobody saw it, because the listing is the only place a
  1853  (1193)      % PLANC error survives and CHAT:LIST has never once been read. The MODE
  1854  (1194)      % file says so in as many words: "Not one *** ERROR in CHAT:LIST is the
  1855  (1195)      % only green light here." Every client build before 2026-08-21 went in
  1856  (1196)      % unchecked, so how much of the program the compiler skipped after this
  1857  (1197)      % point is NOT KNOWN.
  1858  (1198)      % -----------------------------------------------------------------------
  1859  (1199)      ROUTINE VOID, VOID : showMyName
  1860  (1200)          INTEGER : i
  1861  (1201)  
  1862  (1202)          OUTPUT(1, 'AL15', '$CHAT: you are ')
  1863  (1203)          FOR i IN 1:lenMyName DO
  1864  (1204)              myName(i - 1) =: oneChar(0)
  1865  (1205)              OUTPUT(1, 'AL1', oneChar)
  1866  (1206)          ENDFOR
  1867  (1207)          OUTPUT(1, 'AL1', '$')
  1868  (1208)      ENDROUTINE
  1869  (1209)  
  1870  (1210)      ROUTINE VOID, VOID : sendJoin
  1871  (1211)          XMMSGIDENTIFIER : msgIdent
  1872  (1212)          INTEGER : length
  1873  (1213)  
  1874  (1214)          % The XSLET header, built in a local buffer. 123 is our reference
  1875  (1215)          % number, echoed back so a task with several requests outstanding can
  1876  (1216)          % tell the answers apart.
  1877  (1217)          % A SUBARRAY, because roomName is now storage rather than a literal.
  1878  (1218)          %
  1879  (1219)          % XMPBLET takes portName as BYTES and appends it as parameter 1 of the
  1880  (1220)          % letter - a PLANC BYTES argument carries its own length, so handing it
  1881  (1221)          % the whole 21-byte array would ask XROUT for a name with eleven bytes
  1882  (1222)          % of leftovers on the end. roomName(0:lenRoomName-1) is exactly the name
  1883  (1223)          % and nothing else. Runtime bounds in a subarray are legal: the PLANC
  1884  (1224)          % manual's own example is ia1(0:10,i:k-2).
  1885  (1225)          % ADDRESSED TO THE SERVICE, NOT TO THE ROOM. The room is carried in the
  1886  (1226)          % message by buildJoin below.
  1887  (1227)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, &
  1888  (1228)              servName(0:lenServName - 1)) =: returnStatus
  1889  (1229)          IF returnStatus >< XMOK THEN
  1890  (1230)              showStatus('xmpblet', returnStatus)
  1891  (1231)              RETURN
  1892  (1232)          ENDIF
  1893  (1233)  
  1894  (1234)          xmpfget(0, 200, msgIdent) =: returnStatus
  1895  (1235)          IF returnStatus >< XMOK THEN
  1896  (1236)              showStatus('xmpfget', returnStatus)
  1897  (1237)              RETURN
  1898  (1238)          ENDIF
  1899  (1239)  
  1900  (1240)          % The header first...
  1901  (1241)          offSet =: uLength
  1902  (1242)          xmpfwri(0, 0, &
  1903  (1243)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
  1904  (1244)              0, uLength, wLength) =: returnStatus
  1905  (1245)  
  1906  (1246)          % ...then OUR data after it. XROUT reads only the header and forwards
  1907  (1247)          % the rest untouched, so this is where the nickname rides.
  1908  (1248)          buildJoin =: length
  1909  (1249)          xmpfwri(0, wLength, &
  1910  (1250)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  1911  (1251)              0, length, offSet) =: returnStatus
  1912  (1252)  
  1913  (1253)          xmprout(0, msgIdent, myPort) =: returnStatus
  1914  (1254)          IF returnStatus >< XMOK THEN
  1915  (1255)              showStatus('xmprout (the join)', returnStatus)
  1916  (1256)          ENDIF
  1917  (1257)      ENDROUTINE
  1918  (1258)  
  1919  (1259)      % -----------------------------------------------------------------------
  1920  (1260)      % Send one of our messages straight to the server, no XROUT involved.
  1921  (1261)      % -----------------------------------------------------------------------
  1922  (1262)      ROUTINE VOID, VOID (INTEGER) : sendToServer(length)
  1923  (1263)          XMMSGIDENTIFIER : ident
  1924  (1264)          xmpfget(0, length, ident) =: returnStatus
  1925  (1265)          IF returnStatus >< XMOK THEN
  1926  (1266)              RETURN
  1927  (1267)          ENDIF
  1928  (1268)          xmpfwri(0, 0, &
  1929  (1269)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  1930  (1270)              0, length, wLength) =: returnStatus
  1931  (1271)          xmpfsnd(0, myPort, serverMagic) =: returnStatus
  1932  (1272)      ENDROUTINE
  1933  (1273)  
  1934  (1274)      % -----------------------------------------------------------------------
  1935  (1275)      % Show what arrived. The room speaks in the same message format we send.
  1936  (1276)      % -----------------------------------------------------------------------
  1937  (1277)      ROUTINE VOID, VOID : showArrived
  1938  (1278)          INTEGER : kind, nameLength, textLength, textAt, i
  1939  (1279)          % Only used by the kRenamed branch: is this rename about US?
  1940  (1280)          BOOLEAN : sameAsOurs
  1941  (1281)          INTEGER : newLen
  1942  (1282)  
  1943  (1283)          inBuf(0) =: kind
  1944  (1284)          inBuf(1) =: nameLength
  1945  (1285)  
  1946  (1286)          % THE JOIN IS ONE STEP, and a two-step handshake used to live here.
  1947  (1287)          %
  1948  (1288)          % It was added on the reading that "sending the join through XROUT does
  1949  (1289)          % not put the nickname in front of the server" - that the server's
  1950  (1290)          % connection port is handed a bare 4-byte connect, so a kHello reply was
  1951  (1291)          % needed before the nickname could be sent. That reading was WRONG, and
  1952  (1292)          % it was wrong because the SERVER was reading the wrong bytes: a letter
  1953  (1293)          % arrives with its XSLET header still attached, and the server was
  1954  (1294)          % parsing the header's serial number as a message kind.
  1955  (1295)          %
  1956  (1296)          % The nickname was in the first letter the whole time. sendJoin writes it
  1957  (1297)          % after the header and the Programmer Guide is explicit that XROUT
  1958  (1298)          % forwards it untouched. The server's WELCOME is the answer that hands
  1959  (1299)          % over the magic number, which is all this side ever needed. See the
  1960  (1300)          % header skip in CHATSV.PLNC for the layout and the manual reference.
  1961  (1301)          %
  1962  (1302)          % Nothing replaces this block: the welcome below already sets
  1963  (1303)          % serverMagic, and always did.
  1964  (1304)  
  1965  (1305)          % ---- TRUST NOTHING THAT ARRIVED, ON THIS SIDE TOO ------------------
  1966  (1306)          % The server checks exactly these three things before it reads a name or
  1967  (1307)          % a text; this side did not, and the reasoning is identical. inBuf holds
  1968  (1308)          % 256 bytes and PLANC checks no array bound:
  1969  (1309)          %
  1970  (1310)          %   nameLength is ONE BYTE, so it can say 255. The name loop would then
  1971  (1311)          %   read inBuf(2)..inBuf(256) - past the end - and textAt would already
  1972  (1312)          %   be 257 before any text was touched.
  1973  (1313)          %
  1974  (1314)          %   textLength is TWO BYTES, so it can say 65535, and the text loop
  1975  (1315)          %   would walk tens of thousands of bytes off the end of the array.
  1976  (1316)          %
  1977  (1317)          %   A SHORT message is the quieter half: without testing against
  1978  (1318)          %   readLength the loops print whatever the previous, longer message
  1979  (1319)          %   left behind in inBuf.
  1980  (1320)          %
  1981  (1321)          % "The server would never send that" is not a reason. A truncated
  1982  (1322)          % message does it by accident, and a client that only survives a
  1983  (1323)          % well-behaved peer is not one worth writing.
  1984  (1324)          % Both tests are against readLength, which the read below clamps to the
  1985  (1325)          % size of inBuf - so a field that fits the MESSAGE also fits the ARRAY.
  1986  (1326)          IF 2 + nameLength + 1 > readLength THEN
  1987  (1327)              RETURN
  1988  (1328)          ENDIF
  1989  (1329)  
  1990  (1330)          2 + nameLength =: textAt
  1991  (1331)          inBuf(textAt) * 256 + inBuf(textAt + 1) =: textLength
  1992  (1332)          textAt + 2 =: textAt
  1993  (1333)  
  1994  (1334)          IF textAt + textLength > readLength THEN
  1995  (1335)              RETURN
  1996  (1336)          ENDIF
  1997  (1337)  
  1998  (1338)          % The WELCOME is what reveals the server's address: everything after it
  1999  (1339)          % goes straight there.
  2000  (1340)          IF kind = kWelcome THEN
  2001  (1341)              senderMagic =: serverMagic
  2002  (1342)              TRUE =: joined
  2003  (1343)          ENDIF
  2004  (1344)  
  2005  (1345)          % ---- OUR OWN NAME CHANGES ONLY WHEN THE ROOM SAYS SO ---------------
  2006  (1346)          % A comment in handleCommand has promised this for as long as /nick has
  2007  (1347)          % existed - "our own name changes only when the room says so, with
  2008  (1348)          % kRenamed" - and nothing implemented it. The name in myName therefore
  2009  (1349)          % stayed at the old one after a successful rename, so the next thing
  2010  (1350)          % this client SENT went out under a name the room no longer knew.
  2011  (1351)          %
  2012  (1352)          % A Renamed carries the NEW name in the name field and the OLD one as
  2013  (1353)          % its text, which is exactly what is needed to tell whether it is about
  2014  (1354)          % us: compare the OLD name with what we currently believe we are called.
  2015  (1355)          % Everybody in the room gets every Renamed, so without that test this
  2016  (1356)          % client would take somebody else's new name for itself.
  2017  (1357)          %
  2018  (1358)          % This is also the ONLY place CHAT:CNFG is written. Saving when /nick is
  2019  (1359)          % SENT would remember a name the server may be about to refuse - it
  2020  (1360)          % refuses an empty one, and one already taken - so the save waits for
  2021  (1361)          % the room's confirmation. A refused rename changes nothing, on screen
  2022  (1362)          % or on disk.
  2023  (1363)          IF kind = kRenamed THEN
  2024  (1364)              IF textLength = lenMyName THEN
  2025  (1365)                  TRUE =: sameAsOurs
  2026  (1366)                  FOR i IN 1:textLength DO
  2027  (1367)                      IF inBuf(textAt + i - 1) >< myName(i - 1) THEN
  2028  (1368)                          FALSE =: sameAsOurs
  2029  (1369)                      ENDIF
  2030  (1370)                  ENDFOR
  2031  (1371)  
  2032  (1372)                  IF sameAsOurs THEN
  2033  (1373)                      % Bounded by the buffer, not by what arrived. A server that
  2034  (1374)                      % sent a longer name than we can hold would otherwise write
  2035  (1375)                      % past the end of myName - and the room's own limit and
  2036  (1376)                      % this buffer are both sixteen, so a name that does not fit
  2037  (1377)                      % here is one the room should never have accepted.
  2038  (1378)                      nameLength =: newLen
  2039  (1379)                      IF newLen > maxNameLen THEN
  2040  (1380)                          maxNameLen =: newLen
  2041  (1381)                      ENDIF
  2042  (1382)                      FOR i IN 1:newLen DO
  2043  (1383)                          inBuf(2 + i - 1) =: myName(i - 1)
  2044  (1384)                      ENDFOR
  2045  (1385)                      newLen =: lenMyName
  2046  (1386)  
  2047  (1387)                      writeCnfg
  2048  (1388)                  ENDIF
  2049  (1389)              ENDIF
  2050  (1390)          ENDIF
  2051  (1391)  
  2052  (1392)          % A BYTE HANDED TO 'AL1' PRINTS AS A NUMBER, NOT A CHARACTER.
  2053  (1393)          %
  2054  (1394)          % MEASURED on D100 2026-08-18, the first run in which the join actually
  2055  (1395)          % completed: the welcome arrived, was received and released correctly,
  2056  (1396)          % and printed as
  2057  (1397)          %
  2058  (1398)          %     8279787889: 7269767679
  2059  (1399)          %
  2060  (1400)          % which is 82 79 78 78 89 = RONNY and 72 69 76 76 79 = HELLO, each byte
  2061  (1401)          % rendered as its decimal value. The message was perfect; only the
  2062  (1402)          % printing was wrong, and it looked alarming enough to be mistaken for
  2063  (1403)          % a decode fault.
  2064  (1404)          %
  2065  (1405)          % 'ALn' formats a STRING. inBuf(x) is a BYTE, so it takes the integer
  2066  (1406)          % path. Copying the byte into a one-character BYTES first gives 'AL1'
  2067  (1407)          % the string it is asking for. This uses nothing new - BYTES arrays,
  2068  (1408)          % assignment and OUTPUT with ALn on a BYTES all appear above and all
  2069  (1409)          % compile.
  2070  (1410)          % THE /who ANSWER IS NOT A LINE SOMEBODY SAID, so it does not get the
  2071  (1411)          % "$NAME: text" shape below. Its name field is empty on purpose - the
  2072  (1412)          % room is answering, not a member - and the generic printer would open
  2073  (1413)          % with a bare colon. Printed here and returned.
  2074  (1414)          IF kind = kWho THEN
  2075  (1415)              OUTPUT(1, 'AL10', '$CHAT: in ')
  2076  (1416)              showRoom
  2077  (1417)              OUTPUT(1, 'AL2', ': ')
  2078  (1418)              FOR i IN 1:textLength DO
  2079  (1419)                  inBuf(textAt + i - 1) =: oneChar(0)
  2080  (1420)                  OUTPUT(1, 'AL1', oneChar)
  2081  (1421)              ENDFOR
  2082  (1422)              OUTPUT(1, 'AL1', '$')
  2083  (1423)              RETURN
  2084  (1424)          ENDIF
  2085  (1425)  
  2086  (1426)          OUTPUT(1, 'AL1', '$')
  2087  (1427)          FOR i IN 1:nameLength DO
  2088  (1428)              inBuf(2 + i - 1) =: oneChar(0)
  2089  (1429)              OUTPUT(1, 'AL1', oneChar)
  2090  (1430)          ENDFOR
  2091  (1431)          OUTPUT(1, 'AL2', ': ')
  2092  (1432)          FOR i IN 1:textLength DO
  2093  (1433)              inBuf(textAt + i - 1) =: oneChar(0)
  2094  (1434)              OUTPUT(1, 'AL1', oneChar)
  2095  (1435)          ENDFOR
  2096  (1436)          OUTPUT(1, 'AL1', '$')
  2097  (1437)      ENDROUTINE
  2098  (1438)  
  2099  (1439)      % -----------------------------------------------------------------------
  2100  (1440)      % Take everything the port is holding and print it, WITHOUT WAITING.
  2101  (1441)      %
  2102  (1442)      % flags ZERO means no XFWTF, and that is XMSG's own no-wait: the call
  2103  (1443)      % returns at once whether or not a message was there. Nothing about the
  2104  (1444)      % terminal is involved, which is why this works on a machine where the
  2105  (1445)      % no-wait TERMINAL switch (TNOWAIT 307B) cannot be reached from PLANC.
  2106  (1446)      %
  2107  (1447)      % A SUCCESSFUL RECEIVE DOES RETURN ZERO ON THIS MACHINE, and the opposite
  2108  (1448)      % claim used to stand here. It read: "A SUCCESSFUL RECEIVE DOES NOT RETURN
  2109  (1449)      % ZERO ... a message arrived exactly when the status is POSITIVE", citing
  2110  (1450)      % the constants file's "Message types: Returned as successfull status from
  2111  (1451)      % XFRCV", XMTNO=1 through XMTPS=6.
  2112  (1452)      %
  2113  (1453)      % MEASURED 2026-08-18: the server, doing the same call, prints st= 0 with
  2114  (1454)      % the type in the msgType out-parameter. The constants file is describing
  2115  (1455)      % the RAW MON 200B interface underneath; through the XMP library the status
  2116  (1456)      % is XMOK and the type comes back separately. Appendix G's sample agrees -
  2117  (1457)      % it tests "IF RETURNSTATUS >< XMOK" and only then reads MSGTYPE.
  2118  (1458)      %
  2119  (1459)      % Excluding zero cost the whole join: XMPFRCV took the welcome off the
  2120  (1460)      % queue, returned XMOK, and the test below dropped straight out of the loop
  2121  (1461)      % without printing, reading or releasing it. See the note on the test.
  2122  (1462)      % -----------------------------------------------------------------------
  2123  (1463)      % PLANC HAS NO "WHILE cond DO ... ENDWHILE". WHILE is a CONTINUE-TEST
  2124  (1464)      % written INSIDE a DO ... ENDDO body: reaching it with a false condition
  2125  (1465)      % leaves the loop. ND-60.117.5 shows it that way ("continue the loop only
  2126  (1466)      % for negative array elements ... WHILE a(i)<0"), and writing the header
  2127  (1467)      % form gets WHILE NOT INSIDE LOOP followed by ILLEGAL SYNTAX "ENDWHILE".
  2128  (1468)      % -----------------------------------------------------------------------
  2129  (1469)      % Print an XMSG status with its name and meaning, then say where it came
  2130  (1470)      % from. Called on every path that gives up, so a failure never leaves just
  2131  (1471)      % a number - or worse, nothing at all.
  2132  (1472)      %
  2133  (1473)      % THE LIBRARY'S STATUS MODEL IS NOT THE KERNEL'S, and that difference cost
  2134  (1474)      % a whole evening. Through the XMP routines:
  2135  (1475)      %
  2136  (1476)      %   0                  XMOK - done. The kernel's own OK is 1; XMP-B02:DEFS
  2137  (1477)      %                      remaps it and says so: "NOTE change from XMSG OK=1".
  2138  (1478)      %   16896              XMXENTM - NOT TERMINATED. This is what an EMPTY port
  2139  (1479)      %                      answers, and it is NOT an error.
  2140  (1480)      %   16896 + n          an error, where n is the absolute value of the raw
  2141  (1481)      %                      kernel code. So the raw XEIBP = -6 appears here as
  2142  (1482)      %                      XMXEIBP = 16902.
  2143  (1483)      %   1 .. 6             a MESSAGE TYPE. Documented as a status from XFRCV,
  2144  (1484)      %                      but MEASURED 2026-08-18 the library answers XMOK and
  2145  (1485)      %                      puts the type in the msgType out-parameter instead.
  2146  (1486)      %                      Both forms are accepted on a receive for that reason.
  2147  (1487)      %
  2148  (1488)      % Which is why testing a receive with "> 0" is wrong: 16896 and every error
  2149  (1489)      % are positive too. Measured live: type=0 rel=16902, an empty port being
  2150  (1490)      % read as a message and then released, for ever.
  2151  (1491)      %
  2152  (1492)      % AND WHY TESTING IT WITH "1..6 ONLY" IS EQUALLY WRONG, which took longer to
  2153  (1493)      % find because it fails SILENTLY: XMPFRCV dequeues the message and returns
  2154  (1494)      % XMOK, the test rejects it, and the loop exits having printed nothing. A
  2155  (1495)      % receive must accept XMOK **or** 1..6 - see drainPort.
  2156  (1496)      %
  2157  (1497)      % The numbers are from XMP-B02:DEFS as extracted from the ND-10609 media;
  2158  (1498)      % the texts are the matching XE... comments in XMSG-PL-VALUES-L:INCL.
  2159  (1499)      % -----------------------------------------------------------------------
  2160  (1500)  
  2161  (1501)      % -----------------------------------------------------------------------
  2162  (1502)      % Switch this terminal's INPUT side in and out of no-wait.
  2163  (1503)      %
  2164  (1504)      % THIS IS THE THING THE POLL LOOP ALWAYS ASSUMED AND NOBODY EVER SWITCHED
  2165  (1505)      % ON. The loop below was written for a no-wait terminal - it catches
  2166  (1506)      % ROUTINEERROR from MON1 and reads ErrCode 3 as "nothing was typed" - and a
  2167  (1507)      % comment there claims "the terminal is in no-wait". It was not. Nothing in
  2168  (1508)      % this program ever asked for it, so MON1 BLOCKED, and the loop never got
  2169  (1509)      % back round to drainPort until the user pressed return.
  2170  (1510)      %
  2171  (1511)      % MEASURED ON D100, 2026-08-20: two people in a room, and neither saw the
  2172  (1512)      % other's line until they typed something themselves. The speaker always saw
  2173  (1513)      % their own words at once, because pressing return is what let the loop go
  2174  (1514)      % round. That is indistinguishable from a message that was never sent, and
  2175  (1515)      % it cost an afternoon of hunting a delivery fault in a server that was
  2176  (1516)      % delivering to everybody correctly.
  2177  (1517)      %
  2178  (1518)      % IT DID NOT NEED MAC AFTER ALL. The notes at the foot of this file weigh a
  2179  (1519)      % hand-written MAC interface routine for TNOWAIT (307B) against an XFWAK
  2180  (1520)      % experiment, because "TNOWAIT cannot be had here". Both are unnecessary:
  2181  (1521)      % MONITOR_CALL takes a call BY NAME and handles output parameters - CHATSV
  2182  (1522)      % has been calling MONITOR_CALL('TimeOut', ...) for exactly that reason -
  2183  (1523)      % and MON-CALL-1B-A00 is already in this client's LOAD list. NoWaitSwitch
  2184  (1524)      % (NOWT 36B) takes three parameters and ALL THREE ARE INPUTS, so there is
  2185  (1525)      % not even an output to get wrong.
  2186  (1526)      %
  2187  (1527)      % ALWAYS SWITCH IT BACK. A terminal left in no-wait is one the user's shell
  2188  (1528)      % has to live with after this program ends, so every exit path goes through
  2189  (1529)      % terminalWait - see the leave path at the end of the main loop.
  2190  (1530)      % -----------------------------------------------------------------------
  2191  (1531)      % EVERY ONE OF THESE IS GUARDED, AND THE FIRST VERSION WAS NOT.
  2192  (1532)      %
  2193  (1533)      % MEASURED ON D100, 2026-08-21. The unguarded call killed the client the
  2194  (1534)      % instant it joined:
  2195  (1535)      %
  2196  (1536)      %     @NDCHAT
  2197  (1537)      %     CHAT: you are OLAV  (/nick to change)
  2198  (1538)      %     CHAT: joining (LOBBY) - type and press return
  2199  (1539)      %     NO ROUTINEERROR HANDLER, ERRETURN=177777B
  2200  (1540)      %     @
  2201  (1541)      %
  2202  (1542)      % A MONITOR_CALL that SINTRAN refuses raises a ROUTINEERROR, and an
  2203  (1543)      % unhandled one unwinds the whole program - after the join has been sent,
  2204  (1544)      % so it also leaves a seat behind in the room. The server was fine; the
  2205  (1545)      % client shot itself.
  2206  (1546)      %
  2207  (1547)      % THE FALLBACK IS THE OLD BEHAVIOUR, WHICH IS WHY THIS IS SAFE. Without the
  2208  (1548)      % switch, MON1 blocks and the loop comes round when the user presses return
  2209  (1549)      % - the very thing this change is trying to improve, but a working client.
  2210  (1550)      % So a refusal is worth ONE LINE ON SCREEN and nothing more.
  2211  (1551)      %
  2212  (1552)      % WHICH NAME IS RIGHT IS NOT SETTLED. MONITOR_CALL by NAME works here -
  2213  (1553)      % CHATSV has been calling MONITOR_CALL('TimeOut', ...) for weeks - so the
  2214  (1554)      % mechanism is proved and it is the SPELLING that is in doubt. The Monitor
  2215  (1555)      % Calls manual gives two candidates and their short names:
  2216  (1556)      %     NoWaitSwitch   (NOWT   36B)  LDN, io flag, no-wait flag - ALL INPUTS
  2217  (1557)      %     TerminalNoWait (TNOWAI 307B) LDN, io flag, no-wait flag, status OUT
  2218  (1558)      % If the line below prints, try the other name, and then try inputFlag the
  2219  (1559)      % other way round - 0 for input is what this file has always claimed and
  2220  (1560)      % nothing has ever exercised it.
  2221  (1561)      % TWO NAMES TRIED, AND THE REASON PRINTED. One build, one answer.
  2222  (1562)      %
  2223  (1563)      % 'NoWaitSwitch' is refused on D100 - measured 2026-08-21, the client
  2224  (1564)      % printed its fallback line. But a refusal alone does not say WHETHER the
  2225  (1565)      % name is unknown or the PARAMETERS are wrong, and guessing between those
  2226  (1566)      % costs a build cycle each time. ErrCode is supplied by the runtime inside
  2227  (1567)      % the handler and it is the difference between the two, so it is printed.
  2228  (1568)      %
  2229  (1569)      % Then the other spelling is tried. The Monitor Calls manual offers both:
  2230  (1570)      %     NoWaitSwitch   (NOWT   36B)  LDN, io flag, no-wait flag       3 IN
  2231  (1571)      %     TerminalNoWait (TNOWAI 307B) LDN, io flag, no-wait flag, st   3 IN 1 OUT
  2232  (1572)      % MONITOR_CALL handles an output parameter - CHATSV passes one to TimeOut -
  2233  (1573)      % so the second form costs nothing to attempt.
  2234  (1574)      %
  2235  (1575)      % IF BOTH ARE REFUSED, the remaining suspect is ownTerminal. It is 1, the
  2236  (1576)      % SINTRAN "own terminal" file number, and what NoWaitSwitch wants is the
  2237  (1577)      % LDN OF A CHARACTER DEVICE, which is not obviously the same thing.
  2238  (1578)      ROUTINE VOID, VOID : terminalNoWait
  2239  (1579)          BOOLEAN : switchFailed
  2240  (1580)          INTEGER : nowaitStatus
  2241  (1581)  
  2242  (1582)          ON ROUTINEERROR DO
  2243  (1583)              TRUE =: switchFailed
  2244  (1584)              ErrCode =: firstErr
  2245  (1585)          ENDON
  2246  (1586)          FALSE =: switchFailed
  2247  (1587)          0 =: firstErr
  2248  (1588)  
  2249  (1589)          MONITOR_CALL('NoWaitSwitch', ownTerminal, inputFlag, noWaitOn)
   2249  (1589)/TERMINALNO  *** ERROR   - THE MON-CALL-NAMES FILE WAS NOT FOUND
  2250  (1590)  
  2251  (1591)          IF switchFailed THEN
  2252  (1592)              % Say what the first one answered before trying the second, so a
  2253  (1593)              % run that fails BOTH ways still reports two distinct numbers.
  2254  (1594)              OUTPUT(1, 'AL24', '$CHAT: NoWaitSwitch err ')
  2255  (1595)              OUTPUT(1, 'I6', firstErr)
  2256  (1596)              OUTPUT(1, 'AL1', '$')
  2257  (1597)  
  2258  (1598)              0 =: nowaitStatus
  2259  (1599)              ON ROUTINEERROR DO
  2260  (1600)                  TRUE =: switchFailed
  2261  (1601)                  ErrCode =: firstErr
  2262  (1602)              ENDON
  2263  (1603)              FALSE =: switchFailed
  2264  (1604)              0 =: firstErr
  2265  (1605)  
  2266  (1606)              MONITOR_CALL('TerminalNoWait', ownTerminal, inputFlag, noWaitOn, &
   2266  (1606)/TERMINALNO  *** ERROR   - THE MON-CALL-NAMES FILE WAS NOT FOUND
  2267  (1607)                  nowaitStatus)
  2268  (1608)  
  2269  (1609)              IF switchFailed THEN
  2270  (1610)                  OUTPUT(1, 'AL26', '$CHAT: TerminalNoWait err ')
  2271  (1611)                  OUTPUT(1, 'I6', firstErr)
  2272  (1612)                  OUTPUT(1, 'AL1', '$')
  2273  (1613)              ENDIF
  2274  (1614)          ENDIF
  2275  (1615)  
  2276  (1616)          IF switchFailed THEN
  2277  (1617)              OUTPUT(1, 'AL44', '$CHAT: new lines show when you press return$')
  2278  (1618)          ENDIF
  2279  (1619)      ENDROUTINE
  2280  (1620)  
  2281  (1621)      % Putting it BACK is silent whatever happens. If the switch never went on,
  2282  (1622)      % switching it off is a no-op; if it did, this is the only thing standing
  2283  (1623)      % between the user and a shell whose terminal does not wait for input.
  2284  (1624)      % PUT IT BACK WITH THE NAME THAT ACTUALLY WORKS.
  2285  (1625)      %
  2286  (1626)      % This used to call NoWaitSwitch, which is REFUSED on this machine with
  2287  (1627)      % ErrCode -1 - so the restore silently did nothing while the switch-on had
  2288  (1628)      % quietly succeeded under the other name. A terminal left in no-wait is one
  2289  (1629)      % the user's shell has to live with, so the two must use the SAME name.
  2290  (1630)      % TerminalNoWait is tried first here for that reason, with NoWaitSwitch kept
  2291  (1631)      % only as a fallback for a machine where the other one is the live one.
  2292  (1632)      ROUTINE VOID, VOID : terminalWait
  2293  (1633)          BOOLEAN : switchFailed
  2294  (1634)          INTEGER : nowaitStatus
  2295  (1635)  
  2296  (1636)          0 =: nowaitStatus
  2297  (1637)          ON ROUTINEERROR DO
  2298  (1638)              TRUE =: switchFailed
  2299  (1639)          ENDON
  2300  (1640)          FALSE =: switchFailed
  2301  (1641)  
  2302  (1642)          MONITOR_CALL('TerminalNoWait', ownTerminal, inputFlag, noWaitOff, &
   2302  (1642)/TERMINALWA  *** ERROR   - THE MON-CALL-NAMES FILE WAS NOT FOUND
  2303  (1643)              nowaitStatus)
  2304  (1644)  
  2305  (1645)          IF switchFailed THEN
  2306  (1646)              ON ROUTINEERROR DO
  2307  (1647)                  TRUE =: switchFailed
  2308  (1648)              ENDON
  2309  (1649)              FALSE =: switchFailed
  2310  (1650)              MONITOR_CALL('NoWaitSwitch', ownTerminal, inputFlag, noWaitOff)
   2310  (1650)/TERMINALWA  *** ERROR   - THE MON-CALL-NAMES FILE WAS NOT FOUND
  2311  (1651)          ENDIF
  2312  (1652)      ENDROUTINE
  2313  (1653)  
  2314  (1654)      % Give the machine back a moment. Called only when a pass found NOTHING -
  2315  (1655)      % no message waiting and no key pressed - so it never delays anything that
  2316  (1656)      % actually happened. Guarded for the same reason as the two above: a sleep
  2317  (1657)      % that cannot be had is not a reason to end the program.
  2318  (1658)      ROUTINE VOID, VOID : idleSleep
  2319  (1659)          BOOLEAN : sleepFailed
  2320  (1660)          ON ROUTINEERROR DO
  2321  (1661)              TRUE =: sleepFailed
  2322  (1662)          ENDON
  2323  (1663)          FALSE =: sleepFailed
  2324  (1664)  
  2325  (1665)          MONITOR_CALL('TimeOut', sleepUnits, sleepKind, sleepWhy)
   2325  (1665)/IDLESLEEP  *** ERROR   - THE MON-CALL-NAMES FILE WAS NOT FOUND
  2326  (1666)      ENDROUTINE
  2327  (1667)  
  2328  (1668)      ROUTINE VOID, VOID : drainPort
  2329  (1669)          XMMSGIDENTIFIER : msgIdent
  2330  (1670)          INTEGER : taken
  2331  (1671)  
  2332  (1672)          % THIS LOOP IS BOUNDED, and that is not caution for its own sake - the
  2333  (1673)          % unbounded version hung the client on the first live run. It kept being
  2334  (1674)          % handed a message, printed it, and asked again for ever; the terminal
  2335  (1675)          % filled with the same line until ESC broke it. Whether the message was
  2336  (1676)          % never really released or the peer kept re-offering it is not settled,
  2337  (1677)          % but either way a loop that only ends when the PEER says so is a loop
  2338  (1678)          % the peer can hang. One pass takes at most this many and then returns
  2339  (1679)          % to the keyboard; anything still waiting is taken on the next pass.
  2340  (1680)          0 =: taken
  2341  (1681)  
  2342  (1682)          DO
  2343  (1683)              xmpfrcv(0, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  2344  (1684)                  =: returnStatus
  2345  (1685)  
  2346  (1686)              % XMOK IS A SUCCESSFUL RECEIVE. THIS TEST MUST ACCEPT ZERO.
  2347  (1687)              %
  2348  (1688)              % It did not, and that single missing case is what silently ate the
  2349  (1689)              % welcome. MEASURED on D100 2026-08-18, end to end:
  2350  (1690)              %
  2351  (1691)              %   the server prints  SV: rcv st=  0  t=  2  len= 25
  2352  (1692)              %                                  ^ XMOK, with the type in msgType
  2353  (1693)              %
  2354  (1694)              %   the client's port  LIST-PORTS: port 13  Qhead 161641  Qlen 1
  2355  (1695)              %   one keystroke later                     Qhead 0       Qlen 0
  2356  (1696)              %   and the client printed NOTHING - not even the unconditional
  2357  (1697)              %   "type= / rel=" line below, which every taken message reaches.
  2358  (1698)              %
  2359  (1699)              % That is the whole story: XMPFRCV succeeded, returned XMOK, and
  2360  (1700)              % DEQUEUED the message - which is why Qlen fell to zero - and then
  2361  (1701)              % this continue-test read 0 >= XMTNO as false and left the loop
  2362  (1702)              % before a single byte was printed, before XMPFMST, before XMPFREA,
  2363  (1703)              % and before XMPFREL. The message was received and abandoned. It was
  2364  (1704)              % never returned to the sender either, which is why the server saw
  2365  (1705)              % no bounce.
  2366  (1706)              %
  2367  (1707)              % THE OLD COMMENT HERE ARGUED THE OPPOSITE and was wrong. It claimed
  2368  (1708)              % "a successful receive does not return zero", on the reasoning that
  2369  (1709)              % 0 means OK, 16896 means an empty port, and a bare "> 0" test is
  2370  (1710)              % true for both - all of which is correct ABOUT THE OTHER CALLS and
  2371  (1711)              % does not follow for XMPFRCV. The vendor sample in Appendix G tests
  2372  (1712)              % "IF RETURNSTATUS >< XMOK THEN bad status" and only then looks at
  2373  (1713)              % MSGTYPE, so XMOK is the success case and the TYPE lives in the
  2374  (1714)              % out-parameter, not in the status.
  2375  (1715)              %
  2376  (1716)              % The earlier "type=0 rel=16902" reading that seemed to prove the
  2377  (1717)              % old rule was an EMPTY port being read and then released - a real
  2378  (1718)              % fault, but a different one, and fixing it by excluding zero threw
  2379  (1719)              % out every genuine message with it.
  2380  (1720)              %
  2381  (1721)              % CHATSV was widened for exactly this reason and this client never
  2382  (1722)              % was. Both sides now spell the same rule, and the range is kept
  2383  (1723)              % beside XMOK rather than replaced by it, because which form turns
  2384  (1724)              % up is measured rather than assumed.
  2385  (1725)              %
  2386  (1726)              % 16896 (XMXENTM, "not terminated") is what an EMPTY port answers
  2387  (1727)              % and is still correctly excluded - it is neither XMOK nor 1..6.
  2388  (1728)              WHILE returnStatus = XMOK OR &
  2389  (1729)                    (returnStatus >= XMTNO AND returnStatus <= XMTPS)
  2390  (1730)  
  2391  (1731)              taken + 1 =: taken
  2392  (1732)              WHILE taken <= maxDrain
  2393  (1733)  
  2394  (1734)              xmpfmst(0, msgIdent, msgType, senderMagic, nBytes) =: returnStatus
  2395  (1735)  
  2396  (1736)              % CLAMP BEFORE READING. nBytes is the SENDER'S message size, handed
  2397  (1737)              % back by XMSG - not a size this program chose. inBuf holds
  2398  (1738)              % inBufSize bytes and PLANC checks no array bound, so passing nBytes
  2399  (1739)              % straight in lets anyone who sends a longer message write straight
  2400  (1740)              % past the end of it. That is a WRITE overflow and it happens before
  2401  (1741)              % a single field is parsed, so none of the checks in showArrived
  2402  (1742)              % could save it.
  2403  (1743)              nBytes =: readAmount
  2404  (1744)              IF readAmount > inBufSize THEN
  2405  (1745)                  inBufSize =: readAmount
  2406  (1746)              ENDIF
  2407  (1747)  
  2408  (1748)              xmpfrea(0, 0, &
  2409  (1749)                  ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  2410  (1750)                  0, readAmount, readLength) =: returnStatus
  2411  (1751)              % A RETURN MESSAGE IS OUR OWN LETTER COMING BACK UNDELIVERED.
  2412  (1752)              % XMTRE is the type XMSG uses for "abnormal condition", and the
  2413  (1753)              % commonest reason a join bounces is that the peer does not have us
  2414  (1754)              % as a friend - the same fault XRUNN and XRNRO report from the
  2415  (1755)              % other direction. Saying so here means the user is told once,
  2416  (1756)              % whichever way the machine chooses to complain.
  2417  (1757)              IF msgType = XMTRE THEN
  2418  (1758)                  OUTPUT(1, 'AL46', 'CHAT: that message came BACK - undeliverable.$')
  2419  (1759)                  showFriendAdvice
  2420  (1760)              ENDIF
  2421  (1761)  
  2422  (1762)              xmpfrel(0, msgIdent) =: returnStatus
  2423  (1763)  
  2424  (1764)              % A "type= rel=" line used to print here on every message taken.
  2425  (1765)              % It was temporary, it said so, and it has done its job: the loop
  2426  (1766)              % that printed the same message for ever is understood and fixed
  2427  (1767)              % (see the ROUTINEERROR handler in the main loop), and the empty
  2428  (1768)              % port being read and released - the "type=0 rel=16902" reading -
  2429  (1769)              % is excluded by the continue-test above.
  2430  (1770)              %
  2431  (1771)              % What it proved is kept in the comments that surround it rather
  2432  (1772)              % than on the user's screen. Put it back if this loop ever misbehaves
  2433  (1773)              % again: msgType and returnStatus are the two numbers that say why.
  2434  (1774)  
  2435  (1775)              showArrived
  2436  (1776)          ENDDO
  2437  (1777)  
  2438  (1778)          % How many this pass printed, for the main loop's idle test. Nothing
  2439  (1779)          % else reads it, and it is a COUNT rather than a boolean so a future
  2440  (1780)          % question like "are we falling behind" has a number to look at.
  2441  (1781)          taken =: lastDrainCount
  2442  (1782)  
  2443  (1783)          % ---- DID THE PORT GO AWAY WHILE WE WERE NOT LOOKING? ---------------
  2444  (1784)          % The loop above ends on ANY status that is not a message, and until now
  2445  (1785)          % it ended silently on all of them. That is right for XMXENTM, which
  2446  (1786)          % just means the port is empty and is the normal way round; it is wrong
  2447  (1787)          % for XMXENRU, "XMSG is not running", because the client then sits at
  2448  (1788)          % its prompt looking perfectly connected to a room that no longer
  2449  (1789)          % exists, and everything typed goes nowhere.
  2450  (1790)          %
  2451  (1791)          % MEASURED 2026-08-18: XMSG went down under a running server. The
  2452  (1792)          % SERVER span at full speed on the same status (it waits with XFWTF, so
  2453  (1793)          % a receive that cannot block returns instantly for ever); this client
  2454  (1794)          % would not have spun, because its drain never waits - it would just
  2455  (1795)          % have gone quiet and told nobody. Two different failures from one
  2456  (1796)          % cause, which is why both programs needed their own answer.
  2457  (1797)          %
  2458  (1798)          % Stopping is the honest one here. There is no reconnect to attempt: a
  2459  (1799)          % port belongs to an XMSG that is gone, and when it comes back this
  2460  (1800)          % program has to open a new one and rejoin from the beginning - which
  2461  (1801)          % is exactly what starting it again does.
  2462  (1802)          IF returnStatus = XMXENRU THEN
  2463  (1803)              OUTPUT(1, 'AL33', 'CHAT: XMSG has stopped - leaving$')
  2464  (1804)              FALSE =: joined
  2465  (1805)              0 =: serverMagic
  2466  (1806)              FALSE =: running
  2467  (1807)          ENDIF
  2468  (1808)      ENDROUTINE
  2469  (1809)  
  2470  (1810)      % -----------------------------------------------------------------------
  2471  (1811)      % Does the typed line begin with "/word"? Case is folded, so /WHO and /who
  2472  (1812)      % are the same command.
  2473  (1813)      %
  2474  (1814)      % typed(0) is the slash, so the word starts at 1. A match also requires the
  2475  (1815)      % character AFTER the word to be a space or the end of the line - without
  2476  (1816)      % that test "/nickname" would match "/nick" and the rest be read as an
  2477  (1817)      % argument.
  2478  (1818)      % -----------------------------------------------------------------------
  2479  (1819)      ROUTINE VOID, INTEGER (BYTES, INTEGER) : cmdIs(word, wordLen)
  2480  (1820)          INTEGER : i, c, w
  2481  (1821)  
  2482  (1822)          IF typedLen < wordLen + 1 THEN
  2483  (1823)              0 RETURN
  2484  (1824)          ENDIF
  2485  (1825)  
  2486  (1826)          FOR i IN 1:wordLen DO
  2487  (1827)              typed(i) =: c
  2488  (1828)              % Fold lower case to upper: 'a' is 97, 'z' is 122.
  2489  (1829)              IF c >= 97 AND c <= 122 THEN
  2490  (1830)                  c - 32 =: c
  2491  (1831)              ENDIF
  2492  (1832)              word(i - 1) =: w
  2493  (1833)              IF c >< w THEN
  2494  (1834)                  0 RETURN
  2495  (1835)              ENDIF
  2496  (1836)          ENDFOR
  2497  (1837)  
  2498  (1838)          % The word must END here - the next character is a space or nothing.
  2499  (1839)          IF typedLen = wordLen + 1 THEN
  2500  (1840)              1 RETURN
  2501  (1841)          ENDIF
  2502  (1842)  
  2503  (1843)          IF typed(wordLen + 1) = 32 THEN
  2504  (1844)              1 RETURN
  2505  (1845)          ENDIF
  2506  (1846)  
  2507  (1847)          0 RETURN
  2508  (1848)      ENDROUTINE
  2509  (1849)  
  2510  (1850)      % -----------------------------------------------------------------------
  2511  (1851)      % A line beginning with "/" is a command, not something to say.
  2512  (1852)      %
  2513  (1853)      % WHAT IS AND IS NOT IMPLEMENTED, and the difference matters. /nick, /leave
  2514  (1854)      % and /quit map onto message kinds that ALREADY EXIST on the wire - kRename
  2515  (1855)      % and kLeave - and /join re-sends the join CHAT already sends at startup, to
  2516  (1856)      % a different room name. None of those invent anything.
  2517  (1857)      %
  2518  (1858)      % /who does NOT map onto anything. There is no query kind in the format, and
  2519  (1859)      % the format is pinned byte-for-byte by ChatMessageGoldenBytesTests on the
  2520  (1860)      % C# side, so adding one is a change to BOTH ends in the same commit - not
  2521  (1861)      % something this file may do on its own. It says so rather than pretending.
  2522  (1862)      % -----------------------------------------------------------------------
  2523  (1863)      ROUTINE VOID, VOID : handleCommand
  2524  (1864)          INTEGER : at, argLen, i, length
  2525  (1865)  
  2526  (1866)          IF cmdIs('HELP', 4) = 1 THEN
  2527  (1867)              OUTPUT(1, 'AL15', 'CHAT commands:$')
  2528  (1868)              OUTPUT(1, 'AL11', 'you are in ')
  2529  (1869)              showRoom
  2530  (1870)              OUTPUT(1, 'AL1', '$')
  2531  (1871)              OUTPUT(1, 'AL47', '  /join <room>   join another room, short name$')
  2532  (1872)              OUTPUT(1, 'AL38', '  /nick <name>   change your nickname$')
  2533  (1873)              OUTPUT(1, 'AL37', '  /who           who is in this room$')
  2534  (1874)              OUTPUT(1, 'AL32', '  /leave         leave the room$')
  2535  (1875)              OUTPUT(1, 'AL32', '  /quit          leave and stop$')
  2536  (1876)              OUTPUT(1, 'AL36', '  anything else is said to the room$')
  2537  (1877)              RETURN
  2538  (1878)          ENDIF
  2539  (1879)  
  2540  (1880)          % /who - ask the room for its membership list.
  2541  (1881)          %
  2542  (1882)          % This used to print three lines saying the format had no kind for it.
  2543  (1883)          % It has one now: kWho = 11, added to ChatMessageKind.cs, CHATSV.PLNC
  2544  (1884)          % and here together, which is what those lines said the change needed.
  2545  (1885)          % The answer arrives later as an ordinary message and is printed by
  2546  (1886)          % showArrived - nothing waits here.
  2547  (1887)          IF cmdIs('WHO', 3) = 1 THEN
  2548  (1888)              IF NOT joined THEN
  2549  (1889)                  OUTPUT(1, 'AL40', 'CHAT: not in a room yet - wait or /join$')
  2550  (1890)                  RETURN
  2551  (1891)              ENDIF
  2552  (1892)              buildOwn(kWho, 0) =: length
  2553  (1893)              sendToServer(length)
  2554  (1894)              RETURN
  2555  (1895)          ENDIF
  2556  (1896)  
  2557  (1897)          IF cmdIs('JOIN', 4) = 1 THEN
  2558  (1898)              6 =: at
  2559  (1899)              typedLen - at =: argLen
  2560  (1900)              IF argLen < 1 THEN
  2561  (1901)                  OUTPUT(1, 'AL30', 'CHAT: /join needs a room name$')
  2562  (1902)                  RETURN
  2563  (1903)              ENDIF
  2564  (1904)              IF argLen > maxNameLen THEN
  2565  (1905)                  OUTPUT(1, 'AL33', 'CHAT: that room name is too long$')
  2566  (1906)                  RETURN
  2567  (1907)              ENDIF
  2568  (1908)  
  2569  (1909)              % LEAVE THE OLD ROOM FIRST. Without this the old room still counts
  2570  (1910)              % us as a member and still holds our seat: it never hears that we
  2571  (1911)              % went, and a room only gives a seat back on a clean leave or on a
  2572  (1912)              % reap. Two or three /joins and the room is full of people who are
  2573  (1913)              % not there. The reported "/join doesn't work" hid this one - the
  2574  (1914)              % join never reached a room, so the leak never had a chance to show.
  2575  (1915)              IF joined THEN
  2576  (1916)                  buildOwn(kLeave, 0) =: length
  2577  (1917)                  sendToServer(length)
  2578  (1918)              ENDIF
  2579  (1919)  
  2580  (1920)              % Re-point the room and send the join again. setRoom adds the
  2581  (1921)              % "CHAT-" prefix; the raw copy that stood here is the whole of the
  2582  (1922)              % /join defect.
  2583  (1923)              setRoom(at, argLen)
  2584  (1924)              FALSE =: joined
  2585  (1925)              0 =: serverMagic
  2586  (1926)              OUTPUT(1, 'AL14', 'CHAT: joining ')
  2587  (1927)              showRoom
  2588  (1928)              OUTPUT(1, 'AL4', '...$')
  2589  (1929)              sendJoin
  2590  (1930)              RETURN
  2591  (1931)          ENDIF
  2592  (1932)  
  2593  (1933)          IF cmdIs('NICK', 4) = 1 THEN
  2594  (1934)              6 =: at
  2595  (1935)              typedLen - at =: argLen
  2596  (1936)              IF argLen < 1 THEN
  2597  (1937)                  OUTPUT(1, 'AL25', 'CHAT: /nick needs a name$')
  2598  (1938)                  RETURN
  2599  (1939)              ENDIF
  2600  (1940)              IF argLen > maxNameLen THEN
  2601  (1941)                  OUTPUT(1, 'AL28', 'CHAT: that name is too long$')
  2602  (1942)                  RETURN
  2603  (1943)              ENDIF
  2604  (1944)              % NOT JOINED? THEN THIS IS NOT A RENAME - IT IS A RETRY.
  2605  (1945)              %
  2606  (1946)              % This used to answer "not in the room yet" and stop, which
  2607  (1947)              % left a refused user with NO WAY OUT: the server turns a
  2608  (1948)              % duplicate nickname away, and the client then refused the one
  2609  (1949)              % command that could fix it. The only escape was to quit and
  2610  (1950)              % edit CHAT:CNFG by hand, which no end user will do.
  2611  (1951)              % MEASURED 2026-08-20 with two terminals on one SINTRAN user:
  2612  (1952)              % both read the same CHAT:CNFG, both wanted the same name, and
  2613  (1953)              % the second was stuck.
  2614  (1954)              %
  2615  (1955)              % Both halves were individually right - the server should
  2616  (1956)              % refuse a duplicate, and a rename normally IS a message to a
  2617  (1957)              % room. The combination was the trap.
  2618  (1958)              %
  2619  (1959)              % With no room to tell, changing the name is purely local:
  2620  (1960)              % take the new name and knock again.
  2621  (1961)              IF NOT joined THEN
  2622  (1962)                  setMyName(at, argLen)
  2623  (1963)                  showMyName
  2624  (1964)                  sendJoin
  2625  (1965)                  RETURN
  2626  (1966)              ENDIF
  2627  (1967)  
  2628  (1968)              % THE NEW NAME GOES IN THE NAME FIELD - see buildRename, which is
  2629  (1969)              % where the whole story of this being wrong the other way round is
  2630  (1970)              % written down. It reads the name straight out of typed, so there is
  2631  (1971)              % no shuffling to do here either.
  2632  (1972)              buildRename(at, argLen) =: length
  2633  (1973)              sendToServer(length)
  2634  (1974)  
  2635  (1975)              % Our own name changes only when the room says so, with kRenamed.
  2636  (1976)              RETURN
  2637  (1977)          ENDIF
  2638  (1978)  
  2639  (1979)          IF cmdIs('LEAVE', 5) = 1 THEN
  2640  (1980)              IF NOT joined THEN
  2641  (1981)                  OUTPUT(1, 'AL26', 'CHAT: not in the room yet$')
  2642  (1982)                  RETURN
  2643  (1983)              ENDIF
  2644  (1984)              buildOwn(kLeave, 0) =: length
  2645  (1985)              sendToServer(length)
  2646  (1986)              FALSE =: joined
  2647  (1987)              0 =: serverMagic
  2648  (1988)              OUTPUT(1, 'AL20', 'CHAT: left the room$')
  2649  (1989)              RETURN
  2650  (1990)          ENDIF
  2651  (1991)  
  2652  (1992)          IF cmdIs('QUIT', 4) = 1 THEN
  2653  (1993)              IF joined THEN
  2654  (1994)                  buildOwn(kLeave, 0) =: length
  2655  (1995)                  sendToServer(length)
  2656  (1996)              ENDIF
  2657  (1997)              FALSE =: running
  2658  (1998)              OUTPUT(1, 'AL10', 'CHAT: bye$')
  2659  (1999)              RETURN
  2660  (2000)          ENDIF
  2661  (2001)  
  2662  (2002)          OUTPUT(1, 'AL34', 'CHAT: no such command - try /help$')
  2663  (2003)      ENDROUTINE
  2664  (2004)  
  2665  (2005)      % -----------------------------------------------------------------------
  2666  (2006)      % The program.
  2667  (2007)      % -----------------------------------------------------------------------
  2668  (2008)      PROGRAM : chatClient
  2669  (2009)          XMMSGIDENTIFIER : msgIdent
  2670  (2010)          INTEGER : length
  2671  (2011)          INTEGER : i                   % the start-up room copy below uses it
  2672  (2012)  
  2673  (2013)          INISTACK stack
  2674  (2014)  
  2675  (2015)          xmpfopn(0, myPort) =: returnStatus
  2676  (2016)          IF returnStatus >< XMOK THEN
  2677  (2017)              showStatus('xmpfopn', returnStatus)
  2678  (2018)              RETURN
  2679  (2019)          ENDIF
  2680  (2020)  
  2681  (2021)          % A "port = N magic= M st= S" line used to print here, from a XMPFP2M
  2682  (2022)          % call kept only to feed it. It was there to answer one question: the
  2683  (2023)          % server was receiving the join, parsing it exactly right and answering
  2684  (2024)          % with status 0, and nothing was arriving back - so was the reply going
  2685  (2025)          % to the wrong address?
  2686  (2026)          %
  2687  (2027)          % IT WAS NOT. The reply address was never the bug. The two magic numbers
  2688  (2028)          % matched, which is what sent the search to the receive test in drainPort
  2689  (2029)          % where the real fault was: XMPFRCV returned XMOK, the test excluded
  2690  (2030)          % zero, and the welcome was dequeued and dropped. That is the whole
  2691  (2031)          % reason this diagnostic earned its keep, and the reason it can now go.
  2692  (2032)          %
  2693  (2033)          % XMPFP2M went with it. Nothing else read myMagic.
  2694  (2034)  
  2695  (2035)          % ===================================================================
  2696  (2036)          % HOW THIS CLIENT WATCHES TWO THINGS WITHOUT A NO-WAIT TERMINAL.
  2697  (2037)          %
  2698  (2038)          % The obvious design polls both: switch the terminal to no-wait with
  2699  (2039)          % TNOWAIT (307B) so INBT stops blocking, then spin on keyboard and port
  2700  (2040)          % together.
  2701  (2041)          %
  2702  (2042)          % ============================================================ SOLVED ==
  2703  (2043)          % EVERYTHING BELOW THIS LINE IS KEPT AS A RECORD OF A WRONG CONCLUSION.
  2704  (2044)          % It argued at length that a no-wait terminal could not be had here, and
  2705  (2045)          % that the client should therefore let the keyboard block. That decision
  2706  (2046)          % is what made an arriving line invisible until the user pressed return,
  2707  (2047)          % which on 2026-08-20 looked exactly like a broadcast reaching nobody
  2708  (2048)          % and cost an afternoon.
  2709  (2049)          %
  2710  (2050)          % THE WAY THROUGH IS MONITOR_CALL BY NAME, which the reasoning below
  2711  (2051)          % dismisses because "the MON-CALL-NAMES file was not found". That file
  2712  (2052)          % is supplied by MON-CALL-1B-A00, which is now INSTALLED and is already
  2713  (2053)          % in this client's LOAD list - CHATSV has been calling
  2714  (2054)          % MONITOR_CALL('TimeOut', ...) with it for weeks. And the call wanted is
  2715  (2055)          % not TNOWAIT (307B) at all but NoWaitSwitch (NOWT 36B), whose three
  2716  (2056)          % parameters are ALL INPUTS, so there is not even an output to get
  2717  (2057)          % wrong. See terminalNoWait and terminalWait above.
  2718  (2058)          %
  2719  (2059)          % The lesson is the one that keeps recurring on this project: a "cannot"
  2720  (2060)          % written down once outlives the thing that made it true. This note
  2721  (2061)          % survived the installation of the very package that answers it.
  2722  (2062)          % ======================================================================
  2723  (2063)          %
  2724  (2064)          % The old reasoning, for the record:
  2725  (2065)          %
  2726  (2066)          %   THE PORT IS DRAINED WITHOUT WAITING - xmpfrcv with flags ZERO.
  2727  (2067)          %   That is XMSG'S OWN no-wait and has nothing to do with the terminal:
  2728  (2068)          %   without XFWTF the call returns at once whether or not a message was
  2729  (2069)          %   there. So everything waiting can be taken and printed in a tight
  2730  (2070)          %   loop that never blocks.
  2731  (2071)          %
  2732  (2072)          %   THE KEYBOARD IS ALLOWED TO BLOCK - MON1, one character at a time,
  2733  (2073)          %   until carriage return.
  2734  (2074)          %
  2735  (2075)          % The one thing it costs: arriving lines are shown when you finish
  2736  (2076)          % yours, not the instant they land. Press RETURN on an empty line to
  2737  (2077)          % look. That is the whole price, and it buys a client that needs no
  2738  (2078)          % missing product, no assembler and no interface routine.
  2739  (2079)          %
  2740  (2080)          % Reading the keyboard needs INBT (1B). Getting a NO-WAIT terminal
  2741  (2081)          % would additionally need TNOWAIT (307B), and that is the one that
  2742  (2082)          % cannot be had:
  2743  (2083)          %
  2744  (2084)          % MONITOR_CALL IS THE WRONG TOOL, both ways round, and both were tried:
  2745  (2085)          %
  2746  (2086)          %   By NAME - Monitor_Call('InByte', ...), the form the Monitor Calls
  2747  (2087)          %   manual prints for PLANC - needs the MON-CALL-NAMES file. The
  2748  (2088)          %   compiler answers THE MON-CALL-NAMES FILE WAS NOT FOUND, and no such
  2749  (2089)          %   file exists under any of the nine users on this machine.
  2750  (2090)          %
  2751  (2091)          %   By NUMBER - MONITOR_CALL(1B, ...) - compiles and then does not
  2752  (2092)          %   link: it generates a call to 5MON_P, which is in neither
  2753  (2093)          %   PLANC-1BANK-F00 nor PLANC-2BANK-F00 (LIST-ENTRIES-UNDEFINED after
  2754  (2094)          %   loading both).
  2755  (2095)          %
  2756  (2096)          % WHAT THE PLANC MANUAL ACTUALLY SAYS (ND-60.117.5, appendix 0.2,
  2757  (2097)          % "Monitor Calls Available on the ND-100 and the ND-500"): the runtime
  2758  (2098)          % provides monitor calls as ORDINARY ROUTINES, one per call, named MONn
  2759  (2099)          % and IMPORTed like anything else -
  2760  (2100)          %
  2761  (2101)          %     ROUTINE VOID, BYTE (INTEGER) : MON1 (dev)      % INBIT
  2762  (2102)          %
  2763  (2103)          % which is why the COSMOS guide's own sample opens with
  2764  (2104)          % IMPORT (ROUTINE VOID, VOID: MONO) - that is MON0, LEAVE. These are
  2765  (2105)          % the MN1, MN122, MN310 ... units sitting in PLANC-1BANK-F00. So INBT
  2766  (2106)          % is reachable, correctly, as MON1(1) - no MONITOR_CALL, no names file,
  2767  (2107)          % no 5MON_P.
  2768  (2108)          %
  2769  (2109)          % TNOWAIT IS NOT. The appendix lists MON 0,1,2,3,4,11,12,17,21,45,47,
  2770  (2110)          % 50,54,62,63,64,65,104,113,114,117,120,144,161,162,167,263 - and 307
  2771  (2111)          % is not among them. The manual says what to do about that in as many
  2772  (2112)          % words: "Any monitor calls not listed here, may be called from a PLANC
  2773  (2113)          % routine if a suitable interface routine is constructed by the user.
  2774  (2114)          % If this is done, the user must load the interface routine BEFORE the
  2775  (2115)          % PLANC runtime library."
  2776  (2116)          %
  2777  (2117)          % A hand-written interface routine for MON 307B, loaded ahead of
  2778  (2118)          % PLANC-1BANK-F00, is what the manual says to do about that.
  2779  (2119)          %
  2780  (2120)          % THIS COMMENT USED TO SAY THAT WAS IMPOSSIBLE HERE. It claimed "D100 has
  2781  (2121)          % neither MAC nor NPL installed (LIST-FILES found only MACM-AREA:DATA)".
  2782  (2122)          % BOTH HALVES ARE WRONG, and the way they were wrong is worth keeping.
  2783  (2123)          %
  2784  (2124)          % LIST-FILES IS THE WRONG COMMAND FOR THIS QUESTION. Compilers and other
  2785  (2125)          % subsystems are loaded into shared memory across users, not kept as :PROG
  2786  (2126)          % files in anybody's area, so LIST-FILES was never going to find one and
  2787  (2127)          % its silence proved nothing. The command that answers it is
  2788  (2128)          % LIST-REENTRANT. On D100, 2026-08-18:
  2789  (2129)          %
  2790  (2130)          %   START RESTART SEGMENT   NAME
  2791  (2131)          %  177777B 177776B    107B   MAC
  2792  (2132)          %      0B      1B    110B   NPL
  2793  (2133)          %    752B    752B    111B   PLANC-100
  2794  (2134)          %     0B      0B    112B   PED
  2795  (2135)          %    11B     11B    113B   FORTRAN-100
  2796  (2136)          %
  2797  (2137)          % MAC and NPL are BOTH there, alongside the PLANC that builds this program.
  2798  (2138)          % @MAC answers "- MAC -".
  2799  (2139)          %
  2800  (2140)          % So the door the manual describes is open: any monitor call outside the
  2801  (2141)          % runtime's ready-made MONn set can be reached with an interface routine
  2802  (2142)          % assembled in MAC and loaded BEFORE the PLANC library. TNOWAIT (307B) is
  2803  (2143)          % the one this program wanted, and with it the loop below could stop being
  2804  (2144)          % a busy one - see "what is not finished" at the foot of the file.
  2805  (2145)          %
  2806  (2146)          % The design below still stands on its own: it needs no interface routine,
  2807  (2147)          % and it works. But it is now a CHOICE rather than the only option, and
  2808  (2148)          % nobody should read this comment and conclude the machine cannot do it.
  2809  (2149)          % ===================================================================
  2810  (2150)  
  2811  (2151)          % SETTLE THE NAME BEFORE THE JOIN, because the join CARRIES it and
  2812  (2152)          % there is no second chance to put one in. Nothing is asked of the
  2813  (2153)          % user - see setupName.
  2814  (2154)          setupName
  2815  (2155)  
  2816  (2156)          % THE DEFAULT ROOM, BUILT BY THE SAME RULE AS A TYPED /join.
  2817  (2157)          %
  2818  (2158)          % This client joins a room at start-up whether or not the user asked
  2819  (2159)          % for one, and the bug report was right that nothing said so. It is
  2820  (2160)          % said now, with the name in parentheses.
  2821  (2161)          %
  2822  (2162)          % The short name goes through "typed" because setRoom reads from there.
  2823  (2163)          % That is deliberate: the prefix is then added in ONE place for both
  2824  (2164)          % paths, and the start-up name cannot drift from the /join name.
  2825  (2165)          FOR i IN 1:lenHomeRoom DO
  2826  (2166)              homeRoom(i - 1) =: typed(i - 1)
  2827  (2167)          ENDFOR
  2828  (2168)          setRoom(0, lenHomeRoom)
  2829  (2169)  
  2830  (2170)          OUTPUT(1, 'AL14', 'CHAT: joining ')
  2831  (2171)          showRoom
  2832  (2172)          OUTPUT(1, 'AL25', ' - type and press return$')
  2833  (2173)          sendJoin
  2834  (2174)  
  2835  (2175)          % FROM HERE THE TERMINAL IS IN NO-WAIT, so MON1 stops blocking and the
  2836  (2176)          % loop below can look at the port and the keyboard in turn. Switched on
  2837  (2177)          % AFTER the join is sent, so nothing above has to care, and switched off
  2838  (2178)          % again on the way out - see the end of the loop.
  2839  (2179)          terminalNoWait
  2840  (2180)  
  2841  (2181)          DO
  2842  (2182)              % ---- take everything the port is holding, without waiting -------
  2843  (2183)              drainPort
  2844  (2184)  
  2845  (2185)              % ---- then take whatever HAS been typed, without waiting ---------
  2846  (2186)              % MON1 CAN RAISE A ROUTINEERROR, AND IT MUST BE CAUGHT HERE.
  2847  (2187)              %
  2848  (2188)              % Measured on D100: without this handler the client printed the
  2849  (2189)              % same arriving message for ever and ESC broke it out of a SPIN,
  2850  (2190)              % not out of a wait - so MON1 was not blocking at all. The terminal
  2851  (2191)              % is in no-wait BECAUSE terminalNoWait ABOVE PUT IT THERE, and that
  2852  (2192)              % call is new: for a long time this comment asserted the no-wait
  2853  (2193)              % state while nothing in the program ever asked for it, so MON1
  2854  (2194)              % really did block and the loop only came round when the user
  2855  (2195)              % pressed return. The Monitor Calls manual says what no-wait means:
  2856  (2196)              % "In No Wait, the program does not wait for input or output to
  2857  (2197)              % complete. Monitor calls like InByte return ERROR CODE 3 instead."
  2858  (2198)              % In PLANC that arrives as a ROUTINEERROR, and an unhandled one
  2859  (2199)              % unwinds the program - which re-entered, re-sent the join, and
  2860  (2200)              % produced another undeliverable letter coming back. One missing
  2861  (2201)              % handler, three symptoms.
  2862  (2202)              %
  2863  (2203)              % Caught, it is exactly the poll the design wanted: ErrCode 3 means
  2864  (2204)              % nothing was typed, so leave ch at zero and let the loop go round
  2865  (2205)              % to look at the port again. ErrCode is supplied by the runtime and
  2866  (2206)              % must NOT be declared.
  2867  (2207)              % lineReady stays FALSE until RETURN is seen. typedLen is NOT reset
  2868  (2208)              % here: a line half typed when the port needs draining has to
  2869  (2209)              % survive the trip round the outer loop, so it is only cleared once
  2870  (2210)              % the line has been dealt with.
  2871  (2211)              FALSE =: lineReady
  2872  (2212)              DO
  2873  (2213)                  0 =: ch
  2874  (2214)                  ON ROUTINEERROR DO
  2875  (2215)                      IF ErrCode >< emptyInput THEN
  2876  (2216)                          OUTPUT(1, 'AL27', 'CHAT: terminal read failed$')
  2877  (2217)                      ENDIF
  2878  (2218)                      0 =: rawCh
  2879  (2219)                  ENDON
  2880  (2220)                  MON1(ownTerminal) =: rawCh
  2881  (2221)                  % PARITY. Terminal input carries an even-parity bit in bit 7,
  2882  (2222)                  % so carriage return arrives as 141, NOT 13. Compare without
  2883  (2223)                  % masking and the client never sees the user press return and
  2884  (2224)                  % looks hung rather than wrong.
  2885  (2225)                  rawCh =: ch
  2886  (2226)                  ch AND parityMask =: ch
  2887  (2227)  
  2888  (2228)                  IF ch = carriageRet THEN
  2889  (2229)                      TRUE =: lineReady
  2890  (2230)                  ENDIF
  2891  (2231)  
  2892  (2232)                  % Leave the moment the keyboard runs dry (ch = 0, nothing was
  2893  (2233)                  % typed) or the line is finished. Going round again on an empty
  2894  (2234)                  % buffer is what turns this into a spin instead of a poll.
  2895  (2235)                  WHILE ch >< 0 AND NOT lineReady
  2896  (2236)  
  2897  (2237)                  IF ch > 31 THEN
  2898  (2238)                      % The bound. A full line stops accepting characters rather
  2899  (2239)                      % than writing past the end of typed - PLANC checks no array
  2900  (2240)                      % bound, so this test is the only thing between a held-down
  2901  (2241)                      % key and the variables laid out after it.
  2902  (2242)                      IF typedLen < maxTyped THEN
  2903  (2243)                          ch =: typed(typedLen)
  2904  (2244)                          typedLen + 1 =: typedLen
  2905  (2245)                      ENDIF
  2906  (2246)                  ENDIF
  2907  (2247)              ENDDO
  2908  (2248)  
  2909  (2249)              IF lineReady AND typedLen > 0 THEN
  2910  (2250)                  % NOTHING IS SENT BEFORE THE WELCOME. serverMagic is not known
  2911  (2251)                  % until then, so sending here would post the line to address
  2912  (2252)                  % zero. ChatClient.Say refuses the same way; this is that test.
  2913  (2253)                  % A LEADING SLASH MAKES IT A COMMAND, not something to say.
  2914  (2254)                  IF typed(0) = 47 THEN
  2915  (2255)                      handleCommand
  2916  (2256)                  ELSE
  2917  (2257)                      IF joined THEN
  2918  (2258)                          buildOwn(kSay, typedLen) =: length
  2919  (2259)                          sendToServer(length)
  2920  (2260)                      ELSE
  2921  (2261)                          OUTPUT(1, 'AL26', 'CHAT: not in the room yet$')
  2922  (2262)                      ENDIF
  2923  (2263)                  ENDIF
  2924  (2264)              ENDIF
  2925  (2265)  
  2926  (2266)              % Cleared only once the finished line has been dealt with, so a
  2927  (2267)              % line still being typed is not thrown away by a drain pass.
  2928  (2268)              IF lineReady THEN
  2929  (2269)                  0 =: typedLen
  2930  (2270)              ENDIF
  2931  (2271)  
  2932  (2272)              % ---- NOTHING HAPPENED? THEN GIVE THE MACHINE A MOMENT -----------
  2933  (2273)              % With the terminal in no-wait, MON1 returns at once whether or not
  2934  (2274)              % anything was typed, so a pass that found no message AND no key is
  2935  (2275)              % a pass that would otherwise go straight round again at full speed.
  2936  (2276)              % That is a SPIN, and it is the same shape that burned the machine
  2937  (2277)              % under CHATSV when XMSG died - the note beside sleepUnits carries
  2938  (2278)              % the measurement.
  2939  (2279)              %
  2940  (2280)              % The sleep is skipped whenever ANYTHING happened, so a busy room
  2941  (2281)              % and a fast typist both stay immediate; only an idle client waits,
  2942  (2282)              % and then only a fifth of a second.
  2943  (2283)              IF lastDrainCount = 0 AND typedLen = 0 AND NOT lineReady THEN
  2944  (2284)                  idleSleep
  2945  (2285)              ENDIF
  2946  (2286)  
  2947  (2287)              % /quit clears this. The continue-test goes LAST so the leave
  2948  (2288)              % message it sends is on its way before the loop ends.
  2949  (2289)              WHILE running
  2950  (2290)          ENDDO
  2951  (2291)  
  2952  (2292)          % PUT THE TERMINAL BACK. Anything that leaves this loop - /quit, or the
  2953  (2293)          % port going away when XMSG dies - hands the terminal back to the user's
  2954  (2294)          % shell, and it must be handed back in the state it was lent in. A
  2955  (2295)          % terminal left in no-wait is one every later program has to live with.
  2956  (2296)          terminalWait
  2957  (2297)      ENDROUTINE
  2958  (2298)  
  2959  (2299)  ENDMODULE
  2960  (2300)  
  2961  (2301)  % NO $EOF HERE, deliberately, and it is not an oversight - an earlier version
  2962  (2302)  % had one and it broke the build.
  2963  (2303)  %
  2964  (2304)  % $EOF belongs at the end of an INCLUDED source, where it stops the compiler
  2965  (2305)  % reading past the file's end and calling that the end of the whole
  2966  (2306)  % compilation. XMPIMP:INCL has one for exactly that reason, and so does the
  2967  (2307)  % shipped (UTILITY)XMSG-PL-VALUES-L:INCL.
  2968  (2308)  %
  2969  (2309)  % In the MAIN source it does something else: it ends the compiler SESSION. The
  2970  (2310)  % compiler links and returns to SINTRAN there and then, so every command after
  2971  (2311)  % the COMPILE - the EXIT, and any LOAD - is handed to SINTRAN instead, which
  2972  (2312)  % answers ILLEGAL COMMAND and aborts the batch job. Measured on D100: the LOAD
  2973  (2313)  % line arrived at the shell as "L".
  2974  (2314)  %
  2975  (2315)  % The library is brought in afterwards by BRF-LINKER-C01. See CHATCC:MODE.
  2976  (2316)  
  2977  (2317)  % ---------------------------------------------------------------------------
  2978  (2318)  % WHAT IS NOT FINISHED:
  2979  (2319)  %
  2980  (2320)  %  1. TWO ITEMS THAT USED TO BE ON THIS LIST WERE STALE, and they are recorded
  2981  (2321)  %     here rather than quietly deleted, because a list of open problems that
  2982  (2322)  %     keeps solved ones on it is worse than no list: it sends the next person
  2983  (2323)  %     to work that is already done.
  2984  (2324)  %
  2985  (2325)  %       "Nothing has been compiled."   It compiles and it runs. See the header.
  2986  (2326)  %
  2987  (2327)  %       "No way to leave. kLeave is declared and never sent."   /leave and
  2988  (2328)  %       /quit both send it - handleCommand, which was written after this line
  2989  (2329)  %       and never came back to cross it off.
  2990  (2330)  %
  2991  (2331)  %     The remaining items below were re-read against the code on 2026-08-18 and
  2992  (2332)  %     are still true.
  2993  (2333)  %
  2994  (2334)  %  2. THE LOOP IS A BUSY ONE. It reads the keyboard and the port as fast as the
  2995  (2335)  %     machine will go, which on a shared SINTRAN is antisocial. The server does
  2996  (2336)  %     not have this problem - it BLOCKS on XFWTF - but a client watching two
  2997  (2337)  %     things cannot block on either one.
  2998  (2338)  %
  2999  (2339)  %     THE EXPERIMENT TO RUN, which is one specific thing rather than a research
  3000  (2340)  %     project. Both halves have a documented wake:
  3001  (2341)  %
  3002  (2342)  %       the terminal   after a no-wait call, "SuspendProgram or WaitForRestart
  3003  (2343)  %                      may passivate the program afterwards. The program
  3004  (2344)  %                      restarts when input or output to the device is
  3005  (2345)  %                      completed."          (Monitor Calls, NoWaitSwitch)
  3006  (2346)  %
  3007  (2347)  %       the port       XMPFRCV with XFWAK and WITHOUT XFWTF returns at once and
  3008  (2348)  %                      ARMS a wake: "the next transmission to this port will
  3009  (2349)  %                      lead to a wake up of the receiver task". Note that "when
  3010  (2350)  %                      the wake up is done, the message is not received, and so
  3011  (2351)  %                      the receiving must be repeated."   (COSMOS guide, XFWAK)
  3012  (2352)  %
  3013  (2353)  %     So the shape to try is: arm the port with XFWAK, then WaitForRestart, and
  3014  (2354)  %     on waking re-issue the receive and re-read the keyboard, because either
  3015  (2355)  %     could be what woke us.
  3016  (2356)  %
  3017  (2357)  %     AND THE OTHER ROUTE IS OPEN AFTER ALL: MAC and NPL are BOTH installed on
  3018  (2358)  %     D100 (verified 2026-08-18 with LIST-REENTRANT, which is the command that
  3019  (2359)  %     answers this - subsystems live in shared memory, not as :PROG files, so
  3020  (2360)  %     LIST-FILES finding nothing proved nothing). So TNOWAIT (307B) can be reached
  3021  (2361)  %     the way the PLANC manual says: an interface routine assembled in MAC and
  3022  (2362)  %     loaded BEFORE PLANC-1BANK-F00. That is now a real option to weigh against the XFWAK
  3023  (2363)  %     experiment below, not a closed door.
  3024  (2364)  %
  3025  (2365)  %     WHAT IS NOT ESTABLISHED is whether an XMSG wake-up actually restarts a
  3026  (2366)  %     BACKGROUND PROGRAM passivated that way. The call that makes the wake-up
  3027  (2367)  %     context explicit, XMPFWDF, is for DRIVERS - the guide says so, and adds
  3028  (2368)  %     "not permitted for RT-programs". So this is one measurement, not a
  3029  (2369)  %     deduction, and until it is made the loop stays as it is: honest and rude.
  3030  (2370)  %     A short HOLD is the fallback if the wake does not arrive.
  3031  (2371)  %
  3032  (2372)  %  3. THE NAME IS NO LONGER FIXED AT RONNY, and this item is kept in corrected
  3033  (2373)  %     form because it went through a wrong shape on the way.
  3034  (2374)  %
  3035  (2375)  %     It was briefly a PROMPT at start-up, and that was a mistake: on a machine
  3036  (2376)  %     where you have already told SINTRAN who you are by logging in, being
  3037  (2377)  %     asked your name again on every run is nagging. It is now read from
  3038  (2378)  %     CHAT:CNFG in your own file area, changed with /nick, and saved only when
  3039  (2379)  %     the ROOM confirms the rename - never when the request is sent, because
  3040  (2380)  %     the room can refuse it.
  3041  (2381)  %
  3042  (2382)  %     WHAT IS STILL MISSING is the right fallback for somebody who has never
  3043  (2383)  %     renamed: it should be the SINTRAN user name and it is still RONNY.
  3044  (2384)  %     GetUserName is GUSNA 214B, and the PLANC runtime provides no MON214 -
  3045  (2385)  %     the same gap CreateFile 221B falls into, which is why creating CHAT:CNFG
  3046  (2386)  %     goes through MON70 instead. There is no command-level way round 214, so
  3047  (2387)  %     it needs the route the PLANC manual describes in as many words: an
  3048  (2388)  %     interface routine assembled in MAC and loaded BEFORE the PLANC runtime
  3049  (2389)  %     library. MAC is installed here - LIST-REENTRANT shows it - so this is
  3050  (2390)  %     work, not a wall.
  3051  (2391)  %
  3052  (2392)  %  4. The ON ROUTINEERROR form is taken from the Monitor Calls manual's own
  3053  (2393)  %     PLANC example for InByte. That ErrCode 3 specifically means "nothing was
  3054  (2394)  %     typed" is from the NoWaitSwitch entry, which says so for no-wait calls
  3055  (2395)  %     generally rather than for InByte in particular. If some other code turns
  3056  (2396)  %     up in practice, the handler above prints and carries on rather than
  3057  (2397)  %     mistaking it for a keystroke.
  3058  (2398)  % ---------------------------------------------------------------------------
  3059  (2399)  