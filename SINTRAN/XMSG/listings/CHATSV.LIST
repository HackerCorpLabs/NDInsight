   204   (129)  CONSTANT XKXXX=16896   % BASE for STANDARD ERROR system (41000B)
   205   (130)  CONSTANT XENOT= -1     % No more XT-blocks free
   206   (131)  CONSTANT XEIRM= -2     % Non-local remote port illegal here
   207   (132)  CONSTANT XETMM= -4     % Task is not allowed any more memory
   208   (133)  CONSTANT XENIM= -5     % Facility not yet implemented
   209   (134)  CONSTANT XEIBP= -6     % Illegal message buffer pointer
   210   (135)  CONSTANT XEBNY= -7     % Message buffer not yours
   211   (136)  CONSTANT XEIRT= -8     % Illegal function for RT-programs (only drivers)
   212   (137)  CONSTANT XENOP= -9     % No more ports available
   213   (138)  CONSTANT XEIDR= -10    % Function not available to drivers
   214   (139)  CONSTANT XENDM= -11    % No default message
   215   (140)  CONSTANT XEMCH= -12    % Message is already chained
   216   (141)  CONSTANT XEBFC= -13    % Message is in a queue
   217   (142)  CONSTANT XEAIN= -14    % XMSG Kernel already initialised
   218   (143)  CONSTANT XEBNC= -15    % Return of a bounce message
   219   (144)  CONSTANT XEWNA= -16    % Write Not Allowed (Indirect buffer)
   220   (145)  CONSTANT XENVI= -17    % No Valid Indirect buffer defined
   221   (146)  CONSTANT XEILF= -18    % Illegal function code in monitor call
   222   (147)  CONSTANT XEIMA= -19    % Invalid magic number
   223   (148)  CONSTANT XEMFL= -20    % Message space full
   224   (149)  CONSTANT XEILM= -21    % Illegal message size or not enough space left
   225   (150)  CONSTANT XEIPN= -22    % Illegal port number
   226   (151)  CONSTANT XEPRV= -23    % Privileged function called without privilege
   227   (152)  CONSTANT XEPVR= -24    % Privilege request refused
   228   (153)  CONSTANT XERNA= -25    % Remote system not available
   229   (154)  CONSTANT XEROV= -26    % Remote task space overflow
   230   (155)  CONSTANT XEXBF= -27    % Message already has XMSG buffer (XFDUB)
   231   (156)  CONSTANT XEDRI= -28    % Driver called XMSG before return from previous
   232   (157)  CONSTANT XENDP= -29    % No port open (so 'default port' param invalid)
   233   (158)  CONSTANT XEITL= -30    % Illegal transfer length for read/write
   234   (159)  CONSTANT XEIDP= -31    % Illegal displacement in read/write
   235   (160)  CONSTANT XEILR= -32    % Illegal use of reentrant segment in XFDIB
   236   (161)  CONSTANT XENOS= -33    % Indirect Buffer not on valid segment
   237   (162)  CONSTANT XENSE= -34    % Network sequencing error
   238   (163)  CONSTANT XERND= -35    % Remote system not defined
   239   (164)  CONSTANT XEPCL= -36    % Remote port closed while message queued
   240   (165)  CONSTANT XENRU= -37    % XMSG not running 
   241   (166)  CONSTANT XENTO= -38    % Timeout detected by network layer
   242   (167)  CONSTANT XENUS= -39    % No user segment info defined (XFUSG option)
   243   (168)  CONSTANT XEREJ= -40    % Network remote reject (request retransmit)
   244   (169)  CONSTANT XEIXT= -41    % Driver called XMSG with illegal XT-block
   245   (170)  CONSTANT XETMU= -42    % Too many multi calls
   246   (171)  CONSTANT XECRA= -63    % XMSG crash (Info in Basefield)
