   110    (35)  CONSTANT XFWHD=5             % Write header to a message (6 bytes)
   111    (36)  CONSTANT XFREA=6             % Read from message to user buffer
   112    (37)  CONSTANT XFWRI=7             % Write from user to message
   113    (38)  CONSTANT XFSCM=8             % Set current message
   114    (39)  CONSTANT XFMST=9             % Get message status
