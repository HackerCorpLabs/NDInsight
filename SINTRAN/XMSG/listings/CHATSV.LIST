   738    (78)  % ---------------------------------------------------------------------------
   739    (79)  % FILE MONITOR CALLS, for the log. Same three CHAT.PLNC uses for CHAT:CNFG,
   740    (80)  % declared the same way, because that pair has been working on D100 since
   741    (81)  % 2026-08-19 and a second spelling of a proven call is a second thing to get
   742    (82)  % wrong.
   743    (83)  %
   744    (84)  %   MON50  OpenFile   name, type, access -> device number. RAISES ROUTINEERROR
   745    (85)  %                     on failure, and leaves 46 in the device number when the
   746    (86)  %                     file is not there - NOT zero. Never test the number.
   747    (87)  %   MON2   OutByte    the byte is the IN-VALUE: "b MON2(dev)".
   748    (88)  %   MON43  CloseFile  and it is 43, not 54 - 54 is DELETE.
   749    (89)  %
   750    (90)  % They come from MON-CALL-1B-A00, which this program already links for
   751    (91)  % MONITOR_CALL - see the LOAD line in CHATSV:MODE.
   752    (92)  % ---------------------------------------------------------------------------
   753    (93)  IMPORT ( ROUTINE VOID, INTEGER (BYTES, BYTES, INTEGER) : MON50 )
   754    (94)  IMPORT ( ROUTINE BYTE, VOID (INTEGER) : MON2 )
   755    (95)  IMPORT ( ROUTINE VOID, VOID (INTEGER) : MON43 )
   756    (96)  
   757    (97)      % ----- message kinds, mirroring ChatMessageKind.cs ----------------------
   758    (98)      INTEGER : kJoin    := 1
   759    (99)      INTEGER : kWelcome := 2
   760   (100)      INTEGER : kReject  := 3
   761   (101)      INTEGER : kSay     := 4
   762   (102)      INTEGER : kSaid    := 5
   763   (103)      INTEGER : kLeave   := 6
   764   (104)      INTEGER : kJoined  := 7
   765   (105)      INTEGER : kLeft    := 8
   766   (106)      INTEGER : kRename  := 9
   767   (107)      INTEGER : kRenamed := 10
   768   (108)  
   769   (109)      % ONE KIND, BOTH DIRECTIONS: the member asks with an empty text, the room
   770   (110)      % answers with the same kind and the names in the text. See buildWho.
   771   (111)      INTEGER : kWho     := 11
   772   (112)  
   773   (113)      % ALSO ONE KIND BOTH DIRECTIONS, same shape as kWho.
   774   (114)      %
   775   (115)      % kTopic  ask: empty text.  set: the new topic in the text.
   776   (116)      %         answer: the ROOM NAME in the name field, the topic in the text.
   777   (117)      %         A SET is broadcast to the room; an ASK goes to the asker alone.
   778   (118)      % kRooms  ask: empty text. answer: "NAME(count)" per room, space separated.
   779   (119)      %
   780   (120)      % Room kinds live in 1..31 and admin starts at 32 - see the note there.
   781   (121)      % These MUST match DOC/protocols/chat-wire.json and ChatMessageKind.cs, and
   782   (122)      % all three move in the same commit.
   783   (123)      % 12 IS NOT FREE - it is Map, reserved for /map (task #77). The registry
   784   (124)      % had already allocated all three when this was written, and taking 12 for
   785   (125)      % the topic would have put /topic and /map on the same number. Read
   786   (126)      % DOC/protocols/chat-wire.json BEFORE picking a kind, not after.
   787   (127)      INTEGER : kRooms   := 13
   788   (128)      INTEGER : kTopic   := 14
   789   (129)  
   790   (130)      % ADMIN kinds - 32 and up, and they belong on the command port. These MUST
   791   (131)      % match DOC/protocols/chat-wire.json and ChatMessageKind.cs; all three move
   792   (132)      % in the same commit, which is constraint 5 of the federation design.
   793   (133)      INTEGER : kAdmStat := 32
   794   (134)      INTEGER : kAdmRepl := 33
   795   (135)      INTEGER : kAdmStop := 34
   796   (136)  
   797   (137)      % Set by an AdminStop. Checked at the bottom of the loop rather than acted
   798   (138)      % on where it arrives, so the reply path and the reaping finish first - a
   799   (139)      % stop that abandons a half-sent message is not a clean stop.
   800   (140)      BOOLEAN : stopWanted := FALSE
   801   (141)  
   802   (142)      % THERE IS NO ELEVENTH KIND, and the reason is worth keeping.
   803   (143)      %
   804   (144)      % A kHello was invented here on 2026-08-18 to answer the connect on its own,
   805   (145)      % on the belief that a connection port is handed "4 bytes with byte 0 = 0"
   806   (146)      % and that the joiner's nickname could only follow as a second, ordinary
   807   (147)      % message. That belief was wrong, and it was wrong because this program was
   808   (148)      % reading the WRONG BYTES: the connect arrives with the XSLET letter header
   809   (149)      % still in front of it, and byte 0 of that header is the serial number.
   810   (150)      %
   811   (151)      % The nickname was in the very first arrival all along. See the header skip
   812   (152)      % in the receive loop for the layout and the manual reference. The join is
   813   (153)      % ONE step, exactly as the Programmer Guide describes it: the letter carries
   814   (154)      % the user data, the server answers it, and "thereby gives away its own
   815   (155)      % magic number" - the welcome IS the answer, so no extra kind is needed.
   816   (156)  
   817   (157)      % XFWTF is the BIT POSITION (15). The flags word is 2 to that power - the
   818   (158)      % sample programs in Appendix G both write "2**XFWTF =: FLAGS". Passing 15
   819   (159)      % itself would set bits 0 to 3, four unrelated options, and the wait would
   820   (160)      % not happen at all.
   821   (161)      % XFWTF COMES FROM XMP-B02:DEFS - do NOT declare it here. Declaring our own
   822   (162)      % drew IDENTIFIER ALREADY SPECIFIED/DECLARED "XFWTF", and the compiler then
   823   (163)      % fell over with ASSERT VIOLATION AT 136747B and took the batch job with it.
   824   (164)      % A redeclaration is not a warning you can carry on past in this compiler.
   825   (165)      % ZERO, and it stays zero - see the PROGRAM body for the measurement. Flags
   826   (166)      % zero is XMSG's own no-wait: XFRCV returns at once whether or not a message
   827   (167)      % was there, which is the only way one loop can poll TWO ports.
   828   (168)      INTEGER : waitFlags := 0
   829   (169)  
   830   (170)      % 2**XFSEC, computed at start. SECURE, and the reason is a measurement.
   831   (171)      %
   832   (172)      % These sends used to carry flags ZERO, and the guide is explicit about what
   833   (173)      % that costs: "Non-secure messages are discarded and released by XMSG if they
   834   (174)      % cannot be delivered." So a member whose terminal died was written to for
   835   (175)      % ever, in silence.
   836   (176)      %
   837   (177)      % THE OBVIOUS ALTERNATIVE WAS TRIED FIRST AND IS REFUTED. XMPSEND is handed a
   838   (178)      % magic number, and a magic carries a generation, so it looked as though XMSG
   839   (179)      % would refuse one naming a closed port on the spot - XMXEIMA, "Invalid magic
   840   (180)      % number". MEASURED 2026-08-18 on D100: two clients in the room, one killed
   841   (181)      % with ESC ("USER BREAK AT 17202B"), the other spoke. The broadcast to the
   842   (182)      % dead port returned XMOK. Not one status printed, the seat stayed spent, and
   843   (183)      % LIST-NAMES held at 14. XMPSEND DOES NOT VALIDATE THE DESTINATION.
   844   (184)      %
   845   (185)      % So the return has to come back as a MESSAGE, which is what XFSEC buys:
   846   (186)      % "The message will be returned to the sending port if it cannot be
   847   (187)      % delivered, or if the receiving port is closed (e.g., if the receiving task
   848   (188)      % terminates)". It arrives as msgType XMTRE and is handled in the receive
   849   (189)      % loop.
   850   (190)      %
   851   (191)      % MEASURED WITH THE FLAG SET, same two clients, same kill: the bounce came
   852   (192)      % back carrying reason 16915 - which is XMXEIMA, the very code the refuted
   853   (193)      % attempt was watching for. It was never the send's status; it is the reason
   854   (194)      % on the return. CHAT-LOBBY went 16 free, 14 with both joined, back to 15
   855   (195)      % once the dead one was reaped.
   856   (196)      INTEGER : sendFlags := 0
   857   (197)  
   858   (198)      % ----- the room ---------------------------------------------------------
   859   (199)      % maxSeats is what XMPOPCN is given, so XROUT turns the SEVENTEENTH joiner
   860   (200)      % away before this program sees them. The array bounds and that argument are
   861   (201)      % the same number on purpose.
   862   (202)      %
   863   (203)      % THE CLIENT DOES NOT KNOW THIS NUMBER AND MUST NOT. Neither CHAT.PLNC nor
   864   (204)      % ChatClient.cs mentions it anywhere - XROUT does the admission itself, before
   865   (205)      % this program is woken, so a client that is turned away simply gets a refusal
   866   (206)      % it has to handle in any case. The room's size is the room's business, and
   867   (207)      % raising it is this file alone. The C# ChatRoom has no seat limit at all.
   868   (208)      %
   869   (209)      % Raised from 8 to 16 on 2026-08-18. Nothing else has to move with it: the
   870   (210)      % four arrays below and every FOR loop are written in terms of maxSeats, and
   871   (211)      % the only literal bounds are the array declarations, which are next to it.
   872   (212)      INTEGER : maxSeats := 16
   873   (213)      INTEGER : nameLen  := 16
   874   (214)  
   875   (215)      INTEGER4 ARRAY : memberMagic(1:16)
   876   (216)  
   877   (217)      % A two-dimensional BYTES array: sixteen names of sixteen bytes. Legal PLANC -
   878   (218)      % the reference gives BYTES ARRAY : b1(1:2,0:3) directly.
   879   (219)      %
   880   (220)      % Note that memberName(slot) with the LAST subscript omitted refers to the
   881   (221)      % WHOLE string, which is tempting for copying a name in one statement. It is
   882   (222)      % NOT used here, because a name is variable length and a whole-row copy would
   883   (223)      % carry the sixteen bytes including whatever follows the name. The explicit
   884   (224)      % loops are longer and right.
   885   (225)      % SIXTEEN BYTES PER NAME, and the number is named because the wire decides
   886   (226)      % how many bytes arrive. A nickname length is one byte, so a peer can ask for
   887   (227)      % up to 255 - and PLANC checks no array bound. Copying an unchecked length in
   888   (228)      % here writes straight through the other seven members' names and out the far
   889   (229)      % side of the array. See the guard at the top of handleMessage.
   890   (230)      INTEGER        : maxNameLen := 16
   891   (231)      % NAMES ARE UNIQUE IN THEIR FIRST TEN CHARACTERS, and that is not a style
   892   (232)      % note - it is what the compiler enforces. memberName and memberNameLen both
   893   (233)      % start MEMBERNAME, so the second silently became a redeclaration of the
   894   (234)      % first: IDENTIFIER ALREADY SPECIFIED/DECLARED "MEMBERNAME", and then every
   895   (235)      % memberName(slot, i) drew MORE SUBSCRIPTS THAN IN THE ARRAY DECLARATION,
   896   (236)      % because the name now referred to the one-dimensional array. Four errors,
   897   (237)      % one cause, and none of them mention the length. The listing gives it away:
   898   (238)      % it prints the TRUNCATED names - BUILDRENAM, BUILDFROMS, REASONNICK.
   899   (239)      BYTES ARRAY    : memberName(1:16, 1:16)
   900   (240)      INTEGER ARRAY  : memberLen(1:16)
   901   (241)      INTEGER ARRAY  : memberUsed(1:16)
   902   (242)  
   903   (243)      % Seats whose member has VANISHED - the terminal was killed, the client was
   904   (244)      % aborted with ESC, the task died. Marked by sendTo when a send comes back
   905   (245)      % saying the port is gone, and cleared by reapDead.
   906   (246)      %
   907   (247)      % A MARK IS NOT AN EVICTION, and the separation is the whole point of this
   908   (248)      % array rather than a nicety. sendTo is called from inside broadcast's loop,
   909   (249)      % and evicting there would have to announce the departure - which means
   910   (250)      % building a message into outBuf while broadcast is still part way through
   911   (251)      % sending the outBuf it built. One shared buffer, so the message everybody
   912   (252)      % else is waiting for would be overwritten mid-broadcast and the room would
   913   (253)      % receive the departure notice instead of what was said. Marking is the only
   914   (254)      % thing safe to do at that depth; the acting happens back at the top.
   915   (255)      INTEGER ARRAY  : memberDead(1:16)
   916   (256)  
   917   (257)      % ---- WHICH ROOM EACH MEMBER IS IN ------------------------------------
   918   (258)      %
   919   (259)      % The room used to be a PORT NAME - the client built "CHAT-" plus the room
   920   (260)      % and addressed that - so the server never had to know: whoever reached
   921   (261)      % this port was, by definition, in this room. One port now, so the room is
   922   (262)      % a field in the Join and the server has to remember it per member.
   923   (263)      %
   924   (264)      % Sixteen characters, same as a nickname. A room is a name a person types.
   925   (265)      BYTES ARRAY    : mbrRoom(1:16, 1:16)
   926   (266)      INTEGER ARRAY  : mbrRoomLen(1:16)
   927   (267)  
   928   (268)      % Where a member goes when the Join names no room - see copyRoomIn.
   929   (269)      BYTES          : homeRoom := 'LOBBY'
   930   (270)      INTEGER        : lenHomeRoom := 5
   931   (271)  
   932   (272)      % ---- ROOM TOPICS -----------------------------------------------------
   933   (273)      %
   934   (274)      % A SEPARATE TABLE, NOT A COLUMN IN THE MEMBER TABLE, and the reason is
   935   (275)      % that a topic OUTLIVES the people who set it. Hanging it off a seat would
   936   (276)      % throw it away the moment the last person left, which is exactly when a
   937   (277)      % topic is doing its job: telling the next person what the room is for.
   938   (278)      %
   939   (279)      % Keyed by ROOM NAME, because that is all a room is here - there is no room
   940   (280)      % id and no room record. An entry is made the first time somebody sets a
   941   (281)      % topic, and once made it stays for the life of the server.
   942   (282)      %
   943   (283)      % EIGHT rooms, not sixteen. Sixteen seats could in principle be sixteen
   944   (284)      % rooms of one person each, so this table CAN fill up - and when it does,
   945   (285)      % setTopic refuses in the open rather than silently dropping the topic. A
   946   (286)      % refusal a user can read beats a feature that quietly does nothing.
   947   (287)      INTEGER        : maxTopics := 8
   948   (288)      BYTES ARRAY    : topicRoom(1:8, 1:16)
   949   (289)      INTEGER ARRAY  : topicRoomLen(1:8)
   950   (290)  
   951   (291)      % 64 characters. The whole message must fit outBuf's 250-byte text field
   952   (292)      % alongside the room name, and a topic is a headline, not an essay.
   953   (293)      INTEGER        : maxTopicLen := 64
   954   (294)      BYTES ARRAY    : topicText(1:8, 1:64)
   955   (295)      INTEGER ARRAY  : topicTextLen(1:8)
   956   (296)  
   957   (297)      % Is there anything to reap? Kept so the common case - nothing died - costs
   958   (298)      % one compare per message instead of a walk of the whole room.
   959   (299)      INTEGER        : deadFound := 0
   960   (300)  
   961   (301)      % ----- knowing when to give up ------------------------------------------
   962   (302)      % How many receives in a ROW have failed. Cleared by any good one, so this
   963   (303)      % counts a run of trouble rather than trouble over a lifetime.
   964   (304)      INTEGER        : badRuns := 0
   965   (305)  
   966   (306)      % Twenty in a row is not a bad moment, it is a broken machine. Small enough
   967   (307)      % that a spin is caught in under a second, large enough that a burst of
   968   (308)      % something transient is ridden out rather than treated as fatal.
   969   (309)      INTEGER        : maxBadRuns := 20
   970   (310)  
   971   (311)      % Print at most this many of them. The fault that made all this necessary
   972   (312)      % was ONE message repeated as fast as the terminal could take it, and a
   973   (313)      % diagnostic with no limit buries the line that says what happened.
   974   (314)      INTEGER        : maxNoisy := 5
   975   (315)  
   976   (316)      INTEGER ARRAY : stack(0:1000)
   977   (317)  
   978   (318)      % SIZE OF inBuf, named because the read must clamp against it. XMSG reports
   979   (319)      % the SENDER'S message size; nothing stops that being larger than this
   980   (320)      % array, and PLANC checks no bound.
   981   (321)      INTEGER : inBufSize := 256
   982   (322)      BYTES : inBuf(0:255)
   983   (323)      BYTES : outBuf(0:255)
   984   (324)  
   985   (325)      % ONE SPACE, AS A BYTE. buildWho puts a separator between names, and
   986   (326)      % "' ' =: outBuf(at)" does not compile: 'x' is a STRING and an element of a
   987   (327)      % BYTES array is a BYTE. Held as a one-element BYTES so the copy is
   988   (328)      % byte-to-byte.
   989   (329)      BYTES : spaceByte := ' '
   990   (330)  
   991   (331)      % Same trick, for the room counts /list writes - "LOBBY(2)". Brackets are
   992   (332)      % held as one-element BYTES for exactly the reason spaceByte is.
   993   (333)      BYTES : openParen  := '('
   994   (334)      BYTES : closeParen := ')'
   995   (335)  
   996   (336)      % '0' as a NUMBER, because a digit is computed rather than copied: the
   997   (337)      % count is arithmetic, so the character is digitZero + the value. Held as
   998   (338)      % an INTEGER and not a BYTES for that reason - it is added to, not copied.
   999   (339)      INTEGER : digitZero := 48
  1000   (340)  
  1001   (341)      % Same reason as spaceByte: a string literal cannot be stored into a BYTES
  1002   (342)      % element, so every literal character this program writes into a buffer
  1003   (343)      % lives in a one-element BYTES and is copied byte to byte.
  1004   (344)      % A LOCAL CANNOT CARRY AN INITIALISER. "BYTES : oneByte := ' '" inside
  1005   (345)      % showName drew *** ERROR - INITIAL VALUE ILLEGAL HERE, while the identical
  1006   (346)      % line at MODULE level compiles - which is why the same declaration works in
  1007   (347)      % CHATMON and failed here. Module level it is, beside the others.
  1008   (348)      BYTES : oneByte   := ' '
  1009   (349)      BYTES : slashByte := '/'
  1010   (350)      BYTES : zeroByte  := '0'
  1011   (351)  
  1012   (352)      % The fixed part of the status line. Held as bytes for the same reason.
  1013   (353)      BYTES : statusWord := 'SEATS '
  1014   (354)  
  1015   (355)      INTEGER  : myPort
  1016   (356)      INTEGER  : msgType
  1017   (357)  
  1018   (358)      % ---- THE COMMAND PORT, AND WHY THE LOOP HAD TO CHANGE ------------------
  1019   (359)      %
  1020   (360)      % XFRCV RECEIVES ON ONE NAMED PORT. There is no receive-on-any-port form -
  1021   (361)      % ND-60.134.2 section 4.3.2.10. This program used to block on myPort with
  1022   (362)      % XFWTF, and a server that keeps doing that NEVER SEES a message on a
  1023   (363)      % second port. Not failing, not logging: sitting in the lobby wait while
  1024   (364)      % CHATMON waits for an answer that cannot come.
  1025   (365)      %
  1026   (366)      % The manual's answer is XFWAK: a non-blocking receive arms a wake-up
  1027   (367)      % instead, and "this 'wake up' option can be enabled on more than one port
  1028   (368)      % at a time". MON 100B is StartRTProgram, so that wake-up RT-STARTS this
  1029   (369)      % program - which means there is no wait to choose at all. Drain both
  1030   (370)      % ports, and when both are empty, TERMINATE. A transmission to either one
  1031   (371)      % starts us again.
  1032   (372)      %
  1033   (373)      % AND THE TRAP FROM THE SAME PARAGRAPH: "when the 'wake up' is done, the
  1034   (374)      % message is not received, and so the receive must be repeated." The
  1035   (375)      % wake-up is a DOORBELL, NOT A DELIVERY.
  1036   (376)      INTEGER  : adminPort
  1037   (377)  
  1038   (378)      % CHAT-ADMIN is a NORMAL named port (XMPOPNM), NOT a connection port.
  1039   (379)      % CHAT-LOBBY is a connection port and every arrival there spends one of the
  1040   (380)      % free connections - a seat a human then cannot have. An operator asking
  1041   (381)      % for STATUS must not cost the room a seat, and must still get in when the
  1042   (382)      % room is full, which is exactly when they would want to ask.
  1043   (383)      BYTES    : admName := 'CHAT-ADMIN'
  1044   (384)      INTEGER  : lenAdmName := 10
  1045   (385)  
  1046   (386)      % TRUE once the ports are open. MODULE data lives in the RT segment and
  1047   (387)      % SURVIVES the terminate above - the member table, the port numbers and the
  1048   (388)      % magic are all still here on the next start. INISTACK is not: it runs
  1049   (389)      % every time. So the opening work must happen ONCE, or the second start
  1050   (390)      % tries to re-open a name this program already holds and fails.
  1051   (391)      BOOLEAN  : portsOpen := FALSE
  1052   (392)  
  1053   (393)      % Which port the message being handled arrived on. Admin kinds are refused
  1054   (394)      % on the lobby and room kinds on the command port - sharing one vocabulary
  1055   (395)      % is not sharing the authority to use any of it anywhere.
  1056   (396)      BOOLEAN  : fromAdmin := FALSE
  1057   (397)  
  1058   (398)      % For the idle sleep - see the empty-drain branch of the main loop.
  1059   (399)      % sleepWhy comes back 0 when the time simply elapsed, 1 when a break
  1060   (400)      % restarted us. Neither changes what this loop does next, but the call
  1061   (401)      % needs somewhere to put it.
  1062   (402)      INTEGER  : sleepUnits
  1063   (403)      INTEGER  : sleepKind
  1064   (404)      INTEGER  : sleepWhy
  1065   (405)  
  1066   (406)      % XMROU, "routed message (via XROUT)", is what msgType carries when a letter
  1067   (407)      % arrives. It is the ONLY thing that says a SEAT was spent: XROUT takes one
  1068   (408)      % free connection to forward a letter, before this program has seen a byte
  1069   (409)      % of it.
  1070   (410)      %
  1071   (411)      % SETTLED FROM ND'S OWN SAMPLE SERVERS, both of them, in the COSMOS
  1072   (412)      % Programmer Guide (ND-60.164.3) appendix of sample programs. Each waits for
  1073   (413)      % the forwarded letter and then refuses anything else:
  1074   (414)      %
  1075   (415)      %   PLANC     IF MSGTYPE >< XMROU THEN
  1076   (416)      %                 OUTPUT(1, 'A', 'WRONG MESSAGE TYPE ')
  1077   (417)      %
  1078   (418)      %   FORTRAN   IF (MSGTYPE .NE. XMROU) THEN
  1079   (419)      %                 WRITE(1,*)'WRONG MESSAGE TYPE'
  1080   (420)      %
  1081   (421)      % Both then read the CLIENT's magic number out of the arrived message to
  1082   (422)      % answer it directly - which is the other half of the same fact, and the
  1083   (423)      % reason the sender field is the client rather than XROUT.
  1084   (424)      %
  1085   (425)      % The name is used bare here, not declared as a literal, because the PLANC
  1086   (426)      % sample uses it bare under the same two includes this file has.
  1087   (427)  
  1088   (428)      % Was the sender in the room BEFORE this message was handled? The seat
  1089   (429)      % accounting below needs the answer from before, so it is taken early.
  1090   (430)      INTEGER  : wasMember
  1091   (431)      % Is the sender a member AFTER the letter was handled? That single question
  1092   (432)      % decides whether the seat XROUT spent on the arrival goes back.
  1093   (433)      INTEGER  : nowMember
  1094   (434)      % Byte 1 of a routed arrival, kept BEFORE the payload is shifted down. 65
  1095   (435)      % (XSLET) means a client sent it and a seat was spent; anything else is
  1096   (436)      % XROUT answering one of our own calls, which spent nothing.
  1097   (437)      INTEGER  : letterService
  1098   (438)  
  1099   (439)      % XSLET (65) IS NOT DECLARED HERE. It is already a CONSTANT in XMP-B02:DEFS
  1100   (440)      % - "CONSTANT XSLET=65  % Send a letter" - and declaring our own would be a
  1101   (441)      % redeclaration, which in this compiler is not a warning: it drew
  1102   (442)      % IDENTIFIER ALREADY SPECIFIED and then ASSERT VIOLATION AT 136747B and took
  1103   (443)      % the whole batch job with it. Checked against the listing before writing
  1104   (444)      % this, not assumed.
  1105   (445)      INTEGER  : remotePortHash
  1106   (446)      INTEGER  : nBytes
  1107   (447)      % What XMPFRCV put in nBytes, kept before XMPFMST overwrites it. It is the
  1108   (448)      % message length normally and the REASON FOR RETURN on an XMTRE.
  1109   (449)      INTEGER  : receiveStat
  1110   (450)      INTEGER  : readLength
  1111   (451)      INTEGER  : readAmount
  1112   (452)      % An INTEGER dumpAmount clamped the 48-byte arrival dump. Both are gone;
  1113   (453)      % see the note in the receive loop for what that dump found.
  1114   (454)      % Where the chat message starts inside a letter that came via XROUT - that
  1115   (455)      % is, the first byte after the XSLET header. Derived from the header's own
  1116   (456)      % length word on every arrival, never assumed.
  1117   (457)      INTEGER  : payloadAt
  1118   (458)      INTEGER  : writtenLength
  1119   (459)      INTEGER  : returnStatus
  1120   (460)      INTEGER4 : senderMagic
  1121   (461)  
  1122   (462)      % OUR OWN port's magic number, read once with XMPFP2M after the port opens.
  1123   (463)      % Kept only so an arrival can be tested against it, because the thing that
  1124   (464)      % actually happened - our own answer arriving back at this very port - is not
  1125   (465)      % something any amount of reading the guide would have suggested, and without
  1126   (466)      % this comparison it cannot be told apart from a real peer's message.
  1127   (467)      INTEGER4 : myMagic := 0
  1128   (468)      BOOLEAN  : uniqueName := TRUE
  1129   (469)  
  1130   (470)      % -----------------------------------------------------------------------
  1131   (471)      % THE LOG. An RT program has no terminal, so every OUTPUT(1, ...) in this
  1132   (472)      % file goes NOWHERE once CHATSER is started with @RT.
  1133   (473)      %
  1134   (474)      % That is not a tidiness problem, it is why a whole afternoon was spent
  1135   (475)      % guessing on 2026-08-20. Two clients sat in one room and neither heard
  1136   (476)      % the other; the one line that would have said why - "SV: snd failed st="
  1137   (477)      % from sendTo - was printed to a device that is not there. The fault was
  1138   (478)      % looked for in the room table, the wire, the seat counter and the build,
  1139   (479)      % in that order, because the program's own account of itself was thrown
  1140   (480)      % away.
  1141   (481)      %
  1142   (482)      % SO EVERY DIAGNOSTIC GOES TO A FILE AS WELL AS THE TERMINAL. Run as
  1143   (483)      % @CHATSV you see it on screen AND in the file; run as @RT CHATSER the
  1144   (484)      % screen half goes nowhere and the file is all there is.
  1145   (485)      %
  1146   (486)      % OPEN, WRITE, CLOSE PER LINE - and that is deliberate, not laziness.
  1147   (487)      % A crash leaves an open file's block buffer unwritten, so anything still
  1148   (488)      % in it is lost - which is exactly the moment the log has to survive. One
  1149   (489)      % line per open costs a file system round trip, and these lines are only
  1150   (490)      % written on errors and at startup, so the cost is paid when something is
  1151   (491)      % already wrong.
  1152   (492)      %
  1153   (493)      % ACCESS 5 IS SEQUENTIAL WRITE APPEND, from the OpenFile table in
  1154   (494)      % ND-860228-2-EN. Access 0 would truncate at CLOSE and each line would
  1155   (495)      % erase the one before it - and it truncates at CLOSE rather than at OPEN,
  1156   (496)      % which is the trap CHAT.PLNC already carries a note about.
  1157   (497)      %
  1158   (498)      % AN RT PROGRAM'S DEFAULT USER IS RT, NOT SYSTEM. The file is named
  1159   (499)      % without a user, so it resolves against RT first and then SYSTEM. If it
  1160   (500)      % is never created, logging simply does nothing - see logBroken.
  1161   (501)      % -----------------------------------------------------------------------
  1162   (502)      % CHATLG2, NOT CHATLOG, AND THE REASON MATTERS. The first log this server
  1163   (503)      % ever wrote went out as plain 7-bit ASCII, before logPut existed. Access 5
  1164   (504)      % APPENDS, so the parity-correct lines written afterwards landed BEHIND 107
  1165   (505)      % bytes SINTRAN's own utilities refuse to read, and LIST-FILE stopped at the
  1166   (506)      % first of them without a word - the whole file reads as empty. The file
  1167   (507)      % belongs to user RT and SYSTEM has no directory access to delete it, so the
  1168   (508)      % only way out is a name that has never been written the wrong way.
  1169   (509)      % Measured on D100, 2026-08-20.
  1170   (510)      BYTES   : logName := 'CHATLG2'
  1171   (511)      BYTES   : logType := 'SYMB'
  1172   (512)  
  1173   (513)      % Sequential write APPEND. See above - 0 would truncate.
  1174   (514)      INTEGER : logAppend := 5
  1175   (515)  
  1176   (516)      % Set once the log has failed, and never cleared. A server that cannot
  1177   (517)      % write its log must not spend a file system call per diagnostic finding
  1178   (518)      % that out again, and must certainly not fail because of it.
  1179   (519)      BOOLEAN : logBroken := FALSE
  1180   (520)  
  1181   (521)      % Digits, LEAST significant first as they are produced, written out in
  1182   (522)      % reverse. Ten is enough for any 16-bit value with room to spare.
  1183   (523)      BYTES   : logDigits(0:9)
  1184   (524)  
  1185   (525)      % Single characters the log writes, as NUMBERS. A carriage return has no
  1186   (526)      % spelling inside a PLANC string literal, and CHAT.PLNC already carries
  1187   (527)      % its carriageRet the same way, so all three are written alike rather
  1188   (528)      % than two one way and one the other.
  1189   (529)      INTEGER : logMinus := 45
  1190   (530)      INTEGER : logCr    := 13
  1191   (531)      INTEGER : logLf    := 10
  1192   (532)  
  1193   (533)      % The full filespec, for the create. CreateFile takes the WHOLE thing in
  1194   (534)      % one 64-byte buffer, unlike MON50 which takes name and type separately.
  1195   (535)      BYTES   : logFull     := 'CHATLG2:SYMB'
  1196   (536)      INTEGER : lenLogFull  := 12
  1197   (537)      INTEGER : nameBufSize := 64
  1198   (538)      BYTES   : nameBuf(0:63)
  1199   (539)      BYTES   : blankByte   := ' '
  1200   (540)      INTEGER4 : startAddr  := 0
  1201   (541)      INTEGER4 : noOfPages  := 0
  1202   (542)  
  1203   (543)      % -----------------------------------------------------------------------
  1204   (544)      % Ask SINTRAN to create CHATLOG:SYMB.
  1205   (545)      %
  1206   (546)      % MON50 CANNOT CREATE A FILE - measured in CHAT.PLNC, where quoting the
  1207   (547)      % name did nothing at all. CreateFile is 221B and it is a separate call.
  1208   (548)      % It has no MONn routine, which is why it goes through MONITOR_CALL; that
  1209   (549)      % works here because MON-CALL-1B-A00 supplies 5MON_P, and this program
  1210   (550)      % already relies on it for TimeOut.
  1211   (551)      %
  1212   (552)      % The buffer is filled with SPACES first and the filespec copied over the
  1213   (553)      % front, so whatever was in the rest is never read as part of the name.
  1214   (554)      % Both size parameters are zero: an ordinary indexed file that grows as
  1215   (555)      % it is written, which is what a log wants.
  1216   (556)      % -----------------------------------------------------------------------
  1217   (557)      ROUTINE VOID, VOID : makeLog
  1218   (558)          INTEGER : i
  1219   (559)          FOR i IN 1:nameBufSize DO
  1220   (560)              blankByte(0) =: nameBuf(i - 1)
  1221   (561)          ENDFOR
  1222   (562)          FOR i IN 1:lenLogFull DO
  1223   (563)              logFull(i - 1) =: nameBuf(i - 1)
  1224   (564)          ENDFOR
  1225   (565)          MONITOR_CALL(221B, nameBuf, startAddr, noOfPages)
  1226   (566)      ENDROUTINE
  1227   (567)  
  1228   (568)      % -----------------------------------------------------------------------
  1229   (569)      % Open the log for append, creating it the first time.
  1230   (570)      %
  1231   (571)      % Returns the device number, or 0 when the log is not usable. THE CALLER
  1232   (572)      % MUST TEST THE BOOLEAN, not the number - a failed MON50 leaves 46 in it,
  1233   (573)      % SINTRAN's "no such file", which is the defect CHAT.PLNC records at
  1234   (574)      % length. This routine turns that into a plain 0 so no caller can repeat
  1235   (575)      % it.
  1236   (576)      %
  1237   (577)      % THE FLAG IS CLEARED AFTER THE ON BLOCK, NOT BEFORE. Measured in
  1238   (578)      % CHAT.PLNC on 2026-08-19: cleared before, the handler body had already
  1239   (579)      % run and every open reported failure while returning a good device.
  1240   (580)      % -----------------------------------------------------------------------
  1241   (581)      ROUTINE VOID, INTEGER : logOpen
  1242   (582)          INTEGER : dev
  1243   (583)          BOOLEAN : openFailed
  1244   (584)  
  1245   (585)          IF logBroken THEN
  1246   (586)              0 RETURN
  1247   (587)          ENDIF
  1248   (588)  
  1249   (589)          0 =: dev
  1250   (590)          ON ROUTINEERROR DO
  1251   (591)              TRUE =: openFailed
  1252   (592)          ENDON
  1253   (593)          FALSE =: openFailed
  1254   (594)  
  1255   (595)          MON50(logName, logType, logAppend) =: dev
  1256   (596)  
  1257   (597)          IF openFailed THEN
  1258   (598)              % Not there yet. Make it and open it for real. A create that
  1259   (599)              % fails needs no message of its own - the second open fails too
  1260   (600)              % and that is what sets logBroken.
  1261   (601)              ON ROUTINEERROR DO
  1262   (602)              ENDON
  1263   (603)              makeLog
  1264   (604)  
  1265   (605)              ON ROUTINEERROR DO
  1266   (606)                  TRUE =: openFailed
  1267   (607)              ENDON
  1268   (608)              FALSE =: openFailed
  1269   (609)              MON50(logName, logType, logAppend) =: dev
  1270   (610)          ENDIF
  1271   (611)  
  1272   (612)          IF openFailed THEN
  1273   (613)              TRUE =: logBroken
  1274   (614)              0 RETURN
  1275   (615)          ENDIF
  1276   (616)  
  1277   (617)          dev RETURN
  1278   (618)      ENDROUTINE
  1279   (619)  
  1280   (620)      % -----------------------------------------------------------------------
  1281   (621)      % Write one line: a tag, a number, and an end of line.
  1282   (622)      %
  1283   (623)      % The tag is passed as a slice of a BYTES with its length, the same shape
  1284   (624)      % every other routine here uses, because PLANC's OUTPUT needs the width in
  1285   (625)      % the format string and a routine cannot have a literal one.
  1286   (626)      %
  1287   (627)      % NOTHING HERE IS ALLOWED TO KILL THE SERVER. Every failure sets the flag
  1288   (628)      % and returns. A logger that can take down the thing it is watching is
  1289   (629)      % worse than no logger.
  1290   (630)      % -----------------------------------------------------------------------
  1291   (631)      % -----------------------------------------------------------------------
  1292   (632)      % Write one byte to the log. PLAIN 7-BIT ASCII, and the parity version of
  1293   (633)      % this routine has been TAKEN OUT.
  1294   (634)      %
  1295   (635)      % IT USED TO SET EVEN PARITY IN BIT 7, on a conclusion that was WRONG. The
  1296   (636)      % reasoning was: the log filled up correctly - 107 bytes, five opens, every
  1297   (637)      % size right - and then
  1298   (638)      %
  1299   (639)      %   @LIST-FILE SVLOG:SYMB,,     printed the header and NOTHING ELSE
  1300   (640)      %   @QED  R SVLOG:SYMB          PARITY ERROR AT LINE 1, thirteen times
  1301   (641)      %
  1302   (642)      % which reads as "the bytes are there and the tools refuse them", so the
  1303   (643)      % bytes must be at fault.
  1304   (644)      %
  1305   (645)      % THE CONTROL RUN THAT WAS NEVER DONE. The same two commands against
  1306   (646)      % CHATSV:MODE - the build file @MODE compiles this whole server from, which
  1307   (647)      % is unquestionably good - answer EXACTLY THE SAME WAY: LIST-FILE prints the
  1308   (648)      % header and nothing else, QED cries PARITY ERROR thirteen times. Both tools
  1309   (649)      % do this to every file our FA push puts on the machine. They were never
  1310   (650)      % evidence about the log at all.
  1311   (651)      %
  1312   (652)      % And the parity code did not even do what it claimed: measured on the wire,
  1313   (653)      % EVERY byte came back with bit 7 set - S as 0xD3, T as 0xD4, space as 0xA0,
  1314   (654)      % CR as 0x8D - so the "is the count odd" test was true every time. It was
  1315   (655)      % wrong code justifying itself with a wrong measurement.
  1316   (656)      %
  1317   (657)      % TO READ THIS LOG, PULL IT OFF THE MACHINE AND LOOK AT THE BYTES:
  1318   (658)      %
  1319   (659)      %   @COPY-FILE "SVLOG2:SYMB",(RT)CHATLG2:SYMB     (RT owns it; SYSTEM cannot
  1320   (660)      %                                                  delete or chmod it)
  1321   (661)      %   Xmsg.Live.Runner --config topology-d19999-hdlc-server.json \
  1322   (662)      %       --pull 'SVLOG2:SYMB' --pull-from 100 --pull-to svlog2.raw \
  1323   (663)      %       --originate-from-seed
  1324   (664)      %
  1325   (665)      % That works, and it is how the broadcast question was finally answered.
  1326   (666)      % -----------------------------------------------------------------------
  1327   (667)      ROUTINE VOID, VOID (INTEGER, INTEGER) : logPut(dev, value)
  1328   (668)          BYTE : b
  1329   (669)  
  1330   (670)          % Masked to seven bits so a stray high bit in a caller's value cannot
  1331   (671)          % put a character in the file that nothing will render.
  1332   (672)          value AND 127 =: b
  1333   (673)          b MON2(dev)
  1334   (674)      ENDROUTINE
  1335   (675)  
  1336   (676)      ROUTINE VOID, VOID (BYTES, INTEGER, INTEGER) : logLine(tag, tagLen, value)
  1337   (677)          INTEGER : dev, i, left, rest, digit, digitCount
  1338   (678)          BYTE    : b
  1339   (679)          BOOLEAN : writeFailed
  1340   (680)  
  1341   (681)          logOpen =: dev
  1342   (682)          IF dev = 0 THEN
  1343   (683)              RETURN
  1344   (684)          ENDIF
  1345   (685)  
  1346   (686)          % ONE FLAG FOR THE WHOLE LINE, not a message per byte. CHAT.PLNC
  1347   (687)          % learned that the hard way: a handler round a write loop that prints
  1348   (688)          % inside it says the same thing once per character.
  1349   (689)          ON ROUTINEERROR DO
  1350   (690)              TRUE =: writeFailed
  1351   (691)          ENDON
  1352   (692)          FALSE =: writeFailed
  1353   (693)  
  1354   (694)          FOR i IN 1:tagLen DO
  1355   (695)              tag(i - 1) =: b
  1356   (696)              logPut(dev, b)
  1357   (697)          ENDFOR
  1358   (698)  
  1359   (699)          % The number, most significant digit first. Built backwards into
  1360   (700)          % logDigits and then written forwards, because dividing gives the
  1361   (701)          % LAST digit first and a log line read by a person wants them the
  1362   (702)          % other way round.
  1363   (703)          %
  1364   (704)          % Negative values are printed with a minus and then their magnitude.
  1365   (705)          % A status word can be negative on this wire and "-34" is readable
  1366   (706)          % where the unsigned form is not.
  1367   (707)          value =: left
  1368   (708)          IF left < 0 THEN
  1369   (709)              logPut(dev, logMinus)
  1370   (710)              0 - left =: left
  1371   (711)          ENDIF
  1372   (712)  
  1373   (713)          % NO "MOD" - it appears nowhere in this file and is not going to be
  1374   (714)          % introduced on a guess. putNumber above gets its digits by dividing
  1375   (715)          % and subtracting, so this does the same.
  1376   (716)          0 =: digitCount
  1377   (717)          % A do-while shape, so zero prints as "0" rather than as nothing.
  1378   (718)          DO
  1379   (719)              left / 10 =: rest
  1380   (720)              left - rest * 10 =: digit
  1381   (721)              zeroByte(0) + digit =: logDigits(digitCount)
  1382   (722)              digitCount + 1 =: digitCount
  1383   (723)              rest =: left
  1384   (724)              WHILE left > 0
  1385   (725)          ENDDO
  1386   (726)  
  1387   (727)          FOR i IN 1:digitCount DO
  1388   (728)              logDigits(digitCount - i) =: b
  1389   (729)              logPut(dev, b)
  1390   (730)          ENDFOR
  1391   (731)  
  1392   (732)          % THE CARRIAGE RETURN MATTERS - a SINTRAN text file is expected to
  1393   (733)          % have one, and without it every line runs into the next. It carries
  1394   (734)          % parity like every other byte; QED counts it as part of the line.
  1395   (735)          logPut(dev, logCr)
  1396   (736)          logPut(dev, logLf)
  1397   (737)  
  1398   (738)          % CLOSE, ALWAYS, including after a failed write - see the note on the
  1399   (739)          % open. An unclosed file keeps its old contents.
  1400   (740)          MON43(dev)
  1401   (741)  
  1402   (742)          IF writeFailed THEN
  1403   (743)              TRUE =: logBroken
  1404   (744)          ENDIF
  1405   (745)      ENDROUTINE
  1406   (746)  
  1407   (747)      % -----------------------------------------------------------------------
  1408   (748)      % Compare a name in the room against one in a buffer, ignoring case.
  1409   (749)      %
  1410   (750)      % ChatRoom.cs compares ignoring case, so this does too - the two doors into
  1411   (751)      % one room must not disagree about whether ANNA and anna are the same
  1412   (752)      % person.
  1413   (753)      % -----------------------------------------------------------------------
  1414   (754)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : sameName(slot, at, length)
  1415   (755)          INTEGER : j, a, b
  1416   (756)          IF memberLen(slot) >< length THEN
  1417   (757)              0 RETURN
  1418   (758)          ENDIF
  1419   (759)          FOR j IN 1:length DO
  1420   (760)              memberName(slot, j) =: a
  1421   (761)              inBuf(at + j - 1) =: b
  1422   (762)              IF a > 96 THEN a - 32 =: a ENDIF        % fold lower case to upper
  1423   (763)              IF b > 96 THEN b - 32 =: b ENDIF
  1424   (764)              IF a >< b THEN
  1425   (765)                  0 RETURN
  1426   (766)              ENDIF
  1427   (767)          ENDFOR
  1428   (768)          1 RETURN
  1429   (769)      ENDROUTINE
  1430   (770)  
  1431   (771)      ROUTINE VOID, INTEGER (INTEGER4) : findByMagic(magic)
  1432   (772)          INTEGER : i
  1433   (773)          FOR i IN 1:maxSeats DO
  1434   (774)              IF memberUsed(i) >< 0 THEN
  1435   (775)                  IF memberMagic(i) = magic THEN
  1436   (776)                      i RETURN
  1437   (777)                  ENDIF
  1438   (778)              ENDIF
  1439   (779)          ENDFOR
  1440   (780)          0 RETURN
  1441   (781)      ENDROUTINE
  1442   (782)  
  1443   (783)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : findByName(at, length)
  1444   (784)          INTEGER : i
  1445   (785)          FOR i IN 1:maxSeats DO
  1446   (786)              IF memberUsed(i) >< 0 THEN
  1447   (787)                  IF sameName(i, at, length) = 1 THEN
  1448   (788)                      i RETURN
  1449   (789)                  ENDIF
  1450   (790)              ENDIF
  1451   (791)          ENDFOR
  1452   (792)          0 RETURN
  1453   (793)      ENDROUTINE
  1454   (794)  
  1455   (795)      ROUTINE VOID, INTEGER : freeSlot
  1456   (796)          INTEGER : i
  1457   (797)          FOR i IN 1:maxSeats DO
  1458   (798)              IF memberUsed(i) = 0 THEN
  1459   (799)                  i RETURN
  1460   (800)              ENDIF
  1461   (801)          ENDFOR
  1462   (802)          0 RETURN
  1463   (803)      ENDROUTINE
  1464   (804)  
  1465   (805)      % -----------------------------------------------------------------------
  1466   (806)      % Build a message into outBuf. Returns its total length.
  1467   (807)      % -----------------------------------------------------------------------
  1468   (808)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER, INTEGER) : &
  1469   (809)              buildMessage(kind, nameAt, nameLength, textAt, textLength)
  1470   (810)          INTEGER : i, at
  1471   (811)          kind =: outBuf(0)
  1472   (812)          nameLength =: outBuf(1)
  1473   (813)          2 =: at
  1474   (814)          FOR i IN 1:nameLength DO
  1475   (815)              inBuf(nameAt + i - 1) =: outBuf(at)
  1476   (816)              at + 1 =: at
  1477   (817)          ENDFOR
  1478   (818)          0 =: outBuf(at)                       % text length, high byte
  1479   (819)          textLength =: outBuf(at + 1)          % text length, low byte
  1480   (820)          at + 2 =: at
  1481   (821)          FOR i IN 1:textLength DO
  1482   (822)              inBuf(textAt + i - 1) =: outBuf(at)
  1483   (823)              at + 1 =: at
  1484   (824)          ENDFOR
  1485   (825)          at RETURN
  1486   (826)      ENDROUTINE
  1487   (827)  
  1488   (828)      % -----------------------------------------------------------------------
  1489   (829)      % Print a name that arrived in inBuf, one byte at a time.
  1490   (830)      %
  1491   (831)      % Byte by byte because 'ALn' formats a STRING: handing it a single byte
  1492   (832)      % prints the byte's NUMBER, not the character. A one-element BYTES is the
  1493   (833)      % way across, the same trick the space separator in buildWho uses.
  1494   (834)      % -----------------------------------------------------------------------
  1495   (835)      % -----------------------------------------------------------------------
  1496   (836)      % Write a small number into outBuf as decimal digits, advancing at.
  1497   (837)      %
  1498   (838)      % By hand because there is no formatter that writes into a BYTES array -
  1499   (839)      % OUTPUT goes to a device, not a buffer. Handles 0..999, which covers a
  1500   (840)      % seat count and every counter this status line is likely to grow.
  1501   (841)      % -----------------------------------------------------------------------
  1502   (842)      ROUTINE VOID, INTEGER (INTEGER, INTEGER) : putNumber(value, at)
  1503   (843)          INTEGER : left, digit, p
  1504   (844)          BOOLEAN : started
  1505   (845)  
  1506   (846)          % RETURNS THE NEW CURSOR rather than writing through an INTEGER WRITE
  1507   (847)          % parameter. The WRITE form was assumed to advance the CALLER's variable
  1508   (848)          % and did not: the status line came out "SEATS 016" instead of
  1509   (849)          % "SEATS 0/16" - the separator was written where the previous digit had
  1510   (850)          % gone, and the length came out short. MEASURED on D100 2026-08-20.
  1511   (851)          %
  1512   (852)          % Returning the cursor is the idiom buildMessage and buildWho already
  1513   (853)          % use in this file ("at RETURN"), and it cannot be got wrong by the
  1514   (854)          % caller in the same silent way.
  1515   (855)          at =: p
  1516   (856)          value =: left
  1517   (857)          FALSE =: started
  1518   (858)  
  1519   (859)          % Hundreds and tens are skipped until a non-zero one appears, so 7
  1520   (860)          % prints as "7" and not "007". Zero itself still has to print, which
  1521   (861)          % the final digit below always does.
  1522   (862)          left / 100 =: digit
  1523   (863)          IF digit > 0 THEN
  1524   (864)              zeroByte(0) + digit =: outBuf(p)
  1525   (865)              p + 1 =: p
  1526   (866)              TRUE =: started
  1527   (867)              left - digit * 100 =: left
  1528   (868)          ENDIF
  1529   (869)  
  1530   (870)          left / 10 =: digit
  1531   (871)          IF digit > 0 OR started THEN
  1532   (872)              zeroByte(0) + digit =: outBuf(p)
  1533   (873)              p + 1 =: p
  1534   (874)              left - digit * 10 =: left
  1535   (875)          ENDIF
  1536   (876)  
  1537   (877)          zeroByte(0) + left =: outBuf(p)
  1538   (878)          p + 1 =: p
  1539   (879)          p RETURN
  1540   (880)      ENDROUTINE
  1541   (881)  
  1542   (882)      ROUTINE VOID, VOID (INTEGER, INTEGER) : showName(nameAt, nameLength)
  1543   (883)          INTEGER : i
  1544   (884)          FOR i IN 1:nameLength DO
  1545   (885)              inBuf(nameAt + i - 1) =: oneByte
  1546   (886)              OUTPUT(1, 'AL1', oneByte)
  1547   (887)          ENDFOR
  1548   (888)      ENDROUTINE
  1549   (889)  
  1550   (890)      % -----------------------------------------------------------------------
  1551   (891)      % Build the answer to an AdminStatus: how the room stands, as readable
  1552   (892)      % text.
  1553   (893)      %
  1554   (894)      % TEXT, NOT A STRUCT OF COUNTERS, and that is a decision rather than
  1555   (895)      % laziness. What is worth reporting grows with every phase of federation -
  1556   (896)      % peers, trunk states, hop counts - and a text answer lets it grow without
  1557   (897)      % changing the wire and re-pinning the golden bytes each time.
  1558   (898)      %
  1559   (899)      % The name field is EMPTY: the server is answering, not a member.
  1560   (900)      % -----------------------------------------------------------------------
  1561   (901)      ROUTINE VOID, INTEGER : buildStatus
  1562   (902)          INTEGER : i, j, at, seated, textAt, textLen
  1563   (903)  
  1564   (904)          0 =: seated
  1565   (905)          FOR i IN 1:maxSeats DO
  1566   (906)              IF memberUsed(i) = 1 THEN
  1567   (907)                  seated + 1 =: seated
  1568   (908)              ENDIF
  1569   (909)          ENDFOR
  1570   (910)  
  1571   (911)          kAdmRepl =: outBuf(0)
  1572   (912)          0 =: outBuf(1)                        % no name: the SERVER is answering
  1573   (913)          2 =: at
  1574   (914)          0 =: outBuf(at)                       % text length, high byte
  1575   (915)          0 =: outBuf(at + 1)                   % text length, low byte, filled below
  1576   (916)          at + 2 =: textAt
  1577   (917)          textAt =: at
  1578   (918)  
  1579   (919)          % "SEATS n/m" - taken and offered. Two numbers, because "3 seats used"
  1580   (920)          % does not say whether the room is full, and full is the case an
  1581   (921)          % operator is asking about.
  1582   (922)          FOR j IN 0:5 DO
  1583   (923)              statusWord(j) =: outBuf(at)
  1584   (924)              at + 1 =: at
  1585   (925)          ENDFOR
  1586   (926)          putNumber(seated, at) =: at
  1587   (927)          slashByte(0) =: outBuf(at)
  1588   (928)          at + 1 =: at
  1589   (929)          putNumber(maxSeats, at) =: at
  1590   (930)  
  1591   (931)          at - textAt =: textLen
  1592   (932)          textLen =: outBuf(3)                  % low byte; it cannot reach 256
  1593   (933)          at RETURN
  1594   (934)      ENDROUTINE
  1595   (935)  
  1596   (936)      % Is this member in the same room as that one?
  1597   (937)      %
  1598   (938)      % Compared byte by byte on the stored name. A room is only "the same room"
  1599   (939)      % if it is spelled the same - there is no room id, because a room is not a
  1600   (940)      % registered thing any more, just a name people agree on.
  1601   (941)      %
  1602   (942)      % DECLARED HERE, ABOVE buildWho, AND THAT POSITION IS LOAD-BEARING. It used
  1603   (943)      % to sit next to broadcast, 250 lines further down; PLANC needs a routine
  1604   (944)      % declared before it is called, so buildWho could not have used it even if
  1605   (945)      % somebody had thought to. Moved up 2026-08-22 when /who was fixed.
  1606   (946)      ROUTINE VOID, BOOLEAN (INTEGER, INTEGER) : sameRoom(slotA, slotB)
  1607   (947)          INTEGER : i
  1608   (948)          IF mbrRoomLen(slotA) >< mbrRoomLen(slotB) THEN
  1609   (949)              FALSE RETURN
  1610   (950)          ENDIF
  1611   (951)          FOR i IN 1:mbrRoomLen(slotA) DO
  1612   (952)              IF mbrRoom(slotA, i) >< mbrRoom(slotB, i) THEN
  1613   (953)                  FALSE RETURN
  1614   (954)              ENDIF
  1615   (955)          ENDFOR
  1616   (956)          TRUE RETURN
  1617   (957)      ENDROUTINE
  1618   (958)  
  1619   (959)      % -----------------------------------------------------------------------
  1620   (960)      % Which topic entry belongs to this member's room? 0 if the room has never
  1621   (961)      % had a topic set.
  1622   (962)      %
  1623   (963)      % Compared the same way sameRoom compares: byte for byte on the spelling.
  1624   (964)      % A room IS its name here, so LOBBY and lobby are two rooms, and the topic
  1625   (965)      % table has to agree with the broadcast about that or a topic would show up
  1626   (966)      % in a room that cannot hear the messages.
  1627   (967)      % -----------------------------------------------------------------------
  1628   (968)      ROUTINE VOID, INTEGER (INTEGER) : findTopic(slot)
  1629   (969)          INTEGER : t, i
  1630   (970)          BOOLEAN : match
  1631   (971)  
  1632   (972)          FOR t IN 1:maxTopics DO
  1633   (973)              IF topicRoomLen(t) = mbrRoomLen(slot) THEN
  1634   (974)                  TRUE =: match
  1635   (975)                  FOR i IN 1:topicRoomLen(t) DO
  1636   (976)                      IF topicRoom(t, i) >< mbrRoom(slot, i) THEN
  1637   (977)                          FALSE =: match
  1638   (978)                      ENDIF
  1639   (979)                  ENDFOR
  1640   (980)                  IF match THEN
  1641   (981)                      t RETURN
  1642   (982)                  ENDIF
  1643   (983)              ENDIF
  1644   (984)          ENDFOR
  1645   (985)          0 RETURN
  1646   (986)      ENDROUTINE
  1647   (987)  
  1648   (988)      % -----------------------------------------------------------------------
  1649   (989)      % Claim a topic entry for this member's room, or 0 if the table is full.
  1650   (990)      %
  1651   (991)      % An unused entry is one with topicRoomLen 0 - a room name is never empty,
  1652   (992)      % so zero cannot collide with a real one.
  1653   (993)      % -----------------------------------------------------------------------
  1654   (994)      ROUTINE VOID, INTEGER (INTEGER) : claimTopic(slot)
  1655   (995)          INTEGER : t, i
  1656   (996)  
  1657   (997)          findTopic(slot) =: t
  1658   (998)          IF t >< 0 THEN
  1659   (999)              t RETURN                          % already has one; reuse it
  1660  (1000)          ENDIF
  1661  (1001)  
  1662  (1002)          FOR t IN 1:maxTopics DO
  1663  (1003)              IF topicRoomLen(t) = 0 THEN
  1664  (1004)                  FOR i IN 1:mbrRoomLen(slot) DO
  1665  (1005)                      mbrRoom(slot, i) =: topicRoom(t, i)
  1666  (1006)                  ENDFOR
  1667  (1007)                  mbrRoomLen(slot) =: topicRoomLen(t)
  1668  (1008)                  0 =: topicTextLen(t)
  1669  (1009)                  t RETURN
  1670  (1010)              ENDIF
  1671  (1011)          ENDFOR
  1672  (1012)          0 RETURN                              % full - the caller must say so
  1673  (1013)      ENDROUTINE
  1674  (1014)  
  1675  (1015)      % -----------------------------------------------------------------------
  1676  (1016)      % Build the answer to /who: every seated member's name, one space between.
  1677  (1017)      %
  1678  (1018)      % The name field is EMPTY - the room is answering, not a member - and the
  1679  (1019)      % names all go in the text. One message, not one per member: a message each
  1680  (1020)      % would multiply the scarcest thing XMSG has by the size of the room. The
  1681  (1021)      % measurement is in DOC/BRINGUP-ORDER-AND-TRAPS-2026-08-18.md: "Data
  1682  (1022)      % transmit blocks" has a limit of TEN and a 20-user burst hits it.
  1683  (1023)      %
  1684  (1024)      % BOUNDED, AND THE BOUND IS NOT DECORATION. outBuf holds 256 bytes and the
  1685  (1025)      % header eats four, so 252 are left; sixteen seats of sixteen characters
  1686  (1026)      % plus separators come to 271. A full room of long names would therefore
  1687  (1027)      % write past the end of outBuf, and PLANC checks no array bound - it would
  1688  (1028)      % simply corrupt whatever the loader put next. Names that do not fit are
  1689  (1029)      % dropped, which is a worse answer than a longer buffer would give and a
  1690  (1030)      % far better one than a corrupted program.
  1691  (1031)      % -----------------------------------------------------------------------
  1692  (1032)      ROUTINE VOID, INTEGER (INTEGER) : buildWho(askerSlot)
  1693  (1033)          INTEGER : i, j, at, textAt, textLen, room
  1694  (1034)  
  1695  (1035)          kWho =: outBuf(0)
  1696  (1036)          0 =: outBuf(1)                        % no name: the ROOM is answering
  1697  (1037)          2 =: at
  1698  (1038)          0 =: outBuf(at)                       % text length, high byte
  1699  (1039)          0 =: outBuf(at + 1)                   % text length, low byte, filled in below
  1700  (1040)          at + 2 =: textAt
  1701  (1041)          textAt =: at
  1702  (1042)          0 =: textLen
  1703  (1043)  
  1704  (1044)          FOR i IN 1:maxSeats DO
  1705  (1045)              % THE ASKER'S ROOM ONLY - and this test was MISSING until
  1706  (1046)              % 2026-08-22, which made /who the one thing on this server that
  1707  (1047)              % crossed a room boundary. Measured on D100: TESTER alone in LOBBY,
  1708  (1048)              % ANNA in GENERAL, and TESTER's /who answered
  1709  (1049)              %     CHAT: in (LOBBY): TESTER ANNA
  1710  (1050)              % The client's "in (LOBBY)" label made the answer not merely too
  1711  (1051)              % long but FALSE - it named a room ANNA was not in. Messages were
  1712  (1052)              % isolated the whole time; only the roster leaked, which is why
  1713  (1053)              % this survived a two-room test that watched what people SAID.
  1714  (1054)              %
  1715  (1055)              % sameRoom is the same compare the broadcast uses. Using it here
  1716  (1056)              % rather than a fresh loop is the point: the roster and the
  1717  (1057)              % broadcast must never disagree about who is in the room.
  1718  (1058)              IF memberUsed(i) = 1 THEN
  1719  (1059)                IF sameRoom(i, askerSlot) THEN
  1720  (1060)                  % What this name needs: a separator if it is not the first,
  1721  (1061)                  % then the name itself.
  1722  (1062)                  memberLen(i) =: room
  1723  (1063)                  IF textLen > 0 THEN
  1724  (1064)                      room + 1 =: room
  1725  (1065)                  ENDIF
  1726  (1066)  
  1727  (1067)                  IF textLen + room <= 250 THEN
  1728  (1068)                      IF textLen > 0 THEN
  1729  (1069)                          % A BYTE FROM A BYTES ARRAY, not a string literal.
  1730  (1070)                          % "' ' =: outBuf(at)" is what stood here and the
  1731  (1071)                          % compiler answered
  1732  (1072)                          %   1082 (422)/BUILDWHO *** ERROR
  1733  (1073)                          %        - ILLEGAL DATA TYPE "OUTBUF"
  1734  (1074)                          % because 'x' is a STRING and outBuf(at) is a BYTE.
  1735  (1075)                          % Copying out of a one-byte BYTES gives the element the
  1736  (1076)                          % type it wants - the same move oneChar uses on the
  1737  (1077)                          % client side for printing.
  1738  (1078)                          spaceByte(0) =: outBuf(at)
  1739  (1079)                          at + 1 =: at
  1740  (1080)                          textLen + 1 =: textLen
  1741  (1081)                      ENDIF
  1742  (1082)                      FOR j IN 1:memberLen(i) DO
  1743  (1083)                          memberName(i, j) =: outBuf(at)
  1744  (1084)                          at + 1 =: at
  1745  (1085)                      ENDFOR
  1746  (1086)                      textLen + memberLen(i) =: textLen
  1747  (1087)                  ENDIF
  1748  (1088)                ENDIF
  1749  (1089)              ENDIF
  1750  (1090)          ENDFOR
  1751  (1091)  
  1752  (1092)          % Now the length is known. It cannot exceed 250, so the high byte the
  1753  (1093)          % format carries stays zero.
  1754  (1094)          textLen =: outBuf(3)
  1755  (1095)          at RETURN
  1756  (1096)      ENDROUTINE
  1757  (1097)  
  1758  (1098)      % -----------------------------------------------------------------------
  1759  (1099)      % Build the answer to /topic: the ROOM NAME in the name field, the topic in
  1760  (1100)      % the text. An empty text means the room has no topic yet - the client says
  1761  (1101)      % so in words rather than showing a blank line.
  1762  (1102)      %
  1763  (1103)      % The room name goes in the NAME field on purpose. It is the one message
  1764  (1104)      % that is about a room rather than about a person, and putting the room
  1765  (1105)      % where a nickname normally sits means the client can label it without
  1766  (1106)      % having to remember which room it asked about - which matters, because a
  1767  (1107)      % /join can land between the question and the answer.
  1768  (1108)      % -----------------------------------------------------------------------
  1769  (1109)      ROUTINE VOID, INTEGER (INTEGER) : buildTopic(slot)
  1770  (1110)          INTEGER : i, at, t, len
  1771  (1111)  
  1772  (1112)          kTopic =: outBuf(0)
  1773  (1113)          mbrRoomLen(slot) =: outBuf(1)
  1774  (1114)          2 =: at
  1775  (1115)          FOR i IN 1:mbrRoomLen(slot) DO
  1776  (1116)              mbrRoom(slot, i) =: outBuf(at)
  1777  (1117)              at + 1 =: at
  1778  (1118)          ENDFOR
  1779  (1119)  
  1780  (1120)          findTopic(slot) =: t
  1781  (1121)          0 =: len
  1782  (1122)          IF t >< 0 THEN
  1783  (1123)              topicTextLen(t) =: len
  1784  (1124)          ENDIF
  1785  (1125)  
  1786  (1126)          0 =: outBuf(at)                       % text length, high byte
  1787  (1127)          len =: outBuf(at + 1)                  % low byte; len <= 64
  1788  (1128)          at + 2 =: at
  1789  (1129)          IF t >< 0 THEN
  1790  (1130)              FOR i IN 1:len DO
  1791  (1131)                  topicText(t, i) =: outBuf(at)
  1792  (1132)                  at + 1 =: at
  1793  (1133)              ENDFOR
  1794  (1134)          ENDIF
  1795  (1135)          at RETURN
  1796  (1136)      ENDROUTINE
  1797  (1137)  
  1798  (1138)      % -----------------------------------------------------------------------
  1799  (1139)      % Build the answer to /list: every room that somebody is sitting in, with
  1800  (1140)      % how many people are in it - "LOBBY(2) GENERAL(1)".
  1801  (1141)      %
  1802  (1142)      % THE ROOM LIST IS DERIVED FROM THE SEATS, NOT KEPT. There is no room
  1803  (1143)      % table to go stale: a room exists exactly as long as somebody is in it,
  1804  (1144)      % which is the same rule the broadcast already follows. A room with a topic
  1805  (1145)      % and nobody in it does NOT appear - it is not a place you can talk to.
  1806  (1146)      %
  1807  (1147)      % The walk is O(seats squared) and that is fine at sixteen: for each seat,
  1808  (1148)      % look back over the earlier seats and skip it if its room has already been
  1809  (1149)      % counted. No temporary room table, so nothing to size wrong.
  1810  (1150)      %
  1811  (1151)      % BOUNDED like buildWho, and for the same reason - see the note there.
  1812  (1152)      % Rooms that do not fit are dropped rather than written past the end.
  1813  (1153)      % -----------------------------------------------------------------------
  1814  (1154)      ROUTINE VOID, INTEGER : buildRooms
  1815  (1155)          INTEGER : i, j, at, textLen, count, need, tens, ones
  1816  (1156)          BOOLEAN : already
  1817  (1157)  
  1818  (1158)          kRooms =: outBuf(0)
  1819  (1159)          0 =: outBuf(1)                        % no name: the SERVER is answering
  1820  (1160)          2 =: at
  1821  (1161)          0 =: outBuf(at)                       % text length, high byte
  1822  (1162)          0 =: outBuf(at + 1)                   % low byte, filled in below
  1823  (1163)          at + 2 =: at
  1824  (1164)          0 =: textLen
  1825  (1165)  
  1826  (1166)          FOR i IN 1:maxSeats DO
  1827  (1167)              IF memberUsed(i) = 1 THEN
  1828  (1168)                  % Has an earlier seat already named this room?
  1829  (1169)                  %
  1830  (1170)                  % GUARDED, because seat 1 has no earlier seats and "FOR j IN
  1831  (1171)                  % 1:0" is an EMPTY RANGE. This compiler checks nothing, so an
  1832  (1172)                  % empty FOR is not a thing to rely on - the first room would be
  1833  (1173)                  % compared against seat 0, which is outside the array.
  1834  (1174)                  FALSE =: already
  1835  (1175)                  IF i > 1 THEN
  1836  (1176)                      FOR j IN 1:(i - 1) DO
  1837  (1177)                          IF memberUsed(j) = 1 THEN
  1838  (1178)                              IF sameRoom(i, j) THEN
  1839  (1179)                                  TRUE =: already
  1840  (1180)                              ENDIF
  1841  (1181)                          ENDIF
  1842  (1182)                      ENDFOR
  1843  (1183)                  ENDIF
  1844  (1184)  
  1845  (1185)                  IF NOT already THEN
  1846  (1186)                      % Count everybody in it, including seat i itself.
  1847  (1187)                      0 =: count
  1848  (1188)                      FOR j IN 1:maxSeats DO
  1849  (1189)                          IF memberUsed(j) = 1 THEN
  1850  (1190)                              IF sameRoom(i, j) THEN
  1851  (1191)                                  count + 1 =: count
  1852  (1192)                              ENDIF
  1853  (1193)                          ENDIF
  1854  (1194)                      ENDFOR
  1855  (1195)  
  1856  (1196)                      % name + "(" + up to two digits + ")" + a leading space
  1857  (1197)                      % once there is something to separate from.
  1858  (1198)                      mbrRoomLen(i) + 4 =: need
  1859  (1199)                      IF textLen > 0 THEN
  1860  (1200)                          need + 1 =: need
  1861  (1201)                      ENDIF
  1862  (1202)  
  1863  (1203)                      IF textLen + need <= 250 THEN
  1864  (1204)                          IF textLen > 0 THEN
  1865  (1205)                              spaceByte(0) =: outBuf(at)
  1866  (1206)                              at + 1 =: at
  1867  (1207)                              textLen + 1 =: textLen
  1868  (1208)                          ENDIF
  1869  (1209)                          FOR j IN 1:mbrRoomLen(i) DO
  1870  (1210)                              mbrRoom(i, j) =: outBuf(at)
  1871  (1211)                              at + 1 =: at
  1872  (1212)                          ENDFOR
  1873  (1213)                          textLen + mbrRoomLen(i) =: textLen
  1874  (1214)  
  1875  (1215)                          openParen(0) =: outBuf(at)
  1876  (1216)                          at + 1 =: at
  1877  (1217)                          textLen + 1 =: textLen
  1878  (1218)  
  1879  (1219)                          % At most sixteen seats, so at most two digits. Written
  1880  (1220)                          % straight out rather than through a general routine -
  1881  (1221)                          % a loop for a number that cannot exceed 16 would be
  1882  (1222)                          % more code than the thing it replaces.
  1883  (1223)                          count / 10 =: tens
  1884  (1224)                          count - (tens * 10) =: ones
  1885  (1225)                          IF tens > 0 THEN
  1886  (1226)                              digitZero + tens =: outBuf(at)
  1887  (1227)                              at + 1 =: at
  1888  (1228)                              textLen + 1 =: textLen
  1889  (1229)                          ENDIF
  1890  (1230)                          digitZero + ones =: outBuf(at)
  1891  (1231)                          at + 1 =: at
  1892  (1232)                          textLen + 1 =: textLen
  1893  (1233)  
  1894  (1234)                          closeParen(0) =: outBuf(at)
  1895  (1235)                          at + 1 =: at
  1896  (1236)                          textLen + 1 =: textLen
  1897  (1237)                      ENDIF
  1898  (1238)                  ENDIF
  1899  (1239)              ENDIF
  1900  (1240)          ENDFOR
  1901  (1241)  
  1902  (1242)          textLen =: outBuf(3)
  1903  (1243)          at RETURN
  1904  (1244)      ENDROUTINE
  1905  (1245)  
  1906  (1246)      % -----------------------------------------------------------------------
  1907  (1247)      % Build a message whose name comes from a member slot rather than from the
  1908  (1248)      % incoming buffer - used for Said, where the speaker is named by the room
  1909  (1249)      % and NOT by whatever the sender claimed.
  1910  (1250)      % -----------------------------------------------------------------------
  1911  (1251)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER, INTEGER) : &
  1912  (1252)              buildFromSlot(kind, slot, textAt, textLength)
  1913  (1253)          INTEGER : i, at
  1914  (1254)          kind =: outBuf(0)
  1915  (1255)          memberLen(slot) =: outBuf(1)
  1916  (1256)          2 =: at
  1917  (1257)          FOR i IN 1:memberLen(slot) DO
  1918  (1258)              memberName(slot, i) =: outBuf(at)
  1919  (1259)              at + 1 =: at
  1920  (1260)          ENDFOR
  1921  (1261)          0 =: outBuf(at)
  1922  (1262)          textLength =: outBuf(at + 1)
  1923  (1263)          at + 2 =: at
  1924  (1264)          FOR i IN 1:textLength DO
  1925  (1265)              inBuf(textAt + i - 1) =: outBuf(at)
  1926  (1266)              at + 1 =: at
  1927  (1267)          ENDFOR
  1928  (1268)          at RETURN
  1929  (1269)      ENDROUTINE
  1930  (1270)  
  1931  (1271)      % -----------------------------------------------------------------------
  1932  (1272)      % Copy a name out of the incoming buffer into a member slot.
  1933  (1273)      % -----------------------------------------------------------------------
  1934  (1274)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : copyNameIn(slot, at, length)
  1935  (1275)          INTEGER : i
  1936  (1276)          FOR i IN 1:length DO
  1937  (1277)              inBuf(at + i - 1) =: memberName(slot, i)
  1938  (1278)          ENDFOR
  1939  (1279)          length =: memberLen(slot)
  1940  (1280)      ENDROUTINE
  1941  (1281)  
  1942  (1282)      % -----------------------------------------------------------------------
  1943  (1283)      % Remember which room a member joined.
  1944  (1284)      %
  1945  (1285)      % The room arrives in the JOIN'S TEXT FIELD - the client puts it there
  1946  (1286)      % because there is one port now and the room can no longer be inferred from
  1947  (1287)      % which port the message came in on.
  1948  (1288)      %
  1949  (1289)      % A JOIN WITH NO ROOM IS PUT IN THE HOME ROOM rather than refused. An older
  1950  (1290)      % client that predates this change sends an empty text, and refusing it
  1951  (1291)      % would take the room out from under somebody whose only crime is not having
  1952  (1292)      % been rebuilt yet. LOBBY is where they used to be, so LOBBY is where they
  1953  (1293)      % go.
  1954  (1294)      %
  1955  (1295)      % Bounded at sixteen, the width of the column. PLANC checks no array bound,
  1956  (1296)      % so this test is the only thing between a long room name and whatever the
  1957  (1297)      % loader put next.
  1958  (1298)      % -----------------------------------------------------------------------
  1959  (1299)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : copyRoomIn(slot, at, length)
  1960  (1300)          INTEGER : i, take
  1961  (1301)  
  1962  (1302)          length =: take
  1963  (1303)          IF take > 16 THEN
  1964  (1304)              16 =: take
  1965  (1305)          ENDIF
  1966  (1306)  
  1967  (1307)          IF take <= 0 THEN
  1968  (1308)              FOR i IN 1:lenHomeRoom DO
  1969  (1309)                  homeRoom(i - 1) =: mbrRoom(slot, i)
  1970  (1310)              ENDFOR
  1971  (1311)              lenHomeRoom =: mbrRoomLen(slot)
  1972  (1312)              RETURN
  1973  (1313)          ENDIF
  1974  (1314)  
  1975  (1315)          FOR i IN 1:take DO
  1976  (1316)              inBuf(at + i - 1) =: mbrRoom(slot, i)
  1977  (1317)          ENDFOR
  1978  (1318)          take =: mbrRoomLen(slot)
  1979  (1319)      ENDROUTINE
  1980  (1320)  
  1981  (1321)      % -----------------------------------------------------------------------
  1982  (1322)      % Build the Renamed announcement. Returns its total length.
  1983  (1323)      %
  1984  (1324)      % The NEW name goes in the name field and the OLD one in the text. That is
  1985  (1325)      % not a choice made here - ChatMessageKind.cs states it, and the reason is
  1986  (1326)      % that everybody has a transcript on screen under the old name and no way to
  1987  (1327)      % connect the two without it. CALL THIS BEFORE the slot is changed, while
  1988  (1328)      % the old name is still in it.
  1989  (1329)      % -----------------------------------------------------------------------
  1990  (1330)      ROUTINE VOID, INTEGER (INTEGER, INTEGER, INTEGER) : &
  1991  (1331)              buildRenamed(slot, newAt, newLength)
  1992  (1332)          INTEGER : i, at
  1993  (1333)          kRenamed =: outBuf(0)
  1994  (1334)          newLength =: outBuf(1)
  1995  (1335)          2 =: at
  1996  (1336)          FOR i IN 1:newLength DO
  1997  (1337)              inBuf(newAt + i - 1) =: outBuf(at)
  1998  (1338)              at + 1 =: at
  1999  (1339)          ENDFOR
  2000  (1340)  
  2001  (1341)          % The old name as the text.
  2002  (1342)          0 =: outBuf(at)
  2003  (1343)          memberLen(slot) =: outBuf(at + 1)
  2004  (1344)          at + 2 =: at
  2005  (1345)          FOR i IN 1:memberLen(slot) DO
  2006  (1346)              memberName(slot, i) =: outBuf(at)
  2007  (1347)              at + 1 =: at
  2008  (1348)          ENDFOR
  2009  (1349)          at RETURN
  2010  (1350)      ENDROUTINE
  2011  (1351)  
  2012  (1352)      % -----------------------------------------------------------------------
  2013  (1353)      % Send outBuf to one magic number.
  2014  (1354)      %
  2015  (1355)      % XMPFGET reserves a buffer and makes it CURRENT; XMPFWRI writes into the
  2016  (1356)      % current message; XMPFSND sends it. Note the userAddress coercion - the
  2017  (1357)      % guide's own examples write ADDR(buf(0)) FORCE XMUSERADDRESS.
  2018  (1358)      % -----------------------------------------------------------------------
  2019  (1359)      ROUTINE VOID, VOID (INTEGER4, INTEGER) : sendTo(magic, length)
  2020  (1360)          XMMSGIDENTIFIER : ident
  2021  (1361)          INTEGER : deadSlot
  2022  (1362)          % Each of the three steps below printed its status on EVERY send while
  2023  (1363)          % the room was being brought up - three lines per message, per member.
  2024  (1364)          % They now speak only when a step fails, which is the case that was
  2025  (1365)          % actually worth seeing: a send that half-succeeds is how a member ends
  2026  (1366)          % up in the room and hearing nothing.
  2027  (1367)          xmpfget(0, length, ident) =: returnStatus
  2028  (1368)          IF returnStatus >< XMOK THEN
  2029  (1369)              OUTPUT(1, 'AL18', 'SV: get failed st=')
  2030  (1370)              OUTPUT(1, 'I6', returnStatus)
  2031  (1371)              OUTPUT(1, 'AL1', '$')
  2032  (1372)              logLine('SV get failed st= ', 18, returnStatus)
  2033  (1373)              RETURN
  2034  (1374)          ENDIF
  2035  (1375)          xmpfwri(0, 0, &
  2036  (1376)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  2037  (1377)              0, length, writtenLength) =: returnStatus
  2038  (1378)          IF returnStatus >< XMOK THEN
  2039  (1379)              OUTPUT(1, 'AL18', 'SV: wri failed st=')
  2040  (1380)              OUTPUT(1, 'I6', returnStatus)
  2041  (1381)              OUTPUT(1, 'AL1', '$')
  2042  (1382)              logLine('SV wri failed st= ', 18, returnStatus)
  2043  (1383)          ENDIF
  2044  (1384)          IF returnStatus >< XMOK THEN
  2045  (1385)              xmpfrel(0, ident) =: returnStatus
  2046  (1386)              RETURN
  2047  (1387)          ENDIF
  2048  (1388)          % XMPSEND, NOT XMPFSND - and this is the whole bug, not a tidy-up.
  2049  (1389)          %
  2050  (1390)          % XMPFSND takes no message parameter. The guide says which one it picks:
  2051  (1391)          % "the current (default) message buffer is assumed, namely the 'port
  2052  (1392)          % current' message if one exists, or, if none, the 'task current'
  2053  (1393)          % message" (ND-60.164.3, XMPFSND, EXPLANATION). XMPFGET above only makes
  2054  (1394)          % the new buffer TASK current - it has no port parameter and cannot make
  2055  (1395)          % it port current. This port has just received a message, so a 'port
  2056  (1396)          % current' message may well still exist, and XMPFSND would send THAT
  2057  (1397)          % instead of the reply we just built. The guide never says whether
  2058  (1398)          % XMPFREL clears the port-current pointer, so relying on it would be a
  2059  (1399)          % guess.
  2060  (1400)          %
  2061  (1401)          % XMPSEND("Send message, not necessarily current") removes the question:
  2062  (1402)          % "The message specified by msgIdentifier is set as 'task current'
  2063  (1403)          % message and as 'port current' message for localPort. Then the message
  2064  (1404)          % will be sent as described under routine XMPFSND."
  2065  (1405)          %
  2066  (1406)          % Appendix G's SERVER gets away with XMPFSND only because it never calls
  2067  (1407)          % XMPFGET - it replies in the very buffer that arrived, which is already
  2068  (1408)          % both port and task current. We cannot copy that: a broadcast needs one
  2069  (1409)          % fresh buffer per member.
  2070  (1410)          xmpsend(sendFlags, ident, myPort, magic) =: returnStatus
  2071  (1411)          IF returnStatus >< XMOK THEN
  2072  (1412)              OUTPUT(1, 'AL18', 'SV: snd failed st=')
  2073  (1413)              OUTPUT(1, 'I6', returnStatus)
  2074  (1414)              OUTPUT(1, 'AL1', '$')
  2075  (1415)              logLine('SV snd failed st= ', 18, returnStatus)
  2076  (1416)  
  2077  (1417)              % ---- A MEMBER WHO IS NO LONGER THERE, IF WE ARE EVER TOLD HERE --
  2078  (1418)              % Two statuses would mean the seat is holding somebody who has gone.
  2079  (1419)              % Both are read off XMP-B02:DEFS rather than guessed:
  2080  (1420)              %
  2081  (1421)              %   XMXEIMA 16915  Invalid magic number
  2082  (1422)              %   XMXEPCL 16932  Remote port closed while message queued
  2083  (1423)              %
  2084  (1424)              % NEITHER OF THEM ACTUALLY TURNS UP for a client killed on this
  2085  (1425)              % machine - measured, see the note on sendFlags. XMPSEND took the
  2086  (1426)              % message for a closed port and answered XMOK. This test is kept
  2087  (1427)              % rather than deleted because it costs one compare and it is right
  2088  (1428)              % if a status ever does arrive - a remote member across a link is
  2089  (1429)              % the obvious untested case - but it is NOT what fixes the leak.
  2090  (1430)              % The XMTRE branch in the receive loop is.
  2091  (1431)              %
  2092  (1432)              % ONLY THESE TWO, and deliberately not "any failure". XMXEMFL
  2093  (1433)              % (message space full) is a bad moment, not a dead member, and
  2094  (1434)              % throwing somebody out of the room because the machine was briefly
  2095  (1435)              % short of buffers would be worse than the bug being fixed. Every
  2096  (1436)              % other status still prints above.
  2097  (1437)              IF returnStatus = XMXEIMA OR returnStatus = XMXEPCL THEN
  2098  (1438)                  findByMagic(magic) =: deadSlot
  2099  (1439)                  IF deadSlot >< 0 THEN
  2100  (1440)                      1 =: memberDead(deadSlot)
  2101  (1441)                      1 =: deadFound
  2102  (1442)                  ENDIF
  2103  (1443)              ENDIF
  2104  (1444)          ENDIF
  2105  (1445)      ENDROUTINE
  2106  (1446)  
  2107  (1447)      % -----------------------------------------------------------------------
  2108  (1448)      % Send to everybody in one room, optionally leaving one member out.
  2109  (1449)      %
  2110  (1450)      % ROOM-AWARE NOW, AND IT HAS TO BE. With one port every member of every
  2111  (1451)      % room sits in this one table, so an unfiltered broadcast would put
  2112  (1452)      % GENERAL's traffic on LOBBY's screens. Under the old port-per-room model
  2113  (1453)      % that could not happen - a separate port meant a separate server table -
  2114  (1454)      % which is why this routine had no room test until today.
  2115  (1455)      %
  2116  (1456)      % TWO PARAMETERS, NOT ONE, AND THAT IS THE WHOLE FIX.
  2117  (1457)      %
  2118  (1458)      % There was one slot number doing two unrelated jobs: naming the room to
  2119  (1459)      % send to, AND naming the member to leave out. Slot 0 cannot mean both
  2120  (1460)      % "no room" and "leave nobody out", and it was read as the first while
  2121  (1461)      % every Say, Rename and Leave passed it meaning the second - so the guard
  2122  (1462)      % at the top returned before sending a single letter.
  2123  (1463)      %
  2124  (1464)      % MEASURED ON D100, 2026-08-20, with two clients in LOBBY: neither saw a
  2125  (1465)      % word the other said, while /who listed them both and the Joined notice
  2126  (1466)      % arrived. Those two are exactly the paths that do NOT go through here
  2127  (1467)      % with a zero - /who answers the asker directly, and Joined passes a real
  2128  (1468)      % slot. The room table was never wrong; nothing was ever sent.
  2129  (1469)      %
  2130  (1470)      % So they are separate now and neither is overloaded:
  2131  (1471)      %   roomOfSlot  whose room defines the audience. 0 sends to nobody,
  2132  (1472)      %               because "everybody in the same room as nobody" is nobody.
  2133  (1473)      %   skipSlot    one member to leave out, or 0 to leave nobody out.
  2134  (1474)      %
  2135  (1475)      % roomOfSlot's own seat may already be empty - a member is removed from
  2136  (1476)      % the room BEFORE the room is told they left - and that still works,
  2137  (1477)      % because sameRoom reads only the stored room name, which nothing clears.
  2138  (1478)      % -----------------------------------------------------------------------
  2139  (1479)      ROUTINE VOID, VOID (INTEGER, INTEGER, INTEGER) : broadcast(length, roomOfSlot, skipSlot)
  2140  (1480)          INTEGER : i, sent
  2141  (1481)          IF roomOfSlot = 0 THEN
  2142  (1482)              % Worth a line of its own. "Nobody was in the room" and "this was
  2143  (1483)              % never called" look identical from outside, and telling them apart
  2144  (1484)              % is most of the work when a message does not arrive.
  2145  (1485)              logLine('SV bcast NO ROOM  ', 18, skipSlot)
  2146  (1486)              RETURN
  2147  (1487)          ENDIF
  2148  (1488)  
  2149  (1489)          0 =: sent
  2150  (1490)          FOR i IN 1:maxSeats DO
  2151  (1491)              IF memberUsed(i) >< 0 THEN
  2152  (1492)                  IF i >< skipSlot THEN
  2153  (1493)                      IF sameRoom(i, roomOfSlot) THEN
  2154  (1494)                          sendTo(memberMagic(i), length)
  2155  (1495)                          sent + 1 =: sent
  2156  (1496)                      ENDIF
  2157  (1497)                  ENDIF
  2158  (1498)              ENDIF
  2159  (1499)          ENDFOR
  2160  (1500)  
  2161  (1501)          % HOW MANY IT CHOSE, every time, and this is the instrument the whole
  2162  (1502)          % afternoon of 2026-08-20 was missing. A zero here says the room filter
  2163  (1503)          % rejected everybody; a number with nothing arriving says the sends are
  2164  (1504)          % the problem; no line at all says broadcast was never reached. Three
  2165  (1505)          % different faults that all look the same from a terminal.
  2166  (1506)          logLine('SV bcast sent to  ', 18, sent)
  2167  (1507)      ENDROUTINE
  2168  (1508)  
  2169  (1509)      % -----------------------------------------------------------------------
  2170  (1510)      % Empty the seats of members who have vanished, and give each seat back.
  2171  (1511)      %
  2172  (1512)      % CALLED FROM THE TOP OF THE RECEIVE LOOP, never from inside a broadcast -
  2173  (1513)      % see the note on memberDead for why that is not a style choice.
  2174  (1514)      %
  2175  (1515)      % A vanished member costs TWO things and they are not the same thing:
  2176  (1516)      %
  2177  (1517)      %   the seat in this program  memberUsed, which decides who is in the room;
  2178  (1518)      %   the seat in XROUT         the free-connection counter, which decides
  2179  (1519)      %                             whether a new joiner's letter is forwarded at
  2180  (1520)      %                             all. XROUT decremented it to deliver the join
  2181  (1521)      %                             and only the port's owner - this program -
  2182  (1522)      %                             ever puts one back, with XMPINFC.
  2183  (1523)      %
  2184  (1524)      % Clearing only the first leaves the room looking empty in LIST-NAMES while
  2185  (1525)      % it refuses everybody. MEASURED 2026-08-18, before this routine existed:
  2186  (1526)      % CHAT-LOBBY went 16 free to 15 when a client was aborted with ESC
  2187  (1527)      % ("USER BREAK AT 16665B") and stayed at 15 for good.
  2188  (1528)      % -----------------------------------------------------------------------
  2189  (1529)      ROUTINE VOID, VOID : reapDead
  2190  (1530)          INTEGER : round, i, length
  2191  (1531)  
  2192  (1532)          % Cleared FIRST, not last. A broadcast below can discover another dead
  2193  (1533)          % member - telling the room somebody left is exactly when the next dead
  2194  (1534)          % port gets found - and clearing at the end would throw that mark away.
  2195  (1535)          % Cleared here, a mark raised during our own broadcasts simply re-arms
  2196  (1536)          % this routine for the next message.
  2197  (1537)          0 =: deadFound
  2198  (1538)  
  2199  (1539)          % Bounded rather than a WHILE. Each pass empties at least one seat and a
  2200  (1540)          % pass can only mark members still in the room, so maxSeats passes empty
  2201  (1541)          % the worst room there is. An unbounded loop here would be taking on
  2202  (1542)          % trust that a broadcast to a dying room always terminates, and this
  2203  (1543)          % program has no way to recover if it does not.
  2204  (1544)          FOR round IN 1:maxSeats DO
  2205  (1545)              FOR i IN 1:maxSeats DO
  2206  (1546)                  IF memberDead(i) >< 0 THEN
  2207  (1547)                      0 =: memberDead(i)
  2208  (1548)                      IF memberUsed(i) >< 0 THEN
  2209  (1549)                          % Same order as the kLeave path: build the announcement
  2210  (1550)                          % while the name is still in the slot, empty the seat,
  2211  (1551)                          % THEN tell the room - so the departing member is not
  2212  (1552)                          % sent their own Left notice at a port already gone,
  2213  (1553)                          % which would only mark them dead all over again.
  2214  (1554)                          buildFromSlot(kLeft, i, 0, 0) =: length
  2215  (1555)                          0 =: memberUsed(i)
  2216  (1556)                          broadcast(length, i, i)   % their room, not them
  2217  (1557)  
  2218  (1558)                          xmpinfc(0, myPort, 1, 0) =: returnStatus
  2219  (1559)                          IF returnStatus >< XMOK THEN
  2220  (1560)                              OUTPUT(1, 'AL18', 'SV: infc failed st')
  2221  (1561)                              OUTPUT(1, 'I6', returnStatus)
  2222  (1562)                              OUTPUT(1, 'AL1', '$')
  2223  (1563)                              logLine('SV infc faild st= ', 18, returnStatus)
  2224  (1564)                          ENDIF
  2225  (1565)  
  2226  (1566)                          % Worth one line: an operator watching the room needs to
  2227  (1567)                          % be able to tell "they left" from "they died", because
  2228  (1568)                          % only the second is evidence of anything.
  2229  (1569)                          OUTPUT(1, 'AL21', 'SV: reaped dead slot ')
  2230  (1570)                          OUTPUT(1, 'I6', i)
  2231  (1571)                          OUTPUT(1, 'AL1', '$')
  2232  (1572)                          logLine('SV reaped slot    ', 18, i)
  2233  (1573)                      ENDIF
  2234  (1574)                  ENDIF
  2235  (1575)              ENDFOR
  2236  (1576)          ENDFOR
  2237  (1577)      ENDROUTINE
  2238  (1578)  
  2239  (1579)      % ----- the refusal reasons, worded exactly as ChatRoom.cs words them ----
  2240  (1580)      % Carried on the wire so a client shows the same sentence whichever door it
  2241  (1581)      % came in by. If these and ChatRoom ever diverge, one of the two is wrong.
  2242  (1582)      %
  2243  (1583)      % EACH LENGTH IS WRITTEN OUT beside its string, and that is deliberate. An
  2244  (1584)      % earlier version called LENGTH(reason) - PLANC has no such routine. The one
  2245  (1585)      % it does have is SIZE, whose syntax is "SIZE ident =: var" with no
  2246  (1586)      % parentheses, and which returns the STORAGE size; what that means for a
  2247  (1587)      % BYTES value passed as a routine parameter is not established. Passing the
  2248  (1588)      % count removes the question rather than trading one guess for another.
  2249  (1589)      %
  2250  (1590)      % The cost is that a string and its number must be changed together. That is
  2251  (1591)      % a real risk and it is why they are on adjacent lines.
  2252  (1592)      BYTES : reasonNeedNick := 'a nickname is required'
  2253  (1593)      INTEGER : lenNeedNick := 22
  2254  (1594)      BYTES : reasonNickTaken    := 'that nickname is taken'
  2255  (1595)      INTEGER : lenNickTaken := 22
  2256  (1596)      BYTES : reasonAlreadyIn    := 'already joined'
  2257  (1597)      INTEGER : lenAlreadyIn := 14
  2258  (1598)      BYTES : reasonRoomFull     := 'the room is full'
  2259  (1599)      INTEGER : lenRoomFull := 16
  2260  (1600)      BYTES : reasonTopicFull    := 'too many rooms have topics'
  2261  (1601)      INTEGER : lenTopicFull := 26
  2262  (1602)  
  2263  (1603)      % -----------------------------------------------------------------------
  2264  (1604)      % Refuse the sender, echoing the name they asked for and naming the reason.
  2265  (1605)      %
  2266  (1606)      % The name is echoed so the asker can tell WHICH request failed when it has
  2267  (1607)      % more than one outstanding; the reason is carried so the wording is the
  2268  (1608)      % same on both doors.
  2269  (1609)      % -----------------------------------------------------------------------
  2270  (1610)      ROUTINE VOID, VOID (INTEGER, INTEGER, BYTES, INTEGER) : &
  2271  (1611)              refuse(nameAt, nameLength, reason, reasonLength)
  2272  (1612)          INTEGER : i, at
  2273  (1613)          kReject =: outBuf(0)
  2274  (1614)          nameLength =: outBuf(1)
  2275  (1615)          2 =: at
  2276  (1616)          FOR i IN 1:nameLength DO
  2277  (1617)              inBuf(nameAt + i - 1) =: outBuf(at)
  2278  (1618)              at + 1 =: at
  2279  (1619)          ENDFOR
  2280  (1620)  
  2281  (1621)          0 =: outBuf(at)
  2282  (1622)          reasonLength =: outBuf(at + 1)
  2283  (1623)          at + 2 =: at
  2284  (1624)          % SUBSCRIPT FROM ZERO. A BYTES declared from a literal - which is what
  2285  (1625)          % every reason string above is - has its first character at index 0, so
  2286  (1626)          % "reason(i)" for i in 1:len silently drops the first letter and reads
  2287  (1627)          % one byte past the end. Same defect, same day, in CHAT.PLNC's buildOwn,
  2288  (1628)          % where it turned RONNY into ONNY on the wire and was only visible
  2289  (1629)          % because the raw bytes were dumped. Nothing warns; PLANC checks no
  2290  (1630)          % bound. Compare cmdIs in CHAT.PLNC, which has always used word(i - 1).
  2291  (1631)          FOR i IN 1:reasonLength DO
  2292  (1632)              reason(i - 1) =: outBuf(at)
  2293  (1633)              at + 1 =: at
  2294  (1634)          ENDFOR
  2295  (1635)  
  2296  (1636)          sendTo(senderMagic, at)
  2297  (1637)      ENDROUTINE
  2298  (1638)  
  2299  (1639)      % -----------------------------------------------------------------------
  2300  (1640)      % Decode one arrived message and apply the room rules.
  2301  (1641)      %
  2302  (1642)      % A transcription of Xmsg.Chat/ChatRoom.cs. Where that file refuses, this
  2303  (1643)      % refuses for the same reason and in the same order, because the two doors
  2304  (1644)      % lead into one room.
  2305  (1645)      % -----------------------------------------------------------------------
  2306  (1646)      ROUTINE VOID, VOID : handleMessage
  2307  (1647)          INTEGER : kind, nameLength, nameAt, textLength, textAt
  2308  (1648)          INTEGER : slot, taken, length
  2309  (1649)          % i is used by the topic copy, which is the only loop in this routine.
  2310  (1650)          INTEGER : i
  2311  (1651)  
  2312  (1652)          inBuf(0) =: kind
  2313  (1653)          inBuf(1) =: nameLength
  2314  (1654)          2 =: nameAt
  2315  (1655)  
  2316  (1656)          % A "parse k= nlen= rlen=" line printed here on EVERY message while the
  2317  (1657)          % join was being brought up. It said "remove once the join works", and
  2318  (1658)          % the join works - it was what showed the kind arriving as the XSLET
  2319  (1659)          % serial number instead of kJoin, which is how the missing header skip
  2320  (1660)          % was found.
  2321  (1661)          %
  2322  (1662)          % THE THREE "DROP" MESSAGES BELOW STAY. They are not the same thing: a
  2323  (1663)          % silent drop is right for a stranger on the wire but leaves the operator
  2324  (1664)          % unable to tell a refused message from a lost one, and each prints only
  2325  (1665)          % when something is actually wrong rather than once per message.
  2326  (1666)  
  2327  (1667)          % ---- TRUST NOTHING THAT ARRIVED ------------------------------------
  2328  (1668)          % Every field below is a byte a stranger chose. Two things have to hold
  2329  (1669)          % before any of them is used, and neither is checked by the language:
  2330  (1670)          %
  2331  (1671)          %   the name must FIT      memberName has maxNameLen bytes per seat, and
  2332  (1672)          %                          a length byte can say 255.
  2333  (1673)          %   the fields must be IN  the message actually read is readLength
  2334  (1674)          %   THE MESSAGE            bytes; a length that points past it would read
  2335  (1675)          %                          whatever the previous, longer message left in
  2336  (1676)          %                          inBuf and answer with it.
  2337  (1677)          %
  2338  (1678)          % Dropped in silence rather than refused: a refusal would need a name to
  2339  (1679)          % echo, and the name is the part that is not trustworthy. The seat is
  2340  (1680)          % settled by the receive loop either way, which is exactly why that
  2341  (1681)          % accounting does not live in here.
  2342  (1682)          %
  2343  (1683)          % The sixteen is a rule of the ROOM, not a detail of this program:
  2344  (1684)          % ChatRoom.MaxNicknameLength says the same number, so a name this side
  2345  (1685)          % must drop is one the other side refuses rather than admits. Otherwise
  2346  (1686)          % the two rooms would disagree about who is in them.
  2347  (1687)          IF nameLength > maxNameLen THEN
  2348  (1688)              OUTPUT(1, 'AL21', 'SV: DROP name too big')
  2349  (1689)              OUTPUT(1, 'AL1', '$')
  2350  (1690)              RETURN
  2351  (1691)          ENDIF
  2352  (1692)          IF nameAt + nameLength + 1 > readLength THEN
  2353  (1693)              OUTPUT(1, 'AL22', 'SV: DROP name past end')
  2354  (1694)              OUTPUT(1, 'AL1', '$')
  2355  (1695)              RETURN
  2356  (1696)          ENDIF
  2357  (1697)  
  2358  (1698)          nameAt + nameLength =: textAt
  2359  (1699)          inBuf(textAt) * 256 + inBuf(textAt + 1) =: textLength
  2360  (1700)          textAt + 2 =: textAt
  2361  (1701)  
  2362  (1702)          IF textAt + textLength > readLength THEN
  2363  (1703)              OUTPUT(1, 'AL22', 'SV: DROP text past end')
  2364  (1704)              OUTPUT(1, 'AL1', '$')
  2365  (1705)              RETURN
  2366  (1706)          ENDIF
  2367  (1707)  
  2368  (1708)          % ---- ONE VOCABULARY IS NOT ONE AUTHORITY ---------------------------
  2369  (1709)          %
  2370  (1710)          % Admin kinds share the room's numbering on purpose - a second enum
  2371  (1711)          % would mean a second decoder bound, and that bound has been left
  2372  (1712)          % behind twice, silently both times. But sharing the words is not
  2373  (1713)          % sharing the right to use them anywhere: an admin kind arriving on
  2374  (1714)          % CHAT-LOBBY would let any client that can reach the room stop the
  2375  (1715)          % server, and a room kind on the command port would put a member in a
  2376  (1716)          % seat nobody counted.
  2377  (1717)          %
  2378  (1718)          % Refused in SILENCE rather than with a reason. A caller on the wrong
  2379  (1719)          % port is either confused or probing, and neither is owed a map.
  2380  (1720)          IF kind >= kAdmStat THEN
  2381  (1721)              IF NOT fromAdmin THEN
  2382  (1722)                  RETURN
  2383  (1723)              ENDIF
  2384  (1724)          ELSE
  2385  (1725)              IF fromAdmin THEN
  2386  (1726)                  RETURN
  2387  (1727)              ENDIF
  2388  (1728)          ENDIF
  2389  (1729)  
  2390  (1730)          % ---- THE ADMIN COMMANDS --------------------------------------------
  2391  (1731)          IF kind = kAdmStat THEN
  2392  (1732)              buildStatus =: length
  2393  (1733)              sendTo(senderMagic, length)
  2394  (1734)              RETURN
  2395  (1735)          ENDIF
  2396  (1736)  
  2397  (1737)          IF kind = kAdmStop THEN
  2398  (1738)              % Say who did it. An unattributed stop in a log is worth little,
  2399  (1739)              % and the asker's name rode in the nickname field for this.
  2400  (1740)              OUTPUT(1, 'AL19', 'CHATSV: stopped by ')
  2401  (1741)              showName(nameAt, nameLength)
  2402  (1742)              OUTPUT(1, 'AL1', '$')
  2403  (1743)              TRUE =: stopWanted
  2404  (1744)              RETURN
  2405  (1745)          ENDIF
  2406  (1746)  
  2407  (1747)          % The seat this sender already holds, or -1 if none. A "slot now=" line
  2408  (1748)          % used to print here on every message; it was part of the same bring-up
  2409  (1749)          % as the parse line above and went with it.
  2410  (1750)          findByMagic(senderMagic) =: slot
  2411  (1751)  
  2412  (1752)          IF kind = kJoin THEN
  2413  (1753)              % Order matches ChatRoom.TryJoin: empty name, then taken name, then
  2414  (1754)              % already joined.
  2415  (1755)              IF nameLength = 0 THEN
  2416  (1756)                  refuse(nameAt, nameLength, reasonNeedNick, lenNeedNick)
  2417  (1757)                  RETURN
  2418  (1758)              ENDIF
  2419  (1759)              findByName(nameAt, nameLength) =: taken
  2420  (1760)              IF taken >< 0 THEN
  2421  (1761)                  refuse(nameAt, nameLength, reasonNickTaken, lenNickTaken)
  2422  (1762)                  RETURN
  2423  (1763)              ENDIF
  2424  (1764)              IF slot >< 0 THEN
  2425  (1765)                  refuse(nameAt, nameLength, reasonAlreadyIn, lenAlreadyIn)
  2426  (1766)                  RETURN
  2427  (1767)              ENDIF
  2428  (1768)  
  2429  (1769)              freeSlot =: slot
  2430  (1770)              IF slot = 0 THEN
  2431  (1771)                  % XROUT should have stopped this - the seat count it holds and
  2432  (1772)                  % maxSeats here are the same number. If it ever happens, the
  2433  (1773)                  % two have drifted apart and that is worth refusing loudly
  2434  (1774)                  % rather than overwriting a member.
  2435  (1775)                  refuse(nameAt, nameLength, reasonRoomFull, lenRoomFull)
  2436  (1776)                  RETURN
  2437  (1777)              ENDIF
  2438  (1778)  
  2439  (1779)              1 =: memberUsed(slot)
  2440  (1780)              senderMagic =: memberMagic(slot)
  2441  (1781)              copyNameIn(slot, nameAt, nameLength)
  2442  (1782)  
  2443  (1783)              % AND WHICH ROOM. The Join carries it in the TEXT field,
  2444  (1784)              % because with one port the room can no longer be told from
  2445  (1785)              % which port the message arrived on. Everything this member
  2446  (1786)              % says afterwards is broadcast only to the others in it.
  2447  (1787)              copyRoomIn(slot, textAt, textLength)
  2448  (1788)  
  2449  (1789)              % The welcome goes only to the joiner; the room hears Joined.
  2450  (1790)              buildMessage(kWelcome, nameAt, nameLength, 0, 0) =: length
  2451  (1791)              sendTo(senderMagic, length)
  2452  (1792)  
  2453  (1793)              buildMessage(kJoined, nameAt, nameLength, 0, 0) =: length
  2454  (1794)              broadcast(length, slot, slot)        % their room, not them
  2455  (1795)              RETURN
  2456  (1796)          ENDIF
  2457  (1797)  
  2458  (1798)          % Everything below requires membership. Silence for a stranger, exactly
  2459  (1799)          % as ChatRoom does: answering would confirm the port is a chat server to
  2460  (1800)          % something that never joined.
  2461  (1801)          IF slot = 0 THEN
  2462  (1802)              RETURN
  2463  (1803)          ENDIF
  2464  (1804)  
  2465  (1805)          IF kind = kSay THEN
  2466  (1806)              % The speaker is named by the ROOM, never by what the sender put in
  2467  (1807)              % the message - otherwise anyone could speak as anyone.
  2468  (1808)              buildFromSlot(kSaid, slot, textAt, textLength) =: length
  2469  (1809)              broadcast(length, slot, 0)            % their room, speaker too
  2470  (1810)              RETURN
  2471  (1811)          ENDIF
  2472  (1812)  
  2473  (1813)          IF kind = kRename THEN
  2474  (1814)              IF nameLength = 0 THEN
  2475  (1815)                  refuse(nameAt, nameLength, reasonNeedNick, lenNeedNick)
  2476  (1816)                  RETURN
  2477  (1817)              ENDIF
  2478  (1818)              IF sameName(slot, nameAt, nameLength) = 1 THEN
  2479  (1819)                  RETURN                            % already your name: not news
  2480  (1820)              ENDIF
  2481  (1821)              findByName(nameAt, nameLength) =: taken
  2482  (1822)              IF taken >< 0 THEN
  2483  (1823)                  refuse(nameAt, nameLength, reasonNickTaken, lenNickTaken)
  2484  (1824)                  RETURN
  2485  (1825)              ENDIF
  2486  (1826)  
  2487  (1827)              % Renamed carries the NEW name and the OLD one as its text, so a
  2488  (1828)              % transcript on somebody's screen can be connected up. Built before
  2489  (1829)              % the slot changes, while the old name is still there.
  2490  (1830)              buildRenamed(slot, nameAt, nameLength) =: length
  2491  (1831)              copyNameIn(slot, nameAt, nameLength)
  2492  (1832)              broadcast(length, slot, 0)            % their room, asker too
  2493  (1833)              RETURN
  2494  (1834)          ENDIF
  2495  (1835)  
  2496  (1836)          % /who - answered to the ASKER ALONE, never broadcast. Everybody else
  2497  (1837)          % asking would then get a list they did not want, and the room would
  2498  (1838)          % spend a message on each of them.
  2499  (1839)          IF kind = kWho THEN
  2500  (1840)              % slot, not senderMagic: the answer is filtered to the ASKER'S
  2501  (1841)              % ROOM, so buildWho needs a seat to compare against.
  2502  (1842)              buildWho(slot) =: length
  2503  (1843)              sendTo(senderMagic, length)
  2504  (1844)              RETURN
  2505  (1845)          ENDIF
  2506  (1846)  
  2507  (1847)          % /list - the rooms and how many are in each. Answered to the ASKER
  2508  (1848)          % ALONE, same as /who and for the same reason.
  2509  (1849)          IF kind = kRooms THEN
  2510  (1850)              buildRooms =: length
  2511  (1851)              sendTo(senderMagic, length)
  2512  (1852)              RETURN
  2513  (1853)          ENDIF
  2514  (1854)  
  2515  (1855)          % /topic - ask with an empty text, set with a non-empty one.
  2516  (1856)          %
  2517  (1857)          % A SET IS BROADCAST, AN ASK IS NOT. Everybody in the room needs to see
  2518  (1858)          % a topic change as it happens - it is a change to the room, not an
  2519  (1859)          % answer to one person - while an ask is nobody else's business.
  2520  (1860)          IF kind = kTopic THEN
  2521  (1861)              IF textLength = 0 THEN
  2522  (1862)                  buildTopic(slot) =: length
  2523  (1863)                  sendTo(senderMagic, length)
  2524  (1864)                  RETURN
  2525  (1865)              ENDIF
  2526  (1866)  
  2527  (1867)              % TRUNCATED, NOT REFUSED. The length arrives from the peer and
  2528  (1868)              % PLANC checks no array bound, so a long topic would write straight
  2529  (1869)              % through the rest of the table. The client already stops at 64, so
  2530  (1870)              % this only ever bites a peer that is not our client - which is
  2531  (1871)              % exactly the case a bound has to survive.
  2532  (1872)              IF textLength > maxTopicLen THEN
  2533  (1873)                  maxTopicLen =: textLength
  2534  (1874)              ENDIF
  2535  (1875)  
  2536  (1876)              claimTopic(slot) =: taken
  2537  (1877)              IF taken = 0 THEN
  2538  (1878)                  % The table is full. SAY SO rather than dropping it: a topic
  2539  (1879)                  % that silently does not stick is the kind of failure somebody
  2540  (1880)                  % retries for ten minutes. refuse() sends for itself.
  2541  (1881)                  refuse(nameAt, nameLength, reasonTopicFull, lenTopicFull)
  2542  (1882)                  RETURN
  2543  (1883)              ENDIF
  2544  (1884)  
  2545  (1885)              FOR i IN 1:textLength DO
  2546  (1886)                  inBuf(textAt + i - 1) =: topicText(taken, i)
  2547  (1887)              ENDFOR
  2548  (1888)              textLength =: topicTextLen(taken)
  2549  (1889)  
  2550  (1890)              buildTopic(slot) =: length
  2551  (1891)              broadcast(length, slot, 0)        % 0 = leave nobody out
  2552  (1892)              RETURN
  2553  (1893)          ENDIF
  2554  (1894)  
  2555  (1895)          IF kind = kLeave THEN
  2556  (1896)              buildFromSlot(kLeft, slot, 0, 0) =: length
  2557  (1897)              0 =: memberUsed(slot)
  2558  (1898)              broadcast(length, slot, slot)         % their room, not them
  2559  (1899)  
  2560  (1900)              % Give the seat back to XROUT, or the room fills up permanently and
  2561  (1901)              % XROUT stops forwarding joins long after anybody left.
  2562  (1902)              xmpinfc(0, myPort, 1, 0) =: returnStatus
  2563  (1903)              RETURN
  2564  (1904)          ENDIF
  2565  (1905)      ENDROUTINE
  2566  (1906)  
  2567  (1907)      % -----------------------------------------------------------------------
  2568  (1908)      % The program.
  2569  (1909)      % -----------------------------------------------------------------------
  2570  (1910)      PROGRAM : chatServer
  2571  (1911)          XMMSGIDENTIFIER : msgIdent
  2572  (1912)          INTEGER : i
  2573  (1913)  
  2574  (1914)          % INISTACK RUNS EVERY START, and it must - the stack does not survive
  2575  (1915)          % the terminate. Everything below it is guarded instead.
  2576  (1916)          INISTACK stack
  2577  (1917)  
  2578  (1918)          % ---- NO FLAGS AT ALL. NOT XFWTF, AND NOT XFWAK EITHER. --------------
  2579  (1919)          %
  2580  (1920)          % XFWTF was never right here: a task already blocked in XFRCV is ACTIVE,
  2581  (1921)          % and RT-starting an active program does not queue a second run, so a
  2582  (1922)          % wake-up arriving during a block is simply LOST.
  2583  (1923)          %
  2584  (1924)          % BUT XFWAK IS ALSO WRONG NOW, AND IT WEDGED THE SERVER. Measured on
  2585  (1925)          % D100, 2026-08-21, with one client trying to join:
  2586  (1926)          %
  2587  (1927)          %   X-C LIST-PORTS
  2588  (1928)          %    No  Address  Owner-task   Qhead  Qlen  Chain WAK
  2589  (1929)          %     6  160057 152616 BAK06  161762     1      0   0   <- the ROOM port
  2590  (1930)          %    14  160147 152616 BAK06       0     0      6   1   <- the ADMIN port
  2591  (1931)          %
  2592  (1932)          % A message SITTING on the room port, and the task parked on the admin
  2593  (1933)          % port's wake-up instead. The server had logged its two START lines and
  2594  (1934)          % then written nothing more; the client waited for ever at "not in a
  2595  (1935)          % room yet". XFRCV CANNOT WAIT ON TWO PORTS - arming a wake on each does
  2596  (1936)          % not make one call watch both, and the wake-up does NOT deliver the
  2597  (1937)          % message even when it fires.
  2598  (1938)          %
  2599  (1939)          % XFWAK WAS LEFT OVER FROM A DESIGN THAT NO LONGER EXISTS. It belonged
  2600  (1940)          % to the original loop, which RETURNED when both ports were empty and
  2601  (1941)          % relied on the next message RT-starting the program again. That was
  2602  (1942)          % replaced by the MON 267B sleep below - the program now STAYS ALIVE and
  2603  (1943)          % goes round - and once it stays alive there is nothing for a wake-up to
  2604  (1944)          % do. Keeping it bought nothing and cost the whole server.
  2605  (1945)          %
  2606  (1946)          % Flags ZERO is XMSG's own no-wait: the call returns at once whether or
  2607  (1947)          % not a message was there. Both ports get polled every pass, and the
  2608  (1948)          % one-second sleep when both are empty is what keeps it from spinning.
  2609  (1949)          0 =: waitFlags
  2610  (1950)          2**XFSEC =: sendFlags
  2611  (1951)  
  2612  (1952)          % ---- OPEN ONCE, NOT ONCE PER START ---------------------------------
  2613  (1953)          IF NOT portsOpen THEN
  2614  (1954)              FOR i IN 1:maxSeats DO
  2615  (1955)                  0 =: memberUsed(i)
  2616  (1956)                  0 =: memberDead(i)
  2617  (1957)              ENDFOR
  2618  (1958)  
  2619  (1959)              % A CONNECTION port: XROUT holds the free-connection counter and
  2620  (1960)              % turns the joiner past maxSeats away for us, before this program
  2621  (1961)              % is woken. That is the whole reason no client knows the number.
  2622  (1962)              % ONE PORT, CALLED *CHAT. Every service on this machine is starred
  2623  (1963)              % and short - *FA-SERVER, *XFTRA, *COSPO, *TADADM - and the chat
  2624  (1964)              % server is one of them.
  2625  (1965)              %
  2626  (1966)              % IT USED TO BE CHAT-LOBBY, and that was two mistakes in one name.
  2627  (1967)              % CHAT-LOBBY is a ROOM name doing duty as a SERVICE name, and the
  2628  (1968)              % client built a DIFFERENT port name per room - "CHAT-" plus the
  2629  (1969)              % room - so every room needed its own registered port. That made
  2630  (1970)              % the set of rooms XROUT's data rather than the server's, with no
  2631  (1971)              % call to read it back; it made a room expensive to create; it
  2632  (1972)              % fragmented the seat count per port; and it turned a federated
  2633  (1973)              % room into the SAME NAME registered on two machines, which is a
  2634  (1974)              % collision rather than shared state.
  2635  (1975)              %
  2636  (1976)              % Now: one port, and the ROOM TRAVELS IN THE MESSAGE. LOBBY goes
  2637  (1977)              % back to being an ordinary room. See the_room_model in
  2638  (1978)              % DOC/protocols/chat-wire.json.
  2639  (1979)              xmpopcn(0, '*CHAT', uniqueName, maxSeats, myPort) &
  2640  (1980)                  =: returnStatus
  2641  (1981)              IF returnStatus >< XMOK THEN
  2642  (1982)                  OUTPUT(1, 'AL29', 'CHATSV: cannot open the room$')
  2643  (1983)                  OUTPUT(1, 'AL11', 'SV: opn st=')
  2644  (1984)                  OUTPUT(1, 'I6', returnStatus)
  2645  (1985)                  OUTPUT(1, 'AL1', '$')
  2646  (1986)                  RETURN
  2647  (1987)              ENDIF
  2648  (1988)  
  2649  (1989)              % The command port. XMPOPNM - a NORMAL named port, so an operator
  2650  (1990)              % costs the room nothing. See the declaration for why that matters.
  2651  (1991)              xmpopnm(0, admName(0:lenAdmName - 1), adminPort) =: returnStatus
  2652  (1992)              IF returnStatus >< XMOK THEN
  2653  (1993)                  OUTPUT(1, 'AL28', 'CHATSV: no command port, st=')
  2654  (1994)                  OUTPUT(1, 'I6', returnStatus)
  2655  (1995)                  OUTPUT(1, 'AL1', '$')
  2656  (1996)                  % NOT fatal. A server that will not start because nobody can
  2657  (1997)                  % ask it for STATUS is worse than one that runs unattended.
  2658  (1998)              ENDIF
  2659  (1999)  
  2660  (2000)              % Our own magic number, so an arrival can be tested against it.
  2661  (2001)              xmpfp2m(0, myPort, myMagic) =: returnStatus
  2662  (2002)              IF returnStatus >< XMOK THEN
  2663  (2003)                  OUTPUT(1, 'AL18', 'SV: p2m failed st=')
  2664  (2004)                  OUTPUT(1, 'I6', returnStatus)
  2665  (2005)                  OUTPUT(1, 'AL1', '$')
  2666  (2006)              ENDIF
  2667  (2007)  
  2668  (2008)              % ONE BANNER, AND IT STAYS. An operator has to be able to tell a
  2669  (2009)              % server that is waiting from one that never got its room, and the
  2670  (2010)              % port number is what LIST-PORTS is matched against when it does
  2671  (2011)              % not. It prints on the FIRST start only - this program is now
  2672  (2012)              % started again by every arrival, and a banner per message would
  2673  (2013)              % bury the machine.
  2674  (2014)              OUTPUT(1, 'AL24', 'CHATSV: room open, port ')
  2675  (2015)              OUTPUT(1, 'I6', myPort)
  2676  (2016)              OUTPUT(1, 'AL9', ' command ')
  2677  (2017)              OUTPUT(1, 'I6', adminPort)
  2678  (2018)              OUTPUT(1, 'AL1', '$')
  2679  (2019)              logLine('SV START room prt=', 18, myPort)
  2680  (2020)              logLine('SV START admin prt', 18, adminPort)
  2681  (2021)  
  2682  (2022)              TRUE =: portsOpen
  2683  (2023)          ENDIF
  2684  (2024)  
  2685  (2025)          DO
  2686  (2026)              % WAIT. XFWTF is what makes this block rather than spin; an RT
  2687  (2027)              % program that polls burns the machine for nothing. Without the
  2688  (2028)              % flag the status would come back MXNEXTM when nothing is waiting.
  2689  (2029)              % ---- DRAIN BOTH PORTS, THEN TERMINATE --------------------------
  2690  (2030)              %
  2691  (2031)              % The lobby first, because that is the busy one. If it is empty,
  2692  (2032)              % the command port. If BOTH are empty, both wake-ups are now armed
  2693  (2033)              % and there is nothing to do: RETURN, and the next transmission to
  2694  (2034)              % either port RT-starts this program again.
  2695  (2035)              %
  2696  (2036)              % HOW "EMPTY" IS TOLD FROM "GOT ONE", which is the whole hazard of
  2697  (2037)              % dropping XFWTF and is MEASURED rather than reasoned:
  2698  (2038)              %
  2699  (2039)              %   XMOK (0)        a SUCCESSFUL receive, with the type in the
  2700  (2040)              %                   msgType out-parameter. Vendor Appendix G tests
  2701  (2041)              %                   "IF RETURNSTATUS >< XMOK THEN bad status", and
  2702  (2042)              %                   D100 printed "SV: rcv st= 0 t= 2 len= 25".
  2703  (2043)              %   XMTNO..XMTPS    also a successful receive.
  2704  (2044)              %   XMXENTM (16896) an EMPTY port. Neither of the above.
  2705  (2045)              %
  2706  (2046)              % The manual's "a zero status is returned" for an empty port
  2707  (2047)              % describes the RAW MON call. XMPFRCV remaps it - the library's
  2708  (2048)              % empty answer is 16896, not 0 - so zero is unambiguous here. Had
  2709  (2049)              % that not been so, this loop could not have told an empty port
  2710  (2050)              % from a message and would have terminated on live traffic.
  2711  (2051)              FALSE =: fromAdmin
  2712  (2052)              xmpfrcv(waitFlags, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  2713  (2053)                  =: returnStatus
  2714  (2054)  
  2715  (2055)              IF returnStatus = XMXENTM THEN
  2716  (2056)                  TRUE =: fromAdmin
  2717  (2057)                  xmpfrcv(waitFlags, adminPort, msgType, remotePortHash, &
  2718  (2058)                      msgIdent, nBytes) =: returnStatus
  2719  (2059)  
  2720  (2060)                  IF returnStatus = XMXENTM THEN
  2721  (2061)                      % ---- BOTH EMPTY: SLEEP, DO NOT END ------------------
  2722  (2062)                      %
  2723  (2063)                      % THIS USED TO "RETURN", AND THAT WAS REFUTED ON THE
  2724  (2064)                      % MACHINE. MEASURED on D100 2026-08-20: @RT CHATSER ran,
  2725  (2065)                      % drained both empty ports, returned - and
  2726  (2066)                      % LIST-RT-DESCRIPTION then said PASSIVE with 0 CPU units
  2727  (2067)                      % while LIST-NAMES showed NEITHER CHAT-LOBBY NOR
  2728  (2068)                      % CHAT-ADMIN. SINTRAN CLOSES A TASK'S PORTS WHEN THE TASK
  2729  (2069)                      % TERMINATES, so the XFWAK wake-up had nothing left to
  2730  (2070)                      % arrive on and the server could never be restarted.
  2731  (2071)                      %
  2732  (2072)                      % The manual's wake-up mechanism is real, but it assumes a
  2733  (2073)                      % task that STAYS ALIVE to be woken. Both halves of that
  2734  (2074)                      % were already written down here and were not put together.
  2735  (2075)                      %
  2736  (2076)                      % So: sleep and go round. MON 267B suspends the program for
  2737  (2077)                      % a given time and continues after the call - no spin, no
  2738  (2078)                      % termination, ports stay open. Unit type 1 is basic time
  2739  (2079)                      % units of 1/50 second, so 50 is one second: long enough to
  2740  (2080)                      % cost nothing, short enough that an operator typing STATUS
  2741  (2081)                      % does not notice the wait.
  2742  (2082)                      %
  2743  (2083)                      % A BARE LOOP WITH NO SLEEP IS NOT AN OPTION. When XMSG
  2744  (2084)                      % died under this server the receive stopped blocking and
  2745  (2085)                      % this loop burned the machine until somebody pressed ESC.
  2746  (2086)                      50 =: sleepUnits
  2747  (2087)                      1 =: sleepKind
  2748  (2088)                      MONITOR_CALL('TimeOut', sleepUnits, sleepKind, sleepWhy)
  2749  (2089)                  ENDIF
  2750  (2090)              ENDIF
  2751  (2091)              % A RECEIVE IS A MESSAGE ONLY WHEN THE STATUS IS A MESSAGE TYPE.
  2752  (2092)              % Not "= XMOK" and not "> 0". The library remaps statuses: 0 is OK
  2753  (2093)              % for other calls but is NOT a message type, so comparing to it
  2754  (2094)              % here discards every message; and 16896 (XMXENTM, nothing there)
  2755  (2095)              % and every error are positive, so "> 0" accepts an empty port.
  2756  (2096)              % The constants file settles it - "Message types: Returned as
  2757  (2097)              % successfull status from XFRCV", XMTNO=1 through XMTPS=6.
  2758  (2098)              % PRINT THE STATUS OF EVERY RECEIVE, OUTSIDE THE TEST.
  2759  (2099)              %
  2760  (2100)              % This line is here because the test below threw the message away
  2761  (2101)              % and every diagnostic was INSIDE it, so the server looked as if it
  2762  (2102)              % had never woken at all. MEASURED 2026-08-18: CHAT-LOBBY went from
  2763  (2103)              % 8 free seats to 6 across two joins, which proves XROUT accepted
  2764  (2104)              % both letters and forwarded them here - "XROUT will decrement the
  2765  (2105)              % counter and forward the whole message to portName" - while this
  2766  (2106)              % program printed nothing and went straight back to waiting.
  2767  (2107)              %
  2768  (2108)              % A gate must never be the only thing that can tell you it closed.
  2769  (2109)              % This printed on EVERY receive during bring-up. It now prints only
  2770  (2110)              % when the receive is NOT one this server accepts - which is the case
  2771  (2111)              % the original comment was really about. A message that arrives and is
  2772  (2112)              % handled says so by what it does; a message thrown away by the test
  2773  (2113)              % below still has nothing else to speak for it.
  2774  (2114)              % ---- KNOW WHEN TO STOP -------------------------------------
  2775  (2115)              % MEASURED 2026-08-18, and it is why this block exists at all.
  2776  (2116)              % XMSG went down under a running server. XMPFRCV then stopped
  2777  (2117)              % blocking - there is nothing to wait ON - and returned 16933,
  2778  (2118)              % XMXENRU, "XMSG not running", instantly, for ever. This loop
  2779  (2119)              % printed that line as fast as the terminal could take it and
  2780  (2120)              % burned the machine until somebody pressed ESC.
  2781  (2121)              %
  2782  (2122)              % A WAIT THAT CANNOT WAIT IS A SPIN. The XFWTF flag is what makes
  2783  (2123)              % this loop cheap, and it quietly stops meaning anything the moment
  2784  (2124)              % the thing it waits on is gone. Any program built around a
  2785  (2125)              % blocking call needs an answer for that, and "print and go round
  2786  (2126)              % again" is not one.
  2787  (2127)              %
  2788  (2128)              % Two ways out, and they are different on purpose:
  2789  (2129)              %
  2790  (2130)              %   XMXENRU        STOP. Nothing this program can do brings XMSG
  2791  (2131)              %                  back - an operator has to restart it - so
  2792  (2132)              %                  retrying is not persistence, it is a busy loop
  2793  (2133)              %                  with no end. Say so plainly and leave.
  2794  (2134)              %
  2795  (2135)              %   anything else  RETRY, but not for ever. An unknown status may
  2796  (2136)              %                  well clear; the same one arriving maxBadRuns
  2797  (2137)              %                  times running has not cleared and will not.
  2798  (2138)              %
  2799  (2139)              % A GOOD RECEIVE CLEARS THE COUNT, so the limit is on a RUN of
  2800  (2140)              % failures rather than on failures for the life of the program. A
  2801  (2141)              % server that has been up for a week and sees twenty scattered odd
  2802  (2142)              % statuses is healthy; one that sees twenty in a row is not.
  2803  (2143)              IF returnStatus = XMOK OR &
  2804  (2144)                 (returnStatus >= XMTNO AND returnStatus <= XMTPS) THEN
  2805  (2145)                  0 =: badRuns
  2806  (2146)              ELSE
  2807  (2147)                  IF returnStatus >< XMXENTM THEN
  2808  (2148)                      badRuns + 1 =: badRuns
  2809  (2149)  
  2810  (2150)                      % Print the first few and then stop shouting. The whole
  2811  (2151)                      % fault above was a message repeated without limit, and a
  2812  (2152)                      % diagnostic that fills the screen hides the one line that
  2813  (2153)                      % matters.
  2814  (2154)                      IF badRuns <= maxNoisy THEN
  2815  (2155)                          OUTPUT(1, 'AL23', 'SV: receive refused st=')
  2816  (2156)                          OUTPUT(1, 'I6', returnStatus)
  2817  (2157)                          OUTPUT(1, 'AL1', '$')
  2818  (2158)                          logLine('SV rcv refused st=', 18, returnStatus)
  2819  (2159)                      ENDIF
  2820  (2160)  
  2821  (2161)                      IF returnStatus = XMXENRU THEN
  2822  (2162)                          OUTPUT(1, 'AL31', 'CHATSV: XMSG is not running - $')
  2823  (2163)                          OUTPUT(1, 'AL31', 'CHATSV: stopping, restart XMSG$')
  2824  (2164)                          RETURN
  2825  (2165)                      ENDIF
  2826  (2166)  
  2827  (2167)                      IF badRuns > maxBadRuns THEN
  2828  (2168)                          OUTPUT(1, 'AL30', 'CHATSV: too many bad receives$')
  2829  (2169)                          OUTPUT(1, 'I6', returnStatus)
  2830  (2170)                          OUTPUT(1, 'AL1', '$')
  2831  (2171)                          RETURN
  2832  (2172)                      ENDIF
  2833  (2173)                  ENDIF
  2834  (2174)              ENDIF
  2835  (2175)  
  2836  (2176)              % ACCEPT XMOK TOO - Appendix G's SERVER does exactly this.
  2837  (2177)              %
  2838  (2178)              % The old test was the range XMTNO..XMTPS alone, defended by a
  2839  (2179)              % comment claiming 0 "is NOT a message type, so comparing to it here
  2840  (2180)              % discards every message". The vendor sample says otherwise: after
  2841  (2181)              % XMPFRCV it tests "IF RETURNSTATUS >< XMOK THEN ... bad status" and
  2842  (2182)              % only THEN looks at the MSGTYPE out-parameter to check for XMROU.
  2843  (2183)              % So XMOK is a successful receive, and the message type belongs in
  2844  (2184)              % msgType, not in the status.
  2845  (2185)              %
  2846  (2186)              % Both forms are accepted here rather than one being swapped for the
  2847  (2187)              % other, because the print above will say which one actually turns up
  2848  (2188)              % and guessing is what put the range test here in the first place.
  2849  (2189)              IF returnStatus = XMOK OR &
  2850  (2190)                 (returnStatus >= XMTNO AND returnStatus <= XMTPS) THEN
  2851  (2191)                  % The FULL magic number of the sender - XMPFRCV hands back only
  2852  (2192)                  % a hashed port, and we must be able to answer.
  2853  (2193)                  % A "got t= len=" line printed here to separate "never woke"
  2854  (2194)                  % from "woke, replied, reply lost". It said to remove it once the
  2855  (2195)                  % join works, and the join works.
  2856  (2196)                  % THE RECEIVE'S OWN nBytes, KEPT BEFORE ANYTHING OVERWRITES IT.
  2857  (2197)                  % For an ordinary message it is the length; for a RETURNED one
  2858  (2198)                  % the guide says it is something else entirely - "If msgType is
  2859  (2199)                  % XMTRE, msgLengthOrStat contains the error status" - and
  2860  (2200)                  % xmpfmst below writes over it either way.
  2861  (2201)                  nBytes =: receiveStat
  2862  (2202)  
  2863  (2203)                  xmpfmst(0, msgIdent, msgType, senderMagic, nBytes) =: returnStatus
  2864  (2204)  
  2865  (2205)                  % CLAMP BEFORE READING. nBytes is the sender's message size,
  2866  (2206)                  % handed back by XMSG - not a size this program chose. Passing
  2867  (2207)                  % it straight in lets any peer that sends more than inBufSize
  2868  (2208)                  % bytes write past the end of inBuf. That is a WRITE overflow
  2869  (2209)                  % and it happens before a single field is parsed, so none of
  2870  (2210)                  % the careful field checks in handleMessage can save it.
  2871  (2211)                  nBytes =: readAmount
  2872  (2212)                  IF readAmount > inBufSize THEN
  2873  (2213)                      inBufSize =: readAmount
  2874  (2214)                  ENDIF
  2875  (2215)  
  2876  (2216)                  xmpfrea(0, 0, &
  2877  (2217)                      ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  2878  (2218)                      0, readAmount, readLength) =: returnStatus
  2879  (2219)  
  2880  (2220)                  xmpfrel(0, msgIdent) =: returnStatus
  2881  (2221)  
  2882  (2222)                  % A 48-BYTE RAW DUMP OF EVERY ARRIVAL STOOD HERE, and it is the
  2883  (2223)                  % single diagnostic that solved this program. It is worth saying
  2884  (2224)                  % what it did before it goes, because the lesson outlives it.
  2885  (2225)                  %
  2886  (2226)                  % It began at 8 bytes and printed nothing useful for the arrival
  2887  (2227)                  % that mattered. Widened to 48 it showed the join in full:
  2888  (2228)                  %
  2889  (2229)                  %   123  65  0 12 | 255 10 'CHAT-LOBBY' | 1 5 'RONNY' 0 0
  2890  (2230)                  %
  2891  (2231)                  % Byte 0 was 123 - the SERIAL NUMBER this program's own client
  2892  (2232)                  % hands to XMPBLET. So what arrives starts with the XSLET LETTER
  2893  (2233)                  % HEADER, and handleMessage had been reading that header as if it
  2894  (2234)                  % were a chat message all along. The header skip below is the fix,
  2895  (2235)                  % and the layout under it is read off those bytes.
  2896  (2236)                  %
  2897  (2237)                  % The general form: a dump of what actually arrived beat every
  2898  (2238)                  % re-reading of the code, and it beat the manual too - the manual
  2899  (2239)                  % was right and was being applied to the wrong offset.
  2900  (2240)  
  2901  (2241)                  % A "fromSelf YES/no" line printed here. It earned its place once:
  2902  (2242)                  % the answer came back YES, the server's own reply arriving
  2903  (2243)                  % straight back at this port, which no amount of reading the guide
  2904  (2244)                  % would have suggested. That is recorded rather than printed now.
  2905  (2245)                  % THE SENDER'S MAGIC NUMBER AND OUR OWN were printed side by side
  2906  (2246)                  % here, to answer one suspicion: the welcome was being sent with
  2907  (2247)                  % status 0 and never arriving, so was senderMagic - taken from
  2908  (2248)                  % XMPFMST on a letter that came via XROUT - an address we could
  2909  (2249)                  % actually send BACK to?
  2910  (2250)                  %
  2911  (2251)                  % IT WAS. The two numbers were consistent and the reply address
  2912  (2252)                  % was never the bug. What that ruled out is what sent the search
  2913  (2253)                  % to the CLIENT's receive test, where XMPFRCV was returning XMOK,
  2914  (2254)                  % a "1..6 only" test was rejecting it, and the welcome was being
  2915  (2255)                  % dequeued and dropped in silence.
  2916  (2256)                  %
  2917  (2257)                  % A diagnostic that clears a suspicion is worth as much as one
  2918  (2258)                  % that confirms it, and this one cost a push-and-compile round
  2919  (2259)                  % trip to add. That is why it is written down instead of deleted.
  2920  (2260)  
  2921  (2261)                  % ---- A LETTER ARRIVES WEARING ITS XROUT HEADER --------------
  2922  (2262)                  % XROUT forwards THE WHOLE MESSAGE, header included. So a letter
  2923  (2263)                  % that came via XROUT has the XSLET header in front of the chat
  2924  (2264)                  % message, and the chat message has to be found behind it.
  2925  (2265)                  %
  2926  (2266)                  % ND-60.164.3 EN COSMOS Programmer Guide, appendix B, "XROUT
  2927  (2267)                  % Message Format", states the layout - this is read from the
  2928  (2268)                  % manual, not inferred from one capture:
  2929  (2269)                  %
  2930  (2270)                  %   byte 0     serial number, echoed back unchanged by XROUT
  2931  (2271)                  %   byte 1     the service number (XSLET = 65); XROUT overwrites
  2932  (2272)                  %              it with the return status on a reply
  2933  (2273)                  %   bytes 2-3  LENGTH OF THE REMAINDER OF THE MESSAGE in bytes,
  2934  (2274)                  %              "followed by a sequence of parameter blocks"
  2935  (2275)                  %
  2936  (2276)                  % So the parameter blocks occupy exactly the bytes that length
  2937  (2277)                  % counts, and OUR data starts right after them:
  2938  (2278)                  %
  2939  (2279)                  %   payloadAt = 4 + the length word
  2940  (2280)                  %
  2941  (2281)                  % The manual is explicit that the user data is untouched: "The
  2942  (2282)                  % remainder of the message will not be looked at by XROUT ... thus
  2943  (2283)                  % the user data can be coded in any format legible to the
  2944  (2284)                  % receiving (server) task."
  2945  (2285)                  %
  2946  (2286)                  % MEASURED 2026-08-18, the 25-byte join, which agrees:
  2947  (2287)                  %   123  65  0 12 | 255 10 'CHAT-LOBBY' | 1 5 'RONNY' 0 0
  2948  (2288)                  %    ^serial ^len=12   ^param 1: string, 10 bytes  ^payload at 16
  2949  (2289)                  %
  2950  (2290)                  % DERIVED, NEVER HARD-CODED. 16 is only right for a ten-character
  2951  (2291)                  % room name; the parameter block moves with the name, and a
  2952  (2292)                  % constant here would break the moment /join names a longer room.
  2953  (2293)                  %
  2954  (2294)                  % The alternative reading - 6 + the name length - fits this one
  2955  (2295)                  % capture just as well and is WRONG in general: it cannot see a
  2956  (2296)                  % second parameter block, and XSLET has an optional third.
  2957  (2297)                  %
  2958  (2298)                  % The payload is slid down to offset 0 so that handleMessage
  2959  (2299)                  % parses one layout and one only. Every other route into it -
  2960  (2300)                  % an ordinary XMTNO message straight from a magic number - has no
  2961  (2301)                  % header at all, and this is the single place that knows that.
  2962  (2302)                  % ---- A MESSAGE OF OURS THAT COULD NOT BE DELIVERED ----------
  2963  (2303)                  % This is what XFSEC bought, and it has to be caught BEFORE
  2964  (2304)                  % handleMessage: the bytes in inBuf are our own outgoing Said or
  2965  (2305)                  % Joined coming home, so parsing them as an arrival would have
  2966  (2306)                  % the room answering itself.
  2967  (2307)                  %
  2968  (2308)                  % THE QUESTION THIS BRANCH WAS BUILT TO ANSWER, AND THE ANSWER.
  2969  (2309)                  %
  2970  (2310)                  % A returned message carries what WE wrote, and what we wrote
  2971  (2311)                  % names the SPEAKER, not the member it could not reach - so it
  2972  (2312)                  % was not obvious that anything here identifies the destination.
  2973  (2313)                  % XMPFMST hands back a magic number for an ordinary arrival; the
  2974  (2314)                  % guide never says what that field holds on a returned one.
  2975  (2315)                  %
  2976  (2316)                  % MEASURED 2026-08-18 on D100, and it IS the destination:
  2977  (2317)                  %
  2978  (2318)                  %   SV: returned msg, st=  16915
  2979  (2319)                  %   SV: it names slot          2
  2980  (2320)                  %   SV: reaped dead slot       2
  2981  (2321)                  %
  2982  (2322)                  % 16915 is XMXEIMA, "Invalid magic number" - the reason the
  2983  (2323)                  % message came home. Note where that code turned up: as the
  2984  (2324)                  % REASON ON A RETURN, not as the status of the send. The first
  2985  (2325)                  % attempt at this fix tested XMPSEND's own status for exactly
  2986  (2326)                  % that number and never fired, because XMPSEND answered XMOK and
  2987  (2327)                  % handed the message to a port that was already gone.
  2988  (2328)                  %
  2989  (2329)                  % The slot print stays. It costs nothing - a member has to die
  2990  (2330)                  % before it runs - and it separates "one of ours bounced" from
  2991  (2331)                  % "something bounced", which is the first thing an operator
  2992  (2332)                  % needs to know and the one thing the reap line cannot say.
  2993  (2333)                  IF msgType = XMTRE THEN
  2994  (2334)                      OUTPUT(1, 'AL22', 'SV: returned msg, st= ')
  2995  (2335)                      OUTPUT(1, 'I6', receiveStat)
  2996  (2336)                      OUTPUT(1, 'AL1', '$')
  2997  (2337)                      logLine('SV bounced msg st=', 18, receiveStat)
  2998  (2338)  
  2999  (2339)                      findByMagic(senderMagic) =: wasMember
  3000  (2340)                      OUTPUT(1, 'AL22', 'SV: it names slot     ')
  3001  (2341)                      OUTPUT(1, 'I6', wasMember)
  3002  (2342)                      OUTPUT(1, 'AL1', '$')
  3003  (2343)  
  3004  (2344)                      IF wasMember >< 0 THEN
  3005  (2345)                          1 =: memberDead(wasMember)
  3006  (2346)                          1 =: deadFound
  3007  (2347)                      ENDIF
  3008  (2348)                  ELSE
  3009  (2349)                  IF msgType = XMROU THEN
  3010  (2350)                      % THE SERVICE BYTE, TAKEN BEFORE ANYTHING MOVES. The payload
  3011  (2351)                      % is slid down to offset 0 below, so by the time the seat
  3012  (2352)                      % rule runs inBuf(1) is chat data, not the header. Reading
  3013  (2353)                      % it there is how the feedback loop went unnoticed in
  3014  (2354)                      % review - the test looked right and was inspecting the
  3015  (2355)                      % wrong bytes.
  3016  (2356)                      inBuf(1) =: letterService
  3017  (2357)  
  3018  (2358)                      4 + inBuf(2) * 256 + inBuf(3) =: payloadAt
  3019  (2359)  
  3020  (2360)                      % A letter with nothing behind the header is a connect this
  3021  (2361)                      % program has no answer for. Dropping it says so; the seat is
  3022  (2362)                      % already spent either way. Note this is >=, not >: a payload
  3023  (2363)                      % that starts exactly AT the end is an empty payload.
  3024  (2364)                      IF payloadAt >= readLength THEN
  3025  (2365)                          OUTPUT(1, 'AL24', 'SV: DROP empty letter   ')
  3026  (2366)                          OUTPUT(1, 'AL1', '$')
  3027  (2367)                      ELSE
  3028  (2368)                          % (the seat for this arrival is settled after
  3029  (2369)                          %  handleMessage, by the one rule below)
  3030  (2370)                          readLength - payloadAt =: readLength
  3031  (2371)                          FOR i IN 1:readLength DO
  3032  (2372)                              inBuf(payloadAt + i - 1) =: inBuf(i - 1)
  3033  (2373)                          ENDFOR
  3034  (2374)  
  3035  (2375)                          % ---- SEAT ACCOUNTING, and it belongs HERE ----------
  3036  (2376)                          % The seat is spent by the ARRIVAL of a routed message,
  3037  (2377)                          % not by any particular kind of message inside it. Doing
  3038  (2378)                          % it per kind is what the C# side got wrong: a letter
  3039  (2379)                          % carrying anything but a join, or a letter too damaged
  3040  (2380)                          % to decode at all, never reaches a handler - so no
  3041  (2381)                          % handler can give its seat back, and the room silently
  3042  (2382)                          % loses a seat for good.
  3043  (2383)                          %
  3044  (2384)                          % XROUT decremented its free-connection counter to get
  3045  (2385)                          % this letter here, so a seat is already spent by the
  3046  (2386)                          % time this line runs. There are now exactly two places
  3047  (2387)                          % that give one back, and between them they cover both
  3048  (2388)                          % ways a member can stop being one:
  3049  (2389)                          %
  3050  (2390)                          %   handleMessage, kLeave   they said goodbye;
  3051  (2391)                          %   reapDead                they did not, and a send to
  3052  (2392)                          %                           them came back saying the
  3053  (2393)                          %                           port is gone.
  3054  (2394)                          findByMagic(senderMagic) =: wasMember
  3055  (2395)  
  3056  (2396)                          handleMessage
  3057  (2397)                      ENDIF
  3058  (2398)  
  3059  (2399)                      % ---- THE SEAT BELONGS TO THE ARRIVAL, SO SETTLE IT HERE ----
  3060  (2400)                      % MEASURED 2026-08-18 by a load run: twenty C# clients joined
  3061  (2401)                      % at once and CHAT-LOBBY went from 16 free seats to 2 and
  3062  (2402)                      % stayed there, even though every welcomed member left again
  3063  (2403)                      % cleanly. Fourteen seats gone.
  3064  (2404)                      %
  3065  (2405)                      % The comment a few lines up has described this hole all
  3066  (2406)                      % along - "a letter carrying anything but a join, or a letter
  3067  (2407)                      % too damaged to decode at all, never reaches a handler - so
  3068  (2408)                      % no handler can give its seat back" - and named it as
  3069  (2409)                      % something the C# side got wrong. It was wrong HERE too. The
  3070  (2410)                      % code only ever returned a seat on a clean /leave or a reap,
  3071  (2411)                      % so an empty letter, a join refused because the name was
  3072  (2412)                      % taken, and a letter from a stranger each cost a seat for
  3073  (2413)                      % good. Under a burst that is most of them.
  3074  (2414)                      %
  3075  (2415)                      % ONE RULE, APPLIED TO EVERY LETTER: XROUT spent a seat to
  3076  (2416)                      % deliver this, so if the sender is not sitting in the room
  3077  (2417)                      % once we have finished with it, nobody is holding that seat
  3078  (2418)                      % and it must go straight back.
  3079  (2419)                      %
  3080  (2420)                      % This does NOT double-count with the /leave and reapDead
  3081  (2421)                      % paths. A leave arrives as an ORDINARY message, port to
  3082  (2422)                      % port, and never comes through this branch at all - only the
  3083  (2423)                      % JOIN is a letter. So each member's seat is returned exactly
  3084  (2424)                      % once, by whichever of the three applies.
  3085  (2425)                      %
  3086  (2426)                      % KNOWN GAP, said plainly rather than left to be discovered:
  3087  (2427)                      % a letter from somebody who IS already a member keeps its
  3088  (2428)                      % seat and should not. Clients send port to port after
  3089  (2429)                      % joining, so it does not arise in normal use, and guessing a
  3090  (2430)                      % fix for a case never seen would be worse than naming it.
  3091  (2431)                      % ---- ONLY A REAL LETTER SPENT A SEAT --------------------
  3092  (2432)                      % MEASURED, and it is the worst kind of bug: a FEEDBACK
  3093  (2433)                      % LOOP that this very block created. Four users joined and
  3094  (2434)                      % left, and CHAT-LOBBY went from 16 free seats to 3470 while
  3095  (2435)                      % the terminal filled with "DROP empty letter" for ever.
  3096  (2436)                      %
  3097  (2437)                      % Here is the loop. Returning a seat means sending XMPINFC
  3098  (2438)                      % to XROUT. XROUT ANSWERS, and its answer arrives back on
  3099  (2439)                      % this very port as a routed message with no chat payload -
  3100  (2440)                      % which the code above drops as an empty letter, and which
  3101  (2441)                      % this rule then read as "a letter whose sender is not a
  3102  (2442)                      % member", so it returned ANOTHER seat, which produced
  3103  (2443)                      % ANOTHER answer. The note at the foot of this file has
  3104  (2444)                      % warned since the first version that the XMPINFC reply
  3105  (2445)                      % "comes back later on our own port as an ordinary message"
  3106  (2446)                      % and that ignoring it was "safe by accident until somebody
  3107  (2447)                      % says so". It stopped being safe the moment this rule
  3108  (2448)                      % started acting on every routed arrival.
  3109  (2449)                      %
  3110  (2450)                      % THE DISCRIMINATOR IS BYTE 1. A client's letter carries the
  3111  (2451)                      % XSLET service number, 65. XROUT OVERWRITES that byte with
  3112  (2452)                      % a return status when it answers - the header comment in
  3113  (2453)                      % the receive loop says so, and it is the same test the C#
  3114  (2454)                      % load client uses to spot a refused letter. So a letter
  3115  (2455)                      % with 65 in byte 1 came from a client and spent a seat;
  3116  (2456)                      % anything else is XROUT talking to us and spent nothing.
  3117  (2457)                      IF letterService = XSLET THEN
  3118  (2458)                          findByMagic(senderMagic) =: nowMember
  3119  (2459)                          IF nowMember = 0 THEN
  3120  (2460)                              xmpinfc(0, myPort, 1, 0) =: returnStatus
  3121  (2461)                              IF returnStatus >< XMOK THEN
  3122  (2462)                                  OUTPUT(1, 'AL22', 'SV: seat return failed')
  3123  (2463)                                  OUTPUT(1, 'I6', returnStatus)
  3124  (2464)                                  OUTPUT(1, 'AL1', '$')
  3125  (2465)                                  logLine('SV seat back st=  ', 18, returnStatus)
  3126  (2466)                              ENDIF
  3127  (2467)                          ENDIF
  3128  (2468)                      ENDIF
  3129  (2469)                  ELSE
  3130  (2470)                      % No header on this path: an ordinary message sent straight
  3131  (2471)                      % to our magic number is exactly the bytes the peer wrote.
  3132  (2472)                      handleMessage
  3133  (2473)                  ENDIF
  3134  (2474)                  ENDIF
  3135  (2475)  
  3136  (2476)                  % ---- AND NOW BURY ANYBODY WHO TURNED OUT TO BE GONE ---------
  3137  (2477)                  % One place, after everything the arrival caused has finished,
  3138  (2478)                  % because that is the only depth at which outBuf is free. Both
  3139  (2479)                  % branches above lead here on purpose: a member can be found
  3140  (2480)                  % dead by any broadcast, and the routed and direct paths both
  3141  (2481)                  % broadcast.
  3142  (2482)                  IF deadFound >< 0 THEN
  3143  (2483)                      reapDead
  3144  (2484)                  ENDIF
  3145  (2485)  
  3146  (2486)                  % ---- AND STOP, IF AN OPERATOR ASKED ------------------------
  3147  (2487)                  % Here rather than where the AdminStop arrived, so the reply
  3148  (2488)                  % path and the reaping above finish first. A stop that abandons
  3149  (2489)                  % a half-sent message is not a clean stop.
  3150  (2490)                  %
  3151  (2491)                  % This RETURN is different from the one on an empty drain. That
  3152  (2492)                  % one goes to sleep and is woken by the next arrival; this one
  3153  (2493)                  % ends the program for good - the ports go with it and SINTRAN
  3154  (2494)                  % clears the names, measured 2026-08-18.
  3155  (2495)                  IF stopWanted THEN
  3156  (2496)                      OUTPUT(1, 'AL17', 'CHATSV: stopping$')
  3157  (2497)                      RETURN
  3158  (2498)                  ENDIF
  3159  (2499)              ENDIF
  3160  (2500)          ENDDO
  3161  (2501)      ENDROUTINE
  3162  (2502)  
  3163  (2503)  ENDMODULE
  3164  (2504)  
  3165  (2505)  % ---------------------------------------------------------------------------
  3166  (2506)  % STILL NOT DONE, and worth saying rather than leaving to be met:
  3167  (2507)  %
  3168  (2508)  %  1. THIS ITEM USED TO READ "Nothing has been compiled", and it is kept here
  3169  (2509)  %     in corrected form rather than deleted, because everything it worried about
  3170  (2510)  %     has now been settled by the compiler itself rather than by argument:
  3171  (2511)  %     INTEGER4, two-dimensional BYTES ARRAY, the implicit extra ARRAY keyword on
  3172  (2512)  %     a BYTES declaration, BOOLEAN := TRUE, and the XMMSGIDENTIFIER and
  3173  (2513)  %     XMUSERADDRESS names out of XMP-B02:IMPT. All of it compiles and runs.
  3174  (2514)  %
  3175  (2515)  %     The one thing the list did NOT anticipate is the one that cost the most:
  3176  (2516)  %     a letter arrives with its XSLET header still in front of it. No amount of
  3177  (2517)  %     checking declarations against a manual would have found that - only the
  3178  (2518)  %     raw dump did.
  3179  (2519)  %
  3180  (2520)  %  2. The seat returned on Leave uses XMPINFC(flags, portNumber, extraConn,
  3181  (2521)  %     serialNumber). Its reply comes back later on our own port as an ordinary
  3182  (2522)  %     message, which handleMessage will see and not understand. Decide what to
  3183  (2523)  %     do with it - ignoring an unknown kind is already the behaviour, so this
  3184  (2524)  %     is safe, but it is safe by accident until somebody says so.
  3185  (2525)  %
  3186  (2526)  %  3. Each reason string carries its length as a separate constant, because
  3187  (2527)  %     PLANC has no LENGTH routine and SIZE's meaning for a BYTES parameter is
  3188  (2528)  %     not established. A string and its number must be changed together.
  3189  (2529)  % ---------------------------------------------------------------------------
  3190  (2530)  