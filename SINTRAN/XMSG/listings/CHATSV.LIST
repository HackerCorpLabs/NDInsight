   142    (67)  CONSTANT XFDMM=37            % define max memory for a task
   143    (68)  CONSTANT XFALM=38            % allocate messages to a task
   144    (69)  CONSTANT XFFRM=39            % free allocated messages
   145    (70)  CONSTANT XFLMP=40            % list messages and ports
   146    (71)  CONSTANT XFRRE=41            % receive and read message 
   147    (72)  CONSTANT XFCPV=42            % check system and/or user privileges
   148    (73)  CONSTANT X5FUN=43            % == END MARKER == LEAVE ME HERE PLEASE
