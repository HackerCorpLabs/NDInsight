   702    (42)  
   703    (43)      % MON1 IS INBIT - read one byte from a device. The PLANC runtime carries it
   704    (44)      % as a MONn routine, but it still has to be DECLARED here or the compiler
   705    (45)      % answers ILLEGAL SYNTAX at the call site. Same declaration CHAT.PLNC uses.
   706    (46)      IMPORT ( ROUTINE VOID, BYTE (INTEGER) : MON1 )
   707    (47)  
   708    (48)      INTEGER ARRAY : stack(0:600)
   709    (49)  
   710    (50)      % ---------------------------------------------------------------
   711    (51)      % The message kinds. These MUST match DOC/protocols/chat-wire.json
   712    (52)      % and ChatMessageKind.cs - all three move in the same commit, which
   713    (53)      % is constraint 5 of the federation design.
   714    (54)      %
   715    (55)      % 32 and up are ADMIN and belong on the command port. They share the
   716    (56)      % room's numbering on purpose: a second vocabulary would mean a
   717    (57)      % second decoder bound, and that bound has already been left behind
   718    (58)      % twice, silently both times.
   719    (59)      % ---------------------------------------------------------------
   720    (60)      INTEGER : kAdmStat := 32
   721    (61)      INTEGER : kAdmRepl := 33
   722    (62)      INTEGER : kAdmStop := 34
   723    (63)  
   724    (64)      % Trunk configuration. All three are answered with kAdmRepl, the same kind
   725    (65)      % STATUS uses, so showAnswer needs no new decoding - which is why three new
   726    (66)      % verbs cost no change to the wire format. These MUST match CHATSV.PLNC and
   727    (67)      % DOC/protocols/chat-wire.json; all three move in the same commit.
   728    (68)      INTEGER : kAdmTrunk  := 35
   729    (69)      INTEGER : kAdmUntrnk := 36
   730    (70)      INTEGER : kAdmTrunks := 37
   731    (71)  
   732    (72)      % INITIALIZE <room> <n> - how many messages a room remembers. Answered with
   733    (73)      % kAdmRepl like the rest, so it too costs no wire change.
   734    (74)      INTEGER : kAdmInit   := 38
   735    (75)  
   736    (76)      % SET-NAME <name> - what this machine calls itself.
   737    (77)      INTEGER : kAdmName   := 39
   738    (78)  
   739    (79)      % LOCK-TRUNKS / UNLOCK-TRUNKS - may the server learn a machine nobody
   740    (80)      % configured? Open is the default and always has been; locking is how an
   741    (81)      % operator says these are the machines, once the lab is up.
   742    (82)      INTEGER : kAdmLock   := 40
   743    (83)      INTEGER : kAdmOpen   := 41
   744    (84)  
   745    (85)      % DROP-MEMBER <name> - free a seat on the server and tell nobody.
   746    (86)      % A TEST VERB, and the server's own declaration of kAdmDrop says why:
   747    (87)      % it is the only way to create the machine-disagreement that kTrkDBad
   748    (88)      % answers, because every ordinary way of leaving keeps both ends in step.
   749    (89)      INTEGER : kAdmDrop   := 42
   750    (90)  
   751    (91)      % The server's command port, by name. XROUT turns this into an
   752    (92)      % address; nothing here knows or wants the number.
   753    (93)      BYTES : admName := 'CHAT-ADMIN'
   754    (94)      INTEGER : lenAdmName := 10
   755    (95)  
   756    (96)      % Who is asking. Carried in the nickname field so the server's log can
   757    (97)      % say who stopped it - an unattributed STOP is not worth much.
   758    (98)      BYTES : operName := 'OPER'
   759    (99)      INTEGER : lenOperName := 4
   760   (100)  
   761   (101)      INTEGER : myPort
   762   (102)      INTEGER : returnStatus
   763   (103)      % THE SYSTEM NAME IS BYTES, NOT AN INTEGER, and an EMPTY one means the LOCAL
   764   (104)      % system - which is what we want, since CHAT-ADMIN is on this machine.
   765   (105)      % Declaring it INTEGER drew
   766   (106)      %   *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
   767   (107)      % on the CALL rather than on the declaration, which sends you looking at the
   768   (108)      % arguments you changed instead of the one you copied wrong. CHAT.PLNC has
   769   (109)      % the same declaration. Measured on D100, 2026-08-20.
   770   (110)      BYTES : hereSystem := ''
   771   (111)      INTEGER : offSet
   772   (112)      INTEGER : uLength
   773   (113)      INTEGER : wLength
   774   (114)      INTEGER : length
   775   (115)      INTEGER : msgType
   776   (116)      INTEGER : remotePortHash
   777   (117)      INTEGER : nBytes
   778   (118)      INTEGER : waitFlags
   779   (119)      INTEGER : replyKind
   780   (120)      INTEGER : replyTextLen
   781   (121)      INTEGER : replyNameLen
   782   (122)      BOOLEAN : leaving
   783   (123)  
   784   (124)      % The command words. Held as BYTES so isVerb can compare byte by byte.
   785   (125)      BYTES : vExit       := 'EXIT'
   786   (126)      BYTES : vHelp       := '?'
   787   (127)      BYTES : vHelpWord   := 'HELP'
   788   (128)      BYTES : vStatus     := 'STATUS'
   789   (129)      BYTES : vStop       := 'STOP'
   790   (130)      BYTES : vStart      := 'START'
   791   (131)      BYTES : vRestart    := 'RESTART'
   792   (132)      BYTES : vStartTrunk := 'START-TRUNK'
   793   (133)      BYTES : vStopTrunk  := 'STOP-TRUNK'
   794   (134)      BYTES : vRestTrunk  := 'RESTART-TRUNK'
   795   (135)      BYTES : vListTrunks := 'LIST-TRUNKS'
   796   (136)      BYTES : vInit       := 'INITIALIZE'
   797   (137)      BYTES : vSetName    := 'SET-NAME'
   798   (138)      BYTES : vLockTrunks := 'LOCK-TRUNKS'
   799   (139)      BYTES : vUnlockTrk  := 'UNLOCK-TRUNKS'
   800   (140)      BYTES : vDropMbr    := 'DROP-MEMBER'
   801   (141)      INTEGER : i
   802   (142)  
   803   (143)      % ONE NUMBER PER COMMAND. The matcher below finds WHICH command was typed
   804   (144)      % before deciding what to do about it, so dispatch is a plain choice on a
   805   (145)      % number rather than a ladder of tests whose ORDER carries meaning. That
   806   (146)      % ordering was a standing trap: LIST-TRUNKS, RESTART-TRUNK and START-TRUNK
   807   (147)      % all had to be tested before the shorter words they begin with, and every
   808   (148)      % new verb had to be inserted in exactly the right place or it was
   809   (149)      % swallowed. With a match count the order no longer matters at all.
   810   (150)      INTEGER : cNone        := 0
   811   (151)      INTEGER : cExit        := 1
   812   (152)      INTEGER : cHelp        := 2
   813   (153)      INTEGER : cStatus      := 3
   814   (154)      INTEGER : cStop        := 4
   815   (155)      INTEGER : cStart       := 5
   816   (156)      INTEGER : cRestart     := 6
   817   (157)      INTEGER : cStartTrunk  := 7
   818   (158)      INTEGER : cStopTrunk   := 8
   819   (159)      INTEGER : cRestTrunk   := 9
   820   (160)      INTEGER : cListTrunks  := 10
   821   (161)      INTEGER : cInit        := 11
   822   (162)      INTEGER : cSetName     := 12
   823   (163)      INTEGER : cLockTrunks  := 13
   824   (164)      INTEGER : cUnlockTrk   := 14
   825   (165)      INTEGER : cDropMbr     := 15
   826   (166)  
   827   (167)      % The RT program that IS the chat server. This is the PROGRAM unit's name
   828   (168)      % from CHATSV.PLNC - "PROGRAM : chatServer" - not the file name, and it is
   829   (169)      % what CHANGE-RT-DESCRIPTION and @RT CHATSER both use.
   830   (170)      BYTES : rtProgName := 'CHATSER'
   831   (171)      INTEGER : rtAddr
   832   (172)  
   833   (173)      INTEGER : cmdId          % which command matched, when exactly one did
   834   (174)      INTEGER : cmdCount       % how many matched - 0 unknown, >1 ambiguous
   835   (175)      INTEGER : cmdWordLen     % length of the typed word, up to the first space
   836   (176)      INTEGER : hyphenCh := 45 % '-', the separator inside a compound command
   837   (177)      INTEGER : spaceCh  := 32
   838   (178)      INTEGER : questCh  := 63 % '?'
   839   (179)  
   840   (180)      % Only the PROGRAM's line reader uses these. buildAdmin and showAnswer
   841   (181)      % keep their OWN cursors as locals - a shared cursor across routines is a
   842   (182)      % latent bug waiting for the day the call order changes.
   843   (183)      INTEGER : at
   844   (184)      INTEGER : ch
   845   (185)      INTEGER : maxLine := 80
   846   (186)      BOOLEAN : lineReady
   847   (187)      BYTE : rawCh
   848   (188)  
   849   (189)      % Terminal reading. Same values and same reasons as the client's reader.
   850   (190)      INTEGER : ownTerminal := 1        % device number of your own terminal
   851   (191)      INTEGER : parityMask  := 127      % strip the even-parity bit, see below
   852   (192)      INTEGER : carriageRet := 13
   853   (193)      INTEGER : emptyInput  := 3        % InByte in no-wait: nothing was typed
   854   (194)  
   855   (195)      BYTES : letterBuf(0:63)
   856   (196)      BYTES : outBuf(0:255)
   857   (197)      BYTES : inBuf(0:511)
   858   (198)      BYTES : lineBuf(0:79)
   859   (199)      % AN INITIALISER IS WHAT GIVES A BYTES ITS LENGTH. Declared bare, the
   860   (200)      % compiler answers "ARRAY BOUNDS MISSING" and then, further down, warns the
   861   (201)      % name was never declared - two diagnostics from one omission. CHATSV's
   862   (202)      % spaceByte is the same idiom.
   863   (203)      BYTES : oneByte := ' '
   864   (204)  
   865   (205)      % THE LINE BREAK INSIDE A REPLY. The server separates the elements of a
   866   (206)      % listing with LF because the whole answer travels as ONE kAdmRepl message;
   867   (207)      % showAnswer turns each one into a CRLF. Must match lineBreak in
   868   (208)      % CHATSV.PLNC - the two move together.
   869   (209)      INTEGER : lineBreak := 10
   870   (210)  
   871   (211)      % -----------------------------------------------------------------------
   872   (212)      % Print a status number beside the call that produced it. A bare number
   873   (213)      % with no name attached is what makes an XMSG failure take an hour.
   874   (214)      % -----------------------------------------------------------------------
   875   (215)      ROUTINE VOID, VOID (BYTES, INTEGER) : showStatus(what, status)
   876   (216)          OUTPUT(1, 'AL', what)
   877   (217)          OUTPUT(1, 'AL6', ' st = ')
   878   (218)          OUTPUT(1, 'I6', status)
   879   (219)          OUTPUT(1, 'AL1', '$')
   880   (220)      ENDROUTINE
   881   (221)  
   882   (222)      % -----------------------------------------------------------------------
   883   (223)      % Build one admin message into outBuf.
   884   (224)      %
   885   (225)      % The format is the room's own, unchanged: kind, then a one-byte name
   886   (226)      % length and that many bytes of name, then a TWO-byte big-endian text
   887   (227)      % length and that many bytes of text. Admin messages cost no wire change
   888   (228)      % precisely because they need no new fields - a request carries empty
   889   (229)      % text, and the answer puts readable text where a Said would put what
   890   (230)      % somebody said.
   891   (231)      % -----------------------------------------------------------------------
   892   (232)      ROUTINE VOID, INTEGER (INTEGER) : buildAdmin(kind)
   893   (233)          INTEGER : n
   894   (234)          INTEGER : p
   895   (235)          kind =: outBuf(0)
   896   (236)          lenOperName =: outBuf(1)
   897   (237)          FOR n IN 0:lenOperName - 1 DO
   898   (238)              operName(n) =: outBuf(2 + n)
   899   (239)          ENDFOR
   900   (240)          2 + lenOperName =: p
   901   (241)          % Text length, high byte then low. Always zero on a request.
   902   (242)          0 =: outBuf(p)
   903   (243)          0 =: outBuf(p + 1)
   904   (244)          p + 2 RETURN
   905   (245)      ENDROUTINE
   906   (246)  
   907   (247)      % -----------------------------------------------------------------------
   908   (248)      % Send one admin message to CHAT-ADMIN, addressed BY NAME through XROUT.
   909   (249)      %
   910   (250)      % By name rather than by address because nothing here knows the server's
   911   (251)      % port number, and the whole point of a registered name is that it does
   912   (252)      % not have to. This is the same letter mechanism the client uses to join,
   913   (253)      % against a NORMAL named port rather than a connection port - which is
   914   (254)      % what keeps it from spending a seat.
   915   (255)      % -----------------------------------------------------------------------
   916   (256)      ROUTINE VOID, VOID (INTEGER) : sendAdmin(kind)
   917   (257)          XMMSGIDENTIFIER : msgIdent
   918   (258)  
   919   (259)          % XMPBLET takes the port name as BYTES and appends it as parameter 1
   920   (260)          % of the letter. A PLANC BYTES argument carries its own length, so
   921   (261)          % handing over the whole declared array would ask XROUT for a name
   922   (262)          % with the leftovers on the end. The subarray is exactly the name.
   923   (263)          % NO SUBARRAY HERE, and that is the difference from the client's join.
   924   (264)          %
   925   (265)          % CHAT.PLNC declares roomName with explicit bounds (0:20) and fills it at
   926   (266)          % runtime, so it MUST hand XMPBLET a subarray or the letter would carry
   927   (267)          % eleven bytes of leftovers. admName is declared with an INITIALISER, so
   928   (268)          % its implicit length is already exactly 'CHAT-ADMIN' and the whole array
   929   (269)          % is the name. Writing admName(0:lenAdmName - 1) anyway drew
   930   (270)          %   830 (170)/SENDADMIN *** ERROR - ILLEGAL DATA TYPE "XMPBLET"
   931   (271)          % - a variable subarray of a literal-initialised BYTES is not something
   932   (272)          % this compiler will take. Measured on D100, 2026-08-20.
   933   (273)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, admName) =: returnStatus
   934   (274)          IF returnStatus >< XMOK THEN
   935   (275)              % THIS IS THE NAME LOOKUP, and it is the failure an operator will
   936   (276)              % meet most often by a long way: CHAT-ADMIN is not registered
   937   (277)              % because nothing is running to register it. The status number
   938   (278)              % stays - it is what a second pair of eyes needs - but a number on
   939   (279)              % its own is not an answer to somebody who just wants the server
   940   (280)              % up, so say the likely cause and the command that fixes it.
   941   (281)              showStatus('xmpblet', returnStatus)
   942   (282)              OUTPUT(1, 'AL44', 'the chat server does not answer - try START$')
   943   (283)              RETURN
   944   (284)          ENDIF
   945   (285)  
   946   (286)          xmpfget(0, 200, msgIdent) =: returnStatus
   947   (287)          IF returnStatus >< XMOK THEN
   948   (288)              showStatus('xmpfget', returnStatus)
   949   (289)              RETURN
   950   (290)          ENDIF
   951   (291)  
   952   (292)          % The letter header first...
   953   (293)          offSet =: uLength
   954   (294)          xmpfwri(0, 0, &
   955   (295)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
   956   (296)              0, uLength, wLength) =: returnStatus
   957   (297)  
   958   (298)          % ...then our own message after it. XROUT reads only the header and
   959   (299)          % forwards the rest untouched, so this is where the command rides.
   960   (300)          buildAdmin(kind) =: length
   961   (301)          xmpfwri(0, wLength, &
   962   (302)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
   963   (303)              0, length, offSet) =: returnStatus
   964   (304)  
   965   (305)          xmprout(0, msgIdent, myPort) =: returnStatus
   966   (306)          IF returnStatus >< XMOK THEN
   967   (307)              showStatus('xmprout', returnStatus)
   968   (308)          ENDIF
   969   (309)      ENDROUTINE
   970   (310)  
   971   (311)      % -----------------------------------------------------------------------
   972   (312)      % The same message, but carrying WHAT THE OPERATOR TYPED AFTER THE VERB.
   973   (313)      %
   974   (314)      % START-TRUNK and STOP-TRUNK need a system number, and the argument is
   975   (315)      % simply the rest of the typed line: everything after the verb and the one
   976   (316)      % space behind it. It is sent as TEXT and the server parses it - this end
   977   (317)      % does not need to know that a trunk is named by a number, only that the
   978   (318)      % verb takes an argument.
   979   (319)      %
   980   (320)      % A MISSING ARGUMENT IS SENT AS AN EMPTY TEXT rather than refused here. The
   981   (321)      % server already has to handle a peer sending nonsense, so it owns the
   982   (322)      % complaint, and there is then ONE place that decides what a valid trunk
   983   (323)      % argument is instead of two that can disagree.
   984   (324)      % -----------------------------------------------------------------------
   985   (325)      ROUTINE VOID, INTEGER (INTEGER) : bldArgMsg(kind)
   986   (326)          INTEGER : n, p, argAt, argLen
   987   (327)  
   988   (328)          kind =: outBuf(0)
   989   (329)          lenOperName =: outBuf(1)
   990   (330)          FOR n IN 0:lenOperName - 1 DO
   991   (331)              operName(n) =: outBuf(2 + n)
   992   (332)          ENDFOR
   993   (333)          2 + lenOperName =: p
   994   (334)  
   995   (335)          % cmdWordLen is the verb; one space follows it; the rest is the
   996   (336)          % argument. "at" is how much was typed altogether.
   997   (337)          cmdWordLen + 1 =: argAt
   998   (338)          at - argAt =: argLen
   999   (339)          IF argLen < 0 THEN
  1000   (340)              0 =: argLen
  1001   (341)          ENDIF
  1002   (342)  
  1003   (343)          0 =: outBuf(p)                        % text length, high byte
  1004   (344)          argLen =: outBuf(p + 1)               % low byte - a typed line is short
  1005   (345)          p + 2 =: p
  1006   (346)          FOR n IN 1:argLen DO
  1007   (347)              lineBuf(argAt + n - 1) =: outBuf(p)
  1008   (348)              p + 1 =: p
  1009   (349)          ENDFOR
  1010   (350)          p RETURN
  1011   (351)      ENDROUTINE
  1012   (352)  
  1013   (353)      % -----------------------------------------------------------------------
  1014   (354)      % Send an admin message that carries the typed argument.
  1015   (355)      %
  1016   (356)      % Identical to sendAdmin except for which builder it calls. Kept as its own
  1017   (357)      % routine rather than adding a flag to sendAdmin, because the two differ in
  1018   (358)      % exactly one line and a flag would put a branch in the middle of the letter
  1019   (359)      % sequence that is worth keeping straight.
  1020   (360)      % -----------------------------------------------------------------------
  1021   (361)      ROUTINE VOID, VOID (INTEGER) : sndArgMsg(kind)
  1022   (362)          XMMSGIDENTIFIER : msgIdent
  1023   (363)  
  1024   (364)          xmpblet(letterBuf, 64, offSet, 123, hereSystem, admName) =: returnStatus
  1025   (365)          IF returnStatus >< XMOK THEN
  1026   (366)              showStatus('xmpblet', returnStatus)
  1027   (367)              OUTPUT(1, 'AL44', 'the chat server does not answer - try START$')
  1028   (368)              RETURN
  1029   (369)          ENDIF
  1030   (370)  
  1031   (371)          xmpfget(0, 200, msgIdent) =: returnStatus
  1032   (372)          IF returnStatus >< XMOK THEN
  1033   (373)              showStatus('xmpfget', returnStatus)
  1034   (374)              RETURN
  1035   (375)          ENDIF
  1036   (376)  
  1037   (377)          offSet =: uLength
  1038   (378)          xmpfwri(0, 0, &
  1039   (379)              ADDR(letterBuf(0)) FORCE XMUSERADDRESS, &
  1040   (380)              0, uLength, wLength) =: returnStatus
  1041   (381)  
  1042   (382)          bldArgMsg(kind) =: length
  1043   (383)          xmpfwri(0, wLength, &
  1044   (384)              ADDR(outBuf(0)) FORCE XMUSERADDRESS, &
  1045   (385)              0, length, offSet) =: returnStatus
  1046   (386)  
  1047   (387)          xmprout(0, msgIdent, myPort) =: returnStatus
  1048   (388)          IF returnStatus >< XMOK THEN
  1049   (389)              showStatus('xmprout', returnStatus)
  1050   (390)          ENDIF
  1051   (391)      ENDROUTINE
  1052   (392)  
  1053   (393)      % -----------------------------------------------------------------------
  1054   (394)      % Wait for the server's answer and print it.
  1055   (395)      %
  1056   (396)      % BLOCKING on purpose - XFWTF. This program has nothing else to do and a
  1057   (397)      % poll would burn the machine for nothing. It is also the one place where
  1058   (398)      % blocking is safe: unlike the server, CHATMON holds exactly one port.
  1059   (399)      % -----------------------------------------------------------------------
  1060   (400)      ROUTINE VOID, VOID : showAnswer
  1061   (401)          XMMSGIDENTIFIER : msgIdent
  1062   (402)          INTEGER : p
  1063   (403)  
  1064   (404)          xmpfrcv(waitFlags, myPort, msgType, remotePortHash, msgIdent, nBytes) &
  1065   (405)              =: returnStatus
  1066   (406)  
  1067   (407)          % A RECEIVE IS A MESSAGE ONLY WHEN THE STATUS IS A MESSAGE TYPE.
  1068   (408)          % Not "= XMOK" and not "> 0": zero is OK for other calls but is not a
  1069   (409)          % message type, and every error is positive too, so "> 0" would accept
  1070   (410)          % an empty port. XMTNO=1 through XMTPS=6 are the message types.
  1071   (411)          % XMOK IS A SUCCESSFUL RECEIVE, AND THIS TEST MUST ACCEPT ZERO.
  1072   (412)          %
  1073   (413)          % MEASURED on D100 2026-08-20: this printed "xmpfrcv st = 0" and threw
  1074   (414)          % the message away. Zero is XMOK, the type lives in the msgType
  1075   (415)          % out-parameter, and the vendor's Appendix G sample tests
  1076   (416)          % "IF RETURNSTATUS >< XMOK THEN bad status" before looking at the type.
  1077   (417)          %
  1078   (418)          % This is the SAME defect CHAT.PLNC's header records at length - it ate
  1079   (419)          % the welcome there and cost a day. Writing "1..6 only" a second time,
  1080   (420)          % in a new program, with the warning already written down, is exactly
  1081   (421)          % the trap that comment exists to prevent.
  1082   (422)          %
  1083   (423)          % An EMPTY port answers XMXENTM (16896), which is neither XMOK nor 1..6
  1084   (424)          % and is still correctly rejected here.
  1085   (425)          IF returnStatus >< XMOK AND &
  1086   (426)             (returnStatus < XMTNO OR returnStatus > XMTPS) THEN
  1087   (427)              showStatus('xmpfrcv', returnStatus)
  1088   (428)              RETURN
  1089   (429)          ENDIF
  1090   (430)  
  1091   (431)          xmpfrea(0, 0, &
  1092   (432)              ADDR(inBuf(0)) FORCE XMUSERADDRESS, &
  1093   (433)              0, nBytes, length) =: returnStatus
  1094   (434)          IF returnStatus >< XMOK THEN
  1095   (435)              showStatus('xmpfrea', returnStatus)
  1096   (436)              RETURN
  1097   (437)          ENDIF
  1098   (438)  
  1099   (439)          inBuf(0) =: replyKind
  1100   (440)          IF replyKind >< kAdmRepl THEN
  1101   (441)              OUTPUT(1, 'AL17', 'unexpected kind $')
  1102   (442)              RETURN
  1103   (443)          ENDIF
  1104   (444)  
  1105   (445)          % Walk it. The name is variable-length, so the text length cannot be
  1106   (446)          % read from a fixed offset - this format must be WALKED, not indexed.
  1107   (447)          inBuf(1) =: replyNameLen
  1108   (448)          2 + replyNameLen =: p
  1109   (449)          inBuf(p) * 256 + inBuf(p + 1) =: replyTextLen
  1110   (450)          p + 2 =: p
  1111   (451)  
  1112   (452)          % NO "CHAT-MON:" IN FRONT OF THE ANSWER. The prompt already says C-M:,
  1113   (453)          % so every reply repeating the program's own name was noise stacked on
  1114   (454)          % top of the one line the operator actually asked for.
  1115   (455)          FOR i IN 0:replyTextLen - 1 DO
  1116   (456)              % AN LF IN THE TEXT IS A LINE BREAK, not a character to print.
  1117   (457)              %
  1118   (458)              % A listing - LIST-TRUNKS and anything else the server answers with
  1119   (459)              % kAdmRepl - arrives as ONE message with its elements separated by
  1120   (460)              % LF, because there is no second kind and no room in the format for
  1121   (461)              % one. Turning it into a CRLF here is what puts one element per
  1122   (462)              % line, and it does so for EVERY listing at once rather than only
  1123   (463)              % the one that was reported.
  1124   (464)              %
  1125   (465)              % Printing the byte instead would send a bare LF to the terminal,
  1126   (466)              % which drops a line without returning the carriage and leaves the
  1127   (467)              % next line marching to the right.
  1128   (468)              IF inBuf(p + i) = lineBreak THEN
  1129   (469)                  OUTPUT(1, 'AL1', '$')
  1130   (470)              ELSE
  1131   (471)                  % One byte at a time through a one-element BYTES. A string
  1132   (472)                  % literal cannot be stored into a BYTES element, and 'ALn'
  1133   (473)                  % formats a STRING - handing it a byte prints the byte's NUMBER.
  1134   (474)                  inBuf(p + i) =: oneByte
  1135   (475)                  OUTPUT(1, 'AL1', oneByte)
  1136   (476)              ENDIF
  1137   (477)          ENDFOR
  1138   (478)          OUTPUT(1, 'AL1', '$')
  1139   (479)      ENDROUTINE
  1140   (480)  
  1141   (481)      % -----------------------------------------------------------------------
  1142   (482)      % Read one command line from the terminal into lineBuf, length in at.
  1143   (483)      %
  1144   (484)      % PARITY. Terminal input carries an even-parity bit in bit 7, so carriage
  1145   (485)      % return arrives as 141, NOT 13. Compare without masking and this never
  1146   (486)      % sees the user press return and looks HUNG rather than wrong.
  1147   (487)      %
  1148   (488)      % MON1 CAN RAISE A ROUTINEERROR and it must be caught - an unhandled one
  1149   (489)      % takes the program down instead of ending the line.
  1150   (490)      % -----------------------------------------------------------------------
  1151   (491)      ROUTINE VOID, VOID : readLine
  1152   (492)          0 =: at
  1153   (493)          FALSE =: lineReady
  1154   (494)          DO
  1155   (495)              0 =: ch
  1156   (496)              ON ROUTINEERROR DO
  1157   (497)                  IF ErrCode >< emptyInput THEN
  1158   (498)                      OUTPUT(1, 'AL12', 'read failed$')
  1159   (499)                  ENDIF
  1160   (500)                  0 =: rawCh
  1161   (501)              ENDON
  1162   (502)              MON1(ownTerminal) =: rawCh
  1163   (503)              rawCh =: ch
  1164   (504)              ch AND parityMask =: ch
  1165   (505)  
  1166   (506)              IF ch = carriageRet THEN
  1167   (507)                  TRUE =: lineReady
  1168   (508)  
  1169   (509)                  % A CARRIAGE RETURN IS NOT A NEW LINE ON THIS TERMINAL. It puts
  1170   (510)                  % the cursor back at column ONE of the line just typed, and
  1171   (511)                  % nothing moves it down. So every answer this program printed
  1172   (512)                  % landed ON TOP of the command that asked for it - "CHAT-MON:
  1173   (513)                  % stop sent" written straight over "STOP" - and the screen read
  1174   (514)                  % like the program had mangled the input. It had not; it simply
  1175   (515)                  % never ended the line. One end-of-line here, the moment the
  1176   (516)                  % user presses return, and the answer starts on a line of its
  1177   (517)                  % own.
  1178   (518)                  OUTPUT(1, 'AL1', '$')
  1179   (519)              ENDIF
  1180   (520)  
  1181   (521)              % Leave the moment the keyboard runs dry or the line is finished.
  1182   (522)              % Going round again on an empty buffer is a spin, not a poll.
  1183   (523)              WHILE ch >< 0 AND NOT lineReady
  1184   (524)  
  1185   (525)              IF ch > 31 THEN
  1186   (526)                  % PLANC checks no array bound, so this test is the only thing
  1187   (527)                  % between a held-down key and the variables laid out after it.
  1188   (528)                  IF at < maxLine THEN
  1189   (529)                      ch =: lineBuf(at)
  1190   (530)                      at + 1 =: at
  1191   (531)                  ENDIF
  1192   (532)              ENDIF
  1193   (533)          ENDDO
  1194   (534)      ENDROUTINE
  1195   (535)  
  1196   (536)      % -----------------------------------------------------------------------
  1197   (537)      % Print the command list. Reached by ? the way X-C does it.
  1198   (538)      % -----------------------------------------------------------------------
  1199   (539)      ROUTINE VOID, VOID : showHelp
  1200   (540)          OUTPUT(1, 'AL19', 'CHAT-MON commands:$')
  1201   (541)          OUTPUT(1, 'AL38', '  STATUS                how it stands$')
  1202   (542)          OUTPUT(1, 'AL40', '  STOP                  stop the server$')
  1203   (543)          OUTPUT(1, 'AL29', '  ? or HELP             this$')
  1204   (544)          OUTPUT(1, 'AL30', '  EXIT                  leave$')
  1205   (545)          OUTPUT(1, 'AL40', '  START                 use @RT CHATSER$')
  1206   (546)          OUTPUT(1, 'AL38', '  RESTART               stops it only$')
  1207   (547)          OUTPUT(1, 'AL40', '  START-TRUNK <sys>     trunk to a peer$')
  1208   (548)          OUTPUT(1, 'AL41', '  STOP-TRUNK <sys>      forget that peer$')
  1209   (549)          OUTPUT(1, 'AL43', '  RESTART-TRUNK <sys>   stop then start it$')
  1210   (550)          OUTPUT(1, 'AL41', '  LIST-TRUNKS           peers and states$')
  1211   (551)          OUTPUT(1, 'AL49', '  INITIALIZE <room> <n> how much that room keeps$')
  1212   (552)          OUTPUT(1, 'AL', '  SET-NAME <name>      what this machine is called$')
  1213   (553)          % NO WIDTH ON THESE. 'ALn' is a FIELD, not a maximum: a count one short
  1214   (554)          % truncates the line and one too long pads it with asterisks, and both
  1215   (555)          % build clean. The bare descriptor sizes itself.
  1216   (556)          OUTPUT(1, 'AL', '  LOCK-TRUNKS          learn no NEW machines$')
  1217   (557)          OUTPUT(1, 'AL', '  DROP-MEMBER <name>   free a seat, tell NOBODY (test)$')
  1218   (558)          OUTPUT(1, 'AL', '  UNLOCK-TRUNKS        learn any machine again$')
  1219   (559)          OUTPUT(1, 'AL1',  '$')
  1220   (560)          OUTPUT(1, 'AL', 'Shorten each part: LI-T is LIST-TRUNKS, LO-T is LOCK-TRUNKS.$')
  1221   (561)          OUTPUT(1, 'AL37', 'Upper or lower case, either is fine.$')
  1222   (562)          OUTPUT(1, 'AL53', 'A trunk is a BELIEF a peer is reachable, not a link.$')
  1223   (563)      ENDROUTINE
  1224   (564)  
  1225   (565)      % -----------------------------------------------------------------------
  1226   (566)      % Say plainly that a command is known but not built yet.
  1227   (567)      %
  1228   (568)      % A SHELL THAT SILENTLY DOES NOTHING IS WORSE THAN ONE THAT REFUSES. The
  1229   (569)      % trunk verbs are declared so the command set is visible and a mode file
  1230   (570)      % can be written against it, but their wire kinds and the server half
  1231   (571)      % arrive with phase B. "Not built yet" is the honest answer; a cheerful
  1232   (572)      % "Ok" that changed nothing would be a lie an operator would act on.
  1233   (573)      % -----------------------------------------------------------------------
  1234   (574)      ROUTINE VOID, VOID : notYet
  1235   (575)          OUTPUT(1, 'AL21', 'known, not built yet$')
  1236   (576)      ENDROUTINE
  1237   (577)  
  1238   (578)      % -----------------------------------------------------------------------
  1239   (579)      % Fold one character to upper case.
  1240   (580)      %
  1241   (581)      % TYPING IN LOWER CASE IS NOT A MISTAKE AND MUST NOT BE TREATED AS ONE.
  1242   (582)      % The old matcher compared raw bytes against upper-case keywords, so
  1243   (583)      % "status" was answered "no such command" while "STATUS" worked. Nothing
  1244   (584)      % about this program needs the shift key held down.
  1245   (585)      % -----------------------------------------------------------------------
  1246   (586)      ROUTINE VOID, INTEGER (INTEGER) : upper(c)
  1247   (587)          IF c >= 97 AND c <= 122 THEN
  1248   (588)              c - 32 RETURN
  1249   (589)          ENDIF
  1250   (590)          c RETURN
  1251   (591)      ENDROUTINE
  1252   (592)  
  1253   (593)      % -----------------------------------------------------------------------
  1254   (594)      % How long is the typed command word? It ends at the first space, so an
  1255   (595)      % argument after it does not spoil the match.
  1256   (596)      % -----------------------------------------------------------------------
  1257   (597)      ROUTINE VOID, INTEGER : verbLength
  1258   (598)          INTEGER : n
  1259   (599)          0 =: n
  1260   (600)          DO
  1261   (601)              WHILE n < at AND lineBuf(n) >< spaceCh
  1262   (602)              n + 1 =: n
  1263   (603)          ENDDO
  1264   (604)          n RETURN
  1265   (605)      ENDROUTINE
  1266   (606)  
  1267   (607)      % -----------------------------------------------------------------------
  1268   (608)      % SINTRAN'S OWN ABBREVIATION RULE, and nothing more clever than it.
  1269   (609)      %
  1270   (610)      % A command is a run of parts separated by '-'. What you type must give
  1271   (611)      % EVERY part, and each typed part must be a PREFIX of the matching keyword
  1272   (612)      % part. So LIST-TRUNKS answers to L-T, LI-TRU, LIST-T and LIST-TRUNKS, and
  1273   (613)      % that is exactly how every SINTRAN command has always behaved.
  1274   (614)      %
  1275   (615)      % A BARE "L" DOES NOT MATCH IT. The parts are not optional - dropping one
  1276   (616)      % is a different command, not a shorter spelling of this one. That is what
  1277   (617)      % keeps L-T from colliding with a future LIST verb.
  1278   (618)      %
  1279   (619)      % This routine only answers yes or no about ONE keyword. Deciding what the
  1280   (620)      % typed word MEANS needs the count across all of them, because a prefix
  1281   (621)      % that fits two commands is ambiguous and must be refused rather than
  1282   (622)      % guessed - see matchAll.
  1283   (623)      % -----------------------------------------------------------------------
  1284   (624)      ROUTINE VOID, BOOLEAN (BYTES, INTEGER) : abbrevMatch(word, wordLen)
  1285   (625)          INTEGER : ti          % cursor in what was typed
  1286   (626)          INTEGER : ki          % cursor in the keyword
  1287   (627)          INTEGER : partLen     % characters given for the part in hand
  1288   (628)          BOOLEAN : bad
  1289   (629)          BOOLEAN : done
  1290   (630)  
  1291   (631)          0 =: ti
  1292   (632)          0 =: ki
  1293   (633)          FALSE =: bad
  1294   (634)          FALSE =: done
  1295   (635)  
  1296   (636)          DO
  1297   (637)              WHILE NOT bad AND NOT done
  1298   (638)  
  1299   (639)              % ---- the typed part must run down the keyword part ------------
  1300   (640)              0 =: partLen
  1301   (641)              DO
  1302   (642)                  WHILE NOT bad AND ti < cmdWordLen AND lineBuf(ti) >< hyphenCh
  1303   (643)                  IF ki >= wordLen THEN
  1304   (644)                      TRUE =: bad                 % typed past the end of it
  1305   (645)                  ELSE
  1306   (646)                      IF word(ki) = hyphenCh THEN
  1307   (647)                          TRUE =: bad             % this keyword part is shorter
  1308   (648)                      ELSE
  1309   (649)                          IF upper(lineBuf(ti)) >< word(ki) THEN
  1310   (650)                              TRUE =: bad
  1311   (651)                          ELSE
  1312   (652)                              ti + 1 =: ti
  1313   (653)                              ki + 1 =: ki
  1314   (654)                              partLen + 1 =: partLen
  1315   (655)                          ENDIF
  1316   (656)                      ENDIF
  1317   (657)                  ENDIF
  1318   (658)              ENDDO
  1319   (659)  
  1320   (660)              % An empty part - "-T", or "L--T" - is not an abbreviation.
  1321   (661)              IF NOT bad AND partLen = 0 THEN
  1322   (662)                  TRUE =: bad
  1323   (663)              ENDIF
  1324   (664)  
  1325   (665)              IF NOT bad THEN
  1326   (666)                  % Run the keyword on to the end of ITS part.
  1327   (667)                  DO
  1328   (668)                      WHILE ki < wordLen AND word(ki) >< hyphenCh
  1329   (669)                      ki + 1 =: ki
  1330   (670)                  ENDDO
  1331   (671)  
  1332   (672)                  IF ti >= cmdWordLen THEN
  1333   (673)                      % Nothing more was typed, so the keyword must be finished
  1334   (674)                      % too. If it is not, a part was left out.
  1335   (675)                      IF ki < wordLen THEN
  1336   (676)                          TRUE =: bad
  1337   (677)                      ENDIF
  1338   (678)                      TRUE =: done
  1339   (679)                  ELSE
  1340   (680)                      % More was typed: both sides are sitting on a '-'.
  1341   (681)                      IF ki >= wordLen THEN
  1342   (682)                          TRUE =: bad
  1343   (683)                      ELSE
  1344   (684)                          ti + 1 =: ti
  1345   (685)                          ki + 1 =: ki
  1346   (686)                      ENDIF
  1347   (687)                  ENDIF
  1348   (688)              ENDIF
  1349   (689)          ENDDO
  1350   (690)  
  1351   (691)          IF bad THEN
  1352   (692)              FALSE RETURN
  1353   (693)          ENDIF
  1354   (694)          TRUE RETURN
  1355   (695)      ENDROUTINE
  1356   (696)  
  1357   (697)      % -----------------------------------------------------------------------
  1358   (698)      % Count one keyword against what was typed, remembering the last hit.
  1359   (699)      % -----------------------------------------------------------------------
  1360   (700)      % THE LENGTH IS NOT A PARAMETER - THE KEYWORD IS ASKED FOR IT.
  1361   (701)      %
  1362   (702)      % Every caller passes one of the vXxx keywords declared above, and each one
  1363   (703)      % used to hand the count in beside it: fifteen hand-typed numbers that
  1364   (704)      % nothing could check. Rename a command and the number beside it is silently
  1365   (705)      % wrong, the build is clean, and the abbreviation matcher then compares the
  1366   (706)      % wrong number of characters - so a command matches when it should not, or
  1367   (707)      % stops matching at all.
  1368   (708)      %
  1369   (709)      % MAXINDEX(word, 1) is the DECLARED UPPER BOUND of the parameter and a
  1370   (710)      % string subscripts from ZERO, so the length is that plus one. A STANDARD
  1371   (711)      % routine the compiler provides - no IMPORT - and it works on an array
  1372   (712)      % parameter, which is what this is.
  1373   (713)      ROUTINE VOID, VOID (BYTES, INTEGER) : tryCmd(word, id)
  1374   (714)          INTEGER : wordLen
  1375   (715)          MAXINDEX(word, 1) + 1 =: wordLen
  1376   (716)          IF abbrevMatch(word, wordLen) THEN
  1377   (717)              cmdCount + 1 =: cmdCount
  1378   (718)              id =: cmdId
  1379   (719)          ENDIF
  1380   (720)      ENDROUTINE
  1381   (721)  
  1382   (722)      % -----------------------------------------------------------------------
  1383   (723)      % Print one keyword if it matched - used to say WHICH commands an
  1384   (724)      % ambiguous abbreviation could have meant. Being told "ambiguous" without
  1385   (725)      % being told between what is a riddle, not an error message.
  1386   (726)      % -----------------------------------------------------------------------
  1387   (727)      % The length is derived here for the same reason as in tryCmd above - the
  1388   (728)      % keyword knows how long it is, and a hand-typed number beside it is one
  1389   (729)      % more thing that can quietly disagree with the string.
  1390   (730)      ROUTINE VOID, VOID (BYTES) : showIfMatch(word)
  1391   (731)          INTEGER : wordLen
  1392   (732)          MAXINDEX(word, 1) + 1 =: wordLen
  1393   (733)          IF abbrevMatch(word, wordLen) THEN
  1394   (734)              OUTPUT(1, 'AL2', '  ')
  1395   (735)              OUTPUT(1, 'AL', word)
  1396   (736)              OUTPUT(1, 'AL1', '$')
  1397   (737)          ENDIF
  1398   (738)      ENDROUTINE
  1399   (739)  
  1400   (740)      % -----------------------------------------------------------------------
  1401   (741)      % Try every keyword. Afterwards cmdCount says what happened: 0 means no
  1402   (742)      % such command, 1 means cmdId is it, more than 1 means ambiguous.
  1403   (743)      %
  1404   (744)      % ORDER IS DELIBERATELY IRRELEVANT HERE. Every keyword is tried, always.
  1405   (745)      % -----------------------------------------------------------------------
  1406   (746)      ROUTINE VOID, VOID : matchAll
  1407   (747)          0 =: cmdCount
  1408   (748)          cNone =: cmdId
  1409   (749)          tryCmd(vExit, cExit)
  1410   (750)          tryCmd(vHelpWord, cHelp)
  1411   (751)          tryCmd(vStatus, cStatus)
  1412   (752)          tryCmd(vStop, cStop)
  1413   (753)          tryCmd(vStart, cStart)
  1414   (754)          tryCmd(vRestart, cRestart)
  1415   (755)          tryCmd(vStartTrunk, cStartTrunk)
  1416   (756)          tryCmd(vStopTrunk, cStopTrunk)
  1417   (757)          tryCmd(vRestTrunk, cRestTrunk)
  1418   (758)          tryCmd(vListTrunks, cListTrunks)
  1419   (759)          tryCmd(vInit, cInit)
  1420   (760)          tryCmd(vSetName, cSetName)
  1421   (761)          tryCmd(vLockTrunks, cLockTrunks)
  1422   (762)          tryCmd(vUnlockTrk, cUnlockTrk)
  1423   (763)          tryCmd(vDropMbr, cDropMbr)
  1424   (764)      ENDROUTINE
  1425   (765)  
  1426   (766)      % -----------------------------------------------------------------------
  1427   (767)      % List what an ambiguous abbreviation could have meant.
  1428   (768)      % -----------------------------------------------------------------------
  1429   (769)      ROUTINE VOID, VOID : showAmbiguous
  1430   (770)          OUTPUT(1, 'AL22', 'ambiguous - could be:$')
  1431   (771)          showIfMatch(vExit)
  1432   (772)          showIfMatch(vHelpWord)
  1433   (773)          showIfMatch(vStatus)
  1434   (774)          showIfMatch(vStop)
  1435   (775)          showIfMatch(vStart)
  1436   (776)          showIfMatch(vRestart)
  1437   (777)          showIfMatch(vStartTrunk)
  1438   (778)          showIfMatch(vStopTrunk)
  1439   (779)          showIfMatch(vRestTrunk)
  1440   (780)          showIfMatch(vListTrunks)
  1441   (781)          showIfMatch(vInit)
  1442   (782)          showIfMatch(vSetName)
  1443   (783)          % THESE THREE WERE MISSING. tryCmd knows them, so an abbreviation CAN be
  1444   (784)          % ambiguous between them, and this list is what the person is shown when
  1445   (785)          % it is - leaving them out turns a helpful message into a wrong one.
  1446   (786)          showIfMatch(vLockTrunks)
  1447   (787)          showIfMatch(vUnlockTrk)
  1448   (788)          showIfMatch(vDropMbr)
  1449   (789)      ENDROUTINE
  1450   (790)  
  1451   (791)      % -----------------------------------------------------------------------
  1452   (792)      % One command.
  1453   (793)      %
  1454   (794)      % ORDER MATTERS WHERE ONE KEYWORD IS A PREFIX OF ANOTHER. LIST-TRUNKS,
  1455   (795)      % UNTRUNK and RETRUNK are all tested before TRUNK, or the shorter word would
  1456   (796)      % swallow the longer ones.
  1457   (797)      % -----------------------------------------------------------------------
  1458   (798)      % -----------------------------------------------------------------------
  1459   (799)      % START THE SERVER. This is NOT a message, and that is why it was missing.
  1460   (800)      %
  1461   (801)      % STOP is a message to a RUNNING server. START cannot be - there is nothing
  1462   (802)      % running to receive it - so it has to be an RT start from THIS side, the
  1463   (803)      % same thing @RT CHATSER does.
  1464   (804)      %
  1465   (805)      % TWO CALLS, NOT ONE. StartRTProgram (RT 100B) takes the ADDRESS of an RT
  1466   (806)      % description, not a name: "Address of RT description. Use 0 for your own".
  1467   (807)      % GetRTAddress (GRTDA 151B) is what turns CHATSER into that address -
  1468   (808)      % name in, address out. Reaching for StartRTProgram alone and passing it a
  1469   (809)      % name would compile, and start whatever RT description happened to live at
  1470   (810)      % the address those bytes make.
  1471   (811)      %
  1472   (812)      % BOTH ARE REACHED BY NAME through MON-CALL-1B-A00, which CHATMN:MODE now
  1473   (813)      % loads. It did not before, because MON1 was this program's only monitor
  1474   (814)      % call and MON1 is one of the runtime's own MONn routines.
  1475   (815)      %
  1476   (816)      % WHAT THIS CANNOT FIX, and an operator needs to know it: an RT program that
  1477   (817)      % uses XMSG must be RT-LOADED AGAIN after every XMSG restart. Starting one
  1478   (818)      % that was linked BEFORE the restart puts it straight into PASSIVE with zero
  1479   (819)      % CPU and not a line in its log. If START says it started and STATUS still
  1480   (820)      % says nothing is there, that is what happened - use tools\rt-load.ps1.
  1481   (821)      % -----------------------------------------------------------------------
  1482   (822)      ROUTINE VOID, BOOLEAN : startServer
  1483   (823)          BOOLEAN : failed
  1484   (824)  
  1485   (825)          0 =: rtAddr
  1486   (826)  
  1487   (827)          ON ROUTINEERROR DO
  1488   (828)              TRUE =: failed
  1489   (829)          ENDON
  1490   (830)          FALSE =: failed
  1491   (831)  
  1492   (832)          MONITOR_CALL('GetRTAddress', rtProgName, rtAddr)
  1493   (833)  
  1494   (834)          % Clear the handler before anything else can raise under it.
  1495   (835)          ON ROUTINEERROR DO
  1496   (836)          ENDON
  1497   (837)  
  1498   (838)          IF failed OR rtAddr = 0 THEN
  1499   (839)              OUTPUT(1, 'AL31', 'cannot find RT program CHATSER$')
  1500   (840)              FALSE RETURN
  1501   (841)          ENDIF
  1502   (842)  
  1503   (843)          ON ROUTINEERROR DO
  1504   (844)              TRUE =: failed
  1505   (845)          ENDON
  1506   (846)          FALSE =: failed
  1507   (847)  
  1508   (848)          MONITOR_CALL('StartRTProgram', rtAddr)
  1509   (849)  
  1510   (850)          ON ROUTINEERROR DO
  1511   (851)          ENDON
  1512   (852)  
  1513   (853)          IF failed THEN
  1514   (854)              OUTPUT(1, 'AL24', 'could not start CHATSER$')
  1515   (855)              FALSE RETURN
  1516   (856)          ENDIF
  1517   (857)  
  1518   (858)          TRUE RETURN
  1519   (859)      ENDROUTINE
  1520   (860)  
  1521   (861)      ROUTINE VOID, VOID : dispatch
  1522   (862)          IF at = 0 THEN
  1523   (863)              RETURN
  1524   (864)          ENDIF
  1525   (865)  
  1526   (866)          verbLength =: cmdWordLen
  1527   (867)          IF cmdWordLen = 0 THEN
  1528   (868)              RETURN
  1529   (869)          ENDIF
  1530   (870)  
  1531   (871)          % ? IS NOT AN ABBREVIATION OF ANYTHING and must not go near the
  1532   (872)          % matcher. X-C answers ?, and a person coming from anywhere else types
  1533   (873)          % HELP, so both are taken.
  1534   (874)          IF cmdWordLen = 1 AND lineBuf(0) = questCh THEN
  1535   (875)              showHelp
  1536   (876)              RETURN
  1537   (877)          ENDIF
  1538   (878)  
  1539   (879)          matchAll
  1540   (880)  
  1541   (881)          IF cmdCount = 0 THEN
  1542   (882)              OUTPUT(1, 'AL16', 'no such command$')
  1543   (883)              RETURN
  1544   (884)          ENDIF
  1545   (885)  
  1546   (886)          % REFUSE, DO NOT GUESS. "S" fits STATUS, STOP and START, and picking
  1547   (887)          % one of them because it happened to be tested last is how an operator
  1548   (888)          % stops a server they meant to ask about.
  1549   (889)          IF cmdCount > 1 THEN
  1550   (890)              showAmbiguous
  1551   (891)              RETURN
  1552   (892)          ENDIF
  1553   (893)  
  1554   (894)          IF cmdId = cExit THEN
  1555   (895)              TRUE =: leaving
  1556   (896)              RETURN
  1557   (897)          ENDIF
  1558   (898)  
  1559   (899)          IF cmdId = cHelp THEN
  1560   (900)              showHelp
  1561   (901)              RETURN
  1562   (902)          ENDIF
  1563   (903)  
  1564   (904)          IF cmdId = cStatus THEN
  1565   (905)              sendAdmin(kAdmStat)
  1566   (906)              showAnswer
  1567   (907)              RETURN
  1568   (908)          ENDIF
  1569   (909)  
  1570   (910)          IF cmdId = cStop THEN
  1571   (911)              sendAdmin(kAdmStop)
  1572   (912)              % A STOP gets no answer - the server is gone by the time one could
  1573   (913)              % be written. Waiting for a reply that is never coming is how a
  1574   (914)              % tool ends up looking hung when it worked.
  1575   (915)              OUTPUT(1, 'AL10', 'stop sent$')
  1576   (916)              RETURN
  1577   (917)          ENDIF
  1578   (918)  
  1579   (919)          % START IS BACK TO NOT BUILT, AND THE REASON IS MEASURED.
  1580   (920)          %
  1581   (921)          % StartRTProgram (RT 100B) is REFUSED from here. Typing START answered
  1582   (922)          %
  1583   (923)          %     ERROR 00 AT  12156; ILLEGAL MONITOR CALL
  1584   (924)          %       100
  1585   (925)          %
  1586   (926)          % and took CHAT-MON down with it. GetRTAddress (151B) got through, so it
  1587   (927)          % is 100B specifically - it needs a privilege this program does not have
  1588   (928)          % running as an ordinary background program. The manual's parameter list
  1589   (929)          % was read and its PERMISSION COLUMNS were not.
  1590   (930)          %
  1591   (931)          % AND THE GUARD DOES NOT HELP. ON ROUTINEERROR does NOT catch an ILLEGAL
  1592   (932)          % MONITOR CALL - that is a system trap, not a ROUTINEERROR - so wrapping
  1593   (933)          % it more carefully changes nothing. A command that kills the program is
  1594   (934)          % worse than one that admits it does nothing, so it admits it.
  1595   (935)          %
  1596   (936)          % AND THE MANUAL SAYS SO PLAINLY. ND-860228-2-EN SINTRAN III Monitor
  1597   (937)          % Calls, the availability line under StartRTProgram:
  1598   (938)          %
  1599   (939)          %     | ND-100 and ND-500 | User RT and user SYSTEM | RT programs |
  1600   (940)          %
  1601   (941)          % Three columns: which machine, which USER, and which PROGRAM TYPE. We
  1602   (942)          % are user SYSTEM, which is allowed. We are a BACKGROUND program, which
  1603   (943)          % is not. Page 5 of the same manual states the rule in general - "Other
  1604   (944)          % monitor calls may be used only in RT programs or only in background
  1605   (945)          % programs."
  1606   (946)          %
  1607   (947)          % SO THIS IS NOT A BUG TO BE FIXED, IT IS A CONSTRAINT. An interactive
  1608   (948)          % operator shell IS a background program; making CHAT-MON an RT program
  1609   (949)          % to win this one command would cost it its terminal. @RT CHATSER typed
  1610   (950)          % at SINTRAN works because SINTRAN itself does the starting.
  1611   (951)          %
  1612   (952)          % The honest thing, and what RESTART now does, is to tell the operator
  1613   (953)          % the command rather than pretend to run it.
  1614   (954)          %
  1615   (955)          % Note the ERR column for 100B is BLANK - the call has NO error return,
  1616   (956)          % which is why it traps as ILLEGAL MONITOR CALL instead of handing back
  1617   (957)          % a status, and why no amount of guarding could have caught it.
  1618   (958)          IF cmdId = cStart THEN
  1619   (959)              OUTPUT(1, 'AL32', 'SINTRAN only - type @RT CHATSER$')
  1620   (960)              RETURN
  1621   (961)          ENDIF
  1622   (962)  
  1623   (963)          % RESTART IS STOP THEN START, and the two halves travel by different
  1624   (964)          % roads: the stop is a message to the running server, the start is an RT
  1625   (965)          % start from here. The server has to notice the stop and terminate
  1626   (966)          % before the start can take, and nothing here waits for it - so this
  1627   (967)          % says what it did rather than claiming the server is up.
  1628   (968)          % RESTART is STOP then START, and START is refused - see above. The stop
  1629   (969)          % half works, so it does that and says plainly what is left to do by
  1630   (970)          % hand rather than pretending the server is coming back.
  1631   (971)          IF cmdId = cRestart THEN
  1632   (972)              sendAdmin(kAdmStop)
  1633   (973)              OUTPUT(1, 'AL10', 'stop sent$')
  1634   (974)              OUTPUT(1, 'AL31', 'start it yourself: @RT CHATSER$')
  1635   (975)              RETURN
  1636   (976)          ENDIF
  1637   (977)  
  1638   (978)          % ---- THE TRUNK VERBS ------------------------------------------------
  1639   (979)          %
  1640   (980)          % These were declared long before they did anything, so the command set
  1641   (981)          % and its abbreviations could be settled and a mode file written against
  1642   (982)          % them. The server half exists now.
  1643   (983)          %
  1644   (984)          % All three answer with kAdmRepl, the same kind STATUS uses, so showAnswer
  1645   (985)          % needs no new decoding - the server sends readable text and this prints
  1646   (986)          % it. That is why adding three verbs costs no wire change.
  1647   (987)          IF cmdId = cStartTrunk THEN
  1648   (988)              sndArgMsg(kAdmTrunk)
  1649   (989)              showAnswer
  1650   (990)              RETURN
  1651   (991)          ENDIF
  1652   (992)  
  1653   (993)          % INITIALIZE <room> <n> - how many messages that room remembers.
  1654   (994)          %
  1655   (995)          % TWO FIELDS IN ONE ARGUMENT, and this end does not take them apart.
  1656   (996)          % sndArgMsg sends everything after the verb as text and the SERVER
  1657   (997)          % splits it, for the same reason START-TRUNK does not parse its system
  1658   (998)          % number here: one place decides what a valid argument is, so there are
  1659   (999)          % never two that can disagree about it.
  1660  (1000)          IF cmdId = cInit THEN
  1661  (1001)              sndArgMsg(kAdmInit)
  1662  (1002)              showAnswer
  1663  (1003)              RETURN
  1664  (1004)          ENDIF
  1665  (1005)  
  1666  (1006)          % DROP-MEMBER <name> - free that seat on the server and tell nobody.
  1667  (1007)          %
  1668  (1008)          % sndArgMsg like the other verbs that carry an argument: the name goes
  1669  (1009)          % across as text and the SERVER decides what a valid one is, so there is
  1670  (1010)          % only ever one place that can be wrong about it.
  1671  (1011)          %
  1672  (1012)          % THIS IS A TEST VERB AND THE HELP LINE SAYS SO. It exists to reach
  1673  (1013)          % kTrkDBad on purpose - see the comment on kAdmDrop in CHATSV.PLNC.
  1674  (1014)          % Used on a live room it silently unseats somebody, and the room is
  1675  (1015)          % never told, which is exactly what makes it useful and exactly what
  1676  (1016)          % makes it wrong for anything else.
  1677  (1017)          IF cmdId = cDropMbr THEN
  1678  (1018)              sndArgMsg(kAdmDrop)
  1679  (1019)              showAnswer
  1680  (1020)              RETURN
  1681  (1021)          ENDIF
  1682  (1022)  
  1683  (1023)          % SET-NAME <name> - what this machine calls itself.
  1684  (1024)          %
  1685  (1025)          % TYPICALLY THE MACHINE'S OWN NAME, and that is the point of it: a room
  1686  (1026)          % that spans machines shows ANNA@D102 today, which is a number a person
  1687  (1027)          % has to translate. With a name set it shows ANNA@FJELL.
  1688  (1028)          %
  1689  (1029)          % SET-NAME with nothing after it CLEARS the name, and the machine goes
  1690  (1030)          % back to being called D<number> everywhere - which is what it was
  1691  (1031)          % before names existed, so there is a way back from a typo that does
  1692  (1032)          % not need a restart.
  1693  (1033)          %
  1694  (1034)          % NOT PARSED HERE. sndArgMsg sends everything after the verb and the
  1695  (1035)          % SERVER decides what a valid name is, for the same reason START-TRUNK
  1696  (1036)          % does not parse its system number at this end: one place decides, so
  1697  (1037)          % there are never two that can disagree.
  1698  (1038)          %
  1699  (1039)          % IT IS NOT WRITTEN TO DISK. Put it in this machine's boot mode file
  1700  (1040)          % beside START-TRUNK and it is set on every cold start.
  1701  (1041)          IF cmdId = cSetName THEN
  1702  (1042)              sndArgMsg(kAdmName)
  1703  (1043)              showAnswer
  1704  (1044)              RETURN
  1705  (1045)          ENDIF
  1706  (1046)  
  1707  (1047)          % LOCK-TRUNKS / UNLOCK-TRUNKS carry no argument, so they go out with
  1708  (1048)          % sendAdmin rather than sndArgMsg. The server answers with kAdmRepl like
  1709  (1049)          % every other admin verb, so showAnswer needs no new decoding.
  1710  (1050)          IF cmdId = cLockTrunks THEN
  1711  (1051)              sendAdmin(kAdmLock)
  1712  (1052)              showAnswer
  1713  (1053)              RETURN
  1714  (1054)          ENDIF
  1715  (1055)  
  1716  (1056)          IF cmdId = cUnlockTrk THEN
  1717  (1057)              sendAdmin(kAdmOpen)
  1718  (1058)              showAnswer
  1719  (1059)              RETURN
  1720  (1060)          ENDIF
  1721  (1061)  
  1722  (1062)          IF cmdId = cStopTrunk THEN
  1723  (1063)              sndArgMsg(kAdmUntrnk)
  1724  (1064)              showAnswer
  1725  (1065)              RETURN
  1726  (1066)          ENDIF
  1727  (1067)  
  1728  (1068)          IF cmdId = cListTrunks THEN
  1729  (1069)              sendAdmin(kAdmTrunks)
  1730  (1070)              showAnswer
  1731  (1071)              RETURN
  1732  (1072)          ENDIF
  1733  (1073)  
  1734  (1074)          % RESTART-TRUNK is STOP-TRUNK then START-TRUNK against the same system.
  1735  (1075)          % Both halves are ordinary messages here - unlike RESTART above, which
  1736  (1076)          % needs an RT start this program is not allowed to make - so it really
  1737  (1077)          % does both and says so.
  1738  (1078)          IF cmdId = cRestTrunk THEN
  1739  (1079)              sndArgMsg(kAdmUntrnk)
  1740  (1080)              showAnswer
  1741  (1081)              sndArgMsg(kAdmTrunk)
  1742  (1082)              showAnswer
  1743  (1083)              RETURN
  1744  (1084)          ENDIF
  1745  (1085)  
  1746  (1086)          notYet
  1747  (1087)      ENDROUTINE
  1748  (1088)  
  1749  (1089)      % -----------------------------------------------------------------------
  1750  (1090)      % The program.
  1751  (1091)      % -----------------------------------------------------------------------
  1752  (1092)      PROGRAM : chatMonitor
  1753  (1093)          INISTACK stack
  1754  (1094)  
  1755  (1095)          % The flags WORD from its bit position. XFWTF is a BIT NUMBER in the
  1756  (1096)          % values file, not a mask - 2**XFWTF is what the call wants.
  1757  (1097)          2**XFWTF =: waitFlags
  1758  (1098)  
  1759  (1099)          xmpfopn(0, myPort) =: returnStatus
  1760  (1100)          IF returnStatus >< XMOK THEN
  1761  (1101)              showStatus('xmpfopn', returnStatus)
  1762  (1102)              RETURN
  1763  (1103)          ENDIF
  1764  (1104)  
  1765  (1105)          OUTPUT(1, 'AL31', 'CHAT-MON - type ? for commands$')
  1766  (1106)  
  1767  (1107)          % ---- THE COMMAND LOOP -------------------------------------------
  1768  (1108)          %
  1769  (1109)          % A SHELL, NOT A ONE-SHOT. This used to read one line, send it and
  1770  (1110)          % exit, so an operator had to restart the program for every command
  1771  (1111)          % and could not use it the way X-C is used. It now prompts, dispatches
  1772  (1112)          % and prompts again until EXIT - the same feel as X-C, and the same
  1773  (1113)          % shape a boot mode file can drive line by line.
  1774  (1114)          FALSE =: leaving
  1775  (1115)          DO
  1776  (1116)              OUTPUT(1, 'AL5', 'C-M: ')
  1777  (1117)              readLine
  1778  (1118)              dispatch
  1779  (1119)              WHILE NOT leaving
  1780  (1120)          ENDDO
  1781  (1121)      ENDROUTINE
  1782  (1122)  
  1783  (1123)  ENDMODULE
  1784  (1124)  