126374   INTEGER CBHOLD=?
126374   B8OTERM: IF CFREE-10<0 GO WDX
126400   B8FELLS: 0=:CBHOLD
126401          IF X:=FYLLE NBIT "0" GO EVEN
126404          T:=BUFST
126405          *IRR ALEVB DA
126406          A SHZ -10; *SBYT
126410          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DA; SBYT
126417          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DD
126425          A SHZ -10; *SBYT
126427          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DD; SBYT
126436          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DL
126444          A SHZ -10; *SBYT
126446          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DL; SBYT
126455          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DX
126463          A SHZ -10; *SBYT
126465          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DX; SBYT
126474          IF X+1=MAX THEN X:=0 FI; X=:FYLLE
126502   GORET: BHOLD+10=:BHOLD; CFREE-10=:CFREE
126510          *IRR ALEVB DT
126511          IF A>177 AND A<300 THEN
126517                *IRR ALEVB DX
126520                A/\377; GO RETINDV
126522          FI; CALL STDEV; GO MOURET
126524   EVEN: FYLLE SHZ -1+BUFST=:X; MAX SHZ -1+BUFST=:T
126534          *IRR ALEVB DA
126535          A=:X.S0; IF X+1=T THEN X:=BUFST FI
126542          *IRR ALEVB DD
126543          A=:X.S0; IF X+1=T THEN X:=BUFST FI
126550          *IRR ALEVB DL
126551          A=:X.S0; IF X+1=T THEN X:=BUFST FI
126556          *IRR ALEVB DX
126557          A=:X.S0; IF X+1=T THEN X:=BUFST FI
126564          A:=X-BUFST SHZ 1=:FYLLE
126570          GO GORET
126571   INTEGER CBHOLD
126572   *)FILL
126576   
126576   B8OINDV: IF "IOTRANS"><"IPTCH" GO B8IWORD
126602          DFOPP=:B
126604          IF CFREE-10<0 THEN
126607   NOSPACE:     DFOPP=:B; GO WDX
126612          FI; GO FAR B8FELLS
126613   @ELIB
126613   @LIB CXCPU
