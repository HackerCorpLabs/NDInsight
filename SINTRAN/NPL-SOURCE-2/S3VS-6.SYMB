070362   *"8DIR
"070362   
070362   SUBR P3OSTERM
070362   RBUS
070362   
070362   %==============================================================================
070362   % 35.9       3 I N S T R   3 O U T S T
070362   %
070362   % STRING MONITOR CALLS
070362   % I=INSTR(LOG.NO,COREADDR,MAXNO,TERMINATOR)
070362   % I=OUTST(LOG.NO,COREADDR,NUMBER)
070362   SUBR 3INSTR,3OUTST,PT3OSTERM,COPTDFIELD
070362   
070362   DISP 24
070362          INTEGER CCOUNT,VAL,DYTYFIELD
070362          INTEGER POINTER LREG
070362   PSID
070362   
070362   @LIB CXCPU
070362   
070362   INTEGER BREG
070363   
070363   % MONITOR CALL INSTR:
070363   3INSTR: T:="P1"; CALL GET4; CALL C3OUTX
070366          A=:X; CALL CHERR
070370          OLDPAGE=:D; CALL DALTON; *BSET ZRO
070374          DO
070374                MIN CCOUNT; GO BYP1; GO OUT1
070377   BYP1:        CALL IOTR; GO WEX1; IF =D3 GO TERM1; A SH 10=:VAL
070406                MIN CCOUNT; GO BYP2; GO OUT2
070411   BYP2:        CALL IOTR; GO WEX2; IF =D3 GO TERM2
070416                A+VAL; *BSET ONE
070420                A=:X.S0; *BSET ZRO
070422                X+1
070423          OD
070424   %EXITS FROM LOOP:
070424   OUT2:  *BSET ONE
070425          A=:X.S0; *BSET ZRO
070427   OUT1:  D2=:ZAREG; GO ACTRET
070432   % BUFFER EMPTY(RT ONLY):
070432   WEX2:  VAL; *BSET ONE
070434          A=:X.S0; *BSET ZRO
070436          GO WEXX
070437   WEX1:  IF D2+CCOUNT-1=0 GO WTIO
070443   WEXX:  D2+CCOUNT BONE 17=:ZAREG; GO ACTRET
070450   TERM2: A+VAL; GO TERMX
070452   TERM1: A SH 10
070453   TERMX: *BSET ONE;
070454          A=:X.S0; *BSET ZRO
070456          D2+CCOUNT+1 BONE 16=:ZAREG; GO ACTRET
070464   % EXIT WITH ACTIVATION OF DEVICE:
070464   ACTRET: X:=DYTYFIELD:=:B; *IOF
070467   @LIB CXCPU
070467   @LIB CXCPU-,
070467          CALL STDEV; X:=:B; *ION
070472   @ELIB
070472   RETU:  IF BACKGROUND><0 THEN CALL XBMRET FI; GO RET
070476   WTIO:  *IOF
070477          X:=DYTYFIELD:=:B=:BREG:=RTREF; CALL WDATA
070504   @LIB CXCPU
070504   @LIB CXCPU-,
070504          CALL STDEV; BREG=:B
070507   @ELIB
070507          ZPREG-1=:ZPREG; GO RETSTUPR
070513   @LIB CXCPU-,
070513   ERR2:  2; GO ERRF
070515   @ELIB
070515   *)FILL
070530   
070530   
070530   
070530   % MONITOR CALL OUTST:
070530   3OUTST: T:="P1"; CALL GET3; CALL C3OUTX
070533          IF D=0 GO ERR2
070535   @LIB CXCPU
070535   @LIB CXCPU-,
070535          IF A><0 AND A.TYPRING BIT 5TERM GO FAR OSTERM
070542          IF D.TYPRING BIT 5COM GO FAR SIMMAG
070546          IF A BIT 5BAD GO FAR OSTAD
070550   @ELIB
070550          IF BACKGROUND=0 THEN
070552             IF D2>>X.MAX GO OUTFULL
070556             IF A>>X.CFREE GO WTIO
070561          FI; CALL CHERR; OLDPAGE=:D; CALL DALTON; *BSET ZRO
070566          DO
070566                MIN CCOUNT; GO OBYP1; GO OOUT
070571   OBYP1:       *BSET ONE
070572                X.S0; *BSET ZRO
070574                X+1; A=:VAL SHZ -10
070577                CALL IOTR; GO OUTFULL; MIN CCOUNT; GO OBYP2; GO OOUT
070604   OBYP2:       VAL/\377; CALL IOTR; GO OUTFULL
070610          OD
070611   % EXITS FROM LOOP:
070611   OOUT:  0=:ZAREG; GO ACTRET
070613   OUTFULL: 100000=:ZAREG; GO RET                   % RT ONLY
070616   
070616   % LOCAL SUBROUTINE TO CHECK FOR ERRORS; X=DATAFIELD
070616   %RETURN: X=CORE ADDR
070616   CHERR: A:=L=:"LREG"; X=:DYTYFIELD
070621          IF X=0 OR X.TYPRING NBIT 5IOBT GO ERR2
070625          IF X.RTRES><RTREF THEN 5; GO ERRF FI; T=:D
070634          IF D2<0 GO ERR; T:=A+1 SHZ -1; A-,=:CCOUNT
070642          D1; CALL CHLIM; GO ERR; *IOF
070646          IF X.TYPRING BIT 5TERM THEN
070651             T:="FLAGB"; CALL XGTDFADDR 
070653             IF A BIT 5LSTA THEN TER02; GO ERRF FI  % TERMINAL NOT CONNECTED
070657          FI
070657   @LIB CXCPU
070657   @LIB CXCPU-,
070657          IF X.DERROR><0 THEN 0=:X.DERROR; *ION
070663   ERRF:        A\/140000=:ZAREG; GO RETU
070666   @ELIB
070666          FI; X:=D1; MLEV; *MST PIE; ION
070672          GO LREG
070673   @LIB CXCPU
070673   @LIB CXCPU-,
070673   ERR:   -1=:ZAREG; GO FAR RETU
070676   @ELIB
070676   *)FILL
070721   
070721   C3OUTX: T=:D1:=L=:"LREG"
070724           CALL 3OUTX; A=:D; IF A/\177700=100 GO FAR ERR2; A:=D
070733           CALL LOGPH; GO LREG
070735   
070735   % SUBROUTINE TO EXECUTE "IOTRANS"
070735   % RETURN: FULL/EMPTY (RT ONLY)
070735   % SKIPRETURN: OK
070735   IOTR:  A=:D; DYTYFIELD; *IOF; IRW BLEVB DB
070741          "BIOTR"; *IRW BLEVB DP
070743          BLEV; *MST PID; COPY SD DA
070746          IF T:=BACKGROUND><0 THEN L-1 FI
070752          *ION; EXIT
070754   % INBT-OUTBT LEVEL:
070754   BIOTR: *PIOF
070755   @LIB CXCPU
070755          *IRR ALEVB DA
070756          CALL IOTRANS; GO WWT; *IRW ALEVB DA
070761          *IRR ALEVB DL; AAA 1
070763          IF T:=BACKGROUND><0 THEN A+1 FI
070767          *IRW ALEVB DL
070770   WBIO:  CALL STDEV
070771   @LIB CXCPU
070771          *PION; WAIT
070773          CALL ERRFATAL
070774   WWT:   IF BACKGROUND><0 THEN
070776   @LIB CXCPU
070776   @LIB CXCPU-,
070776             X:=RTREF; CALL WDATA; "STUPR";*IRW MLEVB DP
071002   @ELIB
071002             MLEV; *MST PID
071004          FI
071004          GO WBIO
071005   *)FILL
071017    
071017   %      O S T E R M
071017   
071017   DISP 0; DOUBLE CDBUADR=CBUADR, DD1=D1; PSID
071017   DISP 5REG; REAL ZF1RG,ZF4RG,ZF7RG; PSID
071017   INTEGER XREG,SAVB
071021   
071021   OSTERM: IF D.RTRES><RTREF THEN 5; GO FAR ERRF FI          % DEVICE NOT RESERVED
071030   @LIB CXCPU
071030   
071030   @LIB CXCPU-,
071030          AD:=DD1=:X.CDBUADR; X=:XREG
071033          TAD:=ZF1RG=:X.ZOPRG:=ZF4RG=:X.ZOARG:=ZF7RG=:X.ZOSRG
071041          IF B="DEMFIELD" THEN X:=RTRES; CALL BRELEASE FI
071046          OLDPAGE=:D; XREG=:B; MLEV; *MST PIE
071054          MAX SHZ -1+BUFST=:T; NOCHAR SHZ -1; A-=:CNOCHAR
071064          CALL DALTON; *PIOF
071066          FYLLE SHZ -1+BUFST=:D; MINBHOLD BONE 5BLOC=:MINBHOLD
071075   LOOP:  *PIOF
071076          X:=CBUADR; BHOLD=:SBHOLD; 0=:BHOLD; CFREE SHZ -1=:L
071105          CNOCHAR-=:XNOCHAR; IF A=0 GO MBFERDIG
071111          IF FYLLE BIT 0 GO FAR NOTEVEN
071114          FOR CNOCHAR DO
071114                IF L=0 GO NOSPACE; *PION
071117                X.S0; *PIOF
071121                X+1:=:D; A=:X.S0
071124                L-1; IF X+1=T THEN X:=BUFST FI; X:=:D
071132          OD; GO FERDIG; *)FILL
071143   
071143   FERDIG: CNOCHAR+XNOCHAR SH 1+SBHOLD=:SBHOLD
071150          IF NOCHAR BIT 0 THEN
071153                IF L=0 AND CFREE NBIT 0 THEN
071160                   A:=D-BUFST SH 1=:FYLLE
071164                   SBHOLD=:BHOLD; GO GGSTUPR
071167                FI
071167                A:=D-BUFST SH 1=:D
071173                *PION
071174                X.S0 SHZ -10; *PIOF
071177                T:=BUFST; X:=:D; *SBYT
071202                IF X+1=MAX THEN X:=0 FI; X=:FYLLE; MIN SBHOLD
071211          ELSE
071212                A:=D-BUFST SH 1=:FYLLE
071216          FI
071216   GORET: SBHOLD=:BHOLD; MAX-BHOLD=:CFREE
071223          MINBHOLD BZERO 5BLOC=:MINBHOLD
071226   @ELIB
071226   
071226   TGORET: CALL ALTOFF; *IOF
071230          CALL STDEV
071231          A:=B+"ZOPRG"-5REG=:B; 0=:ZAREG
071236          *PION
071237          GO FAR RETU
071240   
071240   @LIB CXCPU-,
071240   MBFERDIG: IF FYLLE BIT 0 THEN A=:D; GO XFERDIG FI
071245          GO FERDIG
071246   
071246   *)FILL
071251   
071251   NOSPACE: A:=D-BUFST SH 1=:FYLLE
071255   GOSTUPR: CNOCHAR+XNOCHAR SH 1+SBHOLD=:BHOLD
071262   GGSTUPER: MAX-BHOLD=:CFREE; X=:CBUADR; A:=D=:SBHOLD
071270          X:=RTRES; CALL WDATA; CALL STDEV
071273          SBHOLD=:D
071275          "STUPR"; *IRW MLEVB DP
071277          MLEV; *MST PID; PION
071302          GO FAR LOOP
071303   
071303   NOTEVEN: FYLLE=:D
071305          FOR CNOCHAR DO
071305                IF L=0 GO XNOSPACE; *PION
071310                X.S0 SHR 10; X+1:=:D; *PIOF
071315                T:=BUFST; *SBYT
071317                IF X+1=MAX THEN X:=0 FI
071324                T:=BUFST; A SHR 10; *SBYT
071327                IF X+1=MAX THEN X:=0 FI
071334                L-1; X:=:D
071336          OD
071340   
071340   XFERDIG: CNOCHAR+XNOCHAR SH 1+SBHOLD=:SBHOLD
071345          IF NOCHAR BIT 0 THEN
071350                IF L=0 AND CFREE NBIT 0 THEN
071355                   A:=D=:FYLLE; SBHOLD=:BHOLD; GO GGSTUPR
071362                FI
071362                *PION
071363                X.S0 SHR 10; *PIOF
071366                X:=D; T:=BUFST; *SBYT
071371                IF X+1=MAX THEN X:=0 FI
071376                MIN SBHOLD
071377          ELSE
071400                X:=D
071401          FI; X=:FYLLE
071402          GO GORET
071403   
071403   XNOSPACE: A:=D=:FYLLE
071405          GO GOSTUPR
071406   *)FILL
071411   @ELIB
071411   
071411   INTEGER POINTER PTTNO:=TTNO,PBCHFLAG:=BCHFLAG, PTTIFIELD:=TTIFIELD
071414   3OUTX: IF BACKGROUND><0 THEN
071416                X:=B+7; *LRB BLEVB
071421                X:="ESCBLOCK"; *SRB BLEVB
071423                A:=B=:CMDFFIELD
071425                IF D0=1 THEN
071431                   IF PBCHFLAG=0 THEN
071433                      A:=PTTNO
071434                   ELSE
071435                      A:=PTTIFIELD.DFOPP.ROFIL
071440                FI;FI
071440          ELSE
071441                D0
071442          FI; EXIT
071443   
071443   
071443   % SIMULATE MAGTP CALL FOR COMM. CHANNEL
071443   SIMMAG: D2 SHZ -1=:IMAXW; D1=:ICORAD; IF M THEN MIN IMAXW; 3 ELSE 1 FI A=:IFUNC
071457          1=:WFLAG; 0=:MTFLG; -1=:IBLOADR; GO FAR XMRW                  % CONT. IN MAGTP ROUTINE
071465   *)FILL
071471   
071471   %      O S T A D   
071471   
071471   INTEGER TADDF
071472   OSTAD:
071472   
071472   *"8STRN+8N500 -BADAD
"071472   
071472          IF D.RTRES><RTREF THEN 5; GO FAR ERRF FI          % DEVICE NOT RESERVED
071501          X=:TADDF; D1=:X.USDADR; D2-=:X.OBCOU
071507          TAD:=ZF1RG=:X.ZOPRG:=ZF4RG=:X.ZOARG:=ZF7RG=:X.ZOSRG
071515          IF B="DEMFIELD" THEN X:=RTRES; CALL BRELEASE FI
071522          OLDPAGE=:D; TADDF=:B; MLEV; *MST PIE
071530          0=:XRSA; CALL DALTON
071532   TLOOP: *PIOF
071533          X:=XRSA; IF OBCOU=0 GO FAR TGORET
071537          FOR OBCOU DO
071537                T:=USDADR
071540                *PION; BSET ONE; LBYT; BSET ZRO; PIOF
071545                CALL IOTRANS; GO TBUFWT; X+1 
071550          OD; GO FAR TGORET; *)FILL
071561   
071561   TBUFWT: IF DERROR=0 THEN                         % WAIT FOR BUFFER
071563             X:=RTRES; CALL WDATA 
071565             "STUPR"; *IRW MLEVB DP
071567             MLEV; *MST PID; PION
071572             GO TLOOP
071573          FI; *PION
071574          0=:DERROR; GO FAR ERRF                    % ERROR FROM IOTRANS
071576   *"8STRN+8N500
"071576   RBUS
071601   
071601   @LIB CXCPU
071601   *"-8STRN -8N500
"071601   *CBLOC=TEXIT; CB2LO=TEXIT; CBUNL=TEXIT
071601   
071601   *"8DMAS
"071601   *"8MEAS
"071601   %==============================================================================
071601   % 35.12      X P P R U T
071601   %
071601   SUBR XPPRUT
071601   DISP 7; INTEGER P7; PSID
071601   XPPRUT: *IOF
071602          X:=X.P7=:B; CALL STDEV; *ION
071606          GO STUPR
