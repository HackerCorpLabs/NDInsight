043203  % MACRO FOR INTERNAL DEVICE IN
043203  
043203  )MCDEF IDVI $NAM,$NOC,$TCHAR 
$NAM I,0;0;*-2;112100;0;0;IORES;IGTCH;ISTDV;CLBUF
       $NAM O;0;BUF;$NOC +$NOC ;0;0;$NOC +$NOC ;0
       1210+XIBNX;1211+XIBNX;1;0;$STCHAR ;0
%%XBU=BUF+$NOC ;)KILL BUF;BUF=XBU;)KILL XBU
"8S3C
BUF=*; )KILL BUF; *+$NOC /
"
]
043203  
043203  % MACRO FOR INTERNAL DEVICE OUT
043203  
043203  )MCDEF IDVO $NAM 
$NAM O,  0;0;*-2;112100;0;0;IORES;IPTCH;OSTDV;INIOS;$NAM I;0
       0;0;0;0;0;0
       1210+XIBNX;1272+YIBNY;0;0
YIBNX=XIBNX+2;)KILL XIBNX; XIBNX=YIBNX;)KILL YIBNX
YIBNZ=YIBNY+1;)KILL YIBNY; YIBNY=YIBNZ;)KILL YIBNZ
]
043203  
