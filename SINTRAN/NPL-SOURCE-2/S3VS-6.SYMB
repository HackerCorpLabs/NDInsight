"063606          A-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
063613          A*GNLPRT*ALMSZ+LAMACT; A:=:X; A-RTSTART=:D:=0; *RDIV ST
063623          A*GNLPRT*ALMSZ+LAMACT=:T; A:=GNLPRT:=:L=:LREG; L+L
063633   @LIB CXCPU
063633   @LIB CXCPU-,
