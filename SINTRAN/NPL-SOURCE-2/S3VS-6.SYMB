115354             CALL FCDSKFORM; 0=:CCPGN
115356             -77=:CCOUNT; DDASA=:CMASS; DDBLST=:DMASS
115364             FOR CCOUNT DO
115364                AD:=CCMAD=:MEMAD=:CMADR
115367   LOOPX:       T:=DSKTYP BZERO "0"; CMASS; X:=CNBLCK
115373   RLOOP:       CALL TRNSF; GO ERR2; GO RLOOP
115376                IF CCOUNT=-77 THEN
115402                   AD:=CCMAD; X:="LGCOLDSTART"+D; ROUTSWITCH=:X.S0
115407                FI
115407                IF CPGN><0 AND A=CCPGN THEN
115414                   AD:=CCMAD; A:="QDLAY"/\1777; D+A=:X
115421                   A:="CDSKFORM"; T:=20=:D; *MOVB; JMP *
115426                FI; AD:=CCMAD=:MEMAD=:CMADR
115431                T:=DSKTYP BONE "0"; DMASS; X:=CNBLCK
115435   WLOOP:       CALL TRNSF; GO ERR2; GO WLOOP
115440                CMASS; A:=:D+CNBLCK; D:=D+C; A:=:D; AD=:CMASS
115446                DMASS; A:=:D+CNBLCK; D:=D+C; A:=:D; AD=:DMASS
115454                MIN CCPGN
115455             OD
115457          FI
115457          A:=0=:D; AD=:MEMAD=:CMADR; T:=DSKTYP; X:=CNBLCK
115465          *TRR 10
115466   LOOP2: CALL TRNSF; GO ERR2; GO LOOP2
115471          "0"; *TRR IIE; IDENT PL11; IDENT PL11
115475          A:=0; *TRR 11         % LOWER LIMIT
115477          A:=-1; *TRR 12        % UPPER LIMIT
115501          *TRR 10               % CLEAR CACHE
115502          0=:P                  % START BOOTSTRAP
