065344   *"8MT1+8MT2+8MT3+8MT4
"065344   %==============================================================================
065344   % 34.3       M C 1 4 4
065344   %
065344   %
065344   % CALL MAGTP(FUNC,CORAD,LOG.DEV,MAXWORDS,READWORDS)
065344   % ENTRY: B=DF-DATAFIELD
065344   %       PARAMETERS ARE IN DATAFIELD
065344   % EXIT: A=0 IF OK
065344   %
065344   
065344   SUBR MC144
065344   
065344   % VARIABLES IN I/O DATAFIELD:
065344   
065344   DISP 25; INTEGER CASUN; PSID           % DEVICE UNIT NUMBER
065344   
065344   % VARIABLES IN "DF" DATAFIELDS:
065344   
065344   DISP 35
065344      INTEGER DMLOG                % LOGICAL DEVICE NUMBER OF MASS STORAGE DEVICE
065344      INTEGER DMFLD                % DATA FIELD ADDRESS OF MASS STORAGE DEVICE
065344      INTEGER IUNIT                % DEVICE UNIT NUMBER
065344      INTEGER MDBUF                % DEVICE BUFFER ADDRESS: LEAST SIG. 16 BITS
065344      INTEGER CMDBUF               % DEVICE BUFFER ADDRESS: LEAST SIG. 16 BITS
065344                                   % WILL BE INCREMENTED WITH 1K FOR EACH K WORDS
065344                                   % TO READ/WRITE
065344      INTEGER MDFI                 % DEVICE BUFFER HEADER ADDRESS
065344      INTEGER FIMAX                % NO. OF WORDS TO READ OR WRITE IF FLOPPY DISC
065344      INTEGER SVXERR=DMLOG         % TEMPORARLY SAVING OF X-REGISTER
065344      INTEGER TSAVE=MDBUF          % TEMPORARLY SAVING OF T-REGISTER
065344   PSID
065344   
065344   %      DISPLACEMENTS IN INTERNAL BLOCK DEVICE DATAFIELDS.
065344   
065344   DISP -3
065344      INTEGER DBLDN             % LOGICAL DEVICE NUMBER OF DBH RESERVED FOR THIS IBD. (ONLY FIRST). .
065344      INTEGER INWORDS           % NO. OF WORDS IN BUFFER                                            .  INPUT PART ONLY
065344      INTEGER IDFOPP            % ADDRESS OF OUTPUT DATAFIELD                                       .
065344   PSID
065344   DISP 13
065344      INTEGER BREGC
065344   PSID
065344   
065344   MC144: A:=L=:"MCLRG"
065346          CALL SPT3PIT; GO PT3MC144       % CONTINUE ON PIT3-SEGMENT
065350   
065350   RBUS
