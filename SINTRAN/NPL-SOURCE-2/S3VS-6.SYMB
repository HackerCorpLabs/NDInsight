174574   %%@LIB CXCPU
174574   %========================================================================
174574   %      X C H I O X
174574   %
174574   % CHECK FOR IOX ERRORS ON THE TERMINALS
174574   %
174574   SUBR XCHIOX
174574   
174574   INTEGER POINTER LREG,PTMRTE
174576   INTEGER XREG; TRIPLE TADREG
174602   INTEGER CCOUNT
174603   
174603   XCHIOX: TAD=:TADREG; X=:XREG; A:=L=:"LREG"
174607          A:=200; *TRR IIE; TRA IIC
174612          "TMRTE"+1=:"PTMRTE"
174615          DO WHILE X:=PTMRTE><-1 AND "PTMRTE"<<"9EXTD"
174625             *TRA IIC
174626             IF X><0 AND X.HDEV><0 THEN
174631                T:=A+2; *IOXT; TRA IIC
174635                IF A=7 THEN
174640                   0=:PTMRTE
174641                ELSE
174642                   IF X.HDEV NBIT 2 THEN
174645   % CHECK IDENT CODE IF INPUT DEVICE
174645                      X=:D; T:=X.HDEV+3; A:=30; *IOXT
174652                      *IDENT PL10; IDENT PL12; TRA IIC
174655                      15; *IOXT
174657                      A:=0; T+"5-3"; *IOXT
174662                      0=:CCOUNT; FOR CCOUNT DO OD; FOR CCOUNT DO OD
174667                      5; T+"7-5"; *IOXT
174672                      A:=0; *IDENT PL12
174674                      IF A=0 GO ERRID; A-1
174676                      IF A<<="HIDTERM" AND A>>="LIDTERM" THEN
174704                         IF A-T>>"MXX12" GO ERRID
174710                         X:="ID12T"+A; X.S0
174713                      ELSE
174714                         ITB12(A)
174716                      FI; IF A><D GO ERRID; A:=0; *IDENT PL10
174722                      IF A=0 GO ERRID; A-1
174724                      IF A<<="HIDTERM" AND A>>="LIDTERM" THEN
174732                         IF A-T>>"MXX10" GO ERRID
174736                         X:="ID10T"+A; X.S0
174741                      ELSE
174742                         ITB10(A)
174744                      FI
174744                      T:="9CXTI"; D+T
174746                      IF A><D GO ERRID
174750                      T+"3-7"; A:=30; *IOXT; IDENT PL10; IDENT PL12; TRA IIC
174756                      GO IDOK
174757   ERRID:             D.HDEV; T:=0; CALL 9ERR(#23)
174764   IDOK:           FI
174764                FI
174764             FI; MIN "PTMRTE"
174765          OD; TAD:=TADREG; X:=XREG; GO LREG
174771   RBUS
