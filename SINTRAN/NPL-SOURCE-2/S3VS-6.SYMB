"074203   
074203   %==============================================================================
074203   % 36.13      E N T S G
074203   %
074203   %  MONITOR CALL: ENTSG(SEGNO,PT.NO,INT.LEVEL,STARTADDR)
074203   %  ENTERING A FIXED SEGMENT INTO THE PAGE TABLES
074203   SUBR ENTSG
074203   INTEGER SVB,IRWINST(0); *IRW DP
074205   ENTSG: CALL GET4
074206          IF D1>>3 GO ERR                     % ILLEGAL PAGE TABLE NUMBER
074212          IF D0>>SGMAX GO ERR
074216          A*5SEGSIZE+SEGSTART
074220          IF A.FLAG NBIT 5FIX GO ERR
074224          D1; *PIOF
074226          A SH 7+177000:=:B=:SVB; T:=CORMBANK; X:=X.BPAGLINK
074234          DO WHILE X><0
074235             *LDATX DALOG
074236             A/\77 SH 1+B=:B; *LDDTX DPGPR
074243             AD=:DOU0; A:=B/\177600=:B; *LDXTX DPAGL
074250          OD; SVB=:B; *PION
074254          IF D2<2 OR >11 OR =3 OR =4 GO ERR
074271          D1 SH 7=:D SH 2; D\/A; D2 SH 3+2\/D; *TRR PCR
074303          D2 SH 3\/IRWINST=:T; D3; *EXR ST
074311          1; FOR X:=D2- DO A SH 1; OD; *MST PIE
074317          0=:ZAREG; GO RET
074321   ERR:   -1=:ZAREG; GO RET
074324   RBUS
