115102          IF A.ACTPRI BIT 17 AND ERNUM><#20 AND><#21 AND><#22 AND><#23 AND><#37
115124             AND ><#40 AND ><#44 AND ><#46 AND ><#47 AND><#72 AND><#73 AND><#74
115151             AND ><#75 AND ><#76 AND ><#97 AND ><#99 AND ><-1 AND >#08 OR <#06 THEN
115200                  X:="ERNUM"; CALL BGERR
115202          ELSE                                      % RT-ERROR
115203   ASRT:          "IERRFIELD"=:B
115205                  IF CFREE>=5 THEN
115211                    FOR X:=0 TO 4 DO ERRARR(X)=:9ERRP(X); CALL RWPUT OD
115222                    CALL XRTACT
115223                  FI
115223          FI; BREG=:B; GO LREG
