123346   %            E U S E 3   D U S E 3
123346   
123346   % MONITOR CALLS TO ENABLE/DISABLE USER ESCAPE HANDLING
123346   %
123346   % EUSE3 (EUSEL - MON 300)   - ENABLE  USER ESCAPE HANDLING    
123346   % DUSE3 (DUSEL - MON 301)   - DISABLE USER ESCAPE HANDLING (NORMAL SINTRAN MODE)
123346   SUBR EUSE3,DUSE3
123346   INTEGER POINTER TTIF:=TTIFIELD
123347   EUSE3: K:=1; GO FELLS
123351   DUSE3: K:="0"
123352   FELLS: IF TTIF=0 THEN 33; GO RETU; FI
123356          IF A.TYPRING NBIT 5TERM AND A NBIT 5BAD THEN
123364             240; GO RETU
123366          FI
123366          IF K THEN
123370             ZAREG=:X.EUSADD; *IOF
123373             X.FLAGB BONE 5USESC=:X.FLAGB; *ION
123377          ELSE
123400             *IOF
123401             X.FLAGB BZERO 5USESC BZERO 5WESC=:X.FLAGB; *ION
123406          FI
123406          MIN ZPREG; 0/\0; A:=0
123411   RETU:  A=:ZAREG; GO RET
