065126   
065126   SUBR PLOTT
065126   
065126   DISP -6; INTEGER POINTER PLDRI; PSID
065126   
065126   PLOTT: CALL GET5; IF D3/\177700=100 THEN 2; GO ERROR FI
065136          D3; CALL LOGPH
065140          IF X:=D=0 THEN 2;  GO ERORR FI     % TEST IF DEVICE PRESENT
065145          IF X.RTRES><CURPROG THEN 5; GO ERORR FI  % RESERVED BY THIS USER ?
065153          X."PLDRI"=:P                   % CALL RELEVANT INTERFACEROUTINE
065155   ERORR: A=:ZAREG;  GO RET               % DEVICE NOT AVAILABLE
065157   RBUS
