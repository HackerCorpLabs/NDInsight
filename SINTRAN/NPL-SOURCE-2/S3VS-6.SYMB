130763   %==========================================================
130763   % 40.28      X 2 1 7    X 2 1 1 0    X 2 1 1 2    X 2 1 R T
130763   %******************************************
130763   %
130763   %      INFORMATION FROM DCE 
130763   %
130763   %*******************************************
130763   
130763   %
130763   %
130763   %     CALL PROGRESS SIGNALS                     ** STATE 7 **
130763   %      T-REG AT EXIT:
130763   %      T = CODE GROUP NO
130763   %      T < 0 MEANS  T = ERRORCODE-
130763   
130763   SUBR X217
130763   X217:  T:=7=:X2DST; A:=L=:X2DSR; CALL STORE      % ENTERING STATE 7
130770          0=:X2DPC=:X2DPS
130772          DO WHILE X2D00><"X21PL"
130776             IF T:=X2DBC<0 THEN
131001                X:=X2DPC
131002                T:=X2DMP+X2M2; *SBYT                % SAVE BYTE IN MESSAGE
131005             ELSE
131006                T:=X2FSM; GO OUT                    % MESSAGE TOO SMALL
131010             FI
131010             MIN X2DPC; P+0
131012             MIN X2DBC; P+0
131014             IF X2D00><"X21PL" OR ><"X21KO" THEN
131023                X2DPS*12=:T; X2D00-60\/T=:X2DPS     % CONVERT FROM ASCII
131032             FI
131032             IF X2D00="X21KO" AND X2DPS<=24 THEN    % IMPORTENT CP SIGNAL?
131042                0=:X2DPS=:X2DPC                     % NO, FOREGET IT
131044             FI
131044             CALL X2GET; *JMP *-1                   % GET NEXT CHARACTER
131046          OD
131047          IF X2DPS>=24 THEN T:=X2FCP; GO OUT FI     % SERIOUS CP  STOPP
131055          IF X2DPC > 2 THEN T:=X2FEC; GO OUT FI     % EXTENDED CP SIGNAL
131063          T:=0
131064   OUT:   X:=X2DMP; A:=X2DSR=:P 
131067   RBUS
131072   
131072                        
131072   %      TAKE ACTION ACCORDING TO CALL PROGRESS SIGNAL
131072   
131072   
131072   %
131072   %
131072   %      CALLED/CALLING LINE IDENTIFICATION        ** STATE 10
131072   %      OR DCE PROVIDED INFORMATION
131072      
131072   SUBR X2110
131072   X2110: T:=12=:X2DST:=L=:X2DSR; CALL STORE        % ENTERING STATE 10
131077          X:=0=:X2DPC
131101             DO WHILE X2D00><"X21PL"
131105                X:=X2DPC
131106                T:=X2DMP+X2M3; *SBYT                % STORE IN MESSAGE
131111                MIN X2DBC; P+0                      % MESSAGE LENGTH INCREMENTED
131113                MIN X2DPC; P+0                       
131115                IF X2DBC = 0 THEN T:=X2FSM; GO OUT FI % NO MORE SPACE IN MESSAGE
131121                CALL X2GET; *JMP *-1
131123             OD
131124             X:=X2DPC; T:=X2DMP+X2M3; A:="X21PL"; *SBYT
131131             T:=0 
131132   OUT:   A:=X2DSR=:P                               % EXIT
131134   RBUS
