043203  
043203  % MACRO FOR ALLOCATING AREA WITH ZEROES
043203  )MCDEF BSPAC $NOADR
*<*+$NOADR -1
)ZERO
*+$NOADR /
]
043203  % MACRO FOR TEKTRONIX DISPLAY
043203  
043203  )MCDEF TXTRO $NAM,$HNO,$MAXX,$MAXY,$MAXZ
TEXTR; $MAXY ;$MAXZ ;IOX $HNO ;0 ; $MAXX ;
$NAM , 0; 0; *-2; 0
]
