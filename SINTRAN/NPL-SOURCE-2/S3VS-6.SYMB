"125620   %
125620   % ===========================================================================
125620   % 15.16      P T 3 F U S E R
125620   % INTERFACE ROUTINE TO CALL PLANC SUBROUTINES ON FILE USER SEGMENT
125620   % PARAMETER TRANSFER BY REFERENCE
125620   %
125620   % CALL SEQUENCE:
125620   %      X:=<INDEX TO PLANC ROUTINE>; CALL FILUS; CALL ERROR
125620   %      SKIP RETURN IF NO ERRORS DETECTED
125620   % NOTE:
125620   %      BEFORE CALLING FILUS, REFERENCES TO PARAMETERS MUST BE
125620   %      PLACED ON THE FILE SYSTEM STACK FROM LOCATION CSTCK+22
125620   %      CSTCK: FILE SYSTEM CURRENT STACK POINTER
125620   %
125620   SUBR PT3FUSER
125620   
125620   INTEGER WPROG=?
125620   INTEGER ARRAY POINTER RFRES:=RFSTB      % RFA DATA SEGMENT RESERVE TABLE
125621   INTEGER POINTER NMSEGS:=NRFSG           % NUMBER OF RFA DATA SEGMENTS
125622   INTEGER POINTER CRTR:=CRTREF            % CALLING RT PROGRAM
125623   
125623   DISP 0; DOUBLE DACTSEG=ACTSEG; PSID
125623   
125623          *SDATA
125623   
125623   % NOTE:      THIS DISP VARIABLES ARE ALSO DEFINED IN THE ROUTINE
125623   %            TOFENTRY IN RESIDENT (ON FILE SINB-X).
125623   %            DO NOT CHANGE THIS DISP DEFINITIONS WITHOUT DOING
125623   %            THE SAME MODIFICATIONS IN TOFENTRY
125623   %
125623   
125623   DISP 0
125623          INTEGER XREG,TREG,AREG,DREG,LREG,BREG
125623          INTEGER OLDSG,OLDRSG                      % SAVED ON FILE SYSTEM STACK
125623          INTEGER RETUR,PREVB,STPTR,STMAX,LEXIT,ERRCO         % PLANC STACK FRAME
125623   PSID
125623          *DATA ERRCO
125623   
125623   PT3FUSER: *FENTR
125630          0=:LEXIT=:ERRCO       % MAKE PLANC STACK FRAME
125632          "ESTCK"=:STMAX
125634          CSTCK=:STPTR; X:=RTREF
125637          IF BACKGR=0 OR X.ACTSEG SHZ -10=5ERRSEG OR XREG=URTLIOP THEN
125652             % RT PROGRAM OR RTOPEN, RTCONNECT, RTCLOSE,LIST-RTOPEN OR RTRES-O-F-E
125652             A:="5RRUS"=:DRFSG  % RT PROGRAM
125654          ELSE                 
125655             IF DRFSG=0 THEN
125657                *IOF                                                            %%%%%%%%%%%%%%%%%%%%%
125660                FOR X:=0 TO NMSEGS DO                                           %%                 %%
125664                   IF RFRES(X)=0 GO SFNDX; X=:T:=A  % SEGMENT IS FREE TO USE    %%  MUST NOT CROSS %%
125670                   IF X.WLINK=0 AND X.TLINK=0 AND X.STATUS NBIT 5RWAIT THEN     %%  A PAGE BORDER  %%
125677                      T=:X; GO SFNDX   % PROGRAM IS PASSIVE, TAKE SEGMENT       %%                 %%
125701                   FI; T=:X                                                     %%                 %%
125702                OD; *ION                                                        %%                 %%
125705                % ALL SEGMENTS ARE RESERVED                                     %%                 %%
125705                A:=ER188=:AREG; GO FAR NSGSX; *)FILL                            %%                 %%
125721   SFNDX:       RTREF=:RFRES(X); 0=:INSFG; A:="DSSNM"+X=:DRFSG; X:=RTREF; *ION  %%%%%%%%%%%%%%%%%%%%%
125731             FI
125731          FI    % A-REG: RFA DATA SEGMENT NUMBER
125731          A\/177400=:T;
125733          CALL MMEXY; T=:OLDSG; X.RSEGM=:OLDRSG;
125737          IF X:=XREG<=UCLOS THEN A:=5FIU2 ELSE A:=5FIUS; FI; CALL MMREENT
125747          IF DRFSG="5RRUS" THEN           % RT PROGRAM
125753             IF X:="RTRFA"=RTREF GO ASBACK          % ALREADY RUNNING
125757             A:=1730; CALL XLOCK                    % RESERVE RTRFA SEMA
125761             X:=X.RTDLGADDR; CALL SVRBLK            % COPY REGISTER BLOCK
125763             A:="NSTRT"; T:=0; *STATX               % SET P-REG.
125766             AD:=RTREF.DACTSEG; D BZERO 5BACKGR; AD=:"RTRFA".DACTSEG
125773             RTREF.RSEGM=:"RTRFA".RSEGM
125777             % RESERVE DF DATAFIELD
125777             MLEV; *MCL PIE
126001             X:="RTRFA"; CALL RTENTRY; RTREF.STATUS BONE 5WAIT=:X.STATUS
126007             "STUPR"; *IRW MLEVB DP;
126011             MLEV; *MST PID; MST PIE
126014             GO XRRT; A:=1730; CALL XUNLOCK; MIN LREG; GO OUT
126021   XRRT:     A:=1730; CALL XUNLOCK; D=:A; GO ERRT
126025   NSTRT:    T=:WPROG                               % NEW ENTRY OF RTRFA
126026             X:=XREG; CALL TOFENTRY; GO EERRT
126031             T:=0; X:=WPROG.RTDLGADDR
126034             *LDATX; AAA 1; STATX                   % INCREMENT P-REG.
126037             GO ENDXX
126040   EERRT:    X:=WPROG.RTDLGADDR; T:=0; *STATX 40    % ERROR CODE IN D-REG.
126044   ENDXX:    WPROG.STATUS BZERO 5WAIT=:X.STATUS
126050             *JMP I (SRRT1; )FILL                   % RESTART WAITING TASK
126072             INTEGER WPROG
126073          FI
126073   ASBAC: X:=XREG
126074          CALL TOFENTRY; GO ERRT                    % X MUST BE SET 
126076          MIN LREG; GO OUT                          % SKIP RETURN IF NO ERRORS
126100   ERRT:  IF A=-1 THEN A:=ER161; FI; A=:AREG 
126105   OUT:   % GET BACK FILE SYSTEM SEGMENT(S):
126105          T:=OLDSG; CALL MMEXY; A:=OLDRSG; CALL MMREENT
126111   NSGSX: *FLEAV
126113   RBUS
126120   *"
"126120   
126120   *"8C1X2+8C2X2+8C3X2+8C4X2
"126120   %
126120   %=============================================
126120   % 40.20
126120   %      X 2 1 2 S    X 2 1 3 S    X 2 S N D 
126120   %      X 2 S S S
126120   
126120   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
126120   %
126120   %      X 2 1  DRIVER FOR HANDLING X21 DCB'S
126120   %
126120   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
126120    
126120   
126120   %PURPOSE:    CONNECT AND DISCONNECT TO A X 21 NETWORK
126120   
126120   %ENTER:      B-REG DATAFIELDPOINTER
126120   %            MESSAGE:      COMMAND
126120   %                          FACILITY
126120   %                          STATUS
126120   %                          SELECTIONS SIGNALS
126120   %                          DTE/DCE PROVIDED INFORMATION
126120   
126120   
126120   %EXIT:       MESSAGE SENT BACK TO USER WITH APPROPRIATE STATUS INFORMATION.
126120   
126120    
126120   %HDLC REGISTER CONTENT DEFINITION
126120   %
126120   %
126120   SYMBOL CPCR = 100                                % IOX + 1
126120   SYMBOL CSAR = 377% IOX + 3
126120   SYMBOL CCL  = 347                                %IOX + 4  7BITS BYTE+PARITY
126120   SYMBOL CTCW =   1% IOX + 7
126120   SYMBOL CWTTC= 104% IOX + 13
126120   SYMBOL CRTTC= 104% IOX + 11
126120   %
126120   %
126120    
126120   %
126120   %
126120   %      X21 LOGGING ROUTINES
126120   %**************************
126120   
126120   
126120          SYMBOL X22SIZ = 20
126120          SYMBOL X2LMA = X22SIZ-1
126120          SYMBOL DCEMS = X22SIZ*10+4
126120   
126120          INTEGER ARRAY X2A00(X22SIZ)
126140          INTEGER ARRAY X2A02(X22SIZ)
126160          INTEGER ARRAY X2A05(X22SIZ)
126200          INTEGER ARRAY X2A10(X22SIZ)
126220          INTEGER ARRAY X2A11(X22SIZ)
126240          INTEGER ARRAY X2A12(X22SIZ)
126260          INTEGER ARRAY X2AST(X22SIZ)
126300          INTEGER ARRAY X2ATL(X22SIZ)
126320    
126320          INTEGER X2LL:=0
126321          INTEGER X2LL1:=-1
126322          INTEGER X2LL2:=0
126323          INTEGER X2LL4:=0
126324          INTEGER X2LL5:=0
126325   
126325   %
126325   %
126325   %      LOGG IN ARRAYS
126325   
126325   SUBR STORE
126325   STORE: IF X2D00 >< X2A00(X2LL) THEN GO XUP21 FI
126333          IF X2D02 >< X2A02(X2LL) AND >< "0" THEN GO XUP21 FI
126344          IF X2D05 >< X2A05(X2LL) THEN GO XUP21 FI
126352          IF X2D10 >< X2A10(X2LL) THEN GO XUP21 FI
126360          IF X2D11 >< X2A11(X2LL) THEN GO XUP21 FI
126366          IF X2D12 >< X2A12(X2LL) THEN GO XUP21 FI
126374          IF X2DST >< X2AST(X2LL) THEN GO XUP21 FI
126402          MIN X2LL4; P+0; X:=X2DMP
126405          EXIT
126406   XUP21: MIN X2LL1; P+0
126410          X2LL1 /\ X2LMA=:X2LL
126413          X2D00=:X2A00(X2LL)
126416          X2D02=:X2A02(X2LL); 0=:X2D02
126422          X2D05=:X2A05(X2LL)
126425          X2D10=:X2A10(X2LL)
126430          X2D11=:X2A11(X2LL)
126433          X2D12=:X2A12(X2LL)
126436          X2DST=:X2AST(X2LL)
126441          X2LL-1=:X2LL5
126444          IF X2LL5 < 0 THEN "X22SIZ-1"=:X2LL5 FI
126450          X2LL4=:X2ATL(X2LL5); 0=:X2LL4
126454          X:=X2DMP; EXIT
126456   RBUS
126473   
126473   
126473   %****************************
126473   %
126473   %      SOME USEFUL ROUTINES
126473   %
126473   %****************************
126473   
126473   
126473   %      SERVICE ROUTINE FOR UPATINNG IDENT TABLES
126473   %************************************************
126473   
126473   
126473   %      EXCHANGE "X2OLD" IN IDENTTABLE WITH "X2NEW"
126473   %      "X2OLD" MAY ALSO BE FOUND IN EXTENDED IDENTTABLE
126473   %      ENTRY X212S - LEVEL 12(D)
126473   %      ENTRY X213S - LEVEL 13(D)
126473   
126473   %      INPUT PARAMS:
126473   
126473   INTEGER X2NEW:=0                                 % ADDR TO BE INSERTED
126474   INTEGER X2OLD:=0                                 % ADDR TO BE REMOVED
126475   
126475   %      SCRATCH LOCATIONS
126475   
126475   SUBR X212S,X213S
126475   INTEGER X2TA1:=0                                 % ADDR TO TABLE
126476   INTEGER X2TA2:=0                                 % ADDR TO EXTENDED TABLE
126477   INTEGER X2SSP:=0                                 % WORKING 
126500   
126500   DISP 0; INTEGER XNUL1; INTEGER EN; PSID
126500   
126500   X212S: IDNTS(2)=:X2TA1+"MAX12"=:X2SSP; EXTDS(2)=:X2TA2; GO X2HER
126511   X213S: IDNTS(3)=:X2TA1+"MAX13"=:X2SSP; EXTDS(3)=:X2TA2
126521                     
126521   X2HER: FOR X:=X2TA1 STEP 1 TO X2SSP DO
126525             T:=0; *LDATX
126527             IF A=X2OLD THEN
126532                T:=0; X2NEW; *STATX
126535                EXIT
126536             FI
126536          OD
126540   
126540   %      LOOK IN EXTENDED TABLE
126540   
126540          DO T:=0; X:=X2TA2; X+1; * LDATX
126544          WHILE A><-1
126547             X:=X2TA2; X+1; T:=0; * LDATX
126553             IF A=X2OLD THEN
126556                T:=0; X2NEW; *STATX
126561                EXIT
126562             FI
126562             MIN X2TA2; P+0
126564          OD
126565          A:=X2FNI; CALL X21UT                      % ENTRY NOT FOUND
126567   RBUS
126575   
126575   %
126575   %      SEND ONE CHARACTER 
126575   %      THE ROUTINE WILL GENERATE ODD PARITY 
126575   %
126575   %      INPUT: A-REG IS CHARACTER TO BE TRANSMITTED
126575   %
126575   %      OUTPUT: STATUS IN X2D12 IN DATAFIELD
126575   %
126575   %**************************************************
126575   
126575   SUBR X2SND
126575   X2SND: T:=L=:X2DLS; 
126577          CALL X21PG; A=:X2D05  
126601          T:=X2DHD+XWTDR; *EXR ST
126604          105
126605          T+"XWTTC-XWTDR"
126606          *EXR ST
126607          CALL X21LV; T:=X2DHD+XRTTS; *EXR ST
126613          A=:X2D12; CALL STORE; A:=X2DLS=:P
126617    
126617    
126617   %      ROUTINE FOR PARITY GENERATION ( ODD PARITY)
126617   %**************************************************
126617   
126617   X21PG: *BSET ONE 70 DA
126620          *BSKP ZRO 60 DA; BSET BCM 70 DA
126622          *BSKP ZRO 50 DA; BSET BCM 70 DA
126624          *BSKP ZRO 40 DA; BSET BCM 70 DA
126626          *BSKP ZRO 30 DA; BSET BCM 70 DA
126630          *BSKP ZRO 20 DA; BSET BCM 70 DA
126632          *BSKP ZRO 10 DA; BSET BCM 70 DA
126634          *BSKP ZRO  0 DA; BSET BCM 70 DA
126636          EXIT
126637   RBUS
126642   
126642   %
126642   %      ROUTINE FOR STARTING TRANSMITTER PART OF INTERFACE
126642   %      AND SENDING "SYN,SYN"
126642   %
126642   %*********************************************************
126642   
126642   SUBR X2SSS
126642   X2SSS: A:=L=:X2DLS
126644          1=:X2DPC
126646          FOR X2DPC STEP 1 TO 4 DO                  % SEND 4 SYNC
126652             1; T:=X2DHD+XWTCR; *EXR ST
126656   L1:       105; T:=X2DHD+XWTTC; *EXR ST
126662             CALL X21LV
126663             T:=X2DHD+XRTTS; *EXR ST
126666             A=:X2D13
126667             IF A NBIT 0 THEN GO L1 FI
126672          OD
126676          0=:A; T:=X2DHD+XWTCR; *EXR ST
126702          A:=X2DLS=:P
126704   RBUS
126705   
126705   
126705   
126705   % ======================================================
126705   % 40.21 
126705   %      X 2 1 E R    X 2 S T A     X 2 S B Y    X 2 R B Y
126705   %      X 2 R A C    X 2 1 U T
126705   %========================================================
126705   
126705   %*******************************
126705   %
126705   %      MESSAGE HANDLING
126705   %
126705   %*******************************
126705   
126705   SUBR X21ER,X2STA,X2SBY,X2RBY,X2RAC,X21UT      
126705    
126705   %
126705   % 
126705   %      MESSAGE RECEPTION
126705   X2STA: IF X2DST=10 THEN                          % ARE YOU IN READY STATE?
126711             CALL XTSTC; GO NOMES                   % YES, ANY MESSAGE?
126713                CALL X2114                          % CONTROLLED NOT READY
126714                0=:X2DST=:X2DPIN
126716                X2FNC=:X2DMP.X2MST; CALL O3CHA     % YES, RETURN READY MESSAGE
126722                0=:X2DMP; 1=:X2DDF
126725          FI
126725   NOMES: CALL D3CHA; CALL X21LV; 0=:X2DER; CALL X2RBY      % GET NEW MESSAGE
126731          IF A >= 10 THEN CALL X21C FI              % DECODE COMMAND
126735          IF A >= 6 THEN X2FSM=:X.CRET FI           % TOO SMALL MESSAGE
126742          CALL O3CHA; 0=:X2DMP; GO X2STA           % RETURN MINI MESSAGE
126745   
126745   
126745   % 
126745   %
126745   %      MESSAGE SENDING       (RETURN IT TO SENDER)
126745   
126745   X21ER: A=:X2DMP.X2MST=:X2DER; CALL STORE; CALL X2116
126752          CALL X2121; CALL X211; CALL X2114
126755          X:=X2DMP; GO X21UU                         % LEAVE AT STATE 24
126757   
126757   X21UT: A=:X2DMP.X2MST; CALL STORE                % SET STATUS
126762   X21UU:  CALL X2RBY; A+X2DBC=:T; CALL X2SBY
126766          CALL O3CHA; 0=:X2DMP; 1=:X2DDF 
126772          GO FAR X2STA
126773   
126773   %
126773   %
126773   %      SOME USEFUL MESSAGE MAINTENANCE ROUTINES
126773   
126773   
126773   %      STORE BYTECOUNT IN MESSAGE
126773   
126773   X2SBY: T=:X.BBYTC; EXIT
126775   
126775   %
126775   %      READ ACTUAL BYTECOUNT
126775   
126775   X2RAC: A:=X.BBYTC; EXIT
126777   
126777   %
126777   %      READ MAX BYTECOUNT
126777   
126777   X2RBY: A:=X.BMBYTE; EXIT
127001   
127001   %
127001   %      ANY MESSAGES FOR ME?
127001   
127001   XTSTC: IF IQUEU><0 THEN  EXITA FI
127004          EXIT
127005   RBUS
127023   
127023   %============================
127023   % 40.22
127023   %      X 2 1 C
127023   %
127023   %============================
127023   
127023   
127023   %******************************
127023   %
127023   %      THE X21 COMMANDS
127023   %
127023   %******************************
127023   
127023   
127023   SUBR X21C,X21RE,X21LG,X21CL,X21CN,X21CH,X21DC,X21AA,X21RD,X21BR
127023   
127023   %      S T A T U S
127023   %      ***********
127023   
127023   X21AA: IF X2DCN = 0 THEN X21SA; GO LLL FI        % NOT CONNECTED
127027          IF X2DST = 14 THEN X21SB ELSE X21SC FI    % DATA-PHASE OR CONNECTED
127036   LLL:   T:=X2DBC+2=:X2DBC
127041          IF T:=X2DBC<0 THEN                        % ENOUGH MESSAGE SPACE ?
127044            A=:X2DMP.X2MSL; A:=0                    % YES
127047              ELSE
127050            A:=X2FSM                                % NO
127051          FI
127051          CALL X21UT
127052     
127052   %      C A L L 
127052   %      ******* 
127052   
127052   X21CA: IF X2DCN=0 THEN X2FFF; CALL X21UT FI      % MUST CONNECT FIRST
127056          IF X2DST=14 OR X2DCC = 2 THEN A:=X2FIS; CALL X21UT FI  % ILLEGAL COMMAND IN DATA PHASE
127070          IF X2DMP.X2MFA NBIT X21C3 THEN            % DIRECT CALL ?
127074             CALL X2RAC; A=:D; X:=0                 % NO, LOOK FOR "+"      
127077             DO WHILE A><"X21PL"                    % ANY "+" IN SELECTION SIGNAL ?
127102                T:=X2DMP+X2M3; *LBYT
127105                X+1      
127106                IF X>D OR X>15 THEN A:=X2FNP; CALL X21UT FI % NO, ERROR
127115             OD
127116          FI
127116          CALL X211
127117          IF T><0 THEN T=:A; CALL X21ER FI
127123          CALL X212                                 % STATE 2 - 6
127124   LOOP:  CALL X2GET; A=:A
127126             IF X2D10 BIT 6 THEN 0=:TMR; CALL X2112 FI  % DCE READY FOR DATA
127133             IF T = 0  GO LOOP                          % WAIT FOR DATA
127135             IF X2D00="X21SY" OR ="X21PL" OR ="177" THEN GO LOOP FI
127150             IF A="X21ST" OR ="X21SL" THEN
127156                CALL X2110                          % ENTER STATE 10
127157                IF T><0 THEN T=:A; CALL X21ER FI
127163                   ELSE
127164                0=:TMR; CALL X217; X21T3=:TMR       % CALL PROGRESS SIGNALS
127170                IF T><0 THEN T=:A; CALL X21ER FI
127174             FI
127174          GO LOOP 
127175   *)FILL
127206    
127206   %      R E A D Y
127206   %      *********
127206   
127206   X21RE: IF X2DCN=0 THEN X2FFF; CALL X21UT FI      % MUST CONNECT FIRST
127212          IF X2DST=14 OR X2DCC = 2 THEN A:=X2FIS; CALL X21UT FI  % ILLEGAL COMMAND IN DATAPHASE
127224          CALL X211
127225          IF T><0 THEN T=:A; CALL X21ER FI
127231          CALL X218                                 % EXECUTE STATE 8 - 9
127232          DO CALL X2GET; A=:A                       %
127234          WHILE X2D10 NBIT 6
127237             IF T=1 AND X2D00="X21ST" THEN CALL X2110       % CALLING LINE IDENTIFICATION
127247               IF T><0 THEN 0=:TMR; T=:A; CALL X21ER FI  % TOO SMALL MESSAGE
127254             FI
127254          OD
127255          0=:TMR
127256          CALL X2112                                % READY FOR DATA
127257   
127257   
127257   %      C L E A R  R E Q U E S T
127257   %      ************************
127257   
127257   X21CL: IF X2DCN=0 THEN X2FFF; CALL X21UT; FI     % MUST CONNECT FIRST
127263          IF X2DBR >< 0 THEN                        % BREAK REQUESTED
127265            X2FBR =: X2DBR.X2MST                    % 
127270            0=:X2DBR; 4=:X.BBYTC                    % SET BYTECOUNT
127273            CALL O3CHA                             % SEND IT TO USER
127274          FI
127274          CALL X2116; CALL X2121
127276          IF X2DCC=1 THEN                           % EXPECTING CHARGING INFO ?
127302            CALL X21GC                              % GET CHARGING
127303          FI
127303          CALL X21SH; CALL X2SSS; CALL X2114
127306          X21LO=:X2DUI.HXDOK=:X2DUO.HXDOK           % LOCK USER DRIVER
127313          A:=0; CALL X21UT
127315   *)FILL
127333    
127333   %      C O N N E C T  T O  X 2 1
127333   %      *************************
127333   *)FILL
127333   
127333   X21CN: IF X2DCN><0 THEN X2FAC; CALL X21UT FI     % ALLREADY CONNECTED
127337          CALL X2RAC
127340          IF A<16 THEN A:=X2FSM; CALL X21UT FI      % TOO SMALL MESSAGE
127345          A:=X2DMP.X2MSL; CALL LOGPH; A=:X2DUI      % GET USER INPUT DATAFIELD ADR
127351          IF A=0 THEN A:=X2FIL; CALL X21UT FI
127354          A:=X2DMP.X2MSS; CALL LOGPH; A:=D=:X2DUO   % GET USER OUTPUT DATAFIELD ADR
127361          IF A=0 THEN A:=X2FIL; CALL X21UT FI
127364          IF X2DMP.X2MS2=0 THEN A:=CURPR FI
127370          IF A><X2DUO.RTRES  THEN
127374             X2FNR; CALL X21UT                      % NOT RESERVED BY YOU
127376          FI
127376          IF A><X2DUI.RTRES THEN
127402             X2FNR; CALL X21UT                      % NOT RESERVED BY YOU
127404          FI
127404   
127404   %      GET NEW DATAFIELD IF HASP-DMA IS USED
127404   
127404          IF X2DUO.TYPRING BIT 5HDMA THEN
127410            A:=X.CLOGDV; CALL LOGPH A=:X2DUO        % NB SHOULD HAVE BEEN OUTPUT
127413            A:=X2DUI.CLOGDV; CALL LOGPH; A=:X2DUI
127417          FI
127417   
127417   
127417   %      GET HARDWARE DEVICE NUMBER (HDEV)
127417   
127417          A:=X2DUO.HDEV=:HDEV
127422          IF A><X2DUI.HDEV THEN X2FNM=:A; CALL X21UT FI  % NOT MATCHING HDEV 
127431   
127431   %      REROUTE INTERRUPTS TO X21 DRIVER     
127431   
127431          A:=B=:X2NEW; X2DUO=:X2OLD; 
127435          CALL X212S                                % UPDATE LEVEL 12
127436          A:=B=:X2NEW; X2DUI=:X2OLD
127442          CALL X213S                                % UPDATE LEVEL 13
127443          1=:X2DCN; A:=0; CALL X21UT
127447   *)FILL
127457   
127457   %      R E D I R E C T
127457   %      ***************
127457   
127457   X21RD: A:=X2FIC; CALL X21UT
127461   
127461   %      D I S C O N N E C T  F R O M  X 2 1
127461   %      ***********************************
127461   
127461   X21DC: IF X2DCN=0 THEN A:=X2FFF; CALL X21UT; FI  % NOTHING CONNECTED
127465          IF X2DST=14 THEN A:=X2FIS; CALL X21UT; FI % YOU ARE IN DATA PHASE !
127473          A:=B=:X2OLD; X2DUO=:X2NEW; CALL X212S     % REROUTE LEVEL 12
127500          X2DUI=:X2NEW; CALL X213S                  % REROUTE LEVEL 13
127503          A:=0=:X2DCN; CALL X21UT                   % OK, RETURN
127506   
127506   
127506   %      G E T  C H A R G I N G  I N F O R M A T I O N
127506   %      *********************************************
127506   
127506   X21CH: IF X2DCC >< 3 THEN X2FAB; CALL X21UT FI   % NO CHARGING RECEIVED
127514          IF X2DBC>-10 THEN X2FSM; CALL X21UT FI    % TOO SMALL MESSAGE
127522          0=:X2DPC
127523          DO WHILE X2DPC < 14
127527             T:=X2DCI; X:=X2DPC; *LBYT
127532             T:=X2DMP+X2M3; *SBYT 
127535             MIN X2DPC; P+0
127537             MIN X2DBC; P+0
127541             IF A = "X21PL" THEN GO ASD FI
127545          OD
127546   ASD:   0=:X2DCC; A:=0; CALL X21UT
127551   
127551   %      R E T U R N    W H E N    C O N N E C T I O N    B R O K E N
127551   %      ************************************************************
127551   
127551   X21BR: IF X2DST >< 14 THEN X2FBR; CALL X21UT FI  % NOT IN DATAPHASE
127557          X =: X2DBR; 1=:X2DDF
127562          GO FAR X2STA
127563   %*****************************
127563   %
127563   %     X 2 1 COMMAND DECODER
127563   %
127563   %*****************************
127563   
127563   X21C:  X=:X2DMP; A-; A+10=:X2DBC; A:=X.X2MFU-    % POSITIVE FUNCTIONS
127571          IF A < 1 OR > X21PM THEN
127577             A:=X2FIC; CALL X21UT                   % ILLEGAL COMMAND
127601          FI
127601          0=:X2DDF                                   % EXPECTING NO CHARGING INFO
127602          GOSW X21C,FAR X21CA,X21RE,X21CL,X21CH,X21CN,X21DC,X21RD,FAR X21AA,X21BR
127615   RBUS
127635   
127635   %==========================================
127635   % 40.23
127635   %      X 2 1 L V    X 2 1 I N    X 2 1 G C
127635   %
127635   %==========================================
127635   
127635   %***************************************
127635   %
127635   %      INTERRUPT HANDLING ROUTINES
127635   %
127635   %***************************************
127635   
127635   SUBR X21LV,X21IN
127635   
127635   %      LEAVE X21, WAITING FOR INTERRUPT
127635   
127635          INTEGER CPOF(0); *POF
127636   X21LV: A:=L=:X2DL3; *TRA STS 
127641          IF A BIT 10 THEN GO FAR WT13 ELSE GO FAR WT12 FI
127645   %
127645   %
127645   %      LEVEL 12 AND 13 INTERRUPT HANDLING
127645   
127645   X21IN: *TRA STS                                  % WHICH LEVEL ?
127646          IF A BIT 10 THEN                          
127650   
127650   %      LEVEL 13
127650   %      ********
127650   
127650          T:=X2DHD+XRRTS; *EXR ST                   % GET STATUS
127653          A=:X2D10
127654          IF A BIT DCE19 THEN                       % DCE CLEAR INDICATION ?
127656           IF X2DDF >= 0 THEN                       % NOT ENTRY HERE TWICE
127660            A BONE 17 =: X2DDF
127662            IF X2DST >< 25 THEN                     % DON'T CARE IF WAITING FOR DCE TO GET READY *H*
127666              CALL X2120; 1=:WAKEF                  % YES
127671              X21LO=:X2DUI.HXDOK=:X2DUO.HXDOK       % LOCK USER DRIVER
127676              X21T6=:TMR; CALL X2121 
127701              IF X2DCC = 1 THEN CALL X21GC FI       % GET CHARGING IF REQUESTED
127706              CALL X21SH; CALL X2SSS; CALL X2114    % NB X2SSS BRINGS US FROM LEVEL 13 TO LEVEL 12
127711              0=:WAKEF
127712              IF X2DBR >< 0 THEN                    % BREAK REQUESTED ?
127714                X2FBR =: X2DBR.X2MST; 0=:X2DBR      % YES
127720                4=:X.BBYTC; CALL O3CHA             % SEND BREAK MESSAGE FOR USER
127723              FI
127723              IF X2DDF NBIT 0 THEN                  % X21 MODUS ?
127726                X2DST+30=:X2DMP.X2MST; 6=:X.BBYTC   % YES, STATUS TO DCB
127734                CALL O3CHA; 0=:X2DST=:X2DPI=:X2DMP % SEND IT BACK TO USER
127740                1=:X2DDF; GO FAR X2STA              % NOT X21 MODUS ANY MORE
127743              FI
127743              X2DDF BONE 16; A BZERO 17=: X2DDF     % 
127747             FI
127747           FI
127747          FI
127747   
127747   %      ACTIVATE X21 DRIVER ?
127747   
127747          IF X2DDF NBIT 0 OR A BIT 17 THEN          % X21 ACTIONS ?
127754            IF X2DPIN = 0 THEN GO X21LV FI          % NOT PINNED, SKIP IT
127757            A:=X2D10; 0=:X2DPIN; T:=X2DL3=:P        % GO TO X21 ROUTINE
127763          FI
127763   
127763   %      ACTIVATE DATA DRIVER
127763   
127763          IF X2DDF BIT 16 THEN                      % CONNECTION BROKEN ?
127766            A:=X2DUI=:B; T:="DRIVER"+3; A:=HX21M
127773            *IOF; IRW LV13B DA
127775            CALL S3L13; *ION                        % FIRST START DRIVER, THEN RETURN
127777            CALL WT12
130000              ELSE
130001            A:=X2D10                                % 
130002            T:=X2DUI=:B; T:="DRIVER"+3; GO FAR X3T13 % GO TO USER DRIVER
130007          FI
130007          FI
130007   
130007   %      LEVEL 12
130007   %      ********
130007   
130007          IF X2DDF > 0 THEN                         % DATA PHASE ?
130012             A:=X2DUO=:B; GO FAR X3T12                 % YES, GO TO USER DRIVER
130015          FI
130015          A:=X2DL3=:P                               % LEVEL = 12
130017   
130017   RBUS
130036   
130036   SUBR X21GC
130036   
130036   %      ROUTINE FOR RECEIVING CHARGING INFORMATION
130036   %      ******************************************
130036   
130036   X21GC: A:=L=:X2DSL
130040          2=:X2DCC                                  % WAITING FOR CHARGING
130042             CALL X211; X21T7=:TMR; CALL X218       % YES, GET READY FOR IT
130046             0=:X2DPC=:WAKEF
130050   KAST:     CALL X2GET; *JMP *-1
130052                IF X2D00 = "X21BL" OR A = "X21SY" THEN
130061                  GO KAST
130062                FI
130062                0=:TMR
130063                X:=X2DPC; T:=X2DCI; *SBYT           % STORE CHARGING INFO.
130066                MIN X2DPC; P+0                      % IN DATAFIELD
130070                IF X2D00 >< "X21PL" AND X2DPC < 14 THEN
130100                  GO KAST
130101                FI
130101             3=:X2DCC; CALL X2116; CALL X2121       % TERMINATE CHARGING CALL
130105             CALL X211
130106          A:=X2DSL=:P                               % EXIT
130110   RBUS
130115   
130115   %============================
130115   % 40.24
130115   %      X 2 1 T O    X 2 G E T
130115   %
130115   %============================
130115   %**********************
130115   %
130115   %      TIMOUT HANDLING
130115   % 
130115   ***********************
130116   
130116   %      NON RESIDENT PART
130116   
130116   SUBR X21TO
130116   X21TO: IF X2DPIN = 0 THEN GO FAR WT13 FI         % NOT PINNED, SKIP IT
130121          0=:X2DPIN
130122          IF X2DCC = 2 THEN 0=:X2DCC; CALL X2114; GO FAR WT13 FI          % WAITING FOR CHARGININFO ?
130131          IF X2DST = -1 THEN CALL X2114; X2F01; CALL X21UT; FI  %
130140          IF X2DST = 3 THEN CALL X21SH; CALL X2SSS; CALL X2114; A:=33; CALL X21UT FI  % STATE 1, STATE 14
130151          IF X2DST = 25 THEN CALL X2114             % HAVE SEEN DCE CLEAR, TIMOUT FOR 21
130156            IF X2DDF NBIT 0 THEN                      % X21 MODUS?
130161              55; CALL X21UT                        % 55 MEANS TIMOUT IN STATE 25
130163            ELSE
130164              IF X2DBR >< 0 THEN
130166                X2FBR =: X2DBR.X2MST; 0=:X2DBR
130172                4=:X.BBYTC; CALL O3CHA
130175              FI
130175              X21LO=:X2DUI.HXDOK=:X2DUO.HXDOK
130202              60000; T:=X2DUI=:B; T:="DRIVER"+3; GO FAR X3T13  % ACTIVATE DRIVER, 60000 MEANS CONNECTION BROKEN BY X21
130210            FI
130210          FI
130210          IF X2DER >< 0 THEN CALL X21SH; CALL X2SSS; X2F01; CALL X21UT; FI          % ERROR IN ERROR SEQUENCE
130216          X2DST+30; CALL X21ER
130221   RBUS
130232   %*****************************************************************************
130232   %
130232   %      WAIT FOR ANY INPUT REACTION    
130232   %      THE INPUT CHARACTER IS STORED IN X2D00 IN DATAFIELD
130232   %      STATUS IS SAVED IN X2D10
130232   %
130232   %      RETURN: SKIP IF INPUT DATA ELSE NOSKIP
130232   %
130232   %*****************************************************************************
130232   
130232   SUBR X2GET
130232   X2GET: A:=L=:X2DLS; -2=:X2D0C                    % SAVE RETURN ADDRES 
130236          X2D11; T:=X2DHD+XWRTC; *EXR ST            % ENABLE RECEIVER, C = ON
130242          1=:X2DPI; CALL X21LV                      % PINNED FOR INPUT (SEE X21TO)
130245          A=:X2D10                                  % SAVE IT
130246          IF A BIT 1 THEN                           % STATUS AVAILABLE
130250                T:=X2DHD+XRRSR; *EXR ST             % GET STATUS
130253                A=:X2D02
130254          FI
130254          IF X2D10 BIT 0 THEN                       % ANY DATA AVAILABLE
130257             T:=X2DHD+XRRDR; *EXR ST                % GET DATA
130262             A BZERO "7" =:X2D00; X2DLS+1=:X2DLS    % SKIP RETURN IF DATA
130267             T:=1                                   % T = 1  I.E DATA
130270          ELSE
130271             T:=0                                   % T = 0 I.E NO DATA
130272          FI
130272   OUT:   A:=X2DLS=:P                               % NO DATA, NO SKIP
130274   RBUS
