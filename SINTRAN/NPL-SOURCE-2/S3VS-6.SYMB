112523   *"8XMSG+8CXHD+8C1X2+8C2X2+8C3X2+8C4X2
"112523   
112523   %==============================================================================
112523   %
112523   % 40.9      GENERAL BUFFER ALLOCATION PACKAGE - ZB... for XMSG and HDLC
112523   %
112523   %==============================================================================
112523   SUBR ZBINI,ZBGET,ZBREL
112523   %
112523   %      THIS PACKAGE IS BASED ON THE CERN SMO MEMORY ALLOCATION PACKAGE. IT
112523   % ALLOCATES BUFFERS OF SIZE MULTIPLE OF FOUR WORDS. THE FIRST WORD OF EACH 
112523   % BUFFER IS USED BY THE ALLOCATION PACKAGE AND CONTAINS:
112523   %      BIT 0 : SET IF THE BUFFER IS FREE (ZBCFR)
112523   %          1 : SET IF PRECEDING BUFFER IS FREE (ZBPFR)
112523   %       2-15 : BUFFER LENGTH IN MULTIPLE OF FOUR WORDS
112523   %
112523   %      IF THE BUFFER IS FREE (BIT 0 SET), THE LAST WORD OF THE BUFFER CONTAINS
112523   % THE ADDRESS OF ITS START (FOR CONCATENATION OF FREED BUFFERS.)
112523   %
112523   %      THE USER OF THIS PACKAGE MUST PROVIDE OF BUFFER AREA DESCRIPTOR OF 4
112523   % WORDS, WHICH MUST BE POINTED AT BY X ON ENTRY TO THESE ROUTINES:
112523   %
112523   DISP 0
112523          INTEGER ZBBNK         % BANK NO WHERE BUFFER AREA LIES (=0 IF N10)
112523          INTEGER ZBSTR         % ADDRESS OF FIRST WORD USED IN BANK FOR BUFFERS
112523          INTEGER ZBEND         % ADDRESS OF LAST WORD USED IN BANK FOR BUFFERS
112523          INTEGER ZBSAV         % SAVE LOCATION FOR USER B-REG
112523   PSID
112523   SYMBOL ZBCFR=0,ZBPFR=1       % BITS IN THE HEADER (DO NOT CHANGE - SEE CODE)
112523   %
112523   %      FUNCTIONS PROVIDED MUST BE CALLED WITH X POINTING TO THE DESCRIPTOR.
112523   % THE RETURN WILL BE BY SKIP RETURN UNLESS A FATAL ERROR IS DETECTED IN WHICH 
112523   % CASE A WILL CONTAIN AN ERROR CODE: 
112523   SYMBOL ZBX01=1               % BANK NO >< 0 AND CPSTA SAYS THIS IS A N10
112523   SYMBOL ZBX02=2               % NOT ENOUGH BUFFER SPACE TO INITIALISE
112523   SYMBOL ZBX03=3               % INCONSISTENCY IN BUFFERS FOUND BY ZBGET
112523   SYMBOL ZBX04=4               % ILLEGAL USER BUFFER ADDRESS TO ZBREL
112523   %
112523   %      FUNCTIONS ARE:            (B -> BUFFER AREA DESCRIPTOR)
112523   %
112523   % ZBINI:     INITIALISE BUFFER AREA
112523   %            T=BANK NO, A=ADDR OF FIRST WORD TO USE, D=ADDR OF LAST WORD
112523   %
112523   % ZBGET:     GET BUFFER SPACE
112523   %            A=NO OF BYTES
112523   %      SKIP: A:=USER BUFFER ADDRESS ( OR 0 IF NONE AVAILABLE ) 
112523   %            NB: This is the address of the first USABLE word in the buffer
112523   %
112523   % ZBREL:     RELEASE BUFFER SPACE
112523   %            A=USER BUFFER ADDRESS
112523   %
112523   INTEGER ZBMSK:=177774
112524   INTEGER POINTER ZBCPS:=CPSTA
112525   
112525   ZBINI: X:=:B=:ZBSAV; T=:ZBBNK;                   % INITIALISE DESCRIPTOR
112530          IF T><0 AND X:=ZBCPS NBIT 5N100           % BANK><0 AND NOT N100
112533          THEN ZBX01; GO ZBOUT; FI                  % NOT ALLOWED
112537          X:=ZBMSK; A+3/\X=:ZBSTR; X/\D=:ZBEND      % ROUND START UP, END DOWN
112545          IF A+10>>=X THEN ZBX02; GO ZBOUT; FI      % NOT ENOUGH SPACE
112552          X-1; *STATX 0; SAA 2; STATX 10            % BACKPTR. LENG=0, PREV. FREE  
112556          X:=ZBSTR; ZBEND-X BONE ZBCFR; *STATX 0    % SET LENGTH & FREE.
112563          GO ZBOKR                                  % SKIP RETURN
112564   
112564   ZBGET: X:=:B=:ZBSAV                              % SAVE USER B-REG. B->DESCR.
112566          A SHZ -1; *BSKP ZRO SSM; RINC DA          % A=NUMBER OF USER WORDS
112571          A+4/\ZBMSK=:D; X:=ZBSTR                   % D=NUMBER OF WORDS NEEDED
112575          DO WHILE X><ZBEND                         % SCAN DOWN BUFFERS
112600                ZBX03; IF X>>T OR X<<ZBSTR GO ZBOUT % BUFFERS DESTROYED!
112606                T:=ZBBNK; *LDATX 0                  % GET HEADER WORD
112610                IF A BIT ZBCFR AND A>>=D THEN       % SPACE AVAILABLE?
112614                     A BZERO ZBCFR :=:D; * STATX 0  % SET NEW LENGTH IN HEADER
112617                     % NOW HAVE: X=BUFAD, A=NEWSIZE, D=OLDSIZE, T=BANK NO
112617                     D-A; A+X:=:X                   % D=REMNANT, A=USER BUF, X=NEW 
112622                     IF D=0                         % FILLED WHOLE BUFFER?
112622                     THEN D:=A; * LDATX 0           % GET HEADER OF NEXT BUFFER
112626                          A BZERO ZBPFR; * STATX 0  % CLEAR PREVIOUS FREE
112630                          A:=D                      % RECOVER USER ADDRESS
112631                     ELSE; * STATX 10               % SAVE USER ADDR IN NEW BUF(1)
112633                          A:=D BONE ZBCFR; *STATX 0 % BUILD NEW HEADER
112636                          X=:A+D-1; * STATX 0       % SET BACK POINTER
112642                          X:=A; * LDATX 10          % RECOVER USER ADDRESS
112644                     FI;
112644                     A+1; GO ZBOKR                  % RETURN WITH USER ADDR.
112646                FI; A/\ZBMSK+X=:X                   % TRY NEXT
112651          OD;
112652          A:=0; GO ZBOKR                            % NO SPACE LEFT
112654   
112654   ZBREL: X:=:B=:ZBSAV; A-1=:X/\ZBMSK               % CONVERT USER->BUFFER ADDR
112661          IF A><X OR A<<ZBSTR OR A>>=ZBEND GO ZBIOW % CONSISTENCY CHECKING
112671          T:=ZBBNK; * LDATX 0                       % GET BUFFER HEADER
112673          IF A BIT ZBCFR THEN GO ZBIOW; FI          % SHOULD BE ALLOCATED
112676          A/\ZBMSK; X=:D+A; * LDATX 0               % GET HEADER OF NEXT BUFFER
112702          IF A BIT ZBCFR THEN A/\ZBMSK; X+A; FI     % IF FREE FIND ONE AFTER
112706          X:=:D; * LDATX 0                          % GO BACK TO ORIGINAL.
112710          IF A BIT ZBPFR                            % IF PREVIOUS FREE
112710          THEN X-1; * LDATX 0; COPY DX SA           % GET POINTER TO START OF PREV
112715          FI
112715          % WE NOW HAVE X=START OF NEW (CONCATENATED) BUFFER, D=START OF NEXT
112715          A:=D-X BONE ZBCFR; * STATX 0              % SET HEADER OF NEW
112721          X=:A:=D-1; * STATX 0; LDATX 10            % SET BACK PTR, GET NEXT HEAD
112726          A BONE ZBPFR; * STATX 10                  % SET PREVIOUS FREE
112730   ZBOKR: L+1; GO ZBOUT                             % SKIP RETURN SEQUENCE
112732   ZBIOW: ZBX04;                                    % ILLEGAL BUFFER ADDRESS
112733   ZBOUT: X:=ZBSAV:=:B; EXIT                        % RESTORE USER B AND X-REGS
112736   RBUS
112736   %==================== END OF BUFFER ALLOCATION ROUTINES (ZB...) ==============
112736   
112736   
112736   *"8LPPU
"112736   %==============================================================================
112736   % 33.10      L P P U T
112736   %
112736   @MAC

)9SCLC
112736  % LINE PRINTER COVERTING ROUTINES
112736  PTABL=*
112736  PTABL<PTABL 27
112736  )ZERO
112736  % INSERT INPUT AND OUTPUT VALUES HERE
112736  %
112736  160;30
112740  44;135
112742  135;134
112744  43;133
112746  100;134
112750  0
112751  PTABL 20/
112756  % IOTRANS ROUTINE FOR LINE PRINTER
112756  % THE CHARACTERS IN PTABL ARE CONVERTED
112756  LPPUT, COPY  SX DD
112757         LDX   (PTABL
112760         BSET ZRO 70 DA
112761         LDT ,X
112762         SKP   DT UEQ 0
112763         JMP   PCON1
112764         SKP   DT UEQ SA
112765         JMP   * 3
112766         AAX   2
112767         JMP   LPPUT 3
112770         LDA   1 ,X
112771  PCON1, SAT   0
112772         SAX   -10
112773         BSET  ZRO 70 DA
112774         SHA   10
112775         JAP   *+2
112776         AAT   1
112777         SHA   ROT 1
113000         JNC   *-3
113001         BSKP  ZRO 00 DT
113002         BSET  ONE 70 DA
113003         COPY  SD DX
113004         JMP I (TRTPU
113005  )FILL
113007  )9RCLC
)9SLPL113007   *"
"113007   
113007   %==============================================================================
113007   % 37.15      D P R I N T
113007   
113007   % SUBROUTINE TO PUT TEXT DIRECTLY INTO TERM.1-BUFFER
113007   % ENTRY:     A=TEXT POINTER
113007   SUBR DPRINT
113007   INTEGER TRTX,LREG,BREG,XREG
113013   DPRINT:  A=:TRTX:=L=:LREG:=B=:BREG:="DT01W"=:B; X=:XREG:=0; *IOF
113025   @LIB CXCPU
113025   @LIB CXCPU-,
113025          DO T:=TRTX; *LBYT
113027                WHILE ><##'
113032                CALL RBPUT; X+1
113034          OD; -1=:TMR
113037   @ELIB
113037          *ION
113040          X:=LREG=:L:=BREG=:B:=XREG; EXIT
113046   RBUS
113050   
113050   @LIB CXCPU
113050   
113050   
113050   *9EPT3=*                     % END OF CODE MAPPED INTO PAGE TABLE 3
113050   
113050   
113050   %==============================================================================
113050   % 37.1       C T R D I S K   B U S Y E   M D R I V   P F E I L
113050   %            C O O P T   D R F E I L
113050   %
113050   % LEVEL 11 ROUTINE TO PERFORM DRUM/DISK TRANSFERS
113050   % ACTIVATED BY MTRANS, WITH B=DATAFIELD, X=ABSTR PAR.LIST
113050   
113050   
113050   SUBR CTRDISK,BUSYE,MDRIV,PFEIL,COOPT,DRFEIL
113050   
113050   DISP 0; DOUBLE POINTER DP1=P1; PSID
113050   DISP 12; INTEGER TMRFLG; PSID
113050   DISP 0; DOUBLE DITARG=CTRG,DIDXRG=CDRG; PSID
113050   INTEGER  CBLDA(0); *BLDA 00 DT
113051   INTEGER CUN=?
113051   
113051   CTRDISK: X:=:B; CALL PICKFPAR; IF A=0 AND D=0 THEN CALL ERRFATAL FI
113057          AD=:X.MEMAD; A/\3; A SH 14+T=:X.CTRG
113064          A SHZ -6/\7 SH 3\/CBLDA
113070          T:=X.M2UNTYP; *EXR SA
113072          IF K THEN
113074             X.CTRG BONE 16=:X.CTRG; 0=:X.CARG       % IF PHOENIX DISC
113100          ELSE
113101             X.CTRG/\7000 SHZ -11=:X.CARG
113105          FI
113105          IF X.CTRG/\77>=60 AND A<=63 THEN
113115             X.CTRG/\177717=:X.CTRG; CALL PICKYLPAR; AD=:X.CADRG
113122          ELSE
113123             CALL PICKLPAR; A=:X.CDRG
113125          FI; T=:X.CXRG
113126          X=:B; CTRG=:TRGINI
113131          IF A/\77=36 THEN                                    % READ ELEMENT IN "DISC-LAYOUT-TABLE"
113135             0=:HSTAT; AD:=MEMAD; *EXAM                       % T=FORMAT NUMBER
113140             IF 40>T AND DISPE(T)><0 THEN                     % 37 IS MAX FORMAT NUMBER
113146                T:=MEMA1; X:=MEMA2; B=:L:=A; "DILEZ"=:D
113154                DO WHILE D><0                                 % COPY "DISC LAYOUT TABLE" ELEMENT TO "DMA-BUFFER"
113156                   S0; *STATX
113160                   X+1; D-1; B+1
113163                OD; B:=L
113165             FI; GO FAR FIN; *)FILL
113202          FI
113202          IF A=42 AND "TRNSF"><"BDISK" GO FAR FIN   % READ FORMAT NOT LEGAL IN DRIVER
113211                                                    % BUT GIVE NO ERROR MESSAGE
113211          IF TMR><0 THEN CALL ID11 FI; 0=:TMRFLG
113215   *"8DILG
"113215   NOTLOG: 0=:HSTAT; 1=:DIFTCOUNT                             % ONE RESTART BY TIMRT IS MAX
113220   *"8DILG
"113220   LOOP:                                                      % FOR TRANSF AND COMPARE
113220                TACNS=:TACOU
113222                FOR TACOU DO                                  % FOR EACH ERROR
113222                   AD:=MEMAD=:CMADR
113224   CREST:          CTADRG=:TADRG; X:=CXRG=:XRG
113230                   DO                                         % FOR EACH PHYSICAL TRANSFER
113230                      TTMR=:TMR; A:=ARG
113233                      CALL TRNSF; GO ERROR; GO BUSY; GO FINISH
113237   BUSYE:             TAD=:TADRG; X=:XRG; CALL ID11           % WAIT FOR INTERRUPT
113242                      IF TMR=0 THEN                           % TIMEOUT
113244   *"8DILG
"113244                         IF HSTAT><0 GO FAR ERTMOUT
113247                         -1=:HSTAT
113251                      FI
113251                         
113251   MDRIV:             TADRG; X:=XRG
113253                   OD
113254   
113254   PFEIL:          IF X NBIT 16 AND DIFTCOUNT><0 THEN         % NOT ON CYLINDER
113260                      A-1=:DIFTCOUNT; CALL ID11; GO CREST     % TIMRT REACTIVATE DRIVER
113264                   FI
113264   DRFEIL:         X BONE 4 =:HSTAT; AERRB\/X=:AERRB; MIN ERCNT; 0/\0
113273   *"8DILG
"113273                   IF SERRB/\X><0 GO FIN  %SERIOUS
113276                   IF X BIT 12 THEN TRGINI=:CTRG FI
113302                OD; GO FIN; *)FILL
113311   *"8DILG
"113311   
113311   COOPT:       X=:HSTAT
113312   *"8DILG
"113312                IF COMFL=0 GO FIN
113314                IF TRG/\7=3 GO FIN                  % COMPARE HAS BEEN EXECUTED
113321                IF "TRNSF"="BDISK" GO FIN           % NO COMPARE ON ECC DISKS
113325                IF CTRG/\77>1 GO FIN                % COMPARE FOR FUNCTION 0 AND 1
113332                177770/\TRG\/3=:CTRG                % SET COMPARE
113336          GO FAR LOOP; *)FILL
113344   
113344   FIN:
113344          IF CTRG/\77=42 THEN                                 % READ FORMAT
113351             CTRG SHZ -6/\7=:X                                % X=UNIT NUMBER
113355             X:=HTABL(X); T:=X.DISPN; AD:=MEMAD; *DEPO        % RETURN FORMAT NUMBER IN FIRST LOCATION OF "DMA-BUFFER"
113361             0=:HSTAT                                         % NO ERROR MESSAGE
113362          FI
113362   
113362          0=:TMR; IF RTRES><0 THEN CALL RTACT FI
113366          IF HSTAT BIT 4 THEN
113371                HDEV; T:=TRG SH 7 SHZ -15; CALL 9ERR(#20)
113377                DRG; T:=HSTAT; CALL 9ERR(#21)
113403          FI
113403   FINE:  CALL ID11; A+1; GO ERR22
113406   *)FILL
113414   
113414   ERTMOUT: HDEV; T:=TRG SH 7 SHZ -15; CALL 9ERR(#26)         % DEVICE TIMEOUT
113422            HSTAT BONE 4=:HSTAT; GO FINE
