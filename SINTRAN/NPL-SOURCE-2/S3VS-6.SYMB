071610   SYMBOL SBMAX=100             % MAX NUMBER OF BUFFERS IN PACKET
071610   %
071610   %============================================================================
071610   %         DATA FIELD DESCRIPTORS
071610   %
071610   %============================================================================
071610   % 35.21      P O O L   H E A D
071610   
071610   DISP -1
071610   INTEGER WPVER                % VERIFICATION VALUE OF POOL HEAD
071610   SYMBOL SPCOR=125252          % CORRECT VALUE OF WPVER
071610   INTEGER WFREE                % ADDRESS OF FIRST FREE BUFFER, =0 IF EMPTY
071610   INTEGER WNFRE                % NUMBER OF FREE BUFFERS IN POOL
071610   INTEGER WLLIM                % LOWER ADDRESS OF BUFFER POOL
071610   INTEGER WHLIM                % HIGHER ADDRESS OF BUFFER POOL
071610   INTEGER WBFSZ                % BUFFER SIZE , NO. OF WORDS
071610   PSID
071610   
071610   
071610   %============================================================================
071610   % 35.22      Q U E U E   H E A D
071610   
071610   DISP 0
071610   INTEGER WLPAK                % ADDRESS OF LAST PACKET IN QUEUE
071610                                % EQUAL TO QUEUE HEAD IF QUEUE EMPTY
071610   INTEGER WFPAK                % ADDRESS TO FIRST BUFFER IN QUEUE
071610                                % EQUAL TO QUEUE HEAD IF EMPTY
071610   INTEGER WPNUM                % NUMBER OF PACKETS IN QUEUE
071610   INTEGER WPROC                % ADDRESS OF OWNER OF QUEUE
071610   PSID
071610   
071610   
071610   %============================================================================
071610   % 35.23      P A C K E T   H E A D
071610   
071610   %      2.3.1 GENERAL OFFSETS, PACKET HEAD AND WXX
071610   %            TO BE USED WITHIN GLOB-DEF, ONLY !!!
071610   
071610   SYMBOL SLHW=400              % MULTIPLIER FOR LEFT HALFWORD
071610   SYMBOL S1QW=10000            % MULTIPLIER FOR 1 QUARTERWORD
071610   SYMBOL S3QW=20               % MULTIPLIER FOR 3 QUARTERWORD
071610   SYMBOL S1OCT=40000           % MULTIPLIER FOR 1 OCTET
071610   SYMBOL S3OCT=2000            % MULTIPLIER FOR 3 OCTET
071610   SYMBOL S5OCT=100             % MULTIPLIER FOR 5 OCTET
071610   SYMBOL S7OCT=4               % MULTIPLIER FOR 7 OCTET
071610   SYMBOL SRHW=1                % MULTIPLIER FOR RIGHT HALFWORD
071610   
071610   %============================================================================
071610   % 35.24      GENERAL FIELDS, PACKET HEAD AND WDW'S
071610   %            TO BE USED WITHIN GLOB-DEF ONLY !!!
071610   %
071610   SYMBOL SRHWMASK=377          % RIGHT HALFWORD MASK
071610   SYMBOL SLHWMASK=-SRHWMASK-1  % LEFT HALFWORD MASK
071610   SYMBOL S1QWMASK=17*S1QW      % 1. QUARTER WORD MASK
071610   SYMBOL S2QWMASK=17*SLHW      % 2. QUARTER WORD MASK
071610   SYMBOL S3QWMASK=17*S3QW      % 3. QUARTER WORD MASK
071610   SYMBOL S4QWMASK=17*SRHW      % 4. QUARTER WORD MASK
071610   SYMBOL C1QWMASK=-S1QWMASK-1
071610   SYMBOL C2QWMASK=-S2QWMASK-1
071610   SYMBOL C3QWMASK=-S3QWMASK-1
071610   SYMBOL C4QWMASK=-S4QWMASK-1
071610   %
071610   %============================================================================
071610   % 35.25      ACTUAL PACKET HEAD LAY-OUT
071610   %
071610   DISP SPDISP=0
071610   INTEGER WNBUF                % ADDRESS OF NEXT BUFFER IN PACKET
071610   INTEGER WNPAK                % ADDRESS OF NEXT PACKET IN QUEUE
071610   INTEGER WPOSS                % ADDRESS OF OWNER OF PACKET
071610   INTEGER WDUM                 % DUMMY
071610   INTEGER WTYP,WSCOM=WTYP                          % WORD FOR MESSAGE TYPE &  FORMAT
071610   INTEGER WBC,WSEQ=WBC                             % WORD FOR BYTE COUNT & SEQUENCE CONTROL
071610   INTEGER WDEA,WPRI=WDEA                           % DESTINATION ADDRESS AND PRIORITY
071610          SYMBOL SPRIMASK=3*S1OCT                   % MSG PRIORITY
071610          SYMBOL CPRIMASK=-SPRIMASK-1
071610          SYMBOL SPRISHIFT=-16
071610          SYMBOL CPRISHIFT=-SPRISHIFT
071610   DOUBLE  WDADR=WDEA                               % BOTH ADDRESSES
071610   INTEGER WSCA                                     % SOURCE ADDRESS
071610   PSID
071610   *)KILL SLHW S1QW S3QW S1OCT S3OCT S5OCT S7OCT SRHW
071610   *)KILL SRHWM SLHWM S1QWM S2QWM S3QWM S4QWM
071610   *)KILL C1QWM C2QWM C3QWM C4QWM
071610   
