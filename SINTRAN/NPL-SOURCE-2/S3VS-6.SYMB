110000   @LIB CXCPU
110000   
110000   
110000   %==============================================================================
110000   % 37.2       S T T I N   T Y E N T
110000   %
110000   % TERMINAL INPUT DRIVER, LEVEL 12
110000   %
110000   % THE X-REGISTER MUST POINT TO THE OUTPUT DATAFIELD IN ALL THE
110000   % ROUTINES CALLED BY THIS DRIVER
110000   %
110000   INTEGER 12DFOPP,10DFOPP,IISTATE,OISTATE
110004   SUBR STTIN,TYENT
110004   SYMBOL 5PIP=17
110004   @LIB CXCPU
110004   STTIN:
110004   RETURN: TTMR=:TMR
110006          CALL ID12                                 % WAIT FOR INTERRUPT
110007   TYENT: ISTATE=:IISTATE
110011   @LIB CXCPU
110011   @LIB CXCPU-,
110011          X:=DFOPP=:12DFOPP
110013   @ELIB
110013          CALL IOAPD; GO RETURN                     % READ CHARACTER
110015          IF T:="ROUSPEC"><0 THEN
110020             D:=0; CALL ROUSPEC; GO RETURN; GO OKCHAR
110024          FI; A BZERO 7=:LAST                       % SAVE IN DATAFIELD
110026          CALL XONREAD; GO RETURN  
110030   OKCHAR: BRECHOFL/\170=:BRECHOFL                  % CLEAR BREAK/ECHO FLAG
110033          A := LAST/\377; CALL XONCHECK             % TEST FOR XON/XOFF OUT.
110036          IF DFLAG BIT 5CAPITAL THEN                % CONVERT LOWER CASE TO UPPER CASE
110041             LAST/\177=:T
110044             IF 140<T AND 176>T AND CESCP SHZ -10><T AND CESCP/\377><T THEN
110062                LAST BZERO 5=:LAST                  % CONVERT ALL EXEPT
110065             FI                                     % RUBOUT  AND DISCONNECT
110065          FI
110065          IF X><0 AND X.SCREEN><0 THEN              % TWO WAY DEVICE WITH CR-DELAY
110070                IF <0 THEN -1=:X.TMR FI
110073                1=:X.SCREEN
110075                IF LAST=0 THEN                      % IGNORE TAPE-FEED?             
110077                  IF FLAGB NBIT 5LCHAR GO RETURN
110102                  IF CESCP SHZ-10><0 GO RETURN
110105                FI
110105          FI
110105          IF T:=DFLAG NBIT 5SPEC AND T NBIT 5CTRLO THEN
110112             CALL ESCAPE; GO RETURN; X:=12DFOPP
110115          FI
110115          IF DFLAG NBIT 5CTRLO THEN
110120             IF LAST/\377=17 THEN
110125                DFLAG BONE 5CTRLO=:DFLAG
110130             FI
110130          ELSE
110131             DFLAG BZERO 5CTRLO=:DFLAG
110134          FI
110134          IF CFREE=0 THEN
110136             TINFO BONE 5BFUL=:TINFO; GO BFULL      % BUFFER IS FULL, RESTART USER
110142          FI
110142          GO L1; *)FILL
110155   L1:   *IOF
110156          IF DFLAG BIT 5ECHO THEN
110161               LAST/\377
110163               CALL TECHO                 %TEST FOR ECHO
110164               CALL TBREAK                %TEST FOR BREAK
110165               X:=12DFOPP
110166          ELSE
110167               IF IISTATE=-1 THEN; *ION   % NOWAIT MODE 
110174                  LAST/\377; CALL CXRBPUT; GO BFULL
110200               FI
110200          FI
110200         *ION
110201          IF BRECHOFL BIT 5ECHO THEN CALL ECHSUBR FI             % ECHO CHAR?
110205          IF BRECHOFL<0 THEN 7=:LAST; CALL ECHSUBR; GO RETU FI   % IGNORE CHAR?
110213   
110213   ADDCH: LAST/\377; CALL CXRBPUT                   % PUT CHARACTER IN BUFFER
110216   
110216          IF BHOLD>=MAX-10 AND BRECHOFL NBIT 5BREAK GO BFULL % FULL BUFFER
110226          IF BRECHOFL BIT 5BREAK THEN               % BREAK ACCORDING TO STRATEGY
110231             DFLAG BZERO 5ECHO                      % ECHO OFF IN DRIVER
110233             IF X:=FYLLE=HENTE THEN
110237                A BONE 5ALEC                        % WHOLE BUFFER IS ECHOED BY DRIVER
110240             ELSE
110241                A BZERO 5ALEC                       % PART OF BUFFER MUST BE ECHOED BY IOTRANS
110242             FI; A=:DFLAG; X=:RSISTE                % RSISTE IS FIRST CHARACTER NOT ECHOED 
110244          ELSE               
110245             GO RETU   
110246          FI
110246   
110246   BFULL: CALL TSTBACK                              % RESTART PROGRAM
110247   *"8N500
"110247   *"-8N500
"110247   @LIB CXCPU-,
110247          "IORESTART"=:MFUNC; CALL RTACT
110252   @ELIB
110252   @LIB CXCPU
110252   *"
"110252   
110252   RETU:  IF "ROUSPEC"><0 THEN
110254             D:=1; X:=12DFOPP; CALL ROUSPEC; GO FAR OKCHAR   
110260          FI
110260          GO FAR RETURN
110261   XRETU: *ION
110262          GO RETU
110263   *)FILL
110277   %
110277   %%  ECHO:
110277   INTEGER  LREG
110300   ECHSUBR: *IOF
110301          A:=L=: LREG
110303          IF X.CFREE=0 THEN
110305             *ION
110306             GO FAR RETURN
110307          FI
110307          IF X.MINBHOLD BIT 5BLOC THEN    % OUTPUT BUFFER LOCKED
110312             DFLAG BZERO 5ECHO=:DFLAG; BRECHOFL BZERO 5BREAK=:BRECHOFL
110320             -1=:RSISTE; *ION
110323             GO FAR ADDCH
110324          FI
110324          LAST/\377; X:=:B
110327          IF T:=EMPTFLAG><0 AND T:=X.DFLAG NBIT 5OXON THEN
110335             IF T:=TYPRING BIT 5CRDLY THEN CALL CHDL1 FI
110341             CALL ECAPD
110342          ELSE
110343   PIBUF:    CALL CXRBPUT
110344          FI
110344          X:=:B; LREG =: L
110347          *ION
110350          EXIT; *)FILL
110357   
110357   ECAPD: A=:D; T:=HDEV+DST; *IOXT                      % READ STATUS        
110363          IF A BIT 3 THEN                               % READY FOR TRANSFER
110365             D=:A; T-DST+DDW; *IOXT                     % WRITE CHARACTER
110371             "DACT"; T-DDW+DCONT; *IOXT                 % ACTIVATE
110375             EXIT
110376          ELSE                                          % NOT READY
110377             0=:EMPTFLAG; "DACT+DPIN"                  
110401             T-DST+DCONT; *IOXT                         % ACTIVATE AND PIN
110404             D=:A; GO PIBUF                             % ECHO VIA OUTPUT-BUFFER
110406          FI
110406          EXIT
110407   RBUS
110407   %
110407   %
110407   %=================================================================
110407   %37.2A      TECHO
110407   %
110407   %  TEST FOR ECHO:
110407   %  THIS SUBROUTINE SHOULD BE CALLED WITH INTERRUPTS OFF!!
110407   %
110407   SUBR TECHO
110407   INTEGER CHARN; INTEGER POINTER LREG
110411   SYMBOL 5PIP=17
110411   TECHO: A=:CHARN; A:=L=:"LREG"
110414          IF X:=ECHOTAB><0 THEN
110416             A:=CHARN; CALL VSXGETBIT
110420             IF A<0 THEN                  % NO ECHO 
110421                IF X:=ECHOTAB><"ECH0" AND X><"ECH1" AND X><"ECH2" THEN
110433                   BRECHOFL BONE 5PIP=:BRECHOFL    
110436                FI
110436             ELSE                         % ECHO 
110437                IF DFLAG NBIT 5SPEC AND A NBIT 5HDUP THEN
110444                   BRECHOFL BONE 5ECHO BZERO 5PIP=:BRECHOFL   
110450                FI
110450             FI
110450          FI
110450         CHARN; GO LREG
110452   RBUS
110456   %========================================================================
110456   % 37.2B       TBREAK
110456   %
110456   %     TEST FOR BREAK:
110456   %     THIS ROUTINE SHOULD BE CALLED WITH INTERRUPTS OFF!!
110456   %
110456   SUBR TBREAK
110456   INTEGER CHARN; INTEGER POINTER LREG
110460   SYMBOL 5PIP=17
110460   TBREAK: A=:CHARN; A:=L=:"LREG"
110463           IF DFLAG BIT 5SPEC THEN        %UNCONDITIONAL BREAK, NO ECHO.
110466              0=:NCBRK                    
110467              A BZERO 5SPEC BZERO 5CTRLO=:DFLAG
110472              BRECHOFL BONE 5BREAK BZERO 5ECHO=:BRECHOFL
110476           ELSE
110477              IF X:=BRKTAB><0 THEN
110501                 IF BRECHOFL>=0 THEN MIN NCBRK; 0/\0; FI
110505                 IF BRKTAB="BRK1" AND CHARN/\177=17 OR =20 OR =26 OR =30 OR =32 THEN
110532                    DFLAG BONE 5SPEC =:DFLAG    %BREAK ON NEXT
110535                 ELSE  
110536                    A:=CHARN; CALL VSXGETBIT
110540                    IF A<0 THEN                 %BREAK ON CHARACTER
110541                       0=:NCBRK
110542                       BRECHOFL BONE 5BREAK BZERO 5PIP=:BRECHOFL  
110546                    ELSE                        %POSSIBLE BREAK ON MAX CHARS. 
110547                       IF BRKMAX><0 AND A<<=NCBRK THEN
110554                          0=:NCBRK
110555                          BRECHOFL BONE 5BREAK=:BRECHOFL 
110560                       FI
110560                    FI
110560                 FI
110560              FI 
110560           FI; CHARN; GO LREG;  *)FILL
110565   RBUS
110565   
110565   %==============================================================================
110565   % 37.3       T T G E T     T D G E T
110565   %
110565   % TTGET:     TERMINAL IOTRANS ROUTINE. CALLED VIA DATAFIELD TO GET A
110565   %            CHARACTER FROM BUFFER.
110565   %            SKIP-RETURN : A = CHARACTER
110565   %            RETURN      : BUFFER EMPTY  
110565   %                        : OR TERMINAL NOT CONNECTED (DERROR=316)
110565   %
110565   % TDGET:     TERMINAL IOTRANS ROUTINE 2. CALLED DIRECTLY.
110565   %            ROUTINE RETURNS CHARACTERS FROM BUFFER AND CHECKS FOR
110565   %            BREAK CONDITIONS IN DATA
110565   %            SKIP-RETURN : A = CHARACTER
110565   %                          T = 0: NO BREAK, T = 1: BREAK CONDITION
110565   %            RETURN      : BUFFER EMPTY
110565   %                        : OR TERMINAL NOT CONNECTED (DERROR=316)
110565   %
110565   SUBR TTGET,TDGET
110565   INTEGER CHARN,XREG,INPTY; INTEGER POINTER LREG
110571   INTEGER CDFOP
110572   TDGET: A:=0; GO FELLS
110574   TTGET: A:=1
110575   FELLS: A=:INPTY; X=:XREG; A:=L=:"LREG"
110601   @LIB CXCPU
110601   @LIB CXCPU-,
110601          X:=DFOPP
110602   @ELIB
110602          X=:CDFOP
110603   NXTCH: BRECHOFL/\70=:BRECHOFL
110606          IF FLAGB BIT 5LSTA THEN                   % TERMINAL IS NOT CONNECTED
110611             TER02=:DERROR; GO OUT1
110614          FI
110614          IF BHOLD=0 THEN                           % EMPTY BUFFER
110616                DFLAG BONE 5ECHO BZERO 5ALEC=:DFLAG % TURN ON ECHO IN DRIVER
110622                -1=:RSISTE                          % DRIVER DEFINES NEXT BREAK
110624                GO OUT1
110625          FI
110625          IF X.CFREE=0 THEN
110627             BRECHOFL BONE 5WECH=:BRECHOFL          % WAIT FOR OUTPUT BUFFER
110632             GO OUT1
110633          FI
110633          IF RSISTE>=0 THEN
110635                IF HENTE=RSISTE THEN -1=:RSISTE FI
110643          FI
110643          CALL XONCHECK; CALL CXRBGET; CALL SETPARITY; A=:CHARN
110647          IF DFLAG BIT 5ECHO GO RETU                % ECHO BY DRIVER
110652          IF RSISTE<0 THEN                          % ECHO SHOULD BE DONE BY ME
110654             IF DFLAG NBIT 5ALEC THEN               % ALL CHARACTERS ALREADY ECHOED?
110657                CHARN; CALL TECHO                   % TEST ECHO
110661             FI
110661             CALL TBREAK                            % TEST BREAK
110662             X:=CDFOP
110663             IF BRECHOFL<0 THEN           % CHARACTER SHOULD BE IGNORED
110665                 7=:CHARN; CALL GECHO; GO NXTCH
110671             FI
110671             IF A BIT 5ECHO THEN CALL GECHO FI      % GIVE ECHO
110674          FI
110674   RETU:  T:=0
110675          IF INPTY=0 THEN                 % BREAK CHECK IN TDGET           
110677             IF RSISTE>=0 THEN
110701                IF HENTE-RSISTE=0 THEN T:=1 FI     % BREAK BY DRIVER
110705             ELSE
110706                IF BRECHOFL BIT 5BREAK THEN T:=1 FI % BREAK CONDITION
110712             FI
110712          FI
110712   OUT:   CHARN; MIN "LREG"
110714   OUT1:  X:=XREG; GO LREG
110716   
110716   % GIVE ECHO FROM TTGET OR TDGET
110716   % B=INPUT DATAFIELD, X=OUTPUT DATAFIELD
110716   INTEGER POINTER LREGL
110717   GECHO: A:=L=:"LREGL"
110721          X:=:B
110722          CHARN; CALL CXRBPUT; CALL STDEV; X:=:B    
110726          GO LREGL
110727   RBUS
110741   
110741   *"8XON
"110741   %=====================================================================
110741   %            X O F T R      
110741   %      37.20
110741   %
110741   % THIS ROUTINE IS AN ALTERNATIVE TO NORMAL XOFF/XON CHECKING AND
110741   % REQUIRES XOFF/XON TO BE IN SEQUENCE. ANY OTHER COMBINATION WILL
110741   % BE TREATED AS NORMAL DATA CHARACTERS.
110741   % THE ROUTINE IS ACTIVATED BY ENTERING IT'S ADDRESS IN THE ROUSPEC
110741   % LOCATION IN THE TERMINAL INPUT DATAFIELD. THE ROUTINE IS CALLED
110741   % AT THE START (D=0) AND AT THE END (D=1) OF THE DRIVER.
110741   % FIRST PART (D=0) PERFORMS THE XOFF/XON CHECKING WILE THE LAST PART
110741   % (D=1) PERFORMS BRANCHING ACCORDING TO RESULTS FROM FIRST PART.
110741   
110741   SUBR XOFTR
110741   SYMBOL IXOFF=3,IDATA=4,OPIN=5
110741   XOFTR: IF T:=DFLAG BIT 5XDEVICE THEN   % XOFF/XON CHECKING FOR THIS TERMINAL?
110744             IF D=0 THEN                                      % TEST CHARACTERS
110746                A BZERO 7=:LAST=:D
110751                IF T:=BRECHOFL NBIT IXOFF THEN      % X O F F   T E S T
110754                   IF "XOFF"=D THEN
110757                      T BONE IXOFF BZERO IDATA=:BRECHOFL
110762                      T:=DFLAG BONE 5OXON=:DFLAG              % STOP OUTPUT
110765                      0=:X.TMR; L-1
110767                   FI; A:=LAST; EXITA
110771                ELSE                                % X O N   T E S T
110772                   IF D="XON" THEN                            % IGNORE CHARACTERS
110775                      T:=BRECHOFL BZERO IXOFF BZERO IDATA=:BRECHOFL
111001                      T:=DFLAG BZERO 5OXON=:DFLAG
111004                      T:=X.HDEV+DCONT
111006                      A:=1; *IOXT                             % PIN OUTPUT
111010                      EXIT
111011                   ELSE
111012                      A SHZ 10+"XOFF"=:LAST                   % DATA CHARACTERS
111015                      T:=BRECHOFL BONE IDATA BZERO IXOFF=:BRECHOFL
111021                      EXITA
111022                   FI   
111022                 FI    
111022             ELSE                                   % R E T U R N   C H E C K
111023                IF T:=BRECHOFL BIT IDATA THEN
111026                   T BONE OPIN BZERO IDATA=:BRECHOFL
111031                   LAST SHZ -10=:LAST
111034                   EXIT                                       % NEW CHARACTER
111035                FI
111035                IF T:=BRECHOFL BIT OPIN THEN
111040                   T BZERO OPIN=:BRECHOFL
111042                   DFLAG BZERO 5OXON=:DFLAG
111045                   T:=X.HDEV+DCONT
111047                   A:=1; *IOXT                                % PIN OUTPUT
111051                FI
111051                EXITA
111052             FI
111052          ELSE
111053             IF D=0 THEN
111055                A BZERO 7=:LAST; 0=:BRECHOFL
111060             FI
111060          FI
111060          EXITA
111061   RBUS
111061   *"
"111061   
111061   
111061   %==============================================================================
111061   % 37.4       D W R I T E
111061   %
111061   % DRIVER ROUTINE ON LEVEL 10
111061   %
111061   % THE X-REGISTER MUST POINT TO THE INPUT DATAFIELD (X=DFOPP)
111061   % IN ALL THE ROUTINES CALLED BY THE OUTPUT DRIVER
111061   
111061   
111061   %
111061   
111061   INTEGER LOGFIELD=?
111061   INTEGER 10BUFST
111062   SUBR DWRITE
111062   SYMBOL BIT0=0
111062   SYMBOL SUFFS=5               % SUFFICIENT SPACE FOR ECHO
111062   INTEGER CCNOBYT,XCNOBYT
111064   INTEGER POINTER 3PT10:=177600+L10LGP+L10LGP+1
111065   DWRITE:
111065          ISTATE=:OISTATE
111067   @LIB CXCPU
111067   @LIB CXCPU-,
111067          X:=DFOPP=:10DFOPP; BUFST=:10BUFST
111073   @ELIB
111073          *IOF
111074   *"8N500
"111074   INDRIV:
111074          MINBHOLD BZERO 5BLOC=:T
111077          IF BHOLD<T AND OISTAT><0 THEN
111104   @LIB CXCPU-,
111104             "IORESTART"=:MFUNC;  CALL XRTACT
111107   @ELIB
111107   @LIB CXCPU
111107          FI
111107          IF SCREEN><0 THEN
111111             IF A>24 THEN 207; CALL OOAPD; 0=:EMPTFLAG; -1=:SCREEN FI
111121             IF A<0 GO FAR OUT
111123          FI; CALL OXONCHECK; GO CALLOOAPD          % SEND 'XON/XOFF'
111125          CALL XONWRITE; GO FAR OUT                 % TEST FOR XOFF.
111127   NOXON: IF BHOLD >< 0 THEN
111131             T:=HDEV+DST; *IOXT
111134             IF BIT 3 THEN                     % READY FOR TRANSFER AND CARRIER NOT MISSING
111136                IF TYPRING BIT 5CRDLY THEN
111141                   CALL CHDL2
111142                ELSE
111143                   IF A BIT 5TERM THEN CALL CXRBGET ELSE CALL RBGET FI
111150                FI
111150   NOCH:        IF T:=SCREEN>0 THEN
111153                   IF =12 THEN MIN SCREEN FI
111157                   IF =14 THEN T+24=:SCREEN FI
111164                   GO CALLOOAPD; *)FILL
111202                FI
111202   CALLOOAPD:   CALL XOOAPD; 0=:EMPTFLAG; TTMR=:TMR
111206                IF X><0 THEN X.DFLAG BZERO 5LBRK=:X.DFLAG FI  % LINE IS OK
111212             ELSE
111213                T:=HDEV+"DCONT"; "DPIN+DACT"; *IOXT           % PIN DEVICE.
111217                TTMR =: TMR                                   % START TIME-OUT
111221                IF X><0 THEN
111222                   IF X.TYPRING BIT 5TERM THEN                % SPEC. FOR TERMINALS
111225                      T := X.HDEV + DST; * IOXT               % READ INPUT STATUS.
111230                      IF BIT 4 OR BIT 13 THEN                 % IF ERROR
111234                         IF BIT 13 THEN                       % CARR. MISSING 
111236                            X.DFLAG BONE 5LBRK=:X.DFLAG       % FLAG CARRIER MISSING
111241                            -2=:X.TMR                         % SET INPUT TIME-OUT IN 2 SEC.
111243                         FI; T:=HDEV+"DCONT"; "DACT"; *IOXT   % UNPIN DEVICE
111247                         CALL CLBUF                           % CLEAR BUFFER
111250   @LIB CXCPU
111250   @LIB CXCPU-,
111250                         IF RTRES><0 THEN CALL XRTACT FI % ACTIVATE USER
111253   @ELIB
111253   EFI:      FI; FI; FI; FI
111253          ELSE            
111254   *"8N500
"111254   @LIB CXCPU
111254   @LIB CXCPU-,
111254             IF LOGFIELD=B THEN
111257   @ELIB
111257                0=:EMPTFLAG; A:=0; CALL OOAPD; TTMR=:TMR
111264             ELSE
111265   *"
"111265   NLOG1:       1=:EMPTFLAG; 0=:TMR
111270             FI
111270          FI;  GO OUT; *)FILL
111276   
111276   INTEGER SAVB
111277   
111277   OUT:   IF CFREE=SUFFS THEN            % CHECK IF INPUT IS WAITING FOR BUFFER
111303             IF X:=10DFOPP><0 THEN
111305   @LIB CXCPU
111305   @LIB CXCPU-,
111305                IF X.BRECHOFL BIT 5WECH THEN
111310                   A BZERO 5WECH=:X.BRECHOFL; X:=:B=:SAVB
111314   *"8N500
"111314                   CALL TSTBACK; "IORESTART"=:MFUNC;
111317   *"
"111317                   CALL XRTACT; SAVB=:B
111322                FI
111322   @ELIB
111322             FI
111322           FI; *ION
111323   @LIB CXCPU-,
111323          CALL LOG1
111324   @ELIB
111324   @LIB CXCPU
111324   NLOG2: CALL ID10; GO FAR DWRITE
111326   
111326   RBUS
111335   
111335   
111335   %==============================================================================
111335   % 37.5       I O A P D   O O A P D
111335   %
111335   % SUBROUTINES TO READ AND WRITE A CHARACTER USING IOXT!!!!!!!
111335   
111335   SUBR IOAPD,OOAPD,XOOAPD
111335   INTEGER ERRCODE,IOXNO
111337   IOAPD: T:=HDEV+DST; *IOXT
111342          A =: D                                    % STATUS
111343          T+"DDR-DST"; *IOXT                        % BYTE IN A
111345          IF D BIT 13 THEN                          % CARRIER MISSING?? 
111347                IF TYPRING BIT 5TERM THEN           % TERMINAL      
111352                   DFLAG BONE 5LBRK=:DFLAG
111355                   -2=:TMR                          % START TIME-OUT IN 2 SEC.
111357                FI
111357                L =: D                              % SAVE RETUR-ADRESS
111360                CALL CLBUF ; L := D                 % CLEAR BUFFER
111362                EXIT
111363          ELSE
111364             T:=DFLAG BZERO 5LBRK=:DFLAG            % LINE IS OK
111367          FI
111367          IF D BIT 4 THEN
111371             T:=TINFO
111372             IF D BIT 5 THEN T BONE 5FRER ELSE T BONE 5PAER FI; T=:TINFO
111400             IF A=0 THEN
111401                IF CESCP/\377><LAST GO SIMESC
111406             FI
111406             CNTREG; T:=HDEV+DCONT; *IOXT
111412             TTMR=:TMR; EXIT
111415          FI
111415   SIMESC: A=:D; CNTREG; T:=HDEV+DCONT; *IOXT
111422          D=:A; EXITA
111424   
111424   OOAPD: A=:D                                      % SAVE CHAR IN D
111425          T:=HDEV+DST; *IOXT
111430          IF BIT 3 THEN                             % READY!!!
111432             D=:A
111433   XOOAPD:   T:=HDEV+DDW; *IOXT                     % WRITE CHAR TO INTERFACE
111436          FI
111436   OUTRA: "DACT+DPIN"; T:=HDEV+"DCONT"; *IOXT       % RE-ACTIVATE.
111442          EXIT
111443   
111443   RBUS
111445   
111445   
111445   @LIB CXCPU
111445   %==============================================================================
111445   % 37.7       R B G E T   R B P U T     R W G E T    R W P U T    D B P U T
111445   %   - - -3.5.6.2  A U X I L I A R Y     R O U T I N E S
111445   
111445   % RING BUFFER ROUTINES TO GET OR PUT A BYTE
111445   % CHARACTER IN A
111445   %      DBPUT PUTS A BYTE INTO A DEVICE BUFFER SIMULATING A RING BUFFER.
111445   %            - IT SHOULD BE EXECUTED WITH PIOF AND ON ENTRY A SHOULD HAVE 
111445   %            - THE BYTE TO BE STORED IN ITS LEAST SIG. BYTE.
111445   %
111445   % TDBGET/TDBPUT: T=MEMORY BANK OF BUFFER
111445   %                ELSE SAME FUNCTION AS DBGET/DBPUT
111445   %
111445   SUBR RBGET,RBPUT,RWGET,RWPUT,DBPUT,DBGET,TDBPUT,TDBGET
111445   %
111445   INTEGER TREG, AREG, DREG, XREG         % SAVE REGISTERS FOR DBGET
111451   REAL TADREG=TREG
111451   INTEGER POINTER LREG
111452   DISP 0; REAL FFMAX=MAX; DOUBLE DBHOLD=BHOLD
111452          INTEGER ARRAY POINTER RWBUFST=BUFST
111452   PSID
111452   RBGET: TAD:=FFMAX; IF A=0 THEN EXIT FI    %BHOLD
111455          A-1; D+1; AD=:DBHOLD
111460          IF D=T THEN 0=:HENTE FI     % BOTTOM OF BUFFER
111463          D-1:=:X; T:=BUFST; *LBYT
111467          MIN CFREE; D=:X; EXIT
111472   
111472   RBPUT: IF T:=CFREE=0 THEN EXIT FI; T-1=:CFREE
111500          X:=:D:=FYLLE; T:=BUFST; *SBYT
111504          X+1; IF X=MAX THEN X:=0 FI; X=:FYLLE
111512          MIN BHOLD; D=:X; EXIT
111515   
111515   INTEGER CMBBANK
111516   
111516   TDBPUT: TAD=:TADREG; GO DDBPU
111520   DBPUT: TAD=:TADREG; T:=BUFBANK
111522   DDBPU: T=:CMBBANK
111523          X=:XREG; A/\377=:D
111526          IF CFREE><0 THEN
111530             A-1=:CFREE; MIN BHOLD
111533             X:=BUFST; A:=FYLLE; *BLDA 00 DA
111536             A SHZ -1; X+A; T:=CMBBANK; *LDATX
111542             IF K THEN A/\177400 ELSE D SHZ 10; A/\377 FI
111550             A\/D; *STATX
111552             IF A:=FYLLE+1=MAX THEN A:=0 FI; A=:FYLLE
111561          FI
111561   OUT:   TAD:=TADREG; X:=XREG; EXIT
111564   
111564   TDBGET: TAD=:TADREG; GO DDBGE
111566   DBGET: TAD=:TADREG; T:=BUFBANK
111570   DDBGE: T=:CMBBANK
111571          X=:XREG; TAD:=FFMAX
111573          IF A><0 THEN                              % BHOLD
111574             A-1; D+1; AD=:DBHOLD; IF D=T THEN 0=:HENTE FI
111602             D-1; *BLDA 00 DD
111604             D SHZ -1; X:=BUFST+D; T:=CMBBANK; *LDATX
111611             IF K NBIT THEN A SHZ -10 FI; A/\377=:AREG
111616             MIN CFREE
111617          FI; GO OUT
111620   
111620   *)FILL
111623   
111623   RWGET: TAD:=FFMAX; IF A=0 THEN EXIT FI    %BHOLD
111626          A-1; D+1; AD=:DBHOLD; IF D=T THEN 0=:HENTE FI
111634          D-1:=:X; RWBUFST(X); MIN CFREE; D=:X; EXIT
111642   
111642   RWPUT: IF T:=CFREE=0 THEN EXIT FI; T-1=:CFREE
111650          X=:D; A=:RWBUFST(FYLLE)
111653          X+1; IF X=MAX THEN X:=0 FI; X=:FYLLE
111661          MIN BHOLD; D=:X; EXIT
111664   RBUS
111664   *"-CXCPU
"111664   *CXRBP=RBPUT
111664   *CXRBG=RBGET
111664   *"
"111664   
111664   %==============================================================================
111664   % 40.1       T E L I N   T E L E N T
111664   %
111664   *"TELIX
"111664   %
111664   % SIMPLE DRIVER FOR TELETYPE INTERFACE
111664   % BREAK ON EVERY CHARACTER, NO ECHO, NO MODIFICATIONS OF THE BYTES
111664   % LEVEL 12
111664   %
111664   
111664   SUBR TELIN,TELENT
111664   INTEGER ERRCODE,IOXNO
111666   @LIB CXCPU
111666   TELIN: TTMR=:TMR;CALL ID12
111671   TELENT:
111671   @LIB CXCPU
111671   @LIB CXCPU-,
111671          X:=DFOPP
111672   @ELIB
111672          T:=HDEV+"DST"; *IOXT            % READ STATUS
111675          IF A BIT 4 THEN       % ERROR
111677                A=:ERRCODE; A BONE 17=:DERROR; T-"DST"=:IOXNO; T+"DDR"; *IOXT
111706                A=:D; T+"DST-DDR"; *IOXT  
111711                IF A BIT 3 GO ERR; GO L1
111714          ELSE
111715          T+"DDR-DST"; *IOXT    % READ DATA
111717          FI; A=:LAST; T+"DST-DDR"; *IOXT  
111722          IF A BIT 3 GO ERR
111724   L1:    CNTREG; T+"DCONT-DST"; *IOXT     % PIN DEV
111727          A:=LAST; CALL XONCHECK
111731          CALL XONREAD; GO CONT1
111733          A := LAST
111734   % TEXT EDITING TERMINAL CONVERTING ROUTINE
111734   *"TELIX 7TEXT
"111734   CONT1:
111734   @LIB CXCPU
111734   @LIB CXCPU-,
111734          CALL RBPUT; CALL RTACT
111736   @ELIB
111736          GO TELIN
111737   ERR:   T:=HDEV; A:=:T; CALL 9ERR(#23); 232=:DERROR
111745   @LIB CXCPU
111745   @LIB CXCPU-,
111745          IF RTRES><0 THEN CALL RTACT FI
