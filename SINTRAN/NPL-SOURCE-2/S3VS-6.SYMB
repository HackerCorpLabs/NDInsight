121211   %==============================================================================
121211   %            3 S P L R E E
121211   %
121211   % THIS ROUTINE IS CALLED FROM SPLREE
121211   %
121211   SUBR 3SPLRE
121211   
121211   DISP 26                      % D5+1
121211   INTEGER CBSGNO,CPOTADDR,CCFP,CCLP,CORSEGM,CCBMX,CCPOTADDR,CREBMAP,CCSGNO
121211   INTEGER NPAGES=CCBMX,PREVT=CCBMX,PREVX=CCPOTADDR,CURRX=CCSGNO
121211   INTEGER CFP1=D1,CLP1=D2,CFP2=D3,CLP2=D4
121211   DOUBLE DDDS1=CFP1,DDDS2=CFP2,DDDD0=D0,DDDD2=D2,DDDD4=D4,CCLMS=CCFP
121211   PSID
121211   DISP 100; DOUBLE D1PREV,D2PREV; PSID   % PREVIOUS LOGICAL ADDRESS AREAS
121211   DISP 0; TRIPLE 3BM0,3BM3; DOUBLE 2BM6; PSID
121211   
121211   % COMPUTE ADDRESSES AND SIZES USED BY SEVERAL ROUTINES
121211   %
121211   GTVALUES: AD=:CCLMS; *BLDA 00 DA
121213             T:=D-A; AD SHZ -4; A+CREBMAP=:CCBMX
121220             AD SHZ 7; A/\170=:D
121223             CCFP SHZ -1; X:=CPOTADDR+A=:CCPOTADDR
121230             EXIT
121231   
121231   % FOR ALL PAGES IN PREVIOUS LOGICAL ADDRESS AREA DO
121231   %      IF BIT OF CORRESPONDING PAGE IN BITMAP IS SET THEN
121231   %         SET CORRESPONDING POT-TABLE ENTRY EQUAL CURRENT REENTRANT SEGMENT
121231   %      FI
121231   % OD
121231   %
121231   INTEGER POINTER LREG=?
121231   INTEGER ENDINSTR(0); *BSKP ONE 170 DT
121232   INTEGER CINSTR(0); *BSKP ONE 00 DT
121233   STPOTTABLE: T:=L=:"LREG"; CALL GTVALUES
121236           T=:L; A:=CINSTR; D\/A
121241           DO WHILE L>>0                            % FOR ALL BITMAP LOCATIONS DO:
121243              IF T:=CCBMX.S0><0 THEN                % IF UNEQUAL ZERO
121247                 *EXR SD                            % TEST EACH BIT
121250                 GO NOTSET
121251                 A:=CORSEG; *BSKP ONE SSK; SHA 10   % A = RSEGM READ FROM RT-D 
121254                 A=:CCSGNO; X=:CCBMX:=CCPOTADDR     % X = ADDRESS OF POT-ENTRY
121257                 T:=SREBBANK; *LDATX                % T = BANK NO. WHERE POT RESIDES; A = POT INFORMATION
121261                 IF K NBIT THEN                     % ACCORDING TO THE SETTING OF K-INDICATOR
121263                     A/\377
121264                 ELSE                               % TAKE RIGHT- OR LEFTMOST BYTE
121265                     A/\177400
121266                 FI 
121266                 A\/CCSGNO; *STATX                  % COMBINE WITH RSEGM-INFO AND UPDATE POT-ENTRY
121270                 *BSKP ZRO SSK 
121271                 MIN CCPOTADDR; 0/\0                % INCREMENT POINTER IN POT-ENTRY
121273   NOTSET:       L-1
121274                 T:=10; IF D+T>>ENDINSTR GO INELSE  % MODIFY BSKP INSTRUCTION TO TEST FOR NEXT BIT
121301                 *BSET BCM SSK                      % SWITCH VALUE OF K-INDICATOR
121302             ELSE
121303                 A:=D SHZ -3/\17; T:=20-A; L-T; T+1 SHZ -1
121313                 CCPOTADDR+T=:CCPOTADDR
121316   INELSE:       CINSTR=:D; K:="0"; MIN CCBMX       % MAKE READY TO TEST NEXT BITMAP WORD
121322             FI
121322           OD; GO LREG
121324   
121324   INTEGER CBSET(0); *BSET ZRO 00 DA
121325   INTEGER LBSET(0); *BSET ZRO 170 DA
121326   INTEGER CLBSGNO
121327   INTEGER POINTER LREG
121330   MBCLBITS: T:=L=:"LREG"; CALL GTVALUES
121333             T=:L; A:=CBSET; D\/A
121336             DO WHILE L><0                          % FOR ALL PAGES IN LOGICAL AREA DO:
121340                X:=CCPOTADDR; T:=SREBBANK; *LDATX   % READ A WORD FROM POT-TABLE
121343                *BSKP ONE SSK                       % SKIP NEXT IF PAGE NO IS AN ODD NUMBER
121344                *SHA ZIN SHR 10                     % SEGMENT NUMBER IN RIGHTMOST BYTE
121345                IF A/\377-D0><0 THEN                % IF EQUAL SEGMENT NO IN PARAMETERLIST
121350                   *LDATX; BSKP ZRO SSK; JMP RBY
121353                   A/\377\/CLBSGNO; GO FELLS
121356   RBY:            A/\177400\/CBSGNO
121360   FELLS:          *STATX
121361                   X:=CCBMX; X.S0; *EXR SD          %   SET THE RESPECTIVE BIT TO 1 
121364                   A=:X.S0                          %   IN BITMAP
121365                FI; T:=10
121366                IF D+T>>LBSET THEN                  % IF LAST BIT IN THIS LOC. HAS BEEN SET
121372                    CBSET=:D; MIN CCBMX; 0/\0       %   MAKE READY FOR THE NEXT ONE
121376                FI
121376                *BSET BCM SSK                       % SWITCH VALUE OF K (INDICATES ODD OR EVEN PAGE NO)
121377                IF K NBIT THEN MIN CCPOTADDR; 0/\0 FI; L-1            
121404            OD; GO LREG
121406   *)FILL
121413   
121413   TRIPLE ALLONES(0); *-1;-1;-1
121416   
121416   CCHLIMS: D+A; IF C OR A>>200 OR D>>T GO CR15ERRD
121426            EXIT
121427   
121427   CR15ERRD: D0; GO R15ERRD
121431   
121431   3SPLRE: RTREF.SEGM SHZ -10+1=:CBSGNO                       % GET BACKGROUND SEGMENT NO
121436           T:=A SH 10=:CLBSGNO
121441           IF A*5SEGSIZE+SEGSTART><NSEGB GO RETSTUPR          % IF UNEQUAL NSEGB START SCANNING EXEC.QUEUE
121446           A:=RTREF-"BAK01"=:D:=0; T:=5RTSIZE; *RDIV ST       % INDEX IN RT-D TABLE, BAK01 = INDEX 0
121454           A*POTESIZE+SREBADDR=:CPOTADDR; X.RSEGM=:CORSEGM    % CPOTADDR = POINTER TO POT-ENTRY, SAVE REENTR. SEG NO
121461           X.RTDLGADDR+5BITMAP=:CREBMAP
121464           IF D0=0 AND CORSEGM=0 THEN
121470              X:=NSEGB; CBSGNO; CALL WSEGX                    % WRITE SHADOW SEGMENT BACK
121473           FI
121473           IF D0><0 THEN                                      % IF SEGMENT NUMBER UNEQUAL O
121475              CALL LEGSEG; IF A NBIT 5SREEP GO CR15ERRD       % LEGAL SEGMENT ? DEMAND SEGMENT?
121500              IF A SHZ -11/\3><0 GO CR15ERRD                  % RING ><0 ?   
121503              IF X.LOGADR SHZ -6/\3<1 OR A>2 GO CR15ERRD      % PAGE TABLE MUST BE 1 OR 2
121514           FI
121514           AD:=DDDS1; CALL CCHLIMS; AD=:DDDS1                 % LOGICAL AREA 1 TOO LARGE?
121517           AD:=DDDS2; CALL CCHLIMS; AD=:DDDS2                 % LOGICAL AREA 2 TOO LARGE?
121522           IF D5><0 THEN                                      % IF POT-ENTRY FOR THIS PROGRAM IS TO BE CLEARED
121524              X:=CPOTADDR; A:=X+100=:L                        %    X POINTS TO START OF POT-ENTRY, L POINTS TO THE NEXT
121530              CBSGNO SH 10\/CBSGNO=:D; T:=SREBBANK             
121535              DO WHILE X><L                                   %    FOR ALL BYTES IN THE POT-ENTRY
121537                 *STDTX; AAX 2                                %    FILL IN BACKGROUND SEGMENT NUMBER
121541              OD;
121542           ELSE
121543              IF CORSEGM><0 THEN
121545                 X:=CPOTADDR; T:=SREBBANK; *AAX D1PRE; LDDTX
121551                 CALL FAR STPOTTABLE
121552                 X:=CPOTADDR; T:=SREBBANK; *AAX D2PRE; LDDTX
121556                 CALL FAR STPOTTABLE
121557              FI
121557           FI
121557           TAD:=ALLONES=:CREBMAP.3BM0=:X.3BM3; AD=:X.2BM6
121564           IF D0><0 THEN
121566              AD:=DDDS1; CALL FAR MBCLBITS 
121570              AD:=DDDS2; CALL FAR MBCLBITS
121572           FI; GO L1; *)FILL
121613   
121613   INTEGER POINTER PPBPAG1:=BPAG1
121614   INTEGER CBSKP(0); *BSKP ZRO 00 DT
121615   L1:     AD:=DDDS1; T:=SREBBANK; X:=CPOTADDR; *AAX D1PRE; STDTX
121622           T:=100; A+T; D+T; AD=:DDDS1
121626           AD:=DDDS2; T:=SREBBANK; *AAX D2PRE-D1PRE; STDTX
121632           T:=100; A+T; D+T; AD=:DDDS2
121636           IF D0><0 THEN
121640              T:=0; X:=NSEGB+1   % BPAGLINK=1
121643              DO
121643                 T=:PREVT; X=:PREVX; *LDXTX DPAGL
121646              WHILE X><0
121647                 T:=CORMBANK; X=:CURRX; *LDATX DALOG
121652                 IF A>=CFP1 AND A<CLP1 GO COVERLAP
121660                 IF A<CFP2 OR A>=CLP2 GO NOVERLAP
121666   COVERLAP:     A-100; AD SHZ -4; A+CREBMAP=:X
121672                 AD SH 7; A/\170+CBSKP; T:=X.S0; *EXR SA
121677                 GO NOVERLAP
121700                 X:=CURRX; T:=CORMBANK; *LDATX DPAGL
121703                 A=:L:=PPBPAG1; *STATX DPAGL
121706                 A:=1; *STATX DPGPR
121710                 X=:PPBPAG1:=PREVX; T:=PREVT; A:=L; *STATX DPAGL
121715                 GO EDO    
121716   NOVERLAP:     T:=CORMBANK; X:=CURRX
121720   EDO:       OD
121721              IF PPBPAG1><0 AND "XSGRT".SEGLINK=0 THEN
121726                 X:="BSEGLINK"; DO WHILE X.SEGLINK><-1; X:=A; OD
121735                 "XSGRT"=:X.SEGLINK; -1=:"XSGRT".SEGLINK
121742              FI
121742           FI; D0=:RTREF.RSEGM; GO RETSTUPR
121746   RBUS
121756   
121756   
121756   
121756   
121756   %==============================================================================
121756   %            S T S L I C E 
121756   %
121756   % ROUTINE TO TIMESLICE ND-100 PROCESSES
121756   %
121756   
121756   SUBR STSLICE
121756   
121756   INTEGER CINDEX=?,CTSLPROC=?,CTSLSTATUS=?
121756   
121756   STSLICE:
121756          MLEV; *MCL PIE                   % STSLICE ENTRY POINT
121760          0=:CINDEX; X:=FPTSLICE
121762          DO WHILE X<<LPTSLICE
121765             IF X.WLINK=0 GO NXTSLPROG                   % PROGRAM NOT ACTIVE
121767             X=:B=:CTSLPROC
121771             IF TSLSTATUS(CINDEX) NBIT 5NOSLICE AND NBIT 5SPRF THEN
121777                A=:CTSLSTATUS
122000                IF A BIT 5ESCF THEN                       % WAITING FOR ESCAPE PRIORITY?
122002                   A BZERO 5ESCF BZERO 5BRKF=:CTSLSTATUS  % CLEAR ESCAPE AND BREAK
122005                   A SHZ -7CUTY/\7                        % FIND SLICE TYPE
122007                   TSLESCELEM(A); GO INBRKTEST            % GET ESCAPE ELEMENT
122012                FI
122012                IF A BIT 5BRKF THEN                       % WAITING FOR BREAK PRIORITY?
122014                   A BZERO 5BRKF=:CTSLSTATUS              % CLEAR BREAK FLAG
122016                   IF STATUS/\377<=TSLLOWLG THEN          % CAN PRIORITY BE INCREASED
122023                      CTSLSTATUS SHZ -7CUTY/\7            % FIND SLICE TYPE
122026                      TSLBRKELEM(A)                       % GET BREAK ELEMENT
122030   INBRKTEST:         A=:D:=CTSLSTATUS/\177740\/D=:CTSLSTATUS
122035                      DTIN2=:TSLNTIME(CINDEX)
122040                      GO SETALL                          
122041                   FI
122041                FI
122041   %            A:=TSLNTIME(CINDEX)-TSLIDLE=:TSLNTIME(X)-+DTIN2=:D:=0
122041                A:=DTIN2-TSLNTIME(CINDEX)=:D:=0
122046                T:=TSLTUNIT; *RDIV ST                      % COMPUTE CPU TIME USED
122050                IF A+TSLCOUNTA(X)<0 GO CONWAIT             % TIMESLICE FINISHED?
122052                DTIN2=:TSLNTIME(X)                         % YES, SET NEW CPU TIME
122054   FINNEW:      CTSLSTATUS/\37=:X                          % TIMESLICE ELEMENT
122057                A:=CTSLSTATUS/\177740\/TSLNEXTAB(X)        % FIND NEXT ELEMENT IN CHAIN
122062                A=:CTSLSTATUS/\37=:D
122065   
122065   SETALL:      IF TSLTIMTAB(D)=:T-TSLHTIME>=0 THEN        % HASH ELEMENT?
122072                   DTIN2/\TSLHASHM+T                       % YES; HASH WITH TIME USED
122075                ELSE
122076                   A:=T
122077                FI; A-=:TSLCOUNTA(CINDEX)                  % SET TIMSLICE COUNTER
122102                STATUS/\177400\/TSLPRITAB(D)=:STATUS       % SET PRIORITY ON PROCESS
122107                X:=B; CALL FRWQU
122111                IF A><0 THEN B:=A; CALL TOWQU FI           % UPDATE EX-QUEUE
122114                CTSLSTATUS=:TSLSTATUS(CINDEX)
122117   CONWAIT:  FI; X:=CTSLPROC
122120   NXTSLPROG: X+5RTSIZE; MIN CINDEX
122122          OD; MLEV; *MST PIE
122125          CALL N500SCHEDULER                               % TIMESLISE ND-500 PROCESSES
122126          *IOF
122127          X:=RTREF; CALL FREXQ; 1=:MTOR
122133          "MONEN"; *IRW MLEVB DP
122135          MLEV; *MST PID; ION; JMP *                       % TERMINATE RTSLI (INSTEAD OF MON RTEXT)
122141   
122141   INTEGER CINDEX,CTSLPROC,CTSLSTATUS
122144   
122144   RBUS
122175   %==============================================================================
122175   %            T 3 R E P P     (TREPP  MON 332)    
122175   %
122175   %      MONITORCALL TO DISABLE/ENABLE AND READ TERMINAL REPPORT
122175   %
122175   %      ENTRY: T = LOGICAL DEVICE NUMBER ( 1: OWN TERMINAL BACKGROUND)
122175   %             A = FUNCTION  = 0: DISABLE TERMINAL-REPPORT
122175   %                           = 1: ENABLE  TERMINAL-REPPORT
122175   %                           = 2: READ    TERMINAL-STATUS
122175   %      ERROR RETURN: A = ERROR NUMBER
122175   %      SKIP  RETURN: FUNCTION 0: OK
122175   %                    FUNCTION 1: OK
122175   %                    FUNCTION 2: OK  A = STATUS                 
122175   %                                        BIT  0: 1 - TERMINAL LINE DEAD
122175   %                                        BIT  1: 1 - LOGOUT WAITING FOR MON 0
122175   %                                        BIT  2: 1 - OVERRUN IN INPUT BUFFER
122175   %                                        BIT  3: 1 - PARITY ERROR IN INPUT
122175   %                                        BIT  4: 1 - FRAMING ERROR IN INPUT
122175   %      BITS USED IN FLAGB: 
122175   %           BIT  0: 5TLREP  
122175   %           BIT   : 5LOGOUT 
122175   %           BIT 17: 5LSTA   
122175   %      BITS USED IN TINFO:
122175   %           BIT 17: 5BFUL   - READ AND CLEAR
122175   %           BIT 16: 5PAER   - -----"-------
122175   %           BIT 15: 5FRER   - -----"-------
122175   
122175   SUBR T3REPP
122175   INTEGER POINTER TTIF:=TTIFIELD,PBCHFLAG:=BCHFLAG
122177   T3REPP: IF BACKGROUND><0 AND ZTREG=1 THEN         % BACKGROUND OWN TERMINAL
122205              IF PBCHFLAG=1 GO DUMRE                 % FAKE ALWAYS OK IF BATCH
122211              X:=TTIF                                % TTIFIELD IS TERM. DATAF.
122212          ELSE                                       % RT OR BACKGROUND DEV SPEC.
122213             IF ZTREG/\177700=100 GO ILLDV           % FILE IS ILLEGAL
122220             ZTREG; CALL LOGPH; IF A=0 GO ILLDV      % FIND DATAFIELD
122223             IF A.RTRES><RTREF GO NRESV              % DEVICE MUST BE RESERVED
122230             IF X.TYPRING BIT 5TERM THEN
122233                CALL XSETBFPAGE
122234             FI  
122234          FI
122234          IF X.TYPRING BIT 5COM THEN A:="0"; T:=X.FLAGB; GO IGNLI FI
122242          IF A NBIT 5TERM AND A NBIT 5BAD THEN GO ILLDV FI
122247          IF ZAREG=0 THEN X.FLAGB BZERO 5TLREP=:X.FLAGB; GO DUMRE FI
122255          IF A=1 THEN X.FLAGB BONE 5TLREP=:X.FLAGB; GO DUMRE FI
122264          IF A=2 THEN
122267             A:="0"
122270             IF T:=X.FLAGB BIT 5LSTA THEN
122273                A BONE "0"                                    % LINE IS DEAD
122274             ELSE
122275                IF T BIT 5TLREP AND T BIT 5LOGOUT THEN        % TERMINATION STARTED
122301                   A BONE "0"   % LINE IS UP, BUT NOT RAPPORTED
122302                ELSE
122303                   A BZERO "0"  % LINE IS UP
122304                FI
122304             FI; *IOF
122305             T:=X.TINFO
122306             IF T BIT 5BFUL THEN T BZERO 5BFUL; A BONE 2 FI
122312             IF T BIT 5PAER THEN T BZERO 5PAER; A BONE 3 FI
122316             IF T BIT 5FRER THEN T BZERO 5FRER; A BONE 4 FI; T=:X.TINFO; *ION
122324   IGNLI:    IF T BIT 5LOGOUT THEN A BONE 1 ELSE A BZERO 1 FI % LOGOUT WANTED?         
122331             GO RERET
122332          FI
122332          GO ILLFU
122333   
122333   DUMRE: A:="0"
122334   RERET: MIN ZPREG; 0/\0
122336   RETU:  A=:ZAREG; GO RET
122340   NRESV: A:=5; GO RETU                   % DEVICE NOT RESERVED
122342   ILLDV: A:=240; GO RETU                 % ILLEGAL DEVICE TYPE
122344   ILLFU: A:=201; GO RETU                 % ILLEGAL FUNCTION CODE
122346   RBUS
122356   
122356   %=======================================================================
122356   %  11.34     G D E V 3 T Y
122356   %
122356   %  MONITOR CALL TO GET DEVICE-TYPE AND ATTRIBUTES (MON 263)
122356   %
122356   %  ENTRY:        T-REG:   DEVICE NUMBER
122356   %                A-REG:   0=INPUT, 1=OUTPUT
122356   %  SKIP RETURN:  T-REG:   DEVICE TYPE
122356   %                A&D REG: DEVICE ATTRIBUTES
122356   %  RETURN:       A-REG:   ERROR CODE
122356   %   
122356   %  DEVICE TYPES RETURNED IN T-REG
122356   %      0 - UNSPECIFIED
122356   %      1 - TERMINAL
122356   %      2 - BACKGROUND ACCESS DEVICE (BAD)
122356   %      3 - COMMUNICATION CHANNEL
122356   %      4 - INTERNAL BLOCK DEVICE
122356   %      5 - FLOPPY-DISK
122356   %      6 - MAG-TAPE
122356   %      7 - MASS-STORAGE-FILE
122356   %
122356   %  ATTRIBUTES  RETURNED IN A&D REG
122356   %     BIT  0: INBT/OUTBT ALLOWED
122356   %     BIT  1: CONCT ALLOWED
122356   %     BIT  2: IOSET ALLOWED
122356   %     BIT  3: BLOCK CALLS ALLOWED
122356   %     BIT  4: CLEAR DEV ROUTINE AVAILABLE
122356   %     BIT  5: NO RESERVATION NECESSARY
122356   %     BIT  6: COSMOS REMOTE OPEN FILE
122356   %     BIT  7: NN-CHANNEL USED FOR REMOTE OPEN
122356   
122356   SUBR GDEV3TY
122356   SYMBOL 9BTERM=1,9BBAD,9BCOM,9BIBDV,9BFLOP,9BMT,9BRFILE            % TYPES
122356   SYMBOL AIOBT,ACONCT,ATISET,AM144,ACLDV,ANORES,ACOSOP,ANNOP  % ATTRIBUTES
122356   INTEGER POINTER PTTNO:=TTNO,PBCHFLAG:=BCHFLAG, PTTIF:=TTIFIELD
122361   
122361   GDEV3TY:
122361          IF BACKGROUND><0 AND ZTREG=1 THEN
122367             IF PBCHFLAG=0 THEN
122371                PTTNO
122372             ELSE
122373                X:=PTTIF
122374                IF ZAREG=0 THEN X.RIFIL ELSE X.DFOPP.ROFIL FI
122402             FI
122402          ELSE
122403             ZTREG
122404          FI 
122404          CALL LOGPH
122405          IF T:=ZAREG><0 THEN D=:A FI
122411          IF A=0 GO ERR                             % NO SUCH LOGICAL UNIT
122412          IF A.TYPRING BIT 5TERM THEN T:=9BTERM; GO ATRIB FI
122420          IF A BIT 5BAD   THEN T:=9BBAD;   GO ATRIB FI
122424          IF A BIT 5COM   THEN T:=9BCOM;   GO ATRIB FI
122430          IF A BIT 5IBDV  THEN T:=9BIBDV;  GO ATRIB FI
122434          IF A BIT 5FLOP  THEN T:=9BFLOP;  GO ATRIB FI
122440          IF A BIT 5MT    THEN T:=9BMT;    GO ATRIB FI
122444          IF A BIT 5RFILE THEN T:=9BRFILE; GO ATRIB FI
122450          T:=0
122451   ATRIB: T=:ZTREG:=0
122453          IF A BIT 5RFILE THEN
122455             A=:D; IF X.OFFLG BIT 5RCFIL THEN T BONE ACOSOP FI
122462             IF A BIT 5REMPO THEN T BONE ANNOP FI
122465             D=:A
122466          FI
122466          IF A BIT 5IOBT  THEN T BONE AIOBT FI
122471          IF A BIT 5CONCT THEN T BONE ACONCT FI
122474          IF A BIT 5ISET  THEN T BONE ATISET FI
122477          IF A BIT M144B  THEN T BONE AM144 FI
122502          IF A BIT 5CLDV  THEN T BONE ACLDV FI
122505          IF A BIT 5NORES THEN T BONE ANORES FI
122510   
122510   UT:    T=:ZDREG; 0=:ZAREG; MIN ZPREG; 0/\0; GO RET
122515   
122515   ERR:   33=:ZAREG; GO RET
122520   RBUS
122523   
