133112   % 40.9
133112   %      H D L C  -  D R I V E R
133112   %      SYMBOLS AND DEFENITIONS
133112   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
133112   %
133112   %
133112   %      COMMON DEFINITIONS
133112   
133112   SYMBOL INTCH = 102164                  % RESPONCE ON INIT
133112   SYMBOL SILFO = 100000                  % ILLEGAL TRANSMITTER LIST KEY
133112   SYMBOL TXUND =      2                  % TRANSMITTER UNDERRUN
133112   SYMBOL OVERR = 100000                  % RECEIVER OVERRUN
133112   SYMBOL EMTY  =  4000                   % RECEIVER LIST EMTY
133112   SYMBOL BLDON = 10                      % RECEIVER STATUS BLOCK DONE
133112   %
133112   %
133112   %      I O X DEFINITIONS
133112   
133112   @ICR;
133112   SYMBOL RRDR=0,                         % READ REC.DATA REG.
133112          WPCR,                           % WRITE PARAM. CONTR. REG.
133112          RRS,                            % READ REC STATUS
133112          WSAR,                           % WRITE SYNC/ADDRESS REG.
133112          WCHL,                           % WRITE CHAR. LENGTH
133112          WTDR,                           % WRITE TRANSM. DATA REG.
133112          RTSR,                           % READ TRANSM. STATUS REG.
133112          WTCR,                           % WRITE TRANSM. CONTROLE REG.
133112          RRTS,                           % READ REC. TRANSFER STATUS
133112          WRTC,                           % WRITE REC. TRANSFER CONTROLE
133112          RTTS,                           % READ TRANSM. TRANSFER STATUS
133112          WTTC,                           % WRITE TRANSM. TRANSFER CONTROLE
133112          RDMA,                           % READ DMA ADDRESS (LEAST)
133112          WDMA,                           % WRITE DMA ADDRESS (LEAST)
133112          RDCR,                           % READ DMA COMMAND REG
133112          WDCR;                           % WRITE DMA COMMAND REG+TRIGGER
133112   @CR;
