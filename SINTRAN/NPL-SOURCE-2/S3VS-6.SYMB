121112   %==============================================================================
121112   % 34.28      G R T N A
121112   %
121112   
121112   SUBR 3GRTNA
121112   
121112   DISP 0; REAL FZTREG=ZTREG,FS0=S0; PSID
121112   INTEGER CCRSG
121113   
121113   3GRTNA: IF LOADI=0 GO ERR
121115          MLEV; *MST PIE
121117          RTREF.ACTSEG=:D1; IF D0=0 THEN X=:D0 FI
121125          X.RSEGM=:CCRSG; 0=:X.RSEGM; T:=5RTFIL; CALL MMEXY
121132          X:=6; CALL RALTON; X.S0; *BSET ZRO
121136          A=:D2; X+1
121140          DO WHILE D2><0
121142                *BSET ONE
121143                X.S4; *BSET ZRO
121145                IF A/\37=27 THEN
121151                   *BSET ONE
121152                   X.S5; *BSET ZRO
121154                   IF A=D0 THEN
121157                      *BSET ONE
121160                      TAD:=X.FS0; *BSET ZRO
121162                      GO OUT
121163                   FI
121163                FI; X+7; D2-1=:D2
121167          OD
121170          TAD:=FZTREG; D:=0
121172   OUT:   TAD=:FZTREG; CCRSG=:RTREF.RSEGM; T:=D1; CALL MMEXY
121200          GO RET
121201   ERR:   0=:ZDREG; GO RET
