130444   *"
"130444   *"8PIOC
"130444   @LIB OLDPIOC
130444   *"
"130444   
130444   %==========================================================================
130444   %      P R T C G P L O C
130444   %
130444   % SUBROUTINE TO THE RTCGPLOC IN RESIDENT
130444   % MUST BE CALLED IN PIOF.
130444   %
130444   SUBR PRTCGPLOC
130444   INTEGER TREG,AREG,DREG,CCDISP; TRIPLE SVTAD=TREG
130450   INTEGER ARRAY POINTER ACCTAB:=CCTAB
130451   PRTCGPLOC:
130451          TAD=:SVTAD; X=:XRG; A:=X/\1777=:CCDISP:=X SHZ -12+100=:D; X:=0
130463          DO WHILE ACCTAB(X)><-1
130467             IF A/\377=D THEN
130472                X+1; A:=ACCTAB(X)=:D:=0; AD SH 12; X:=CCDISP
130500                X+D; T:=A
130502                IF TREG=0 THEN
130504                   *LDATX; STA AREG
130506                ELSE
130507                   AREG; *STATX
130511                FI; GO  OUT
130512             FI; X+2
130513          OD; L-1
130515   OUT:   TAD:=SVTAD; X:=XRG; EXITA
130520   RBUS
