115655   % 37.2       P A G E F A U L T   P A G E 2 F A U L T   L I M C H E C K
115655   %
115655   %--MONITOR ENTRY FROM LEVEL 14 IF PAGE FAULT
115655   % A=PAGE NUMBER FOUND ON LEVEL 14
115655   %EXIT TO SEGIN
115655   
115655   SUBR PAGEFAULT,PAGE2FAULT,LIMCHECK
115655   
115655   DOUBLE ARRAY POINTER WINDAD:=177174
115656   DOUBLE POINTER BPG:=177000+5BFPAGE+5BFPAGE
115657   INTEGER SHAINSTR(0); *SHA
115660   INTEGER CINSTR(0); *BSKP ZRO DT
115661   
115661   *"8SWLG
"115661   
115661   PAGE2FAULT:
115661   *"8SWLG
"115661               CALL BLEVSET; GO PAGF      % PAGEFAULT ON INBT/OUTBT LEVEL
115663   PAGEFAULT:                             % PAGEFAULT ON APPLICATION LEVEL
115663   *"8SWLG
"115663   PAGF:  IF PNUMB=76 OR =77 THEN
115672   @LIB CXCPU
115672   @LIB CXCPU-,
115672             A-76=:T; IF RTREF.WINDOW/\377=0 GO OUTSIDE
115700             A=:WIND1+T=:PNUMB-T; T SH 1; A SH 1+T+177000=:X; AD:=X.DOU0
115712             IF A><0 THEN
115713                AD=:WINDAD(T)
115715   *"8SWLG
"115715                GO PMONEN
115716             FI
115716   @ELIB
115716          ELSE
115717             IF A="5BFPAGE" THEN
115722   @LIB CXCPU
115722   @LIB CXCPU-,
115722               IF RTREF.WINDOW SHZ -10=0 GO OUTSIDE
115726               A=:D:=162000; AD=:BPG
115731   *"8SWLG
"115731               GO PMONEN
115732   @ELIB
115732             FI
115732          FI
115732          PNUMB SH 1+177000=:X
115736          IF X.S0><0 THEN CALL ERRFATAL FI
115741          IF DEMAND=0 THEN PNUMB; CALL 9ERR(#13); GO PBRTEXT FI
115747          X:=SEGMC; CALL LIMCHECK
115751          IF =0 THEN
115752                A:=X.LOGADR/\300=:D:=PNUMB/\377-D
115760                AD SHZ -4; X:=RTREF.RTDLGADDR+A
115764                SHAINSTR; D SHZ -14+A; 1; *EXR SD
115771                IF A/\X.BITMAP><0 GO NOTREENT; X:=SEGMC
115774          ELSE
115775   NOTREENT:    X:=SEGMA; CALL LIMCHECK
115777                IF <0 THEN X:=SEGMB; CALL LIMCHECK
116002                   IF <0 THEN
116003   OUTSIDE:           PNUMB; CALL 9ERR(#14); GO PBRTEXT
116007                   FI
116007          FI    FI; X=:B; CALL SEGIN
116011   *)FILL
116034   
116034   LIMCHECK: IF X=0 OR X.LOGADR/\377>PNUMB OR A=:D:=X.LOGADR SHZ -10+D<=T THEN
116050                A:=-1
116051             ELSE
116052   *"8SWLG
"116052             A:=0                                             % RETURN WITH A=0
116053             FI; EXIT
116054   RBUS
