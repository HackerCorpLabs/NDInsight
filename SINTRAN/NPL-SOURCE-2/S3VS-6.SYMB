063760   *"8IBRS
"063760   %=======================================================================
063760   %            I B R S I Z
063760   %
063760   % RESIDENT PART OF IBRSIZ MONITOR CALL. CODE ON PIT3-SEGMENT
063760   @LIB CXCPU
063760   @LIB CXCPU-,
063760   SUBR IBRSIZ,T2C06,T2P06,IBLBYT
063760   @ELIB
063760   IBRSIZ: CALL GET0; CALL SPT3PIT; GO IBR3S        % (MON 313)          
063763   T2C06: *POF
063764   T2P06: GO BISIZ; 0/\0; *PON                      % CALL TO BISIZ FOR TAD
063767          GO T206RET
063770   @LIB CXCPU-,
063770   IBLBYT: *POF; LBYT; PON; EXIT                    % LOAD A BYTE FROM BUFFER IN POF
063774   @ELIB
063774   RBUS
064001   *"
"064001   
064001   %=============================================================================
064001   %            C L R B M A P   B M F R T D   B M T R T D  
064001   %            B M O R
064001   %
064001   % ROUTINES TO MANIPULATE WITH THE RT-DESCRIPTION'S REENTRANT BITMAP
064001   %
064001   SUBR CLRBMAP,BMFRTD,BMTRTD,BMOR
064001   
064001   % CLRBMAP:   CLEAR THE REENTRANT BITMAP
064001   %      ENTRY:  X=RTDESCRIPTION; INTERRUPT MUST BE OFF OR MLEV DISABLED
064001   %      EXIT:   PAGING IS ON
064001   %
064001   CLRBMAP: *POF
064002          X:=X.RTDLGADDR
064003          0=:X.BITMAP=:X.BITM1=:X.BITM2=:X.BITM3=:X.BITM4=:X.BITM5=:X.BITM6=:X.BITM7
064013          *PON; EXIT
064015   
064015   % BMFRTD:    COPY BITMAP FROM RT-DESCRIPTION TO ARRAY POINTED AT BY B-REG
064015   %      ENTRY:  X=RTDESCRIPTION; B=ARRAY ADDR
064015   %      EXIT:   T,A,D,X ARE DESTROYED
064015   %
064015   BMFRTD:
064015   *"CXCPU
"064015          X:=X.RTDLGADDR+5BITMAP; B+BXBITMAP; T:=0
064021          *LDDTX 00; STD 0,B; LDDTX 20; STD 2,B
064025          *LDDTX 40; STD 4,B; LDDTX 60; STD 6,B
064031          B-BXBITMAP; EXIT
064033   *"
"064033   
064033   % BMTRTD:    COPY BITMAP FROM ARRAY POINTED AT BY B-REG TO RT-DESCRIPTION
064033   %      ENTRY:  X=RTDESCRIPTION; B=ARRAY ADDR
064033   %      EXIT:   T,A,D,X ARE DESTROYED
064033   %
064033   BMTRTD:
064033   *"CXCPU
"064033          X:=X.RTDLGADDR+5BITMAP; B+BXBITMAP; T:=0
064037          *LDD 0,B; STDTX 00; LDD 2,B; STDTX 20
064043          *LDD 4,B; STDTX 40; LDD 6,B; STDTX 60
064047          B-BXBITMAP; EXIT
064051   *"
"064051   
064051   % BMOR:      RT-DESCRIPTION.BITMAP OR SAVED-BITMAP =: RTDESCRIPTION.BITMAP
064051   %      ENTRY: X=RTDESCRIPTION ADDR; B=ARRAY ADDR
064051   %             MUST BE CALLED IN IOF AND ARRAY POINTED TO BY B-REG MUST
064051   %             BE IN MEMORY WHEN BMOR IS CALLED
064051   %      EXIT:  T,A,D,X ARE DESTROYED
064051   %
064051   BMOR:  X:=X.RTDLGADDR+5BITMAP; T:=0
064054          *LDATX 00; ORA XUBIM,B; STATX 00
064057          *LDATX 10; ORA XUBI1,B; STATX 10
064062          *LDATX 20; ORA XUBI2,B; STATX 20
064065          *LDATX 30; ORA XUBI3,B; STATX 30
064070          *LDATX 40; ORA XUBI4,B; STATX 40
064073          *LDATX 50; ORA XUBI5,B; STATX 50
064076          *LDATX 60; ORA XUBI6,B; STATX 60
064101          *LDATX 70; ORA XUBI7,B; STATX 70
064104          EXIT
064105   RBUS
064105   
064105   
064105   %==========================================================================
064105   %            C S T S E G
064105   %
064105   % ROUTINE TO CALL STSEG IN "POF-AREA", CALLED FROM MMREENT
064105   %
064105   SUBR CSTSEG
064105   CSTSEG: MLEV; *MCL PIE; POF; ION
064111          X=:A:=L; CALL STSEG; A:=RTREF:=:X; CALL CLRBMAP     % CLRBMAP SETS PAGING ON
064117          A=:L; MLEV; *MST PIE
064122          EXIT
064123   RBUS
064126   
064126   %=============================================================================
064126   %            R E E I N   R E E U T
064126   %
064126   % COPY THE REENTRANT BITMAP BETWEEN TWO RT-PROGRAMS
064126   %
064126   % REEIN: COPY BITMAP FROM SSREF TO RTREF
064126   % RREUT: RTREF.BITMAP\/SSREF.BITMAP=:SSREF.BITMAP
064126   %
064126   SUBR REEIN,REEUT
064126   
064126   INTEGER LREG,BREG,XREG
064131   
064131   REEIN: K:=1; GO FELLS
064133   REEUT: K:="0"
064134   FELLS: *PIOF
064135          X=:XREG:=L=:LREG:=SSREF:=:B=:BREG:=RTREF
064144          IF K THEN
064146             RSEGM=:X.RSEGM
064150             RTDLGADDR+"5BITMAP-BXBITMAP"=:B; CALL BMTRTD
064154          ELSE
064155             0=:X.RSEGM; X:=X.RTDLGADDR+"5BITMAP-BXBITMAP":=:B; CALL BMOR
064162          FI; X:=BREG=:B:=LREG=:L:=XREG; *PION
064170          EXIT
064171   RBUS
