130275   
130275   %==================================
130275   % 40.25      R E A D Y    X 2 1 S H    X 2 1 1 4
130275   
130275   %***************************************************************
130275   %
130275   %      R E A D Y                                 % ** STATE 1 **
130275   %      T = 1  C = OFF
130275   %
130275   %      EXIT: T = 0     OK
130275   %            T ><0     ERROR CODE IN T
130275   %
130275   %***************************************************************
130275   
130275   SUBR X211
130275   X211:  A:=L=:X2DSR; 1=:X2DST                     % SAVE RETURN ADDR
130301          CALL X21SH                                % DEFINE SYN = HIGH, ENABLING
130302                                                    % INTERFACE TO DETECT R = HIGH
130302          100=:A; T:=X2DHD+XWTTC; *EXR ST           % T = 1
130307          -3=:X2D0C; -1=:X2DST                      % **** POSSIBLE -7 HERE *****
130313   X21L:  005; T:=X2DHD+XWRTC; *EXR ST              % C = OFF, IS R = 1 ?
130317          X21TA=:TMR; 1=:X2DPI; CALL X21LV          % WAIT FOR R = 1
130324          A=:X2D10                                  % SAVE STATUS
130325          IF A/\ "101" >< "001" THEN                % IS I OFF ?
130331                T:=X2F01;  GO OUT                   % NO, REPORT ERROR
130333          FI                                        % YES,  I = OFF
130333          T:=X2DHD+XRRDR; *EXR ST                   % GET R
130336          A=:X2D00
130337          IF A >< "377" THEN                        % IS R = HIGH ?
130342                T:=X2F01; GO OUT                    % NO, NETWORK NOT READY 
130344          FI                                        % I DO NOT LIKE STATE 8 NOW
130344          MIN X2D0C; GO X21L                        % MUST DETECT 3 SUCH CHAR, THUS
130346                                                    % MAKE SURE T = 1 IN 24 BIT    
130346          0=:TMR                                    % INTERVALLS
130347          0=:A; T:=X2DHD+XWRTC; *EXR ST             % DISABLE RECEIVER
130353          40; *EXR ST
130355          147; T:=X2DHD+XWPCR; *EXR ST              % 8 BITS CHAR,STRIP SYNC
130361                                                    % NO PARITY CONTROL
130361          X21SY; T:=X2DHD+XWSAR; *EXR ST            % REDEFINE SYNC CHARACTER
130365          100; T:=X2DHD+XWTTC; *EXR ST              % T = 1
130371          CALL STORE; T:=0
130373   OUT:   A:=X2DSR=:P                               % EXIT
130375   RBUS
130402   
130402   %      SET READY (1,OFF) DONT CARE ABOUT DCE
130402   
130402   SUBR X2118
130402   
130402   X2118: A:=L=:X2DSR; T:=22=:X2DST; CALL STORE
130407          CALL X21SH; 100; T:=X2DHD+XWTTC; *EXR ST
130414          A:=0; T+"XWRTC-XWTTC"; *EXR ST
130417          A:=X2DSR=:P
130421   
130421   RBUS
130423   
130423   %      STATE 14 CONTROLLED NOT READY
130423   
130423   SUBR X2114
130423   X2114: A:=0; T:=X2DHD+XWRTC; *EXR ST
130427          A:=40; *EXR ST
130431          A:=0; *EXR ST
130433          A:=107; T+"XWPCR-XWRTC"; *EXR ST
130436          A:=252; T+"XWSAR-XWPCR"; *EXR ST
130441          A:=0; T+"XWCHL-XWSAR"; *EXR ST
130444          A:=104; T+"XWTTC-XWCHL"; *EXR ST
130447          A:=1; T+"XWTCR-XWTTC"; *EXR ST
130452          EXIT
130453   RBUS
130454   %
130454   %
130454   %      ENABLE INTERFACE TO SEE R = HIGH
130454   
130454   SUBR   X21SH
130454   X21SH: A:=0; T:=X2DHD+XWRTC; *EXR ST             % DEVICE CLEAR
130460          A:=40; *EXR ST
130462          *AAT 6; EXR ST                            % CLEAR DMA ALSO *H*
130464          A:=107; T:=X2DHD+XWPCR; *EXR ST           % BCP MODUS, NO VCR CONTROL
130470                                                    % STRIP ONLY TWO SYN
130470          377; T:=X2DHD+XWSAR; *EXR ST              % SPECIFY SYNC CHAR
130474          A:=0; T:=X2DHD+XWCHL; *EXR ST             % CHARACTER LENGTH = 8 BITS
130500          EXIT
130501   RBUS
