122425   *"8LAMU
"122425   %
122425   %=========================================================================
122425   %      L A M A R R
122425   %
122425   % PHYSICAL MEMORY PARTS AVAILABLE FOR LAMUS
122425   %
122425   % FORMAT: 2 LOCATIONS FOR EATCH ENTRY
122425   %         FIRST PHYSICAL PAGE IN AREA
122425   %         LAST PHYSICAL PAGE IN AREA
122425   %
122425   INTEGER ARRAY LAMARR(NINSZ*2)
122475   * LAMAR<*; )ZERO
122475   *"
"122475   
122475   
122475   %==============================================================================
122475   % 36.24      N S W P A G E  -  N I N I T P A G E  -   C U M T A B L E
122475   %
122475   % NSWPAGE    : MEMORY AREA NOT USED AS SWAPPING AREA
122475   % NINITPAGE  : MEMORY AREA NOT LEGAL TO INITIALIZE
122475   %
122475   % THE LAYOUT IN THE TABLES:
122475   %      TWO WORDS FOR EACH ENTRY, FIRST PAGE AND LAST PAGE IN AREA
122475   %      THE TABLES ARE TERMINATED BY A ZERO
122475   %
122475   DOUBLE ARRAY NSWPAGE(NNSWSZ)           % MEMORY AREAS UNAVAILABLE FOR SWAPPING
122545   *NINSZ
122546   DOUBLE ARRAY NINITPAGE(NINSZ)          % MEMORY AREAS NOT ACCESSED IN START-UP (SHARED BETWEEN CPU'S)
122616   DOUBLE ARRAY CUMTABLE(CUMSIZE)         % CUSTOMER RESERVED MEMORY AREAS
122642   DOUBLE ARRAY USIOXTAB(USDVSIZE)        % CUSTOMER RESERVED PHYSICAL DEVICE NUMBERS (SHOULD NOT BE CLEARED)
122662   * NSWPA<*; )ZERO
122662   *"8VDD+8VDP
"122662   
122662   @DEV 1
122662   @DEV (S-S-J)ND500-DRIVER-1
122662   %
122662   *"8N500
"122662   * CH5CP=TEXIT
122662   * RL5PD=TEXIT
122662   * 1RL5P=TEXIT
122662   *"
"122662   
122662   @DEV 1
122662   @DEV (S-S-J)MRES-CDR1
122662   %
122662   %==============================================================================
122662   %      M R E S - C D R 1
122662   %=============================================================================
122662   
122662   
122662   *"MODIN
"122662   %==============================================================================
122662   % 38.1       M O D I N   M O D U T   M O D I 1
122662   %
122662   
122662   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
122662   %   SYNCRONOUS MODEM DRIVER                 %
122662   %   AND HANDLING ROUTINES FOR SINTRAN III   %
122662   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
122662   
122662   SUBR MODIN,MODUT,MODI1
122662   
122662   DISP -12
122662   INTEGER MOWSTAT
122662   INTEGER TERSW,MOSW
122662   PSID
122662   
122662   SYMBOL EBSOH=1, EBSTX=2, EBETX=3, EBDLE=20, EBIUS=37, EBETB=46
122662   SYMBOL EBEOT=67, EBSYN=62, EBPAD=377
122662   
122662   SYMBOL ASSOH=1, ASSTX=2, ASETX=3, ASEOT=4, ASACK=6, ASBEL=7
122662   SYMBOL ASDLE=20, ASDC1=21, ASNAK=25, ASSYN=26, ASETB=27, ASUS=37
122662   
122662   % MODEM INPUT DRIVER
122662   
122662   MODIN:
122662          CALL ID12
122663   MODI1: T:=HDEV+DDR;*EXR ST
122666          A=:LAST
122667          IF T:=CFREE=0 GO MOSWX
122672   
122672   @ICR;
122672          T:=MOSW GOSW MOSW0, FAR IBM1, FAR IBM2, MOSW3, MOSW4, MOSW4,  % 0-5
122702                       FAR I3271, HASP1, HASP2, HASP3, FAR HASP4,       % 6-12
122707                       FAR HASP5, FAR HASP6, FAR HASP7, FAR HASP8,      % 13-16
122713                       FAR HASP9;                                       % 17
122714   @CR;
122714   
122714   MOSW4: GO MODIN
122715   
122715   MOTERMF:
122715          LAST                                      % TERMINATOR FOUND
122716   MOSW3: T:=MBSYMOD; CALL TDBPUT
122720   MOSWX: CALL RTACT
122721          IF TERSW=7 OR =12 OR =14 GO MOSWY         % NTR/VIP-BTH/UTS-400
122733          T:=HDEV+DCONT; 2204; *EXR ST
122737          0=:TMR; 4=:MOSW                           % IGNORE NEXT CHARACTER
122742          GO MODIN
122743   MOSWY: T:=HDEV+DCONT; 2204; *EXR ST
122747          205; *EXR ST                              % READ NEXT CHARACTER (IF SYNC)
122751          0=:TMR=:MOSW
122753          GO MODIN
122754   
122754   *)FILL
122774   
122774   % TEST FOR TERMINATION CONDITION
122774   
122774   @ICR;
122774   MOSW0: T:=TERSW GOSW FAR GEN0, FAR DCT0, FAR CDC0, FAR GER0, IBM0, VIP0, HASP0,
123005                        FAR NTR0, FAR MSV20, FAR I3270, FAR BTH0, FAR SSAAB,
123012                        FAR UTS0;
123013   @CR;
123013   
123013   %      HASP WS :
123013   %
123013   %      MOSW=0, TERSW=6 : DECODE 1. CHARACTER (SHOULD BE SYN)
123013   %
123013   HASP0: IF A><EBSYN GO MOSWY                      % ERROR: RESYNC
123016          7=:MOSW; GO FAR MORET                     % READ SECOND
123021   
123021   %
123021   %      MOSW=7 : DECODE 2. CHARACTER (SHOULD ALSO BE SYNC)
123021   %
123021   HASP1: IF A><EBSYN GO FAR MOSWY                  % ERROR : RESYNC
123024          10=:MOSW; GO FAR MORET
123027   %
123027   %      MOSW=10 : DECODE BLOCK FOLLOWING SYNC
123027   %
123027   HASP2: IF A=EBSYN GO FAR MORET
123032          IF A=EBPAD GO FAR MOSWX                   % END OF BLOCK
123035          T:=MBSYMOD; CALL TDBPUT
123037          IF A=EBDLE THEN                           % ACK OR TRANSP. TEXT
123042             11=:MOSW
123044          ELSE
123045             IF A=EBSOH THEN                        % ENQ OR NON-TRANSP. TEXT
123050                12=:MOSW
123052             FI
123052          FI
123052          GO FAR MODPIN
123053   
123053   %
123053   %      MOSW=11 : TRANSPARENT TEXT OR ACK (STARTS WITH DLE)
123053   %
123053   HASP3: T:=MBSYMOD; CALL TDBPUT
123055          IF A=EBSTX THEN                           % TRANSP. TEXT-BLOCK
123060             13=:MOSW
123062          ELSE
123063             GO MOSWX                               % ACK
123064          FI
123064          GO FAR MODPIN
123065   
123065   %
123065   %      MOSW=12 : NON-TRANSPARENT TEXT BLOCK OR ENQ (STARTS WITH SOH)
123065   %
123065   HASP4: T:=MBSYMOD; CALL TDBPUT
123067          IF A=EBSTX THEN                           % TEXT-BLOCK WITH CRC FOLLOWS
123072             15=:MOSW
123074          ELSE
123075             GO MOSWX                               % ENQ
123076          FI
123076          GO FAR MODPIN
123077   
123077   %
123077   %      MOSW=13 : TRANSPARENT TEXT BLOCK ENDED WITH DLE+ETB+CRC+CRC+PAD
123077   %
123077   HASP5: T:=MBSYMOD; CALL TDBPUT
123101          IF A=EBDLE THEN MIN MOSW FI               % ETB MAY FOLLOW
123105          GO FAR MODPIN
123106   
123106   %
123106   %      MOSW=14 : DLE WAS READ IN TRANSP. TEXT MODE, CHECK IF NEXT IS ETB
123106   %
123106   HASP6: T:=MBSYMOD; CALL TDBPUT
123110          IF A=EBETB THEN                           % ETB : 2 CRC FOLLOWS
123113             16=:MOSW
123115          ELSE
123116             13=:MOSW                               % RESET DLE-MODE
123120          FI
123120          GO FAR MODPIN
123121   
123121   %
123121   %      MOSW=15 : NON-TRANSPARENT TEXT BLOCK ENDED WITH ETB+CRC+CRC+PAD
123121   %
123121   HASP7: T:=MBSYMOD; CALL TDBPUT
123123          IF A=EBETB THEN MIN MOSW FI
123127          GO FAR MODPIN
123130   
123130   %
123130   %      MOSW=16 : 1. CRC CHARACTER
123130   %
123130   HASP8: T:=MBSYMOD; CALL TDBPUT
123132          MIN MOSW; GO FAR MODPIN                   % READ NEXT CRC
123134   
123134   %
123134   %      MOSW=17 : 2. CRC CHARACTER
123134   %
123134   HASP9: T:=MBSYMOD; CALL TDBPUT
123136          GO FAR MOSWX                              % END OF BLOCK
123137   *)FILL
123160   
123160   %      VIP CONTROL (HONEYWELL-BULL INTERACTIV TERMINALS)
123160   
123160   VIP0:  IF A=0 OR =ASSYN GO FAR MORET
123164          T:=MBSYMOD; CALL TDBPUT; A/\177
123167          IF A=ASETX THEN
123172             T:=2=:MOSW; GO FAR MODPIN              % BCB WILL FOLLOW AFTER ETX
123175          FI
123175          IF A=ASEOT GO FAR MOSWX                   % EOT : END OF BLOCK
123200          GO FAR MODPIN
123201   
123201   % IBM 3780/2780
123201   
123201   IBM0:  IF A=EBSYN GO FAR MORET
123204          T:=MBSYMOD; CALL TDBPUT
123206          IF A=EBETX OR =EBETB OR =EBIUS THEN       % ETX,ETB,IUS : 2 CRC WILL FOLLOW
123217             MIN MOSW                               % MOSW=1
123220          FI
123220          IF A=EBPAD GO FAR MOSWX                   % PAD : END OF BLOCK
123223          GO FAR MODPIN
123224   %
123224   %      MOSW=1 : READ 1. CRC-CHARACTER
123224   %
123224   IBM1:  T:=MBSYMOD; CALL TDBPUT
123226          MIN MOSW; GO FAR MODPIN
123230   %
123230   %      MOSW=2 : READ 2. CRC-CHARACTER
123230   %
123230   IBM2:  T:=MBSYMOD; CALL TDBPUT
123232          0=:MOSW; GO FAR MODPIN                    % END OF BLOCK, READ PAD
123234   
123234   %      GERTS-115
123234   
123234   GER0:  IF A=0 OR =ASSYN OR =377 GO FAR MORET
123243          T:=MBSYMOD; CALL TDBPUT
123245          A/\177
123246          IF A=ASETX THEN T:=3=:MOSW FI             % ETX : BCB WILL FOLLOW NEXT
123253   *"8KGS
"123253          GO FAR MODPIN
123254   %                                                              
123254   %      UNIVAC NTR
123254   %
123254   NTR0:  T:=MBSYMOD; CALL TDBPUT
123256          IF A=ASETX THEN 3=:MOSW FI                % ETX : BCB WILL FOLLOW NEXT
123263          GO FAR MODPIN
123264   
123264   *)FILL
123273   
123273   %
123273   %      CD-200-USER
123273   %
123273   CDC0:  GO GER0
123274   %
123274   %      NOT DEFINED
123274   %
123274   GEN0:  GO GER0
123275   %
123275   %      DCT-2000
123275   %
123275   DCT0:  IF =0 OR =ASSYN OR =377 GO FAR MORET
123304          T:=MBSYMOD; CALL TDBPUT
123306          A/\177
123307          IF A=ASETX OR =ASEOT OR =ASACK OR=ASNAK OR=ASBEL OR =ASDC1 THEN
123331             3=:MOSW                                % AFTER ETX,EOT,ACK,NAK,BELL,DC1 : 1 BCC
123333          FI 
123333          GO FAR MODPIN
123334   %
123334   %      SIEMENS MSV2
123334   %
123334   MSV20: IF A=ASSYN GO MORET
123337          T:=MBSYMOD; CALL TDBPUT; A/\177
123342          IF A=ASETX OR =ASETB OR =ASUS THEN MIN MOSW FI      % READ 2 CRC NEXT
123354          IF A=177 GO FAR MOSWX                               % END OF BLOCK
123357          GO MODPIN
123360   
123360   %
123360   %      IBM-3270 EMULATOR
123360   %
123360   
123360   I3270: IF A=EBSYN GO MORET
123363          T:=MBSYMOD; CALL TDBPUT
123365          IF A=EBSTX THEN T:=6=:MOSW FI             % STX : SET TEXT MODE
123372          IF A=EBEOT GO FAR MOSWY                   % EOT : NEW SYNC MAY FOLLOW
123375          IF A=EBPAD GO FAR MOSWX                   % ENDING PAD
123400          GO MODPIN
123401   %
123401   %      MOSW=6 : 3270 IN TEXT MODE
123401   %
123401   
123401   
123401   I3271: T:=MBSYMOD; CALL TDBPUT
123403          IF A=EBETX OR =EBETB THEN T:=1=:MOSW FI   % ETX/ETB : 2 CRC WILL FOLLOW
123413          GO MODPIN
123414   
123414   %
123414   %      BTH/VIP 7750 INTERACTIVE TERMINALS
123414   %
123414   BTH0:  IF A=0 GO MORET
123415          IF A=377 GO FAR MOSWX                     % PAD : END OF BLOCK
123420          T:=MBSYMOD; CALL TDBPUT
123422          A/\177
123423          IF A=ASETX OR =ASETB THEN                 % ETX/ETB : BCC NEXT
123431             2=:MOSW; GO MODPIN
123434          FI
123434          IF A=ASEOT GO FAR MOSWX                   % EOT
123437          GO MODPIN
123440   
123440   *)FILL
123450   
123450   %
123450   %      STANSAAB, ISO-1745 LINE PROCEDURE.
123450   %
123450   
123450   SSAAB: T:=177/\A=:D
123453          IF D=0 OR D=ASSYN GO MORET                 
123460          IF D=ASEOT OR D=ASNAK GO FAR MOSW3        % EOT/NAK : END OF BLOCK
123466          T:=MBSYMOD; CALL TDBPUT; A/\177
123471          IF A=ASDLE OR A=ASETX THEN 3=:MOSW FI     % DLE/ETX : 1 BCC WILL FOLLOW
123501          GO MODPIN
123502   
123502   %
123502   %      UNIVAC UTS-400 EMULATOR
123502   %
123502   UTS0:  IF A=0 OR =ASSYN OR =377 GO FAR MORET     % UTS-400
123511          T:=MBSYMOD; CALL TDBPUT; A/\177
123514          IF A=ASETX THEN 3=:MOSW; FI               % AFTER ETX : 1 BCC
123521          GO MODPIN
123522   
123522   MODPIN:
123522   MORET: 205; T:=HDEV+DCONT; *EXR ST
123526          -2=:TMR
123530          GO MODIN
123531   %
123531   % DRIVER FOR MODEM OUTPUT
123531   MODUT: DO;*IOF
123532             IF BHOLD=0 THEN 0=:TMR=:MOWSTAT; T:=0; CALL RTACT; GO HIT FI
123541             T:=MBSYMOD; CALL TDBGET; T:=HDEV+DDW;*EXR ST
123546             TTMR=:TMR
123550             T:=5
123551   HIT:      T=:A; T:=HDEV+DCONT;*EXR ST;ION
123556             CALL ID10
123557          OD
123560   
123560   RBUS
123573   
123573   
123573   
123573   
123573   *"8HMO1+8HMO2+8HMO3+8HMO4+8HMO5+8HMO6
"123573   %=================================================
123573   % 38.11    H O D I N    H O D U T    H O D I 1
123573   %
123573   
123573   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
123573   % SYNCRONOUS MODEM DRIVER FOR HDLC INTERFACE
123573   % AND HANDLING ROUTINES FOR SINTRAN III
123573   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
123573   
123573   %      SEE SPECIAL MODIFICATION IN CASE OF COMMUNICATION BETWEEN
123573   %      X21 AND X21-BIS ON NORD COMPUTERS AT LABEL "HODUT"
123573   
123573   SUBR HODIN,HODUT,HODI1
123573   DISP -13
123573          INTEGER HOWSTAT
123573          INTEGER HERSW
123573          INTEGER HDXOK
123573          INTEGER MOSW
123573   PSID
123573          INTEGER TELL:=0
123574          INTEGER TELL1:=0
123575          SYMBOL BUFSIZ=20
123575          SYMBOL TELMA=BUFSIZ-1
123575          INTEGER ARRAY BUFF(BUFSIZ)                % RECEIVER STATUS
123615   
123615          SYMBOL EBSOH=1, EBSTX=2, EBETX=3, EBDLE=20, EBIUS=37, EBETB=46
123615          SYMBOL EBEOT=67, EBSYN=62, EBPAD=377
123615   
123615          SYMBOL ASSOH=1, ASSTX=2, ASETX=3, ASEOT=4, ASACK=6, ASBEL=7
123615          SYMBOL ASDLE=20, ASDC1=21, ASNAK=25, ASSYN=26, ASETB=27, ASUS=37
123615   
123615   % MODEM INPUT DRIVER
123615   
123615   HODIN:
123615          CALL ID13
123616   HODI1: T:=HDEV+BRRTS; *EXR ST
123621          A=:T                                      % ENTRY HERE IF X21
123622          IF A NBIT 0 OR A/\60000><0 THEN           % NO DATA OR X21 ERROR?
123626             MIN TELL; P+0
123630             TELL/\ TELMA=:TELL1
123633             T=:BUFF(TELL1)
123635             IF HOWSTAT = 0 THEN                    % YES, PINNED FOR DATA?
123637               304/\HDXOK; T:=HDEV+BWRTC; *EXR ST   % NO, ENABLE FOR STATUS CHANGE
123644                GO HODIN                            % HDXOK MAY CLEAR BIT 100
123645             ELSE      
123646                GO FAR MODPIN                       % FORGET DATA, ENABLE AGAIN
123647             FI
123647          FI
123647          T:=HDEV+BRRDR;*EXR ST
123652          A=:LAST
123653          IF T:=CFREE=0 GO MOSWX
123656   
123656   @ICR;
123656          T:=MOSW GOSW MOSW0, FAR IBM1, FAR IBM2, MOSW3, MOSW4, MOSW4,  % 0-5
123666                       FAR I3271, HASP1, HASP2, FAR HASP3, FAR HASP4,   % 6-12
123673                       FAR HASP5, FAR HASP6, FAR HASP7, FAR HASP8,      % 13-16
123677                       FAR HASP9;                                       % 17
123700   
123700   @CR;
123700   
123700   MOSW4: 300/\HDXOK; T:=X2DHD+BWRTC; *EXR ST       % ENABLE FOR MODEM STATUS CHANGE
123705   
123705   MOTERMF:
123705          LAST                                      % TERMINATOR FOUND
123706   MOSW3: T:=MBSYMOD; CALL TDBPUT
123710   MOSWX: CALL RTACT
123711          IF HERSW=7 OR =12 OR =14 GO MOSWY         % NTR/VIP-BTH/UTS-400
123723          T:=HDEV+BWRTC
123725          300; *EXR ST
123727          0=:TMR=:HOWSTAT; 4=:MOSW                  % IGNORE NEXT CHARACTER
123733          GO HODIN
123734   MOSWY: T:=HDEV+BWRTC
123736          100; *EXR ST
123740          307; *EXR ST                              % ENABLE INPUT AGAIN
123742          0=:TMR=:MOSW                              % READ NEXT CHARACTER (IF SYNC)
123744          GO HODIN
123745   
123745   *)FILL
123773   
123773   % TEST FOR TERMINATION CONDITION
123773   
123773   @ICR;
123773   MOSW0: T:=HERSW GOSW FAR GEN0, FAR DCT0, FAR CDC0, FAR GER0, IBM0, VIP0, HASP0,
124004                        FAR NTR0, FAR MSV20, FAR I3270, FAR BTH0, FAR SSAAB,
124011                        FAR UTS0;
124012   @CR;
124012   
124012   %      HASP WS :
124012   %
124012   %      MOSW=0, HERSW=6 : SKIP TEST FOR 1. CHAR WHEN HDLC IS USED, HDLC WILL
124012   %                        NOT GIVE AN INTERRUPT BEFORE 2 SYNCS ARE RECEIVED.
124012   %
124012   HASP0: T:=10=:MOSW; GO HASP2
124015   %
124015   %      MOSW=7 : NOT USED IN HDLC
124015   %
124015   HASP1: T:=10=:MOSW; GO HASP2
124020                               
124020   %
124020   %      MOSW=10 : DECODE BLOCK FOLLOWING SYNC
124020   %
124020   HASP2: IF A=EBSYN GO FAR MORET
124023          IF A=EBPAD GO FAR MOSWX                   % END OF BLOCK
124026          T:=MBSYMOD; CALL TDBPUT
124030          IF A=EBDLE THEN                           % ACK OR TRANSP. TEXT
124033             11=:MOSW
124035          ELSE
124036             IF A=EBSOH THEN                        % ENQ OR NON-TRANSP. TEXT
124041                12=:MOSW
124043             FI
124043          FI
124043          GO FAR MODPIN
124044   
124044   %
124044   %      MOSW=11 : TRANSPARENT TEXT OR ACK (STARTS WITH DLE)
124044   %
124044   HASP3: T:=MBSYMOD; CALL TDBPUT
124046          IF A=EBSTX THEN                           % TRANSP. TEXT-BLOCK
124051             13=:MOSW
124053          ELSE
124054             GO MOSWX                               % ACK
124055          FI
124055          GO FAR MODPIN
124056   
124056   %
124056   %      MOSW=12 : NON-TRANSPARENT TEXT BLOCK OR ENQ (STARTS WITH SOH)
124056   %
124056   HASP4: T:=MBSYMOD; CALL TDBPUT
124060          IF A=EBSTX THEN                           % TEXT-BLOCK WITH CRC FOLLOWS
124063             15=:MOSW
124065          ELSE
124066             GO MOSWX                               % ENQ
124067          FI
124067          GO FAR MODPIN
124070   
124070   %
124070   %      MOSW=13 : TRANSPARENT TEXT BLOCK ENDED WITH DLE+ETB+CRC+CRC+PAD
124070   %
124070   HASP5: T:=MBSYMOD; CALL TDBPUT
124072          IF A=EBDLE THEN MIN MOSW FI               % ETB MAY FOLLOW
124076          GO FAR MODPIN
124077   
124077   %
124077   %      MOSW=14 : DLE WAS READ IN TRANSP. TEXT MODE, CHECK IF NEXT IS ETB
124077   %
124077   HASP6: T:=MBSYMOD; CALL TDBPUT
124101          IF A=EBETB THEN                           % ETB : 2 CRC FOLLOWS
124104             16=:MOSW
124106          ELSE
124107             13=:MOSW                               % RESET DLE-MODE
124111          FI
124111          GO FAR MODPIN
124112   
124112   %
124112   %      MOSW=15 : NON-TRANSPARENT TEXT BLOCK ENDED WITH ETB+CRC+CRC+PAD
124112   %
124112   HASP7: T:=MBSYMOD; CALL TDBPUT
124114          IF A=EBETB THEN MIN MOSW FI
124120          GO FAR MODPIN
124121   
124121   %
124121   %      MOSW=16 : 1. CRC CHARACTER
124121   %
124121   HASP8: T:=MBSYMOD; CALL TDBPUT
124123          MIN MOSW; GO FAR MODPIN                   % READ NEXT CRC
124125   
124125   %
124125   %      MOSW=17 : 2. CRC CHARACTER
124125   %
124125   HASP9: T:=MBSYMOD; CALL TDBPUT
124127          GO FAR MOSWX                              % END OF BLOCK
124130   
124130   *)FILL
124150   
124150   %      VIP CONTROL (HONEYWELL-BULL INTERACTIV TERMINALS)
124150   
124150   VIP0:  IF A=0 OR =ASSYN GO FAR MORET
124154          T:=MBSYMOD; CALL TDBPUT;A/\177
124157          IF A=ASETX THEN
124162             T:=2=:MOSW; GO FAR MODPIN              % BCB WILL FOLLOW AFTER ETX
124165          FI
124165          IF A=ASEOT GO FAR MOSWX                   % EOT : END OF BLOCK
124170          GO FAR MODPIN
124171   
124171   % IBM 3780/2780
124171   
124171   IBM0:  IF A=EBSYN GO FAR MORET
124174          T:=MBSYMOD; CALL TDBPUT
124176          IF A=EBETX OR =EBETB OR =EBIUS THEN       % ETX,ETB,IUS : 2 CRC WILL FOLLOW
124207             MIN MOSW                               % MOSW=1
124210          FI
124210          IF A=EBPAD GO FAR MOSWX                   % PAD : END OF BLOCK
124213          GO FAR MODPIN
124214   %
124214   %      MOSW=1 : READ 1. CRC-CHARACTER
124214   %
124214   IBM1:  T:=MBSYMOD; CALL TDBPUT
124216          MIN MOSW; GO FAR MODPIN
124220   %
124220   %      MOSW=2 : READ 2. CRC-CHARACTER
124220   %
124220   IBM2:  T:=MBSYMOD; CALL TDBPUT
124222          0=:MOSW; GO FAR MODPIN                    % END OF BLOCK, READ PAD
124224   
124224   %      GERTS-115
124224   
124224   GER0:  IF A=0 OR =ASSYN OR =377 GO FAR MORET
124233          T:=MBSYMOD; CALL TDBPUT
124235          A/\177
124236          IF A=ASETX THEN T:=3=:MOSW FI             % ETX : BCB WILL FOLLOW NEXT
124243   *"8KGS
"124243          GO FAR MODPIN
124244   %
124244   %      UNIVAC NTR
124244   %
124244   NTR0:  T:=MBSYMOD; CALL TDBPUT
124246          IF A=ASETX THEN 3=:MOSW FI                % ETX : BCB WILL FOLLOW NEXT
124253          GO FAR MODPIN
124254   
124254   *)FILL
124263   
124263   %
124263   %      CD-200-USER
124263   %
124263   CDC0:  GO GER0
124264   %
124264   %      NOT DEFINED
124264   %
124264   GEN0:  GO GER0
124265   %
124265   %      DCT-2000
124265   %
124265   DCT0:  IF =0 OR =ASSYN OR =377 GO FAR MORET
124274          T:=MBSYMOD; CALL TDBPUT
124276          A/\177
124277          IF A=ASETX OR =ASEOT OR =ASACK OR=ASNAK OR=ASBEL OR =ASDC1 THEN
124321             3=:MOSW                                % AFTER ETX,EOT,ACK,NAK,BELL,DC1 : 1 BCC
124323          FI 
124323          GO FAR MODPIN
124324   %
124324   %      SIEMENS MSV2
124324   %
124324   MSV20: IF A=ASSYN GO MORET
124327          T:=MBSYMOD; CALL TDBPUT; A/\177
124332          IF A=ASETX OR =ASETB OR =ASUS THEN MIN MOSW FI      % READ 2 CRC NEXT
124344          IF A=177 GO FAR MOSWX                               % END OF BLOCK
124347          GO MODPIN
124350   
124350   %
124350   %      IBM-3270 EMULATOR
124350   %
124350   
124350   I3270: IF A=EBSYN GO MORET
124353          T:=MBSYMOD; CALL TDBPUT
124355          IF A=EBSTX THEN T:=6=:MOSW FI             % STX : SET TEXT MODE
124362          IF A=EBEOT GO FAR MOSWY                   % EOT : NEW SYNC MAY FOLLOW
124365          IF A=EBPAD GO FAR MOSWX                   % ENDING PAD
124370          GO MODPIN
124371   %
124371   %      MOSW=6 : 3270 IN TEXT MODE
124371   %
124371   
124371   
124371   I3271: T:=MBSYMOD; CALL TDBPUT
124373          IF A=EBETX OR =EBETB THEN T:=1=:MOSW FI   % ETX/ETB : 2 CRC WILL FOLLOW
124403          GO MODPIN
124404   
124404   %
124404   %      BTH/VIP 7750 INTERACTIVE TERMINALS
124404   %
124404   BTH0:  IF A=0 GO MORET
124405          IF A=377 GO FAR MOSWX                     % PAD : END OF BLOCK
124410          T:=MBSYMOD; CALL TDBPUT
124412          A/\177
124413          IF A=ASETX OR =ASETB THEN                 % ETX/ETB : BCC NEXT
124421             2=:MOSW; GO MODPIN
124424          FI
124424          IF A=ASEOT GO FAR MOSWX                   % EOT
124427          GO MODPIN
124430   
124430   *)FILL
124440   
124440   %
124440   %      STANSAAB, ISO-1745 LINE PROCEDURE.
124440   %
124440   
124440   SSAAB: T:=177/\A=:D
124443          IF D=0 OR D=ASSYN GO MORET                 
124450          IF D=ASEOT OR D=ASNAK GO FAR MOSW3        % EOT/NAK : END OF BLOCK
124456          T:=MBSYMOD; CALL TSBPUT; A/\177
124461          IF A=ASDLE OR A=ASETX THEN 3=:MOSW FI     % DLE/ETX : 1 BCC WILL FOLLOW
124471          GO MODPIN
124472   
124472   %
124472   %      UNIVAC UTS-400 EMULATOR
124472   %
124472   UTS0:  IF A=0 OR =ASSYN OR =377 GO FAR MORET     % UTS-400
124501          T:=MBSYMOD; CALL TDBPUT; A/\177
124504          IF A=ASETX THEN 3=:MOSW; FI               % AFTER ETX : 1 BCC
124511          GO MODPIN
124512   
124512   MODPIN:
124512   MORET: 305/\HDXOK; T:=HDEV+BWRTC;*EXR ST
124517          -2=:TMR
124521          GO HODIN
124522   %
124522   % DRIVER FOR MODEM OUTPUT
124522   MODXX: 1; T:=HDEV+BWTCR; *EXR ST       % SEND SECOND SYN CHAR
124526          105; T+"BWTTC-BWTCR"; *EXR ST
124531          CALL ID12
124532          A:=0; T:=HDEV+BWTCR; *EXR ST    % CLEAR TSOM , GO ON WITH DATA    
124536   %
124536   %      IF THIS DRIVER IS RUNNING AS X21-BIS AND OTHER END IS NORD X21 THEN
124536   %      WE CAN NOT TURN OFF RQTS WHEN TRANSFER IS FINISHED I.E. T:=100 NOT
124536   %      T:=0
124536   %
124536   HODUT: DO;*IOF
124537             IF BHOLD=0 THEN 0=:TMR=:HOWSTAT; T:=0; CALL RTACT; GO HIT FI
124546             T:=MBSYMOD; CALL TDBGET; T:=HDEV+BWTDR;*EXR ST
124553             TTMR=:TMR
124555             T:=105
124556   HIT:      T=:A; T:=HDEV+BWTTC; *EXR ST;ION
124563             CALL ID12
124564          OD
124565   
124565   RBUS
