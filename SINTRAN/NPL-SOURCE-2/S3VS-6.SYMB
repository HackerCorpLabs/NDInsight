143242   %============================================================================
143242   *"-3PIT
"143242   *)KILL YENDC; YENDC=*
143242   *7ENDC/
075524   *"
"075524   %
075524   *"8UDMA 8PUDM
"075524   *)KILL 3PITU 3POFU
075524   *"8UDMA+8VICO -3PIT  
"075524   
075524   *"8PUDM+8PVIC -3PIT
"075524   *"3PITU+3POFU
"075524   
075524   
075524   *"8PIOC 8PPIO
"075524   *)KILL 3PITP 3POFP
075524   *"8PIOC 3PIT
"075524   *"8PPIO -3PIT
"075524   *"8PIOC+8PPIO -3PIT
"075524   SUBR PIOCM,APIOCM
075524   %===================================================================
075524   % LEVEL 1 ROUTINE TO CALL PIOC MONITOR CALL, ACTIVATED FROM SWAPREG
075524   % ALWAYS ON PIT 0
075524   %===================================================================
075524   PIOCM:
075524     *"8PIOC -3PIT
"075524     CALL SPT3PIT                    % SET NORM PIT=3, ALT PIT=0
075525     *"8PIOC+8PPIO -3PIT
"075525     * BSET ZRO
075526     GO APIOCM
075527   RBUS
075531   *"
"075531   *"3PITP+3POFP
"075531   
075531   *"8PIOC+8PPIO -3PIT
"075531   SUBR PDRIV,APDRIV
075531   %===================================================================
075531   % ROUTINE ON LEVEL 13 TO CALL PIOC DRIVER
075531   % (DRIVER AND STDRIV = PDRIV) ALWAYS ON PIT0
075531   %===================================================================
075531   PDRIV:
075531        *"8PIOC -3PIT
"075531        * PON
075532        *"8PIOC+8PPIO -3PIT
"075532        GO APDRIV
075533   RBUS
075534   *"
"075534   *"8PIOC+8PPIO -3PIT
"075534   SUBR PITIM
075534   %===================================================================
075534   % TIMOUT AFTER REMOVING RESET AND START
075534   % (TMSUB=PITIM) ALWAYS ON PIT0
075534   %===================================================================
075534   PITIM: X := 1002; A:=1; L=:D;
075537          *"8PIOC -3PIT
"075537          CALL SPT3PIT
075540          *"8PIOC+8PPIO -3PIT
"075540          CALL PWRIT;
075541          *"8PIOC -3PIT
"075541          CALL SPT0PIT
075542          *"8PIOC+8PPIO -3PIT
"075542          D=:P                                                % SET FLAG TO STOP LOOP
075543   RBUS
075547   *"
"075547   
075547   *"8PIOC+8PPIO -3PIT
"075547   SUBR PIORE
075547   %===================================================================
075547   % SPECIAL IO-RESTART ROUTINE FOR PIOC  (MFUNC=PIORE)
075547   % X = DATAFIELD, RTRES = PROGRAM TO BE STARTED
075547   % KPROS = PROCESS TO BE ACTIVATED (RT)
075547   % ALWAYS ON PIT0
075547   %===================================================================
075547   PIORE: X=:B:=KPROS
075551          PWCR BONE BENA=: PWCR; T := HDEV+3; *IOXT          % ENABLE PIOC
075557          CALL RTENTRY
075560          *IOF
075561          "STDRIV"; *IOF; IRW LV12B DT                        % START DRIVER AGAIN
075564          B=:A; *IRW LV12B DB
075566          "SLV12"; *IRW LV12B DP
075570          LV12; *MST PID; PION
075573          CALL STUPR
075574   RBUS
075600   *"
"075600   *"-3PIT
"075600   *)KILL 7ENDC; 7ENDC=*
075600   *YENDC/
143242   *"
"143242   @EOF
