115275   FCDSKFORM: IF "TRNSF"="BDISK" THEN
115301                 X:="HTABL"+B; X.S0; X:="CDSKFORM"; T:=20=:D; *MOVB; JMP *
115311                 "QDLAY" SHZ -12=:CPGN
115314              FI; EXIT
