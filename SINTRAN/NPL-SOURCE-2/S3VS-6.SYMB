074743   *"8SREE
"074743   INTEGER FIXCRT=?
074743   %==============================================================================
074743   % 36.15      S R E E N T
074743   %
074743   % MONITOR CALL SREENT(SEGNO) - ATTACH REENTRANT SEGMENT AND WRITE SHADDOW
074743   %                              PAGES WITH 5WIP TO MASSTORAGE
074743   
074743   SUBR SREENT
074743   
074743   INTEGER SAVB,SGA,SGB,RSGA=?,RSTA=?,REND=?
074746   SREENT: CALL GET1; A:=B=:SAVB; *POF
074752          CALL XCSEGS           % CLEAR PAGE TABLES
074753          IF D0><0 THEN
074755             CALL LEGSEG; X=:RSGA; IF X=NSEGA OR X=NSEGB GO RETSTUPR
074765             IF A NBIT 5DEMAND GO ERRD
074767             CALL RLEGSEG
074770             T:=D0; NSEGA.FLAG; X=:SGA; CALL SHRSOVERLAP
074775             T:=D0; NSEGB.FLAG; X=:SGB; CALL SHRSOVERLAP
075002             CALL SRESER         % RESERVE SWAPPING AND DISC SYSTEM
075003             IF BACKGROUND><0 THEN CALL ESCOF FI    % DISABLE ESCAPE
075006             X:=RTREF=:FIXCRT
075010             CALL CLRBMAP; 0=:RTREF.RSEGM; *POF
075014             RSGA.LOGADR/\377=:RSTA; X.LOGADR SHZ -10+RSTA=:REND
075024             IF X:=SGA><0 THEN CALL TFWBACK FI
075027             IF X:=SGB><0 THEN CALL TFWBACK FI
075032             SGA; T:=RSGA; CALL OVERLAP; SGB; T:=RSGA; CALL OVERLAP
075040             CALL SRELES; 0=:FIXCRT; *PION          % RELEASE SWAPPING AND DISC SYSTEM
075043             IF BACKGROUND><0 THEN CALL ESCON FI
075046             SAVB=:B
075050          FI;
075050          X:=RTREF; CALL CLRBMAP; X:=RTREF
075053          X.RSEGM/\177400+D0=:X.RSEGM; GO RETSTUPR
075060   
075060   % ERROR EXITS:
075060   ERRD:  CALL 9ERRA(#45); GO RETXIT  % NOT DEMAND SEGMENTS
075063   
075063   *)FILL
075111   
075111   %  LOCAL SUBROUTINE TO FIND SHADDOW PAGES WITH 5WIP AND WRITE THESE
075111   %  PAGES TO DISC.
075111   %  ENTRY:    X = SEGMENT TABLE ENTRY
075111   %            RSTA = FIRST LOGICAL PAGE FOR REENTRANT SEGMENT
075111   %            REND = LAST LOGICAL PAGE FOR REENTRANT SEGMENT
075111   %            SWAPPING AND DISCS MUST BE RESERVED!!
075111   %
075111   %  EXIT:     B IS DESTROID
075111   
075111   INTEGER RSGA,RSTA,REND
075114   INTEGER POINTER LREG
075115   TFWBACK: A:=L=:"LREG"; X=:B; T:=0; X+1
075122          FLAG BZERO 5OK=:FLAG
075125          DO; *LDXTX DPAGL
075126          WHILE X><0                      % FIND OVERLAPING PAGES
075127                T:=CORMBANK; *LDATX DALOG
075131                IF A>=RSTA AND A<REND THEN % SHADDOW PAGE
075137                   T:=CORMBANK; *LDATX DPGPR
075141                   IF A BIT 5WIP THEN A:=1=:D; B=:T; CALL ATRNSEG FI
075147                FI; T:=CORMBANK
075150          OD; GO LREG; *)FILL
075154   
075154   RBUS
