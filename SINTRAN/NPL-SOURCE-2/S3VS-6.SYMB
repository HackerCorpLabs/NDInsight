125175          *SDATA
125175   DISP 0
125175   INTEGER XREG,TREG,AREG,DREG,LREG,BREG
125175   INTEGER DBHAD,SAVSG,FUDSG,OLSGM,CFRSEG
125175   INTEGER ARRAY XBMSV(10)                % SAVE ARRAY FOR BITMAP
125175   INTEGER WNUMB,ZFUNC,REPAR,WMOVD,FSPEC
125175   INTEGER MDBU1,MDBU2; DOUBLE XMDBUF=MDBU1
125175   INTEGER FUBU1,FUBU2; DOUBLE FUBUF=FUBU1
125175   PSID
125175   
125175          *DATA FUBU2
125175   
125175   % AT ENTRY:
125175   %
125175   % XREG: POINTER TO OPEN FILE TABLE
125175   % TREG: ADDRESS TO DEVICE BUFFER HEADER
125175   % DREG: ADDRESS TO "DF-DATAFIELD"
125175   
125175   DISP 24; INTEGER OFADR,MGFUNC,RWFUN,DAADR,NWRDS,ANWRDS,RTPAR; PSID
125175   RMAGT:
125175   *"-8RFAC
"125175          *FENTR
125202          T=:DBHAD; T.DBPAG=:XMDBUF
125206          RTREF.RSEGM=:CFRSEG; X.ACTSEG=:SAVSG
125213          A:=DRFSG;  A\/177400=:FUDSG
125216          0=:FUBU1; TLBUF=:FUBU2; 0=:FSPEC
125222          % SAVE BITMAP FOR CALLER
125222   *"CXCPU
"125222          X:=X.RTDLGADDR+5BITMAP; "XBMSV"+B=:B; T:=0; *BSET ONE
125231          *LDDTX 00; STD 0,B; LDDTX 20; STD 2,B
125235          *LDDTX 40; STD 4,B; LDDTX 60; STD 6,B; BSET ZRO
125242          A:=B-"XBMSV"=:B;
125245   *"
"125245   
125245          A:=DREG.IFUNC=:ZFUNC; T:=X.IMAXW=:WNUMB
125252   @ICR
125252          IF A>4 AND ><43 AND ><44 AND ><25 AND ><52 AND ><55
125252             AND ><26 AND ><27 THEN
125252   @CR;
125302             4=:FSPEC; CALL SPARM; CALL PT3FUSER; GO FAR ERET
125307             IF ZFUNC=42 OR =46 OR =56 OR =63 THEN
125324                WMOVD=:DBHAD.DBLOCK;
125327             FI; REPAR=:DREG.SVXERR=:AREG; GO OUT3; *)FILL
125346          FI
125346          % READ OR WRITE FUNCTIONS:
125346          IF A=26 OR =27 THEN  % NUMBER OF BYTES IN IMAXW
125354             WNUMB+1 SHZ -1=:WNUMB; FSPEC+2=:FSPEC
125363          FI
125363          IF WNUMB<0 OR >2000 THEN A:=172; GO ERET; FI    % MAX 1 K
125372          IF ZFUNC><0 AND ><2 AND ><43 AND ><25 AND><26 AND ><36 GO MWRT
125413          % READ:
125413          CALL SPARM; CALL PT3FUSER; GO ERET; 
125416          % MOVE DATA FROM FILE USER DATA SEGMENT TO DEVICE BUFFER:
125416          RTREF.ACTPRI=:D; T:=FUDSG; CALL MMEXY; T=:OLSGM; A:=0; CALL MMREENT
125426          X:=MDBU2; T:=MDBU1; A:=TLBUF; CALL DBTRANS; X:=:A
125433          T:=WNUMB; CALL PT3COPYB; T:=OLSGM; CALL MMEXY; A:=CFRSEG; CALL MMREENT
125441          WMOVD=:DREG.IMAXW; REPAR=:X.SVXERR; "RRETU"=:LREG; GO OUT3; *)FILL
125463   MWRT:  % WRITE:
125463          % MOVE DATA FROM DEVICE BUFFER TO FILE USER DATA SEGMENT:
125463          RTREF.ACTPRI=:D; T:=FUDSG; CALL MMEXY; T=:OLSGM; A:=0; CALL MMREENT
125473          X:=MDBU2; T:=MDBU1; A:=TLBUF; CALL DBTRANS;       
125477          T:=WNUMB; CALL PT3COPYB; T:=OLSGM; CALL MMEXY; A:=CFRSEG; CALL MMREENT
125505          FSPEC+1=:FSPEC; CALL SPARM; CALL PT3FUSER; GO ERET; A:=REPAR
125514   ERET:  A=:AREG=:DREG.SVXERR; "RETU"=:LREG
125521   OUT3:  X:=RTREF; % RESTORE CALLERS BITMAP:
125522   *"CXCPU
"125522          X:=X.RTDLGADDR+5BITMAP; "XBMSV"+B=:B; T:=0; *BSET ONE
125531          *LDD 0,B; STDTX 00; LDD 2,B; STDTX 20
125535          *LDD 4,B; STDTX 40; LDD 6,B; STDTX 60; BSET ZRO
125542          A:=B-"XBMSV"=:B;
125545   *"
"125545          *FLEAV
125547   *)FILL
125562   
125562   SPARM: A:=XREG=:CSTCK.OFADR; "FUBU1"+B=:X.DAADR; "ZFUNC"+B=:X.MGFUNC
125573          "WNUMB"+B=:X.NWRDS; "WMOVD"+B=:X.ANWRDS; "REPAR"+B=:X.RTPAR
125604          "FSPEC"+B=:X.RWFUN; X:=UMAGTP; EXIT
