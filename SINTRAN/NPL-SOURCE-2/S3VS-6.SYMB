"114403            X:=GOTAB(T); *JMP ,X; )FILL             % MONITOR CALL NUMBER IN T
114413   POFNMONC: *TRA PVL
114414          A=:D; *EXR SA
114416          A=:PERR:=D SH 11 SHZ -14=:ACTLV
114423          IF IBITNO=12 THEN CALL PPWFAIL FI
114430          IF =7 THEN PERR; T:=ACTLV; CALL 9ERR(#37); GO RET14 FI % IOX-ERROR
114440          IF =10 THEN           % MEMORY ERROR
114443                *TRA PES
114444                A=:T=:PESERR
114446                IF CPSTA BIT 5N100 THEN
114451                  IF PESERR BIT 5FATAL THEN
114454                    GO NOCORR
114455                  ELSE
114456                    GO NOFATAL
114457                  FI
114457                FI
114457                IF PESERR BIT 5ERC THEN % 21 BITS MEMORY
114462                  A SH -11/\37+SADINSTR=:X; MMAP; *EXR SX
114470                  IF A<0 GO NOCORR        % MULTIPLE ERROR
114471   NOFATAL:       *TRA PEA
114472   NOFAP1:        A=:PEAERR
114473                  CALL 9ERR(#44); A:=0; *TRR ERCC
114477                ELSE
114500   NOCORR:        *TRA PEA
114501   NOCP1:        A=:PEAERR; CALL 9ERR(#38)  % NOT CORRECTABLE ERROR
114504                  A:=PEAERR; T:=PESERR; CALL MFXMSG           % FATAL MEMORY ERROR IN XMSG?
114507                  IF CPSTA BIT 5N100 THEN
114512                    IF PESERR BIT 5DMA THEN CALL ERRFATAL FI  % DMA-ERROR N-100
114516                  ELSE
114517                    IF PESERR BIT 3 THEN CALL ERRFATAL FI     % DMA-ERROR N-10
114523                  FI
114523                  IF ACTLV=ALEVL GO ABOR; IF ><0 GO FAR TDTLEV
114531                FI; GO RET14; *)FILL
114542          FI
114542          IF A=0 THEN A:=16; T:=0; CALL 9ERR(#22); GO RET14 FI  % FALSE INTERRUPT
114550          IF ACTLV=ALEVL THEN
114554                IF IBITNO=3 THEN
114560   NOTRAP:         *TRA PGS
114561                   IF A=:PNUMB NBIT 17 THEN
114564                      *IRR ALEVB DP; AAA -1; IRW ALEVB DP
114567                   FI; T:="PPAGEFAULT"; GO FAR IPAGFAULT
114571                FI
114571                IF =6 THEN
114574                  RTREF.ACTPRI/\3000 SH -2\/162; X:=PERR; *TRR PCR; BSET ONE 0
