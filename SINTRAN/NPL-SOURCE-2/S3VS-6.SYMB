111763   *"7TEXT
"111763  ==============================================================================
111763   40.2       C H D L 1   C H D L 2
111763  

)9SCLC
111763  %
111763  % ROUTINES FOR GIVING 5 DUMMY CHARACTERS AFTER EACH CARRIAGE-RETTURN
111763  % THE DUMMY CHARATER IS 26 OCTAL
111763  %
111763  
111763  % CHDL1 IS CALLED  FROM THE ROUTINE ECHSUBR
111763  %
111763  % ENTRY: A=CHARACTER TO OUTPUT (ECHO)
111763  %
111763  % EXIT:  A=OLD CHARACTER OR A=26 (DUMMY CHARACTER)
111763  
111763  CHDL1, COPY SL DT; STT CHDLL; COPY SA DD; JPL CHDLF; JMP CHDLA
111770         COPY SD DA; LDT TYPRI,B; BSKP ONE 50 DA; JMP NTRM2  % TEST ON BIT 5TERM
111774         JPL I (CXRBP; SAA 26; JMP I CHDLL
111777  NTRM2, JPL I (RBPUT; SAA 26; JMP I CHDLL
112002  
112002  CHDLA, COPY SD DA; JPL XXCRT
112004  CHDLD, COPY SD DA; JMP I CHDLL
112006  
112006  % TEST IF CURRENT CHARACTER IS CR AND SET "DUMMY-CHARACTER" COUNTER TO 5
112006  % WHEN CHAR IS CR (THE COUNTER IS BIT 6-8 IN TYPRING)
112006  %
112006  XXCRT, AND (177; AAA -15; JAZ *+2; EXIT
112012         LDA (500; ORA TYPRI,B; STA TYPRI,B; EXIT
112016  
112016  % TEST IF MORE DUMMY CHARACTERS MUST BE GIVEN
112016  % EXIT:      NO MORE DUMMY CHARACTERS
112016  % EXIT+1:    GIVE DUMMY CHARACTER
112016  %
112016  CHDLF, LDA TYPRI,B
112017         SHA ZIN SHR 6; AND (7; JAF *+2; EXIT
112023         AAA -1; SHA 6; LDT TYPRI,B; SWAP SA DT; AND (177077
112030         RORA ST DA; STA TYPRI,B; EXIT AD1
112033  
112033  % ENTRY FROM THE ROUTINE DWRITE
112033  % TEST IF THE CHARACTER TO OUTPUT SHOULD BE FETCHED FROM THE RING-BUFFER
112033  % OR A DUMMY CHARACTER SHOULD BE GIVEN.
112033  % EXIT WITH THE CHARACTER TO OUTPUT IN A-REG
112033  %
112033  CHDL2, COPY SL DA; STA CHDLL; JPL CHDLF; JMP CHDLC; SAA 26
112040  CHDLB, JMP I CHDLL
112041  CHDLC, LDT TYPRI,B; BSKP ONE 50 DT; JMP NTRM1              % TEST ON BIT 5TERM
112044         JPL I (CXRBG; JMP FELLS
112046  NTRM1, JPL I (RBGET
112047  FELLS, COPY SA DD; JPL XXCRT; COPY SD DA; JMP CHDLB
112053  
112053  CHDLL, 0
112054  
112054  )FILL
112062  )KILL CHDLA XXCRT CHDLF CHDLB CHDLC CHDLL CHDLD NTRM2 NTRM1 FELLS
112062  
112062  )9RCLC
)9SLPL"112062   %==============================================================================
112062   % 40.5       X O N C H E C K   X O F F C H E C K   O X O N C H E C K
112062   %
112062   % SUBROUTINE TO TELETYPE DRIVERS TO CONTROL
112062   % XON/XOFF SENDING TO TELETYPE INTERFACES
112062   % XOFF IS GIVEN WHEN ONLY 5 FREE CHAR-ENTRIES IN BUFFER
112062   % XON IS GIVEN WHEN HALF THE BUFFER IS FREE AND "XOFF" HAS
112062   % PREVIOUSLY BEEN GIVEN
112062   % LEVEL 12
112062   %
112062   SUBR XONCHECK,OXONCHECK
112062   INTEGER POINTER LREGL
112063   XONCHECK:
112063          IF X=0 OR DFLAG NBIT 5RDEVICE THEN EXIT FI
112070          A:=L=:"LREGL"
112072          IF DFLAG BIT 5XOFF OR A BIT 6XOFF GO CONT1
112077          IF BHOLD>MAX-5 THEN
112104                IF X.EMPTFLAG><0 THEN
112106                   0=:X.EMPTFLAG; "XOFF"; X:=:B; CALL OOAPD; X:=:B
112113                ELSE
112114                  DFLAG BONE 5XOFF=:DFLAG
112117                FI
112117                DFLAG BONE 6XOFF=:DFLAG
112122                GO CONT2
112123          FI
112123   CONT1: IF DFLAG BIT 5XON OR A NBIT 6XOFF GO CONT2
112130          IF CFREE=MAX SHZ -1 THEN
112135                IF X.EMPTFLAG><0 THEN
112137                   0=:X.EMPTFLAG; "XON"; X:=:B; CALL OOAPD; X:=:B
112144                ELSE
112145                  DFLAG BONE 5XON=:DFLAG
112150              FI; DFLAG BZERO 6XOFF=:DFLAG
112153          FI
112153   CONT2: GO LREGL
112154   
112154   % OUTPUT LEVEL, (LEVEL 10)
112154   OXONCHECK:
112154          IF X=0 OR T:=X.DFLAG NBIT 5RDEVICE THEN EXITA FI
112161          IF T:=X.DFLAG BIT 5XON THEN "XON"; T BZERO 5XON=:X.DFLAG; EXIT FI
112170          IF T BIT 5XOFF THEN "XOFF"; T BZERO 5XOFF=:X.DFLAG; EXIT FI
112176          EXITA
112177   
112177   RBUS
112200   
112200   *"-8RON
"112200   
112200   *"8XON
"112200   %==============================================================================
112200   % 40.6       X O N R E A D
112200   %
112200   %
112200   %      SUBROUTINE TO INPUT DRIVERS
112200   %      TO CHECK FOR RECIEVED XON/XOFF FROM LEGAL DEVICE
112200   %      LEVEL 12.
112200   %
112200   %      EXIT  => IGNORE THIS CHAR.
112200   %      EXITA => CHAR. OK AS INPUT.
112200   %
112200   %
112200   %
112200   SUBR XONREAD
112200   XONREAD:  A/\177=:D                              % SAVE CHAR FOR TESTS & RETUR.
112202          IF DFLAG NBIT 5XDEVICE GO OKUT            % NOT ALLOWED
112205          IF D><"XON" AND D><"XOFF" GO OKUT         % NOT XON/XOFF
112213          IF D="XON" THEN                           % XON RECIEVED.
112216                A BZERO 5OXON =: DFLAG              % FLAG XOFF-STATE
112220                T := X.HDEV + DCONT                 % RESTART OUTPUT DRIVER
112222                A:=1; *IOXT  
112224          ELSE
112225                A BONE 5OXON =: DFLAG               % XOFF; FLAG.
112227                0=:X.TMR
112230          FI
112230          EXIT                                      % IGNORE-RETURN.
112231   
112231   OKUT:  EXITA                                     % OK RETURN
112232   
112232   RBUS
112233   
112233   %==============================================================================
112233   % 40.7       X O N W R I T E
112233   %
112233   %      ROUTINE TO CHECK FOR XOFF-STATE
112233   %      OUTPUT LEVEL (LEVEL 10)
112233   %
112233   %      EXIT  => XOFF STATE / DON'T SEND ANYTHING.
112233   %      EXITA => XON STATE / SEND
112233   %
112233   %            CALLED IN IOF
112233   %            =============
112233   %
112233   
112233   SUBR XONWRITE
112233   
112233   XONWRITE:
112233          IF X=0 OR X.DFLAG NBIT 5XDEVICE THEN EXITA FI
112240          IF A NBIT 5OXON THEN EXITA FI
112243          EXIT
112244   
112244   RBUS
112244   *"-8XON
"112244   
112244   @LIB CXCPU
112244   %==============================================================================
112244   % 40.8       X M S G / P I T 3     E N T R Y    P O I N T S
112244   %
112244   %==============================================================================
112244   %
112244   SUBR CLXMS,PFXMS,MFXMS,DRXMS,ZXRES,ZXRRS,ZXTRS,P2XMS,ZXCOM,XMSGA,XPFAD,XDHOM
112244   
112244   % GENERAL PHILOSOPHY: LEVELS 5,10,12,13,14 (DEC) WILL ALWAYS HAVE PIT3 SET
112244   % AS NORMAL AND ALTERNATIVE
112244   % XMSG ALWAYS RUNS ON PIT3
112244   INTEGER POINTER HOME=?
112244   
112244   XPFAD: INTEGER ZXH:=0
112245   XMSGA: INTEGER POINTER ZGO:=ZGO+1      % GENERALISED ENTRY POINT TO XMSG PIT3
112246                                          % X=CODE: 1=DRIVER, 2=POWERFAIL, 3=CLOCK
112246                                          %         4=MEMORYFAIL, 5=MONCALL
112246                                          %         6=HDLC INIT, 7= HDLC RCV
112246                                          %         8=HDLC XMIT
112246                                          % OLD X-REG IS SAVED IN D-REG
112246   DUM: -45=:T                            % DUM IF XMSG NOT ACTIVE
112250        IF X-1=0 THEN MIN "HOME"; FI      % DO EXITA IF DRXMSG
112254        EXIT
112255   XDCOM: A:=D; X=:D:=1;                  % DRIVER CALL. RECOVER A-REG. SAVE X IN D
112260   ZXCOM:
112260   COM:   *PON
112261          GO ZGO                          % ORIGINAL X IS IN A. CODE IS IN X
112262   
112262   % CLOCK HANDLING (MONITOR LEVEL)
112262   INTEGER POINTER CLSAV,PFSAV,MFSAV,HISAV,HRSAV,HTSAV
112270   CLXMS: X=:D:=L=:"CLSAV":=A; 3632; *TRR PCR       % SWITCH TO PIT3
112276          X=:A:=3; CALL COM; 32; *POF; TRR PCR      % AND BACK TO PIT0
112304          GO CLSAV
112305   PFXMS: X=:D:=L=:"PFSAV":=2; CALL COM; *POF
112313          GO PFSAV
112314   MFXMS: X=:D:=L=:"MFSAV":=4; CALL COM; *POF
112322          GO MFSAV
112323   ZXRES: X=:D:=L=:"HISAV":=6; CALL COM; *POF
112331          GO HISAV
112332   ZXRRS: X=:D:=L=:"HRSAV":=7; CALL COM; *POF
112340          GO HRSAV
112341   ZXTRS: X=:D:=L=:"HTSAV":=10; CALL COM; *POF
112347          GO HTSAV
112350   P2XMS: IF "ZGO"="DUM" OR ZXH=0 THEN EXIT; FI; *IRW DP 50; EXIT AD1
112361   
112361   
112361   % ENTRY POINT (PIOF) FROM DIRECT DRIVER ROUTINE CALLS TO XMSG (TO XDFUE)
112361   XDHOM: INTEGER POINTER HOME;INTEGER LEV,SAVA,SAVX
112365   DRXMS: A=:D:=50:=:L=:"HOME"; *TRA STS  % GET INTERRUPT LEVEL. SAVE A-REG IN D!!
112372          IF A SHZ -5/\170<L              % LOWER THAN LEVEL 5?
112374          THEN A=:LEV\/3602; *TRR PCR     % SWITCH TO PIT3 (APT AND NPT)
112401               CALL XDCOM; *POF           % CALL XMSG ROUTINE ON PIT3
112403               A=:SAVA:=LEV; X=:SAVX:=12  % SAVE RETURN VALUES
112407               IF A\/2=X THEN CURPROG.ACTPRI/\3773; FI; *TRR PCR; 
112416               SAVA; X:=SAVX; 
112420          ELSE CALL XDCOM; *POF           % GO TO SPESIAL VERSION OF COM
112423          FI; GO HOME
112424   RBUS
112433   
112433   SUBR XMSGY                   % XMSG MONITOR CALL HANDLER (EVEN WHEN NO XMSG)
112433   INTEGER XPVL,XPBIT:=100000
112435   INTEGER XIRRP(0); * IRR DP
112436   INTEGER XIRWP(0); * IRW DP
112437   INTEGER XIRWT(0); * IRW DT
112440   
112440   % COME HERE FROM POFMONC VIA GOTAB
112440   XMSGY: T:=A; *TRA PVL                  % SAVE PAGING STATUS IN T, GET LEVEL
112442          A=:D/\170=:XPVL                 % SAVE LEVEL
112445          IF T NBIT 16                    % WAS CALLING LEVEL IN POF?
112445          THEN A SHZ -3=:X; *EXR SD       % GET HIS P-REG
112452               CALL XFIPV; T:=0; XPVL     % SAVE IN SWITCH TABLE, T=PAGING STATUS
112455          ELSE T:=XPBIT                   % T=PON BIT, A=PREVIOUS LEVEL*10
112457          FI;
112457          X:=5; D:=T; CALL ZXCOM          % GOTO XMSG (A=PREVLEV*10,T=D=PAGING STAT)
112462          % RETURN HERE IF XMSG NOT RUNNING (D=0 IF PAGING WAS OFF)
112462          IF XPVL>40                      % DRIVER CALL?
112464          THEN  A SHZ -3=:X               % GET PAGING STATUS
112470                IF 0=D                    % WAS PAGING OFF?
112470                THEN X:=PVLAD(X); X.S2+1=:X.S2 % SET SWITCH TABLE AGAIN TO A SKIP
112476                ELSE
112477                   XPVL\/XIRRP; *EXR SA   % GET HIS P-REG (AGAIN!)
112502                   A+1=:D:=XPVL\/XIRWP:=:D; *EXR SD % GIVE HIM A SKIP RETURN,WRITE HIS P-REG DIRECT
112510                FI
112510          FI
112510          XPVL\/XIRWT=:D:=-45; *EXR SD    % SET HIS T-REG TO 'XMSG NOT RUNNING'
112515          GO RET14
112516   RBUS
