126613   B8IWORD: DFOPP=:B; IF CFREE-4<0 GO NOSPACE
126620          BUFST+FYLLE=:X; BUFST+MAX=:L
126626          *IRR ALEVB DA
126627          A=:X.S0; IF X+1=L THEN X:=BUFST FI; *IRR ALEVB DD
126635          A=:X.S0; IF X+1=L THEN X:=BUFST FI; *IRR ALEVB DL
126643          A=:X.S0; IF X+1=L THEN X:=BUFST FI; *IRR ALEVB DX
126651          A=:X.S0; IF X+1=L THEN X:=BUFST FI
126656          BHOLD+4=:BHOLD; CFREE-4=:CFREE; A:=X-BUFST=:FYLLE
126667          *IRR ALEVB DX
126670   RETINDV: A=:CHARI; DFOPP=:B; CALL STDEV; GO MOURET
126675   
