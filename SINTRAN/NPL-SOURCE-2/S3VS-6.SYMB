127535   RBUS
127541   
127541   *"8VIPS
"127541   @ELIB
127541   @LIB CXCPU-,
127541   %==============================================================================
127541   % 39.11      B 4 I N T E R M   B 4 I I N D V
127541   %
127541   
127541   SUBR B4INTERM,B4IINDV,IB4INTERM
127541   INTEGER CCHAR
127542   IB4INTERM:
127542   B4INTERM: IF BHOLD<10 GO WDX           % NOT ENOUGH DATA IN BUFFER
127546          IF HENTE NBIT "0" THEN GO EVEN FI
127552          X:=HENTE; T:=BUFST; MAX=:L; *LBYT                   % ( 1.BYTE)
127557          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % ( 2.BYTE)
127566          A\/CCHAR; *IRW ALEVB DA
127570          IF X+1=L THEN X:=0 FI; *LBYT                        % ( 3.BYTE)
127575          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % ( 4.BYTE)
127604          A\/CCHAR; *IRW ALEVB DD
127606          IF X+1=L THEN X:=0 FI; *LBYT                        % ( 5.BYTE)
127613          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % ( 6.BYTE)
127622          A\/CCHAR; *IRW ALEVB DL
127624          IF X+1=L THEN X:=0 FI; *LBYT                        % ( 7.BYTE)
127631          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % (10.BYTE)
127640          A\/CCHAR; *IRW ALEVB DX
127642          T:=10; A:=T; *IRW ALEVB DT
127645          BHOLD-T=:BHOLD; CFREE+T=:CFREE
127653          IF X+1=L THEN X:=0 FI; X=:HENTE; *ION
127661          GO MOURET
127662   
127662   EVEN:  A SHZ -1+BUFST=:X; MAX SHZ -1+BUFST=:L
127671          X.S0; *IRW ALEVB DA
127673          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DD
127701          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DL
127707          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DX
127715          T:=10; BHOLD-T=:BHOLD; CFREE+T=:CFREE; A:=T; *IRW ALEVB DT
127726          IF X+1=L THEN X:=BUFST FI; A:=X-BUFST SHZ 1=:HENTE
127736          *ION
127737          GO MOURET
127740   
127740   *)FILL
127742   
127742   @ELIB
127742   @LIB CXCPU
127742   
127742   B4IINDV: IF BHOLD<4 GO WDX
127746          IF "IOTRANS"="IGTCH" GO IB4INTERM
127752          MAX+BUFST=:L; HENTE+BUFST=:X
127760          X.S0; *IRW ALEVB DA
127762          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DD
127770          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DL
127776          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DX
130004          T:=4
130005   WORET: BHOLD-T=:BHOLD; A:=T; *IRW ALEVB DT
130012          CFREE+T=:CFREE; IF X+1=L THEN X:=BUFST FI; A:=X-BUFST=:HENTE
130024          *ION
130025          GO MOURET
