062072                400=:D; CALL DALTON
062075              FI; *BSET ZRO
062076              IF RSWITCH<2 THEN 153120 ELSE 153117 FI; A=:D
062106              T:=CFILNO; "CRWPAR"; *EXR SD
062111              A=:AARG
062112              IF RSWITCH=0 THEN
062114                RTREF.ACTSEG/\177400; T:=5RT2SG\/A; CALL MMEXY
062122   OUT1:      FI; 200=:D
062124   OUT:       CALL DALTON; TAD:=SVTAD; X:=LLRG=:L:=XXRG; EXIT
