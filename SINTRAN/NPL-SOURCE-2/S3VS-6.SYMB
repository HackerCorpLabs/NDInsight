117574   %==============================================================================
117574   % 37.12      S E G S O R T
117574   
117574   % SUBROUTINE TO PUT NON-USED PAGES FIRST IN PAGE LINK
117574   % B=SEGMENT
117574   SUBR SEGSORT
117574   INTEGER LST0,LST0BANK,LST1,LST1BANK,FRST1,XREG
117602   SEGSORT: IF FLAG NBIT 5DEMAND THEN EXIT FI;
117606          X=:XREG:=BPAGLINK; A:=B+1=:LST0; 0=:LST0BANK; "FRST1"=:LST1
117615          0=:LST1BANK
117616          DO
117616             T:=CORMBANK; *LDATX DPGPR
117620             A:=:X
117621             IF X BIT 5PGU THEN
117623                T:=LST1BANK; X:=LST1; *STATX
117626                A=:LST1; T:=CORMBANK=:LST1BANK
117631             ELSE
117632                T:=LST0BANK; X:=LST0; *STATX
117635                A=:LST0; T:=CORMBANK=:LST0BANK
117640             FI; X:=A; *LDXTX DPAGL
117642          WHILE X><0
117643          OD; X:=LST1; T:=LST1BANK; *STZTX
117647          FRST1; X:=LST0; T:=LST0BANK; *STATX
117653          X:=XREG; EXIT
117655   RBUS
117657   
117657   %==============================================================================
117657   % 37.13      R A N D O M
117657   
117657   % SUBROUTINE TO TAKE A RANDOM(PREFERABLY NOT USED) PAGE AND PUT IT FIRST
117657   % ENTRY:     B=SEGMENT
117657   SUBR RANDOM
117657   INTEGER XREG,XN:=3614,CC:=33031,AA:=12465,PREVX,PREVT
117665   RANDOM: IF FLAG NBIT 5DEMAND THEN EXIT FI
117671          X=:XREG; X:=BPAGLINK; D:=0; T:=CORMBANK
117675          DO
117675             IF X=0 GO L1; *LDATX DPGPR
117677             IF A BIT 5PGU GO L1
117701             D+1; *LDXTX DPAGL
117703          OD
117704   L1:    IF D=0 THEN
117706             DO WHILE X><0
117707                D+1; *LDXTX DPAGL
117711             OD
117712          FI
117712          D=:T; XN*AA+CC=:XN BZERO 17=:D:=0; *RDIV ST
117723          X:=BPAGLINK; A:=B+1=:PREVX; 0=:PREVT; T:=CORMBANK
117730          FOR D-+1 TO 0 DO
117734             X=:PREVX; T=:PREVT; *LDXTX DPAGL
117737          OD; *LDATX DPAGL
117742          X=:T:=PREVX; T=:PREVX:=PREVT; *STATX DPAGL
117747          X:=PREVX; T:=CORMBANK; BPAGLINK; *STATX DPAGL
117753          X=:BPAGLINK
117754          X:=XREG; EXIT
117756   RBUS
