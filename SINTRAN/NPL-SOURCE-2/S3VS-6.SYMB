116056   %==============================================================================
116056   % 37.3       C L S E G   S T S E G   X C L S E G   Y C L S E G
116056   %            C L P A G E   S L A M U    C L A M U
116056   %
116056   %  SUBROUTINES TO UPDATE THE HARDWARE PAGE TABLE
116056   % ENTRY:     A=SEGM. POINTER
116056   
116056   SUBR CLSEG,STSEG,CLPAGE,SCPOUT,CLWINDOWS,CLAMU,SLAMU
116056   *"8LAMU
"116056   DOUBLE ARRAY POINTER PTBG0=?
116056   INTEGER ARRAY POINTER IPTBG=?
116056   INTEGER POINTER LREG
116057   INTEGER CL,CACLE
116061   
116061   SLAMU: K:="0"; GO LAMU
116063   CLAMU: K:=1
116064   LAMU:  A:=L=:"LREG"; IF A:=SEGPROG = 0 GO LREG
116071          A-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
116076          A*GNLPRT*ALMSZ+LAMACT=:CACLE; 0=:CL
116103          FOR CL TO GNLPRT-1 DO
116110                A*ALMSZ+CACLE=:X; T:=LAMBANK; *LDDTX
116115                IF A >< 0 THEN            % D=FIRST LOGICAL PAGE NO
116116                   A*LDTSZ+LAMDT=:X; *LDATX LMNP
116122                   L:=D+A-1+L; *LDATX LMPP;
116127                   * LDXTX LMPR; COPY SX DT  % T= LAMU PROTECTION
116131                   X:=D+X; D:=A; A:=T
116135                   IF K THEN
116137                      FOR X STEP 2 TO L DO 0=:IPTBG(X) OD
116144                   ELSE
116145                      FOR X STEP 2 TO L DO AD=:PTBG0(X); D+1 OD
116153                   FI
116153                FI
116153          OD; GO LREG
116160   
116160   *)FILL
116170   *"
"116170   
116170   INTEGER PINDEX,BRG
116172   DOUBLE POINTER P76:=177174,P77:=177176
116174   INTEGER POINTER IP76=P76,IP77=P77
116174   DOUBLE ARRAY POINTER PTBG0:=177000,PTBG1:=177002
116176   INTEGER ARRAY POINTER IPTBG=PTBG0
116176   INTEGER POINTER BPG:=177000+5BFPAGE+5BFPAGE
116177   *"CXCPU
"116177   CLWINDOWS:
116177   @LIB CXCPU
116177   @LIB CXCPU-,
116177              AD:=P76; IF A><0 THEN X:=WIND1+X; AD=:PTBG0(X); 0=:IP76 FI
116205              AD:=P77; IF A><0 THEN X:=WIND1+X; AD=:PTBG1(X); 0=:IP77 FI
116213   @ELIB
116213              0=:BPG; EXIT
116215   
116215   CLSEG: IF A=0 THEN EXIT FI
116217          X=:PINDEX; A:=:B; A=:BRG
116222   @LIB CXCPU-,
116222          AD:=P76; IF A><0 THEN X:=WIND1+X; AD=:PTBG0(X); 0=:IP76 FI
116230          AD:=P77; IF A><0 THEN X:=WIND1+X; AD=:PTBG1(X); 0=:IP77 FI
116236          0=:BPG
116237   @ELIB
116237   L1:    T:=CORMBANK; X:=BPAGLINK
116241   @LIB CXCPU
116241   @LIB CXCPU-,
116241   
116241   DOUBLE XCLEP(0)                        % ALTERNATIVE ROUTINE
116241                                          % ICLEP; JMP OUT
116241   
116241          DO
116241             IF X=0 GO OUT
116242             *LDBTX DALOG; 177700                   % MIC. PROGRAM BUG!!!!!
116244             AD:=DOU0
116245             IF A><0 THEN
116246                *STDTX DPGPR
116247                0=:S0
116250             FI; *LDXTX DPAGL
116251          OD
116252   @ELIB
116252   
116252   STSEG: IF A=0 THEN EXIT FI
116254          X=:PINDEX; A:=:B; A=:BRG
116257          T:=CORMBANK; X:=BPAGLINK
116261   @LIB CXCPU
116261   @LIB CXCPU-,
116261   
116261   DOUBLE XSETP(0)                        % ALTERNATIVE ROUTINE:
116261                                          % ISETP; JMP OUT
116261          DO
116261             IF X=0 GO OUT
116262             *LDDTX DPGPR
116263             A BZERO 5PGU; *LDBTX DALOG; 177700     % MIC. PROGRAM BUG!!!!!!!
116266             AD=:DOU0; *LDXTX DPAGL
116270          OD
116271   @ELIB
116271   SCPOUT:
116271   OUT:   X:=BRG=:B:=PINDEX
116274          EXIT
116275   CLPAGE: T:=B=:BRG; T:=CORMBANK; *LDBTX DALOG; 177700   % MIC. PROG. BUG!!!
116302          0=:S0; BRG=:B; EXIT
116306   RBUS
