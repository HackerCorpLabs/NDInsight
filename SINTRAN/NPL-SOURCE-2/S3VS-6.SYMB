123415   *"8IBRS
"123415   %=======================================================================
123415   %            I B R 3 S 
123415   %
123415   % MONITOR CALL TO RETURN NUMBER OF CHARACTERS IN THE INPUT-BUFFER
123415   % IF BREAK STRATEGY APPLIES TO THE DEVICE, NUMBER OF CHARACTERS    
123415   % UNTIL BREAK CONDITION IS ALSO RETURNED.
123415   % MON 313
123415   % ENTRY:       T = DEVICE-NUMBER
123415   % SKIP-RETURN: A = NUMBER OF CHARACTERS IN BUFFER
123415   %              X = BREAK CHARACTER NUMBER
123415   % NOSKIP:      A = ERROR CODE
123415   
123415   SUBR IBR3S,T206RET
123415   INTEGER POINTER PTTNO:=TTNO,PBCHFLAG:=BCHFLAG
123417   INTEGER BREG=?,BCOUNT=?,BHENTE=?,BBUFS=?
123417   @LIB CXCPU
123417   IBR3S: CALL GZTREG; GO FAR ERR; IF A=0 GO FAR ERR; *IOF
123424          A:=:B=:BREG
123426          IF TYPRING BIT 5TERM THEN                 % TERMINAL
123431   @LIB CXCPU
123431             0=:BCOUNT
123432             IF BRKTAB><0 THEN                                          % BREAK APPLIES
123434                IF BHOLD><0 THEN        
123436                   IF DFLAG NBIT 5ECHO THEN                             % PAST BREAK IN DRIVER
123441                      HENTE=:BHENTE
123443                      IF RSISTE=-1 THEN                                 % HENTE PAST FIRST BREAK
123447   CHCHR:                1=:BCOUNT
123451   @LIB CXCPU
123451   @LIB CXCPU-,
123451                         BUFST=:BBUFS
123453   @ELIB
123453                         FOR X:=BCOUNT TO BHOLD DO; X=:BCOUNT           % SEARCH FOR BREAK
123460                            T:=BBUFS; X:=BHENTE
123462   @LIB CXCPU
123462   @LIB CXCPU-,
123462                            CALL IBLBYT
123463   @ELIB
123463                            X+1 IF X=MAX THEN X:=0 FI; X=:BHENTE
123471                            X:=BRKTAB; CALL VSXGETBIT; IF A<0 GO RETTR
123474                         X:=BCOUNT; OD
123477                         0=:BCOUNT
123500                         IF BRKMAX><0 THEN
123502                            IF BHOLD+NCBRK>=BRKMAX THEN    
123507                               BRKMAX-NCBRK=:BCOUNT
123512                            FI
123512                         FI
123512                      ELSE
123513                         IF BHENTE=RSISTE GO CHCHR
123517                         DO                                             % BREAK FROM DRIVER
123517                            A+1; IF A=MAX THEN A:=0 FI                  % FIND NUMBER
123524                            MIN BCOUNT; IF A=RSISTE GO RETTR 
123530                         OD
123531             FI;FI;FI;FI
123531   RETTR:    A:=BHOLD        
123532   @LIB CXCPU
123532             GO RETU; *)FILL
123537   
123537   INTEGER BREG,BCOUNT,BHENTE,BBUFS 
123543   
123543          FI
123543          IF TYPRING BIT 5COM THEN                  % COMMINICATION CHANNEL
123546             IF BRKTAB><0 THEN
123550                BYTS-=:BCOUNT
123553             ELSE
123554                0=:BCOUNT
123555             FI
123555             A:=BYTS-; GO RETU
123560          FI
123560          IF TYPRING BIT 5BAD THEN                  % BACKGROUND ACCESS DEVICE
123563             X:=BREG; GO T2C06                      % RETURN IN BISIZ IF TAD INCLUDED
123565          FI
123565   T206RET:
123565          IF TYPRING BIT 5IOBT THEN
123570             0=:BCOUNT; A:=BHOLD; GO RETU
123573          FI
123573   
123573   ERRB:  BREG=:B           
123575   ERR:   240=:ZAREG; GO RET
123600   RETU:  T:=BREG=:B; T:=BCOUNT         
123603          A=:ZAREG; T=:ZXREG; MIN ZPREG; 0/\0; GO RET
