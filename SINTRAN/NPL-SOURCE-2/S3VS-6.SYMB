061776   INTEGER ARRAY CRWPAR:=(CFILNO,"0");INTEGER CMAD
062001   INTEGER ARRAY 2CRWPAR:=(CBLCKNO,CNWRD)
062003   *MRTRG=*;MRXRE=*+1;MELRT=*+2;MRCPL=*+3
