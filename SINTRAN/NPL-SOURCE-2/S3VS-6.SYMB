120407   *"8MOLI
"120407   %==============================================================================
120407   %
120407   % MON LOGIN
120407   %            <LOG.DEV>       : LOGICAL DEVICE NUMBER OF THE TERMINAL
120407   %            <USER NAME>
120407   %            <PASSWORD>
120407   %            <PROJECT PASSWORD>
120407   %            <SUBSYSTEM NAME>
120407   %            <PASET PARAMETERS>
120407   %            <RETURNED STATUS>
120407   %
120407   
120407   SUBR 3MLOGIN
120407   
120407   INTEGER MLCPLIST=?
120407   GSX:   X:=MLCPLIST+A; *BSET ONE
120412          X.S0; *BSET ZRO
120414          EXIT
120415   
120415   CMOVSTR: A=:MLICADDR+20=:MLIMXADDR
120420          DO WHILE X:=MLICADDR><MLIMXADDR
120424             *BSET ONE
120425             X.S0; *BSET ZRO
120427             IF A=:MLIWORD SHZ -10=15 OR A=##' GO OUT
120437             X:=MLICPNT; T:=B; *SBYT
120442             MIN MLICPNT; IF MLIWORD/\377=15 OR A=##' GO OUT
120453             X:=MLICPNT; T:=B; *SBYT
120456             MIN MLICPNT; MIN MLICADDR
120460          OD; EXIT
120462   OUT:   15; T:=B; X:=MLICPNT; *SBYT
120466          MIN MLICPNT
120467          EXITA
120470   *)FILL
120471   
120471   INTEGER MLCPLIST
120472   3MLOGIN: ZAREG=:MLCPLIST
120474          MLEV; *MST PIE
120476          CALL ALTON; *BSET ZRO
120500          "S6"; CALL GSX; A=:MLIADDR
120503          D0; CALL LOGPH; IF A=0 OR D=0 GO EDEV
120510          IF A.TYPRING NBIT 5TERM AND A NBIT 5BAD GO EDEV
120516          IF X.RTRES><0 GO EOCCU
120520          X=:MLITERM
120521          IF UNAFLAG><0 AND RTRES><"STSIN" GO ESUNA
120527          MLISTRNG SH 1=:MLICPNT
120532          "S1"; CALL GSX; CALL CMOVSTR; GO ESTRNG
120536          "S2"; CALL GSX; CALL CMOVSTR; GO ESTRNG
120542          "S3"; CALL GSX; CALL CMOVSTR; GO ESTRNG
120546          "S4"; CALL GSX; CALL CMOVSTR; GO ESTRNG
120552          "S5"; CALL GSX; X:=MLIPASET+B; T:=12=:D; D BONE 16
120561          *BSET ONE; MOVB; JMP *; BSET ZRO
120565          MLICPNT=:MLIMXADDR; MLISTRNG SH 1=:MLICPNT
120572          *IOF
120573          IF MLITERM.RTRES><0 GO XEOCCU
120576          T:="FLAGB"; CALL XGTDFADDR; A BONE 5MLGIN; T:="FLAGB"; CALL XSTDFADDR
120603   *"8MOLI -8BACS
"120603          T:="DBPROG"; CALL XGTDFADDR; IF A=0 GO XPEND
120606          X:=A
120607   *"8MOLI 8BACS
"120607          CALL RTENTRY
120610          RTREF.STATUS BONE 5WAIT=:X.STATUS
120614          TTMR=:TMR; "RWAIT"; *IRW MLEVB DP
120620          MLEV; *MST PID
120622   RETU:  *ION
120623          X:=MLIADDR; MLIMSTATUS; *BSET ONE
120626          A=:X.S0; *IOF; BSET ZRO
120631          X:=RTREF; CALL BRELEASE; GO RET
120634   *)FILL
120657   
120657   ESUNA: A:=-1; GO EFEL
120661   XEOCC:
120661   EOCCU: A:=-1; GO EFEL
120663   EDEV:  A:=-1; GO EFEL
120665   XPEND:
120665          A:=-1; GO EFEL
120667   ESTRN: A:=-1; GO EFEL
120671   ENOFREE: A:=-1
120672   EFEL:  A=:MLIMSTATUS; GO RETU
