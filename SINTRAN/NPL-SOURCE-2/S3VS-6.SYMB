121217          2000; *TRR IIE; TRA IIC  %ENABLE POWER FAIL
121222          *SEX
121223          IF HWINFO(0)/\377=2 THEN
121231             *143500                                % ND-100 CX.
121232          FI
121232   
121232   % IF DISK DMA WAS ACTIVE AT POWER FAIL TIME, FORCE NEW CALL
121232   
121232          X:="QMSDF"; X=:B
121234   QL0:   X:=S0; IF X=-1 GO SETPTABL; IF X=0 GO QL1
121241          100=:X.DIFTCOUNT                % WAIT 100B*3 SECS. BEFORE TIMOUT ON DISC
121243          0=:X.BUSFL            % FORCE NEW CALL
121244          A:=X.TACNS=:X.TACOU; TAD:=X.RCTRG=:X.RTRG; A:=X.CXRG=:X.XRG
121252   QL1:   B+1; GO QL0
121254   *)FILL
121271   
121271   %   COMMON FOR INITIAL START AND RESTART:
121271   
121271   SETPTABL: 0=:PWRFREST; 177000=:B; A:=162000; D:=0
121276   % MAP RESIDENT INTO PIT 0 AND PIT 3
121276   % AND CLEAR THE REST OF THE PAGE INDEX TABLES
121276          X:=177600
121277          DO AD=:DOU0=:X.DOU0; D+1; B+2; X+2; WHILE D<=LRESP OD
121310          DO WHILE B><177600
121313             0=:S0=:S1; B+2; *TRA IIC
121317             IF A=12 GO PWAIT
121322          OD; DO WHILE X><0; 0=:X.S0=:X.S1; X+2; OD
121330   %  *"CXCPU
121330   % MAP XMSG AND TERMINAL DRIVER INTO PIT 3
121330          A:="9SMRE" SHZ -12=:D
121333          A:="9EPT3" SHZ -12=:L; IF "9EPT3"/\1777><0 THEN L+1 FI
121342          X:=177600+D+D; A:=162000
121346          DO AD=:X.DOU0; WHILE D><L; X+2; D+1; OD
