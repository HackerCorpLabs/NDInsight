130604   
130604   %====================
130604   % 40.27      X 2 1 2
130604   
130604   %************************************************************
130604   %
130604   %      DTE CALL REQUEST ROUTINES  (STATE 2,3,4,5)
130604   %
130604   %************************************************************
130604   
130604   SUBR X212
130604   %
130604   %      DTE CALL REQUEST                         ** STATE 2 **
130604   %      T = 0  C = ON
130604   
130604   %
130604   X212:  A:=L=:X2DSR; 2=:X2DST; CALL STORE
130611          X21T1=:TMR; 307=:X2D11                    % C = ON
130615          140; T:=X2DHD+XWTTC; *EXR ST              % T = 0  
130621   
130621   %      PROCEED TO SELECT ( WAIT FOR "+" )
130621   
130621          3=:X2DST
130623          DO 
130623             CALL X2GET; *JMP *-1                   % WAIT FOR DATA
130625          WHILE X2D00><"X21PL"  OD                  % WAIT FOR "+"
130632          0=:TMR                                    % RECEIVED "+"
130633    
130633    
130633   %      SEND SELECTOR SIGNALS                    ** STATE 4 **
130633   %      T = IA5  C = ON
130633   
130633          300; T:=X2DHD+XWRTC; *EXR ST              % MUST SEE DCE CLEAR REQUEST
130637          X21TB=:TMR; 4=:X2DST; CALL STORE
130644          IF X2DMP.X2MFA NBIT X21C3 THEN            % SKIP ALL THIS IF DIRECT CALL
130650          CALL X2SSS                                % SEND "SYN,SYN"
130651          IF X2DMP.X2MFA /\ 7 >< 0 THEN             % ANY PREFIX ?
130655             IF A BIT X21C1 THEN                    % CHARGING REQUEST ?
130657                ##6; CALL X2SND                     % YES, PREFIX = "61"
130661                ##1; CALL X2SND
130663             FI
130663             IF X2DMP.X2MFA BIT X21C2 THEN          % CALLED LINE ID ?
130667                IF A BIT X21C1 THEN
130671                   ##,; CALL X2SND
130673                FI
130673                ##6; CALL X2SND                     % YES, SEND ",62"
130675                ##2; CALL X2SND
130677             FI
130677   %         IF X2DMP.X2MFA BIT X21C4 THEN          % THE USER MAY DO THIS 
130677   %            IF A /\ 3 >< 0 THEN                 % EXPLISIT BY PREFIXING
130677   %               ##,; CALL X2SND                  % WITH "."
130677   %            FI
130677   %            ##.; CALL X2SND
130677   %         FI
130677             ##-; CALL X2SND                        % TERMINATION OF PREFIX
130701          FI
130701          0=:X2DPC
130702             DO                                     % NO, SEND SELECTION SIGNALS
130702                X:=X2DPC; T:=X2DMP+X2M3; *LBYT 
130706                CALL X2SND
130707                MIN X2DPC
130710             WHILE X2D05><"X21PP" OD                % LAST CHAR IS "+"
130715   %      FI
130715          FI
130715          0=:TMR
130716          X:=X2DMP    
130717          300=:A; T:=X2DHD+XWRTC; *EXR ST             % GET RID OF OVERRUN SITUATION
130724          T:=X2DHD+XRRDR; *EXR ST
130727          A=:X2D00
130730          T:=X2DHD+XRRTS; *EXR ST
130733          A:=X2D10; T:=X2DHD+XRRSR; *EXR ST
130737          A=:X2D02; CALL STORE
130741    
130741    
130741   %      DTE WAITING                              ** STATE 5 **
130741   %      T = 1  C = ON 
130741   
130741          5=:X2DST; 0=:A; T:=X2DHD+XWTTC; *EXR ST   % T = 1
130747          X21T2=:TMR; A:=X2DSR=:P                   % EXIT
130753   RBUS
