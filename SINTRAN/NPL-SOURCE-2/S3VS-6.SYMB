120445   % 37.17      S R E M O V E
120445   %
120445   % SUBROUTINE TO REMOVE A SEGMENT FROM SEGMENT LINK
120445   % X=SEGMENT POINTER
120445   
120445   SUBR SREMOVE
120445   SREMOVE: T:="BSEGLINK"; X=:D:=BSEGLINK
120450          DO WHILE X><D; IF X<0 GO OUT; X=:T:=X.SEGLINK OD
120456          X.SEGLINK; 0=:X.SEGLINK; A=:T.SEGLINK
120462   OUT:   D=:X; EXIT
120464   RBUS
