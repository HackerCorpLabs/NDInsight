"070117   
070117   *"8VDD+8VDP
"070117   %==============================================================================
070117   %
070117   % 34.40 ***************** VIRTUAL DISK DRIVER ROUTINES ************************
070117   *"8VDD+8VDP
"070117   @LIB OLDPIOC
070117   @DEV 1
070117   @DEV (S-S-J)XMSG-SYSTABS
070117   
070117   %============================================================================
070117   %      X M S G - S Y S T A B S
070117   %============================================================================
070117   
070117   
070117   %============================================================================
070117   % 34.40      X M S G - S Y S T A B S
070117   %
070117   %
070117   % DEFINITIONS FOR TABLES COMMON TO BOTH RESIDENT AND POF CODE
070117   %
070117   %****************************************************************************
070117   
070117   % DEFINE THE INTERRUPT LEVEL THAT XMSG WILL USE
070117   SYMBOL 5XLEV=5               % INTERRUPT LEVEL FOR RUNNING DRIVER MONITOR
070117   SYMBOL XLEVL=5XLEV,XLEVB=10*5XLEV      % DEDUCTIONS FROM THE ABOVE
070117   *XLEV=1@5XLEV                          % BIT MASK FOR MST(CL) PID(E)
070117   
070117   % DESCRIPTION OF AN XT-BLOCK:
070117   
070117   DISP 5TLEN=0                 % TASK DESCRIPTOR BLOCK (EXTENSION OF RT-DESCR)
070117          INTEGER XTCHN         % CHAIN FOR FREE/WAITING FOR RESOURCES
070117          INTEGER XTSTA         % STATUS WORD
070117          INTEGER XTRTA         % RT-ADDRESS OR 0 IF DRIVER
070117          INTEGER XTPRT         % PORT CHAIN HEADER (POINTS TO FIRST IN QUEUE)
070117          INTEGER XTMEM         % NUMBER OF BYTES OF MEMORY IN USE
070117          INTEGER XTMMX         % MAX AMOUNT OF MEMORY ALLOWED
070117          INTEGER XTCMS         % TASK CURRENT MESSAGE
070117          INTEGER XTSTS         % BIT 17: PAGING STATUS. 0-4: INTERRUPT LEVEL
070117          INTEGER XTPRG,XTXRG,XTTRG,XTARG,XTDRG,XTLRG,XTSRG,XTBRG % SAVE AREA
070117          DOUBLE XTMRG=XTARG              % AD REGS
070117          TRIPLE XTFRG=XTTRG              % TAD REGS
070117          INTEGER XTAPR         % SAVED ACTPRI WHILE ON LEVEL 1 IN XMSG (YSTL1)
070117          INTEGER XTTAP         % ACTPRI TO USE TO SET UP WINDOWS FOR TRANSFER
070117          INTEGER XTUBF         % USER BUFFER ADDRESS
070117          INTEGER XTSBK, XTSBF  % SYSTEM BUFFER BANK/ADDR. BIT 15=>USER->SYS
070117          DOUBLE XTSAD=XTSBK    % COLLECTIVE NAME
070117          INTEGER XTCNT         % TRANSFER COUNT IN BYTES
070117          INTEGER XTTCN         % DYNAMIC COUNTER USED BY XTRAN
070117          INTEGER POINTER XTHOM % RETURN ADDRESS FROM XTRAN. ALSO USED BY XDHAN! 
070117          % SAVE AREA FOR SEGMENT INFORMATION DURING INDIRECT TRANSFER
070117          INTEGER XTASG         % ACTUAL SEGMENTS 1 AND 2
070117          INTEGER XTRSG         % RE-ENTRANT SEGMENT
070117          INTEGER XTBM0,XTBM1   % BIT MAP
070117          INTEGER XTBM2,XTBM3
070117          TRIPLE XTBMA=XTRSG; DOUBLE XTBMB=XTBM2
070117   PSID
070117   % BITS IN XTSTA ARE NOW DEFINED IN XMSG-POFTABS
070117   %*************************************************************************
070117   %      END OF XMSG-SYSTABS:SYMB
070117   %*************************************************************************
070117   
070117   @DEV 1
070117   @DEV (S-S-J)CDR3
070117   
070117   %==============================================================================
070117   %      C D R 3
