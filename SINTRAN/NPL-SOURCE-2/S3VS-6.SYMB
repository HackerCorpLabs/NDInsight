064422   
064422   %============================================================================
064422   %      C D R 1
064422   %============================================================================
064422   
064422   
064422   *"MODIN
"064422   %==============================================================================
064422   % 33.1       M O S T I   M O T R I   M O S T O   M O T R O
064422   %            M O T M O   M O T M I
064422   %
064422   
064422   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
064422   %    SYNCRONOUS MODEM DRIVER                 %
064422   %    AND HANDLING ROUTINES FOR SINTRAN III   %
064422   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
064422   
064422   SUBR MOSTI,MOTRI,MOSTO,MOTRO,MOTMO,MOTMI,TDBPUT,TDBGET
064422   DISP -12
064422   INTEGER MOWSTAT
064422   INTEGER TERSW,MOSW
064422   PSID
064422   % SET STATUS FOR MODEM INPUT
064422   % A=-3: READ MOSW, AND RETURN IT TO THE USER
064422   % A=-2: INITIATE BLOCK RECEIVE (SEARCH FOR SYNC)
064422   % A=-1: CLEAR INPUT BUFFER
064422   % A= 0: UNDEFINED TERMINATE CONDITION
064422   % A= 1: SET DCT-2000 TERMINATE CONDITION
064422   % A= 2: SET CD-200USER TERMINATE CONDITION
064422   % A= 3: SET GERTS-115 TERMINATE CONDITION
064422   % A= 4: SET IBM-3780/2780 TERMINATE CONDITION
064422   % A= 5: SET VIP TERMINATE CONDITION
064422   % A= 6: SET HASP WS TERMINATE CONDITION
064422   % A= 7: SET UNIVAC NTR TERMINATE CONDITION
064422   % A=10: SET MSV2 TERMINATE CONDITION
064422   % A=11: SET IBM-3270 TERMINATE CONDITION
064422   % A=12: SET BTH/VIP7700 TERMINATE CONDITION
064422   % A=13: SET STANSAAB TERMINATE CONDITION
064422   % A=14: SET UTS-400  TERMINATE CONDITION
064422   %
064422   %
064422   %      SET STATUS FOR MODEM INPUT
064422   %
064422   MOSTI: IF A<0 GO MOSI5
064423          IF A>14 GO MOSI6
064426          A=:TERSW; EXIT                  % SET TERMINATE CONDITION
064430   MOSI5: IF A+4<0 GO MOSI6
064432          GOSW MOSI4, MOSI3, MOSI2, MOSI1
064437   MOSI4: EXIT
064440   %
064440   %      CHECK IF A COMPLETE BLOCK IS RECEIVED
064440   %
064440   MOSI3: A:=0
064441          IF T:=MOSW-4=0 THEN 5=:MOSW; A:=1 FI
064450          EXIT
064451   %
064451   %      INITIATE BLOCK RECEIVE (SEARCH FOR SYNC), CLEAR INPUT BUFFER
064451   %
064451   MOSI2: T:=HDEV; *EXR ST; EXR ST        % DUMMY READ
064454          2204; T:=HDEV+DCONT; *EXR ST
064460          2205; GO MOSI7
064462   %
064462   %      RECEIVER RESET, CLEAR BUFFER
064462   %
064462   MOSI1: 2204
064463   MOSI7: T:=HDEV+DCONT;*EXR ST
064466          0=:MOSW
064467          A:=0 BONE 14; *MCL PID          % DISABLE DRIVER ON LEVEL 12
064472          GO CLBUF
064473   MOSI6: EXIT
064474   %
064474   %      TIMER ROUTINE FOR MODEM INPUT
064474   %
064474   MOTMI: 4=:MOSW
064476          2204; T:=HDEV+DCONT; *EXR ST
064502          GO RTACT
064503   %
064503   %      IOTRANS ROUTINE FOR MODEM INPUT
064503   % 
064503   MOTRI: L+1
064504          IF BHOLD>0 THEN T:=MBSYMOD; GO TDBGET FI
064511          A:=-1; EXIT
064513   *)FILL
064521   %
064521   %      SET STATUS FOR MODEM OUTPUT :
064521   %
064521   % A=-1: CLEAR MODEM OUTPUT BUFFER
064521   % A= 0: START SENDING OF CURRENT BLOCK
064521   % A= 1: SET 377 - BYTES TO SEND BETWEEN DATA
064521   % A= 2: SET ASCII SYNC TO SEND
064521   % A= 3: SET EBCDIC SYNC TO SEND
064521   % A= 4: SYNCRONIZE ON 26 RECEIVED (ASCII)
064521   % A= 5: SYNCRONIZE ON 62 RECEIVED (EBCDIC)
064521   % A= 6: SYNCRONIZE ON 226 RECEIVED (ASCII)
064521   % A= 7: SET ASCII SYNC (226 TO SEND BETWEEN DATA)
064521   %
064521   MOSTO: IF A+1<0 OR >10 THEN EXIT FI
064527          GOSW MOSCL,MOS0,MOS1,MOS2,MOS3,MOS4,MOS5,MOS6,MOS7
064541   MOS1:  777;  GO MOS11
064543   MOS2:  426;  GO MOS11
064545   MOS3:  462;  GO MOS11
064547   MOS4:  1026; GO MOS11
064551   MOS5:  1062; GO MOS11
064553   MOS6:  1226; GO MOS11
064555   MOS7:  626;
064556   MOS11: T:=HDEV-3;*EXR ST;EXIT          % UPDATE HARDWARE SYNCREGISTERS
064562   
064562   MOSCL: 0=:MOWSTAT=:TMR=:DERROR
064565          GO CLBUF
064566   
064566   MOS0:  5; T:=HDEV+DCONT; *EXR ST
064572          TTMR=:TMR; 2=:MOWSTAT; EXIT     % SET WAIT CONDITION
064577   %
064577   %      IOTRANS ROUTINE FOR MODEM OUTPUT
064577   %
064577   MOTRO: IF T:=MOWSTAT-2=0 THEN EXIT FI  % CALLING PROGR WILL WAIT
064604          L+1; T:=MBSYMOD; GO TDBPUT
064607   %
064607   %      TIME-OUT SUBROUTINE FOR MODEM OUTPUT
064607   %
064607   MOTMO: 12=:DERROR
064611          "0"; T:=HDEV+DCONT; *EXR ST
064615          IF ISTATE>0 GO RTACT
064620          0=:MOWSTAT
064621          EXIT
064622   RBUS
064635   *"8HMO1+8HMO2+8HMO3+8HMO4+8HMO5+8HMO6
"064635   
064635   %==============================================================================
064635   % 33.11      H O S T I   H O T R I   H O S T O   H O T R O
064635   %            H O T M O   H O T M I
064635   %
064635    
064635   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
064635   % SYNCRONOUS MODEM DRIVER FOR HDLC INTERFACE
064635   % AND HANDLING ROUTINES FOR SINTRAN III
064635   %
064635   % IMPLEMENTED IN SINTRAN 81F (15/5/81  H-AA)
064635   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
064635   
064635   %
064635   %
064635   %I O X DEFINITIONS FOR HDLC USED AS SYNCRONOUS MODEM
064635   
064635   @ICR;
064635   SYMBOL BRRDR=0,                                 % READ REC.DATA REG.
064635   BWPCR,                                          % WRITE PARAM. CONTR. REG.
064635   BRRSR,                                          % READ REC STATUS
064635   BWSAR,                                          % WRITE SYNC/ADDRESS REG.
064635   BWCHL,                                          % WRITE CHAR. LENGTH
064635   BWTDR,                                          % WRITE TRANSM. DATA REG.
064635   BRTSR,                                          % READ TRANSM. STATUS REG.
064635   BWTCR,                                          % WRITE TRANSM. CONTROLE REG.
064635   BRRTS,                                          % READ REC. TRANSFER STATUS
064635   BWRTC,                                          % WRITE REC. TRANSFER CONTROLE
064635   BRTTS,                                          % READ TRANSM. TRANSFER STATUS
064635   BWTTC;                                          % WRITE TRANSM. TRANSFER CONTRO
064635   @CR;
064635   
064635   SUBR HOSTI,HOTRI,HOSTO,HOTRO,HOTMO,HOTMI
064635   DISP -14
064635          INTEGER HTFIL                   % OUTPUT UNDERRUN FILL CHAR
064635          INTEGER HOWSTAT
064635          INTEGER HERSW
064635          INTEGER HDXOK                   % CLEARED BY X21
064635          INTEGER MOSW
064635   PSID
064635   % SET STATUS FOR MODEM INPUT
064635   % A=-3: READ MOSW, AND RETURN IT TO THE USER
064635   % A=-2: INITIATE BLOCK RECEIVE (SEARCH FOR SYNC)
064635   % A=-1: CLEAR INPUT BUFFER
064635   % A= 0: UNDEFINED TERMINATE CONDITION
064635   % A= 1: SET DCT-2000 TERMINATE CONDITION
064635   % A= 2: SET CD-200USER TERMINATE CONDITION
064635   % A= 3: SET GERTS-115 TERMINATE CONDITION
064635   % A= 4: SET IBM-3780/2780 TERMINATE CONDITION
064635   % A= 5: SET VIP TERMINATE CONDITION
064635   % A= 6: SET HASP WS TERMINATE CONDITION
064635   % A= 7: SET UNIVAC NTR TERMINATE CONDITION
064635   % A=10: SET MSV2 TERMINATE CONDITION
064635   % A=11: SET IBM-3270 TERMINATE CONDITION
064635   % A=12: SET BTH/VIP7700 TERMINATE CONDITION
064635   % A=13: SET STANSAAB TERMINATE CONDITION
064635   % A=14: SET UTS-400  TERMINATE CONDITION
064635   %
064635   %
064635   % SET STATUS FOR MODEM INPUT
064635   HOSTI: A=:D
064636          IF HDXOK><X21OP THEN 12=:DERROR; EXIT FI
064645          D=:A
064646          IF A<0 GO MOSI5
064647          IF A>14 GO MOSI6
064652          A=:HERSW; EXIT        % SET TERMINATE CONDITION
064654   MOSI5: IF A+4<0 GO MOSI6
064656          GOSW MOSI4, MOSI3, MOSI2, MOSI1
064663   MOSI4: EXIT
064664   MOSI3: "0"; IF T:=MOSW-4=0 THEN 5=:MOSW;1 FI;EXIT
064675   MOSI2: T:=HDEV+BRRDR;*EXR ST;EXR ST    % DUMMY READ
064701          100; T+"BWRTC-BRRDR"; *EXR ST   % STOP RECEIVER
064704          105; *EXR ST                    % START AND SEARCH FOR SYN
064706          1=:HOWSTAT
064710          0=:MOSW; GO FAR CLBUF
064712   MOSI1: A:=100; T:=HDEV+BWRTC; *EXR ST
064716          A:=0; T+"BWCHL-BWRTC"; *EXR ST  % 8 BITS BYTE
064721          0=:MOSW
064722          GO FAR CLBUF
064723   MOSI6: EXIT
064724   %
064724   % TIMER ROUTINE FOR MODEM INPUT
064724   HOTMI: 4=:MOSW
064726          100; T:=HDEV+BWRTC; *EXR ST
064732          GO FAR RTACT
064733   % IOTRANS ROUTINE FOR MODEM INPUT
064733   HOTRI: L+1
064734          IF BHOLD>0 THEN T:=MBSYMOD; GO TDBGET FI
064741          A:=-1;EXIT;*)FILL
064747   %
064747   %
064747   % SET STATUS FOR MODEM OUTPUT
064747   % A=-1: CLEAR MODEM OUTPUT BUFFER
064747   % A= 0: START SENDING OF CURRENT BLOCK
064747   % A= 1: SET 377 - BYTES TO SEND BETWEEN DATA
064747   % A= 2: SET ASCII SYNC TO SEND
064747   % A= 3: SET EBCDIC SYNC TO SEND
064747   % A= 4: SYNCRONIZE ON 26 RECEIVED (ASCII)
064747   % A= 5: SYNCRONIZE ON 62 RECEIVED (EBCDIC)
064747   % A= 6: SYNCRONIZE ON 226 RECEIVED (ASCII)
064747   % A= 7: SET ASCII SYNC (226 TO SEND BETWEEN DATA)
064747   %
064747   HOSTO: A=:D
064750          IF T:=HDXOK><X21OP THEN 12=:DERROR; EXIT FI
064757          D=:A
064760          IF A+1<0 OR >10 THEN EXIT FI
064766          GOSW MOSCL,MOS0,MOS1,MOS2,MOS3,MOS4,MOS5,MOS6,MOS7
065000   MOS1:  377=:HTFIL; T:=HDEV+BWTDR; *EXR ST   % DUMMY SYNC CHAR
065005          117; T+"BWPCR-BWTDR"; *EXR ST   % 377 AS UNDERRUN FILL CHAR
065010          EXIT
065011   MOS4:  26=:HTFIL
065013   MOS2:  26; GO MOS11
065015   MOS5:  62=:HTFIL
065017   MOS3:  62; GO MOS11
065021   MOS7:  226=:HTFIL
065023   MOS6:  226
065024   MOS11: T:=HDEV+BWSAR; *EXR ST;         % UPDATE HARDWARE SYNCREGISTER
065027          IF HTFIL=377 THEN 117 ELSE 107 FI
065036          T:=HDEV+BWPCR; *EXR ST
065041          EXIT
065042   MOSCL: 0=:HOWSTAT=:TMR=:DERROR
065045          GO FAR CLBUF
065046   MOS0:  "MODXX"=:"DRIVER"               % ENTRY POINT FIRST INTERRUPT
065050          1; T:=HDEV+BWTCR; *EXR ST       % SEND SYNC CHAR, AND START TRANSMITTER
065054          105; T+"BWTTC-BWTCR"; *EXR ST   % ENABLE OUTPUT
065057          TTMR=:TMR;2=:HOWSTAT;EXIT       % SET WAIT CONDITION
065064   % IOTRANS ROUTINE FOR MODEM OUTPUT
065064   HOTRO: IF T:=HOWSTAT-2=0 THEN EXIT FI   % CALLING PROGR WILL WAIT
065071          L+1; T:=MBSYMOD; GO TDBPUT
065074   %
065074   % TIME-OUT SUBROUTINE FOR MODEM OUTPUT
065074   HOTMO: 12=:DERROR
065076          A:=0; T:=HDEV+BWTTC; *EXR ST
065102          IF ISTATE>0 GO FAR RTACT
065105          0=:HOWSTAT
065106          EXIT
065107   RBUS
