070035  )9RCLC
% 
% *)9SLPL
)9SLPL070035   INTEGER NMAXUSERS; * *-1/MAXUS
070036   INTEGER ARRAY BUFFR(7)
070045   INTEGER CUIDX
070046   * *<* MAXUS
070046   *)ZERO
070046   INTEGER ARRAY DBGPROGS(0); * *+MAXUS/
070052   
070052   SUBR BRPNT,DEBUG,ESCDEBUG,3BRPNT,3DEBUG
070052   
070052   BRPNT: CALL GET0; MLEV; *MST PIE
070055          CALL S3NOALPIT; GO 3BRPNT
070057   DEBUGGER: CALL GET0; MLEV; *MST PIE
070062          CALL S3NOALPIT; GO 3DEBUG
070064   
070064   % CALLED FROM MESCAPE
070064   INTEGER POINTER ELREG
070065   ESCDBUG: X:=L=:"ELREG":=B; T:="DBPROG"; CALL XGTDFADDR
070072            FOR X:=0 TO NMAXUSERS-1 DO
070077               IF T:=DBGPROGS(X)=A THEN 0=:DBGPROGS(X); GO ELREG FI
070104            OD; GO ELREG
070107   RBUS
