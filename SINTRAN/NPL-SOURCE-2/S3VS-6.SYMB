075524   * 172400/
172400   * 999EN=*
172400   *"
"172400   @LIB CXCPU
172400   
172400   SUBR SETPTABL,INTDFIELDS
172400   RBUS
172400   
172400   INTEGER TADFPHPAGE           % FIRST PHYSICAL PAGE IN TAD-STACK
172401   INTEGER TADLPHPAGE           % LAST PHYSICAL PAGE IN TAD-STACK
172402   INTEGER TDLPHPAGE            % LAST PHYSICAL PAGE IN TERMINAL-DATAFIELDS
172403   
172403   %===============================================================================
172403   % 36.16      S I N T R
172403   %
172403   
172403   INTEGER CCSTART=?,PIEREG=?,PIDREG=?,TMRTE=?,CCNOX=?
172403   INTEGER XCHREENTPAGES=?
172403   DOUBLE XCLEP=?,XSETP=?
172403   INTEGER XCLNREENT=?
172403   DOUBLE ARRAY NSWPAGE=?,NINIPAGE=?
172403   INTEGER IRTCPIT=?,77CBU=?
172403   DOUBLE ARRAY XCCTAB=?
172403   INTEGER FPS41=?
172403   
172403   INTEGER FMEMCHECK:=0         % NO MEMORY TEST IN START-UP
172404   
172404   SUBR SINTR
172404   
172404   BASE SBFIELD
172404   INTEGER 9HDEV                % SPECIAL IOX-NUMBER FOR MAIN SWAP-DEVICE
172405   INTEGER XIOBUTAB:=IOBUTAB    % ADDRESS OF I/O-DEVICES BUFFER TABLE
172406   INTEGER ARRAY LSWPDEV:=(502,1104,1100,1224,1231,1207)  % LOG.DEV. NO FOR SWAP-DEVICES
172414   INTEGER ARRAY HSWPDEV:=(500, 510,1540, 500, 510,1550)   % IOX-DEV. NO FOR SWAP-DEVICES
172422   INTEGER XSMRES:=9SMRE        % START OF PAGING-OFF CODE AREA
172423   INTEGER XEMRES:=9EMRE        % END OF PAGING-OFF AREA
172424   INTEGER CBUF:=9EMRE          % ADDRESS OF CURRENT I/O BUFFER
172425   INTEGER LPHYSPAGE            % LAST PAGE IN MEMORY
172426   INTEGER DBFNO:=5BUFA         % NUMBER OF DEVICE-BUFFER-HEADERS.
172427   INTEGER MMSIZE               % SIZE OF MEMORY MAP
172430   INTEGER MMFPAGE:=-1          % FIRST PAGE OF MEMORY MAP
172431   INTEGER MMLPAGE:=-1
172432   INTEGER DBFPAGE:=-1          % FIRST PAGE USED AS DEVICE BUFFER
172433   INTEGER DBLPAGE:=-1          % LAST PAGE USED AS DEVICE BUFFER
172434   INTEGER FLAMPAGE:=0          % FIRST PHYSICAL PAGE FOR LAMU TABLES
172435   INTEGER LLAMPAGE:=0          % LAST PHYSICAL PAGE FOR LAMU TABLES
172436   INTEGER CLAMSIZE             % SIZE OF LAMU DESCRIPTION TABLE
172437   INTEGER NPLAMU:=1            % NUMBER OF PAGES USED BY LAMU TABLES
172440   INTEGER CURRPAGE             % CURRENT PAGE NUMBER TO CHECK
172441   INTEGER CHDLCF=CURRPAGE      % HDLC FLAG
172441   INTEGER CCOUNT
172442   DOUBLE ARRAY POINTER DCCTAB:=CCTAB
172443   INTEGER ARRAY POINTER ACCTAB=DCCTAB
172443   INTEGER ARRAY POINTER PNSWPAGE:=NSWPAGE
172444   INTEGER POINTER ICINDADDR(2)
172446   DOUBLE POINTER CINDADDR=ICINDADDR
172446   INTEGER POINTER FPGNO:=XFPGNO,PHYSPTEST:=XPHYSPTEST,GETAREA:=XGETAREA
172451   INTEGER POINTER INITPAGE:=XINIPAGE,MEMCHECK:=XMEMCHECK,OUTLINK:=XOUTLINK
172454   INTEGER XT,XA,XD,XXX; TRIPLE XTAD=XT
172460   INTEGER POINTER CLINK
172461   INTEGER PREVX,PREVT
172463   DOUBLE ARRAY POINTER PNINITPAGE:=NINITPAGE
172464   DOUBLE ARRAY POINTER PLAMARR:=LAMARR
172465   INTEGER 1CCTAB,2CCTAB
172467   INTEGER CINDX
172470   INTEGER NNRTP,POWFPAG,POWLPAG,POWSIZE
172474   DOUBLE DPOWADDR=POWFPAG
172474   INTEGER LPS41
172475   INTEGER BUSYMOD
172476   INTEGER SYMFPHPAGE,SYMLPHPAGE
172500   
172500   @ICR
172500   INTEGER ARRAY ENTAB:=(EN000,0,EN200,EN300,EN400,EN500,EN600,EN700,
172510                         E1000,E1100,E1200,E1300,E1400,E1500,E1600,E1700,
172520                         E2000,E2100,E2200,E2300,E2400);
172525   @CR;
172525   
172525   ESAB
172525   
172525   DISP 0; INTEGER 5NBLCK,5RETRY; INTEGER POINTER 5TRNSF; PSID
172525   DISP -4; INTEGER M4; PSID
172525   
172525   
172525   % LOCAL SUBROUTINE TO FIND SPACE FOR THE I/O BUFFERS
172525   %
172525   % ENTRY:     A=0 : TRY TO PLACE ALL I/O BUFFERS (EXCEPT LARGE HDLC BUFFERS),
172525   %                : IN POF.
172525   % EXIT:      I/O BUFFERS FOUND
172525   % EXIT+1:    NOT ENOUGH SPACE IN POF
172525   %
172525   % ENTRY:     A><0: SAME AS FOR A=0 EXCEPT THAT BUFFERS FOR SYNC.MODEM WILL
172525   %                  BE PLACED OUTSIDE POF
172525   % EXIT:      I/O BUFFERS OK
172525   %
172525   % EXIT+1:    FATAL ERROR
172525   %
172525   INTEGER CFIOFLG
172526   CFIOBUF: A=:CFIOFLG; 0=:BUSYMOD
172530          X:=XIOBUTAB; A:=CBUF=:D
172533          DO WHILE X.S0><-1
172537             IF A BIT BIHDLC AND X.S1/\77777>>=2000 THEN
172546                A:=0
172547             ELSE
172550                IF A BIT BISYMOD AND T:=CFIOFLG><0 THEN
172555                   X.S1/\77777+BUSYMOD=:BUSYMOD; GO NXT
172562                ELSE
172563                   X.S1/\77777
172565                FI
172565             FI; D+A; IF C THEN EXITA FI              % CROSS 64KW MEMORY BANK
172571   NXT:      X+2
172572          OD; IF D>>177000 THEN EXITA FI              % OVERLAP PAGE INDEX TABELS
172577          EXIT                                        % BUFFER IS FOUND
172600   
172600   % LOCAL SUBROUTINE TO SIMULATE LOGPH FOR ELEMENTS IN IOBUTAB
172600   %
172600   % ENTRY:     A=LOGICAL DEVICE NUMBER
172600   %            CINDADDR MUST POINT TO ELEMENT IN IOBUTAB
172600   %
172600   % EXIT:      X=ADDRESS OF DATAFIELD
172600   %
172600   % CALL TO ERRFATAL WHEN ERROR
172600   
172600   XLOGPH: AD SHZ -6; IF A=1 OR A>24 THEN CALL ERRFATAL FI
172610          A=:X:=D SHZ -12
172613          IF A+A+CNVRT(X)+1=:D-ENTAB(X)>=0 THEN CALL ERRFATAL FI
172622          AD:=D.DOU0; IF T:=ICINDADDR BIT 17 THEN D=:X ELSE A=:X FI
172632          IF X=0 THEN CALL ERRFATAL FI
172635          EXIT
172636   *)FILL
172643   
172643   % INITIALIZE PAGING SYSTEM AND INTERRUPT SYSTEM
172643   
172643   SINTR: A:=0; *PIOF; TRR IIE; TRA IIC
172647          A:=0; *TRR PID; TRR PIE
172652          A:=2; *TRR PCR; SEX; TRA STS
172656          IF A NBIT 5N100 THEN CALL ERRFATAL FI % THIS SYSTEM IS ONLY FOR NORD 100!!!!
172661          A=:CPSTA
172662          A:="LV0"; *IRW 0 DP; ION
172665   LV0:   *IOF
172666          "SBFIELD"=:B
172670   % INITIALIZE THE PAGE TABLES
172670          A:=162000; D:=0; X:=177000
172673          DO AD=:X.DOU0; D+1; X+2 WHILE X><0 OD
172700   % INITIALIZE THE MEMORY AREA FROM END OF RESIDENT UP TO 128 KBYTE
172700          X:=ENDCOR; DO X.S0=:X.S0 WHILE X><177777; X+1; OD
172710          A:=ENDCORE-1; CALL FPGNO
172713          IF A>"9POFS" SHZ -12 -1 THEN CALL ERRFATAL FI  % RESIDENT AND POF OVERLAPS
172721          A=:LRESP                                     % LAST PAGE IN RESIDENT
172722   
172722   % TEST MEMORY ADDRESS BITS 19-23 (1-32MB)
172722   ISINTR: 1000=:CURRPAGE
172724   % IF MULTIPORT 3 THEN 3777=:ENDPAGE ELSE 37777=:ENDPAGE FI
172724          A:=200; *TRR IIE; TRA IIC; IOX 750; TRA IIC
172731          IF A=0 THEN A:=3777 ELSE A:=37777 FI; A=:ENDPAGE; A:=0; *TRR IIC
172740          DO WHILE CURRPAGE><ENDPAGE+1
172745             X:=0
172746             DO WHILE X<<"NINSZ*2"
172751                AD:=PNINITPAGE(X)
172752                IF A><0 AND A<<=CURRPAGE AND D>>=T GO NEXT
172760                X+2
172761             OD; X:=0; 124000=:X.S0
172765             A:=CURRPAGE=:D:=162000; X:=177176; AD=:X.DOU0
172772             A:=1000; *TRR IIE; TRA IIC; PON
172776             X:=176000; X.S0; *POF; TRA IIC
173002             IF A=0 THEN
173003                *PON
173004                A:=X.S0=:D:=-1=:X.S0; *POF
173011                X:=0
173012                IF X.S0=124000 THEN
173016                   A:=D; X:=176000; *PON
173021                   A=:X.S0; *POF; TRA IIC
173024                ELSE
173025                   124000=:X.S0; CURRPAGE-1=:ENDPAGE
173032                   GO LABL1
173033                FI
173033             FI
173033   NEXT:     CURRPAGE SH 1=:CURRPAGE
173036          OD
173037   
173037   % FIND LAST 32K MEMORY MODULE
173037   LABL1: A:=77=:LPHYSPAGE+1
173042   DO1:   DO WHILE A<<=ENDPAGE
173045             CALL PHYSPTEST; GO NOTEXIST; A+37=:LPHYSPAGE; A+1
173052          OD; GO L1
173054   NOTEXIST: A+40; GO DO1
173056   *)FILL
173077   
173077   L1:    7EPOF=:CBUF
173101          A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
173107          A=:NNRTP
173110   *"8XMSG
"173110          -1=:CBUF.S0; CBUF=:XZRTT+NNRTP=:CBUF
173117   *"
"173117          CBUF=:7RTDLGADDR
173121          A:=NNRTP*5XRTDSIZE+CBUF=:CBUF=:77CBU; IF C THEN CALL ERRFATAL FI
173131          GO LABL2; *)FILL
173142   % FIND THE I/O BUFFER AREA
173142   LABL2: A:=0; CALL FAR CFIOBUF; GO IOBOK
173145          A:=1; CALL FAR CFIOBUF; GO IOBOK; CALL ERRFATAL
173151   IOBOK:
173151   % CHECK IF "PAGING OFF" AREA AND I/O BUFFER AREA EXISTS IN MEMORY
173151          A:=D; CALL FPGNO; A=:LPOFP            % LAST PAGE IN "PAGING-OFF" AREA
173154          "9POFS"; CALL FPGNO; A=:FPOFP         % FIRST PAGE IN "PAGING-OFF" AREA
173157          DO
173157             CALL PHYSPTEST; CALL ERRFATAL; A+1
173162          WHILE A><LPOFP
173165          OD; GO LABL3; *)FILL
173174   
173174   % SET UP THE I/O BUFFERS
173174   
173174   LABL3: XIOBUTAB=:"CINDADDR"
173176          DO AD:=CINDADDR WHILE A><-1
173202             0=:CHDLCF
173203             IF A BIT BIHDLC THEN
173205                A=:CHDLCF; IF D>>1777 GO NXIOD
173211             FI; A/\7777; CALL FAR XLOGPH
173213             CBUF=:X.BUFST; AD:=CINDADDR
173216             IF A:=D NBIT 17 THEN A SH 1 ELSE A BZERO 17 FI; A=:X.MAX=:X.CFREE
173226             IF CHDLCF><0 THEN 0=:MASTB FI
173231             A:=D BZERO 17+CBUF=:CBUF
173235   NXIOD:    "CINDADDR"+2=:"CINDADDR"
173240          OD
173241   % SET UP RT-COMMON TABLE
173241          IF CCNOX><0 THEN
173243             IF ACCTAB(0)=0 THEN
173246                IF CCSTART=0 THEN
173250                   LPHYSPAGE; X:=CCNOX; T:=LRESP+1
173254                   CALL YGETAREA; CALL ERRFATAL; A-CCNOX+1=:CCSTART
173261                FI; A=:D
173262                200-CCNOX+161000; T:=CCNOX; X:=0
173267                DO WHILE T><0
173271                   AD=:DCCTAB(X); A+1; D+1; X+2; T-1
173276                OD; -1=:ACCTAB(X)
173301             FI
173301          ELSE
173302             IF ACCTAB(0)=0 THEN -1=:ACCTAB(X) FI
173307          FI; GO L2; *)FILL
173322   % TEST IF RT-COMMON PAGES EXIST AND INITIALIZE THE RT-COMMON PAGES
173322   L2:    X:=0
173323          DO WHILE ACCTAB(X)><-1
173327             X+1; ACCTAB(X); CALL PHYSPTEST; CALL ERRFATAL
173333             CALL INITPAGE; X+1
173335          OD
173336          GO FILL1; *)FILL
173340   FILL1:
173340   
173340   % FIND CONTINUOUS AREA FOR THE DEVICE-BUFFERS IN MEMORY BANK 1 TO 3,
173340   % AND INITIALIZE THE PAGES
173340   %
173340          A:=100; X:=DBFNO; T:=377; CALL GETAREA; CALL ERRFATAL     % LAST PAGE = 377
173345          A=:DBFPAGE/\77 SH 12=:BUFASTART           % START ADDRESS OF BUFFER AREA WITHIN BUFBANK
173351          A:=DBFPAGE SHZ -6=:BUFBANK                % MEMORY BANK IN WHICH THE BUFFERS LIE
173354          DBFPAGE+DBFNO-1=:DBLPAGE
173360          FOR A:=DBFPAGE TO DBLPAGE DO CALL INITPAGE; CALL MEMCHECK; CALL ERRFATAL OD
173371   
173371   % RESERVE MEMORY FOR THE LAMU SYSTEM AND CLEAR THE LAMU TABLES
173371   
173371          IF GNLAMU><0 THEN
173373             A*LDTSZ=:CLAMSIZE
173375             A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
173403             A*GNLPRT*ALMSZ+CLAMSIZE; CALL FPGNO; A+D=:NPLAMU
173411             A:=100; T:=LPHYSPAGE; X:=NPLAMU; CALL GETAREA; CALL ERRFATAL 
173416             A=:D=:FLAMPAGE+NPLAMU-1=:LLAMPAGE:=0; AD SH 12=:DLAMDT
173426             A:=D+CLAMSIZE=:LAMACT
173431             A:=FLAMPAGE; T:=NPLAMU+A
173434             DO WHILE A><T; CALL ZEROPAGE; A+1; OD
173441             X:=0
173442             DO WHILE X<<"NINSZ*2"; AD:=PNINITPAGE(X)=:PLAMARR(X); X+2; OD
173451             GO AFLAM; *)FILL
173470          FI
173470   
173470   AFLAM:
173470   
173470   % RESERVE MEMORY FOR THE MONITOR-CALL-LOG TABLE
173470          IF "MCLGPAGE"><0 THEN
173472             A:=0; T:=LPHYSPAGE; X:=1; CALL GETAREA; CALL ERRFATAL
173477             A=:MCLGPAGE=:D:=0; AD SHZ 12; A=:MCLGBANK:=D=:TNMCALL
173506          FI
173506   
173506   % RESERVE MEMORY FOR THE SYNC.MODEM BUFFERS IF THEY ARE PLACED
173506   % OUTSIDE MEMORY BANK #0
173506   
173506          IF BUSYMOD><0 THEN
173510             CALL FPGNO; A+D=:X=:SYMLPHPAGE
173514             A:=0; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
173520             A=:SYMFPHPAGE-1+SYMLPHPAGE=:SYMLPHPAGE
173524             A:=SYMFPHPAGE=:D:=0; AD SHZ 12; A=:MBSYMOD:=D=:CBUF
173533             XIOBUTAB=:"CINDADDR"
173535   % INITIALIZE THE SYNC.MODEM DATAFIELDS WITH
173535   % BUFFER START ADDR, MAX AND CFREE
173535             DO AD:=CINDADDR WHILE A><-1
173541                IF A BIT BISYMOD THEN
173543                   A/\7777; CALL FAR XLOGPH
173545                   CBUF=:X.BUFST
173547                   AD:=CINDADDR
173550                   IF A:=D NBIT 17 THEN A SH 1 ELSE A BZERO 17 FI
173556                   A=:X.MAX=:X.CFREE
173560                   A:=D BZERO 17+CBUF=:CBUF
173564                FI; "CINDADDR"+2=:"CINDADDR"
173567             OD
173570          ELSE
173571             0=:MBSYMOD
173572          FI; GO BYPFILL; *)FILL
173602   BYPFILL:
173602   @LIB CXCPU
173602   
173602   % RESERVE MEMORY FOR THE TAD-STACK
173602          T:=0; X:="D1400"+1
173605          DO                                        % SEARCH IN LOG.DEV TABLES
173605             IF "D1500"=X THEN X+1 FI
173611          WHILE "9EBAD">>X
173614             AD:=X.DS0
173615             IF A><0 OR D><0 THEN T+1 FI
173621             X+2
173622          OD
173623          IF T><0 THEN                              % RESERVE PAGES
173625             A:=T*TSSIZE; CALL FPGNO; A+D=:MMSIZE   % MMSIZE=NO.OF PAGES IN TAD-STACK
173632             X:=A; A:=0; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
173637             A=:TADFPHPAGE-1+MMSIZE=:TADLPHPHAGE    % FIRST AND LAST PHYSICAL PAGE FOR TAD-STACK
173643             A:=TADFPHPAGE SHZ -6=:TSBANK           % MEMORY BANK FOR TAD-STACK
173646             A:=TADFPHPAGE SH 12=:CCOUNT            % CCOUNT=ADDR OF STACK WITHIN A 64KW MEMORY BANK
173651             X:="D1400"+1=:L
173654             DO                                     % INITIALIZE THE TAD DATAFIELDS
173654                IF L="D1500" THEN L+1 FI            % WITH THE ADDR OF THE TAD-STACK AREA
173660             WHILE L<<"9EBAD"
173663                AD:=L.DS0
173665                IF A><0 OR D><0 THEN
173670                   T:=CCOUNT
173671                   IF A><0 THEN T=:A.TSTADD FI
173674                   IF D><0 THEN T=:D.TSTADD FI
173700                   CCOUNT+TSSIZE=:CCOUNT
173703                FI; L+1; L+1
173705             OD;
173706          FI; GO OVFILL; *)FILL
173717   
173717   OVFILL:
173717   % COMPUTE SIZE OF THE PAGE-OWNER TABLE FOR MON SPLREE
173717          "NNBRT"*POTESIZE+1777 SHZ -12=:X=:POWSIZE; A:=0; T:=LPHYSPAGE
173727          CALL GETAREA; CALL ERRFATAL
173731          A=:D=:POWFPAGE+POWSIZE-1=:POWLPAGE:=0; AD SH 12=:DSREBADDR
173741   
173741   % COMPUTE SIZE OF MEMORY MAP, FIND CONTINUOUS MEMORY FOR THE MEMORY MAP
173741   % AND SET UP MEMORY MAP FOR ALL PAGES (0 - LPHYSPAGE)
173741   % THE PHYSICAL PAGE NUMBER IS INDEX IN THE MEMORY MAP
173741          IF LPHYSPAGE=37777 THEN A-1=:LPHYSPAGE FI
173747          A+2 SH 2; CALL FPGNO; A+D=:MMSIZE
173754          100; X:=MMSIZE; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
173761          A=:D=:MMFPAGE SHZ -6=:CORMBANK:=D+MMSIZE-1=:MMLPAGE
173771          IF A:=D/\77=0 THEN A SH 12+4 ELSE A SH 12 FI
174000          A=:CORMSTART=:"XSGRT".BPAGLINK=:D:=CORMBANK; AD=:DCORMSTART
174006          LPHYSPAGE=:ENDPAGE
174010          GO L3; *)FILL
174024   L3:    0=:CURRPAGE; X:=CORMSTART
174026          FOR CURRPAGE DO WHILE CURRPAGE<<=LPHYSPAGE
174032             T:=CORMBANK; A:=X+4; D:=0; *STDTX DPAGL
174037             CURRPAGE=:D; A:=1; *STDTX DPGPR
174043             X+4
174044          OD; X-4=:ECORMAP; T:=CORMBANK; *STZTX
174052   
174052   % RESERVE MEORY FOR PIT3 SEGMENT
174052          "XLPT3"+1-"XSPT3" SHZ -12=:MMSIZE
174057          "SG41".LOGADR/\377; T:=MMSIZE SH 10; A\/T=:X.LOGADR
174066          X:=MMSIZE; A:=100; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
174073          A=:D=:FPS41+MMSIZE-1=:LPS41
174100          IF "SG33".LOGADR/\77 SH 12><0 AND A<<="XLPT3" THEN
174110             CALL ERRFATAL                          % PIT3 SEG AND X-MESSAGE OVERLAPS
174111          FI
174111   @LIB CXCPU-,
174111          A:="5BFPAGE-1"=:D:=0; CALL OUTLINK
174115          A:=LRESP=:D:="5BFPAGE+1"; CALL OUTLINK    % LINK OUT RESIDENT
174121   @ELIB
174121   @LIB CXCPU
174121          A:=LPOFP=:D:=FPOFP; CALL IOUTLINK         % LINK OUT POF AREA
174125          A:=MMLPAGE=:D:=MMFPAGE; CALL IOUTLINK     % LINK OUT MEMORY MAP AREA
174131          A:=DBLPAGE=:D:=DBFPAGE; CALL IOUTLINK     % LINK OUT DEVICE BUFFER AREA
174135          A:=POWLPAGE=:D:=POWFPAGE; CALL IOUTLINK   % LINK OUT PAGE-OWNER TABLE
174141          IF "MCLGBANK"><0 THEN
174143             A:=MCLGPAGE=:D; CALL IOUTLINK          % LINK OUT MONITOR-CALL-LOG-TABLE PAGE
174146          FI
174146          IF TADLPHPAGE><0 THEN
174150             A=:D:=TADFPHPAGE; CALL IOUTLINK        % LINK OUT TAD-STACK PAGES
174153          FI
174153          IF SYMLPHPAGE><0 THEN
174155             A=:D:=SYMFPHPAGE; CALL IOUTLINK        % LINK OUT SYNC.MODEM I/O BUFFERS
174160          FI
174160   @LIB CXCPU
174160          A:=LPS41=:D:=FPS41; CALL OUTLINK          % LINK OUT PAGES RESERVED FOR PIT3 SEGMENT
174164          IF GNLAMU><0 THEN
174166             A:=FLAMPAGE+NPLAMU-1=:D:=FLAMPAGE         
174173             CALL OUTLINK                           % LINK OUT LAMU TABLE PAGES
174174          FI; A:=DBFPAGE SH 2+CORMSTART=:BUFMAPSTA
174200          GO L31; *)FILL
174230   
174230   % LINK OUT RT-COMMON
174230   L31:   IF ACCTAB(0)><-1 THEN
174235             A/\377=:ARTFPAGE SH 1; T:="XCCTAB"-A=:IRTCPIT
174243             177=:ARTLPAGE
174245             DO WHILE ACCTAB(X)><-1
174251                X=:CINDX; A=:1CCTAB
174253                X+1; ACCTAB(X)=:D=:2CCTAB; CALL IOUTLINK
174260                A:=2CCTAB=:D:=161000; AD=:XCCTAB(CINDX); X+2
174266             OD
174267          ELSE
174270             -1=:ARTFPAGE=:ARTLPAGE
174273          FI; IF LPOFP><77 THEN A:=77=:D; CALL OUTLINK FI     % LINK OUT PAGE #77
174302   % LINK OUT NOT-SWAP PAGES AND INITIALIZE THE PAGES
174302          X:=0
174303          DO WHILE X<<"NNSWSZ*2"
174306             AD:=NSWPAGE(X)
174307             IF A><0 AND A<<=D THEN
174312                CALL OUTLINK
174313                DO WHILE A<<=D; CALL INITPAGE; A+1; OD
174320             FI; X+2
174321          OD
174322   % FIND NUMBER OF SWAPPING PAGES AND INITIALIZE THE SWAPPING PAGES
174322          0=:CURRPAGES; X:="XSGRT"+1=:PREVX; T:=0=:PREVT
174330   INDO2: DO
174330             *LDXTX DPAGL
174331          WHILE X><0
174332             T:=CORMBANK; *LDATX DPAGP
174334             CALL PHYSPTEST; GO COUTLINK; CALL INITPAGE
174337             CALL MEMCHECK; GO ERRPAGE; MIN CURRPAGE
174342             T=:PREVT; X=:PREVX
174344          OD; CURRPAGE=:NOPGS; GO L4
174350   ERRPAGE: CALL 9ERR(#03)
174352   COUTLINK: T:=CORMBANK; *LDATX DPAGL
174354          T:=PREVT; X=:D:=PREVX; *STATX DPAGL
174360          X:=D; T:=CORMBANK; A:=0=:D; *STDTX DPAGL; STZTX DPGPR
174366          X:=PREVX; T:=PREVT; GO INDO2
174371   *)FILL
174406   
174406   L4:    "MASKE"=:PIEREG; 0=:PIDREG
174411          CALL XCHIOX; XTMRTERM=:TMRTERM
174414          CALL SYSEVAL
174415   @LIB CXCPU-,
174415   % TEST FOR NEW MICROPROGRAM
174415          IF HWINFO(0)/\377=2 THEN        % NEW MICROPROGRAM, ND100 CX.
174423             "SCPOUT"-"XCLEP"-1+124000=:D; A:=ICLEP; AD=:XCLEP
174432             "SCPOUT"-"XSETP"-1+124000=:D; A:=ISETP; AD=:XSETP
174441             A:=124001=:XCLNREENT
174443             A:="NEWLOOP"-"XCHREENTPAGES"/\377+124000=:XCHREENTPAGES
174450          FI
174450   @ELIB
174450   @LIB CXCPU
174450          ESGTABLE-SEGSTART=:D:=0; T:=5SEGSIZE; *RDIV ST
174456          A-1=:SGMAX; "SEGTX"-SEGSTART=:D:=0; *RDIV ST
174465          A=:USEGM
174466   % SET TIMESLICE CLASS
174466   % IF SAVED TIMESLICE CLASS (TSLSTATUS BIT 15-17) EQUALS ZERO THEN
174466   %          TIMESLICE CLASS FOR TERMINALS IS SET TO ZERO AND TIMESLICE
174466   %          CLASS FOR BATCH IS SET TO ONE
174466   % ELSE
174466   %          TIMESLICE CLASS IS SET EQUAL SAVED TIMESLICE CLASS
174466   % ENDIF
174466   %
174466          FPTSLICE=:B; D:=0
174471          DO WHILE B<<LPTSLICE
174474             IF TSLSTATUS(D)/\160000=0 THEN
174500                X:="BCHTA"+1
174502                DO WHILE X.S0><-1
174506                   IF X.S1=B THEN T:=22000; GO BBBAT FI       % BATCH
174513                   X+4
174514                OD; T:=0
174516             ELSE
174517                T:=A SHZ -3\/A
174522   BBBAT:    FI; A:=TSLSTATUS(D)/\1000\/T=:TSLSTATUS(X)
174527             A:=5RTSIZE; B+A; D+1
174532          OD;
174533   *"8BFD1 8FDI1
"174533   GO INTDFIELDS
