123277   %==============================================================================
123277   %            E L O 3 F   D L O F 3
123277   
123277   % MONITOR CALLS TO ENABLE/DISABLE LOCAL FUNCTION
123277   %
123277   % ELO3F (ELOFU - MON 276)   - ENABLE  LOCAL FUNCTION          
123277   % DLOF3 (DLOFU - MON 277)   - DISABLE LOCAL FUNCTION          
123277   SUBR ELO3F,DLOF3
123277   INTEGER POINTER TTIF:=TTIFIELD
123300   ELO3F: K:=1; GO FELLS
123302   DLOF3: K:="0"
123303   FELLS: IF TTIF=0 THEN 33; GO RETU; FI
123307          IF A.TYPRING NBIT 5TERM AND A NBIT 5BAD THEN
123315             240; GO RETU
123317          FI
123317          IF K THEN
123321             ZAREG=:X.LUSADD; *IOF
123324             X.FLAGB BONE 5LCHAR=:X.FLAGB; *ION
123330          ELSE
123331             *IOF
123332             X.FLAGB BZERO 5LCHAR BZERO 5WLOC=:X.FLAGB; *ION
123337          FI
123337          MIN ZPREG; 0/\0; A:=0
123342   RETU:  A=:ZAREG; GO RET
123344   RBUS
