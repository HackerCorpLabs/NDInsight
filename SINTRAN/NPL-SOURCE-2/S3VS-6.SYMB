074020   CHCORMAP: EXITA
074021   RBUS
074021   
074021   %=============================================================================
074021   %            S S S W P   -   C B R E L   -   C B R E S
074021   %
074021   % RT-PROGRAM RESERVING THE SWAPPING-SEMAPHORE (CLFIE) AND WAITING FOR
074021   % THE DISC ON BEHALF OF THE SWAPPING-REQUESTING PROGRAM
074021   % THE SWAPPING-REQUESTING PROGRAM WILL BE SET IN SWAPPING-WAIT
074021   % 1SWAP HAS THE PRIORITY OF THE SWAPPING-REQUESTING PROGRAM
074021   %
074021   SUBR INRWSEGM,SSSWP,CBREL,CBRES,LNK1SWAP
074021   INTEGER XREGG
074022   SSSWP: *IOF
074023          "XRTEX"; *IRW MLEVB DP
074025          MLEV; *MST PID; ION
074030          GO SSSWP
074031   
074031   % MONITOR LEVEL
074031   XRTEX: X:="1SWAP"
074032          DO WHILE X.BRESLINK><X; A=:B; CALL BRELEASE; OD 
074040          CALL FREXQ
074041          IF SWPFLAG><1 THEN
074045             X:="BEXQU-WLINK"; T:="BEXQU-BWLINK"; A:=XREGG
074050             DO WHILE X:=X.WLINK><T
074053                IF X=A GO IRWAIT
074055             OD 
074056          FI; GO STUPR
074057   
074057   % SUBROUTINES FOR QUICK BRESERVE/BRELEASE
074057   CBREL: X+5BRESLINK
074060          DO WHILE X.RESLINK><B; X:=A; OD
074065          RESLINK=:X.RESLINK; 0=:RESLINK=:RTRES; EXIT
074072   
074072   CBRES: X.BRESLINK=:RESLINK; A:=B=:X.BRESLINK; X=:RTRES; EXIT
074100   
074100   %============================================================================
074100   %            L N K 1 S W A P
074100   %
074100   % ROUTINE TO START 1SWAP
074100   % MONITOR LEVEL, CALLED FROM RWSEGM
074100   %
074100   % ENTRY:     B=ADDRESS OF DISC DATAFIELD
074100   %            X=DISC-REQUESTING RT-PROGRAM
074100   %
074100   % EXIT TO PSTUPR
074100   %
074100   
074100   LNK1SWAP: X=:XREGG
074101          X.ACTPRI BONE 5SWWAIT=:X.ACTPRI
074104          X.STATUS BONE 5WAIT=:X.STATUS
074107          X:="1SWAP"; CALL TOWQU                    % 1SWAP WAITS FOR DISC
074111          X:=XREGG; "CLFIE"=:B; CALL CBREL          % RELEASE SWAPPING-SEMAPHORE FROM
074115                                                    % DISC-REQUESTING PROGRAM
074115          X:="1SWAP"; CALL CBRES                    % DISC IS RESERVED BY 1SWAP
074117          GO PSTUPR
074120    RBUS
074137   
074137   %==========================================================================
074137   %            S W P R E L E A S E
074137   %
074137   % RESETT THE SWAPPING-QUEUE
074137   %
074137   % ENTRY:     B=DATAFIELD
074137   %
074137   SUBR SWPRELEASE
074137   INTEGER XREGG
074140   SWPRELEASE: 
074140          IF "CLFIE"=B THEN
074143             X=:XREGG:="BEXQUE-WLINK"; T:="BEXQU-BWLINK"
074146             DO WHILE X:=X.WLINK><T
074151                IF X.ACTPRI BIT 5SWWAIT THEN
074154                   A BZERO 5SWWAIT=:X.ACTPRI; X.STATUS BZERO 5WAIT=:X.STATUS
074161                FI
074161             OD; X:=XREGG
074163          FI; EXIT
074164   RBUS
074167   
074167   %===========================================================================
074167   %            M R L C L F I E
074167   %
074167   % SUBROUTINE TO RELEASE THE SWAPPING-SEMAPHORE (CLFIE) WHEN
074167   % WAITING FOR THE DISC (WAITING IN RWSEGM)
074167   %
074167   % CALLED FROM MESCAPE AND SYSABORT IN MON-60 (ND-500 DRIVER)
074167   %
074167   % ENTRY: X=ACTUAL PROGRAM
074167   %
074167   SUBR MRLCLFIE
074167   MRLCLFIE: IF SWPFLAG><0 THEN
074171                IF X.ACTPRI BIT 5SWWAIT THEN
074174                   A BZERO 5SWWAIT=:X.ACTPRI
074176                   X.STATUS BZERO 5WAIT=:X.STATUS
074201                FI
074201             FI; EXIT
074202   RBUS
