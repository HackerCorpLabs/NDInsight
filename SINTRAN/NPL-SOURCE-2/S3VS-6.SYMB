123614   
123614   PT3MC144:
123614          IF IOLOG>="RDVLO" AND <"RDVHI" THEN   % REMOTE PERIPHERAL?
123623             IOLOG-"RDVDF"=:IOLOG; CALL LOGPH; IF =0 THEN D=:A; FI; A=:DMFLD
123632             IF =0 THEN A:=174; GO FAR ERR; FI
123635             IF A.OFNBR<100 OR >177 THEN A:=201; GO FAR ERR; FI; GO RMAG
123650          FI
123650          IOLOG; CALL LOGPH; IF =0 THEN D=:A FI
123654          IF =0 OR A.TYPRING NBIT M144B THEN 174; GO FAR ERR FI
123663          IF A BIT 5COM THEN CALL COMBLOCK FI                 % 5COM: COMMUNICATION CHANNEL
123666          IF A BIT 5HDMA OR A BIT 5IBDV THEN                  % 5HDMA: BSC ON DMA, HDLC.
123672             IF IFUNC=1 OR =51 OR =52 OR =55 THEN D=:X FI     % 5IBDV: INTERNAL BLOCK DEVICE: X-REG POINTS TO CHAR DATAFIELD.
123710          FI
123710          IF X.RTRES><0 AND A><SSREF GO FAR E205
123715          X.CASUN=:IUNIT; X.CLOGDV=:DMLOG; CALL LOGPH
123722          IF A = 0 THEN A:=ER109; GO FAR ERR FI               % "ILLEGAL PARAMETER".
123725          A=:DMFLD
123726          IF A.TYPRING BIT 5IBDV THEN
123732   %
123732   %         INTERNAL BLOCK DEVICE. CHECK THAT A DMA DEVICE BUFFER HAS
123732   %         ALREADY BEEN OBTAINED AND IF NOT GET ONE.
123732   %
123732             X=:CMDBU; T:=X.DBLDN
123734             IF T = 0 THEN
123736                A:=IMAXW; T:=IOLOG; CALL G3IBUF; GO FAR ERRBU
123742                T=:MDFI; A:=D=:MDBUF; X=:D
123746                A:=IMAXW+1777 /\ 177000=:T.CPAG2              % BUFFER OBTAINED FOR UP TO THIS NUMBER OF WORDS.
123753                A:=X.LNUMB=:D.DBLDN                           % SAVE LDN OF DBH IN INPUT PART OF IBD DATAFIELD.
123756                0=:X.BREGC                                    % NEW DEVICE BUFFER: NO DATA IN IT.
123757             ELSE
123760                A:=T; CALL XLOCK; A:=T                        % LOCK THE DBH
123763                CALL LOGPH; A=:X=:MDFI; A:=X.BUFFER=:MDBUF    % LEAST SIG WORD OF DB ADDRESS.
123770                IF A:=IMAXW > T:=X.CPAG2 THEN
123774                   A:=ER206; GO FAR ERR                       % TRYING TO READ OR WRITE TOO MANY WORDS IN THE BUFFER.
123776                FI
123776             FI
123776             X:=CMDBUF; A:=MDBUF=:CMDBUF                      % X-REG NOW POINTS AT RIGHT DATFIELD.
124001             A:=OFLD3; CALL XUNLOCK
124003             GO FAR M144X
124004   *)FILL
124024          FI    % EG. ELSE
124024   RMAG:        IOLOG; CALL LOGPH
124026                IF A><0 THEN IF A.RTRES><0 AND A><SSREF GO FAR E205 FI
124035                IF D><0 THEN IF D.RTRES><0 AND A><SSREF GO FAR E205 FI
124045   *"8MDIR 99MGT
"124045          IF IFUNC<5 OR =25 OR =43 OR =44 OR =52 OR =55 THEN
124070             IMAXW
124071          ELSE
124072             IF A=26 OR A=27 THEN IMAXW+1 SHZ -1 ELSE A:=0 FI
124105          FI
124105          A=:D                                                % NO. OF WORDS
124106          IF DMFLD.TYPRING BIT 5HDMA THEN
124112             IF BREGC=0 THEN                                  % DEVICE BUFFER IS PRESENT
124114                T:=IOLOG; A:=D; CALL G3BUFF; GO ERRBU
124120                A:=D=:MDBUF=:CMDBUF; T=:MDFI; 1=:BREGC
124126                IOLOG; CALL LOGPH; D=:X                       % GET OPPOSIT DATAFIELD
124131                X.DFDEV; CALL LOGPH; A=:X
124134                IF X=B THEN                                   % THIS IS THE SAME,
124136                   IOLOG; CALL LOGPH; A=:X                    % GET OPPOSITE
124141                   X.DFDEV; CALL LOGPH; A=:X
124144                FI
124144                CMDBUF=:X.CMDBUF=:X.MDBUF
124147                MDFI=:X.MDFI; 1=:BREGC
124153             ELSE
124154                CMDBUF=:MDBUF                                 % DEVICE BUFFER OK
124156             FI
124156          ELSE
124157             T:=IOLOG; A:=D; CALL G3BUFF; GO ERRBU
124163             A:=D=:MDBUF=:CMDBUF; T=:MDFI
124167          FI
124167          IF DMFLD.OFFLG BIT 5RCFIL AND X.TYPRING BIT 5RFILE GO M144X
124176          OFLD1; CALL XUNLOCK; GO M144X
124201   *)FILL
124205   
124205   INTEGER POINTER OFLD1:=OFLCK
124206   
124206   ERRAD: 153; GO FAR RETU
124210   ERRBU: 172; GO ERR
124212   E201:  201; GO ERR
124214   E205:  205
124215   ERR:   GO FAR RETU2
124216   
124216   M144X: IF DMFLD.TYPRING BIT 5FLOP THEN
124222             IFUNC/\77+"SFTIM"=:X; T:=0; *LDATX     % FLOPPY/STREAMER FUNCTION DESCRIPTION (IN POF)
124230             IF A BIT 3FRESTRICTED THEN
124232                IF SSREF.ACTPRI BIT 5BACKR OR A/\3 < 2 GO E201  % ONLY LEGAL FOR RT-P ON RING 2
124242             FI
124242          FI
124242          IF IFUNC=20 OR =24 OR =57 OR =64 OR =65 OR =70 THEN
124265             CALL CALABSTR; GO FAR RETU; *)FILL
124277          FI
124277          IF A=42 OR A=46 OR =56 OR =63 THEN        % READ FORMAT/READ DISC ADDR.+ND852 FUNCTIONS
124313             T:=1; SSREF=:D; "IRETW"; CALL CHLIM; GO ERRAD
124321             CALL CALABSTR; X:=B; CALL GAPIT
124324             MDFI.DBLOCK; X:="IRETW"
124327             CALL DALTON; A=:X.S0; CALL ALTOFF; *BSET ONE
124333             GO FAR RETU1
124334          FI
124334   @ICR
124334          IF >4 AND A><43 AND A><44 AND A><25 AND A><52
124334            AND A><55 AND A><26 AND A><27 AND A><36 THEN
124334   @CR;
124367             CALL CALABSTR
124370   %
124370   %         CLEAR DEVICE: BLOCK INTERNAL DEVICES ONLY.
124370   %
124370             IF DMFLD.TYPRING BIT 5IBDV AND IFUNC=21 THEN
124400                A:=X.DBLDN; CALL LOCK                         % LOCK DEVICE BUFFER HEADER.
124402                T:=IOLOG; CALL R3IBUFF; CALL ERRFATAL
124405                0=:X.DBLDN; 0=:X.IDFOPP.BREGC
124410             FI
124410             GO FAR RETU1
124411   *)FILL
124422          FI
124422   
124422   %      READ OR WRITE FUNCTIONS:
124422   
124422   L1:    IF IFUNC=2 OR=26 OR=27 THEN T:=IMAXW+1 SHZ -1 ELSE T:=IMAXW FI 
124441          SSREF=:D:=ICORAD
124444          CALL CHLIM; GO FAR ERRAD                  % ILL. USER-BUFF-ADDR
124446          IF MTFLG><0 THEN
124450             T:=1; "IRETW"
124452             CALL CHLIM; GO FAR ERRAD               % CHECK ADDRESS OF IRETW
124454          FI
124454          CALL BLOCK
124455          IF IFUNC><0 AND A><2 AND A><4 AND A><43 AND A><25 AND A><26 AND A><36 GO FAR L3    % READ
124501             IF DMFLD.TYPRING BIT 5FLOP THEN IMAXW=:FIMAXW FI
124507             CALL CALABSTR                          % CALL ABSTR, SAVE STATUS
124510             IF DMFLD.TYPRING BIT 5FLOP THEN
124514                IF SVXERR BIT 4 THEN A:=0 ELSE FIMAXW FI
124522                A=:IMAXW
124523             ELSE
124524                IF A BIT 5IBDV THEN
124526                   MDFI.BUFFER; A=:MDBUF=:CMDBUF    % INTERNAL BLOCK DEVICE.
124532                   X.DBLOCK=:IMAXW
124534                ELSE
124535                   IF A BIT 5HDMA THEN
124537                      IF SVXERR BIT 4 THEN
124542                         A:=0
124543                      ELSE
124544                         X:=MDFI.BUFFER; T:=BUFBANK; *LDATX 10
124550                         A+1 SHZ -1+2
124553                         IF A>IMAXW THEN
124556                            A:=T
124557                         FI
124557                      FI
124557                      A=:IMAXW
124560                   ELSE
124561                      MDFI.DBLOCK=:IMAXW
124564             FI FI FI
124564   RRETU:    X:=B; CALL GAPIT; X:="IRETW"; T:=IMAXW
124570             IF MTFLG BIT MCMAGTP THEN
124573                CALL DALTON
124574                T=:X.S0; CALL ALTOFF; *BSET ONE
124577             FI; GO L2                                        % NO. OF WORDS READ
124600   *)FILL
124611   
124611   L2:       IF T>0 THEN
124613                OFLD; CALL XLOCK
124615                IF IFUNC=26 THEN
124621                   IMAXW+1 SHZ -1 =: IMAXW                    % BYTES => WORDS!!!
124625                FI; OLDPAGE=:D
124627   @LIB CXCPU-,
124627                DO WHILE IMAXW >> 2000                         % COPY PAGE AT A TIME.
124633                   ICORAD; X:=CMDBUF; T:=BUFBANK; CALL DBTRANS
124637                   T:=2000; CALL PT3COPYB
124641                   CMDBUF+T=:CMDBUF; ICORAD+T=:ICORAD; IMAXW-T=:IMAXW
124652                   T:=-1; CALL MMEXY
124654                OD
124655   @ELIB
124655                X:=CMDBUF; ICORAD; T:=BUFBANK; CALL DBTRANS;
124661                T:=IMAXW; CALL PT3COPYB                          % LAST BLOCK <= 2000 (OCT) WORDS.
124663                OFLD; CALL XUNLOCK
124665             FI
124665             GO OVER
124666   *)FILL
124675                                          % WRITE
124675   L3:       OFLD; CALL XLOCK
124677             IMAXW=:D
124701             IF IFUNC=27 THEN                                 % WRITE BYTE RECORD.
124705                A:=D+1 SHZ -1 =: D                            % BYTES => WORDS!!!
124710             FI
124710   @LIB CXCPU-,
124710             DO WHILE D>>2000                                 % D CONTAINS IMAXW
124713                T:=OLDPAGE:=:D; X:=CMDBUF; ICORAD
124717                T=:TSAVE:=BUFBANK; CALL DBTRANS; T:=TSAVE
124723                A:=:X; T=:D:=2000; CALL PT3COPYB
124727                D-T; CMDBUF+T=:CMDBUF; ICORAD+T=:ICORAD
124736             OD
124737   @ELIB
124737             T:=OLDPAGE:=:D; X:=CMDBUF; ICORAD
124743             T=:TSAVE; T:=BUFBANK; CALL DBTRANS; T:=TSAVE
124747             A:=:X; CALL PT3COPYB
124751             OFLD; CALL XUNLOCK
124753             CALL CALABSTR
124754   OVER:     CALL BUNLOCK; GO RETU1
124756                             
124756   INTEGER POINTER OFLD:=OFLCK                      % IN FILE SYSTEM
124757   
124757   RETU1: IF DMFLD.OFFLG BIT 5RCFIL AND X.TYPRING BIT 5RFILE GO RETU3
124766          IF SVXERR BIT 4 THEN X:=DMFLD; CALL MERRCODE ELSE A:=0 FI
124775   RETU:  A=:SVXERR
124776   RETU3: IF DMFLD.TYPRING BIT 5IBDV AND IFUNC >< 21 THEN
125006             A:=MDFI.LNUMB; CALL UNLOC                        % UNLOCK, BUT DON'T CLEAR, DBH.
125011          ELSE
125012             IF A NBIT 5HDMA THEN
125014                OFLD; CALL XLOCK
125016                T:=IOLOG; CALL R3BUF; CALL ERRFATAL
125021                OFLD; CALL XUNLOCK; A:=SVXERR
125024             FI
125024          FI
125024   RETU2: X:=ZDREG=:D:=ZXREG; T:=ZTREG; GO MCLRG
125031   
125031   *)FILL
125045   
125045   % SUBROUTINE FOR CALLING ABSTRANS
125045   CALABSTR:                                                            % TEST IF REMOTE
125045          IF DMFLD.OFFLG BIT 5RCFIL AND X.TYPRING BIT 5RFILE THEN       % REMOTE MAGTP
125054             B=:D; T:=MDFI;  GO RMAGT
125057          FI
125057          IFUNC=:MDFI.DKFUN; IUNIT=:X.DBLO1; IMAXW=:X.DBLOCK
125066          IF DMFLD.TYPRING BIT 5FLOP THEN
125072             IF IFUNC<2 OR A=43 OR A=44 THEN                  % READ/WRITE FUNCTIOINS
125104                IUNIT+DMFLD+"FDIFORM"=:X; X.S0+DMFLD+"WDSCT"=:X
125114                T:=X.S0; A:=IMAXW=:D:=0; *RDIV ST
125121                IF D><0 THEN A+1 FI; A=:MDFI.DBLOCK=:D
125127                IUNIT+DMFLD+"NFDIADR"=:X; X.S0+D=:X.S0-D=:MDFI.DBLO1
125141             FI
125141             IUNIT SH 6+IFUNC=:MDFI.DKFUN
125146          ELSE
125147             IF A BIT 5IBDV AND IFUNC/\ 77 = 1 THEN
125156                DMLOG BONE 17=:DMLOG                          % WRITE ON AN INTERNAL BLOCK DEVICE.
125161             FI
125161          FI
125161          T:=DMLOG; MDFI+"DPNT0"; *MON 2ABST
125165          A=:SVXERR; EXIT
125167   *)FILL
