"075154   
075154   
075154   %==============================================================================
075154   %            S G A N D   S G O R
075154   %
075154   % SUBROUTINES TO THE SEGMENT-WRITE-PERMIT AND SEGMENT-WRITE-PROTECT COMMANDS
075154   % ENTRY: X=SEGMENT TABLE ENTRY; D=SEGMENT NUMBER
075154   % EXIT: ERROR
075154   % EXIT+1: OK
075154   
075154   SUBR SGAND,SGOR
075154   INTEGER CSEG
075155   SGAND: K:="0"; GO FELLS
075157   SGOR:  K:=1
075160   FELLS: MLEV; *MCL PIE
075162          X=:CSEG
075163          IF X=SEGMA OR X=SEGMB OR X=SEGMC THEN
075174             D=:T; X.LOGADR/\377 SH 1+177000=:T
075202             X.LOGADR SHZ -10 SH 1; T=:X; T+A
075207             DO WHILE X><T
075211                *PIOF
075212                IF X.S0/\377=D THEN
075216                   X.S0; IF K THEN A BONE 5WPM ELSE A BZERO 5WPM FI; A=:X.S0
075225                FI; X+2; *PION
075227             OD
075230          FI; T:=0; X:=CSEG+1
075233          DO
075233             *LDXTX DPAGL
075234          WHILE X><0
075235             T:=CORMBANK
075236             *LDATX DPGPR
075237             IF K THEN A BONE 5WPM ELSE A BZERO 5WPM FI; *STATX DPGPR
075245          OD; CSEG.FLAG; IF K THEN A BONE 5WPM ELSE A BZERO 5WPM FI; A=:X.FLAG
075256          MLEV; *MST PIE
075260          EXITA
075261   RBUS
075267   
075267   
075267   %==============================================================================
075267   %            M X R E T
075267   %
075267   % ROUTINE TO RELEASE MONITOR CALL WORKING FIELD AND GO TO MRET
075267   %
075267   SUBR MXRET
075267   MXRET: MLEV; *MCL PIE
075271          X:=RTREF; CALL BRELEASE
075273          A:=B; *IRW MLEVB DX
075275          "MRET"; *IRW MLEVB DP
075277          "MONEN"; *IRW MLEVB DL
075301          MLEV; *MST PID; MST PIE; PION
075305          CALL ERRFATAL
075306   RBUS
075313   
