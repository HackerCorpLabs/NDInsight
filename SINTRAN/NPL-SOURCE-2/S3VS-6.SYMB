133112   
133112   
133112   %      ERROR CODES SENT FOR USER
133112   
133112   SYMBOL ENCLEAR = 100                   % DEV. NOT CLEARED BEFORE INITIATED
133112   SYMBOL ENINIT  = 101                   % DEV. NOT INITIATED BEFORE TRANSMITTION
133112   SYMBOL EUND    = 102                   % UNDERRUN
133112   SYMBOL ETOU1   = 103                   % TRANSFER TIMEOUT
133112   SYMBOL ETOU2   = 104                   % COMMAND TIMEOUT (LOCAL IN IOF)
133112   SYMBOL EILFNC  = 105                   % ILLEGAL FUNCTION
133112   SYMBOL EILLINT = 106                   % HW. FAILURE ININIT.
133112   SYMBOL ETOMUCH  = 107                  % RECEIVER LIST OVERFLOW
133112   SYMBOL ECLEAR   = 110                  % DEVICE CLEARED, MESSAGE RETURNED
133112   SYMBOL EINP     = 111                  % OVERRUN OR CRC ERROR ON INPUT
133112   SYMBOL EPAR     = 112                  % ILLEGAL PARAMETER
133112   SYMBOL EILSIZ   =113                   % BYTECOUNT (FRAMD DATA PART) > FRAMESIZE
133112   SYMBOL ETOSM    =114                   % TOO SMALL MESSAGE FOR EXPECTED INFO
133112   SYMBOL EILFZ    =115                   % ATTEMPT TO SEND FRAME < 2 BYTES
133112   SYMBOL EX21     =116                   % CONNECTION BROKEN BY X21
133112   SYMBOL EDISP    =117                   % ILLEGAL DISPLACEMENT SPESIFICATION
133112   SYMBOL ELOCK    =120                   % DRIVER LOCKED (POSSIBLY BY X21)
133112   %
