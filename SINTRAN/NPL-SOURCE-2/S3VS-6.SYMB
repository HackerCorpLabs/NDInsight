116373   %==============================================================================
116373   % 37.6       S E G C H E C K
116373   %
116373   % SUBROUTINE TO CHECK IF A SEGMENT IS OK
116373   % B=ADDR. IN SEGMENT TABLE; RETURN: A=0 IF OK,ELSE -1
116373   % IF OK THE SEGMENT IS PLACED IN START OF SEGMENT LIST
116373   
116373   SUBR SEGCHECK
116373   INTEGER XREG
116374   SEGCHECK: X=:XREG; IF B=0 GO OK
116377          IF FLAG BIT 5OK THEN
116402                IF A BIT 5DEMAND THEN T:=1=:DEMAND FI
116406                IF SEGLINK><0 AND BSEGLINK><B THEN
116413   LOOP:          IF A.SEGLINK=B THEN SEGLINK=:X.SEGLINK  %REMOVE
116421                  ELSE IF ><-1 GO LOOP FI
116425                  BSEGLINK=:SEGLINK; A:=B=:BSEGLINK      %INSERT
116431                FI
116431   OK:          A:=0
116432          ELSE -1
116434          FI
116434          X:=XREG; EXIT
116436   RBUS
116440   
116440   %==============================================================================
116440   % 37.7       C L N R E E N T R
116440   %
116440   % SUBROUTINE TO RESET NONREENTRANT PAGES IN PAGE INDEX TABLE
116440   % A=SEGMENT ADDRESS,X=RT-DESCR
116440   SUBR CLNREENTR
116440   @LIB CXCPU
116440   @LIB CXCPU-,
116440   INTEGER POINTER ARRAY PTBLE,RTDSCR
116442   INTEGER XCLNREENTR(0)
116442   CLNREENTR: GO NOCXCPU
116443          X=:D:=X.RTDLGADDR+5BITMAP-25; T:=34
116450          *ICLNR
116451          X:=D; EXIT
116453   INTEGER SVX                 
116454   NOCXCPU: IF A=0 GO OUT
116455          X=:SVX:=X.RTDLGADDR
116457          X=:"RTDSCR"; A.LOGADR/\300 SH 1+177000=:"PTBLE"; 5BITMAP=:D
116470          FOR D TO "5BITMAP+7" DO
116473             "PTBLE"+40=:"PTBLE"; RTDSCR(D)
116500             IF A><0 THEN
116501                FOR X:=-20 DO
116502                   A SHR -1
116503                   IF A<0 THEN X=:T+X; 0=:PTBLE(X); X:=T; FI
116510                OD
116511             FI
116511          OD; X:=SVX
116514   OUT:   EXIT
116515   @ELIB
116515   RBUS
116517   
116517   %==============================================================================
116517   % 37.8       C S E G S   X C S E G S   C H R E E N T P A G E S
116517   %
116517   % SUBROUTINES TO CLEAR SEGMENTS
116517   % CSEGS CLEARS IF SEGMENT IS PRESENT (A=SEGMENT POINTER)
116517   % XCSEGS CLEARS ALWAYS
116517   
116517   SUBR CSEGS,XCSEGS,CHREENTPAGES
116517   INTEGER XREG
116520   INTEGER POINTER IPIT3:=177600+5BFPAGE+5BFPAGE
116521   INTEGER POINTER IPIT0:=177000+5BFPAGE+5BFPAGE
116522   INTEGER POINTER LREG,UPIT0:=177000+5UBFPAGE+5UBFPAGE
116524   CSEGS: IF A><SEGMA AND ><SEGMB AND ><SEGMC THEN EXIT FI
116536   XCSEGS: X=:XREG:=L=:"LREG"
116541   @LIB CXCPU
116541   *"8LAMU
"116541          CALL CLAMU
116542   *"
"116542          SEGMA; CALL CLSEG; SEGMB; CALL CLSEG; SEGMC; CALL CLSEG
116550          CALL CLERT            % CLEAR PIT ENTRIES FOR RT'S SYSTEM SEGMENT
116551          IF SEGMC><0 THEN CALL CHREENTPAGES FI
116554          0=:SEGMA=:SEGMB=:SEGMC
116557          X:=XREG; GO LREG
116561   *)FILL
116570   
116570   DOUBLE SVAD
116572   INTEGER CSEG
116573   NEWLOOP: X:=CSEG+1; D:=0; T:=CORMBANK
116577          DO
116577             *ICHRE
116600             GO WIPSET; GO FAR OUT
116602   WIPSET:   AD=:SVAD; CALL COUTLINK
116604             AD:=SVAD; A=:X
116606          OD
116607   
116607   INTEGER CALOGNO,EALOGNO,ERINDICATOR
116612   INTEGER POINTER LREG2
116613   INTEGER PREVX,PREVT,CURX,BRG,SHAINSTR(0); *SHA
116620   CHREENTPAGES: A=:CSEG; IF A.FLAG NBIT 5WPM THEN EXIT FI
116626          A:=L=:"LREG2"; A:=B=:BRG; 0=:ERINDICATOR
116633   @LIB CXCPU
116633   @LIB CXCPU-,
116633   INTEGER XCHREENTPAGES(0); *JMP *+1     % ALTERNATIVE: GO NEWLOOP
116634   LOOP:  X:=CSEG+1; T:=0
116637          DO
116637             X=:PREVX; T=:PREVT; *LDXTX DPAGL
116642          WHILE X><0
116643             T:=CORMBANK
116644             *LDATX DPGPR
116645             IF A BIT 5WIP THEN                     % WRITTEN IN PAGE
116647                X=:CURX; *LDATX DPAGL
116651                X:=PREVX; T:=PREVT; *STATX DPAGL % REMOVE PAGE
116654                X:=CURX; CALL COUTLINK; X:=PREVX; T:=PREVT
116660             FI
116660          OD
116661   @ELIB
116661   OUT:   BRG=:B; IF CSEG.BPAGLINK=0 THEN CALL SREMOVE FI
116667          IF ERINDICATOR><0 GO PSBRTEXT       % ABORT PROGRAM
116672          GO LREG2
116673   
116673   INTEGER POINTER LREG3
116674   COUTLINK: A:=L=:"LREG3"; X=:CURX
116677          SEGMA; CALL INSRPAGE                % INSERT PAGE?
116701          IF A=0 THEN SEGMB; CALL INSRPAGE    % INSERT PAGE?
116704             IF A=0 THEN                      % OUTSIDE SEGMENT BOUNDS
116705                *LDATX DALOG
116706                A=:EALOGNO
116707                IF "XSGRT".SEGLINK=0 THEN     % SET DUMMY LAST IN SEGMENT LINK
116712                   X:="BSEGLINK"
116713                   DO WHILE X.SEGLINK><-1; X:=A; OD
116721                   "XSGRT"=:X.SEGLINK; -1=:"XSGRT".SEGLINK
116726                FI; "XSGRT"=:B; A:=BPAGLINK; X:=CURX=:BPAGLINK
116733                T:=CORMBANK; *STATX DPAGL            % LINK PAGE TO DUMMY
116735                A:=1; *STATX DPGPR
116737                RTREF=:CALOGNO; SEGPROG=:RTREF=:ERINDICATOR
116744                EALOGNO; CALL 9ERR(#14); CALOGNO=:RTREF
116751                GO LREG3
116752             FI
116752          FI; *LDDTX DPAGL
116753          CSEG.LOGADR/\300; D-A; A:=D; AD SHZ -4
116761          X:=SEGPROG.RTDLGADDR+A
116764          SHAINSTR; D SHZ -14+A; 1; *EXR SD
116771          A\/X.BITMAP=:X.BITMAP; GO LREG3
116774   
116774   RBUS
117013   
117013   %==============================================================================
117013   % 37.9       I N S R P A G E
117013   %
117013   % SUBROUTINE TO INSERT A PAGE INTO A SEGMENT
117013   % A=SEGMENT ADDRESS, X=CORMAP ELEMENT ADDRESS
117013   % RETURN: A=SEGMENT NUMBER IF OK, ELSE A=0
117013   
117013   SUBR INSRPAGE
117013   INTEGER BREG
117014   INSRPAGE: IF =0 THEN EXIT FI
117016          A:=:B=:BREG; IF FLAG NBIT 5DEMAND THEN A:=0; GO OUT FI
117025          *LDATX DALOG
117026          A=:T; LOGADR; AD SHZ -10; D SHZ -10
117032          IF T>=D AND T<D+A THEN                    % INSIDE, INSERT
117037             A:=BPAGLINK; T:=CORMBANK; *STATX DPAGL
117042             A:=B-SEGSTART=:D:=0; T:=5SEGSIZE; *RDIV ST
117050             T:=CORMBANK; A=:D; *LDATX DPGPR
117053             A/\177400\/D; *STATX DPGPR
117056             X=:BPAGLINK
117057             IF SEGLINK=0 THEN BSEGLINK=:SEGLINK; A:=B=:BSEGLINK FI
117065             A:=D               % OK: A=SEGMENT NUMBER
117066          ELSE
117067             A:=0               % NOT OK
117070          FI
117070   OUT:   T:=BREG=:B:=CORMBANK
117073          EXIT
117074   RBUS
