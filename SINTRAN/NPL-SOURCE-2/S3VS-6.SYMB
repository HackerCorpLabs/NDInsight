124601   
124601   *"8HDMA
"124601   
124601   *"99NTB
"124601   
124601   @DEV 1
124601   @DEV (S-S-J)MRES-CDR2
124601   %
124601   %==============================================================================
124601   %      M R E S - C D R 2
124601   %==============================================================================
124601   
124601   
124601   *"8MT1+8MT2+8MT3+8MT4
"124601   
124601   
124601   
124601   *"CAMA
"124601   %==============================================================================
124601   % 39.6       T F D I S K   F D I B U S   F D I F I N   F D I F E I L
124601   %            B U F D I S C   F I N F D I S C
124601   %
124601   %
124601   % ROUTINE TO SET UP CALL TO THE FLOPPY DISC DRIVER
124601   % LEVEL 11
124601   %
124601   % ENTRY: B=ADDRESS OF THE DATAFIELD
124601   %        X=ADDRESS OF THE PARAMETER LIST
124601   %
124601   %
124601   % PARAMETERS:
124601   %
124601   %      PAR-0(BIT 0-5)= FUNCTION CODE
124601   %
124601   %             0 - READ
124601   %             1 - WRITE
124601   %             2 - TEST PARITY (READ CRC)
124601   %             3 - DUMMY
124601   %             7 - ERASE TAPE
124601   %            10 - ADVANCE TO EOF
124601   %            11 - REVERCE TO EOF
124601   %            12 - WRITE EOF
124601   %            13 - REWIND TO BOT
124601   %            14 - ADVANCE ONE RECORD
124601   %            15 - REVERCE ONE RECORD
124601   %            21 - CLEAR-DEVICE
124601   %            20 - READ STATUS
124601   %            24 - READ LAST STATUS
124601   %            36 - READ EXTENDED STATUS
124601   %            41 - FORMAT FLOPPY
124601   %            42 - READ FORMAT
124601   %            43 - READ DELETED RECORD
124601   %            44 - WRITE DELETED RECORD
124601   %            46 - READ-CURRENT-ADDRESS
124601   %            47 - WRITE-NEW-ADDRESS
124601   %            54 - COPY-FLOPPY
124601   %            55 - FORMAT-TRACK
124601   %            56 - CHECK-CARTRIDGE (READ AND TEST CRC)
124601   %            57 - TEST CARTRIDGE CAPASITY (WRITE)
124601   %            70 - RETENSION CARTRIDGE
124601   %            71 - PERFORM TEST
124601   %            72 - ILLEGAL COMMAND
124601   %            73 - CLEAR
124601   %            74 - CONTINIOUS READ
124601   %            75 - CONTINIOUS WRITE
124601   %
124601   %       BIT 6-7: UNIT NUMBER  (0,1,2,3)
124601   %
124601   %       BIT 12: STREAMER CASSET
124601   %
124601   %       PAR-1 (24-BIT MEMORY ADDRESS)
124601   %
124601   %       PAR-2 (DISK ADDRESS (LOGIC SECTOR ADDRESS))
124601   %
124601   %       PAR-3 AMOUNT TO TRANSFER (LOGICAL BLOCKS)) IF READ/WRITE
124601   %             ELSE PAR-3=FORMAT NO. IF FUNCTION IS SELECT FORMAT
124601   %
124601   %  THE FUNCTION FLAGS ARE:
124601   %
124601   %      BITS 0 TO 10   = TIMEOUT IN SECONDS
124601   %                          777=MAX (SFTIM(100))
124601   
124601   % SYMBOL  3FLOP = 11 % LEGAL ON FLOPPY
124601   % SYMBOL  3STRE = 12 % LEGAL ON STREAMER
124601   % SYMBOL  3FLTI = 13 % SHORT FLOPPY TIMEOUT (SFTIM (101)).
124601   % SYMBOL  3FRES = 14 % LEGAL ONLY FROM RT-PROGS ON RING 2
124601   % SYMBOL  3DOUA = 15 % DOUBLE ADDRESS; BITS 0-5 GIVES NEW FUNCTION TO USE
124601   % SYMBOL  3DOUB = 16 % DOUBLE AMOUNT; BITS 0-5 GIVES NEW FUNCTION TO USE
124601   % SYMBOL  3ILLF = 17 % ILLEGAL FUNCTION
124601   
124601   @ICR
124601   
124601   INTEGER ARRAY SFTIM := (
124601    7170,   7170,  23056,   1001,     -1,     -1,     -1,   2777,
124611    3700,   1700,   3020,   7200,     -1,   1001,   1001,     -1,
124621    3001,  33073,     -1,     -1,   3001,     -1,     -1,     -1,
124631      -1,     -1,     -1,     -1,     -1,     -1,   3010,     -1,
124641    1010,   1170,   1010,   1010,   1010,     -1,   1001,   1001,
124651      -1,     -1,     -1,     -1,  11400,   1100,   3777,   2777,
124661   21000,  21001,  23003,  21003,  42074,  42075,     -1,     -1,
124671    2777,  12777,   2001,   2777,  12200,  12200,     -1,     -1,
124701    1400,       % MAX TIMEOUT
124702      04);      % SHORT FLOPPY TIMEOUT
124703   
124703   @CR;
124703   
124703   INTEGER SFFUN                % FLAGS AND TIMOUT COUNTER
124704   
124704   SUBR TFDISK,FDIBUS,FDIFIN,FDIFEIL,BUFDISC,FINFDISC,FLV1STFL
124704   
124704   % LOCAL SUBROUTINE TO CHANGE FUNCTION CODE WHEN THIS IS REQUIRED
124704   % ENTRY WITH D=DATAFIELD; EXIT WITH X=DATAFIELD
124704   CHFFUNC: X:=77; X/\T; X:=:D; X.CTRG/\177700\/D=:X.CTRG     % NEW FUNCTION
124713            X:=:D; SFTIM(X)=:SFFUN; X:=D
124717            EXIT
124720   
124720   TFDISK: X:=:B
124721          0=:X.HSTAT=:X.CERRCODE
124723          CALL PICKFPAR; AD=:X.MEMAD; T=:X.CTRG
124726          X=:D:=77; X/\T; T:=SFTIM(X)=:SFFUN        % FLAGS ACCORDING TO FUNCTION
124733          IF T<0 GO FAR D201ER                      % ILLEGAL FUNCTION
124735          IF T BIT 3FRESTRICTED THEN                % FUNCTION ONLY ALLOWED FROM RT-PROGS ON RING 2-3
124737             IF D.RTRES=0 GO FAR D201ER             % FLOPPY NOT RESERVED
124743             IF A.ACTPRI BIT 5BACKGR OR A/\3<2 GO FAR D201ER  % ONLY LEGAL FOR RT-PROGS ON RING 2
124753          FI
124753          IF T BIT 3DOUA THEN                       % DOUBLE FLOPPY DISC ADDRESS
124755             CALL CHFFUNC                           % USE ANOTHER FUNCTION
124756             CALL PICKYLPAR
124757             IF A><0 THEN X=:B; GO FAR 100ER FI     % OUTSIDE DEVICE LIMITS
124762             A:=D=:X.CDRG                           % FLOPPY DISC ADDRESS
124764          ELSE IF T BIT 3DOUB THEN                  % DOUBLE WORDCOUNT
124767             CALL CHFFUNC                           % USE ANOTHER FUNCTION
124770             CALL PICKXLPAR
124771             %% A=:X.DWONO                          % NOT USED NOW
124771             A:=D=:X.CXRG                           % WORDCOUNT
124773          ELSE
124774             X:=D; CALL PICKLPAR
124776             A=:X.CDRG:=D=:X."FRETURN"
125001          FI; FI; T=:X.CXRG 
125002          B:=X; GO L1; *)FILL                       % B=ADDR OF DATAFIELD
125016   
125016   L1:    IF CTRG/\700 SHZ -6>MAXUNIT GO FAR 173ER  % ILLEGAL UNIT NUMBER
125024          A=:CFLUN
125025   
125025          IF CTRG NBIT 14 AND SFFUN BIT 3FLTI THEN  % NOT STREAMER AND SHORT TIMOUT
125033             SFTIM(101)
125035          ELSE
125036             IF SFFUN/\777=777 THEN SFTIM(100) FI
125045          FI; A-=:TTMR                              % TIMEOUT IN SECONDS
125047          IF "TRNSF"="BFDIS" THEN -1 ELSE -3 FI
125056          A=:TACNS                                  % RETRY COUNTER
125057          X:=CFLUN                                  % X=FLOPPY UNIT NUMBER
125060          IF CTRG/\77 =24 OR A=20 THEN
125070             SHSTAT(X)=:HSTAT; GO FAR FIN           % READ STATUS/LAST STATUS
125073          FI
125073   
125073          IF CTRG BIT 14 GO FAR RWOPER              % STREAMER TAPE
125076   
125076          IF A/\77<2 OR A=43 OR A=44 GO FAR RWOPER  % READ & WRITE
125110   
125110          IF A=13 OR A=15 OR A=16 OR A=47 THEN      % POSITION THE DISC
125124                IF CTRG/\77=13 THEN A:=0 ELSE       % REWIND
125133                   IF A=15 THEN NFDIADR(X)-1 ELSE   % BACKSPACE ONE RECORD
125141                      IF A=47 THEN CXRG ELSE        % SET CURRENT DISC ADDR
125146                         NFDIADR(X)+1               % ADVANCE ONE RECORD
125150                      FI
125150                   FI
125150                FI; T:=A; X:=FDIFORM(X)             % T=NEW FLOPPY DISC ADDR; X=FLOPPY FORMAT NUMBER
125152                X:=LFADDR(X)                        % X=LAST ADDRESS FOR THIS FORMAT
125153                IF CTRG/\77-16=0 THEN X+1 FI        % ADVANCE ONE RECORD
125160                IF T>>=X GO 100ER                   % OUTSIDE DEVICE LIMITS
125162                T=:NFDIADR(CFLUN); GO FIN; *)FILL   % SET NEXT DISC ADDRESS
125176          FI
125176          IF A=40 THEN                              % SELECT FORMAT
125201                IF X:=CXRG>>17 OR LFADDR(X)<0 THEN 174; GO FINER FI    % ILLEGAL FORMAT
125211                CXRG=:FDIFORM(CFLUN); GO FIN
125215          FI
125215          IF A=41 THEN                              % FORMAT FLOPPY
125220                FDIFORM(X) SH 10+CTRG=:CTRG
125224                1=:CXRG; 0=:CDRG; TAD:=CTADRG; X:=CXRG; CALL CFDISK
125232                IF HSTAT BIT 4 THEN 223; GO FINER FI
125237                GO FIN
125240          FI; GO OVER; *)FILL
125243   
125243   FINFDISC:
125243   FIN:   0=:TMR; IF RTRES><0 THEN CALL RTACT FI
125247          CALL ID11; GO ERR22
125251   
125251   173ER:  A:=173; GO FINER
125253   D201ER: D=:B; A:=201; GO FINER
125256   D100ER: D=:B
125257   100ER:  A:=100                                    % OUTSIDE DEVICE LIMITS
125260   FINER:  A=:CERRCODE
125261   EFINER: HSTAT BONE 4=:HSTAT; GO FIN
125265   
125265   OVER:  IF A=42 THEN                              % READ FORMAT
125270                FDIFORM(X) SH 10+CTRG=:CTRG
125274                NFDIADR(X)=:CDRG; 1=:CXRG
125300                TAD:=CTADRG; X:=CXRG; CALL CFDISK
125303                IF HSTAT BIT 4 GO EFINER
125306                IF "TRNSF"="BFDIS" THEN A:=D ELSE A:=DRG FI
125315                A/\17=:FRETURN=:FDIFORM(CFLUN); GO FIN
125322          FI
125322          IF A=12 THEN                              % WRITE EOF
125325                FDIFORM(X) SH 10+CTRG/\177700+5=:CTRG % FUNC=5 =WRITE DELETED RECORD
125333                1=:CXRG; A:=B=:CARG
125337                NFDIADR(X)=:CDRG+1=:NFDIADR(X)
125343                X:=FDIFORM(X); T:=LFADDR(X)         % T=LAST ADDRESS FOR THIS FORMAT
125345                IF CDRG>>T GO 100ER                 % OUTSIDE DEVICE LIMIT
125350                TAD:=CTADRG; X:=CXRG; CALL CFDISK; GO FIN
125354          FI
125354          IF A=46 THEN                              % READ CURRENT DISC ADDR.
125357                NFDIADR(X)=:FRETURN; GO FIN
125362          FI
125362          IF A=54 THEN                              % COPY FLOPPY DISKETTE
125365                CXRG/\3 SHZ 14                      % DESTINATION UNIT
125370                A\/CTRG=:CTRG                       % TO BITS 14-15 IN FUNC.
125372                GO FAR RWOPER
125373          FI
125373          IF A=10 THEN A:=1 ELSE                    % ADVANCE TO EOF
125400             IF A=11 THEN A:=-1 ELSE                % REVERSE TO EOF
125405                IF A=3 GO FIN                       % COMPARE
125410                GO RWOPER; *)FILL                   % ILLEGAL FUNCTION??
125423             FI
125423          FI; A=:FDIMOD
125424          FDIFORM(X) SH 10+CTRG/\177700+2=:CTRG
125432          1=:CXRG; NFDIADR(X)=:CDRG
125436          IF FDIMOD<0 THEN CDRG-1=:CDRG FI
125443          DO                                        % UNTIL EOF IS FOUND OR UNTIL ERROR
125443                X:=FDIFORM(CFLUN); T:=LFADDR(X)     % T=LAST ADDRESS FOR THIS FORMAT
125446                IF CDRG>>T GO FAR 100ER             % OUTSIDE DEVICE LIMITS
125451                X:=CXRG; TAD:=CTADRG; CALL CFDISK
125454                IF HSTAT BIT 4 GO FAR FIN
125457                IF A BIT 5 THEN                     % DELETED RECORD
125461                      IF FDIMOD>0 THEN A+CDRG=:CDRG FI
125466                      GO OUT
125467                FI; CDRG+FDIMOD=:CDRG
125472          OD
125473   OUT:   CDRG=:NFDIADR(CFLUN)
125476          HSTAT BZERO 4=:HSTAT; GO FAR FIN
125502   *)FILL
125506   
125506   % READ AND WRITE FUNCTIONS
125506   
125506   RWOPER:IF CTRG NBIT 14 THEN                      % IF NOT STREAMER
125511             FDIFORM(X) SH 10+CTRG=:CTRG
125515             X:=FDIFORM(X); T:=LFADDR(X)            % T=LAST ADDRESS FOR THIS FORMAT
125517             IF CDRG+CXRG>>T GO FAR 100ER           % OUTSIDE DEVICE LIMIT
125523          FI; TACNS=:TACOUNT
125525          FOR TACOUNT DO
125525             AD:=MEMAD=:CMADR; X:=CXRG; TAD:=CTADRG; CALL CFDISK
125532             IF CTRG/\77=43 THEN                 % DELETED RECORD
125537                IF HSTAT NBIT 5 THEN 231; GO FAR FINER FI  % ERROR, NOT DELETED RECORD
125544             ELSE
125545                IF HSTAT BIT 5 THEN 3; GO FAR FINER FI     % ERROR: END-OF-FILE
125552             FI; IF HSTAT NBIT 4 GO FAR FIN
125555          OD; GO FAR FIN
125560   
125560   CFDISK: TAD=:TADRG; X=:XRG; A:=L=:"CFLRG"
125564   FLV1STFL: TTMR=:TMR          % RESTARTED HERE FROM RT-PROG WHEN I/O FLOPPY (OLD FLOPPY)
125566          DO
125566                X:=XRG; TAD:=TADRG
125570                CALL TRNSF; GO ERROR; GO BUSY; GO FINISH
125574   FDIBUS:      CALL ID11                                     % RETURN HERE WHEN BUSY
125575          OD
125576   
125576   % SAVED FOR EACH ERROR RETURN FROM DRIVER
125576   INTEGER LEHSTAT                        % HSTAT WHEN LAST ERROR RETURN FROM DRIVER
125577   INTEGER LETREG                         % T-REG WHEN LAST ERROR RETURN FROM DRIVER
125600   INTEGER LEAREG                         % A-REG WHEN LAST ERROR RETURN FROM DRIVER
125601   INTEGER LEDREG                         % D-REG WHEN LAST ERROR RETURN FROM DRIVER
125602   INTEGER ECTRG,ECARG,ECDRG,ECXRG        % CALLING PROGRAMS REGISTERS WHEN ERROR OCCURES
125606   TRIPLE LETAD=LETREG,FECTREG=ECTRG
125606   
125606   BUFDISC: X BONE 6; GO FDIFEIL                              % TIMEOUT
125610   
125610   FDIFEIL: X BONE 4=:HSTAT=:LEHSTAT                % RETURN HERE WHEN ERROR
125613          TAD=:LETAD:=CTADR=:FECTREG; CXRG=:ECXRG
125620          HSTAT=:SHSTAT(CFLUN)
125623          A\/AERRB=:AERRB; MIN ERCNT; 0/\0
125627          GO CFLRG
125630   
125630   FDIFIN: X=:HSTAT                                 % RETURN HERE WHEN FINISHED
125631          A:=X=:SHSTAT(CFLUN)
125634          GO CFLRG
125635   
125635   RBUS
125645   
125645   *"8DBUG
"125645   
125645   %
125645   *"8DLP1+8DLP2+8DVE1+8DVE2
"125645   
125645   @LIB CXCPU-,
125645   %==============================================================================
125645   % 39.10      M 8 8 T E R M
125645   %
125645   SUBR M8OTERM,M8OINDV
125645   DISP -1; INTEGER MN1; PSID
125645   INTEGER K377:=377,CBHOLD=?
125646   M8OTERM: 0=:D; IF CFREE-10<0 GO WDX
125653   M88FELLS: 0=:CBHOLD
125654          T:=BUFST; X:=FYLLE; IF X NBIT "0" GO EVEN
125660          *IRR ALEVB DA
125661          IF A SHZ -10=0 GO OKRET; *SBYT
125664          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125673          *IRR ALEVB DA
125674          IF A/\K377=0 GO OKRET; *SBYT
125677          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125706          *IRR ALEVB DD
125707          IF A SHZ -10=0 GO OKRET; *SBYT
125712          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125721          *IRR ALEVB DD
125722          IF A/\K377=0 GO OKRET; *SBYT
125725          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125734          *IRR ALEVB DL
125735          IF A SHZ -10=0 GO OKRET; *SBYT
125740          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125747          *IRR ALEVB DL
125750          IF A/\K377=0 GO OKRET; *SBYT
125753          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125762          *IRR ALEVB DX
125763          IF A SHZ -10=0 GO OKRET; *SBYT
125766          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
125775          *IRR ALEVB DX
125776          IF A/\K377=0 GO OKRET; *SBYT
126001          MIN CBHOLD; D-1; X+1; IF MAX=X THEN X:=0 FI
126010   OKRET: X=:FYLLE; CFREE+D=:CFREE; BHOLD+CBHOLD=:BHOLD
126017   GORET: *IRR ALEVB DT; IOF
126021          IF A>177 AND A<300 GO FAR RETINDV
126027          CALL STDEV; GO MOURET
126031   *)FILL
126035   
126035   INTEGER CBHOLD
126036   EVEN:  A:=X SHZ -1+T=:X; MAX SHZ -1+T=:L
126046          *IRR ALEVB DA
126047          D:=0; AD SHZ -10; IF A=0 GO GORET; IF D=0 GO L1
126054          *IRR ALEVB DA
126055          A=:X.S0; IF X+1=L THEN X:=BUFST FI
126062          *IRR ALEVB DD
126063          D:=0; AD SHZ -10; IF A=0 GO L2; IF D=0 GO L3
126070          *IRR ALEVB DD
126071          A=:X.S0; IF X+1=L THEN X:=BUFST FI
126076          *IRR ALEVB DL
126077          D:=0; AD SHZ -10; IF A=0 GO L4; IF D=0 GO L5
126104          *IRR ALEVB DL
126105          A=:X.S0; IF X+1=L THEN X:=BUFST FI
126112          *IRR ALEVB  DX
126113          D:=0; AD SHZ -10; IF A=0 GO L6; IF D=0 GO L7
126120          *IRR ALEVB DX
126121          A=:X.S0; A:=X-BUFST SHZ 1+1=:X; T:=10
126130   FELLS: BHOLD+T=:BHOLD; CFREE-T=:CFREE
126136          IF X+1=MAX THEN X:=0 FI; X=:FYLLE
126144          GO GORET
126145   L1:    A=:T:=X-BUFST SHZ 1=:X:=T; T:=BUFST; *SBYT
126155          T:=1; GO FELLS
126157   L2:    A:=X-BUFST SHZ 1-1=:X; T:=2; GO FELLS
126166   L3:    A=:T:=X-BUFST SHZ 1=:X:=T; T:=BUFST; *SBYT
126176          T:=3; GO FELLS
126200   L4:    A:=X-BUFST SHZ 1-1=:X; T:=4; GO FELLS
126207   L5:    A=:T:=X-BUFST SHZ 1=:X:=T; T:=BUFST; *SBYT
126217          T:=5; GO FELLS
126221   L6:    A:=X-BUFST SHZ 1-1=:X; T:=6; GO FELLS
126230   L7:    A=:T:=X-BUFST SHZ 1=:X:=T; T:=BUFST; *SBYT
126240          T:=7; GO FELLS
126242   *)FILL
126242   
126242   M8OINDV: IF "IOTRANS"><"IPTCH" GO M88IWORD
126246          DFOPP=:B; 0=:D
126251          IF CFREE-10<0 THEN
126254   NOSPACE:     DFOPP=:B; GO WDX
126257          FI; GO FAR M88FELLS
126260   @ELIB
126260   @LIB CXCPU
126260   M8IDRET:
126260   RETINDV: IF X:=FYLLE=0 THEN X:=MAX FI; X-1; T:=BUFST; *LBYT
126267   INDRET: A=:CHARI; DFOPP=:B; CALL STDEV; GO MOURET
126274   
126274   M88IWORD:  DFOPP=:B; CFREE=:D; IF A-4<0 GO NOSPACE
126302          BUFST+FYLLE=:X; MAX+BUFST=:L; *IRR ALEVB DA
126311          IF A=0 THEN DFOPP=:B; GO MOURET FI
126315          A=:X.S0; IF X+1=L THEN X:=BUFST FI; D-1; MIN BHOLD; *IRR ALEVB DD
126325          IF A=0 GO NOMORE; A=:X.S0; IF X+1=L THEN X:=BUFST FI
126333          D-1; MIN BHOLD; *IRR ALEVB DL
126336          IF A=0 GO NOMORE; A=:X.S0; IF X+1=L THEN X:=BUFST FI
126344          D-1; MIN BHOLD; *IRR ALEVB DX
126347          IF A=0 GO NOMORE; A=:X.S0; IF X+1=L THEN X:=BUFST FI
126355   NOMORE: A:=X-BUFST=:FYLLE; A:=D=:CFREE
126362          IF X=BUFST THEN X:=L FI; X.MN1; GO INDRET
126370   
126370   RBUS
