115054          IF X=#29 THEN 9ESSAVTAD; A=:ERPREG; 9EXREG=:N1 ELSE T:=RTREF FI; T=:RTPROG
115066          IF ERNUM=#90 OR =#91 THEN 9EDREG=:ERPREG FI
