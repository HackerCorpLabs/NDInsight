       $NAM O;0;BUF;200;0;0;200;0;0;0;200;0;177;0
%%XBU=BUF+200;)KILL BUF;BUF=XBU;)KILL XBU

$NAM O, 0;0;*-2;110000;0;0;IORES;PUTDW;OSTDV;CEXIT;$NAM I;0
]
