072731   *5PF1=*
072731   *5PF2=*
072731   *5PF3=*
072731   *N500S=*
072731   *5MCST=*
072731   *ESC50=*
072731   *NW5ST=*
072731   *EXIT
072732   *ESC5O=*
072732   *CH5MX=*
