"123613   
123613   %==============================================================================
123613   % 34.3       M C 1 4 4
123613   %
123613   %
123613   % CALL MAGTP(FUNC,CORAD,LOG.DEV,MAXWORDS,READWORDS)
123613   % ENTRY: B=DF-DATAFIELD
123613   %       PARAMETERS ARE IN DATAFIELD
123613   % EXIT: A=0 IF OK
123613   %
123613   SUBR PT3MC144,RMAGT
123613   
123613   % VARIABLES IN I/O DATAFIELD:
123613   
123613   DISP 25; INTEGER CASUN; PSID           % DEVICE UNIT NUMBER
