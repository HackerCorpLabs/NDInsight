127121          X:=1; IF T><0 GO BBREK; CALL IONIOF      
127125          CALL TDGET; GO GORET; A\/CCHAR; *IRW ALEVB DA;
127131          X+1; IF T><0 GO BBREK; CALL IONIOF
127135          CALL TDGET; GO GORET; A SHZ 10=:CCHAR; *IRW ALEVB DD;
127142          X+1; IF T><0 GO BBREK; CALL IONIOF
127146          CALL TDGET; GO GORET; A \/CCHAR; *IRW ALEVB DD;
127152          X+1; IF T><0 GO BBREK; CALL IONIOF
127156          CALL TDGET; GO GORET; A SHZ 10=:CCHAR; *IRW ALEVB DL;
127163          X+1; IF T><0 GO BBREK; CALL IONIOF
127167          CALL TDGET; GO GORET; A\/CCHAR; *IRW ALEVB DL;
127173          X+1; IF T><0 GO BBREK; CALL IONIOF
127177          CALL TDGET; GO GORET; A SHZ 10=:CCHAR; *IRW ALEVB DX;
127204          X+1; IF T><0 GO BBREK; CALL IONIOF
127210          CALL TDGET; GO GORET; A\/CCHAR; *IRW ALEVB DX;
127214          X+1; IF T><0; GO BBREK; CALL IONIOF
127220   GORET: A:=X; *IRW ALEVB DT
127222          GO MOURET
