121203          X:="SVPT3"
121204          DO WHILE B><0; DOU0=:X.DOU0; X+2; B+2; OD
121213          FOR X:=-2000 DO; OD                       % DELAY BEFORE STOP
121215   PWAIT: *WAIT; JMP *
121217   
121217   
