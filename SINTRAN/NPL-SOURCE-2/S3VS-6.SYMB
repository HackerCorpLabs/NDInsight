075351   *DIA1, 0;0;*-2;2;0;0;APLRS;*20/
075400   *DIA2, 0;0;*-2;2;0;0;APLRS;*20/
075427   *DSI0, 0;0;*-2;2;*15/
075450   *DSI1, 0;0;*-2;2;*15/
075471   *DSI2, 0;0;*-2;2;*15/
075512   
