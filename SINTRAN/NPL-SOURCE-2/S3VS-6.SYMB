072371   %==============================================================================
072371   % 35.36      B I O A C C O U N T
072371   %
072371   %% BLOCK I/O ACCOUNTING ROUTINE
072371   %% ROUTINE CALLED FROM PAGE-TRANSFER ROUTINE IN FILE-SYSTEM-RESIDENT PART
072371   INTEGER RWRT1=?,RWRT2=?
072371   INTEGER DF1=?,DF2=?
072371   SUBR BIOACCOUNT
072371   
072371   BIOACCOUNT:
072371   *"-8IOAC
"072371          IF BACKGROUND >< 0 AND ACCFLAG ><0 THEN   % BACKGROUND-ACCOUNTING ON
072375                   A:=CURPROG; GO SUITE
072377                FI
072377                IF RTACCFLAG = 0 THEN EXIT; FI      % RT-ACCOUNTING OFF
072402                IF CURPROG = "RWRT1" THEN A:="DF1".SSREF; GO SUITE; FI
072411                IF         = "RWRT2" THEN A:="DF2".SSREF; GO SUITE; FI
072417                EXIT
072420   SUITE:       A-RTSTART=:D:=0;T:=5RTSIZE;*RDIV ST
072425                A SHZ 1 + "IOACTAB"=:X
072430                *PIOF
072431                MIN X.S1;GO RETU; MIN X.S0; 0/\0
072435   RETU:        *PION
072436                EXIT
072437   *"
