121414             PCCS(X); *TRR PCR
121416          OD
121420          IF PIDREG><0 THEN       %AFTER POWER FAIL
121422   % RESTORE PIT ENTRIES FOR RT'S SYSTEM SEGMENT.
121422             IF BACKGROUND=0 THEN CALL SETRT FI
121425             SEGMA; CALL RSPTABL; SEGMB; CALL RSPTABL; SEGMC; CALL RSPTABL
121433   *"8XMSG
"121433   % RESTORE PIT ENTRIES FOR SEGMENT #33
121433             IF "SG33".FLAG BIT 5FIX THEN
121437                X:=X.BPAGLINK; T:=CORMBANK
121441                DO WHILE X><0
121442                   *LDATX DALOG
121443                   A/\77 SH 1+177600=:B
121447                   *LDDTX DPGPR
121450                   A BONE 5WIP; AD=:DOU0
121452                   *LDXTX DPAGL
121453                OD
121454             FI
121454   *"                
"121454   % RESTORE PIT ENTRIES FOR PIT3-SEGMENT
121454             X:="SG41".BPAGLINK; T:=CORMBANK
121457             DO WHILE X><0
121460                *LDATX DALOG
121461                A/\77 SH 1+177600=:B
121465                *LDDTX DPGPR
121466                AD=:DOU0
121467                *LDXTX DPAGL
121470             OD
121471   
121471   % RESTORE WINDOW ENTRIES IN PAGE TABLE 3
121471             B:=-10                                 % B:=177770
121472             X:="SVPT3"
121473             DO WHILE B><0; X.DOU0=:DOU0; B+2; X+2; OD
121502             CURPROG.ACTPRI /\3773; *TRR PCR
121506             "ERR14"=:LEV14
121510          FI
121510          CALL TBUSPEED
121511          GO CLADV
121512   *)FILL
