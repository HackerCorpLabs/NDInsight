072733   
072733   %==============================================================================
072733   %  36.1      G E T 0   G E T 1   G E T 2   G E T 3   G E T 4
072733   %            G E T 5   G E T S 2
072733   
072733   % SUBROUTINES TO GET PARAMETER VALUES FROM USER
072733   % ENTRY:     B=PARAMETER LIST
072733   %            X=WORKING AREA
072733   % RETURN:    X=B=WORKING AREA
072733   % RT LEVEL
072733   
072733   SUBR GET0,GET1,GET2,GET3,GET4,GET5,GET6,GETS2
072733   DISP 0; DOUBLE POINTER DP1=P1; DOUBLE DD1=D1; PSID
072733   GETS2: DP1; *BSET ZRO 0; STD DD1,X; BSET ONE 0; JMP GET1
072740   GET6:  P5; *BSET ZRO 0; STA D5,X; BSET ONE 0
072744   GET5:  P4; *BSET ZRO 0; STA D4,X; BSET ONE 0
072750   GET4:  P3; *BSET ZRO 0; STA D3,X; BSET ONE 0
072754   GET3:  P2; *BSET ZRO 0; STA D2,X; BSET ONE 0
072760   GET2:  P1; *BSET ZRO 0; STA D1,X; BSET ONE 0
072764   GET1:  P0; *BSET ZRO 0; STA D0,X; BSET ONE 0
072770   GET0:  X=:B; *PIOF
072772          IF BACKGROUND><0 THEN L=:D;*PION
072776                CALL XBMRET; D=:L; *POF
073001          FI
073001          RTREF.ACTPRI/\177177=:X.ACTPRI/\3773; B=:X; *TRR PCR
073010          MLEV; *MCL PIE; TRA PGS; PION
073014          EXIT
073015   RBUS
073022   
073022   
073022   
073022   %==============================================================================
073022   % 36.2       P M T R A N S
073022   
073022   DOUBLE SWPCOREADR,SWPMASSADDR
073026   INTEGER SWPMTMODUS,SWPBLPAGE
073030   INTEGER SWPPARLIST:=(SWPMTMODUS,SWPCOREADR,SWPMASSADR,SWPBLPAGE)
073034   
073034   SUBR PMTRANS
073034   INTEGER POINTER LREG
073035   PMTRANS: T:=L=:"LREG"; CALL MTRANS; *POF
073041          GO LREG
073042   RBUS
073042   
073042   SUBR PAGEFAULT,PAGE2FAULT,PWFAIL,RESYS,COLDSTART
073042   RBUS
073042   
073042   %==============================================================================
073042   % 36.3       P P A G E F A U L T   P 2 P A G E 2 F A U L T
073042   %            P P W F A I L   P R E S Y S
073042   %            P C O L D S T A R T
073042   
073042   SUBR PPAGEFAULT,P2PAGE2FAULT,PPWFAIL,PRESYS,PCOLDSTART
073042   PPAGEFAULT: *POF
073043          GO PAGEFAULT
073044   P2PAGEFAULT: *POF
073045          GO PAGE2FAULT
073046   PPWFAIL: *PIOF
073047          GO PWFAIL
073050   PRESYS: *PIOF
073051          GO RESYS
073052   PCOLDSTART: *PIOF
073053          GO COLDSTART
073054   RBUS
073061   
073061   %============================================================================
073061   % 36.4       A T R A N S      X T R A N S    D B T R A N S
073061   %
073061   % SUBROUTINE TO TRANSFORM ADDRESSES TO WINDOW ADDRESSES
073061   % CALLED FROM BLOCK MONITOR CALLS (MAGTP,RFILE,..) AND XMSG
073061   % RT LEVEL
073061   %
073061   % ATRANS:    PAGING/INTER. STATUS. ON CALL: UNDEFINED, RETURN: PION
073061   % ENTRY:     A=USER ADDRESS,  X=BUFFER ADDRESS, D=CALLING RT-PROGRAMS ACTPRI
073061   % RETURN:    A=WINDOW ADDRESS, X=BUFFER WINDOW
073061   %
073061   % DBTRANS:   PAGING/INTERRUPT STATUS AS FOR ATRANS.
073061   % ENTRY:     AS FOR ATRANS BUT T-REG MUST CONTAIN NO. OF BANK IN WHICH BUFFERS LIE.
073061   % EXIT:      AS FOR ATRANS.
073061   
073061   % XTRANS:    PAGING/INTER. STATUS MUST BE PIOF WHEN CALLING XTRANS (AND RETURN)
073061   % ENTRY:     AS ATRANS, BUT T=BANK NO OF BUFFER (0 TO 3)
073061   % RETURN:    AS ATRANS
073061   
073061   SUBR ATRANS,XTRANS,DBTRANS
073061   INTEGER TREG,AREG,DREG,XREG; REAL TADREG=TREG
073065   DOUBLE POINTER BPG:=177000+5BFPAGE+5BFPAGE
073066   DOUBLE POINTER WND0:=177174,WND1:=177176
073070   INTEGER C5BFPAGE(0); *5BFPA@12                   % "5BFPA*2000"
073071   
073071   XTRANS: X=:XREG
073072   FELLS: TAD=:TADREG; 600/\D SHZ -1; T:=AREG SHZ -12\/A % USER LOG PAGE
073101          XREG/\176000=:D:=TREG; AD SHZ -2
073106   @LIB CXCPU-,
073106          T\/D=:RTREF.WINDOW
073111          T SHZ -10=:D; A:=162000; AD=:BPG
073115          X.WINDOW/\377=:WIND1 SH 1+177000=:X
073123          AD:=X.DOU0=:WND0; X+2
073126          IF X<0 THEN AD:=X.DOU0 ELSE A:=0 FI; AD=:WND1
073134          T:=174000
073135   @ELIB
073135   @LIB CXCPU
073135          1777/\XREG\/C5BFPAGE=:X                   % LOG. ADDR OF SYSTEM BUFFER
073141          1777/\AREG\/T=:AREG                       % LOG. ADDR OF USER BUFFER
073145          TAD:=TADREG; EXIT
073147   
073147   INTEGER ATSAV,ALSAV,BANKSAV                      % SAVE LOCATIONS FOR ATRANS AND DBTRANS
073152   DBTRANS:
073152            *PIOF
073153            T=:ATSAV=:BANKSAV                       % BANK IN WHICH DEVICE BUFFERS LIE.
073155   @LIB CXCPU
073155   @LIB CXCPU-,
073155            GO COMM
073156   @ELIB
073156   
073156   ATRANS:  *PIOF
073157            T=:ATSAV:=0=:BANKSAV                    % BANK 0
073162   COMM:    X=:XREG:=L=:ALSAV
073165            CALL FELLS; T:=ALSAV=:L:=ATSAV; *PION  % RESTORE REGISTERS
073172          EXIT
073173   RBUS
073204   
073204   
073204   %==============================================================================
073204   %
073204   %                S E G M E N T  M O N I T O R  C A L L S
073204   %
073204   %==============================================================================
073204   % 36.5       M C A L L   M E X I T
073204   
073204   % MONITOR CALLS MCALL AND MEXIT - TO CHANGE SEGMENTS
073204   % APPL. LEVEL
073204   
073204   SUBR MCALL,MEXIT,0LEGSEG,LEGSEG,R15ERRD,RLEGSEG
073204   
073204   DISP 0; DOUBLE MSTADR; PSID
073204   DISP 0; INTEGER MSEGM=D0; PSID
073204   INTEGER STRA,LA,STRB,LB,MSEGA,MSEGB
073212   INTEGER POINTER LREG
073213   
073213   MCALL: T=:B; MSTADR; CALL ALTOFF; T:=X.ZPREG=:X.ZLREG
073220          A=:X.ZPREG:=D=:X.MSEGM; CALL GET0; GO MMC
073225   
073225   MEXIT: CALL GET0; ZLREG=:ZPREG; T=:MSEGM
073231   MMC:   RTREF.ACTSEG=:ZTREG
073234          IF MSEGM SHZ -10=377 THEN X.ACTSEG SHZ -10 FI
073243          A=:MSEGA; CALL DECO; A=:STRA; T=:LA; X:=RTREF
073250          IF MSEGM/\377=377 THEN X.ACTSEG/\377 FI
073257          A=:MSEGB; CALL DECO; T=:LB
073262   %CHECK FOR OVERLAP:
073262          IF A>STRA THEN IF A-LA<T GO ERRO
073270          ELSE IF A+LB>T GO ERRO
073274          FI
073274          MSEGA SH 10+MSEGB=:RTREF.ACTSEG
073301          GO RETSTUPR
073302   ERRO:  MSEGA SH 10+MSEGB; CALL 9ERRA(#42); GO RETXIT  % OVERLAP
073310   
073310   % DECODE SEGMENT ELEMENT
073310   % ENTRY: A=SEGMENT NUMBER; X=RTREF
073310   % EXIT:  A=FIRST LOGICAL PAGE IN SEGMENT; T=NUMBER OF PAGES IN SEGMENT
073310   DECO:  IF A=0 THEN T:=0; EXIT FI
073313          T:=L=:"LREG"; IF A=X.RSEGM GO ERRIL
073320          CALL LEGSEG; *POF
073322          CALL SHRSOVERLAP; *PON
073324          T:=X.LOGADR SHZ -10; X.LOGADR/\377
073330          GO LREG
073331   
073331   % SUBROUTINE TO CHECK FOR LEGAL SEGMENT
073331   % ENTRY:     A=SEGMENT NUMBER
073331   % EXIT:      A=SEGMENT FLAG; D=SEGMENT NUMBER; X=SEGMENT TABLE ADDRESS
073331   % RETURN TO RETXIT IF ERROR
073331   
073331   0LEGSEG: IF A=0 GO ERRIL
073332   LEGSEG:  IF A>>X:=SGMAX GO ERRIL
073335            A=:D*5SEGSIZE+SEGSTART=:X
073341            IF X.FLAG=0 OR A BIT 5INHB GO ERRNL
073345            EXIT
073346          
073346   R15ERRD:
073346   ERRIL: CALL 9ERRA(#15); GO RETXIT                % ILL.SEGM.NO.
073351   ERRNL: A:=D; CALL 9ERRA(#16); GO RETXIT          % SEGMENT NOT LOADED
073355   
073355   % CHECK FOR LEGAL SEGMENT NUMBER IN MON REENT/SREENT CALLED FROM BACKGROUND
073355   % PROGRAMS. ONLY SEGMENTS ON PIT 1 AND PIT 2 WITH PROTECTION RING ZERO
073355   % IS LEGAL
073355   %
073355   RLEGSEG: IF BACKGROUND><0 AND OLDPAGE/\3=0 THEN
073362                IF X.LOGADR/\300><100 AND A><200 GO ERRIL
073372                IF X.FLAG/\3><0 GO ERRIL
073375            FI; EXIT
073376   RBUS
073420   
073420   %==============================================================================
073420   % 36.6       M F I X   M U N F I X
073420   
073420   %MONITOR CALLS: CALL FIX(SEGNO),CALL UNFIX(SEGNO)
073420   SUBR MOFIX,MUNFIX
073420   DISP 0; INTEGER SGADR=D1,OLDSGNO=D2; PSID
073420   
073420   MOFIX: CALL GET1; D0; CALL 0LEGSEG
073423          IF A BIT 5DEMAND GO ERRD
073425          IF A BIT 5FIX GO RET
073427          IF X.LOGADR SHZ -10=0 GO ERRNL
073432          IF A+FIXPAGES>FIXMAX GO ERRF
073436          A=:FIXPAGES; X=:SGADR
073440          RTREF.ACTSEG=:OLDSGNO; D0=:X.ACTSEG
073445          "STUPR"; *IRW MLEVB DP
073447          MLEV; *MST PID; MST PIE
073452   %RETURN WITH CHANGED SEGMENT
073452          MLEV; *MCL PIE
073454          OLDSGNO=:X.ACTSEG    %CHANGE BACK
073456          SGADR.FLAG BONE 5FIX=:X.FLAG
073462          X=:L:="BSEGLINK"
073464   LOOP:  X=:D:=X.SEGLINK; IF X=-1 THEN CALL ERRFATAL FI
073472          IF X><L GO LOOP
073474          X.SEGLINK; 0=:X.SEGLINK; A=:D.SEGLINK
073500          GO RETSTUPR
073501   
073501   MUNFIX: CALL GET1; IF D0=0 OR A>>SGMAX GO ERRIL
073507          A*5SEGSIZE+SEGSTART
073511          IF A.FLAG BIT 5FIX THEN
073515                A BZERO 5FIX=:X.FLAG
073517                377; T:=X.LOGADR SHZ -10/\A; FIXPAGES-T=:FIXPAGES; IF <0 GO ERRF
073527                IF X.SEGLINK><0 THEN CALL ERRFATAL FI
073532                BSEGLINK=:X.SEGLINK; X=:BSEGLINK
073535          FI; GO RET
073536   
073536   ERRNL: D0; CALL 9ERRA(#16); GO RETXIT    % EMPTY SEGMENT (NOT LOADED)
073542   ERRD:  D0; CALL 9ERRA(#17); GO RETXIT    % FIXING DEMAND
073546   ERRF:  D0; CALL 9ERRA(#18); GO RETXIT    % TOO MANY FIXED
073552   ERRIL: D0; CALL 9ERRA(#15); GO RETXIT    % ILLEGAL SEGMENT NUMBER
073556   RBUS
073576   
073576   %==============================================================================
073576   % 36.7       W S E G   -   W S E G X
073576   
073576   % MONITOR CALL: CALL WSEG(SEGNO) - WRITE BACK SEGMENT
073576   SUBR WSEG,WSEGX
073576   
073576   INTEGER SG,SGA
073600   INTEGER POINTER CRETADR
073601   
073601   WSEG:  CALL GET1
073602          "RET"=:"CRETADR"
073604          D0=:SG; CALL 0LEGSEG; X=:SGA
073610   FELLS: *POF
073611          CALL SRESER; *PON
073613          "MWSEG"; *IRW MLEVB DP
073615          MLEV; *MST PID; MST PIE
073620   
073620   %MONITOR LEVEL:
073620   MWSEG: X:=RTREF=:SRTREF
073622          IF SGA.FLAG=0 OR A BIT 5INHBT THEN
073627             SG; CALL 9ERR(#16); GO BRTEXT
073633          FI; A BZERO 5OK=:X.FLAG; X=:B=:SEGREF:=SRTREF
073640          *POF
073641          A:=B; CALL CSEGS; 1=:NUMBER; CALL TRNSEG
073646          X:=SRTREF; CALL ZSRELES; "OUT"; *PON
073652          IF X=CURPROG THEN
073655             *IRW ALEVB DP
073656          ELSE
073657             X:=X.RTDLGADDR; T:=0; *STATX XTDPR
073662          FI; GO STUPR
073663   %RT LEVEL:
073663   OUT:   GO CRETADR
073664   
073664   % CALLED FROM PSPLREE IN POF
073664   % ENTRY:     A=SEGMENT NUMBER
073664   %            X=ADDRESS OF SEGMENT TABLE ENTRY
073664   %
073664   
073664   INTEGER POINTER WSEGL
073665   WSEGX: A=:SG:=L=:"WSEGL":="WSEG1"=:"CRETADR"; X=:SGA; GO FELLS
073674   WSEG1: GO WSEGL
073675   RBUS
073717   
073717   %==============================================================================
073717   % 36.8       R E E N T 
073717   
073717   % MONITOR CALL REENT(SEGNO) - ATTACH REENTRANT SEGMENT
073717   SUBR REENT,IMREENT
073717   DISP 0; INTEGER RESEG=D1; PSID
073717   
073717   REENT: CALL GET1; *POF
073721   IMREENT:  CALL XCSEGS
073722          IF D0><0 THEN
073724             CALL LEGSEG
073725             X=:RESEG; IF A NBIT 5DEMAND GO ERRD
073730             IF X=NSEGA OR X=NSEGB GO RETSTUPR
073736             CALL RLEGSEG
073737             T:=D0; NSEGA.FLAG; CALL SHRSOVERLAP
073743             T:=D0; NSEGB.FLAG; CALL SHRSOVERLAP
073747             NSEGA; T:=RESEG; CALL OVERLAP
073752             NSEGB; T:=RESEG; CALL OVERLAP
073755          FI
073755          X:=RTREF; CALL CLRBMAP
073757   OUT:   RTREF.RSEGM/\177400+D0=:X.RSEGM; GO RETSTUPR
073765   
