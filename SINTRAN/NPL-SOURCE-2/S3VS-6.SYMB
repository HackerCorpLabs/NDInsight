126774   SUBR NN310      
126774   INTEGER CCHAR,BR310
126776   BRCNN: IF DFLAG BIT 5SPEC THEN 1=:BR310; EXIT FI; EXITA
127005   NN310: 0=:BR310; *POF
127007          CALL IOTRANS; GO WDX; A SHZ 10=:CCHAR; *IRW ALEVB DA;
127014          X:=1; CALL BRCNN; GO GORET
127017          CALL IOTRANS; GO GORET; A\/CCHAR; *IRW ALEVB DA;
127023          X+1; CALL BRCNN; GO GORET
127026          CALL IOTRANS; GO GORET; A SHZ 10=:CCHAR; *IRW ALEVB DD;
127033          X+1; CALL BRCNN; GO GORET
127036          CALL IOTRANS; GO GORET; A \/CCHAR; *IRW ALEVB DD;
127042          X+1; CALL BRCNN; GO GORET
127045          CALL IOTRANS; GO GORET; A SHZ 10=:CCHAR; *IRW ALEVB DL;
127052          X+1; CALL BRCNN; GO GORET
127055          CALL IOTRANS; GO GORET; A\/CCHAR; *IRW ALEVB DL;
127061          X+1; CALL BRCNN; GO GORET
127064          CALL IOTRANS; GO GORET; A SHZ 10=:CCHAR; *IRW ALEVB DX;
127071          X+1; CALL BRCNN; GO GORET
127074          CALL IOTRANS; GO GORET; A\/CCHAR; *IRW ALEVB DX;
127100          X+1; CALL BRCNN; GO GORET
127103   GORET: A:=X; IF X:=BR310><0 THEN A BONE 17 FI; *IRW ALEVB DT
127110          GO MOURET
