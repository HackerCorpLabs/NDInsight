131141          304; T:=X2DHD+XWRTC; *EXR ST              % TAKE CARE OF MODEM STATUS 
131145          CALL STORE
131146   
131146   %
131146   %
131146   %      LEAVE X21
131146        
131146   X21RT: IF X2DMP.X2MFA BIT X21C1 THEN 1=:X2DCC FI % MARK IF CHARGING REQUEST
131154          IF X2DCC = 2 THEN 0=:X2DCC FI             % WILL NOT SAVE OLD CHARGING
131161          X21OP=:X2DUI.HXDOK=:X2DUO.HXDOK             % OPEN LOCK IN USER DRIVER
131166          X2FOK; CALL X21UT
