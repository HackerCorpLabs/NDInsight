117757   % 37.14      T R N S E G  R W S E G M  X T R N S E G
117757   
117757   %SUBROUTINE TO READ OR WRITE PAGES OF A SEGMENT; NUMBER=-NEEDED PAGES
117757   % ENTRY:     A=READ/WRITE FLAG, B=SEGMENT
117757   %RETURN WITH A=0 IF NO TRANSFER HAS BEEN DONE
117757   
117757   SUBR TRNSEG,RWSEGM,XTRNSEG,INRWSEGM
117757   
117757   INTEGER WRITTEN=?,MODUS=?,CNUMBER=?,LMASSNO=?,XREG=?,XREG2=?,BREG=?,CABLPAGE=?
117757   DOUBLE BLSTX=?
117757   INTEGER POINTER LREG
117760   
117760   % ENTRY: D=NUMBER OF PAGES TO TRANSFER
117760   %        X=CORMAP ELEMENT OF FIRST PAGE TO TRANSFER
117760   %        A=READ/WRITE FLAG
117760   %        B=SEGMENT ADDRESS
117760   %
117760   XTRNSEG: A=:MODUS:=RTREF=:SRTREF:=D; 0=:WRITTEN; CALL RWSEGM
117766          GO PSTUPR
117767   
117767   
117767   TRNSEG: A=:MODUS:=L=:"LREG"; X=:XREG
117773          0=:WRITTEN; NUMBER=:CNUMBER; X:=BPAGLINK
117777          FOR CNUMBER DO WHILE X><0
120000             T:=CORMBANK; *LDATX DPGPR
120002             IF A=:D/\160000\/MODUS=0 OR MODUS SHR 5WIP/\D><0 THEN
120012                1; CALL RWSEGM
120014             FI; T:=CORMBANK; *LDXTX DPAGL
120016          OD
120020          IF WRITTEN><0 THEN X:=SRTREF; LMASSNO; CALL RELEASE FI
120025          WRITTEN; X:=XREG; GO LREG
120030   *)FILL
120040   
120040   INTEGER WRITTEN,MODUS,CNUMBER,LMASSNO,XREG,XREG2,BREG,CABLPAGE,NPAGES,BMASS
120052   INTEGER POINTER LREG2
120053   DOUBLE BLSTX
120055   
120055   RWSEGM: A=:NPAGES:=L=:"LREG2":=B=:BREG; X=:XREG2
120063          IF WRITTEN=0 THEN
120065             MADR SHZ -16; MASSUNIT(A) SH 6+MODUS+60=:SWPMTMODUS
120075             ABLPAGE(X)=:CABLPAGE*NPAGES=:SWPBLPAGE
120101             X=:T+X; DBLST(X)=:BLSTX; X:=T
120106             IF D=0 AND A=0 THEN CALL ERRFATAL FI
120112             MASSNO(X)=:LMASSNO; CALL LOGPH; A=:BMASS=:B
120117             X:=SRTREF; CALL BRESERVE
120121             IF A<0 THEN
120122                IF SWPFLAG><0 THEN
120124                   BMASS=:B; GO LNK1SWAP
120127                FI; 5CLOAD; CALL RELEASE
120131                IF X=RTREF GO PRWAIT; GO PSTUPR; *)FILL
120156             FI; MIN WRITTEN; BREG=:B
120161          FI; T:=CORMBANK; X:=XREG2; *LDATX DALOG
120164          A=:D:=LOGADR/\377; D-A; MADR/\37777+D*CABLPAGE=:L
120175          BLSTX; D+L; A:=A+C; AD=:SWPMASSADR
120201          *LDATX DPAGP
120202          D:=0; AD SHZ -6=:SWPCOREADR
120205   *"8SWLG
"120205          A:=BMASS=:B:="SWPPARLIST"; CALL PMTRANS; IF HSTAT BIT 4 GO ERR
120214          X:=BREG=:B:=XREG2; T:=CORMBANK
120220          IF MODUS><0 THEN
120222             *LDATX DPGPR
120223             A BZERO 5WIP
120224          ELSE
120225             *LDATX DPGPR
120226             A=:D:=FLAG/\177400\/D
120232          FI; *STATX DPGPR
120233          GO LREG2
120234   *)FILL
