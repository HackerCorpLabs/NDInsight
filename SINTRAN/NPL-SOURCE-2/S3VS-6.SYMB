120465   %==============================================================================
120465   %            S R E S E R   -   S R E L E S
120465   %
120465   % SUBROUTINES TO RESERVE AND RELEASE ALL SWAPPING RESOURCES
120465   %
120465   % ENTRY:     B=MONITOR CALL WORKING FIELD
120465   %
120465   SUBR SRESER,SRELES,ZSRELES
120465   INTEGER BRG,CINDX,XREGG
120470   INTEGER POINTER CLR
120471   
120471   SRESER: A:=L=:"CLR":=B=:BRG; X=:XREGG
120476          X:=RTREF; "CLFIE"=:B; CALL BRESERVE
120502          IF A<0 THEN
120503             CALL SRELES
120504             X.STATUS BONE 5WAIT=:X.STATUS
120507             BRG=:B; OLDPAGE BONE 5SWWAIT=:OLDPAGE; GO VENT
120515   OUT:   FI; 0=:CINDX
120516          DO WHILE X:=CINDX<=3
120522             IF MASSNO(X)><0 THEN
120524                CALL LOGPH; A=:B; X:=RTREF; CALL BRESERVE
120530                IF A<0 THEN
120531                   CALL SRELES; CALL FREXQU; CALL TOWQU; GO VENT
120535                FI
120535             FI; MIN CINDX
120536          OD
120537          BRG=:B; X:=XREGG; GO CLR
120543   VENT:  BRG=:B; ZPREG-1=:ZPREG; GO M61RET
120551   
120551   INTEGER CPROG,XINDX,BBRG,XXRG
120555   INTEGER POINTER CLLR
120556   
120556   ZSRELES: X=:CPROG=:XXRG; GO FELLS
120561   SRELES: RTREF=:CPROG; X=:XXRG
120564   FELLS: A:=L=:"CLLR":=B=:BBRG
120570          0=:XINDX
120571          DO WHILE X:=XINDX<=3
120575             IF MASSNO(X)><0 THEN
120577                CALL LOGPH; IF A.RTRES=CPROG THEN X=:B; X:=CPROG; CALL BRELEASE FI
120610             FI; MIN XINDX
120611          OD; "CLFIE"=:B; X:=CPROG; IF RTRES=X THEN CALL BRELEASE FI
120621          BBRG=:B; X:=XXRG; GO CLLR
120625   RBUS
