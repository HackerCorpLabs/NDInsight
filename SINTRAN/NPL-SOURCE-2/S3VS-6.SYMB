121126   INTEGER LEVC,SRBI(0); *SRB 10
121130   INTEGER ARRAY QMSDF:=(DRFIE,DRFI2,BIGDI,BIGD2,BIGD3,BIGD4,GIGDI,GIGD2,WIGDI,WIGD2,-1)
121143   DISP 0; REAL FS0, RCTRG=CTRG, RTRG=TRG; PSID
121143   
121143   %ROUTINE ON LEVEL 14, ACTIVATED BY POWER FAIL
121143   %CAN ALSO BE CALLED BY THE STOP-SYSTEM COMMAND
121143   PWFAIL: *PIOF
121144   *"8N500
"121144          -15=:LEVC; SRBI; X:="LEV1"
121150          FOR LEVC DO; *EXR SA
121151                X+10; A+10
121153          OD
121155          *TRA PIE
121156          A=:PIEREG; *TRA PID
121160          A=:PIDREG
121161          CALL PFXMSG
121162   *"8N500
"121162          IF SEGMC><0 AND A.FLAG BIT 5WPM AND X:=X.BPAGLINK><0 THEN
121172             T:=CORMBANK
121173             DO
121173                *LDBTX DALOG; 177700                % MIC. PROGRAM BUG!!!!!
121175                AD:=DOU0; *STDTX DPGPR
121177                *LDXTX DPAGL
121200             WHILE X><0
121201             OD
121202          FI
