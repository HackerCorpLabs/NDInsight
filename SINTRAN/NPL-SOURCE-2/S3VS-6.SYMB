055571  "8SG15; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG14; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG13; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG12; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG11; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG10; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG09; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG08; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
055571  "8SG07; XYS=TEMP; )KILL TEMP; TEMP=XYS+1; )KILL XYS;
