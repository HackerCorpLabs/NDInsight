127233   SUBR B8INTERM,B8IINDV,M8IINDV,IB8INTERM
127233   INTEGER CCHAR
127234   IB8INTERM:
127234   B8INTERM: IF BHOLD=0 GO WDX; A=:D; X:=HENTE; T:=BUFST; MAX=:L; *LBYT
127245          A SHZ 10
127246          IF D-1=0 THEN
127251                *IRW ALEVB DA
127252                T:=1; GO GORE1
127254          FI; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT
127262          A\/CCHAR; *IRW ALEVB DA
127264          IF D-1=0 THEN T:=2; GO GORE1 FI; IF X+1=L THEN X:=0 FI; *LBYT
127276          A SHZ 10
127277          IF D-1=0 THEN
127302                *IRW ALEVB DD
127303                T:=3; GO GORE1
127305          FI; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT
127313          A\/CCHAR; *IRW ALEVB DD
127315          IF D-1=0 THEN T:=4; GO GORE1 FI; IF X+1=L THEN X:=0 FI
127326          A:=D=:BHOLD; CFREE+4=:CFREE; *ION; IOF
127335          BHOLD=:D; *LBYT
127340          A SHZ 10
127341          IF D-1=0 THEN
127344                *IRW ALEVB DL
127345                T:=1; GO GORE2
127347          FI; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT
127355          A\/CCHAR; *IRW ALEVB DL
127357          IF D-1=0 THEN T:=2; GO GORE2 FI; IF X+1=L THEN X:=0 FI; *LBYT
127371          A SHZ 10
127372          IF D-1=0 THEN
127375                *IRW ALEVB DX
127376                T:=3; GO GORE2
127400          FI; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT
127406          A\/CCHAR; *IRW ALEVB DX
127410          D-1; T:=4
127412   GORE2: A:=T+4
127414   GORET: *IRW ALEVB DT
127415          A:=D=:BHOLD; CFREE+T=:CFREE
127422          IF X+1=L THEN X:=0 FI; X=:HENTE
127427          GO MOURET
127430   
127430   GORE1: A:=T; GO GORET
127432   
127432   *)FILL
127434   
127434   @ELIB
127434   @LIB CXCPU
127434   
127434   B8IINDV:
127434   M8IINDV: IF BHOLD=0 GO WDX
127437          IF "IOTRANS"="IGTCH" GO IB8INTERM
127443          BHOLD=:D; MAX+BUFST=:L; HENTE+BUFST=:X
127453          X.S0; *IRW ALEVB DA; ION
127456          T:=1; IF D-1=0 GO IRET; IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DD
127470          T:=2; IF D-1=0 GO IRET; IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DL
127502          T:=3; IF D-1=0 GO IRET; IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DX
127514          D-1; T:=4
127516   IRET:  A:=D=:BHOLD; A:=T; *IRW ALEVB DT
127522          CFREE+T=:CFREE; IF X+1=L THEN X:=BUFST FI; A:=X-BUFST=:HENTE
127534          GO MOURET
