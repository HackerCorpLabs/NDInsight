117100   
117100   %==============================================================================
117100   %
117100   %                S E G M E N T   F E T C H I N G
117100   %
117100   %==============================================================================
117100   % 37.10      S E G I N
117100   
117100   % SUBROUTINE TO GET A NEW SEGMENT INTO CORE
117100   % B=SEGMENT ELEMENT; NO RETURN
117100   
117100   SUBR SEGIN
117100   SYMBOL 5READ,5WRITE
117100   SEGIN: 5CLOAD; X:=RTREF; CALL RESERVE
117103          IF <0 THEN                      %SEG. TRANSFER GOING ON
117104             IF SWPFLAG><0 THEN
117106                X.ACTPRI BONE 5SWWAIT=:X.ACTPRI
117111                X.STATUS BONE 5WAIT=:X.STATUS
117114   LOOP:        RTREF+"BRESLINK"=:X
117117                DO WHILE X:=X.RESLINK><RTREF
117123                   IF X.TYPRING/\3=3 THEN X=:B:=RTREF; CALL BRELEASE; GO LOOP FI
117134                OD
117135             FI; GO PRWAIT; *)FILL
117146          FI; A:=B=:SEGREF
117150          X=:SRTREF; NSEGA=:TSEGA; NSEGB=:TSEGB; NSEGC=:TSEGC
117157          CALL XCSEGS
117160          IF FLAG NBIT 5DEMAND THEN
117163   
117163   %NON-DEMAND SEGMENT
117163             DO                 %UNTIL THE SEGMENT HAS GOT ENOUGH PAGES
117163                IF B="XSGRT" THEN -1=:NUMBER; GO XLRU FI      % DUMMY SEGMENT
117171                LOGADR SHZ-10-=:NUMBER
117175                IF X:=BPAGLINK><0 THEN
117177                   LOGADR/\377=:D; T:=CORMBANK; *LDATX DALOG
117204                   D-A=:A; A=:NUMBER
117207                FI
117207             WHILE NUMBER><0    %ENOUGH PAGES
117211   XLRU:        CALL LRU; X:=:B; FLAG =:SAVEFLAG BZERO 5OK=:FLAG
117217                5WRITE; CALL TRNSEG
117221                IF ><0 THEN SAVEFLAG=:FLAG; GO END1 FI
117225                X:=:B; CALL LINKOVER
117227             OD
117230          ELSE
117231   
117231   %DEMAND SEGMENT
117231             IF FLAG BIT 5OK THEN
117234                -1=:NUMBER; PNUMB=:CPNUMB
117240                FLAG BZERO 5OK=:FLAG
117243                CALL LRU; X:=:B; FLAG BZERO 5OK=:FLAG
117250                5WRITE; CALL TRNSEG; X:=:B; CALL LINKOVER
117254                T:=CORMBANK; X:=BPAGLINK; *LDATX DPAGL
117257                IF A><0 THEN
117260                   A=:BPAGLINK; *STZTX DPAGL
117262                   X=:D
117263                   DO WHILE A><0
117264                      A=:X; *LDATX DPAGL
117266                   OD; A:=D; *STATX DPAGL
117271                FI
117271             FI
117271          FI
117271          0=:NUMBER; 5READ; CALL TRNSEG
117274   %SEGMENT OK:
117274          FLAG BONE 5OK=:FLAG
117277   END1:  X:=SRTREF; 5CLOAD; CALL RELEASE
117302          IF X=RTREF GO PRW; GO PSTUPR
117306   RBUS
117336   
117336   %==============================================================================
117336   % 37.11      L R U
117336   
117336   %SUBROUTINE TO FIND LEAST RECENTLY USED SEGMENT
117336   %ENTRY: B=SEGREF
117336   % RETURN: X=LRU SEGMENT POINTER
117336   
117336   SUBR LRU
117336   INTEGER ARRAY TSGN:=(TSEGB,TSEGC,TSEGA,TSEGC,TSEGA,TSEGB)
117344   INTEGER POINTER LREG; INTEGER LRUS2,R01
117347   LRU:   A:=L=:"LREG"
117351          IF MAXP<< 200 AND FLAG BIT 5DEMAND THEN            % COUNT PAGES
117360             X:=BPAGLINK; D:=0; T:=CORMBANK
117363             DO WHILE X><0
117364                *LDXTX DPAGL
117365                D+1
117366             OD
117367             IF D>=MAXP THEN B=:X; GO OUT FI
117374          FI
117374          FOR X:=-3 DO IF TSEGS(X)=0 GO NOTF
117377                X:=:A; IF X:=X.SEGLINK=0 GO NOTF; A=:X
117403          OD; CALL GETLAST; IF =0 GO OUT
117406   % ALL THREE SEGMENTS PRESENT, TAKE ONE OF THE TWO OTHERS
117406          FOR X:=-3 DO WHILE TSEGS(X)><B OD
117413          R01-,=:R01; X+3+X-A; X:=TSGN(X); X:=X.S0; GO OUT
117424   NOTF:  CALL GETLAST; IF =0 GO OUT
117426          CALL GETLAST; X=:LRUS2
117430          IF <0 THEN CALL GETLAST
117432                IF <0 THEN
117433                  X=:D; 2/\X.FLAG; T:=LRUS2.FLAG; *BLDA 10 DT; BSTA 0 DA
117442                  D=:X; GOSW ERR,FRSTDEM,OUT,BOTHDEM
117450   BOTHDEM:       IF X><B GO OUT
117452   FRSTDEM:       X:=LRUS2
117453          FI    FI
117453   % X=SEGMENT TO BE REMOVED(LRU-SEG):
117453   OUT:   X=:A; CALL CSEGS
117455          IF X.SEGLINK=0 GO NOTF
117457          X:=:B; CALL SEGSORT; CALL RANDOM; X:=:B
117463          GO LREG
117464   ERR:   IF SEGREF="XSGRT" THEN    % SEGMENT 1, FIXC
117470             "CLFIE"=:B; X:=SRTREF; CALL BRELEASE; 0=:X.ACTSEG; GO PSTUPR
117476          FI
117476          SRTREF=:RTREF; CALL 9ERR(#19); GO PRTEXT
117503   *)FILL
117525   
117525   % LOCAL SUBROUTINE TO FIND LAST SEGMENT
117525   % RETURN: X=LRU-SEG;IF =TSEGA OR TSEGB OR =TSEGC :A<0
117525   INTEGER PREVLINK
117526   GETLAST: "BSEGLINK".SEGLINK; IF =-1 GO ERR
117533          DO X=:PREVLINK WHILE A.SEGLINK><-1; OD
117542          X=:D; A:=0
117544          IF X=TSEGA OR X=TSEGB OR X=TSEGC THEN
117555                IF BSEGLINK><X THEN
117560                  A=:X.SEGLINK; X=:BSEGLINK; -1=:PREVLINK.SEGLINK
117565                FI; -1; D=:X
117567          FI; EXIT
117570   RBUS
