113470   %
113470   SUBR GETDW,PUTDW
113470   DISP 0; DOUBLE ARRAY POINTER DBUFST=BUFST; PSID
113470   INTEGER XREG
113471   GETDW: IF BHOLD>3 THEN
113475                X=:XREG:=HENTE+2; AD:=DBUFST(X); *IRW ALEVB DX
113502                A:=D; *IRW ALEVB DL
113504                X-2; AD:=DBUFST(X)
113506                IF X+4=MAX THEN X:=0 FI; X=:HENTE
113514                X:=BHOLD-4=:BHOLD:=CFREE+4=:CFREE
113522                X:=XREG; A:=:D; *IRW ALEVB DD
113525                A:=D; L+1
113527          FI; EXIT
113530   PUTDW: T:=DFOPP=:B
113532          IF T:=CFREE-3>0 THEN
113536                T-1=:CFREE; A=:CHARI; X=:XREG; *IRR ALEVB DD
113543                A=:D; CHARI; AD=:DBUFST(FYLLE); *IRR ALEVB DL
113550                A=:D=:CHARI; *IRR ALEVB DX
113553                X+2; AD=:DBUFST(X)
113555                IF X+2=MAX THEN X:=0 FI; X=:FYLLE
113563                BHOLD+4=:BHOLD; X:=XREG; L+1
113570          FI; T:=DFOPP=:B; EXIT
113573   RBUS
