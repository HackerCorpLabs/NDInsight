055616  "
055616           )LINE%   M A C R O S   F O R   N - 10 / N - 100  F I L E   S Y S T E M
055616  
055616  % FOR SINTRAN III VERSION
055616  
055616  )KILL SDATA FENTR FLEAV ISTCK MINBT MOUTB DATA
055616  
055616         )MCDEF SDATA
       A=6; ]
055616  
055616         )MCDEF DATA $PAR 
       )KILL A; A=$PAR +1; ]
055616  
055616         )MCDEF FENTR
       STD I (ASTCK; COPY SL DA; COPY SB DD; SAB A; JPL I (SPUSH; ]
055616  
055616         )MCDEF FLEAV
       SAA -A; JMP I (SPOP; )KILL A; ]
055616  
055616         )MCDEF ISTCK
       STA I (ASTCK; LDA (STACK; STA I (CSTCK
       SAA 1; STA I (TDVN; LDA I (ASTCK; ]
055616  
055616         )MCDEF MINBT
       JPL I (SINBT; ]
055616  
055616         )MCDEF MOUTB
       JPL I (SOUTB; ]
055616  )LINE055616   %
