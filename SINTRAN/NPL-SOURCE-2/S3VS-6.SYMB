065352   *"8DMAS
"065352   *BLOCK=TEXIT; BUNLO=TEXIT
065352   *"
"065352   
065352   @MAC
""065352   
065352   *"8MT1+8CAS1+8DMVC+8CDLI+8FDI1+8FDI2+8BFD1+8BFD2+8MT2+8CAS2+8MT3+8MT4
"065352   %==============================================================================
065352   % 34.10      C B G E T   C B P U T   C A I C L   S M T R A   C A O C L
065352   %
065352   %
065352   % IOTRANS ROUTINE FOR MAG.TAPE, VERSATEC ON DMA, CASSETTE
065352   % AND FLOPPY DISC
065352   %
065352   
065352   SUBR CBGET,CBPUT,CAICL,SMTRA,CAOCL
065352   
065352   % VARIABLES IN I/O DATAFIELD
065352   DISP 24
065352   INTEGER LREGC                % RETURN ADDRESS AFTER IOTRANS IS EXECUTED
065352   INTEGER CASUN                % DEVICE UNIT NUMBER
065352   INTEGER CERROR               % CURRENT ERROR CODE
065352   INTEGER LASTC                % CURRENT CHARACTER
065352   INTEGER NOWRE                % NUMBER OF CHARACTERS TO READ/WRITE
065352   INTEGER CPARM(4)             % PARAMETER LIST FOR MTRANS (FIRST WORD IN MEMORY
065352                                % BUFFER ADDRESS IS MBUFB.
065352   INTEGER MBUFB                % BANK NUMBER IN WHICH THE DEVICE BUFFERS LIE.
065352   INTEGER MABUF                % SECOND WORD IN MEMORY BUFFER ADDRESS
065352   DOUBLE MBPAG=MBUFB
065352   INTEGER VEFUNC               % PRINT OR PLOT MODUS IF VERSATEC (10=PLOT,11=PRINT)
065352   INTEGER CIOLOG               % LOGICAL DEVICE NUMBER OF I/O DATAFIELD
065352   INTEGER FDIADR               % FLOPPY DISC ADDRESS
065352   INTEGER POINTER PLREGC=LREGC
065352   PSID
065352   DISP -1; INTEGER ADRBHEAD; PSID        % BUFFER HEADER ADDRESS
065352   
065352   % VARIABLES IN DMA DEVICE DATAFIELD
065352   DISP 12; INTEGER MRTREF; PSID          % PROGRAM CALLING CLOSE
065352   DISP 13; INTEGER BREGC; PSID       % ADDRESS OF I/O DATAFIELD
065352   DISP 0; REAL RFMAX=MAX; DOUBLE DBHOLD=BHOLD; PSID
065352   INTEGER BREG=?
065352   
065352   CBGET: A:=L=:LREGC; *PION              % LEVEL 4
065355          CALL CBF1
065356          IF BHOLD><0 THEN
065360             IF A=1 AND CERROR><0 THEN A=:DERROR FI
065366             *PIOF
065367             CALL DBGET; *PION
065371             MIN LREGC; GO PLREGC
065373          FI
065373          A:=B; *IRW MLEVB DB
065375          "CGMLEV"; *IRW MLEVB DP
065377          MLEV; *MST PID; WAIT
065402          CALL ERRFATAL
065403          *)FILL
065407   
065407   % MONITOR LEVEL
065407   
065407   CGMLEV:CALL CBF2; CALL MTRANS; CALL BRELEASE; CALL CBUNLOCK
065413          CALL MBFDISC; X:=BREGC;0=:X.CERRO
065416          IF TYPRING BIT 5FLOP THEN
065421             IF HSTAT NBIT 4 THEN
065424                IF A BIT 5 THEN A BONE 4=:HSTAT; 3=:CERRCODE; A:=0
065433                ELSE
065434                   X:=BREGC.CASUN; X:=FDIFORM(X); WDSCT(X)     % WORDS PER SECTOR ACCORDING TO FORMAT
065440                FI
065440             ELSE
065441                A:=0
065442             FI; A=:BREGC.NOWRE
065444          FI
065444          IF HSTAT BIT 4 THEN X:=:B; CALL MERRCODE; X:=:B
065452             IF T:=X.NOWRE=0 THEN A=:X.DERROR ELSE A=:X.CERROR FI
065460          FI
065460   CBGE1: X=:B;NOWRE SHZ 1=:BHOLD;0=:HENTE
065465          GO STUPR
065466   
065466   ERR1:  A:=172                % NO DEVICE BUFFER AVAILABLE
065467   ERR:   A=:DERROR; GO PLREGC
065471   *)FILL
065477   
065477   INTEGER BREG
065500   INTEGER POINTER REGL
065501   
065501   % RESERVE THE DFOPP-DATAFIELD AND RESERVE DEVICE BUFFER
065501   
065501   CBF1:  T:=L=:"REGL"
065503          CALL CHDVBUF; GO CNBUF; GO L1
065506   CNBUF: CLOGDV; CALL LOGPH; IF A=0 THEN 2; GO ERR FI
065513          IF A.TYPRING BIT 5FLOP THEN
065517                X=:D; A:=X+CASUN+"FDIFORM"=:X; X.S0+D+"WDSCT"=:X
065530                X.S0 SH 1=:MAX
065533          FI
065533          T:=CIOLOG; MAX SHZ -1; CALL G5BUF; GO ERR1
065540          AD=:MBPAG; A:=D=:BUFST; T=:ADRBHEAD                 % PUT ADDRESS OF DEVICE BUFFER AND DEVICE BUFFER HEADER
065544          0=:BHOLD=:FYLLE=:HENTE; MAX=:CFREE                  % IN THE FLOPPY INBYTE/OUTBYTE DATA FIELD.
065551   L1:    IF X:=DFOPP=0 GO REGL
065554          IF X.RTRES><RTREF THEN
065560             B=:D:=X; X:=T; CALL BRESERVE; D=:B
065565             IF A<0 THEN A:=205; GO ERR FI          % DEV. ALREADY RESERVED
065570          FI; GO REGL
065571          
065571   CBF2:  A:=L=:"REGL"
065573          *IRR ALEVB DP
065574          A-1;*IRW ALEVB DP
065576          MAX SHZ -1=:NOWRE; CLOGDV; CALL LOGPH
065603          IF A=0 THEN 2; GO ERR FI        % NO  "DMA" DATAFIELD
065606          A:=:B;A=:BREG; CALL CBLOCK;X:=RTREF;CALL BRESERVE  % RESERVE "DMA" DATAFIELD
065613          IF A<0 THEN CALL FREXQU;CALL TOWQU; CALL CBUNLOCK
065617                GO STUPR FI               % WAIT FOR "DMA" DEVICE TO BE FREE
065620          IF TYPRING BIT 5FLOP THEN
065623             1=:BREG.NOWRE
065626             X:=X.CASUN; NFDIADR(X)=:BREG.FDIADR
065632          FI; BREG=:BREGC; A+"CPARM"; GO REGL
065636   *)FILL
065654   
065654   CBPUT: X:=L=:LREGC;A=:LASTC; *PION
065660          CALL CBF1
065661          IF CFREE><0 THEN
065663             LASTC; *PIOF
065665             CALL DBPUT; *PION
065667             MIN LREGC; GO PLREGC
065671          FI
065671          A:=B; *IRW MLEVB DB
065673          "CBMLEV"; *IRW MLEVB DP
065675          MLEV; *MST PID; WAIT
065700   
065700   % MONITOR LEVEL
065700   CBMLEV:CALL CBF2
065701          CALL MTRANS;CALL BRELEASE; CALL CBUNLOCK
065704          CALL MBFDISC; X:=BREGC
065706          IF HSTAT BIT 4 THEN X:=:B; CALL MERRCODE; X:=:B; A=:X.DERROR FI
065715          X=:B;MAX=:CFREE;0=:FYLLE=:BHOLD;GO STUPR
065723   *)FILL
065734   
065734   % INCREMENT DISC ADDRESS IF FLOPPY DISC
065734   MBFDISC: IF TYPRING BIT 5FLOP THEN
065737                X:=BREGC.CASUN; MIN NFDIADR(X); 0/\0
065743            FI; EXIT
065744   
065744   
065744   % IOSET ROUTINE FOR MAG.TAPE, VERSATEC ON DMA, LINE-PRINTER, FLOPPY
065744   % AND CASSETTE
065744   
065744   
065744   INTEGER POINTER LREG=?
065744   
065744   % ENTRY POINT FOR INPUT
065744   CAICL: IF A><-1 AND ><-2 THEN EXIT FI
065753   CAICF: A:=L=:"LREG"
065755          CALL CHDVBUF; GO CAIC1
065757          "CAIC4"; *IRW BLEVB DP
065761          CIOLOG; *IRW BLEVB DT
065763          BLEV; *MST PID
065765   CAIC1: 0=:BHOLD=:HENTE=:BUFST=:ADRBHEAD; MAX=:CFREE
065773          A:=0; GO LREG
065775   CAIC4: CALL R5BUF; CALL ERRFATAL; *WAIT
066000          CALL ERRFATAL
066001   
066001   INTEGER SAVEB
066002   INTEGER REGB=?,XREG=?
066002   INTEGER POINTER LREG
066003   
066003   % ENTRY POINT FOR OUTPUT
066003   CAOCL: IF A><-1 THEN IF A=-2 GO CAICF; EXIT FI
066012          IF BHOLD=0 GO CAICF
066014          A:=L=:"LREG"; CALL CHDVBUF; GO CAIC1
066020          X=:XREG
066021          A:=B=:REGB;CLOGDV;CALL LOGPH;A=:B
066026          X:=XREG; CALL CB2LOCK; X:=RTREF;CALL BRESERVE
066032          IF A<0 THEN           % WAIT FOR "DMA"DEVICE
066033                CALL FREXQU;CALL TOWQU; XREG=:B; ZPREG-1=:ZPREG
066042                CALL CBUNLOCK; GO RETSTUPR; *)FILL
066060          FI
066060          RTREF=:MRTREF; X:=REGB; X:=:B; CALL CHDVBUF; GO UT; X=:B
066067          IF TYPRING BIT 5FLOP THEN
066072             IF REGB.BHOLD><X.MAX THEN
066077                A:=B=:SAVEB; X=:B
066102                DO WHILE BHOLD><MAX
066106                   *PIOF
066107                   A:=0; CALL DBPUT; *PION
066112                OD; A:=SAVEB=:B
066115             FI
066115          FI; GO FILSK; *)FILL
066121   
066121   INTEGER REGB,XREG
066123   
066123   FILSK: REGB=:BREGC=:B; "SMTRA"=:MFUNC
066130          IF BHOLD BIT "0" THEN           % ODD NUMBER OF BYTES IN BUFFER
066133             *PIOF
066134             A:=0; CALL DBPUT; *PION
066137          FI
066137          IF TYPRING BIT 5MT THEN
066142             DO WHILE BHOLD<22            % RECORD OF AT LEAST 22 BYTES MUST
066146                *PIOF                     % BE WRITTEN ON MAG TAPE FOR IT TO
066147                A:=0; CALL DBPUT; *PION   % BE DISTINGUISHED FROM NOISE
066152             OD
066153          FI
066153          A:=BHOLD SHZ -1=:NOWRE; CALL RTACT
066157          X:=RTREF; CALL WDATA
066161   UT:    XREG=:B; GO RET
066164   *)FILL
066172   
066172   % SUBROUTINE TO SET UP A CALL TO THE MASS STORAGE DRIVER
066172   % MONITOR LEVEL
066172   
066172   SMTRA: X=:B                            % LEVEL 3
066173          CLOGDV; CALL LOGPH; A=:X
066176          "SRETRA"=:X.MFUNC
066200          IF X.TYPRING BIT 5FLOP THEN
066203             X=:D; 1=:NOWRE; CASUN+X+"NFDIADR"=:X; X.S0; MIN X.S0; 0/\0
066215            A=:FDIADR; D=:X
066217          FI
066217          A:=B+"CPARM"; X=:B;CALL CMTRANS
066223          IF HSTAT BIT 4 THEN X:=:B; CALL MERRCODE; X:=:B ELSE A:=0 FI; A=:D
066234          IF CURPROG=MRTREF THEN
066240              A:=D; *IRW ALEVB DA
066242          ELSE
066243             A:=D; X:=MRTREF.RTDLGADDR; T:=0; *STATX XTDAR
066250          FI; X:=MRTREF
066251          "RETRANS"=:MFUNC; CALL BRELEASE; CALL CBUNLOCK; BREGC=:B
066257          "IORES"=:MFUNC
066261   OUT:   0=:BHOLD=:HENTE=:FYLLE; MAX=:CFREE
066266          CALL CHDVBUF; GO STUPR
066270          T:=CIOLOG; CALL R5BUF; CALL ERRFATAL; 0=:ADRBHEAD
066274          GO STUPR
066275   
066275   RBUS
066314   
066314   
066314   *"8MT1+8MT2+8CAS1+8CAS2+8FDI1+8FDI2+8BFD1+8BFD2+8DLP1+8DLP2+8DMVC+8DVE1+8DVE2+8MT3+8MT4
"066314   %==============================================================================
066314   % 34.11      C M T R A N S   S R E T R A
066314   %
066314   %
066314   % SUBROUTINE TO START DRIVER ON LEVEL 11
066314   % MONITOR LEVEL
066314   % ENTRY: B=DATAFIELD ADDRESS
066314   %        A=ADDRESS OF PARAMETER LISTE
066314   %
066314   SUBR CMTRANS,SRETRA
066314   
066314   DISP 12;INTEGER MRTREF;PSID  % RT PROGRAM CALLING CLOSE (IOSET)
066314   
066314   CMTRANS: *IOF
066315          *IRW LV11B DX; TRR 10
066317          "STDRIV";*IRW LV11B DT
066321          A:=B; *IRW LV11B DB
066323          "SLV11"; *IRW LV11B DP
066325          A:=L=:"TRLREG"
066327          LV11;*MST PID
066331          X:=MRTREF;CALL WDATA
066333          *ION
066334          IF X=RTREF GO RWAIT; GO MONEN
066340   
066340   % X=DATAFIELD ADDRESS
066340   SRETRA: X=:B:=MRTREF;IF X=0 GO MONEN
066344          CALL RDATA;GO TRLREG
066346   
066346   RBUS
066355   
066355   *"8HDMA
"066355   %===========================================================================
066355   % 34.21      C H D V B U F
066355   %
066355   % SUBROUTINE TO CHECK IF A DEVICE BUFFER IS RESERVED FOR THIS LOGICAL
066355   % DEVICE UNIT BY THE PROGRAM WHICH HAS RESERVED THE LOGICAL
066355   % DEVICE UNIT
066355   %
066355   % ENTRY:     B=ADDRESS OF I/O DATAFILELD
066355   % EXIT:      NO DEVICE BUFFER RESERVED
066355   % EXITA:     DEVICE BUFFER RESERVED
066355   %
066355   SUBR CHDVBUF
066355   DISP -1; INTEGER ADRBHEAD; PSID        % ADDRESS OF BUFFER HEADER
066355   DISP 5; INTEGER LGIOLOG; PSID          % LOGICAL DEVICE NUMBER IN BUFFER
066355   DISP 40; INTEGER CIOLOG; PSID          % LOGICAL DEVICE NUMBER IN DATAFIELD
066355   
066355   CHDVBUF:
066355          X=:D
066356          IF ADRBHEAD=0 OR A.RTRES><RTRES OR X.LGIOLOG><CIOLOG THEN
066371             X:=D
066372             EXIT
066373          FI
066373          X:=D; EXITA
066375   RBUS
066375   
066375   
066375   
066375   %==============================================================================
066375   % 34.22      P S T W O R D    P L D W O R D    D B S T W    D B L D W
066375   %
066375   % SUBROUTINES TO READ/WRITE VALUE IN ANY LOCATION IN EXISTING MEMORY
066375   %
066375   %      ROUTINES DBSTW AND DBLDW RETURN WITH PAGING-OFF AND INTERRUPT UNCHANGED
066375   %      - CALLED FROM ROUTINES OPERATING ON DEVICE BUFFERS.
066375   %
066375   %      PSTWORD AND PLDWORD RETURN WITH ION AND PAGING-OFF
066375   %      - CALLED FROM DMA-DRIVERS WITH ION.
066375   %
066375   % ENTRY: T=VALUE TO STORE IF PSTWORD OR DBSTWORD.
066375   %        AD=ADDRESS OF LOCATION TO ACCESS.
066375   %
066375   % EXIT:  T=VALUE IF PLDWORD OR DBLDWORD.
066375   %        AD IS INCREMENTED BY ONE
066375   %
066375   
066375   SUBR PSTWORD,PLDWORD,DBSTWORD,DBLDWORD
066375   
066375   INTEGER SVT,SVA,SVD,SVX,FLGX,PITAB; DOUBLE SVAD=SVA; REAL SVTAD=SVT
066403   INTEGER 5BFAD(0); *5BFPA@12
066404   INTEGER 5BFXX(0); *177400+5BFPA
066405   
066405   DBSTWORD: K:="0"; GO PS1
066407   DBLDWORD: K:="0"; GO PL1
066411   PSTWORD: *IOF
066412          K:=1
066413   PS1:   0=:FLGX; GO FELLS
066415   PLDWORD: *IOF
066416          K:=1
066417   PL1:   T:=1=:FLGX
066421   FELLS: X=:SVX 
066422             IF X:=FLGX=0 THEN
066425                *DEPO
066426             ELSE
066427                *EXAM
066430             FI; *POF
066431          D+1; A:=A+C; X:=SVX
066434          IF K THEN; *ION       % PSTWORD/PLDWORD
066437               FI; EXIT
066440   RBUS
066440   *"8FDI1+8FDI2
"066440   
066440   
066440   %
066440   
066440   *"
"066440   
066440   
066440   *"MERRC
"066440   %==============================================================================
066440   % 34.25      M E R R C O D E
066440   %
066440   %
066440   % SUBROUTINE TO DECODE HARDWARE STATUS TO ERROR CODE
066440   % ANY LEVEL
066440   %
066440   % ENTRY: A=HARDWARE STATUS, X=ADDRESS OF DATAFIELD
066440   % RETURN: A=ERROR CODE, D IS DESTROYED
066440   %
066440   SUBR MERRCODE
066440   DISP 22; INTEGER DIS22; PSID
066440   INTEGER CINSTR(0); *COPY SA DB
066441   MERRCODE: A=:D; IF X.CERRCODE><0 THEN 0=:X.CERRCODE; EXIT FI
066446          IF D=-1 THEN A:=174; EXIT FI          % ILLEGAL PARAMETER IN CALL
066453          IF X.TYPRING BIT 5IBDV THEN A:=D; EXIT FI
066460          IF A BIT 5FLOP THEN
066462                IF X.DIS22-CINSTR><0 THEN 171; EXIT FI  % NEW FLOPPY (BIG-FLOPPY)
066467                IF D BIT 10 THEN 204; EXIT FI
066473                IF D BIT 11 THEN 175; EXIT FI
066477          FI
066477          IF A NBIT 5MT THEN A:=171; EXIT FI % MASS.DEV.ERROR
066503   
066503   % MAG. TAPE
066503          IF X."TRNSF"><"HMAGT" THEN      % IF "SMAGT" OR "TMAGT" !!
066507                IF D NBIT "0" THEN 204; EXIT FI     % NOT READY
066513          ELSE
066514                IF D NBIT 16 THEN 204; EXIT FI      % NOT READY
066520          FI
066520          IF D BIT 7 THEN A:=3; EXIT FI      % END OF FILE
066524          IF D BIT 11 THEN A:=146; EXIT FI             % END OF TAPE
066530          IF D BIT 14 THEN A:=163; EXIT FI           % OVERFLOW IN READ
066534          IF D BIT 13 THEN A:=164; EXIT FI          % DMA ERROR
066540          IF X."TRNSF"><"HMAGT" THEN         % NOT HEWLET-PACKARD.
066544             IF D BIT 6 THEN A:=165; EXIT FI    % BAD DATABLOCK
066550             IF D BIT 5 THEN A:=166; EXIT FI        % CONTROL/MODUS WORD ERROR
066554          ELSE                            % H.P. MAG.TAPE
066555             IF D BIT 12 THEN A:=167; EXIT FI   % PARITY ERROR
066561             IF D BIT 6 THEN A:=170; EXIT FI        % LRC ERROR
066565          FI; A:=171; EXIT                          % MASS STORAGE DEVICE ERROR
066567   RBUS
066571   *"
"066571   
066571   
066571   
066571   
066571   
066571   %==============================================================================
066571   % 34.26      M 8 O U T B   M O U R E T
066571   %
066571   % MONITOR CALL TO OUTPUT 8 BYTES
066571   % INBT/OUTBT LEVEL
066571   SUBR B8INSYN,B8OUSYN,BM8OUT,BB8OUT
066571   RBUS
066571   %
066571   SUBR M8OUTB,MOURET,M8OTERM,CH8BY,M8OINDV,B8OUT,B8OTERM,B8OINDV,CH4WO,T2P01,T2P02
066571   INTEGER POINTER PTTNO:=TTNO,PBCHFLAG:=BCHFLAG
066573   M8OUTB: B:=0; GO FELLS
066575   B8OUT: B:=1
066576   FELLS: *IRR ALEVB DT
066577          IF X:=BACKGROUND><0 AND X:=PBCHFLAG=0 THEN
066604                IF A=1 THEN A:=PTTNO FI
066610          FI; IF A=0 GO MOURET; IF A=:D/\177700=100 GO E240  % NOT ALLOWED ON FILE
066617          A:=D; CALL LOGPH; IF D=0 GO E240
066623          D:=:B                                     % D IS "OLD CFLAG"
066624          IF X:=RTREF><RTRES THEN 5; GO ERR FI
066632   @LIB CXCPU
066632   @LIB CXCPU-,
066632          IF DFOPP=0 GO E240; *PIOF
066635          A.TYPRING; X:=RTREF
066640   @ELIB
066640          IF A BIT 5TERM THEN
066642                IF D=0 GO M8OTERM;  GO B8OTERM
066645          FI
066645          IF A BIT 5BAD THEN
066647                IF D=0 THEN
066651   T2P01:          GO BM8OUT; 0/\0
066653                ELSE
066654   T2P02:          GO BB8OUT; 0/\0
066656                FI
066656          FI
066656   *"8CLI1+8CLI2+8CLI3+8CLI4+8CLI5+8CLI6
"066656          *IRR ALEVB DT
066657          IF A>177 AND A<300 THEN
066665                IF D=0 GO M8OINDV; GO B8OINDV
066670          FI
066670   *"8VIPS
"066670   E240:  240
066671   ERR:   *IRW ALEVB DA
066672   L1:    *PION; WAIT; JMP * 1; IOF; WAIT
066677   MOURET: *IRR ALEVB DP; AAA 1; IRW ALEVB DP
066702          GO L1
066703   RBUS
066720   
066720   @ICR
066720   SUBR M8INTERM,B8INTERM,B8IINDV,M8IINDV,M8INCOM,B4INTERM,
066720        B4IINDV,B4WICOM,M8IBTERM,M8IBCOM,BB4INW,BB8INP;
066720   RBUS
066720   @CR;
066720   SUBR M8INB,B8INB,B4INW,T8INP,T2P03,T2P04,T2P05
066720   INTEGER POINTER PTTNO:=TTNO,PBCHFLAG:=BCHFLAG
066722   M8INB: B:=0; GO FELLS
066724   B8INB: B:=1; GO FELLS
066726   B4INW: B:=2; GO FELLS
066730   T8INP: B:=3
066731   FELLS: *IRR ALEVB DT
066732          IF X:=BACKGROUND><0 AND X:=PBCHFLAG=0 THEN
066737                IF A=1 THEN PTTNO FI
066743          FI; IF A=0 GO MOURET
066745          IF A=:D/\177700=100 GO E240               % NOT ALLOWED ON FILE
066752          A:=D; CALL LOGPH; IF A=0 GO E240
066755          B=:D:=A                                             % D IS "OLD CFLAG"
066757          IF X:=RTREF><RTRES THEN 5; GO ERR FI; *PIOF
066766          IF TYPRING BIT 5TERM THEN
066771                D GOSW M8INTERM,B8INTERM,B4INTERM,M8IBTERM
066776          FI
066776          IF A BIT 5BAD THEN
067000                IF D=0 GO M8INTERM
067002                IF D=1 THEN
067005   T2P03:          GO M8INTERM; 0/\0 
067007                FI
067007                IF D=2 THEN
067012   T2P04:          GO BB4INW; 0/\0   
067014                FI
067014                IF D=3 THEN
067017   T2P05:          GO BB8INP; 0/\0
067021                FI
067021          FI
067021          IF A BIT 5COM THEN
067023                D GOSW M8INCOM,M8INCOM,B4WICOM,M8IBCOM
067030          FI
067030          *IRR ALEVB DT
067031          IF A>177 AND A<300 THEN
067037                D GOSW M8IINDV,B8IINDV,B4IINDV
067043          FI
067043   *"8VIPS
"067043   E240:  240
067044   ERR:   *IRW ALEVB DA; PION; WAIT
067047          CALL ERRFATAL
067050   RBUS
067074   
067074   
067074   %=============================================================================
067074   %
067074   %
067074   SUBR GRTDA,GSGNO,GRTNA,3GRTDA,3GSGNO,3GRTNA
067074   
067074   GSGNO: T:="P0"; CALL GET0; CALL S3NOALT; GO 3GSGNO
067100   GRTDA: T:="P0"; CALL GET0; CALL S3NOALT; GO 3GRTDA
067104   GRTNA: CALL GET1; CALL S3NOALT; GO 3GRTNA
067107   RBUS
067115   
067115   
067115   %==============================================================================
067115   % 34.29      I P R I V
067115   %
067115   SUBR IPRIV
067115   INTEGER OBREG,NBREG,CAREG
067120   IPRIV: CALL GET0
067121          T:=ZTREG; X:=ZXREG; A:=ZDREG=:D
067125          A:=B=:OBREG:=ZAREG=:CAREG:=ZBREG=:B:=CAREG
067134          *EXR ST
067135          A=:CAREG:=B=:NBREG:=OBREG=:B
067142          A:=NBREG=:ZBREG:=D=:ZDREG
067146          T=:ZTREG; X=:ZXREG; CAREG=:ZAREG
067152          GO RET
067153   
067153   RBUS
067155   
067155   *"8CXHD+8C1X2+8C2X2+8C3X2+8C4X2
"067155   
067155   %=======================================================================
067155   % 34.31     X T L X    S T U S P   S T L 1 2    S T L 1 3
067155   %
067155   %      MONITOR CALL HDLC
067155   %
067155   %=======================================================================
067155   %
067155   %
067155   %PUROSE: SIMULATE XTLX MONITOR CALLS FOR COMMUNICATION
067155   %        WITH HDCL-DRIVER.
067155   %
067155   %ARGUMENTS:
067155   %
067155   %ENTRY: X-DEMFIELD, B-PARAMPOINTER
067155   %      PT=0, APT=USER PT, LEV 3 ENABLED, PON, ION
067155   %
067155   %EXIT: WHEN ENTRING THE CODE IN POF (HDLC),THE B-REG WILL
067155   %      POINT TO THE APPROPRIATE BASEFIELD,WHICH IN TURN
067155   %      WILL CONTAIN THE USER CALL PARAMETERS.
067155   %
067155   %
067155   %CALLING SEQUENCE:
067155   %
067155   %      A-REG - POINTER TO PARAM ADDRESSES
067155   %      MON  HDLC
067155   %      POINTER TO PARAM1
067155   %      POINTER TO PARAM2
067155   %      POINTER TO BUFFER
067155   %      POINTER TO PARAM4
067155   %      POINTER TO PARAM5
067155   %
067155   %      P1 - FUNCTION. SEND OR RECEIVE
067155   %      P2 - PORT NO. (LOGICAL UNIT NO.)
067155   %      P3 - BUFFER
067155   %      P4 - BYTECOUNT
067155   %      P5 - P1 - 1  MAX BYTECOUNT OF MESSAGE
067155   %           P1 - 2  WAIT/CONTINUE IF NO MESSAGE IN QUEUE
067155   %
067155   %
067155   DISP -9
067155          INTEGER HXDOK                   %LOCK,OPERATED BY X21(1-LOCKED,0-OPEN)
067155          INTEGER HXTMO                   %ADDRESS OF TIMEOUT-ROUTINE IN POF
067155   PSID
067155   SUBR XTLX,STUSP,IMHDLC
067155   %
067155   %      TEMPORARY WORKING AREA
067155   %
067155   INTEGER ARRAY POINTER TDAFI                      %CURRENT DATAFIELD
067156   INTEGER ARRAY POINTER TDEFI                      %DEMANDFIELD
067157   INTEGER TEMP
067160   INTEGER BFADR                                   
067161   %
067161   XTLX:  *BSET ZRO
067162          CALL GAPIT; CALL DALTON
067164          A:="P2"=:BFADR                            %USER BUFFER ADDRESS
067166          IF P0 = FRECV OR A=FMXRECV THEN
067175                A:="P3"=:TEMP                       %RETURN ADDRESS OF BYTECOUNT
067177                CALL GET5; *BSET ZRO
067201                TEMP=:X.D3
067203          ELSE
067204                IF P0 = FSEND THEN
067210                   CALL GET5
067211                ELSE
067212                   T:=EFUNC; GO ERET   %ILLEGAL FUNCTION
067214                FI
067214          FI; *BSET ZRO
067215          BFADR=:X.D2
067217          X=:"TDEFI"
067220   %
067220   %      LEV 3 DISABLED, TURN OFF PAGING
067220   %
067220          CALL ALTON; *POF                          %SET ALT PAG AND KEEP IT
067222   %
067222   %      FIND DATAFIELD AND RESERVE IT
067222   %
067222          A:=X.D1; CALL LOGPH;
067224          IF A = 0 THEN A:=D FI                     %TRY OUTPUT-FIELD
067226          IF A = 0 THEN T:=E2; GO ERET; FI
067231          A=:"TDAFI"=:B
067233          IF X.TYPRING >< 0 THEN T:=EDEVN; GO ERET FI         %*81F*
067237          IF HXCC >< HXCOD THEN T:=EDEVN; GO ERET FI  % CORRECT DATAFIELD ?
067245          IF CURPR><RTRES THEN                      % *80B*
067251            T:=E1;  GO ERET;                        % *80B* *81F*
067253          FI                                        % *80B*
067253   %
067253   %      COPY DATA TO DATAFIELD AND RELEASE DEMFIELD
067253   %
067253          A:="TDAFI"+OFSET=:"TDAFI"
067256          FOR X:= ST TO SP DO TDEFI(X)=:TDAFI(X) OD;
067266          A:="TDEFI"=:B
067270          X:=CURPROG; CALL BRELEASE;
067272          A:="TDAFI"-OFSET=:"TDAFI"=:B              %DATAFIELDPOINTER
067276   %
067276   %
067276          CALL HDLC                                 % GO TO POF AREA
067277   %
067277   %
067277   %      RETURN SEQUENCE
067277   %
067277   %      ARGUMENTS:
067277   %            B - DATAFIELDPOINTER
067277   %            T = 0, OK, GIVE SKIP RETURN
067277   %            MESSID = MESSAGE IDENTIFICATOR
067277   %  
067277   %      T ><0, ERROR, NO SKIP RETURN
067277   %
067277   %      POF
067277   %
067277   HBACK: IF T><0 THEN
067301              B+OFSET
067302   ERET1:     T=:ZAREG; GO RET                      %*81F*
067304         FI
067304         A:=MESSID; B+OFSET; A=:ZAREG
067307         ZPREG+1=:ZPREG; GO RET
067313   ERET: X=:B; GO ERET1                             % *81F*
067315   %
067315   %      ROUTINE FOR STORING IN USER PARAM
067315   %
067315   %      T - VALUE TO BE STORED
067315   %
067315   %      USER ADDR. IN DDD3 IN DATAFIELD
067315   %
067315   DISP 0; INTEGER HNULL; PSID
067315   STUSP: MLEV; *IOF; MST PIE; PION                 %MUST ALLOW PAGEFAULT
067321          X:=B+OFSET; *BSET ZRO
067324          CALL GAPIT; CALL DALTON; *BSET ZRO
067327          A:=DDD3; A=:B; *BSET ONE
067332          T=:HNULL; X=:B; *BSET ZRO                  %STORE IN USER PARAM
067335          CALL ALTON; B-OFSET
067337          MLEV; *MCL PIE; POF
067342          GO IMHDLC                                 % CONTINUE IN ROUTINE HDLC IN POF
067343   RBUS
067356   
067356   %      START LEVEL 12/13 IN POF AREA AT ADDRESS IN T-REG
067356   %      B-REG FROM CALLIN LEVEL IS COPIED
067356   %      RETURN TO CALLER WITH PIOF
067356   
067356   SUBR STL12                                       %*80B*
067356   STL12: "SLV12"; *IOF; IRW LV12B DP               %*80B*
067361          A:=B; *IRW LV12B DB                       %*80B*
067363          A:=T; *IRW LV12B DT                       %*80B*
067365          LV12; *MST PID; PION; PIOF; EXIT          %*80E*
067372   RBUS                                             %*80B*
067374   SUBR STL13                                       %*80B*
067374   STL13: "SLV13"; *IOF; IRW LV13B DP               %*80B*
067377          A:=B; *IRW LV13B DB                       %*80B*
067401          A:=T; *IRW LV13B DT                       %*80B*
067403          LV13; *MST PID; PION; PIOF; EXIT          %*80B*
067410   RBUS                                             %*80B*
067412   
067412   
067412   %=======================================================================
067412   % 34.32     H D T M 2      H D T M 3
067412   %      OUTPUT TIMEOUT ROUTINE
067412   %
067412   %PURPOSE:    ACTIVATE TIMEOUT ROUTINE ON LEVEL 12 IN POF AREA
067412   %
067412   SUBR   HDTM2
067412   HDTM2: T:=HXTMO; GO STL12                        % *80B*
067414   RBUS
067415   %
067415   %
067415   %       INPUT TIMEOUT ROUTINE
067415   %
067415   %       PURPOSE: ACTIVATE TIMEOUT ROUTINE ON LEVEL 13
067415   %
067415   SUBR X21IN,X2STA,X21TO
067415   RBUS
067415   SUBR HDTM3
067415   HDTM3: T:=HXTMO; GO STL13                        % *80B*
067417   RBUS
067420   %
067420   %      SOME ROUTINES TO GET INTO PIT3 FROM POF
067420   
067420   SUBR X32ST,X321T,O3CHA,S3L13,D3CHA,X321I,X3T12,X3T13
067420   INTEGER SAVL,SAVL1,SAVL2
067423   INTEGER LOGBA,PHBAS                   % LOGICAL AND PHYSICAL BASE
067425   FFF:   X:="SG41"; A:=X.LOGADR/\77=:LOGBA
067431          X:=X.BPAGLINK; T:=CORMBANK; *LDATX DPAGP
067434          A=:PHBAS; EXIT
067436   X32ST: *PON
067437          GO X2STA 
067440   X321T: *PON
067441          GO X21TO
067442   X321I: *PON
067443          GO X21IN
067444   O3CHA: A:=L=:SAVL; X=:D; CALL FFF; A:=0; AD SHZ 6; A-LOGBA+PHBAS
067454          AD SHZ -6; D=:X; *POF
067457          CALL OCHAIN; *PON
067461          A:=SAVL=:P
067463   S3L13: A:=L=:SAVL1; *POF
067466          CALL STL13; *PON
067470          A:=SAVL1=:P
067472   D3CHA: A:=L=:SAVL2; *POF
067475          CALL DICHAIN; GO NSKIP
067477          MIN SAVL2; P+0
067501          X=:D; CALL FFF; A:=0; AD SHZ 6; A-PHBAS+LOGBA; AD SHZ -6; D=:X
067511   NSKIP: *PON
067512          A:=SAVL2=:P
067514   X3T12: *POF
067515          GO DRIVER
067516   X3T13: *POF
067517          T=:P
067520   RBUS
067531   
067531   
067531   %=========================================================================
067531   %      I N B X 2 1
067531   %
067531   % SUBROTINE TO SET UP THE PHYSICAL ADDRESS OF THE "X21-BUFFERS" INTO
067531   % THE "X21" DATAFIELDS
067531   %
067531   % CALLED FROM OLDSTART
067531   %
067531   SUBR INBX21
067531   
067531   INTEGER ARRAY ADRX21(0)
067531   *"8C1X2
"067531   *      X21F1;X2S01;X2E01
067534   *"8C2X2
"067534   INTEGER ARRAY EAX21(0)
067534   *"8C1X2+8C2X2+8C3X2+8C4X2+8C5X2+8C6X2
"067534   INTEGER CINDX,CADR,16BADR; DOUBLE DCAD=CADR
067537   DISP 0; TRIPLE FS0; PSID
067537   *"
"067537   INBX21:
067537   *"8C1X2+8C2X2+8C3X2+8C4X2+8C5X2+8C6X2
"067537          X:="ADRX21"=:CINDX
067541          DO WHILE CINDX<<"EAX21"
067545             X:="SG41".BPAGLINK; T:=CORMBANK; *LDDTX DPGPR
067551             A:=0; AD SHZ 12=:DCAD
067554             TAD:=CINDX.FS0; X:=T
067557             A:=:D-D-1 SH 1=:X.MAX
067564             A:=D-"XSPT3"+16BADR=:X.BUFST
067570             CADR=:X.MASTB; CINDX+3=:CINDX
067575          OD
067576   *"
"067576          EXIT
067577   RBUS
067604   
067604   
067604   *"8D023
"067604   
067604   %========================================================================
067604   %  34.36     E D T R M
067604   % 
067604   % MONITOR CALL TO ENABLE/DISABLE PROGRAM TERMINATION HANDLING
067604   %
067604   % MONITOR CALL (206): ISTAT=EDTRM(<ENABLE/DISABLE>,<RT/UB/FE>
067604   %                                 <  1   /   0   >,< 0/ 1/ 2>
067604   %
067604   %
067604   
067604   SUBR EDTRM
067604   
067604   EDTRM: CALL GET2
067605          IF BACKGROUND><0 THEN
067607                IF D1=0 GO ILLPA
067611          ELSE
067612                IF D1>0 GO ILLPA
067615          FI
067615          IF D1=0 THEN          % RT
067617                IF D0=0 THEN    % DISABLE
067621                   0=:FLRTTERM
067622                ELSE            % ENABLE
067623                   IF RTTERM=0 GO ILLPA
067625                   1=:FLRTTERM
067627                FI
067627          ELSE                  % BACKGROUND
067630                MLEV; *MST PIE  % ENABLE MONITOR LEVEL
067632                T:=5OPSEG; X:="PETECOM"; CALL GET1L; GO ERR
067636                IF A="TECBUF" GO ILLPA
067641                IF D1 BIT "0" THEN % USER-BREAK
067644                   IF D0=0 THEN   % DISABLE
067646                      FLBGTERM BZERO "0"=:FLBGTERM
067651                   ELSE           % ENABLE
067652                      FLBGTERM BONE "0"=:FLBGTERM
067655                   FI
067655                FI
067655                IF D1 BIT 1 THEN % FATAL-ERROR
067660                   IF D0=0 THEN   % DISABLE
067662                      FLBGTERM BZERO 1=:FLBGTERM
067665                   ELSE           % ENABLE
067666                      FLBGTERM BONE 1=:FLBGTERM
067671                   FI
067671                FI
067671          FI; A:=0; GO OUT
067673   
067673   ERR:   -1; GO OUT            % ERROR WHEN ACCESSING OPCOM SEGMENT
067675   ILLPA: 174                   % ILLEGAL PARAMETER
067676   OUT:   A=:ZAREG; GO RET
067700   RBUS
067711   
067711    
067711   %========================================================================
067711   %  34.37     M P A S E T   M P A G E T
067711   %
067711   %  MONITOR CALL TO SET (56) AND GET (57) USER PARAMETERS
067711   %  CALLABLE FROM BACKGROUND ONLY
067711   %
067711   %  IERR=PASET(APAR),  IERR=PAGET(APAR)
067711   %
067711   
067711   SUBR MPASET,MPAGET
067711   
067711   DISP 0; REAL FS0=S0; DOUBLE DIS3=S3; PSID
067711   
067711   MPASET: K:=1; GO FSGPAR
067713   MPAGET: K:="0"
067714   FSGPAR: T:="P0"; CALL GET0; T=:D0
067717          IF DEMAND><0 THEN MLEV; *MST PIE
067723          FI
067723          IF K THEN             % SET PARAMETERS
067725                X:=D0; CALL ALTON; X.FS0; CALL ALTOF; TAD=:"USPAR".FS0
067733                X:=D0; CALL ALTON; X.DIS3; CALL ALTOF; AD=:"USPAR".DIS3
067741          ELSE                  % GET PARAMETERS
067742                "USPAR".FS0; X:=D0; CALL ALTON; TAD=:X.FS0; CALL ALTOF
067750                "USPAR".DIS3; X:=D0; CALL ALTON; AD=:X.DIS3; CALL ALTOF
067756          FI; A:=0
067757   OUT:   A=:ZAREG; GO RET
067761   
067761   RBUS
067767   
067767   
067767   %=============================================================================
067767   %  34.38     R E R R P
067767   %
067767   %  MONITOR CALL (207) TO READ ERROR PARAMETERS (9ERRP+ABPRO)
067767   %
067767   %  CALL RERRP(IARR)
067767   %
067767   %      IARR(1) = ERNUMB (ASCII)
067767   %      IARR(2) = ERPREG
067767   %      IARR(3) = N1 (A-REG)
067767   %      IARR(4) = N2 (T-REG)
067767   %      IARR(5) = RTPROG
067767   %      IARR(6) = ABPRO (0 IF ABORTED BY SYSTEM, ELSE RTPROG)
067767   %
067767   
067767   SUBR RERRP
067767   
067767   DISP 0; REAL FS0=S0,FS1=S3; PSID
067767   
067767   RERRP: T:="P0"; CALL GET0; T=:D0
067772          IF DEMAND><0 THEN MLEV; *MST PIE
067776          FI; RTREF=:D; D0; T:=6; CALL CHLIM; GO ILLAD
070004          "9ERRP".FS0; X:=D0; CALL ALTON; TAD=:X.FS0; CALL ALTOF
070012          "9ERRP".FS1; X:=D0; CALL ALTON; TAD=:X.FS1; CALL ALTOF
070020          A:=0
070021   OUT:   A=:ZAREG; GO RET
070023   ILLAD: 153; GO OUT           % ILLEGAL ADDRESS REF. IN MONITOR CALL
070025   
070025   RBUS
070035   
