043203  
043203  )MCDEF BLIDV $NAM
       0;0;$NAM O
$NAM I, 0;0;*-2;102;0;0;0;0;0;IMTRI;0;0

       $NAM I
$NAM O, 0;0;*-2;102;0;0;0;0;0;IMTRO;0;0
]
043203  
