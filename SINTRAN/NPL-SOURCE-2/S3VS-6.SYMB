074335   
074335   INTEGER ARRAY FXCTAB(0)
074335   * FXCTA<*+NALME+NALME; )ZERO; *+NALME+NALME/
074357   
074357   
074357   INTEGER PAGPN                % MEMORY MAP ELEMENT ADDR OF FIRST PAGE
074360                                % LINKED OUT BY MON 61
074360   
074360   %===========================================================================
074360   % 36.14      F I X C   P F I X C   F I X C 5 0 0
074360   %
074360   
074360   SUBR FIXC,PFIXC,FIXC500
074360   
074360   BASE BFIXC
074360   INTEGER SGADR,FPHYS,SG1ADR:=XSGRT,OLDFLAG
074364   INTEGER CMMENTRY,CSEGN,STEPINCR,CCORMSTART,CECORMAP,BREG
074372   INTEGER COLDFLAG,CINDX
074374   INTEGER PGFOUND,PREVPGFOUND
074376   INTEGER CFPHYS,CT,CA,CD,CLOGPAGE,CCECORMAP
074404   INTEGER POINTER LINK
074405   TRIPLE CTAD=CT
074405   INTEGER FIXFLAG
074406   INTEGER NPAGES; INTEGER CCTINDX=NPAGES
074407   INTEGER AFPHYS,NPARTS=AFPHYS
074410   INTEGER ALPHYS; DOUBLE ARRAY POINTER DPARTADDR=ALPHYS
074411   INTEGER NSHARED; INTEGER POINTER RNPARTS=NSHARED; INTEGER MXMININTERVAL=NSHARED
074412   INTEGER ARRAY POINTER ARRPNT; DOUBLE ARRAY POINTER DRETADDR=ARRPNT
074413   DOUBLE ARRAY POINTER DARRPNT=ARRPNT
074413   TRIPLE ARRAY POINTER FARRPNT=ARRPNT
074413   INTEGER ARRAY POINTER PCCTAB:=CCTAB
074414   DOUBLE ARRAY POINTER DPCCTAB=PCCTAB
074414   DOUBLE POINTER DCCFPA:=CCFPA
074415   INTEGER PREVT,PREVX
074417   TRIPLE T5D1=NPAGES; DOUBLE D5DD4=NSHARED
074417   INTEGER CURPAGE,CPEND; DOUBLE CCAREA=CURPAGE
074421   INTEGER CNPAGES=CPEND, CSGNO=CPEND, CTINDX=CPEND
074421   INTEGER CBPGLINK
074422   INTEGER PARTINDX,RETINDX
074424   INTEGER POINTER RINDXADDR
074425   INTEGER SVFLAGB
074426   ESAB
074426   
074426   DISP 0; TRIPLE TD1=D1; DOUBLE DD4=D4; PSID
074426   INTEGER POINTER PPTTIF:=TTIFIELD
074427   
074427   FIXC:  CALL GET2; D1=:"BFIXC".FPHYS
074433          IF D0 BZERO 17<=0 OR A>SGMAX GO ERRIL     % ILLEGAL SEGMENT NUMBER
074442          A*5SEGSIZE+SEGSTART=:X.SGADR
074445          IF A.FLAG=0 OR A BIT 5INHB GO ERRNL       % SEGMENT NOT LOADED
074452          IF A BIT 5DEMAND GO ERRD                  % DEMAND SEGMENT NOT LEGAL
074454          T:="BFIXC"; T:=:B; T=:BREG
074457          IF A BIT 5FIX THEN                        % SEGMENT ALREADY FIXED
074461   % CHECK IF FIXED CONTINUOUS IN CORRECT ADDRESS
074461             FPHYS=:CURPAGE; X:=X.BPAGLINK; T:=CORMBANK
074465             DO
074465                *LDATX DPAGP
074466                IF A-CURPAGE><0 THEN BREG=:B; GO ERRFX FI  % ERROR, FIXED IN WRONG ADDR.
074473                MIN CURPAGE; *LDXTX DPAGL
074475             WHILE X><0
074476             OD; BREG=:B
074501             IF D0 BIT 17 THEN A:=0; GO FXRET FI; GO RETSTUPR % SEGMENT FIXED OK.
074507          FI
074507          IF SGADR.LOGADR SHZ -10=0 THEN BREG=:B; GO ERRNL FI % ERROR, EMPTY SEGMENT
074516          A=:NPAGES
074517          IF A+FIXPAGES>FIXMAX THEN BREG=:B; GO ERRF FI  % TOO MANY FIXED PAGES
074526          0=:FIXFLAG
074527   L1:    IF BACKGROUND><0 THEN
074531             PPTTIF.FLAGB=:SVFLAGB; CALL ESCOFF
074535          FI
074535          CALL S3NOALPIT                  % ALT PIT=NORM PIT=3
074536          GO PFIXC; *)FILL
074554   
074554   
074554   ERRIL: IF D0 BIT 17 THEN A:=-2; GO FXRET FI
074561          CALL 9ERRA(#15); GO RETXIT        % ILL.SEGM.NO.
074564   ERRNL: IF D0 BIT 17 THEN A:=-3; GO FXRET FI
074571          CALL 9ERRA(#16); GO RETXIT    % NOT LOADED
074574   ERRD:  IF D0 BIT 17 THEN A:=-4; GO FXRET FI
074601          CALL 9ERRA(#17); GO RETXIT    % FIXING DEMAND
074604   ERRF:  IF D0 BIT 17 THEN A:=-5; GO FXRET FI
074611          CALL 9ERRA(#18); GO RETXIT    % TOO MANY PAGES FIXED
074614   ERRFX: IF D0 BIT 17 THEN A:=-6; GO FXRET FI
074621          CALL 9ERRA(#25); GO RETXIT    % ALREADY FIXED
074624   
074624   FXRET: A=:ZAREG; GO RETSTUPR         % RETURN TO USER PROGRAM
074626   
074626   %=========================================================================
074626   % SPECIAL MONITOR CALL TO ALLOCATE MEMORY SPACE FOR NORD-500 SEGMENTS
074626   % AND/OR FIXC (IN MEMORY AREA)/ ALLOCATE BUFFER (IN MEMORY AREA)
074626   %
074626   %
074626   % FUNCTION=1:      ALLOCATE MEMORY FOR NORD 500 SEGMENT - ONE USER VERSION
074626   %
074626   % PAR1:      NUMBER OF PAGES IN SEGMENT
074626   % PAR2:      FIRST LEGAL PHYSICAL PAGE FOR SEGMENT
074626   % PAR3:      LAST LEGAL PHYSICAL PAGE FOR SEGMENT
074626   % PAR4:      NUMBER OF SINTRAN III/N500 SHARED AREAS
074626   % PAR5:      ADDRESS OF SHARED INFORMATION ARRAY (PHYSICAL ADDRESS)
074626   %
074626   % RETURN:    ERROR - NO AREA ALLOCATED FOR NORD-500
074626   %
074626   % SKIP RETURN:  MEMORY ALLOCATED FOR NORD-500 SEGMENT
074626   %               A=FIRST PHYSICAL PAGE IN NORD-500 SEGMENT
074626   %               NUMBER OF FIXED SINTRAN III SEGMENTS  IS RETUNED
074626   %               IN THE "SHARED INFORMATION ARRAY"
074626   %
074626   %
074626   % FUNCTION=2:    GIVE N500 SWAPPING PAGES
074626   %
074626   % PAR1:      NO. OF PAGES
074626   % PAR2:      NO. OF N500 HARDWARE CONFIGURATION MEMORY PARTS
074626   % PAR3:      ADDRESS OF N500 HARDWARE CONFIGURATION MEMORY PARTS TABLE
074626   %            (PHYSICAL ADDRESS)
074626   % PAR4:      MAX NO. OF MEMORY INTERVALS TO RETURN
074626   % PAR5:      ADDRESS OF TABLE TO RETURN THE AVAILABLE MEMORY PARTS INTO
074626   %            (PHYSICAL ADDRESS)
074626   %
074626   % RETURN:    ERROR
074626   % SKIP RETURN: A = NO. OF MEMORY INTERVALS
074626   %
074626   %
074626   % FUNCTION=3:   TAKE PAGES FROM N500
074626   %
074626   % PAR1:      NO. OF PAGES
074626   % PAR2:      NO. OF MEMORY PARTS
074626   % PAR3:      ADDRESS OF MEMORY PARTS TABLE (PHYSICAL ADDRESS)
074626   % PAR4:      DUMMY
074626   % PAR5:      DUMMY
074626   %
074626   % RETURN:    ERROR
074626   % SKIP RETURN: OK
074626   %
074626   %
074626   % FUNCTION=4:   FIX A SEGMENT CONTIGOUSLY AT ANY ADDRESS WITHIN A
074626   %               SPECIFIED AREA
074626   %
074626   % PAR1:      SEGMENT NUMBER
074626   % PAR2:      FIRST (LOWER) LEGAL PHYSICAL PAGE NUMBER
074626   % PAR3:      LAST (UPPER) LEGAL PHYSICAL PAGE NUMBER
074626   % PAR4:      DUMMY
074626   % PAR5:      DUMMY
074626   %
074626   % RETURN:    A=0: AREA OCCUPIED
074626   %            A=1: "PAR2">>LAST PAGE IN MEMORY MAP
074626   %            A=2: SOMETHING WRONG WITH THE SEGMENT (DEMAND, ALREADY FIXED...)
074626   %
074626   % SKIP RETURN:  SEGMENT IS FIXED CONTIGOUSLY, A=FIRST PHYSICAL PAGE IN SEGMENT
074626   %
074626   %
074626   % FUNCTION=5:   RESERVE A CONTIGOUS MEMORY AREA
074626   %
074626   % PAR1:      NUMBER OF PAGES TO RESERVE
074626   % PAR2:      FIRST (LOWER) LEGAL PHYSICAL PAGE
074626   % PAR3:      LAST (UPPER) LEGAL PHYSICAL PAGE
074626   % PAR4:      DUMMY
074626   % PAR5:      DUMMY
074626   %
074626   % RETURN:    ERROR:
074626   %            A=0: AREA OCCUPIED
074626   %            A=1: "PAR2" >> LAST PAGE IN MEMORY MAP
074626   %            A=2: NO FREE TABLE ELEMENT (TRYING TO RESERVE TO MANY AREAS)
074626   %
074626   % SKIP RETURN:  OK, A=FIRST PHYSICAL PAGE IN AREA, T=TABLE INDEX
074626   %
074626   %
074626   % FUNCTION=6:   RELEASE MEMORY AREA RESERVED BY FUNCTION=5
074626   %
074626   % PAR1:      TABLE INDEX (RETURN PARAMETER FROM FUNCTION=5)
074626   % PAR2:      FIRST PHYSICAL PAGE IN AREA (FROM FUNCTION=5)
074626   % PAR3:      DUMMY
074626   % PAR4:      DUMMY
074626   % PAR5:      DUMMY
074626   %
074626   % RETURN:    ERROR
074626   %
074626   % SKIP RETURN:  OK
074626   %
074626   %
074626   % FUNCTION=7:   RELEASE ALL MEMORY AREAS RESERVED BY A SPECIFIC PROGRAM.
074626   %               THE MEMORY AREAS MUST BE RESERVED BY FUNCTION=5 IN MON 61.
074626   %
074626   % PAR1:      RT-PROGRAM WHICH HAS RESERVED THE MEMORY AREAS
074626   %            PAR1=0 MEANS CALLING PROGRAM.
074626   % PAR2:      DUMMY
074626   % PAR3:      DUMMY
074626   % PAR4:      DUMMY
074626   % PAR5:      DUMMY
074626   %
074626   % RETURN:    ERROR
074626   %
074626   % SKIP RETURN: OK
074626   %
074626   %
074626   %
074626   % FUNCTION=10:  GET SEGMENT'S FIXED-STATUS
074626   %
074626   % PAR1:      SEGMENT NUMBER
074626   % PAR2:      PAGE NUMBER WITHIN SEGMENT TO FIND THE PHYSICAL MEMORY PAGE OF,
074626   %            IF THE SEGMENT IS FIXED.
074626   %            <PAR2>=0 IS ALLWAYS FIRST PAGE IN SEGMENT.
074626   % PAR3:      DUMMY
074626   % PAR4:      DUMMY
074626   % PAR5:      DUMMY
074626   %
074626   % RETURN:    ERROR; A=174 : ILLEGAL SEGMENT NUMBER <PAR1> OR ILLEGAL PAGE
074626   %                           NUMBER WITHIN SEGMENT <PAR2>
074626   %                   A=2   : SEGMENT NOT LOADED
074626   %
074626   % SKIP RETURN: OK, T=FIXED STATUS
074626   %                  T=0 : SEGMENT NOT FIXED
074626   %                  T=1 : SEGMENT FIXED SCATTERED
074626   %                  T=2 : SEGMENT FIXED CONTIGUOUSLY
074626   %                  A=PHYSICAL PAGE NUMBER WHER <PAR2> PAGE RESIDE IN MEMORY
074626   %                  D=SEGMENT-TABLE-ELEMENT.FLAG 
074626   %
074626   
074626   FIXC500:
074626          CALL GET6
074627          IF D0>>10 GO ERET; A=:"BFIXC".FIXFLAG
074635          IF A<4 AND PN500=0 GO ERET
074642          TAD:=TD1=:X.T5D1; AD:=DD4=:X.D5DD4
074646          X:=:B=:BREG; GO L1
074651   ERET:  174=:ZAREG; GO RET
074654   RBUS
