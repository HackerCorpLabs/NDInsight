115520   SUBR SEGADM 
115520   INTEGER POINTER LREG; INTEGER BREG
115522   INTEGER XREG=?
115522   
115522   SEGADM: IF X=FIXCRT GO XCSEGS
115525          T:=L=:"LREG":=B=:BREG; X=:XREG
115532          A=:D SHZ -10; IF ><0 THEN A*5SEGSIZE+SEGSTART FI; A=:NSEGA
115540          377/\D;       IF ><0 THEN A*5SEGSIZE+SEGSTART FI; A=:NSEGB
115546          X.RSEGM/\377; IF ><0 THEN A*5SEGSIZE+SEGSTART FI; A=:NSEGC
115554   SLOWS: NSEGA=:B; CALL SEGCHECK; IF A<0 THEN CALL SEGIN FI
115561          NSEGB=:B; CALL SEGCHECK; IF A<0 THEN CALL SEGIN FI
115566          NSEGC=:B; CALL SEGCHECK; IF A<0 THEN CALL SEGIN FI
115573          CALL XCSEGS           % CLEAR PAGETABLES
115574          NSEGC=:SEGMC; CALL STSEG; NSEGC; X:=RTREF; CALL CLNREENT
115602          NSEGA=:SEGMA; CALL STSEG; NSEGB=:SEGMB; CALL STSEG
115610   FELLS: XREG=:SEGPROG
115612          A:=0; IF X:=SEGMA><0 THEN X.FLAG FI
115616          IF X:=SEGMB><0 THEN A\/X.FLAG FI
115621          IF A NBIT 5SYSEGM THEN CALL SETRT FI
115624   *"8LAMU
"115624          CALL SLAMU
115625   *"
"115625   OUT:   BREG=:B; X:=XREG; GO LREG
115631   INTEGER XREG
115632   *)FILL
