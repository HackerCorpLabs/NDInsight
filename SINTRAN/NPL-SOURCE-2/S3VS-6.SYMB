120321   % 37.16      L I N K O V E R
120321   
120321   %SUBROUTINE TO LINK PAGES OVER TO REQUESTING SEGMENT
120321   % ENTRY: B=REQ.SEGMENT (SEGREF)
120321   %        X=LRU-SEGM
120321   
120321   SUBR LINKOVER
120321   INTEGER CURPAGE,CNUMBER,LRUSEG,CSEGN,CALOGNO
120326   INTEGER POINTER LREG
120327   LINKOVER: A:=L=:"LREG"; X=:LRUSEG; NUMBER=:CNUMBER; B=:A; CALL CSEGS
120336          IF FLAG BIT 5FIX THEN CALL ERRFATAL FI
120342          A:=B-SEGSTART=:D:=0; T:=5SEGSIZE; *RDIV ST
120350          IF D><0 THEN CALL ERRFATAL FI; A=:CSEGN; T:=CORMBANK
120355          FOR CNUMBER DO WHILE X:=LRUSEG.BPAGLINK><0
120360             *LDATX DPGPR
120361             IF A BIT 5WIP GO OUT
120363             X=:CURPAGE; *LDATX DPAGL
120365             A=:LRUSEG.BPAGLINK
120367             IF X:=BPAGLINK=0 THEN
120372                IF SEGLINK=0 THEN BSEGLINK=:SEGLINK; SEGREF=:BSEGLINK FI
120400                LOGADR/\377-NUMBER
120403             ELSE
120404                *LDATX DALOG
120405             FI; A=:CALOGNO:=CURPAGE; A:=:X; *STATX DPAGL
120411             X=:BPAGLINK; CSEGN=:D
120414             IF FLAG NBIT 5DEMAND THEN CALOGNO-1 ELSE CPNUMB FI
120423             *STDTX DALOG
120424          OD
120426   OUT:   IF LRUSEG.BPAGLINK=0 THEN CALL SREMOVE FI
120432          GO LREG
