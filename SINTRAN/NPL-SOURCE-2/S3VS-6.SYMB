130502   %
130502   %*************************************************
130502   
130502   SUBR X2119,X2120,X2121,X2116
130502   
130502   
130502    
130502    
130502   %      DCE CLEAR INDICATION                     ** STATE 19 **
130502   %      D = 0  I = OFF
130502   
130502   X2119: A:=L=:X2DSR; 23=:X2DST; CALL STORE
130507          A:=X2DSR=:P
130511     
130511   
130511   
130511   %      CLEAR (DTE UNCONTROLLED)                 ** STATE 20 **
130511   %      T = 0  C = OFF
130511   
130511   X2120: A:=L=:X2DSR; 24=:X2DST; CALL STORE
130516          CALL X21SH                                % SYN = HIGH TO DETECT STATE 21
130517          140; T:=X2DHD+XWTTC; *EXR ST              % T = 0
130523          7=:X2D11; T+"XWRTC-XWTTC"; *EXR ST        % C = OFF
130527          A:=X2DSR=:P                               % EXIT
130531    
130531    
130531   %      DCE READY (DTE UNCONTROLLED)             ** STATE 21 **
130531   
130531   X2121: A:=L=:X2DSR; 25=:X2DST; CALL STORE
130536          DO CALL X2GET; A=:A                       %
130540          WHILE T=0 OR X2D00><"X21EN" OR X2D10 BIT "6" OR X2DDF NBIT 17
130554                                                    % WAIT FOR R = 1, C = OFF,ST 21
130554          OD                                        
130555          0=:TMR
130556          A:=X2DSR=:P                               % EXIT
130560       
130560   
130560   %      DTE CLEAR REQUEST
130560   %      T = 0  C = OFF
130560   
130560   X2116: A:=L=:X2DSR; 20=:X2DST; CALL STORE        % RETURN ADDR
130565          CALL X21SH                                % SYN = HIGH,
130566          140; T:=X2DHD+XWTTC; *EXR ST              % T = 0
130572          207=:X2D11; X21T5=:TMR                    % C = OFF, TIMING UNTIL ST. 21
130576          A:=X2DSR=:P                               % EXIT
