121554   
121554   INTEGER CCIOX
121555   CLADV: 5IOXARR(0)=:500IOX
121560          0=:CCIOX
121561          DO
121561             IF CCIOX=500IOX THEN                   % ND-500 DEVICE NUMBER
121565                CALL 5MCST; X:=5IX+1=:5IX; 5IOXARR(X)=:500IOX
121573                CCIOX+20=:CCIOX; GO NXIOX
121577             FI; X:=0
121600             DO WHILE X<<"USDVSIZE*2"               % DO NOT CLEAR USER RESERVED DEV.NO'S
121603                AD:=USIOXTAB(X)
121604                IF A>>=CCIOX AND D<<=T THEN
121611                   A:=D/\177774=:CCIOX; GO NXIOX
121615                FI; X+2
121616             OD; T:=CCIOX+"DCONT"; A:=20; *IOXT     % CLEAR DEVICE
121623   NXIOX: WHILE CCIOX+4><0
121626             A=:CCIOX
121627          OD; GO L1
121631   *)FILL
121635   INTEGER CCNTRG
121636   
121636   L1:
121636          LGCOLDSTART; CALL LOGPH
121640          IF A=0 OR A.TYPRING NBIT 5TERM THEN X:="DT01R" FI
121646          T:="CNTREG"; CALL XGTDFADDR; A BZERO "0"=:CCNTRG
121652          T:="HDEV"; CALL XGTDFADDR; T:=A+DCONT; CCNTRG; *IOXT
121660          IF VDDFLAG = 0 THEN
121662   
121662   %         ONLY IF SWAPPING NOT DONE VIA VDD/VDP PAIR.
121662   %         CLEAR SWAPPING DEVICE (CLEAR DEVICE AND READ STATUS, THEN WAIT FOR READY)
121662        
121662             MASSNO(0); CALL LOGPH; A.HDEV+"164000+5"=:T; 20; *EXR ST
121673             IF T BIT 11 THEN A:=34004; *EXR ST    % RETURN TO ZERO SEEK IF BIG DISC
121677             FI; T-1                               % READ STATUS (4=READ STATUS)
121700   DDLAY:    FOR X:=-200 DO; OD                    % DELAY
121702             *EXR ST; BSKP ZRO 160 DA; JMP ADLAY   % ON CYLINDER
121705             *BSKP ONE 030 DA; JMP DDLAY           % UNTIL ON CYLINDER
121707          FI
121707   ADLAY: *BSET ZRO SSZ
121710          *TRA IIC; TRA PEA; TRA PGS
121713          "0"; *TRR PID; TRR PIE
121716          "LV0"; *IRW 0 DP; ION
121721   LV0:   *IOF
121722          IMASK; *TRR IIE
121724   % SET CACHE INHIBIT AND CLEAR:
121724          IF CPSTA BIT 5N100 THEN
121727            LCACHLIM; *TRR 11             % LOWER LIMIT
121731            UCACHLIM; *TRR 12             % UPPER LIMIT
121733          ELSE
121734            CACHLIM; *TRR 12
121736          FI; *TRR 10
121737          GO BYPAX; *)FILL
121760   
121760   %%%    INITIALIZE BUS EXPANDER
121760   
121760   INTEGER CURBX                          % TRACKING OF BUS EXPANDER ADDRESS
121761   
121761   BYPAX:
121761   *"8BEX1
"121761   
121761          GO L2; *)FILL
121762   
121762   % RESTORE REGISTER BLOCKS
121762   INTEGER LEVCN,LRBI(0); *LRB 10
121764   L2:    X:="LEV1"; -16=:LEVCN; LRBI
121770          FOR LEVCN DO; *EXR SA
121771                X+10; A+10 OD
121775          "FREQU+160001"; *IOX DCONT RTCLD
121777          9TIM0; *IOX DDW RTCLD
122001          PIEREG; *TRR PIE
122003          PIDREG ; *TRR PID
122005          IF PIDREG><0 THEN
122007   *"8CLI1+8CLI2+8CLI3+8CLI4+8CLI5+8CLI6
"122007                IF X:=URESTART><0 THEN; *JPL ,X
122012                FI
122012                IF URPRO><0 THEN A=:URERTP
122015                  "URERTP"+3=:B; MQUEU=:MLINK; A:=B=:MQUEU
122024                FI
122024          FI
122024   @LIB CXCPU
122024          GO PENT0
122025   *)FILL
122037   
122037   % SUBROUTINE TO SET SPEED FOR TERMINAL BUFFER AND MULTITERMINAL INTERFACE
122037   % THE SPEED IS FOUND IN INPUT DATAFIELD; -1 MEANS DO NOT SET SPEED
122037   
122037   INTEGER POINTER INDXX,CLREG; INTEGER ICNTI,CHDEV
122043   DISP 12; INTEGER CCDFILD; PSID
122043   TBUSPEED: A:=L=:"CLREG"
122045          X=:D; "TMRTE"-2=:"INDXX"
122051          DO WHILE X:=INDXX><-1 OR "INDXX"="TMRTE"  % IN TIMER TABLE
122061                IF X><0 AND X><-1 THEN
122065                   IF X.TYPRING BIT 5TERM THEN      % TERMINAL
122070                      T:="HDEV"; CALL XGTDFADDR; A=:CHDEV
122073                      IF A NBIT 2 THEN
122075                         T:="TSPEED"; CALL XGTDFADDR
122077                         IF A+1><0 THEN
122101                            T:=CHDEV+1; A-1; *IOXT
122105                FI FI FI FI; MIN "INDXX"
122106          OD
122107          1=:ICNTI
122111          FOR ICNTI TO MXLIN DO          % SET SPEED FOR SIN/SIN COMMUNICATION
122115            X:=LINAR(ICNTI); IF X.TSPEED><-1 THEN
122123              T:=X.CCDFILD.HDEV+1; *EXR ST
122127            FI
122127          OD D=:X; GO CLREG
122135   
122135   %SUBROUTINE TO SET CONTENTS TO PAGETABLE
122135   INTEGER XWIP
122136   RSPTABL: IF =0 THEN EXIT FI; A=:D
122141          IF A=SEGMC AND A.FLAG BIT 5WPM AND X:=X.BPAGLINK><0 THEN
122152             T:=CORMBANK
122153             DO
122153                *LDBTX DALOG; 177700; LDDTX DPGPR        % MIC. PROGRAM BUG!!!!
122156                AD=:DOU0; *LDXTX DPAGL
122160             WHILE X><0
122161             OD
122162          ELSE
122163             IF D.FLAG BIT 5WPM THEN 10000 ELSE A:=0 FI; A=:XWIP
122173             IF X:=X.BPAGLINK=0 THEN EXIT FI; T:=CORMBANK
122200             DO
122200                *LDBTX DALOG; 177700; LDDTX DPGPR        % MIC. PROGRAM BUG!!!!
122203                A\/XWIP; AD=:DOU0; *LDXTX DPAGL
122206             WHILE X><0
122207             OD
122210          FI; EXIT
122211   RBUS
122221   @ICR
122221   INTEGER ARRAY LEV1:=(
122221   ERRFA,0,0,0,0,0,0,0,
122231   ERRFA,0,0,0,0,0,0,0,
122241   MONEN,0,0,0,0,0,0,0,
122251   ERRFA,0,0,0,0,0,0,0,
122261   ERRFA,0,0,0,0,0,0,0,
122271   ERRFA,0,0,0,0,0,0,0,
122301   ERRFA,0,0,0,0,0,0,0,
122311   ERRFA,0,0,0,0,0,0,0,
122321   ERRFA,0,0,0,0,0,0,0,
122331   ID10+5,0,0,0,0,0,0,0,
122341   ID11+5,0,0,0,0,0,0,0,
122351   ID12+5,0,0,0,0,0,0,0,
122361   ID13+5,0,0,0,0,0,0,0);
122371   INTEGER LEV14:=(
122371   ENT14,0,0,0,0,0,0,0);
