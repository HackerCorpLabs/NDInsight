117704          *LDD 15,B; BSET ONE; STD 6,X; BSET ZRO
117710          OLDPAGE/\600 SH -7+1; *BSET ONE; STA 10,X; BSET ZRO
117717          OLDPAGE/\177174+200=:OLDPAGE; BPHANDLER(CUIDX)=:ZPREG
117726          GO FAR RETU
117727   *)FILL
117746   
117746   3DEBUGGER: IF ZTREG>>5 GO FAR RETU
117752          A GOSW GETDSEG,PLAC1,FAR PSTART,FAR READLOC,FAR WRITLOC,RELDSEG
117761   
117761   GETDSEG:
117761            FOR X:=0 TO NMAXUSERS-1 DO
117766              IF DBGPROGS(X)=RTREF GO SGFOUND
117772            OD
117774            FOR X:=0 TO NMAXUSERS-1 DO
120001              IF DBGPROGS(X)=0 AND DATSEG(X)><0 THEN RTREF=:DBGPROGS(X); GO SGFOUND FI
120010           OD; GO FAR RETU
120013   SGFOUND: X=:CUIDX
120014          RTREF.ACTSEG/\177400+DATSEG(CUIDX)=:T=:DBGSEGS(X)
120023          CALL MMEXY; T=:OLDSEG(X);T=:A; A/\377*5SEGSIZE+SEGSTART=:X
120032          IF X.LOGADR SHZ -10=200 THEN T:=100 ELSE T:=0 FI
120042          X.LOGADR/\300+T SH 1=:APTNO(CUIDX)
120050          RTREF.RSEGM=:DBUGSEG(CUIDX)
120054          MIN ZPREG; 0/\0; GO FAR RETU
120057   *)FILL
120103   
120103   RELDSEG: CALL FINDINDEX; GO FAR RETU; 0=:DBGPROGS(X); MIN ZPREG; 0/\0; GO FAR RETU
120111   
120111   PLAC1: CALL FINDINDEX; GO FAR RETU
120113          ZAREG=:FILNR; 0=:BLCKNO; 7=:NWRD; "BUFFR"=:RWPAR(2)
120123          "RWPAR"; *MON 117
120125          IF A><0 THEN A=:ZAREG; GO FAR RETU FI
120130          GO PLAC2; *)FILL
120136   
120136   PLAC2: 0=:RTREF.RSEGM; CALL GETDATAFIELD 
120141          5BCOM; T:="BSTATE"; CALL XSTDFADDR
120144          T:=FILNR; X:="BUFFR"; CALL 2BDBRECOVER; GO ERET
120150          A:=0; MIN ZPREG; 0/\0
120153   ERET:  A=:ZAREG; CALL GETDATAFIELD
120155          5BUSER; T:="BSTATE"; CALL XSTDFADDR
120160          DBUGSEG(CUIDX)=:RTREF.RSEGM; T:=DBGSEGS(CUIDX); CALL MMEXY
120167          GO FAR RETU
120170             
120170   
120170   INTEGER ARRAY RWPAR:=(FILNR,"0",0,BLCKNO,NWRD)
120175   INTEGER FILNR,NWRD,64K,BLCKNO
120201   
120201   
120201   PSTART: 200=:D; CALL DALTON; *BSET ZRO
120205          CALL FINDINDEX; GO FAR RETU
120207          ZXREG=:BPHANDLER(CUIDX); ZAREG=:REGBL(X)
120214          X:=ZAREG
120215          *BSET ONE; LDF ,X; BSET ZRO; STF 7,B
120221          *BSET ONE; LDF 3,X; BSET ZRO; STF 12,B
120225          *BSET ONE; LDF 6,X; BSET ZRO; STT 15,B; STA 16,B
120232          IF D=3 THEN T:=APTNO(CUIDX) ELSE T:=200 FI; T=:D
120242          T:=OLDSEG(CUIDX); 0=:RTREF.RSEGM; CALL MMEXY
120247          OLDPAGE/\177177\/D=:OLDPAGE; GO RETU
120254   *)FILL
120300   
120300   READLOC:
120300   WRITLOC: CALL FINDINDEX; GO RETU; T:=OLDSEG(X); 0=:RTREF.RSEGM
120305          CALL MMEXY
120306          IF ZAREG><0 THEN T:=APTNO(CUIDX) ELSE T:=200 FI
120314          T=:D; CALL DALTON; *BSET ZRO
120317          X:=ZDREG
120320          IF ZTREG=3 THEN
120324             *BSET ONE; LDA ,X; BSET ZRO
120327             A=:ZAREG
120330          ELSE
120331             A:=ZXREG; *BSET ONE; STA ,X; BSET ZRO
120335          FI; T:=DBGSEGS(CUIDX); DBUGSEG(X)=:RTREF.RSEGM; CALL MMEXY
120343          MIN ZPREG; 0/\0; GO RETU
120346   
120346   FINDINDEX: FOR X:=0 TO NMAXUSERS-1 DO
120353                IF DBGPROGS(X)=RTREF THEN X=:CUIDX; EXITA FI
120361              OD; EXIT
120364   
120364   RETU:  *IOF                  % WHEN CALLING BRELEASE FROM APPL. LEVEL
120365          X:=CURPROG; CALL BRELEASE; GO RET  % RELEASE SYNC. DATAFIELD
