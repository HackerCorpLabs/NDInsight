120640   %
120640   % SUBROUTINE ON APPLICATION LEVEL TO START
120640   % TRNSEG ON MONITOR LEVEL
120640   %
120640   % ENTRY:     A=NUMBER OF PAGES TO TRANSFER
120640   %            X=ADDRESS OF CORMAP ENTRY
120640   %            D=READ/WRITE FLAG
120640   %            T=SEGMENT ADDRESS
120640   %
120640   SUBR ATRNSEG
120640   INTEGER CT,CA,CD,CX,CB; TRIPLE CTAD=CT
120645   INTEGER POINTER CLR
120646   ATRNSEG: TAD=:CTAD; X=:CX:=L=:"CLR":=B=:CB
120654   LOOP:  *IOF
120655          "YTRNSEG"; *IRW MLEVB DP
120657          CT; *IRW MLEVB DB
120661          CX; *IRW MLEVB DX
120663          CD; *IRW MLEVB DA
120665          CA; *IRW MLEVB DD
120667          MLEV; *MST PIE; MST PID
120672          CALL STMLEV; MLEV; *MCL PIE
120675          TAD:=CTAD; X:=CB=:B:=CX
120701          GO CLR
