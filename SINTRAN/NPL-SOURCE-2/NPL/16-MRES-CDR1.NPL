123275   %      DCT-2000
123275   %
123275   DCT0:  IF =0 OR =ASSYN OR =377 GO FAR MORET
123304          T:=MBSYMOD; CALL TDBPUT
123306          A/\177
123307          IF A=ASETX OR =ASEOT OR =ASACK OR=ASNAK OR=ASBEL OR =ASDC1 THEN
