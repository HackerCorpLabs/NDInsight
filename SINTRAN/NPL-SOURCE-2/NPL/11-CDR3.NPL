070306   %==============================================================================
070306   % 35.2       R T D I R
070306   %
070306   %SUBROUTINE TO START AN RT PROGRAM FROM A DIRECT TASK
070306   %A=POINTER TO AN ARRAY OF 5 LOCATIONS, THE FIRST=RT PROGRAM
070306   SUBR RTDIR
070306   DISP 7; INTEGER AREG,LREG; PSID
070306   RTDIR: B:=:A-4; A=:AREG:=L=:LREG
070313          "RTDMON"=:MFUNC; CALL RTACT
070316          LREG=:L; AREG:=:B+4; EXIT
070324   %MONITOR LEVEL:
070324   RTDMON: X.ISTATE; IF =0 THEN CALL 9ERR(#01) FI; CALL XRTCHECK
070331          CALL RTENTRY; GO STUPR
070333   RBUS
