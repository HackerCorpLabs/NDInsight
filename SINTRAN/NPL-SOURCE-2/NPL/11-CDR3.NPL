071610   *)KILL SRHWM SLHWM S1QWM S2QWM S3QWM S4QWM
071610   *)KILL C1QWM C2QWM C3QWM C4QWM
071610   

071610   
071610   
071610   % TIME USED BY SINTRAN ROUTINES:
071610   %      GET0 - 52MICS (10-54)   25MICS (10-S-02)
071610   %      ALTON- 68MICS (10-54)   33MICS (10-S-02)
071610   %      ALTOF- 56MICS (10-54)   26MICS (10-S-02)
071610   
071610   
071610   
071610   
071610   %=======     G E T F         170
071610   %
071610   % GET A NUMBER OF BUFFERS FROM FREE POOL
071610   % SET RT-PROG ADDRESS IN WPOSS-WORD OF EACH BUFFER
071610   %
071610   % GETF:      GET PARAMETERS(POOLHEAD,NO-OF-BUFFERS-REQUIRED)
071610   %            IF FALSE POOLHEAD OR ILLEGAL NO-OF-BUFFERS-REQUIRED THEN
071610   %                            NON-SKIP-RETURN(-1)
071610   %            ENDIF
071610   %            IF POOLHEAD.WNFRE<NO-OF-BUFFERS-REQUIRED THEN
071610   %                NON-SKIP-RETURN(0)
071610   %            ENDIF
071610   %            POOLHEAD WFREE=:FIRST-BUFFER=:BUFFER
071610   %            FOR COUNT:=2 TO NO-OF-BUFFERS-REQUIRED DO
071610   %                RTREF=:BUFFER.WPOSS; 0=:BUFFER.WNPAK
071610   %                BUFFER.WNBUF=:BUFFER
071610   %            ENDDO
071610   %            BUFFER.WNBUF=:POOLHEAD.WFREE
071610   %            0=:BUFFER.WNBUF
071610   %            POOLHEAD.WNFRE - NO-OF-BUFFERS-REQUIRED=:POOLHEAD.WNFRE
071610   %            SKIP-RETURN(FIRST-BUFFER)
071610   % ENTRY:     X - ADDRESS OF POOL HEAD
071610   %            A - NUMBER OF BUFFERS WANTED
071610   % EXIT:
071610   %      NON-SKIP              A=-4                POOL DESTROYED
071610   %                            A=-1                ILLEGAL PARAMETER VALUE
071610   %                            A=0                 NOT ENOUGH FREE BUFFERS
071610   %      SKIP                  A = ADDRESS OF FIRST BUFFER IN CHAIN
071610   % TIME USED: 326 MICS + 41.5 MICS*N (10-54)      N=NO. OF BUFFERS
071610   %            159 MICS + 20 MICS * N (10-S-02)
071610   %      
071610   
071610   %============================================================================
071610   % 35.30      U S O X
071610   %
071610   SUBR US0X
071610   INTEGER NUM                  % NUMBER OF BUFFERS REQUIRED
071611   INTEGER LVAR                 % LOCAL VARIABLE
071612   INTEGER ICURT                % ADDRESS OF CURRENT RT-PROG DESCRIPTION
071613   INTEGER NPOLH                % ADDRESS OF POOL HEAD
071614   INTEGER LLIM                 % LOWER LIMIT OF BUFFER POOL
071615   INTEGER HLIM                 % HIGHER LIMIT OF BUFFER POOL
071616   US0X:  CALL GET0; ZAREG=:NUM; ZXREG=:NPOLH
071623          RTREF=:ICURT
071625          CALL ALTON            % ACCESS ALTERNATIVE PAGE TABLE
071626          NPOLH.WHLIM=:HLIM; X.WLLIM=:LLIM          % SAVE BUFFER POOL LIMITS
071633          IF NPOLH.WPVER><SPCOR OR NUM<=0 OR A>SBMAX THEN A:=-1; GO NSKIP FI
071650          IF X.WNFRE-NUM<0 THEN A:=0; GO NONSK FI   % TOO FEW BUFFERS LEFT
071655          A=:X.WNFRE                                % UPDATE NUMBER OF FREE BUFFERS LEFT
071656          1=:D
071660          A:=X.WFREE=:LVAR                             % FIRST FREE BUFFER
071662          FOR D TO NUM DO
071665            IF A=:X-LLIM<<0 OR HLIM-,+X>>=0 THEN A:=-4; GO NONSK FI
071700            IF X.WNPAK><X THEN A:=-4; GO NONSK ELSE 0=:X.WNPAK FI
071706            ICURT=:X.WPOSS; A:=X.WNBUF
071711          OD
071713          0=:X.WNBUF
071714          A=:NPOLH.WFREE
071716          CALL ALTOFF; LVAR=:ZAREG; MIN ZPREG; 0/\0; GO RET
071724   NONSK:
071724   NSKIP: A=:LVAR
071725          CALL ALTOFF; LVAR=:ZAREG; GO RET; *US0=US0X
071731   RBUS
071737   
071737   
071737   
071737   
071737   
071737   
071737   
071737   %========    P U T F         171
071737   %
071737   % RETURN A CHAIN OF BUFFERS TO FREE POOL. ALL BUFFERS MUST CONTAIN
071737   % ADDRESS OF CURRENT RT-PROGRAM IN WPOSS-WORD, AND ZERO IN
071737   % WNPAK-WORD. LAST BUFFER MUST HAVE ZERO IN WNBUF-WORD. 
071737   % IT IS CHECKED THAT NUMBER OF BUFFERS DOES NOT EXCEED MAX ALLOWED
071737   % NUMBER. THIS PREVENTS INFINITE LOOP.
071737   %
071737   % PUTF:      GET PARAMETERS(POOLHEAD,PACKET)
071737   %            IF FALSE POOLHEAD OR ILLEGAL PACKET THEN NON-SKIP-RETURN(-1) ENDIF
071737   %            IF ANY-BUF-OF-PACKET.WPOSS><CURR-RT-PROG OR PACKET.WNPAK><0 THEN
071737   %                NON-SKIP-RETURN(0)
071737   %            ENDIF
071737   %            POOLHEAD.WFREE=:LAST-BUFFER-OF-PACKET.WNBUF
071737   %            PACKET=:POLLHEAD.WFREE
071737   %            0=:ALL-PACKET-BUFFERS.WPOSS
071737   %            POOLHEAD.WNFRE+NO-OF-NUFFERS-IN-PACKET=:POOLHEAD.WNFRE
071737   %            SKIP-RETURN
071737   %
071737   %
071737   % ENTRY:     X - ADDRESS OF POOL HEAD
071737   %            A - ADDRESS OF FIRST BUFFER IN CHAIN
071737   % EXIT:      
071737   %                            A=-3                TOO LONG CHAIN, DISORDER ?
071737   %      NON-SKIP              A=-2                PACKET NOT WPOSSESSED BY PROGRAM
071737   %                                                OR PACKET BELONGS TO QUEUE
071737   %                            A=-1                ILLEGAL PARAMETER VALUE
071737   %      SKIP                  BUFFER CHAIN PUT IN POOL OK
071737   % TIME USED: 320 MICS + 52 MICS * N (10-54)      N=NO OF BUFFERS IN PACKET
071737   %            154 MICS + 24 MICS * N (10-S-02)
071737   
071737   %============================================================================
071737   % 35.31      U S 1 X
071737   %
071737   SUBR US1X
071737   INTEGER IPACK                % ADDRESS OF PACKET TO RELEASE
071740   INTEGER LVAR                 % LOCAL VARIABLE
071741   INTEGER ICURT                % ADDRESS OF CURRENT RT-PROG DESCRIPTION
071742   INTEGER NPOLH                % ADDRESS OF POOL HEAD
071743   INTEGER LLIM                 % LOWER LIMIT OF BUUFER POOL
071744   INTEGER HLIM                 % HIGHER LIMIT OF BUFFER POOL
071745   US1X:  CALL GET0; ZAREG=:IPACK; ZXREG=:NPOLH
071752          RTREF=:ICURT
071754          CALL ALTON            % ACCESS ALTERNATIVE PAGE TABLE
071755          NPOLH.WLLIM=:LLIM; X.WHLIM=:HLIM
071762          IF NPOLH.WPVER><SPCOR THEN A:=-1; GO NSKIP FI
071771          IF IPACK.WNPAK><0 THEN A:=-2; GO NSKIP FI
071776          1=:D; IPACK=:LVAR     % CHECK BUFFER CHAIN
072002          FOR D TO SBMAX DO
072005            LVAR=:LVAR.WNPAK
072010            IF A=:T-LLIM<<0 OR HLIM-,+T>>=0 THEN A:=-1; GO NSKIP FI
072023            IF LVAR.WPOSS-ICURT><0 THEN A:=-2; GO NSKIP
072031            ELSE 0=:X.WPOSS; FI
072033            IF LVAR.WNBUF=:LVAR=0 GO PEND
072037          OD
072041          A:=-3; GO NSKIP
072043   PEND:  X=:T
072044          NPOLH.WFREE=:T.WNBUF
072050          IPACK=:NPOLH.WFREE
072053          NPOLH.WNFRE+D=:X.WNFRE
072057          CALL ALTOFF; MIN ZPREG; 0/\0; GO RET
072063   NSKIP: A=:LVAR
072064          CALL ALTOFF; LVAR=:ZAREG; GO RET; *US1=US1X
072070   RBUS
072076   
072076   
072076   
072076   
072076   
072076   %========   G E T Q          172
072076   %
072076   % GET A PACKET FROM START OF QUEUE
072076   % SET RT-PROG ADDRESS IN WPOSS-WORD OF EACH BUFFER
072076   %
072076   % GETQ:      GET PARAMETER(QUEUEHEAD)
072076   %            IF ILLEGAL QUEUE HEAD THEN NON-SKIP-RETURN(-1) ENDIF
072076   %            IF QUEUE EMPTY THEN NON-SKIP-RETURN(0) ENDIF
072076   %            QUEUEHEAD.WFPAK=:PACKET
072076   %            PACKET.WNPAK=:QUEUEHEAD.WFPAK
072076   %            QUEUEHEAD.WPNUM - 1
072076   %            0=:PACKET.WNPAK
072076   %            QUEUEHEAD.WPROC=:ALL-BUFFERS-OF-PACKET.WPOSS
072076   %            SKIP-RETURN(PACKET)
072076   %
072076   % ENTRY:     X - ADDRESS OF QUEUE HEAD
072076   % EXIT:      
072076   %      NON-SKIP              A=-1                ILLEGAL PARAMETER VALUE
072076   %                            A=0                 QUEUE EMPTY
072076   %      SKIP                  A = ADDRESS OF PACKET
072076   % TIME USED: 281 MICS (10-54)                    134 MICS (10-S-02)
072076   
072076   %============================================================================
072076   % 35.32      U S X 2
072076   %
072076   SUBR US2X
072076   INTEGER IPACK                % ADDRESS OF FETCHED PACKET
072077   INTEGER ICURT                % ADDRESS OF CURRENT RT-PROG DESCRIPTION
072100   INTEGER IQH                  % ADDRESS OF QUEUE HEAD
072101   US2X:  CALL GET0; ZXREG=:IQH; RTREF=:ICURT
072106          CALL ALTON            % ACCESS ALTERNATIVE PAGE TABLE
072107   GQCOM: IF IQH.WPROC><ICURT THEN A:=-1; GO NSKIP FI
072116          IF X.WPNUM=0 THEN GO NSKIP FI
072121          A:=X.WFPAK=:IPACK
072123          IF A.WNPAK=IQH THEN IQH=:IQH.WLPAK FI
072133          A=:IQH.WFPAK; X.WPNUM-1=:X.WPNUM
072140          A:=IQH.WPROC; X:=IPACK
072143          DO WHILE X><0
072144            A=:X.WPOSS; 0=:X.WNPAK; X:=X.WNBUF
072147          OD
072150          CALL ALTOFF; IPACK=:ZAREG; MIN ZPREG; 0/\0; GO RET
072156   NSKIP: A=:IPACK
072157          CALL ALTOFF; IPACK=:ZAREG; GO RET; *US2=US2X
072163   RBUS
072170   
072170   
072170   
072170   
072170   
072170   
072170   
072170   
072170   %========    P U T Q         173
072170   %
072170   % PUT A PACKET AT END OF QUEUE. WPOSS-WORD MUST CONTAIN ADDRESS
072170   % OF CALLING RT-PROGRAM. WNPAK-WORD MUST BE ZERO.
072170   %
072170   % PUTQ:      GET PARAMETER(QUEUEHEAD,PACKET)
072170   %            IF PACKET.WPOSS><CURR-RT-PROG THEN NON-SKIP-RETURN(-2) ENDIF
072170   %            IF PACKET.WNPAK><0 THEN NON-SKIP-RETURN(0) ENDIF
072170   %            QUEUEHEAD.WLPAK=:PACKET.WNPAK
072170   %            PACKET=:QUEUEHEAD.WLPAK
072170   %            DO WHILE PACKET><0 
072170   %                0=:PACKET.WPOSS; PACKET.WNPAK=:PACKET
072170   %            ENDDO
072170   %            QUEUEHEAD.WPNUM + 1
072170   %            SKIP-RETURN
072170   %
072170   % ENTRY:     X - ADDRESS OF QUEUE HEAD
072170   %            A - ADDRESS OF PACKET
072170   % EXIT:      
072170   %      NON-SKIP              A=-2                PACKET NOT WPOSSESSED BY PROGRAM OR
072170   %                                                PACKET BELONGS TO QUEUE
072170   %      SKIP                  PACKET PUT IN QUEUE
072170   % TIME USED:
072170   %      PUTQ: 320 MICS (NORD-10)                  165 MICS (10-S)
072170   
072170   %============================================================================
072170   % 35.33      U S X 3
072170   %
072170   SUBR US3X
072170   INTEGER IPACK                % ADDRESS OF PACKET TO PUT IN QUEUE
072171   INTEGER ICURT                % ADDRESS OF CURRENT RT-PROG DESCRIPTION
072172   INTEGER IQH                  % ADDRESS OF QUEUE HEAD
072173   US3X:  CALL GET0; ZAREG=:IPACK; ZXREG=:IQH
072200          RTREF=:ICURT
072202          CALL ALTON            % ACCESS ALTERNATIVE PAGE TABLE
072203          IF IPACK.WPOSS><ICURT OR X.WNPAK><0  THEN A:=-2; GO NSKIP FI
072214          T:=IQH.WLPAK; IPACK=:X.WLPAK; MIN X.WPNUM; A=:T.WNPAK
072223          IQH=:IPACK.WNPAK
072226          X:=IPACK
072227          DO WHILE X><0
072230            0=:X.WPOSS; X:=X.WNBUF
072232          OD
072233          CALL ALTOFF; MIN ZPREG; 0/\0; GO RET
072237   NSKIP: A=:IPACK
072240          CALL ALTOFF; IPACK=:ZAREG; GO RET; *US3=US3X
072244   RBUS
072251   
072251   
072251   
072251   
072251   
072251   
072251   %========    P R I Q         174
072251   %
072251   % PUT A PACKET IN QUEUE ACCORDING TO PRIORITY, I.E. PACKET IS INSERTED
072251   % AFTER LAST PACKET IN QUEUE WITH EQUAL OR HIGHER PRIORITY.
072251   % PRIORITY VALUE IS FOUND IN PACKET HEAD, WORD AND BITS DEFINED AT SYSTEM
072251   % GENERATION.
072251   % WPOSS-WORD MUST CONTAIN ADDRESS OF CALLING RT-PROGRAM. WNPAK-WORD
072251   % MUST BE ZERO.
072251   %
072251   % PRIQ:      GET PARAMETER(QUEUEHEAD,PACKET)
072251   %            IF ANY-BUF-OF-PACKET.WPOSS><CURR-RT-PROG OR PACKET.WNPAK><0 THEN
072251   %                NON-SKIP-RETURN(-2)
072251   %            ENDIF
072251   %            IF PACKET.PRIOR=0 THEN
072251   %                QUEUEHEAD.WLPAK=:LASTPACKET; QUEUEHEAD=:QPACK
072251   %                GO INSERT
072251   %            ENDIF
072251   %            QUEUEHEAD.WFPAK=:QPACK
072251   %            DO WHILE QPACK><QUEUEHEAD AND QPACK.PRIOR>=PACKET.PRIOR
072251   %                QPACK=:LASTPACKET; QPACK.WNPAK=:QPACK
072251   %            ENDDO
072251   % INSERT:    QPACK=:PACKET.WNPAK; PACKET=:LASTPACKET.WNPAK
072251   %            QUEUEHEAD.WPNUM + 1
072251   %            DO WHILE PACKET><0
072251   %                0=:PACKET.WPOSS; PACKET.WNPAK=:PACKET
072251   %            ENDDO
072251   %            SKIP-RETURN
072251   %
072251   % ENTRY:     X - ADDRESS OF QUEUE HEAD
072251   %            A - ADDRESS OF PACKET
072251   % EXIT:
072251   %      NON-SKIP              A=-2                PACKET NOT WPOSSESSED BY PROGRAM OR
072251   %                                                PACKET BELONGS TO QUEUE
072251   %      SKIP                  PACKET INSERTED IN QUEUE
072251   % TIME USED:
072251   %      PRIQ: PRIOR 0         330 MICS (NORD-10)  170 MICS (10-S)
072251   %                  ><0       320+33*N (NORD-10)  165+15*N (10-S)
072251   %                  ><0       130+33*N (NORD-10)   65+15*N (10-S)
072251   %                            N=NO OF PACKETS AHEAD IN QUEUE+1
072251   
072251   %============================================================================
072251   % 35.34      U S X 4
072251   %
072251   SUBR US4X
072251   INTEGER IPACK                % ADDRESS OF PACKET TO SEND
072252   INTEGER ICURT                % ADDRESS OF CURRENT RT-PROG DESCRIPTION
072253   INTEGER IQH                  % ADDRESS OF QUEUE HEAD
072254   INTEGER IPRI                 % PRIORITY OF PACKET
072255   US4X:  CALL GET0; ZAREG=:IPACK; ZXREG=:IQH
072262          RTREF=:ICURT
072264          CALL ALTON            % ACCESS ALTERNATIVE PAGE TABLE
072265          IF IPACK.WPOSS><ICURT OR X.WNPAK><0 THEN A:=-2; GO NSKIP FI
072276          X.WPRI/\SPRIMASK=:IPRI
072301          X:=IQH=:D
072303          IF IPRI=0 THEN X.WLPAK=:D; GO DIPUT FI
072310          DO WHILE X.WNPAK><IQH AND A.WPRI/\SPRIMASK-IPRI>>=0 
072322            X:=D.WNPAK=:D
072325          OD
072326   DIPUT: T:=D.WNPAK; IPACK=:X.WNPAK; T=:A.WNPAK
072334          IF A:=T=IQH THEN IPACK=:IQH.WLPAK FI
072343          MIN IQH.WPNUM
072345          X:=IPACK
072346          DO WHILE X><0
072347            0=:X.WPOSS; X:=X.WNBUF
072351          OD
072352          CALL ALTOFF; MIN ZPREG; 0/\0; GO RET
072356   NSKIP: A=:IPACK
072357          CALL ALTOFF; IPACK=:ZAREG; GO RET; *US4=US4X
072363   RBUS
