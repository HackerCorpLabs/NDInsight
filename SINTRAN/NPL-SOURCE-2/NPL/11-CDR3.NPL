070341   
070341   %===========================================================================
070341   %
070341   % 35.3       P R T D R
070341   %
070341   
070341   SUBR PRTDR
070341   PRTDR: IF X:="RTDTTABLE"=0 GO OUT
070343          DO WHILE X.S1><0
070345                IF "ERTDTABLE"=X GO OUT
070350                X+5
070351          OD; T=:X.S0; X=:A;  CALL RTDIR
070355   OUT:   GO RET14
070356   RBUS
