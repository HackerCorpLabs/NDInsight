071472   *"8STRN+8N500 -BADAD
"071472   
071472          IF D.RTRES><RTREF THEN 5; GO FAR ERRF FI          % DEVICE NOT RESERVED
071501          X=:TADDF; D1=:X.USDADR; D2-=:X.OBCOU
071507          TAD:=ZF1RG=:X.ZOPRG:=ZF4RG=:X.ZOARG:=ZF7RG=:X.ZOSRG
071515          IF B="DEMFIELD" THEN X:=RTRES; CALL BRELEASE FI
071522          OLDPAGE=:D; TADDF=:B; MLEV; *MST PIE
071530          0=:XRSA; CALL DALTON
071532   TLOOP: *PIOF
071533          X:=XRSA; IF OBCOU=0 GO FAR TGORET
071537          FOR OBCOU DO
071537                T:=USDADR
071540                *PION; BSET ONE; LBYT; BSET ZRO; PIOF
071545                CALL IOTRANS; GO TBUFWT; X+1 
071550          OD; GO FAR TGORET; *)FILL
