070117   *"8ACC                                 % CPU-TIME USED FOR USER RT-PROGRAMS
"070117   %============================================================================
070117   % 34.50      N A C C O U N T
070117   
070117   SUBR NACCOUNT
070117   %% RT-ACCOUNTING                                 % USER RT-PROGRAM
070117   NACCOUNT:  IF A:=CURPROG>"RTBES" GO NN2
070123          IF    A="RWRT1" THEN A:="DF1".SSREF;GO NN1;FI
070131          IF    A="RWRT2" THEN A:="DF2".SSREF;FI
070136   NN1:   IF    A<"RTBES" THEN EXIT;FI              % NOT USER RT-PROGRAM
070142   NN2:         A-"RTBES"=:D:=0;T:=5RTSIZE;*RDIV ST % COMPUTE RT-DES INDEX
070147          A=:D SHZ  1 +D+ "ACTAB"=:X                % ACCOUNT ENTRY
070154          IF X.S0 >< 0 THEN
070156            MIN X.S2;GO SUITE;MIN X.S1;0/\0
070162          FI
070162   SUITE: EXIT
070163   *)FILL
070172   *"-8ACC
"070172   RBUS
070172   
070172   INTEGER BPAG1=?                        %% POINTER TO 1. ELEM. IN SEG.TABLE
070172   INTEGER CCSTART=?                      %% RTCOMMON START IN PHYSICAL MEMORY
070172   *"8RSEG+8N500
"070172   %==============================================================================
070172   % 35.0       M R S E G M
070172   %
070172   %      MONITOR CALL TO READ SEGMENT TABLE ENTRY
070172   %
070172   %      ENTRY:  D0 = SEGMENT NUMBER
070172   %              D1 = USER ARRAY ADDRESS WHERE CONTENT SHOULD BE STORED
070172   %
070172   %      EXIT :  OK = SKIPRETURN
070172   %              ERROR:  A=ERRCODE
070172   
070172   SUBR MRSEGM
070172   
070172   INTEGER ARRAY SCCOM(5)                           % SIM. SEGMENT TABLE ENTRY FOR RT-COMMON
070177   DISP 0; REAL FS0=S0; DOUBLE DIS3=S3; PSID
070177   
070177   MRSEGM: T:="P1"; CALL GET1; T=:D1
070202          IF D0<0 OR A>SGMAX GO ILLPA
070207          A*5SEGSIZE+SEGSTART=:D2
070212          RTREF=:D; D1; T:=5; CALL CHLIM; GO ILLAD
070220          IF DEMAND><0 THEN MLEV; *MST PIE
070224          FI
070224          IF D0=0 THEN          % RT-COMMON
070226                100-CCFPAGE SH 10+CCFPAGE=:SCCOM(2)
070234                CCSTART=:SCCOM(3)
070237                161000=:SCCOM(4); "SCCOM"=:D2
070244          FI
070244          D2.FS0; X:=D1; CALL ALTON; TAD=:X.FS0; CALL ALTOF
070252          D2.DIS3; X:=D1; CALL ALTON; AD=:X.DIS3; CALL ALTOF
070260          MIN ZPREG; 0/\0; A:=0
070263   OUT:   A=:ZAREG; GO RET
070265   ILLPA: 174; GO OUT           % ILLEGAL PARAMETER
070267   ILLAD: 153; GO OUT           % ILLEGAL ADDRESS REF. IN MON CALL
070271   RBUS
