072451   *"8XMSG
"072451   

072451   %**********************************************************************
072451   %
072451   %      X M S G  -  R E S I D E N T    P A R T
072451   %
072451   %      MARTIN STANDLEY. 12/12/79. INSTALLED: 16/9/80 IN SIII E!
072451   %                       18/04-83 for S III I (XMSG/PIT3)
072451   %
072451   %      THIS PART CONTAINS ALL THEN ROUTINES THAT MUST LIE IN THE
072451   %      0-30K PART IF SINTRAN (I.E. BOTH IN POF AND ON PIT0.)
072451   %
072451   %      LINKAGE BETWEEN THE RESIDENT AND KERNEL(PIT3) CODE
072451   %      IS VIA SYMBOL-2-LIST.
072451   %
072451   %*************************************************************************
072451   
072451   *XXRPT=177777 % Set flag indicating that XMSG has been generated (8XMSG)
072451   
072451   %============================================================================
072451   % 35.37      X 1 I O N   X 1 R E T   X W T 0 5   X G W R D
072451   %
072451   SUBR XWT05
072451   
072451   % LEVEL 5 WAIT STATE. NOTE THAT THE PID BIT MUST BE RESET BEFORE CALLING WITH
072451   % INTERRUPTS OFF.
072451   INTEGER POINTER X5HOM
072452   
072452   XWT05: A:=L=:"X5HOM"; *PION; TRA STS; PON        % WAIT; GET STATUS; PAGING ON
072457          IF A NBIT 16 THEN                         % CHECK IF PAGING OFF
072461                *TRA PID; COPY SA DD; TRA PIE       % INTERRUPT SYSTEM STATUS
072464                A/\D; CALL TWT04                    % LET TNY HANDLE IT
072466          FI; *IOF
072467          GO X5HOM
072470   RBUS
072471   
072471   
072471   %============================================================================
072471   % 35.38      X R T E N
072471   %
072471   %      X R T E N    -   R E S T A R T    R T     F R O M    R T  W A I T
072471   %
072471   %============================================================================
072471   SUBR XRTEN,XRTDS
072471   % THIS ROUTINE IS CALLED ON LEVEL 5 TO DO AN RTENTRY ON RT-PROG IN A-REG
072471   INTEGER ARRAY XDFLD:=(0,0,XDFLD,0,0,0,XXENT)     % DATAFIELD!
072500   XRTDS: INTEGER ARRAY POINTER RTDS; INTEGER POINTER HOME; 
072502   
072502   XRTEN: T:=L=:"HOME"; X:=0; *POF                  % A=RT-DESC ADDRESS
072506          DO WHILE 0><RTDS(X); IF A=T GO OUT; X+1; OD % FIND END; CHECK NOT THERE
072515          A=:RTDS(X); X+1; 0=:RTDS(X)               % INSERT IN TABLE
072520          IF X=1 THEN X:="XDFLD":=:B; CALL RTACT; X:=:B; FI % PUT IN MONITOR QUEUE
072527   OUT:   *PON
072530          GO HOME
072531   
072531   % MFUNC ROUTINE EXECUTED ON LEVEL 3
072531   XXENT: X:=0; T:=0; *PIOF                         % LOCK OUT LEVEL 5
072534          DO WHILE RTDS(X)><0; X+1; A=:T; OD        % FIND LAST ELEMENT
072541          IF T><0                                   % WAS THERE ANY
072541          THEN X-1; 0=:RTDS(X); *PION               % CLEAR HIS ENTRY
072546               X:=T; CALL RTENTRY; GO XXENT         % START HIM, AND TRY NEXT ONE
072551          FI; *PION
072552          GO STUPR
072553   RBUS
072557   *"8XMSG+8CXHD+8C1X2+8C2X2+8C3X2+8C4X2
"072557   

072557   %
072557   %==============================================================================
072557   %
072557   % 35.39   D A T A    C O P Y I N G:   X M S G / P I T 3,  H D L C,  X 2 1
072557   %
072557   %==============================================================================
072557   %
072557   SUBR Z2PHY,Z0PHY,Z2USR,Z0USR
072557   
072557   % Routines to transfer data between a user V.S. and physical memory. They
072557   % assume that everything has been set up so that only the 0 bit in the status
072557   % register needs to be turned on to allow access via the APT to the user data
072557   % area.
072557   
072557   % On entry: D contains the byte count and B points to the parameter block:
072557   DISP 0
072557         INTEGER ZXUBF          % Buffer address in user's logical space
072557         INTEGER ZXSBK,ZXSBF    % Physical buffer address (Bank, Displacement)
072557         DOUBLE ZXSAD=ZXSBK
072557         INTEGER POINTER ZXHOM  % Scratch location used to save L-register
072557   PSID
072557   *APTON=BSET ONE; APTOF=BSET ZRO  % Enable/disable alternative page table
072557   
072557   Z0PHY: K:="0"; * APTOF; PON            % Entry from POF? Set PON and flag
072562          GO ZPHY
072563   Z2PHY: K:="1"                          % Entry from PON
072564   ZPHY:  D SHZ -1                                  % Convert to word count
072565          IF M                                      % Odd byte count?
072565          THEN X:=ZXUBF+D; *APTON; LDA 0,X; APTOF   % Get via APT
072574               A/\177400                            % Maskout r.h. byte
072575          FI; T:=ZXSBK; X:=ZXSBF; A:=:L=:"ZXHOM"    % Get physical addr
072601          IF M                            % Odd count?
072601          THEN X+D; *LDATX 0                        % Get last word
072605               A/\377\/L; *STATX 0                  % Mask in lh byte and store
072610               X-D
072611          FI; ZXUBF:=:D; *APTON                     % TX=Destn addr; D=Useraddr
072614   @LIB CXCPU
072614   @LIB CXCPU-,
072614          D:=:B; A=:L                               % TX=Physical, L=count, B=user
072616          DO WHILE L><0                             % Simple loop one word at a time
072620                *LDA 0,B; STATX 0                   % From APT to physical
072622                L-1; B+1; X+1; * RADD DT ADC        % Watch carry bit
072626          OD; B:=D
072630   @ELIB
072630          GO OUT
072631   
072631   Z0USR: K:="0"; * APTOF; PON            % Entry from POF. Set PON & flag
072634          GO ZUSR
072635   Z2USR: K:="1"                          % Entry with PON
072636   ZUSR:  D SHZ -1;                                 % Convert byte count to words
072637          IF M                                      % Odd byte count?
072637          THEN X:=ZXSBF+D; T:=ZXSBK; *LDATX 0       % Get last word in physbuff
072645               A SHZ -10; D SHZ 1=:X; T:=ZXUBF;     % Mask & get user buffer addr
072651               *APTON; SBYT; APTOF                  % Enable APT & store
072654               GO ZUSR                              % Try again (even byte count)
072655          FI; 
072655          D=:X; T:=L=:"ZXHOM":=ZXUBF; ZXSAD; *APTON % AD=Physical, X=count, T=user
072663   @LIB CXCPU
072663   @LIB CXCPU-,
072663          X=:L:=D; B=:D:=T; T:=A                    % TX=Physical, L=count, B=user
072670          DO WHILE L><0                             % Simple loop one word at a time
072672                *LDATX 0; STA 0,B;                  % From physical to APT
072674                L-1; B+1; X+1; * RADD DT ADC        % Watch carry bit
072700          OD; B:=D
072702   @ELIB
072702   OUT:   * APTOF; BSKP SSK ONE; POF                % Switch off access to APT
072705          GO ZXHOM
072706   *)KILL APTON APTOF
