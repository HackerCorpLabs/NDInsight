073204   %==============================================================================
073204   %
073204   %                S E G M E N T  M O N I T O R  C A L L S
073204   %
073204   %==============================================================================
073204   % 36.5       M C A L L   M E X I T
073204   
073204   % MONITOR CALLS MCALL AND MEXIT - TO CHANGE SEGMENTS
073204   % APPL. LEVEL
073204   
073204   SUBR MCALL,MEXIT,0LEGSEG,LEGSEG,R15ERRD,RLEGSEG
073204   
073204   DISP 0; DOUBLE MSTADR; PSID
073204   DISP 0; INTEGER MSEGM=D0; PSID
073204   INTEGER STRA,LA,STRB,LB,MSEGA,MSEGB
073212   INTEGER POINTER LREG
073213   
073213   MCALL: T=:B; MSTADR; CALL ALTOFF; T:=X.ZPREG=:X.ZLREG
073220          A=:X.ZPREG:=D=:X.MSEGM; CALL GET0; GO MMC
073225   
073225   MEXIT: CALL GET0; ZLREG=:ZPREG; T=:MSEGM
073231   MMC:   RTREF.ACTSEG=:ZTREG
073234          IF MSEGM SHZ -10=377 THEN X.ACTSEG SHZ -10 FI
073243          A=:MSEGA; CALL DECO; A=:STRA; T=:LA; X:=RTREF
073250          IF MSEGM/\377=377 THEN X.ACTSEG/\377 FI
073257          A=:MSEGB; CALL DECO; T=:LB
073262   %CHECK FOR OVERLAP:
073262          IF A>STRA THEN IF A-LA<T GO ERRO
073270          ELSE IF A+LB>T GO ERRO
073274          FI
073274          MSEGA SH 10+MSEGB=:RTREF.ACTSEG
073301          GO RETSTUPR
073302   ERRO:  MSEGA SH 10+MSEGB; CALL 9ERRA(#42); GO RETXIT  % OVERLAP
073310   
073310   % DECODE SEGMENT ELEMENT
073310   % ENTRY: A=SEGMENT NUMBER; X=RTREF
073310   % EXIT:  A=FIRST LOGICAL PAGE IN SEGMENT; T=NUMBER OF PAGES IN SEGMENT
073310   DECO:  IF A=0 THEN T:=0; EXIT FI
073313          T:=L=:"LREG"; IF A=X.RSEGM GO ERRIL
073320          CALL LEGSEG; *POF
073322          CALL SHRSOVERLAP; *PON
073324          T:=X.LOGADR SHZ -10; X.LOGADR/\377
073330          GO LREG
073331   
073331   % SUBROUTINE TO CHECK FOR LEGAL SEGMENT
073331   % ENTRY:     A=SEGMENT NUMBER
073331   % EXIT:      A=SEGMENT FLAG; D=SEGMENT NUMBER; X=SEGMENT TABLE ADDRESS
073331   % RETURN TO RETXIT IF ERROR
073331   
073331   0LEGSEG: IF A=0 GO ERRIL
073332   LEGSEG:  IF A>>X:=SGMAX GO ERRIL
073335            A=:D*5SEGSIZE+SEGSTART=:X
073341            IF X.FLAG=0 OR A BIT 5INHB GO ERRNL
073345            EXIT
073346          
073346   R15ERRD:
073346   ERRIL: CALL 9ERRA(#15); GO RETXIT                % ILL.SEGM.NO.
073351   ERRNL: A:=D; CALL 9ERRA(#16); GO RETXIT          % SEGMENT NOT LOADED
073355   
073355   % CHECK FOR LEGAL SEGMENT NUMBER IN MON REENT/SREENT CALLED FROM BACKGROUND
073355   % PROGRAMS. ONLY SEGMENTS ON PIT 1 AND PIT 2 WITH PROTECTION RING ZERO
073355   % IS LEGAL
073355   %
073355   RLEGSEG: IF BACKGROUND><0 AND OLDPAGE/\3=0 THEN
073362                IF X.LOGADR/\300><100 AND A><200 GO ERRIL
073372                IF X.FLAG/\3><0 GO ERRIL
073375            FI; EXIT
073376   RBUS
073420   
073420   %==============================================================================
073420   % 36.6       M F I X   M U N F I X
073420   
073420   %MONITOR CALLS: CALL FIX(SEGNO),CALL UNFIX(SEGNO)
073420   SUBR MOFIX,MUNFIX
073420   DISP 0; INTEGER SGADR=D1,OLDSGNO=D2; PSID
073420   
073420   MOFIX: CALL GET1; D0; CALL 0LEGSEG
073423          IF A BIT 5DEMAND GO ERRD
073425          IF A BIT 5FIX GO RET
073427          IF X.LOGADR SHZ -10=0 GO ERRNL
073432          IF A+FIXPAGES>FIXMAX GO ERRF
073436          A=:FIXPAGES; X=:SGADR
073440          RTREF.ACTSEG=:OLDSGNO; D0=:X.ACTSEG
073445          "STUPR"; *IRW MLEVB DP
073447          MLEV; *MST PID; MST PIE
073452   %RETURN WITH CHANGED SEGMENT
073452          MLEV; *MCL PIE
073454          OLDSGNO=:X.ACTSEG    %CHANGE BACK
073456          SGADR.FLAG BONE 5FIX=:X.FLAG
073462          X=:L:="BSEGLINK"
073464   LOOP:  X=:D:=X.SEGLINK; IF X=-1 THEN CALL ERRFATAL FI
073472          IF X><L GO LOOP
073474          X.SEGLINK; 0=:X.SEGLINK; A=:D.SEGLINK
073500          GO RETSTUPR
073501   
073501   MUNFIX: CALL GET1; IF D0=0 OR A>>SGMAX GO ERRIL
073507          A*5SEGSIZE+SEGSTART
073511          IF A.FLAG BIT 5FIX THEN
073515                A BZERO 5FIX=:X.FLAG
073517                377; T:=X.LOGADR SHZ -10/\A; FIXPAGES-T=:FIXPAGES; IF <0 GO ERRF
073527                IF X.SEGLINK><0 THEN CALL ERRFATAL FI
073532                BSEGLINK=:X.SEGLINK; X=:BSEGLINK
073535          FI; GO RET
073536   
073536   ERRNL: D0; CALL 9ERRA(#16); GO RETXIT    % EMPTY SEGMENT (NOT LOADED)
073542   ERRD:  D0; CALL 9ERRA(#17); GO RETXIT    % FIXING DEMAND
073546   ERRF:  D0; CALL 9ERRA(#18); GO RETXIT    % TOO MANY FIXED
073552   ERRIL: D0; CALL 9ERRA(#15); GO RETXIT    % ILLEGAL SEGMENT NUMBER
073556   RBUS
073576   
073576   %==============================================================================
073576   % 36.7       W S E G   -   W S E G X
073576   
073576   % MONITOR CALL: CALL WSEG(SEGNO) - WRITE BACK SEGMENT
073576   SUBR WSEG,WSEGX
073576   
073576   INTEGER SG,SGA
073600   INTEGER POINTER CRETADR
073601   
073601   WSEG:  CALL GET1
073602          "RET"=:"CRETADR"
073604          D0=:SG; CALL 0LEGSEG; X=:SGA
073610   FELLS: *POF
073611          CALL SRESER; *PON
073613          "MWSEG"; *IRW MLEVB DP
073615          MLEV; *MST PID; MST PIE
073620   
073620   %MONITOR LEVEL:
073620   MWSEG: X:=RTREF=:SRTREF
073622          IF SGA.FLAG=0 OR A BIT 5INHBT THEN
073627             SG; CALL 9ERR(#16); GO BRTEXT
073633          FI; A BZERO 5OK=:X.FLAG; X=:B=:SEGREF:=SRTREF
073640          *POF
073641          A:=B; CALL CSEGS; 1=:NUMBER; CALL TRNSEG
073646          X:=SRTREF; CALL ZSRELES; "OUT"; *PON
073652          IF X=CURPROG THEN
073655             *IRW ALEVB DP
073656          ELSE
073657             X:=X.RTDLGADDR; T:=0; *STATX XTDPR
073662          FI; GO STUPR
073663   %RT LEVEL:
073663   OUT:   GO CRETADR
073664   
073664   % CALLED FROM PSPLREE IN POF
073664   % ENTRY:     A=SEGMENT NUMBER
073664   %            X=ADDRESS OF SEGMENT TABLE ENTRY
073664   %
073664   
073664   INTEGER POINTER WSEGL
073665   WSEGX: A=:SG:=L=:"WSEGL":="WSEG1"=:"CRETADR"; X=:SGA; GO FELLS
073674   WSEG1: GO WSEGL
073675   RBUS
073717   
073717   %==============================================================================
073717   % 36.8       R E E N T 
073717   
073717   % MONITOR CALL REENT(SEGNO) - ATTACH REENTRANT SEGMENT
073717   SUBR REENT,IMREENT
073717   DISP 0; INTEGER RESEG=D1; PSID
073717   
073717   REENT: CALL GET1; *POF
073721   IMREENT:  CALL XCSEGS
073722          IF D0><0 THEN
073724             CALL LEGSEG
073725             X=:RESEG; IF A NBIT 5DEMAND GO ERRD
073730             IF X=NSEGA OR X=NSEGB GO RETSTUPR
073736             CALL RLEGSEG
073737             T:=D0; NSEGA.FLAG; CALL SHRSOVERLAP
073743             T:=D0; NSEGB.FLAG; CALL SHRSOVERLAP
073747             NSEGA; T:=RESEG; CALL OVERLAP
073752             NSEGB; T:=RESEG; CALL OVERLAP
073755          FI
073755          X:=RTREF; CALL CLRBMAP
073757   OUT:   RTREF.RSEGM/\177400+D0=:X.RSEGM; GO RETSTUPR
073765   
073765   ERRD:  CALL 9ERRA(#45); GO RETXIT  % NOT DEMAND SEGMENTS
073770   RBUS
074006   
074006   
074006   %===========================================================================
074006   %            S P L R E E
074006   % MON SPLREE(SGNO,FP1,NP1,FP2,LP2,FLAG)
074006   %            FP1= FIRST PAGE IN LOG.AREA 1 TO OVERLAP BACKGROUND SEGMENT
074006   %            NP1= NUMBER OF PAGES IN AREA 1
074006   %            FP2= FIRST PAGE IN LOG.AREA 2 TO OVERLAP BACKGROUND SEGMENT
074006   %            NP2= NUMBER OF PAGES IN AREA 2
074006   %            FLAG><0: CLEAR PAGE-OWNER TABLE
074006   %
074006   SUBR SPLRE,3SPLRE
074006   SPLRE: CALL GET6; *POF
074010          CALL XCSEGS; CALL S3NOALTPIT; *PON
074013          GO 3SPLRE
074014   RBUS
074020   
074020   
074020   %====================================================================
074020   % 36.10      C H C O R M A P
074020   %
074020   SUBR CHCORMAP
074020   CHCORMAP: EXITA
074021   RBUS
074021   
074021   %=============================================================================
074021   %            S S S W P   -   C B R E L   -   C B R E S
074021   %
074021   % RT-PROGRAM RESERVING THE SWAPPING-SEMAPHORE (CLFIE) AND WAITING FOR
074021   % THE DISC ON BEHALF OF THE SWAPPING-REQUESTING PROGRAM
074021   % THE SWAPPING-REQUESTING PROGRAM WILL BE SET IN SWAPPING-WAIT
074021   % 1SWAP HAS THE PRIORITY OF THE SWAPPING-REQUESTING PROGRAM
074021   %
074021   SUBR INRWSEGM,SSSWP,CBREL,CBRES,LNK1SWAP
074021   INTEGER XREGG
074022   SSSWP: *IOF
074023          "XRTEX"; *IRW MLEVB DP
074025          MLEV; *MST PID; ION
074030          GO SSSWP
074031   
074031   % MONITOR LEVEL
074031   XRTEX: X:="1SWAP"
074032          DO WHILE X.BRESLINK><X; A=:B; CALL BRELEASE; OD 
074040          CALL FREXQ
074041          IF SWPFLAG><1 THEN
074045             X:="BEXQU-WLINK"; T:="BEXQU-BWLINK"; A:=XREGG
074050             DO WHILE X:=X.WLINK><T
074053                IF X=A GO IRWAIT
074055             OD 
074056          FI; GO STUPR
074057   
074057   % SUBROUTINES FOR QUICK BRESERVE/BRELEASE
074057   CBREL: X+5BRESLINK
074060          DO WHILE X.RESLINK><B; X:=A; OD
074065          RESLINK=:X.RESLINK; 0=:RESLINK=:RTRES; EXIT
074072   
074072   CBRES: X.BRESLINK=:RESLINK; A:=B=:X.BRESLINK; X=:RTRES; EXIT
074100   
074100   %============================================================================
074100   %            L N K 1 S W A P
074100   %
074100   % ROUTINE TO START 1SWAP
074100   % MONITOR LEVEL, CALLED FROM RWSEGM
074100   %
074100   % ENTRY:     B=ADDRESS OF DISC DATAFIELD
074100   %            X=DISC-REQUESTING RT-PROGRAM
074100   %
074100   % EXIT TO PSTUPR
074100   %
074100   
074100   LNK1SWAP: X=:XREGG
074101          X.ACTPRI BONE 5SWWAIT=:X.ACTPRI
074104          X.STATUS BONE 5WAIT=:X.STATUS
074107          X:="1SWAP"; CALL TOWQU                    % 1SWAP WAITS FOR DISC
074111          X:=XREGG; "CLFIE"=:B; CALL CBREL          % RELEASE SWAPPING-SEMAPHORE FROM
074115                                                    % DISC-REQUESTING PROGRAM
074115          X:="1SWAP"; CALL CBRES                    % DISC IS RESERVED BY 1SWAP
074117          GO PSTUPR
074120    RBUS
074137   
074137   %==========================================================================
074137   %            S W P R E L E A S E
074137   %
074137   % RESETT THE SWAPPING-QUEUE
074137   %
074137   % ENTRY:     B=DATAFIELD
074137   %
074137   SUBR SWPRELEASE
074137   INTEGER XREGG
074140   SWPRELEASE: 
074140          IF "CLFIE"=B THEN
074143             X=:XREGG:="BEXQUE-WLINK"; T:="BEXQU-BWLINK"
074146             DO WHILE X:=X.WLINK><T
074151                IF X.ACTPRI BIT 5SWWAIT THEN
074154                   A BZERO 5SWWAIT=:X.ACTPRI; X.STATUS BZERO 5WAIT=:X.STATUS
074161                FI
074161             OD; X:=XREGG
074163          FI; EXIT
074164   RBUS
074167   
074167   %===========================================================================
074167   %            M R L C L F I E
074167   %
074167   % SUBROUTINE TO RELEASE THE SWAPPING-SEMAPHORE (CLFIE) WHEN
074167   % WAITING FOR THE DISC (WAITING IN RWSEGM)
074167   %
074167   % CALLED FROM MESCAPE AND SYSABORT IN MON-60 (ND-500 DRIVER)
074167   %
074167   % ENTRY: X=ACTUAL PROGRAM
074167   %
074167   SUBR MRLCLFIE
074167   MRLCLFIE: IF SWPFLAG><0 THEN
074171                IF X.ACTPRI BIT 5SWWAIT THEN
074174                   A BZERO 5SWWAIT=:X.ACTPRI
074176                   X.STATUS BZERO 5WAIT=:X.STATUS
074201                FI
074201             FI; EXIT
074202   RBUS
074203   
074203   *"8DILG
"074203   
074203   %==============================================================================
074203   % 36.13      E N T S G
074203   %
074203   %  MONITOR CALL: ENTSG(SEGNO,PT.NO,INT.LEVEL,STARTADDR)
074203   %  ENTERING A FIXED SEGMENT INTO THE PAGE TABLES
074203   SUBR ENTSG
074203   INTEGER SVB,IRWINST(0); *IRW DP
074205   ENTSG: CALL GET4
074206          IF D1>>3 GO ERR                     % ILLEGAL PAGE TABLE NUMBER
074212          IF D0>>SGMAX GO ERR
074216          A*5SEGSIZE+SEGSTART
074220          IF A.FLAG NBIT 5FIX GO ERR
074224          D1; *PIOF
074226          A SH 7+177000:=:B=:SVB; T:=CORMBANK; X:=X.BPAGLINK
074234          DO WHILE X><0
074235             *LDATX DALOG
074236             A/\77 SH 1+B=:B; *LDDTX DPGPR
074243             AD=:DOU0; A:=B/\177600=:B; *LDXTX DPAGL
074250          OD; SVB=:B; *PION
074254          IF D2<2 OR >11 OR =3 OR =4 GO ERR
074271          D1 SH 7=:D SH 2; D\/A; D2 SH 3+2\/D; *TRR PCR
074303          D2 SH 3\/IRWINST=:T; D3; *EXR ST
074311          1; FOR X:=D2- DO A SH 1; OD; *MST PIE
074317          0=:ZAREG; GO RET
074321   ERR:   -1=:ZAREG; GO RET
074324   RBUS
074335   
074335   %===========================================================================
074335   %            F X C T A
074335   %
074335   % TABLE FOR START OF COREMAP FOR ALLOCATED MEMORY AREAS (NOT SEGMENTS)
074335   % LAYOUT: WORD 1: MEMORY MAP POINTER OF THE ALLOCATED MEMORY AREA
074335   %         WORD 2: PROGRAM WHICH HAS ALLOCATED THE MEMORY AREA
074335   
074335   INTEGER ARRAY FXCTAB(0)
074335   * FXCTA<*+NALME+NALME; )ZERO; *+NALME+NALME/
