173717          "NNBRT"*POTESIZE+1777 SHZ -12=:X=:POWSIZE; A:=0; T:=LPHYSPAGE
173727          CALL GETAREA; CALL ERRFATAL
173731          A=:D=:POWFPAGE+POWSIZE-1=:POWLPAGE:=0; AD SH 12=:DSREBADDR
