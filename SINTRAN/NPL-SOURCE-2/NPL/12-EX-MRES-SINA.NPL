174574   %
174574   SUBR XCHIOX
174574   
174574   INTEGER POINTER LREG,PTMRTE
174576   INTEGER XREG; TRIPLE TADREG
174602   INTEGER CCOUNT
174603   
174603   XCHIOX: TAD=:TADREG; X=:XREG; A:=L=:"LREG"
174607          A:=200; *TRR IIE; TRA IIC
174612          "TMRTE"+1=:"PTMRTE"
174615          DO WHILE X:=PTMRTE><-1 AND "PTMRTE"<<"9EXTD"
174625             *TRA IIC
174626             IF X><0 AND X.HDEV><0 THEN
174631                T:=A+2; *IOXT; TRA IIC
174635                IF A=7 THEN
174640                   0=:PTMRTE
174641                ELSE
174642                   IF X.HDEV NBIT 2 THEN
174645   % CHECK IDENT CODE IF INPUT DEVICE
174645                      X=:D; T:=X.HDEV+3; A:=30; *IOXT
174652                      *IDENT PL10; IDENT PL12; TRA IIC
174655                      15; *IOXT
174657                      A:=0; T+"5-3"; *IOXT
174662                      0=:CCOUNT; FOR CCOUNT DO OD; FOR CCOUNT DO OD
174667                      5; T+"7-5"; *IOXT
174672                      A:=0; *IDENT PL12
174674                      IF A=0 GO ERRID; A-1
174676                      IF A<<="HIDTERM" AND A>>="LIDTERM" THEN
174704                         IF A-T>>"MXX12" GO ERRID
174710                         X:="ID12T"+A; X.S0
174713                      ELSE
174714                         ITB12(A)
174716                      FI; IF A><D GO ERRID; A:=0; *IDENT PL10
174722                      IF A=0 GO ERRID; A-1
174724                      IF A<<="HIDTERM" AND A>>="LIDTERM" THEN
174732                         IF A-T>>"MXX10" GO ERRID
174736                         X:="ID10T"+A; X.S0
174741                      ELSE
174742                         ITB10(A)
174744                      FI
174744                      T:="9CXTI"; D+T
174746                      IF A><D GO ERRID
174750                      T+"3-7"; A:=30; *IOXT; IDENT PL10; IDENT PL12; TRA IIC
174756                      GO IDOK
174757   ERRID:             D.HDEV; T:=0; CALL 9ERR(#23)
174764   IDOK:           FI
174764                FI
174764             FI; MIN "PTMRTE"
174765          OD; TAD:=TADREG; X:=XREG; GO LREG
174771   RBUS
175006   
175006   
175006   %===============================================================================
175006   % 36.18      X G E T A R E A     Y G E T A R E A
175006   %
175006   % SUBROUTINE TO ALLOCATE CONTINUOUS AREA IN MEMORY
175006   %
175006   % ENTRY: A=FIRST PAGE TO TEST
175006   %        B=SBFIELD IN SINTR
175006   %        X=NUMBER OF PAGES IN AREA
175006   %        T=LAST POSSIBLE PAGE IN AREA
175006   %
175006   %        XGETAREA: ALLOCATES PAGES FROM A UPP TO T
175006   %                  AND TEST THAT WHOLE AREA IS IN ONE BANK
175006   %        YGETAREA: ALLOCATES PAGES FROM A DOWN TO T 
175006   %                  (CALLED WHEN ALLOCATING PAGES TO RT-COMMON)
175006   % EXIT:  AREA NOT FOUND
175006   %
175006   % EXIT+1: AREA FOUND, A=FIRST PAGE IN AREA
175006   %
175006   
175006   % N O T E: THIS DISP DEFINITION MUST CORRESPOND TO THE BASEFIELD IN SINTR
175006   
175006   SUBR XGETAREA,YGETAREA
175006   
175006   DISP -200
175006   INTEGER 9HDEV                % SPECIAL IOX-NUMBER FOR MAIN SWAP-DEVICE
175006   INTEGER XIOBUTAB             % ADDRESS OF I/O-DEVICES BUFFER TABLE
175006   INTEGER ARRAY LSWPDEV(6)     % LOG.DEV. NO FOR SWAP-DEVICES
175006   INTEGER ARRAY HSWPDEV(6)     % IOX-DEV. NO FOR SWAP-DEVICES
175006   INTEGER XSMRES               % START OF PAGING-OFF CODE AREA
175006   INTEGER XEMRES               % END OF PAGING-OFF AREA
175006   INTEGER CBUF                 % ADDRESS OF CURRENT I/O BUFFER
175006   INTEGER LPHYSPAGE            % LAST PAGE IN MEMORY
175006   INTEGER DBFNO                % NUMBER OF DEVICE-BUFFER-HEADERS.
175006   INTEGER MMSIZE               % SIZE OF MEMORY MAP
175006   INTEGER MMFPAGE              % FIRST PAGE OF MEMORY MAP
175006   INTEGER MMLPAGE    
175006   INTEGER DBFPAGE              % FIRST PAGE USED AS DEVICE BUFFER
175006   INTEGER DBLPAGE              % LAST PAGE USED AS DEVICE BUFFER
175006   INTEGER FLAMPAGE             % FIRST PHYSICAL PAGE FOR LAMU TABLES
175006   INTEGER LLAMPAGE             % LAST PHYSICAL PAGE FOR LAMU TABLES
175006   INTEGER CLAMSIZE             % SIZE OF LAMU DESCRIPTION TABLE
175006   INTEGER NPLAMU               % NUMBER OF PAGES USED BY LAMU TABLES
175006   INTEGER CURRPAGE             % CURRENT PAGE NUMBER TO CHECK
175006   INTEGER CCOUNT
175006   DOUBLE ARRAY POINTER DCCTAB       
175006   INTEGER ARRAY POINTER ACCTAB=DCCTAB
175006   INTEGER ARRAY POINTER PNSWPAGE         
175006   INTEGER POINTER ICINDADDR(2)
175006   DOUBLE POINTER CINDADDR=ICINDADDR
175006   INTEGER POINTER FPGNO,PHYSPTEST,GETAREA
175006   INTEGER POINTER INITPAGE,MEMCHECK,XYOUTLINK
175006   INTEGER XT,XA,XD,XXX; TRIPLE XTAD=XT
175006   INTEGER POINTER CLINK
175006   INTEGER PREVX,PREVT
175006   DOUBLE ARRAY POINTER PNINITPAGE
175006   DOUBLE ARRAY POINTER PLAMARR
175006   INTEGER 1CCTAB,2CCTAB
175006   INTEGER CINDX
175006   INTEGER NNRTP,POWFPAG,POWLPAG,POWSIZE
175006   INTEGER LPS41
175006   INTEGER BUSYMOD
175006   INTEGER SYMFPHPAGE,SYMLPHPAGE
175006   PSID
175006   
175006   DOUBLE ARRAY POINTER PCUMTABLE:=CUMTABLE
175007   YGETAREA: K:="0"; GO L1
175011   XGETAREA: K:=1
175012   L1:    TAD=:XTAD; X-=:XXX; T:=L=:"CLINK"
175017   AGAIN: XXX=:CCOUNT; XA=:CURRPAGE
175023          FOR CCOUNT DO
175023             IF CURRPAGE<<100 THEN
175027                IF A<<=LRESP GO FAR TRNX
175032                IF A=77 GO FAR TRNX                     % DO NOT USE PAGE 77
175035                IF A>>=FPOFP AND A<<=LPOFP GO FAR TRNX  % FOR DEVICE BUFFERS OR CORE MAP
175043             FI; IF A>>=DBFPAGE AND A<<=DBLPAGE GO FAR TRNX
175051             IF A>>=TDFPAGE AND A<<=TDLPHPAGE GO FAR TRNX
175057             IF A>>=POWFPAGE AND A<<=POWLPAGE GO FAR TRNX
175065             IF A>>=FLAMPAGE AND A<<=LLAMPAGE GO FAR TRNX     % IN LAMU TABLE AREA?
175073             IF A>>=MMFPAGE AND A<<=MMLPAGE GO FAR TRNX       % MEMORY MAP AREA
175101             IF T:="MCLGPAGE"><0 AND A=MCLGPAGE GO FAR TRNX   % MONCALL LOG PAGE
175107             IF A>>=TADFPHPAGE AND A<<=TADLPHPAGE GO FAR TRNX % TAD STACK AREA
175115             IF A>>=FPS41 AND A<<=LPS41 GO FAR TRNX           % MEMORY RESERVED FOR PIT3 SEGMENT
175123             IF A>>=SYMFPHPAGE AND A<<=SYMLPHPAGE GO FAR TRNX % SYNC.MODEM I/O BUFFER
175131             X:=0
175132             IF K THEN
175134               DO WHILE ACCTAB(X)><-1                         % RT COMMON
175140                  X+1; IF ACCTAB(X)=CURRPAGE GO TRNX; X+1
175146               OD; X:=0
175150             FI
175150             DO WHILE X<<"NINSZ*2"
175153                AD:=PNINITPAGE(X)
175154                IF A><0 AND A<<=CURRPAGE AND D>>=T GO TRNX
175162                X+2
175163             OD; X:=0
175165             DO WHILE X<<"CUMSIZE*2"
175170                AD:=PCUMTABLE(X)
175171                IF A><0 AND A<<=CURRPAGE AND D>>=T GO TRNX
175177                X+2
175200             OD
175201             CURRPAGE; CALL PHYSPTEST; GO TRNX
175204             IF K THEN
175206                CURRPAGE/\177700=:T; IF XA/\177700><T GO TRNX    % CHECK THAT WHOLE
175215                MIN CURRPAGE                                     % AREA IS IN ONE BANK
175216              ELSE
175217                CURRPAGE-1=:CURRPAGE
175222             FI
175222          OD; GO OUT; *)FILL
175240   OUT:   MIN "CLINK"; A:=XA; GO CLINK          % AREA FOUND
175243   TRNX:  A:=XXX;
175244          IF K THEN A-; IF A+CURRPAGE >> XT GO CLINK; CURRPAGE+1=:XA;
175256          ELSE          IF A+CURRPAGE << XT GO CLINK; CURRPAGE-1=:XA;
175266          FI;GO FAR AGAIN
175267   
175267   RBUS
175270   
175270   
175270   %============================================================================
175270   %
175270   % SUBROUTINE TO INITIALIZE A PAGE (READ AND WRITE IN EVERY ADDRESS IN THE PAGE)
175270   %
175270   % ENTRY: A=PAGE NUMBER
175270   %
175270   % 36.19      X I N P A G E
175270   %
175270   SUBR XINIPAGE
175270   INTEGER XREG,TREG,AREG,DREG
175274   TRIPLE TADR=TREG
175274   XINIPAGE: TAD=:TADR; X=:XREG
175276          X:=0
175277          DO WHILE X<<"NINSZ*2"
175302             AD:=NINITPAGE(X)
175303             IF A><0 AND A<<=AREG AND D>>=T GO OUT
175311             X+2
175312          OD
175313          A:=AREG=:D:=162000; X:=177176; AD=:X.DOU0; *PON
175321          FOR X:=176000 DO X.S0=:X.S0 OD; *POF
175326   OUT:   TAD:=TADR; X:=XREG; EXIT
175331   RBUS
175335   
175335   %============================================================================
175335   % 36.20      X M E M C H E C K
175335   %
175335   %
175335   % SUBROUTINE TO DO MEMORY CHECK ON A PAGE
175335   %
175335   % ENTRY: A=PAGE NUMBER
175335   %
175335   % EXIT:  MEMORY ERROR IN PAGE
175335   % EXIT+1: OK
175335   %
175335   SUBR XMEMCHECK
175335   *"8MEMC
"175335   XMEMCHECK:
175335   *"-8MEMC
"175335          EXITA
175336   *"8MEMC
"175336   RBUS
175336   
175336   %============================================================================
175336   % 36.21      X F P G N O
175336   %
175336   %
175336   % SUBROUTINE TO CONVERT ADDRESS TO PAGE NUMBER
175336   %
175336   % ENTRY: A=ADDRESS
175336   %
175336   % EXIT:  A=PAGE NUMBER
175336   %        D=0 WHEN ADDRESS IS MODULO 2K BYTE ELSE D=1
175336   %
175336   SUBR XFPGNO
175336   INTEGER SAVD
175337   XFPGNO: D:=0; AD SHZ -12; IF D><0 THEN D:=1 FI; EXIT
175345   RBUS
175345   
175345   
175345   %============================================================================
175345   % 36.11      X P H Y S P T E S T
175345   %
175345   % SUBROUTINE TO TEST IF PAGE EXIST IN MEMORY
175345   %
175345   % ENTRY: A=PAGE NUMBER
175345   %
175345   % EXIT:  PAGE DOES NOT EXIST
175345   %
175345   % EXIT+1: PAGE EXSIST
175345   %
175345   SUBR XPHYSPTEST
175345   INTEGER XREG,TREG,AREG,DREG
175351   TRIPLE TADR=TREG
175351   XPHYSPTEST: TAD=:TADR; X=:XREG:=0
175354          DO WHILE X<<"NINSZ*2"
175357             AD:=NINITPAGE(X)
175360             IF A><0 AND A<<=AREG AND D>>=T GO NOTOK
175366             X+2
175367          OD; A:=AREG=:D:=162000; X:=177176; AD=:X.DOU0; A:=1000
175376          *TRR IIE; PON; TRA IIC
175401          X.S0; *POF; TRA IIC
175404          IF A=0 THEN L+1 FI; A:=0; *TRR IIE
175410   NOTOK: TAD:=TADR; X:=XREG; EXIT
175413   RBUS
175417   
175417   %==============================================================================
175417   %            X O U T L I N K   -   I O U T L I N K
175417   %
175417   % SUBROUTINE TO LINK OUT AN AREA FROM THE MEMORY MAP
175417   % IOUTLINK WILL ALSO INITIALIZE THE AREA (READ AND WRITE IN ALL LOCATIONS)
175417   %
175417   % ENTRY:     A=FIRST PAGE TO LINK OUT
175417   %            D=LAST PAGE TO LINK OUT
175417   SUBR XOUTLINK,IOUTLINK
175417   INTEGER TREG,AREG,DREG,XREG,PREVX,PREVT
175425   TRIPLE TADR=TREG
175425   INTEGER POINTER LREG
175426   IOUTLINK: K:=1; GO FELLS
175430   XOUTLINK: K:="0"
175431   FELLS: TAD=:TADR; X=:XREG:=L=:"LREG"
175435          IF K THEN
175437             DO CALL XINIPAGE; WHILE A><D; A+1; OD; TAD:=TADR
175445          FI; X:="XSGRT"+1; T:=0
175450          DO
175450             IF X=0 THEN CALL ERRFATAL FI
175453             X=:PREVX; T=:PREVT
175455             *LDXTX DPAGL
175456             T:=CORMBANK; *LDATX DPAGP
175460             IF A-AREG=0 GO FOUND
175462          OD
175463   FOUND: DO
175463             *LDATX DPAGP
175464             IF A-DREG=0 THEN
175466                *LDATX DPAGL
175467                X=:D:=PREVX; T:=PREVT; *STATX DPAGL
175473                X:=D; T:=CORMBANK; A:=0=:D; *STDTX DPAGL; STZTX DPGPR
175501                TAD:=TADR; X:=XREG; GO LREG
175504             FI; A:=0=:D; *STDTX DPAGL; STZTX DPGPR
175510             X+4
175511          OD
175512   RBUS
175516   %=============================================================================
175516   %      Z E R O P A G E
175516   %
175516   % SUBROUTINE TO FILL A PAGE WITH ZEROES
175516   %
175516   % ENTRY:     A=PHYSICAL PAGE NUMBER
175516   %
175516   SUBR ZEROPAGE
175516   INTEGER XREG; TRIPLE TADR
175522   ZEROPAGE: TAD=:TADR; X=:XREG
175524          A=:D:=162000; X:=177176; AD=:X.DOU0; *PON
175531          FOR X:=176000 DO 0=:X.S0 OD; *POF
175535          TAD:=TADR; X:=XREG; EXIT
175540   RBUS
175543   
175543   @LIB CXCPU
175543   
175543   * 99END=*
