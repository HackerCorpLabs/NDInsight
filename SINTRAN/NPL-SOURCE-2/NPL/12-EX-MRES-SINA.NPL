173602   % RESERVE MEMORY FOR THE TAD-STACK
173602          T:=0; X:="D1400"+1
173605          DO                                        % SEARCH IN LOG.DEV TABLES
173605             IF "D1500"=X THEN X+1 FI
173611          WHILE "9EBAD">>X
173614             AD:=X.DS0
173615             IF A><0 OR D><0 THEN T+1 FI
173621             X+2
173622          OD
173623          IF T><0 THEN                              % RESERVE PAGES
173625             A:=T*TSSIZE; CALL FPGNO; A+D=:MMSIZE   % MMSIZE=NO.OF PAGES IN TAD-STACK
173632             X:=A; A:=0; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
173637             A=:TADFPHPAGE-1+MMSIZE=:TADLPHPHAGE    % FIRST AND LAST PHYSICAL PAGE FOR TAD-STACK
173643             A:=TADFPHPAGE SHZ -6=:TSBANK           % MEMORY BANK FOR TAD-STACK
173646             A:=TADFPHPAGE SH 12=:CCOUNT            % CCOUNT=ADDR OF STACK WITHIN A 64KW MEMORY BANK
173651             X:="D1400"+1=:L
