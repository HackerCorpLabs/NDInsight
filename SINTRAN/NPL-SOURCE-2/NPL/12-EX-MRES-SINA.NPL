173741   % THE PHYSICAL PAGE NUMBER IS INDEX IN THE MEMORY MAP
173741          IF LPHYSPAGE=37777 THEN A-1=:LPHYSPAGE FI
173747          A+2 SH 2; CALL FPGNO; A+D=:MMSIZE
173754          100; X:=MMSIZE; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
173761          A=:D=:MMFPAGE SHZ -6=:CORMBANK:=D+MMSIZE-1=:MMLPAGE
173771          IF A:=D/\77=0 THEN A SH 12+4 ELSE A SH 12 FI
174000          A=:CORMSTART=:"XSGRT".BPAGLINK=:D:=CORMBANK; AD=:DCORMSTART
174006          LPHYSPAGE=:ENDPAGE
174010          GO L3; *)FILL
174024   L3:    0=:CURRPAGE; X:=CORMSTART
174026          FOR CURRPAGE DO WHILE CURRPAGE<<=LPHYSPAGE
174032             T:=CORMBANK; A:=X+4; D:=0; *STDTX DPAGL
174037             CURRPAGE=:D; A:=1; *STDTX DPGPR
174043             X+4
174044          OD; X-4=:ECORMAP; T:=CORMBANK; *STZTX
