075267   %            M X R E T
075267   %
075267   % ROUTINE TO RELEASE MONITOR CALL WORKING FIELD AND GO TO MRET
075267   %
075267   SUBR MXRET
075267   MXRET: MLEV; *MCL PIE
075271          X:=RTREF; CALL BRELEASE
075273          A:=B; *IRW MLEVB DX
075275          "MRET"; *IRW MLEVB DP
075277          "MONEN"; *IRW MLEVB DL
075301          MLEV; *MST PID; MST PIE; PION
075305          CALL ERRFATAL
075306   RBUS
