174057          "SG41".LOGADR/\377; T:=MMSIZE SH 10; A\/T=:X.LOGADR
174066          X:=MMSIZE; A:=100; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
174073          A=:D=:FPS41+MMSIZE-1=:LPS41
174100          IF "SG33".LOGADR/\77 SH 12><0 AND A<<="XLPT3" THEN
174110             CALL ERRFATAL                          % PIT3 SEG AND X-MESSAGE OVERLAPS
174111          FI
