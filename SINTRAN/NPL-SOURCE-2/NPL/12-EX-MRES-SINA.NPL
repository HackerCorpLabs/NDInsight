074732   %            S S 4 1 I P I T
074732   %
074732   % SUBROUTINE TO SET PIT3 SEGMENT INTO PIT3
074732   %
074732   % ENTRY: X=START OF PAGELINK
074732   %        T=CORMBANK
074732   %        B=ADDR OF FIRST PAGE TABLE ENTRY FOR PIT3 SEGMENT
074732   %
074732   SUBR SS41IPIT
074732   SS41IPIT: *PIOF
074733          DO
074733             *LDDTX DPGPR
074734             AD=:DS0; *LDXTX DPAGL
074736          WHILE X><0
074737             B+2
074740          OD; *PION
074742          EXIT
