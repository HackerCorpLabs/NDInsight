173654                IF L="D1500" THEN L+1 FI            % WITH THE ADDR OF THE TAD-STACK AREA
173660             WHILE L<<"9EBAD"
173663                AD:=L.DS0
173665                IF A><0 OR D><0 THEN
173670                   T:=CCOUNT
173671                   IF A><0 THEN T=:A.TSTADD FI
173674                   IF D><0 THEN T=:D.TSTADD FI
173700                   CCOUNT+TSSIZE=:CCOUNT
173703                FI; L+1; L+1
173705             OD;
173706          FI; GO OVFILL; *)FILL
