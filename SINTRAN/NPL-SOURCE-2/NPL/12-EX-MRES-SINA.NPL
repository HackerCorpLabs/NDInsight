172525   
172525   % LOCAL SUBROUTINE TO FIND SPACE FOR THE I/O BUFFERS
172525   %
172525   % ENTRY:     A=0 : TRY TO PLACE ALL I/O BUFFERS (EXCEPT LARGE HDLC BUFFERS),
172525   %                : IN POF.
172525   % EXIT:      I/O BUFFERS FOUND
172525   % EXIT+1:    NOT ENOUGH SPACE IN POF
172525   %
172525   % ENTRY:     A><0: SAME AS FOR A=0 EXCEPT THAT BUFFERS FOR SYNC.MODEM WILL
172525   %                  BE PLACED OUTSIDE POF
172525   % EXIT:      I/O BUFFERS OK
172525   %
172525   % EXIT+1:    FATAL ERROR
172525   %
172525   INTEGER CFIOFLG
172526   CFIOBUF: A=:CFIOFLG; 0=:BUSYMOD
172530          X:=XIOBUTAB; A:=CBUF=:D
172533          DO WHILE X.S0><-1
172537             IF A BIT BIHDLC AND X.S1/\77777>>=2000 THEN
172546                A:=0
172547             ELSE
172550                IF A BIT BISYMOD AND T:=CFIOFLG><0 THEN
172555                   X.S1/\77777+BUSYMOD=:BUSYMOD; GO NXT
172562                ELSE
172563                   X.S1/\77777
172565                FI
172565             FI; D+A; IF C THEN EXITA FI              % CROSS 64KW MEMORY BANK
172571   NXT:      X+2
172572          OD; IF D>>177000 THEN EXITA FI              % OVERLAP PAGE INDEX TABELS
172577          EXIT                                        % BUFFER IS FOUND
172600   
172600   % LOCAL SUBROUTINE TO SIMULATE LOGPH FOR ELEMENTS IN IOBUTAB
172600   %
172600   % ENTRY:     A=LOGICAL DEVICE NUMBER
172600   %            CINDADDR MUST POINT TO ELEMENT IN IOBUTAB
172600   %
172600   % EXIT:      X=ADDRESS OF DATAFIELD
172600   %
172600   % CALL TO ERRFATAL WHEN ERROR
172600   
172600   XLOGPH: AD SHZ -6; IF A=1 OR A>24 THEN CALL ERRFATAL FI
172610          A=:X:=D SHZ -12
172613          IF A+A+CNVRT(X)+1=:D-ENTAB(X)>=0 THEN CALL ERRFATAL FI
172622          AD:=D.DOU0; IF T:=ICINDADDR BIT 17 THEN D=:X ELSE A=:X FI
172632          IF X=0 THEN CALL ERRFATAL FI
172635          EXIT
172636   *)FILL
172643   
172643   % INITIALIZE PAGING SYSTEM AND INTERRUPT SYSTEM
172643   
172643   SINTR: A:=0; *PIOF; TRR IIE; TRA IIC
172647          A:=0; *TRR PID; TRR PIE
172652          A:=2; *TRR PCR; SEX; TRA STS
172656          IF A NBIT 5N100 THEN CALL ERRFATAL FI % THIS SYSTEM IS ONLY FOR NORD 100!!!!
172661          A=:CPSTA
172662          A:="LV0"; *IRW 0 DP; ION
172665   LV0:   *IOF
172666          "SBFIELD"=:B
172670   % INITIALIZE THE PAGE TABLES
172670          A:=162000; D:=0; X:=177000
172673          DO AD=:X.DOU0; D+1; X+2 WHILE X><0 OD
172700   % INITIALIZE THE MEMORY AREA FROM END OF RESIDENT UP TO 128 KBYTE
172700          X:=ENDCOR; DO X.S0=:X.S0 WHILE X><177777; X+1; OD
172710          A:=ENDCORE-1; CALL FPGNO
172713          IF A>"9POFS" SHZ -12 -1 THEN CALL ERRFATAL FI  % RESIDENT AND POF OVERLAPS
172721          A=:LRESP                                     % LAST PAGE IN RESIDENT
172722   
172722   % TEST MEMORY ADDRESS BITS 19-23 (1-32MB)
172722   ISINTR: 1000=:CURRPAGE
172724   % IF MULTIPORT 3 THEN 3777=:ENDPAGE ELSE 37777=:ENDPAGE FI
172724          A:=200; *TRR IIE; TRA IIC; IOX 750; TRA IIC
172731          IF A=0 THEN A:=3777 ELSE A:=37777 FI; A=:ENDPAGE; A:=0; *TRR IIC
172740          DO WHILE CURRPAGE><ENDPAGE+1
172745             X:=0
172746             DO WHILE X<<"NINSZ*2"
172751                AD:=PNINITPAGE(X)
172752                IF A><0 AND A<<=CURRPAGE AND D>>=T GO NEXT
172760                X+2
172761             OD; X:=0; 124000=:X.S0
172765             A:=CURRPAGE=:D:=162000; X:=177176; AD=:X.DOU0
172772             A:=1000; *TRR IIE; TRA IIC; PON
172776             X:=176000; X.S0; *POF; TRA IIC
173002             IF A=0 THEN
173003                *PON
173004                A:=X.S0=:D:=-1=:X.S0; *POF
173011                X:=0
173012                IF X.S0=124000 THEN
173016                   A:=D; X:=176000; *PON
173021                   A=:X.S0; *POF; TRA IIC
173024                ELSE
173025                   124000=:X.S0; CURRPAGE-1=:ENDPAGE
173032                   GO LABL1
173033                FI
173033             FI
173033   NEXT:     CURRPAGE SH 1=:CURRPAGE
173036          OD
173037   
173037   % FIND LAST 32K MEMORY MODULE
173037   LABL1: A:=77=:LPHYSPAGE+1
173042   DO1:   DO WHILE A<<=ENDPAGE
173045             CALL PHYSPTEST; GO NOTEXIST; A+37=:LPHYSPAGE; A+1
173052          OD; GO L1
173054   NOTEXIST: A+40; GO DO1
173056   *)FILL
173077   
173077   L1:    7EPOF=:CBUF
173101          A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
173107          A=:NNRTP
173110   *"8XMSG
"173110          -1=:CBUF.S0; CBUF=:XZRTT+NNRTP=:CBUF
173117   *"
"173117          CBUF=:7RTDLGADDR
173121          A:=NNRTP*5XRTDSIZE+CBUF=:CBUF=:77CBU; IF C THEN CALL ERRFATAL FI
173131          GO LABL2; *)FILL
173142   % FIND THE I/O BUFFER AREA
173142   LABL2: A:=0; CALL FAR CFIOBUF; GO IOBOK
173145          A:=1; CALL FAR CFIOBUF; GO IOBOK; CALL ERRFATAL
173151   IOBOK:
173151   % CHECK IF "PAGING OFF" AREA AND I/O BUFFER AREA EXISTS IN MEMORY
173151          A:=D; CALL FPGNO; A=:LPOFP            % LAST PAGE IN "PAGING-OFF" AREA
173154          "9POFS"; CALL FPGNO; A=:FPOFP         % FIRST PAGE IN "PAGING-OFF" AREA
173157          DO
173157             CALL PHYSPTEST; CALL ERRFATAL; A+1
173162          WHILE A><LPOFP
173165          OD; GO LABL3; *)FILL
173174   
173174   % SET UP THE I/O BUFFERS
173174   
173174   LABL3: XIOBUTAB=:"CINDADDR"
173176          DO AD:=CINDADDR WHILE A><-1
173202             0=:CHDLCF
173203             IF A BIT BIHDLC THEN
173205                A=:CHDLCF; IF D>>1777 GO NXIOD
173211             FI; A/\7777; CALL FAR XLOGPH
173213             CBUF=:X.BUFST; AD:=CINDADDR
173216             IF A:=D NBIT 17 THEN A SH 1 ELSE A BZERO 17 FI; A=:X.MAX=:X.CFREE
173226             IF CHDLCF><0 THEN 0=:MASTB FI
173231             A:=D BZERO 17+CBUF=:CBUF
173235   NXIOD:    "CINDADDR"+2=:"CINDADDR"
173240          OD
173241   % SET UP RT-COMMON TABLE
173241          IF CCNOX><0 THEN
173243             IF ACCTAB(0)=0 THEN
173246                IF CCSTART=0 THEN
173250                   LPHYSPAGE; X:=CCNOX; T:=LRESP+1
173254                   CALL YGETAREA; CALL ERRFATAL; A-CCNOX+1=:CCSTART
173261                FI; A=:D
173262                200-CCNOX+161000; T:=CCNOX; X:=0
173267                DO WHILE T><0
173271                   AD=:DCCTAB(X); A+1; D+1; X+2; T-1
173276                OD; -1=:ACCTAB(X)
173301             FI
173301          ELSE
173302             IF ACCTAB(0)=0 THEN -1=:ACCTAB(X) FI
173307          FI; GO L2; *)FILL
173322   % TEST IF RT-COMMON PAGES EXIST AND INITIALIZE THE RT-COMMON PAGES
173322   L2:    X:=0
173323          DO WHILE ACCTAB(X)><-1
173327             X+1; ACCTAB(X); CALL PHYSPTEST; CALL ERRFATAL
173333             CALL INITPAGE; X+1
173335          OD
173336          GO FILL1; *)FILL
173340   FILL1:
173340   
173340   % FIND CONTINUOUS AREA FOR THE DEVICE-BUFFERS IN MEMORY BANK 1 TO 3,
173340   % AND INITIALIZE THE PAGES
173340   %
173340          A:=100; X:=DBFNO; T:=377; CALL GETAREA; CALL ERRFATAL     % LAST PAGE = 377
173345          A=:DBFPAGE/\77 SH 12=:BUFASTART           % START ADDRESS OF BUFFER AREA WITHIN BUFBANK
173351          A:=DBFPAGE SHZ -6=:BUFBANK                % MEMORY BANK IN WHICH THE BUFFERS LIE
173354          DBFPAGE+DBFNO-1=:DBLPAGE
173360          FOR A:=DBFPAGE TO DBLPAGE DO CALL INITPAGE; CALL MEMCHECK; CALL ERRFATAL OD
173371   
173371   % RESERVE MEMORY FOR THE LAMU SYSTEM AND CLEAR THE LAMU TABLES
173371   
173371          IF GNLAMU><0 THEN
173373             A*LDTSZ=:CLAMSIZE
173375             A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
173403             A*GNLPRT*ALMSZ+CLAMSIZE; CALL FPGNO; A+D=:NPLAMU
173411             A:=100; T:=LPHYSPAGE; X:=NPLAMU; CALL GETAREA; CALL ERRFATAL 
173416             A=:D=:FLAMPAGE+NPLAMU-1=:LLAMPAGE:=0; AD SH 12=:DLAMDT
173426             A:=D+CLAMSIZE=:LAMACT
173431             A:=FLAMPAGE; T:=NPLAMU+A
173434             DO WHILE A><T; CALL ZEROPAGE; A+1; OD
173441             X:=0
173442             DO WHILE X<<"NINSZ*2"; AD:=PNINITPAGE(X)=:PLAMARR(X); X+2; OD
173451             GO AFLAM; *)FILL
173470          FI
173470   
173470   AFLAM:
173470   
173470   % RESERVE MEMORY FOR THE MONITOR-CALL-LOG TABLE
173470          IF "MCLGPAGE"><0 THEN
173472             A:=0; T:=LPHYSPAGE; X:=1; CALL GETAREA; CALL ERRFATAL
173477             A=:MCLGPAGE=:D:=0; AD SHZ 12; A=:MCLGBANK:=D=:TNMCALL
173506          FI
173506   
173506   % RESERVE MEMORY FOR THE SYNC.MODEM BUFFERS IF THEY ARE PLACED
173506   % OUTSIDE MEMORY BANK #0
173506   
173506          IF BUSYMOD><0 THEN
173510             CALL FPGNO; A+D=:X=:SYMLPHPAGE
173514             A:=0; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
173520             A=:SYMFPHPAGE-1+SYMLPHPAGE=:SYMLPHPAGE
173524             A:=SYMFPHPAGE=:D:=0; AD SHZ 12; A=:MBSYMOD:=D=:CBUF
173533             XIOBUTAB=:"CINDADDR"
173535   % INITIALIZE THE SYNC.MODEM DATAFIELDS WITH
173535   % BUFFER START ADDR, MAX AND CFREE
173535             DO AD:=CINDADDR WHILE A><-1
173541                IF A BIT BISYMOD THEN
173543                   A/\7777; CALL FAR XLOGPH
173545                   CBUF=:X.BUFST
173547                   AD:=CINDADDR
173550                   IF A:=D NBIT 17 THEN A SH 1 ELSE A BZERO 17 FI
173556                   A=:X.MAX=:X.CFREE
173560                   A:=D BZERO 17+CBUF=:CBUF
173564                FI; "CINDADDR"+2=:"CINDADDR"
173567             OD
173570          ELSE
173571             0=:MBSYMOD
173572          FI; GO BYPFILL; *)FILL
