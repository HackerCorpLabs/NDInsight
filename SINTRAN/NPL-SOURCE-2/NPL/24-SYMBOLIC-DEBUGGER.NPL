130633   
130633          300; T:=X2DHD+XWRTC; *EXR ST              % MUST SEE DCE CLEAR REQUEST
130637          X21TB=:TMR; 4=:X2DST; CALL STORE
130644          IF X2DMP.X2MFA NBIT X21C3 THEN            % SKIP ALL THIS IF DIRECT CALL
130650          CALL X2SSS                                % SEND "SYN,SYN"
130651          IF X2DMP.X2MFA /\ 7 >< 0 THEN             % ANY PREFIX ?
130655             IF A BIT X21C1 THEN                    % CHARGING REQUEST ?
