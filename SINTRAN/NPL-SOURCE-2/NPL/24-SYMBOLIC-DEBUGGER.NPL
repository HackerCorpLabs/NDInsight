122523   %            3 G E T X T     (MON 334)
122523   %
122523   SUBR 3GETXT
122523   DISP 0; INTEGER SVACTSG=D0,SVRSGM=D1; PSID
122523   3GETXT:RTREF=:D; ZXREG; T:=100; CALL CHLIM; GO ERR  % CHECK USER'S BUFFER ADDRESS
122531          RTREF.ACTSEG=:SVACTSG; X.RSEGM=:SVRSGM       % SAVE USER'S SEGMENT
122536          MLEV; *MST PIE
122540          T:=ECODSEG; CALL MMEXY                       % GET ERROR-PROGRAM SEGMENT
122542          IF ZAREG<<ER0 THEN
122546             ERSTB(A)
122550          ELSE
122551             IF A<<ERM THEN A-ER0 ELSE A:=0 FI
122557             ERTAB(A)
122561          FI
122561   @LIB CXCPU
122561   @LIB CXCPU-,
122561          X:=A; 100=:L; B=:D; "CBUFF"=:B
122567          DO WHILE L><0                                 % MOVE ERROR-MESSAGE TO BUFFER
122571             *LDA ,X; BSET ZRO; STA ,B; BSET ONE
122575             L-1; X+1; B+1
122600          OD; B:=D; SVRSGM=:RTREF.RSEGM; T:=SVACTSG; CALL MMEXY   % UNSAVE USER'S SEGMENT
122607          OLDPAGE=:D; CALL DALTON; *BSET ZRO
122613          X:=ZXREG; B=:D; 100=:L; "CBUFF"=:B
122621          DO WHILE L><0
122623             *LDA ,B; BSET ONE; STA ,X; BSET ZRO
122627             L-1; X+1; B+1
122632          OD; B:=D; MIN ZPREG; 0/\0; GO RET
122637   @ELIB
122637   ERR:   153=:ZAREG; GO RET                                  % ILLEGAL ADDRESS REFS IN MONCALL
122642   *)FILL
