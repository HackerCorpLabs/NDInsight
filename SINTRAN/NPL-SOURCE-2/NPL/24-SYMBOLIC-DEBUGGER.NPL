122753   %            E X A B S       (MON 335)
122753   %
122753   % ENTRY:     X=WORKING AREA
122753   %            B=PARAMETER LISTE
122753   %
122753   SUBR 3EXABS
122753   
122753   DISP 0; TRIPLE TRIP1=ZPREG,TRIP2=ZAREG,TRIP3=ZSREG; PSID
122753   DISP 4;  INTEGER A3FUNC;     PSID
122753   DISP 5;  DOUBLE A3MEMAD;     PSID
122753   DISP 20; DOUBLE A3MADDR;     PSID
122753   DISP 22; DOUBLE A3NWRD;      PSID
122753   DISP 24; INTEGER A3RETADDR;  PSID
122753   DISP 25; INTEGER A3PLIST;    PSID
122753   
122753   INTEGER SVX=?
122753   
122753   3EXABS:IF X.OLDPAGE NBIT "1" THEN
122756              X=:B; -1=:ZAREG; GO RETSTUPR                    % ERROR, PROG NOT ON RING 2
122762          FI; MLEV; *MCL PIE
122764          X=:SVX
122765          FOR X:="FPL3ABS" STEP 31 TO "LPL3ABS"-31 DO            % FIND PARAMETER FIELD
122772             IF X.RTRES=0 OR A=RTREF GO FOUND
122777          OD
123001          IF X.RTRES=0 THEN X=:B:="DUMMY"; CALL BRESERVE; FI  % RESERVE QUEUEING SEMAPHORE FOR DUMMY
123006          X:=RTREF; CALL FREXQU; CALL TOWQU                   % WAIT FOR ABSTR PARAMETER LISTE
123011          SVX=:B; ZPREG-1=:ZPREG; GO RETSTUPR; *)FILL
123027   
123027   INTEGER SVX
123030   FOUND: X=:B:=RTREF; CALL BRESERVE                          % RESERVE ABSTR PARAMETER LISTE
123033          IF A<0 THEN CALL ERRFATAL FI; X:=SVX
123036          TAD:=X.TRIP1=:TRIP1:=X.TRIP2=:TRIP2:=X.TRIP3=:TRIP3
123044          X:=:B=:SVX:=RTREF; CALL BRELEASE                    % RELEASE ORIGINAL WORKING FIELD
123050          SVX=:B; MLEV; *MST PIE
123054          OLDPAGE=:D; CALL DALTON; *BSET ZRO                  % SET ALT.PIT=USER'S.ALT.PIT
123060          X:=ZAREG; *BSET ONE                                 % SET UP ABSTR PARAMETER LISTE
123062          X:=X.S0; X.S0; *BSET ZRO
123065          A=:A3FUNC; X:=ZAREG; *BSET ONE
123070          X:=X.S1; X.DS0; *BSET ZRO
123073          AD=:A3MEMAD; X:=ZAREG; *BSET ONE
123076          X:=X.S2; X.DS0; *BSET ZRO
123101          AD=:A3MADDR; X:=ZAREG; *BSET ONE
123104          X:=X.S3; X.DS0; *BSET ZRO
123107          AD=:A3NWRD; X=:A3RETADDR
123111          T:=ZTREG; "A3PLIST"+B; *MON 2ABST
123115          A=:ZAREG; X:=A3RETADDR; A3NWRD; *BSET ONE
123121          AD=:X.DS0; *BSET ZRO
123123          MLEV; *MCL PIE
123125          IF "LPL3ABS".RTRES="DUMMY" THEN
123132             IF X.BWLINK><X THEN
123135                X:=:B; X=:SVX:=A; CALL FRWQU; CALL TOEXQU; SVX=:B
123144             FI
123144          FI; X:=RTREF; CALL BRELEASE
123146          GO RET
