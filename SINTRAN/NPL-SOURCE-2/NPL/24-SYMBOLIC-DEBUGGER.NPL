120674   % 34.27      G R T D A   -   G S G N O
120674   %
120674   % GRTDA: MONITOR CALL TO GET ADDR. OF RT-DESCRIPTION
120674   % GSGNO: MONITOR CALL TO GET SEGMENT NUMBER FROM SEGMENT NAME
120674   %
120674   SUBR 3GRTDA,3GSGNO
120674   
120674   DISP 0; DOUBLE DOD1=D1,DOD2=D2; PSID
120674   DISP 0; REAL FS0=S0; PSID
120674   INTEGER CCRSG=?,CFLAG=?
120674   
120674   3GSGNO: 5; GO FELLS
120676   3GRTDA: 7
120677   FELLS: A=:CFLAG; T=:D0
120701          MLEV; *MST PIE
120703          IF LOADI=0 GO FAR ERR
120706          0=:D1=:D2=:D3
120711          CALL ALTON; *BSET ZRO
120713          FOR X:=D0 TO D0+3 DO
120720                RTREF=:D; A:=X; T:=1; CALL CHLIM; GO FAR ERR; *BSET ONE
120727                T:=X.S0; *BSET ZRO
120731                T=:D4
120732                IF D4 SHZ -10/\177=##' GO OUT
120740                A BZERO 6=:T
120742                AD:=DOD1 SH 6; A=:D1; AD:=DOD2 SH 6
120747                D+T; AD=:DOD2
120751                IF D4/\177=##' GO OUT
120756                A BZERO 6=:T
120760                AD:=DOD1 SH 6; A=:D1; AD:=DOD2 SH 6
120765                D+T; AD=:DOD2
120767          OD; GO OUT; *)FILL
121000   INTEGER CCRSG,CFLAG
121002   OUT:   RTREF.ACTSEG=:D4; X.RSEGM=:CCRSG; 0=:X.RSEGM; T:=5RTFIL; CALL MMEXY
121012          X:=6; CALL RALTON; X.S0; *BSET ZRO
121016          A=:D0; X+1
121020          DO WHILE D0><0
121022                *BSET ONE
121023                X.S4; *BSET ZRO
121025                IF A/\7=CFLAG THEN
121031                   *BSET ONE
121032                   TAD:=X.FS0; *BSET ZRO
121034                   IF A-D2=0 AND D=A:=D3 AND T=A:=D1 GO FOUND
121044                FI
121044                X+7; D0-1=:D0
121050          OD; T:=D4; CCRSG=:RTREF.RSEGM; CALL MMEXY
121056   ERR:   -1=:ZAREG; GO RET
121061   FOUND: *BSET ONE
121062          IF CFLAG=7 THEN X.S5; T:=0 ELSE X.S3; T:=1 FI; *BSET ZRO
121074          A=:ZAREG; ZPREG+T=:ZPREG; CCRSG=:RTREF.RSEGM; T:=D4; CALL MMEXY
121105          GO RET
