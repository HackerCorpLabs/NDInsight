125104                IUNIT+DMFLD+"FDIFORM"=:X; X.S0+DMFLD+"WDSCT"=:X
125114                T:=X.S0; A:=IMAXW=:D:=0; *RDIV ST
125121                IF D><0 THEN A+1 FI; A=:MDFI.DBLOCK=:D
125127                IUNIT+DMFLD+"NFDIADR"=:X; X.S0+D=:X.S0-D=:MDFI.DBLO1
125141             FI
125141             IUNIT SH 6+IFUNC=:MDFI.DKFUN
125146          ELSE
125147             IF A BIT 5IBDV AND IFUNC/\ 77 = 1 THEN
125156                DMLOG BONE 17=:DMLOG                          % WRITE ON AN INTERNAL BLOCK DEVICE.
125161             FI
