122356   %=======================================================================
122356   %  11.34     G D E V 3 T Y
122356   %
122356   %  MONITOR CALL TO GET DEVICE-TYPE AND ATTRIBUTES (MON 263)
122356   %
122356   %  ENTRY:        T-REG:   DEVICE NUMBER
122356   %                A-REG:   0=INPUT, 1=OUTPUT
122356   %  SKIP RETURN:  T-REG:   DEVICE TYPE
122356   %                A&D REG: DEVICE ATTRIBUTES
122356   %  RETURN:       A-REG:   ERROR CODE
122356   %   
122356   %  DEVICE TYPES RETURNED IN T-REG
122356   %      0 - UNSPECIFIED
122356   %      1 - TERMINAL
122356   %      2 - BACKGROUND ACCESS DEVICE (BAD)
122356   %      3 - COMMUNICATION CHANNEL
122356   %      4 - INTERNAL BLOCK DEVICE
122356   %      5 - FLOPPY-DISK
122356   %      6 - MAG-TAPE
122356   %      7 - MASS-STORAGE-FILE
122356   %
122356   %  ATTRIBUTES  RETURNED IN A&D REG
122356   %     BIT  0: INBT/OUTBT ALLOWED
122356   %     BIT  1: CONCT ALLOWED
122356   %     BIT  2: IOSET ALLOWED
122356   %     BIT  3: BLOCK CALLS ALLOWED
122356   %     BIT  4: CLEAR DEV ROUTINE AVAILABLE
122356   %     BIT  5: NO RESERVATION NECESSARY
122356   %     BIT  6: COSMOS REMOTE OPEN FILE
122356   %     BIT  7: NN-CHANNEL USED FOR REMOTE OPEN
122356   
122356   SUBR GDEV3TY
122356   SYMBOL 9BTERM=1,9BBAD,9BCOM,9BIBDV,9BFLOP,9BMT,9BRFILE            % TYPES
122356   SYMBOL AIOBT,ACONCT,ATISET,AM144,ACLDV,ANORES,ACOSOP,ANNOP  % ATTRIBUTES
122356   INTEGER POINTER PTTNO:=TTNO,PBCHFLAG:=BCHFLAG, PTTIF:=TTIFIELD
122361   
122361   GDEV3TY:
122361          IF BACKGROUND><0 AND ZTREG=1 THEN
122367             IF PBCHFLAG=0 THEN
122371                PTTNO
122372             ELSE
122373                X:=PTTIF
122374                IF ZAREG=0 THEN X.RIFIL ELSE X.DFOPP.ROFIL FI
122402             FI
122402          ELSE
122403             ZTREG
122404          FI 
122404          CALL LOGPH
122405          IF T:=ZAREG><0 THEN D=:A FI
122411          IF A=0 GO ERR                             % NO SUCH LOGICAL UNIT
122412          IF A.TYPRING BIT 5TERM THEN T:=9BTERM; GO ATRIB FI
122420          IF A BIT 5BAD   THEN T:=9BBAD;   GO ATRIB FI
122424          IF A BIT 5COM   THEN T:=9BCOM;   GO ATRIB FI
122430          IF A BIT 5IBDV  THEN T:=9BIBDV;  GO ATRIB FI
122434          IF A BIT 5FLOP  THEN T:=9BFLOP;  GO ATRIB FI
122440          IF A BIT 5MT    THEN T:=9BMT;    GO ATRIB FI
122444          IF A BIT 5RFILE THEN T:=9BRFILE; GO ATRIB FI
122450          T:=0
122451   ATRIB: T=:ZTREG:=0
122453          IF A BIT 5RFILE THEN
122455             A=:D; IF X.OFFLG BIT 5RCFIL THEN T BONE ACOSOP FI
122462             IF A BIT 5REMPO THEN T BONE ANNOP FI
122465             D=:A
122466          FI
122466          IF A BIT 5IOBT  THEN T BONE AIOBT FI
122471          IF A BIT 5CONCT THEN T BONE ACONCT FI
122474          IF A BIT 5ISET  THEN T BONE ATISET FI
122477          IF A BIT M144B  THEN T BONE AM144 FI
122502          IF A BIT 5CLDV  THEN T BONE ACLDV FI
122505          IF A BIT 5NORES THEN T BONE ANORES FI
122510   
122510   UT:    T=:ZDREG; 0=:ZAREG; MIN ZPREG; 0/\0; GO RET
122515   
122515   ERR:   33=:ZAREG; GO RET
122520   RBUS
