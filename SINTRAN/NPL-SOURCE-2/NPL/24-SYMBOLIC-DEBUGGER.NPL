130763   %      T-REG AT EXIT:
130763   %      T = CODE GROUP NO
130763   %      T < 0 MEANS  T = ERRORCODE-
130763   
130763   SUBR X217
130763   X217:  T:=7=:X2DST; A:=L=:X2DSR; CALL STORE      % ENTERING STATE 7
130770          0=:X2DPC=:X2DPS
130772          DO WHILE X2D00><"X21PL"
130776             IF T:=X2DBC<0 THEN
131001                X:=X2DPC
131002                T:=X2DMP+X2M2; *SBYT                % SAVE BYTE IN MESSAGE
131005             ELSE
131006                T:=X2FSM; GO OUT                    % MESSAGE TOO SMALL
131010             FI
131010             MIN X2DPC; P+0
131012             MIN X2DBC; P+0
131014             IF X2D00><"X21PL" OR ><"X21KO" THEN
131023                X2DPS*12=:T; X2D00-60\/T=:X2DPS     % CONVERT FROM ASCII
131032             FI
131032             IF X2D00="X21KO" AND X2DPS<=24 THEN    % IMPORTENT CP SIGNAL?
131042                0=:X2DPS=:X2DPC                     % NO, FOREGET IT
131044             FI
131044             CALL X2GET; *JMP *-1                   % GET NEXT CHARACTER
131046          OD
131047          IF X2DPS>=24 THEN T:=X2FCP; GO OUT FI     % SERIOUS CP  STOPP
131055          IF X2DPC > 2 THEN T:=X2FEC; GO OUT FI     % EXTENDED CP SIGNAL
131063          T:=0
131064   OUT:   X:=X2DMP; A:=X2DSR=:P 
