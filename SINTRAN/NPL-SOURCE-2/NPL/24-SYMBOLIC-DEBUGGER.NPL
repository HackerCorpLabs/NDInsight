130431          A:=0; *EXR ST
130433          A:=107; T+"XWPCR-XWRTC"; *EXR ST
130436          A:=252; T+"XWSAR-XWPCR"; *EXR ST
130441          A:=0; T+"XWCHL-XWSAR"; *EXR ST
130444          A:=104; T+"XWTTC-XWCHL"; *EXR ST
130447          A:=1; T+"XWTCR-XWTTC"; *EXR ST
