121756   %==============================================================================
121756   %            S T S L I C E 
121756   %
121756   % ROUTINE TO TIMESLICE ND-100 PROCESSES
121756   %
121756   
121756   SUBR STSLICE
121756   
121756   INTEGER CINDEX=?,CTSLPROC=?,CTSLSTATUS=?
121756   
121756   STSLICE:
121756          MLEV; *MCL PIE                   % STSLICE ENTRY POINT
121760          0=:CINDEX; X:=FPTSLICE
121762          DO WHILE X<<LPTSLICE
121765             IF X.WLINK=0 GO NXTSLPROG                   % PROGRAM NOT ACTIVE
121767             X=:B=:CTSLPROC
121771             IF TSLSTATUS(CINDEX) NBIT 5NOSLICE AND NBIT 5SPRF THEN
121777                A=:CTSLSTATUS
122000                IF A BIT 5ESCF THEN                       % WAITING FOR ESCAPE PRIORITY?
122002                   A BZERO 5ESCF BZERO 5BRKF=:CTSLSTATUS  % CLEAR ESCAPE AND BREAK
122005                   A SHZ -7CUTY/\7                        % FIND SLICE TYPE
122007                   TSLESCELEM(A); GO INBRKTEST            % GET ESCAPE ELEMENT
122012                FI
122012                IF A BIT 5BRKF THEN                       % WAITING FOR BREAK PRIORITY?
122014                   A BZERO 5BRKF=:CTSLSTATUS              % CLEAR BREAK FLAG
122016                   IF STATUS/\377<=TSLLOWLG THEN          % CAN PRIORITY BE INCREASED
122023                      CTSLSTATUS SHZ -7CUTY/\7            % FIND SLICE TYPE
122026                      TSLBRKELEM(A)                       % GET BREAK ELEMENT
122030   INBRKTEST:         A=:D:=CTSLSTATUS/\177740\/D=:CTSLSTATUS
122035                      DTIN2=:TSLNTIME(CINDEX)
122040                      GO SETALL                          
122041                   FI
122041                FI
122041   %            A:=TSLNTIME(CINDEX)-TSLIDLE=:TSLNTIME(X)-+DTIN2=:D:=0
122041                A:=DTIN2-TSLNTIME(CINDEX)=:D:=0
122046                T:=TSLTUNIT; *RDIV ST                      % COMPUTE CPU TIME USED
122050                IF A+TSLCOUNTA(X)<0 GO CONWAIT             % TIMESLICE FINISHED?
122052                DTIN2=:TSLNTIME(X)                         % YES, SET NEW CPU TIME
122054   FINNEW:      CTSLSTATUS/\37=:X                          % TIMESLICE ELEMENT
122057                A:=CTSLSTATUS/\177740\/TSLNEXTAB(X)        % FIND NEXT ELEMENT IN CHAIN
122062                A=:CTSLSTATUS/\37=:D
122065   
122065   SETALL:      IF TSLTIMTAB(D)=:T-TSLHTIME>=0 THEN        % HASH ELEMENT?
122072                   DTIN2/\TSLHASHM+T                       % YES; HASH WITH TIME USED
122075                ELSE
122076                   A:=T
122077                FI; A-=:TSLCOUNTA(CINDEX)                  % SET TIMSLICE COUNTER
122102                STATUS/\177400\/TSLPRITAB(D)=:STATUS       % SET PRIORITY ON PROCESS
122107                X:=B; CALL FRWQU
122111                IF A><0 THEN B:=A; CALL TOWQU FI           % UPDATE EX-QUEUE
122114                CTSLSTATUS=:TSLSTATUS(CINDEX)
122117   CONWAIT:  FI; X:=CTSLPROC
122120   NXTSLPROG: X+5RTSIZE; MIN CINDEX
122122          OD; MLEV; *MST PIE
122125          CALL N500SCHEDULER                               % TIMESLISE ND-500 PROCESSES
122126          *IOF
122127          X:=RTREF; CALL FREXQ; 1=:MTOR
122133          "MONEN"; *IRW MLEVB DP
122135          MLEV; *MST PID; ION; JMP *                       % TERMINATE RTSLI (INSTEAD OF MON RTEXT)
122141   
122141   INTEGER CINDEX,CTSLPROC,CTSLSTATUS
122144   
122144   RBUS
122175   %==============================================================================
122175   %            T 3 R E P P     (TREPP  MON 332)    
122175   %
122175   %      MONITORCALL TO DISABLE/ENABLE AND READ TERMINAL REPPORT
122175   %
122175   %      ENTRY: T = LOGICAL DEVICE NUMBER ( 1: OWN TERMINAL BACKGROUND)
122175   %             A = FUNCTION  = 0: DISABLE TERMINAL-REPPORT
122175   %                           = 1: ENABLE  TERMINAL-REPPORT
122175   %                           = 2: READ    TERMINAL-STATUS
122175   %      ERROR RETURN: A = ERROR NUMBER
122175   %      SKIP  RETURN: FUNCTION 0: OK
122175   %                    FUNCTION 1: OK
122175   %                    FUNCTION 2: OK  A = STATUS                 
122175   %                                        BIT  0: 1 - TERMINAL LINE DEAD
122175   %                                        BIT  1: 1 - LOGOUT WAITING FOR MON 0
122175   %                                        BIT  2: 1 - OVERRUN IN INPUT BUFFER
122175   %                                        BIT  3: 1 - PARITY ERROR IN INPUT
122175   %                                        BIT  4: 1 - FRAMING ERROR IN INPUT
122175   %      BITS USED IN FLAGB: 
122175   %           BIT  0: 5TLREP  
122175   %           BIT   : 5LOGOUT 
122175   %           BIT 17: 5LSTA   
122175   %      BITS USED IN TINFO:
122175   %           BIT 17: 5BFUL   - READ AND CLEAR
122175   %           BIT 16: 5PAER   - -----"-------
122175   %           BIT 15: 5FRER   - -----"-------
122175   
122175   SUBR T3REPP
122175   INTEGER POINTER TTIF:=TTIFIELD,PBCHFLAG:=BCHFLAG
122177   T3REPP: IF BACKGROUND><0 AND ZTREG=1 THEN         % BACKGROUND OWN TERMINAL
122205              IF PBCHFLAG=1 GO DUMRE                 % FAKE ALWAYS OK IF BATCH
122211              X:=TTIF                                % TTIFIELD IS TERM. DATAF.
122212          ELSE                                       % RT OR BACKGROUND DEV SPEC.
122213             IF ZTREG/\177700=100 GO ILLDV           % FILE IS ILLEGAL
122220             ZTREG; CALL LOGPH; IF A=0 GO ILLDV      % FIND DATAFIELD
122223             IF A.RTRES><RTREF GO NRESV              % DEVICE MUST BE RESERVED
122230             IF X.TYPRING BIT 5TERM THEN
122233                CALL XSETBFPAGE
122234             FI  
122234          FI
122234          IF X.TYPRING BIT 5COM THEN A:="0"; T:=X.FLAGB; GO IGNLI FI
122242          IF A NBIT 5TERM AND A NBIT 5BAD THEN GO ILLDV FI
122247          IF ZAREG=0 THEN X.FLAGB BZERO 5TLREP=:X.FLAGB; GO DUMRE FI
122255          IF A=1 THEN X.FLAGB BONE 5TLREP=:X.FLAGB; GO DUMRE FI
122264          IF A=2 THEN
122267             A:="0"
122270             IF T:=X.FLAGB BIT 5LSTA THEN
122273                A BONE "0"                                    % LINE IS DEAD
122274             ELSE
122275                IF T BIT 5TLREP AND T BIT 5LOGOUT THEN        % TERMINATION STARTED
122301                   A BONE "0"   % LINE IS UP, BUT NOT RAPPORTED
122302                ELSE
122303                   A BZERO "0"  % LINE IS UP
122304                FI
122304             FI; *IOF
122305             T:=X.TINFO
122306             IF T BIT 5BFUL THEN T BZERO 5BFUL; A BONE 2 FI
122312             IF T BIT 5PAER THEN T BZERO 5PAER; A BONE 3 FI
122316             IF T BIT 5FRER THEN T BZERO 5FRER; A BONE 4 FI; T=:X.TINFO; *ION
122324   IGNLI:    IF T BIT 5LOGOUT THEN A BONE 1 ELSE A BZERO 1 FI % LOGOUT WANTED?         
122331             GO RERET
122332          FI
122332          GO ILLFU
122333   
122333   DUMRE: A:="0"
122334   RERET: MIN ZPREG; 0/\0
122336   RETU:  A=:ZAREG; GO RET
122340   NRESV: A:=5; GO RETU                   % DEVICE NOT RESERVED
122342   ILLDV: A:=240; GO RETU                 % ILLEGAL DEVICE TYPE
122344   ILLFU: A:=201; GO RETU                 % ILLEGAL FUNCTION CODE
122346   RBUS
