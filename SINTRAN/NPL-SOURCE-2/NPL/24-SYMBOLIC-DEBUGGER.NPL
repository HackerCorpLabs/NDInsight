121211   %            3 S P L R E E
121211   %
121211   % THIS ROUTINE IS CALLED FROM SPLREE
121211   %
121211   SUBR 3SPLRE
121211   
121211   DISP 26                      % D5+1
121211   INTEGER CBSGNO,CPOTADDR,CCFP,CCLP,CORSEGM,CCBMX,CCPOTADDR,CREBMAP,CCSGNO
121211   INTEGER NPAGES=CCBMX,PREVT=CCBMX,PREVX=CCPOTADDR,CURRX=CCSGNO
121211   INTEGER CFP1=D1,CLP1=D2,CFP2=D3,CLP2=D4
121211   DOUBLE DDDS1=CFP1,DDDS2=CFP2,DDDD0=D0,DDDD2=D2,DDDD4=D4,CCLMS=CCFP
121211   PSID
121211   DISP 100; DOUBLE D1PREV,D2PREV; PSID   % PREVIOUS LOGICAL ADDRESS AREAS
121211   DISP 0; TRIPLE 3BM0,3BM3; DOUBLE 2BM6; PSID
121211   
121211   % COMPUTE ADDRESSES AND SIZES USED BY SEVERAL ROUTINES
121211   %
121211   GTVALUES: AD=:CCLMS; *BLDA 00 DA
121213             T:=D-A; AD SHZ -4; A+CREBMAP=:CCBMX
121220             AD SHZ 7; A/\170=:D
121223             CCFP SHZ -1; X:=CPOTADDR+A=:CCPOTADDR
121230             EXIT
121231   
121231   % FOR ALL PAGES IN PREVIOUS LOGICAL ADDRESS AREA DO
121231   %      IF BIT OF CORRESPONDING PAGE IN BITMAP IS SET THEN
121231   %         SET CORRESPONDING POT-TABLE ENTRY EQUAL CURRENT REENTRANT SEGMENT
121231   %      FI
121231   % OD
121231   %
121231   INTEGER POINTER LREG=?
121231   INTEGER ENDINSTR(0); *BSKP ONE 170 DT
121232   INTEGER CINSTR(0); *BSKP ONE 00 DT
121233   STPOTTABLE: T:=L=:"LREG"; CALL GTVALUES
121236           T=:L; A:=CINSTR; D\/A
121241           DO WHILE L>>0                            % FOR ALL BITMAP LOCATIONS DO:
121243              IF T:=CCBMX.S0><0 THEN                % IF UNEQUAL ZERO
121247                 *EXR SD                            % TEST EACH BIT
121250                 GO NOTSET
121251                 A:=CORSEG; *BSKP ONE SSK; SHA 10   % A = RSEGM READ FROM RT-D 
121254                 A=:CCSGNO; X=:CCBMX:=CCPOTADDR     % X = ADDRESS OF POT-ENTRY
121257                 T:=SREBBANK; *LDATX                % T = BANK NO. WHERE POT RESIDES; A = POT INFORMATION
121261                 IF K NBIT THEN                     % ACCORDING TO THE SETTING OF K-INDICATOR
121263                     A/\377
121264                 ELSE                               % TAKE RIGHT- OR LEFTMOST BYTE
121265                     A/\177400
121266                 FI 
121266                 A\/CCSGNO; *STATX                  % COMBINE WITH RSEGM-INFO AND UPDATE POT-ENTRY
121270                 *BSKP ZRO SSK 
121271                 MIN CCPOTADDR; 0/\0                % INCREMENT POINTER IN POT-ENTRY
121273   NOTSET:       L-1
121274                 T:=10; IF D+T>>ENDINSTR GO INELSE  % MODIFY BSKP INSTRUCTION TO TEST FOR NEXT BIT
121301                 *BSET BCM SSK                      % SWITCH VALUE OF K-INDICATOR
121302             ELSE
121303                 A:=D SHZ -3/\17; T:=20-A; L-T; T+1 SHZ -1
121313                 CCPOTADDR+T=:CCPOTADDR
121316   INELSE:       CINSTR=:D; K:="0"; MIN CCBMX       % MAKE READY TO TEST NEXT BITMAP WORD
121322             FI
121322           OD; GO LREG
121324   
121324   INTEGER CBSET(0); *BSET ZRO 00 DA
121325   INTEGER LBSET(0); *BSET ZRO 170 DA
121326   INTEGER CLBSGNO
121327   INTEGER POINTER LREG
121330   MBCLBITS: T:=L=:"LREG"; CALL GTVALUES
121333             T=:L; A:=CBSET; D\/A
121336             DO WHILE L><0                          % FOR ALL PAGES IN LOGICAL AREA DO:
121340                X:=CCPOTADDR; T:=SREBBANK; *LDATX   % READ A WORD FROM POT-TABLE
121343                *BSKP ONE SSK                       % SKIP NEXT IF PAGE NO IS AN ODD NUMBER
121344                *SHA ZIN SHR 10                     % SEGMENT NUMBER IN RIGHTMOST BYTE
121345                IF A/\377-D0><0 THEN                % IF EQUAL SEGMENT NO IN PARAMETERLIST
121350                   *LDATX; BSKP ZRO SSK; JMP RBY
121353                   A/\377\/CLBSGNO; GO FELLS
121356   RBY:            A/\177400\/CBSGNO
121360   FELLS:          *STATX
121361                   X:=CCBMX; X.S0; *EXR SD          %   SET THE RESPECTIVE BIT TO 1 
121364                   A=:X.S0                          %   IN BITMAP
121365                FI; T:=10
121366                IF D+T>>LBSET THEN                  % IF LAST BIT IN THIS LOC. HAS BEEN SET
121372                    CBSET=:D; MIN CCBMX; 0/\0       %   MAKE READY FOR THE NEXT ONE
121376                FI
121376                *BSET BCM SSK                       % SWITCH VALUE OF K (INDICATES ODD OR EVEN PAGE NO)
121377                IF K NBIT THEN MIN CCPOTADDR; 0/\0 FI; L-1            
121404            OD; GO LREG
121406   *)FILL
121413   
121413   TRIPLE ALLONES(0); *-1;-1;-1
121416   
121416   CCHLIMS: D+A; IF C OR A>>200 OR D>>T GO CR15ERRD
121426            EXIT
121427   
121427   CR15ERRD: D0; GO R15ERRD
121431   
121431   3SPLRE: RTREF.SEGM SHZ -10+1=:CBSGNO                       % GET BACKGROUND SEGMENT NO
121436           T:=A SH 10=:CLBSGNO
121441           IF A*5SEGSIZE+SEGSTART><NSEGB GO RETSTUPR          % IF UNEQUAL NSEGB START SCANNING EXEC.QUEUE
121446           A:=RTREF-"BAK01"=:D:=0; T:=5RTSIZE; *RDIV ST       % INDEX IN RT-D TABLE, BAK01 = INDEX 0
121454           A*POTESIZE+SREBADDR=:CPOTADDR; X.RSEGM=:CORSEGM    % CPOTADDR = POINTER TO POT-ENTRY, SAVE REENTR. SEG NO
121461           X.RTDLGADDR+5BITMAP=:CREBMAP
121464           IF D0=0 AND CORSEGM=0 THEN
121470              X:=NSEGB; CBSGNO; CALL WSEGX                    % WRITE SHADOW SEGMENT BACK
121473           FI
121473           IF D0><0 THEN                                      % IF SEGMENT NUMBER UNEQUAL O
121475              CALL LEGSEG; IF A NBIT 5SREEP GO CR15ERRD       % LEGAL SEGMENT ? DEMAND SEGMENT?
121500              IF A SHZ -11/\3><0 GO CR15ERRD                  % RING ><0 ?   
121503              IF X.LOGADR SHZ -6/\3<1 OR A>2 GO CR15ERRD      % PAGE TABLE MUST BE 1 OR 2
121514           FI
121514           AD:=DDDS1; CALL CCHLIMS; AD=:DDDS1                 % LOGICAL AREA 1 TOO LARGE?
121517           AD:=DDDS2; CALL CCHLIMS; AD=:DDDS2                 % LOGICAL AREA 2 TOO LARGE?
121522           IF D5><0 THEN                                      % IF POT-ENTRY FOR THIS PROGRAM IS TO BE CLEARED
121524              X:=CPOTADDR; A:=X+100=:L                        %    X POINTS TO START OF POT-ENTRY, L POINTS TO THE NEXT
121530              CBSGNO SH 10\/CBSGNO=:D; T:=SREBBANK             
121535              DO WHILE X><L                                   %    FOR ALL BYTES IN THE POT-ENTRY
121537                 *STDTX; AAX 2                                %    FILL IN BACKGROUND SEGMENT NUMBER
121541              OD;
121542           ELSE
121543              IF CORSEGM><0 THEN
121545                 X:=CPOTADDR; T:=SREBBANK; *AAX D1PRE; LDDTX
121551                 CALL FAR STPOTTABLE
121552                 X:=CPOTADDR; T:=SREBBANK; *AAX D2PRE; LDDTX
121556                 CALL FAR STPOTTABLE
121557              FI
121557           FI
121557           TAD:=ALLONES=:CREBMAP.3BM0=:X.3BM3; AD=:X.2BM6
121564           IF D0><0 THEN
121566              AD:=DDDS1; CALL FAR MBCLBITS 
121570              AD:=DDDS2; CALL FAR MBCLBITS
121572           FI; GO L1; *)FILL
121613   
121613   INTEGER POINTER PPBPAG1:=BPAG1
121614   INTEGER CBSKP(0); *BSKP ZRO 00 DT
121615   L1:     AD:=DDDS1; T:=SREBBANK; X:=CPOTADDR; *AAX D1PRE; STDTX
121622           T:=100; A+T; D+T; AD=:DDDS1
121626           AD:=DDDS2; T:=SREBBANK; *AAX D2PRE-D1PRE; STDTX
121632           T:=100; A+T; D+T; AD=:DDDS2
121636           IF D0><0 THEN
121640              T:=0; X:=NSEGB+1   % BPAGLINK=1
121643              DO
121643                 T=:PREVT; X=:PREVX; *LDXTX DPAGL
121646              WHILE X><0
121647                 T:=CORMBANK; X=:CURRX; *LDATX DALOG
121652                 IF A>=CFP1 AND A<CLP1 GO COVERLAP
121660                 IF A<CFP2 OR A>=CLP2 GO NOVERLAP
121666   COVERLAP:     A-100; AD SHZ -4; A+CREBMAP=:X
121672                 AD SH 7; A/\170+CBSKP; T:=X.S0; *EXR SA
121677                 GO NOVERLAP
121700                 X:=CURRX; T:=CORMBANK; *LDATX DPAGL
121703                 A=:L:=PPBPAG1; *STATX DPAGL
121706                 A:=1; *STATX DPGPR
121710                 X=:PPBPAG1:=PREVX; T:=PREVT; A:=L; *STATX DPAGL
121715                 GO EDO    
121716   NOVERLAP:     T:=CORMBANK; X:=CURRX
121720   EDO:       OD
121721              IF PPBPAG1><0 AND "XSGRT".SEGLINK=0 THEN
121726                 X:="BSEGLINK"; DO WHILE X.SEGLINK><-1; X:=A; OD
121735                 "XSGRT"=:X.SEGLINK; -1=:"XSGRT".SEGLINK
121742              FI
121742           FI; D0=:RTREF.RSEGM; GO RETSTUPR
121746   RBUS
