"123162   %==============================================================================
123162   %            E L O N 3    E L O F 3
123162   
123162   % MONITOR CALLS TO TURN ON OFF DELAYED ESCAPE HANDLING
123162   %
123162   % ELON3  (ELON  - MON 302)   - NORMAL  ESCAPE/LOCAL DETECTION
123162   % ELOF3  (ELOFF - MON 303)   - DELAYED ESCAPE/LOCAL DETECTION
123162   SUBR ELON3,ELOF3,T207RET
123162   INTEGER POINTER TTIF:=TTIFIELD
123163   ELON3: IF TTIF=0 THEN 33; GO RETU; FI
123167          IF A.TYPRING NBIT 5TERM AND A NBIT 5BAD AND A NBIT 5COM THEN
123177             240; GO RETU
123201          FI
123201          IF X.FLAGB BIT 5WLOC THEN                  
123204                IF A BIT 5LCHAR THEN
123206                   X.LUSADD=:ZPREG        % RETURN IN LOCAL CHAR HANDLING
123210                   GO ESON
123211                FI
123211          FI
123211          IF A BIT 5WESC THEN
123213                X:=:B; GO T2P07           % ESCAPE RESPONSE IF TAD
123215   T207RET:     X:=:B                     % T2P07 ALWAYS RETURNS TO T207RET
123216                IF X.FLAGB BIT 5USESC THEN
123221                   X.EUSADD=:ZPREG        % RETURN IN USER ESCAPE HANDLING
123223                   GO ESON
123224                ELSE
123225                   "XBRTWT"               % SYSTEM ESCAPE HANDLING
123226                   *IOF; IRW MLEVB DP
123230                   MLEV; *MST PID
123232                FI
123232          FI
123232          MIN ZPREG; 0/\0
123234   ESON:  X.FLAGB BZERO 5ESCLOFF; GO OUT
123237   
123237   ELOF3: CALL GET0; IF TTIF=0 THEN 33; GO RETU; FI
123244          IF A.TYPRING NBIT 5TERM AND A NBIT 5BAD AND A NBIT 5COM THEN
123254             240; GO RETU
123256          FI
123256          X.FLAGB BONE 5ESCLOFF; MIN ZPREG; 0/\0; GO OFOUT
123263   OUT:   A BZERO 5WLOC BZERO 5WESC
123265   OFOUT: A=:X.FLAGB; A:=0; *ION
123270   RETU:  A=:ZAREG; GO RET
123272   RBUS
