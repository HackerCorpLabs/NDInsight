066355   *"8HDMA
"066355   %===========================================================================
066355   % 34.21      C H D V B U F
066355   %
066355   % SUBROUTINE TO CHECK IF A DEVICE BUFFER IS RESERVED FOR THIS LOGICAL
066355   % DEVICE UNIT BY THE PROGRAM WHICH HAS RESERVED THE LOGICAL
066355   % DEVICE UNIT
066355   %
066355   % ENTRY:     B=ADDRESS OF I/O DATAFILELD
066355   % EXIT:      NO DEVICE BUFFER RESERVED
066355   % EXITA:     DEVICE BUFFER RESERVED
066355   %
066355   SUBR CHDVBUF
066355   DISP -1; INTEGER ADRBHEAD; PSID        % ADDRESS OF BUFFER HEADER
066355   DISP 5; INTEGER LGIOLOG; PSID          % LOGICAL DEVICE NUMBER IN BUFFER
066355   DISP 40; INTEGER CIOLOG; PSID          % LOGICAL DEVICE NUMBER IN DATAFIELD
066355   
066355   CHDVBUF:
066355          X=:D
066356          IF ADRBHEAD=0 OR A.RTRES><RTRES OR X.LGIOLOG><CIOLOG THEN
066371             X:=D
066372             EXIT
066373          FI
066373          X:=D; EXITA
