067155   *"8CXHD+8C1X2+8C2X2+8C3X2+8C4X2
"067155   

067155   %=======================================================================
067155   % 34.31     X T L X    S T U S P   S T L 1 2    S T L 1 3
067155   %
067155   %      MONITOR CALL HDLC
067155   %
067155   %=======================================================================
067155   %
067155   %
067155   %PUROSE: SIMULATE XTLX MONITOR CALLS FOR COMMUNICATION
067155   %        WITH HDCL-DRIVER.
067155   %
067155   %ARGUMENTS:
067155   %
067155   %ENTRY: X-DEMFIELD, B-PARAMPOINTER
067155   %      PT=0, APT=USER PT, LEV 3 ENABLED, PON, ION
067155   %
067155   %EXIT: WHEN ENTRING THE CODE IN POF (HDLC),THE B-REG WILL
067155   %      POINT TO THE APPROPRIATE BASEFIELD,WHICH IN TURN
067155   %      WILL CONTAIN THE USER CALL PARAMETERS.
067155   %
067155   %
067155   %CALLING SEQUENCE:
067155   %
067155   %      A-REG - POINTER TO PARAM ADDRESSES
067155   %      MON  HDLC
067155   %      POINTER TO PARAM1
067155   %      POINTER TO PARAM2
067155   %      POINTER TO BUFFER
067155   %      POINTER TO PARAM4
067155   %      POINTER TO PARAM5
067155   %
067155   %      P1 - FUNCTION. SEND OR RECEIVE
067155   %      P2 - PORT NO. (LOGICAL UNIT NO.)
067155   %      P3 - BUFFER
067155   %      P4 - BYTECOUNT
067155   %      P5 - P1 - 1  MAX BYTECOUNT OF MESSAGE
067155   %           P1 - 2  WAIT/CONTINUE IF NO MESSAGE IN QUEUE
067155   %
067155   %
067155   DISP -9
067155          INTEGER HXDOK                   %LOCK,OPERATED BY X21(1-LOCKED,0-OPEN)
067155          INTEGER HXTMO                   %ADDRESS OF TIMEOUT-ROUTINE IN POF
067155   PSID
067155   SUBR XTLX,STUSP,IMHDLC
067155   %
067155   %      TEMPORARY WORKING AREA
067155   %
067155   INTEGER ARRAY POINTER TDAFI                      %CURRENT DATAFIELD
067156   INTEGER ARRAY POINTER TDEFI                      %DEMANDFIELD
067157   INTEGER TEMP
067160   INTEGER BFADR                                   
067161   %
067161   XTLX:  *BSET ZRO
067162          CALL GAPIT; CALL DALTON
067164          A:="P2"=:BFADR                            %USER BUFFER ADDRESS
067166          IF P0 = FRECV OR A=FMXRECV THEN
067175                A:="P3"=:TEMP                       %RETURN ADDRESS OF BYTECOUNT
067177                CALL GET5; *BSET ZRO
067201                TEMP=:X.D3
067203          ELSE
067204                IF P0 = FSEND THEN
067210                   CALL GET5
067211                ELSE
067212                   T:=EFUNC; GO ERET   %ILLEGAL FUNCTION
067214                FI
067214          FI; *BSET ZRO
067215          BFADR=:X.D2
067217          X=:"TDEFI"
067220   %
067220   %      LEV 3 DISABLED, TURN OFF PAGING
067220   %
067220          CALL ALTON; *POF                          %SET ALT PAG AND KEEP IT
067222   %
067222   %      FIND DATAFIELD AND RESERVE IT
067222   %
067222          A:=X.D1; CALL LOGPH;
067224          IF A = 0 THEN A:=D FI                     %TRY OUTPUT-FIELD
067226          IF A = 0 THEN T:=E2; GO ERET; FI
067231          A=:"TDAFI"=:B
067233          IF X.TYPRING >< 0 THEN T:=EDEVN; GO ERET FI         %*81F*
067237          IF HXCC >< HXCOD THEN T:=EDEVN; GO ERET FI  % CORRECT DATAFIELD ?
067245          IF CURPR><RTRES THEN                      % *80B*
067251            T:=E1;  GO ERET;                        % *80B* *81F*
067253          FI                                        % *80B*
067253   %
067253   %      COPY DATA TO DATAFIELD AND RELEASE DEMFIELD
067253   %
067253          A:="TDAFI"+OFSET=:"TDAFI"
067256          FOR X:= ST TO SP DO TDEFI(X)=:TDAFI(X) OD;
067266          A:="TDEFI"=:B
067270          X:=CURPROG; CALL BRELEASE;
067272          A:="TDAFI"-OFSET=:"TDAFI"=:B              %DATAFIELDPOINTER
067276   %
067276   %
067276          CALL HDLC                                 % GO TO POF AREA
067277   %
067277   %
067277   %      RETURN SEQUENCE
067277   %
067277   %      ARGUMENTS:
067277   %            B - DATAFIELDPOINTER
067277   %            T = 0, OK, GIVE SKIP RETURN
067277   %            MESSID = MESSAGE IDENTIFICATOR
067277   %  
067277   %      T ><0, ERROR, NO SKIP RETURN
067277   %
067277   %      POF
067277   %
067277   HBACK: IF T><0 THEN
067301              B+OFSET
067302   ERET1:     T=:ZAREG; GO RET                      %*81F*
067304         FI
067304         A:=MESSID; B+OFSET; A=:ZAREG
067307         ZPREG+1=:ZPREG; GO RET
067313   ERET: X=:B; GO ERET1                             % *81F*
067315   %
067315   %      ROUTINE FOR STORING IN USER PARAM
067315   %
067315   %      T - VALUE TO BE STORED
067315   %
067315   %      USER ADDR. IN DDD3 IN DATAFIELD
067315   %
067315   DISP 0; INTEGER HNULL; PSID
067315   STUSP: MLEV; *IOF; MST PIE; PION                 %MUST ALLOW PAGEFAULT
067321          X:=B+OFSET; *BSET ZRO
067324          CALL GAPIT; CALL DALTON; *BSET ZRO
067327          A:=DDD3; A=:B; *BSET ONE
067332          T=:HNULL; X=:B; *BSET ZRO                  %STORE IN USER PARAM
067335          CALL ALTON; B-OFSET
067337          MLEV; *MCL PIE; POF
067342          GO IMHDLC                                 % CONTINUE IN ROUTINE HDLC IN POF
067343   RBUS
067356   
067356   %      START LEVEL 12/13 IN POF AREA AT ADDRESS IN T-REG
067356   %      B-REG FROM CALLIN LEVEL IS COPIED
067356   %      RETURN TO CALLER WITH PIOF
067356   
067356   SUBR STL12                                       %*80B*
067356   STL12: "SLV12"; *IOF; IRW LV12B DP               %*80B*
067361          A:=B; *IRW LV12B DB                       %*80B*
067363          A:=T; *IRW LV12B DT                       %*80B*
067365          LV12; *MST PID; PION; PIOF; EXIT          %*80E*
067372   RBUS                                             %*80B*
067374   SUBR STL13                                       %*80B*
067374   STL13: "SLV13"; *IOF; IRW LV13B DP               %*80B*
067377          A:=B; *IRW LV13B DB                       %*80B*
067401          A:=T; *IRW LV13B DT                       %*80B*
067403          LV13; *MST PID; PION; PIOF; EXIT          %*80B*
067410   RBUS                                             %*80B*
