065352   % 34.10      C B G E T   C B P U T   C A I C L   S M T R A   C A O C L
065352   %
065352   %
065352   % IOTRANS ROUTINE FOR MAG.TAPE, VERSATEC ON DMA, CASSETTE
065352   % AND FLOPPY DISC
065352   %
065352   
065352   SUBR CBGET,CBPUT,CAICL,SMTRA,CAOCL
065352   
065352   % VARIABLES IN I/O DATAFIELD
065352   DISP 24
065352   INTEGER LREGC                % RETURN ADDRESS AFTER IOTRANS IS EXECUTED
065352   INTEGER CASUN                % DEVICE UNIT NUMBER
065352   INTEGER CERROR               % CURRENT ERROR CODE
065352   INTEGER LASTC                % CURRENT CHARACTER
065352   INTEGER NOWRE                % NUMBER OF CHARACTERS TO READ/WRITE
065352   INTEGER CPARM(4)             % PARAMETER LIST FOR MTRANS (FIRST WORD IN MEMORY
065352                                % BUFFER ADDRESS IS MBUFB.
065352   INTEGER MBUFB                % BANK NUMBER IN WHICH THE DEVICE BUFFERS LIE.
065352   INTEGER MABUF                % SECOND WORD IN MEMORY BUFFER ADDRESS
065352   DOUBLE MBPAG=MBUFB
065352   INTEGER VEFUNC               % PRINT OR PLOT MODUS IF VERSATEC (10=PLOT,11=PRINT)
065352   INTEGER CIOLOG               % LOGICAL DEVICE NUMBER OF I/O DATAFIELD
065352   INTEGER FDIADR               % FLOPPY DISC ADDRESS
065352   INTEGER POINTER PLREGC=LREGC
065352   PSID
065352   DISP -1; INTEGER ADRBHEAD; PSID        % BUFFER HEADER ADDRESS
065352   
065352   % VARIABLES IN DMA DEVICE DATAFIELD
065352   DISP 12; INTEGER MRTREF; PSID          % PROGRAM CALLING CLOSE
065352   DISP 13; INTEGER BREGC; PSID       % ADDRESS OF I/O DATAFIELD
065352   DISP 0; REAL RFMAX=MAX; DOUBLE DBHOLD=BHOLD; PSID
065352   INTEGER BREG=?
065352   
065352   CBGET: A:=L=:LREGC; *PION              % LEVEL 4
065355          CALL CBF1
065356          IF BHOLD><0 THEN
065360             IF A=1 AND CERROR><0 THEN A=:DERROR FI
065366             *PIOF
065367             CALL DBGET; *PION
065371             MIN LREGC; GO PLREGC
065373          FI
065373          A:=B; *IRW MLEVB DB
065375          "CGMLEV"; *IRW MLEVB DP
065377          MLEV; *MST PID; WAIT
065402          CALL ERRFATAL
065403          *)FILL
065407   
065407   % MONITOR LEVEL
065407   
065407   CGMLEV:CALL CBF2; CALL MTRANS; CALL BRELEASE; CALL CBUNLOCK
065413          CALL MBFDISC; X:=BREGC;0=:X.CERRO
065416          IF TYPRING BIT 5FLOP THEN
065421             IF HSTAT NBIT 4 THEN
065424                IF A BIT 5 THEN A BONE 4=:HSTAT; 3=:CERRCODE; A:=0
065433                ELSE
065434                   X:=BREGC.CASUN; X:=FDIFORM(X); WDSCT(X)     % WORDS PER SECTOR ACCORDING TO FORMAT
065440                FI
065440             ELSE
065441                A:=0
065442             FI; A=:BREGC.NOWRE
065444          FI
065444          IF HSTAT BIT 4 THEN X:=:B; CALL MERRCODE; X:=:B
065452             IF T:=X.NOWRE=0 THEN A=:X.DERROR ELSE A=:X.CERROR FI
065460          FI
065460   CBGE1: X=:B;NOWRE SHZ 1=:BHOLD;0=:HENTE
065465          GO STUPR
065466   
065466   ERR1:  A:=172                % NO DEVICE BUFFER AVAILABLE
065467   ERR:   A=:DERROR; GO PLREGC
065471   *)FILL
065477   
065477   INTEGER BREG
065500   INTEGER POINTER REGL
065501   
065501   % RESERVE THE DFOPP-DATAFIELD AND RESERVE DEVICE BUFFER
065501   
065501   CBF1:  T:=L=:"REGL"
065503          CALL CHDVBUF; GO CNBUF; GO L1
065506   CNBUF: CLOGDV; CALL LOGPH; IF A=0 THEN 2; GO ERR FI
065513          IF A.TYPRING BIT 5FLOP THEN
065517                X=:D; A:=X+CASUN+"FDIFORM"=:X; X.S0+D+"WDSCT"=:X
065530                X.S0 SH 1=:MAX
065533          FI
065533          T:=CIOLOG; MAX SHZ -1; CALL G5BUF; GO ERR1
065540          AD=:MBPAG; A:=D=:BUFST; T=:ADRBHEAD                 % PUT ADDRESS OF DEVICE BUFFER AND DEVICE BUFFER HEADER
065544          0=:BHOLD=:FYLLE=:HENTE; MAX=:CFREE                  % IN THE FLOPPY INBYTE/OUTBYTE DATA FIELD.
065551   L1:    IF X:=DFOPP=0 GO REGL
065554          IF X.RTRES><RTREF THEN
065560             B=:D:=X; X:=T; CALL BRESERVE; D=:B
065565             IF A<0 THEN A:=205; GO ERR FI          % DEV. ALREADY RESERVED
065570          FI; GO REGL
065571          
065571   CBF2:  A:=L=:"REGL"
065573          *IRR ALEVB DP
065574          A-1;*IRW ALEVB DP
065576          MAX SHZ -1=:NOWRE; CLOGDV; CALL LOGPH
065603          IF A=0 THEN 2; GO ERR FI        % NO  "DMA" DATAFIELD
065606          A:=:B;A=:BREG; CALL CBLOCK;X:=RTREF;CALL BRESERVE  % RESERVE "DMA" DATAFIELD
065613          IF A<0 THEN CALL FREXQU;CALL TOWQU; CALL CBUNLOCK
065617                GO STUPR FI               % WAIT FOR "DMA" DEVICE TO BE FREE
065620          IF TYPRING BIT 5FLOP THEN
065623             1=:BREG.NOWRE
065626             X:=X.CASUN; NFDIADR(X)=:BREG.FDIADR
065632          FI; BREG=:BREGC; A+"CPARM"; GO REGL
065636   *)FILL
065654   
065654   CBPUT: X:=L=:LREGC;A=:LASTC; *PION
065660          CALL CBF1
065661          IF CFREE><0 THEN
065663             LASTC; *PIOF
065665             CALL DBPUT; *PION
065667             MIN LREGC; GO PLREGC
065671          FI
065671          A:=B; *IRW MLEVB DB
065673          "CBMLEV"; *IRW MLEVB DP
065675          MLEV; *MST PID; WAIT
065700   
065700   % MONITOR LEVEL
065700   CBMLEV:CALL CBF2
065701          CALL MTRANS;CALL BRELEASE; CALL CBUNLOCK
065704          CALL MBFDISC; X:=BREGC
065706          IF HSTAT BIT 4 THEN X:=:B; CALL MERRCODE; X:=:B; A=:X.DERROR FI
065715          X=:B;MAX=:CFREE;0=:FYLLE=:BHOLD;GO STUPR
065723   *)FILL
065734   
065734   % INCREMENT DISC ADDRESS IF FLOPPY DISC
065734   MBFDISC: IF TYPRING BIT 5FLOP THEN
065737                X:=BREGC.CASUN; MIN NFDIADR(X); 0/\0
065743            FI; EXIT
065744   
065744   
065744   % IOSET ROUTINE FOR MAG.TAPE, VERSATEC ON DMA, LINE-PRINTER, FLOPPY
065744   % AND CASSETTE
065744   
065744   
065744   INTEGER POINTER LREG=?
065744   
065744   % ENTRY POINT FOR INPUT
065744   CAICL: IF A><-1 AND ><-2 THEN EXIT FI
065753   CAICF: A:=L=:"LREG"
065755          CALL CHDVBUF; GO CAIC1
065757          "CAIC4"; *IRW BLEVB DP
065761          CIOLOG; *IRW BLEVB DT
065763          BLEV; *MST PID
065765   CAIC1: 0=:BHOLD=:HENTE=:BUFST=:ADRBHEAD; MAX=:CFREE
065773          A:=0; GO LREG
065775   CAIC4: CALL R5BUF; CALL ERRFATAL; *WAIT
066000          CALL ERRFATAL
066001   
066001   INTEGER SAVEB
066002   INTEGER REGB=?,XREG=?
066002   INTEGER POINTER LREG
066003   
066003   % ENTRY POINT FOR OUTPUT
066003   CAOCL: IF A><-1 THEN IF A=-2 GO CAICF; EXIT FI
066012          IF BHOLD=0 GO CAICF
066014          A:=L=:"LREG"; CALL CHDVBUF; GO CAIC1
066020          X=:XREG
066021          A:=B=:REGB;CLOGDV;CALL LOGPH;A=:B
066026          X:=XREG; CALL CB2LOCK; X:=RTREF;CALL BRESERVE
066032          IF A<0 THEN           % WAIT FOR "DMA"DEVICE
066033                CALL FREXQU;CALL TOWQU; XREG=:B; ZPREG-1=:ZPREG
066042                CALL CBUNLOCK; GO RETSTUPR; *)FILL
066060          FI
066060          RTREF=:MRTREF; X:=REGB; X:=:B; CALL CHDVBUF; GO UT; X=:B
066067          IF TYPRING BIT 5FLOP THEN
066072             IF REGB.BHOLD><X.MAX THEN
066077                A:=B=:SAVEB; X=:B
066102                DO WHILE BHOLD><MAX
066106                   *PIOF
066107                   A:=0; CALL DBPUT; *PION
066112                OD; A:=SAVEB=:B
066115             FI
066115          FI; GO FILSK; *)FILL
066121   
066121   INTEGER REGB,XREG
066123   
066123   FILSK: REGB=:BREGC=:B; "SMTRA"=:MFUNC
066130          IF BHOLD BIT "0" THEN           % ODD NUMBER OF BYTES IN BUFFER
066133             *PIOF
066134             A:=0; CALL DBPUT; *PION
066137          FI
066137          IF TYPRING BIT 5MT THEN
066142             DO WHILE BHOLD<22            % RECORD OF AT LEAST 22 BYTES MUST
066146                *PIOF                     % BE WRITTEN ON MAG TAPE FOR IT TO
066147                A:=0; CALL DBPUT; *PION   % BE DISTINGUISHED FROM NOISE
066152             OD
066153          FI
066153          A:=BHOLD SHZ -1=:NOWRE; CALL RTACT
066157          X:=RTREF; CALL WDATA
066161   UT:    XREG=:B; GO RET
066164   *)FILL
066172   
066172   % SUBROUTINE TO SET UP A CALL TO THE MASS STORAGE DRIVER
066172   % MONITOR LEVEL
066172   
066172   SMTRA: X=:B                            % LEVEL 3
066173          CLOGDV; CALL LOGPH; A=:X
066176          "SRETRA"=:X.MFUNC
066200          IF X.TYPRING BIT 5FLOP THEN
066203             X=:D; 1=:NOWRE; CASUN+X+"NFDIADR"=:X; X.S0; MIN X.S0; 0/\0
066215            A=:FDIADR; D=:X
066217          FI
066217          A:=B+"CPARM"; X=:B;CALL CMTRANS
066223          IF HSTAT BIT 4 THEN X:=:B; CALL MERRCODE; X:=:B ELSE A:=0 FI; A=:D
066234          IF CURPROG=MRTREF THEN
066240              A:=D; *IRW ALEVB DA
066242          ELSE
066243             A:=D; X:=MRTREF.RTDLGADDR; T:=0; *STATX XTDAR
066250          FI; X:=MRTREF
066251          "RETRANS"=:MFUNC; CALL BRELEASE; CALL CBUNLOCK; BREGC=:B
066257          "IORES"=:MFUNC
066261   OUT:   0=:BHOLD=:HENTE=:FYLLE; MAX=:CFREE
066266          CALL CHDVBUF; GO STUPR
066270          T:=CIOLOG; CALL R5BUF; CALL ERRFATAL; 0=:ADRBHEAD
066274          GO STUPR
