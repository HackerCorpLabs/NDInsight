060511   %      B A C G R O U N D   A L L O C A T I O N   S Y S T E M
060511   %
060511   INTEGER NONTTMCOUNT:=10      % ALLOWED TIME INACTIVE WHEN NOT LOGGED IN (2 MINUTES)
060512   INTEGER TTMWARNING:=144      % TIME INACTIVE BEFORE WARNING IS GIVEN (25 MINUTES)
060513   INTEGER ONTTMCOUNT:=170      % ALLOWED TIME INACTIVE BEFORE LOGGED OUT (30 MINUTES)
060514   INTEGER MBSPRTAB,ASBPRTAB    % PHYSICAL ADDRESS OF SPRTAB
060516   INTEGER AEBPRTAB             % PHYSICAL ADDR OF END OF SBPRTAB
060517   INTEGER AEPRVTTABL           % PHYSICAL ADDR OF END OF PRVTTABLE
060520   INTEGER MBPRVTTABLE=MBSPRTAB,APRVTTABLE  % PHYSICAL ADDRESS OF PRVTTABLE
060521   
060521   %=============================================================================
060521   %      T I M E S L I C E   D E F I N I T I O N S
060521   %
060521   %INTEGER TSLIDLES:=0
060521   INTEGER TSLTUNIT:=14         % BASIC TIME UNITS PER SCHEDULER TIME UNIT
060522   INTEGER TSLSYSPRI:=67        % PRIORITY TO OWNER OF SYSTEM RESOURCE WHICH IS WAITED FOR
060523   INTEGER TSLLOWLG:=40         % LOWEST LEGAL PRIORITY FOR INCREASING PRIORITY WHEN BREAK
060524   INTEGER TSLHTIME:=22         % TIME COUNTER LIMIT FOR HASHING
060525   INTEGER TSLHASHM:=17         % MAX HASH DISPLACEMENT MASK
060526   INTEGER FPTSLICE:=BAK01      % FIRST PROCESS TO TIMESLICE
060527   INTEGER LPTSLICE:=THISS      % LAST PROCESS TO TIMESLICE
060530          DOUBLE DFPTSLICE=FPTSLICE
060530   
060530   INTEGER ARRAY TSLBRKELEM:=( 1,10,12,15,21, 1, 1, 1)   % START ELEMENT NUMBER WHEN BREAK
060540   INTEGER ARRAY TSLESCELEM:=( 0, 7,12,15,21, 0, 0, 0)   % START ELEMENT NUMBER WHEN ESCAPE
060550   INTEGER ARRAY TSLLPRITAB:=(24,20,24,24,24,24,24,24)   % HIGHEST PRIORITY ON "ND-500 LOWER TIMESLICE CLASS" PRIORITY
060560   
060560   @ICR;
060560   % CHAIN ELEMENT NUMBER    0  1  2  3  4  5  6    7  10 11   12 13 14   15 16 17 
060560   %
060560   INTEGER ARRAY TSLPRITAB:=(60,55,44,40,30,24,20,  45,20,16,  46,41,21,  44,34,24,
060600                             17,50,42,35,00,00,00,00,  00,00,00,00,00,00,00,00);
060620   INTEGER ARRAY TSLTIMTAB:=( 1, 3, 6,14,30,50, 4,   4,22,22,   2,22,40,   2,10,40,
060640                             10, 3, 6,14,00,00,00,00,  00,00,00,00,00,00,00,00);
060660   INTEGER ARRAY TSLNEXTAB:=( 1, 2, 3, 4, 5, 6, 5,  10,11,10,  13,14,13,  16,17,20,
060700                             17,22,23, 4,00,00,00,00,  00,00,00,00,00,00,00,00);
060720   @CR;
060720   INTEGER ARRAY TSLCOUNTA=?
060720   INTEGER ARRAY TSLNTIME=?
060720   
060720   %==============================================================================
060720   %            T I M E  S L I C E R
060720   %
060720   % 14.0       S T S L I C E   S T B A C K   A N T I J A M M E R
060720   %
060720   
060720   @ICR;
060720   SUBR STSLICE,STBACK,ANTIJAMMER,ANTI2JAMMER,TSTBACK,
060720   S5ESCF,RESAJ,XS5ESC,XSTBACK,GTSLPINDEX;
060720   @CR;
060720   
060720   
060720   %==============================================================================
060720   %            X S T B A C K
060720   %
060720   % SUBROUTINE TO SET BREAK PRIORITY ON TIMESLICED PROCESS
060720   %
060720   % ENTRY:     X=INPUT DATAFIELD ("TERMINAL")
060720   %
060720   XSTBACK:
060720   @LIB CXCPU
060720          GO L1
060721   
060721   %==============================================================================
060721   %            T S T B A C K   -   S T B A C K
060721   %
060721   % SUBROUTINE TO SET HIGH PRIORITY ON BREAK CHARACTERS
060721   % ENTRY:     B=DATAFIELD
060721   % TSTBACK IS CALLED FROM TERMINAL INPUT/OUTPUT DRIVER 
060721   TSTBACK:
060721   @LIB CXCPU
060721   STBACK: X:=B
060722   L1:    IF X.ISTAT><0 THEN                        % PROCESS MUST WAIT FOR I/O ON "TERMINAL"
060724             AD:=DFPTSLICE
060725             IF T:=X.RTRES>>=A AND T<<D THEN
060732                T-A=:D; A:=0; T:=5RTSIZE; *RDIV ST
060737                TSLSTATUS(A) BONE 5BRKF=:TSLSTATUS(X)
060743             FI;
060743          FI; EXIT
060744   %=============================================================================
060744   %            X S 5 E S C F
060744   %
060744   % CALLED FROM ESCAPE TO SET HIGH PRIORITY WHEN ESCAPE IS TYPED
060744   % WHILE PROCESS IS IN COMMAND MODE AND ESCAPE IS OFF
060744   %
060744   % ENTRY:     T=BIT TO SET IN FLAGB
060744   %            B=DATAFIELD
060744   %            A=FLAGB
060744   %
060744   % EXIT:      RETURNS TO ROUTINE CALLING ESCAPE
060744   %
060744   XS5ESCF: A\/T=:FLAGB
060746   @LIB CXCPU
060746   @LIB CXCPU-,
060746          X:=B
060747   @ELIB
060747          X:=X.RTRES; GO S5ESCF
060751   
060751   %=============================================================================
060751   %            S 5 E S C F
060751   %
060751   % SUBROUTINE TO SET ESCAPE PRIORITY ON TIMESLICED PROCESSES
060751   %
060751   % ENTRY:     X=RT-PROGRAM
060751   
060751   S5ESCF: AD:=DFPTSLICE
060752          IF X>>=A AND X<<D THEN
060756             X-A=:D; A:=0; T:=5RTSIZE; *RDIV ST
060763             TSLSTATUS(A) BONE 5ESCF=:TSLSTATUS(X)
060767          FI; EXIT
060770   *)FILL
060773   
060773   %==============================================================================
060773   %            A N T I J A M M E R   -   A N T I 2 J A M M E R
060773   %
060773   % SUBROUTINES TO SET HIGH PRIORITY ON THE OWNER OF A SYSTEM RESOURCE
060773   % WHICH IS WAITED FOR BY OTHER PROCESSES.
060773   %
060773   % ENTRY WHEN ANTIJAMMER:     B=DATAFIELD
060773   % ENTRY WHEN ANTI2JAMMER:    X=RT-PROGRAM
060773   %
060773   % EXIT:                      NONE
060773   %
060773   % REGISTERS DESTROYED:       T,A,D,L
060773   %
060773   
060773   INTEGER CPROG                % CURRENT PROGRAM ADDRESS
060774   INTEGER B2RG
060775   INTEGER 2XRG
060776   INTEGER C2INDX=?
060776   INTEGER POINTER 2LRG
060777   INTEGER CTYP=B2RG
060777   
060777   ANTIJAMMER: 
060777          IF TYPRING NBIT RING2 THEN EXIT FI        % RETURN WHEN NOT SYSTEM RESOURCE (ON RING 1)
061003          X=:2XRG:=RTRES; GO FELLS
061006   ANTI2JAMMER: X=:2XRG
061007   FELLS: X=:CPROG; A:=L=:"2LRG"
061012          IF X.STATUS/\377<TSLSYSPRI THEN           % SYSTEM PRIORITY ?
061017             CALL GTSLPINDEX; GO FIN; X=:C2INDX     % FIND TIMESLICE-PROCESS INDEX
061022             IF TSLSTATUS(X) BIT 5NOSLICE THEN
061025                T:=CPROG.STATUS; X:=77; T/\X; A/\177700\/T   % SAVE ORIGINAL PRIORITY
061033             FI; A BONE 5SPRF=:TSLSTATUS(C2INDX)       % MARK PROCESS IN SYSPRI
061036             CPROG.STATUS/\177400+TSLSYSPRI=:X.STATUS  % SET SYSTEM PRIORITY
061043             CALL FRWQU   
061044             IF A><0 THEN A:=:B=:B2RG; CALL TOWQU; B2RG=:B FI % REORGANIZE QUEUE ACCORDING TO PRIORITY
061052   FIN:   FI; X:=2XRG; GO 2LRG; *)FILL
061064   
061064   %==============================================================================
061064   %            R E S A J
061064   %
061064   % SUBROUTINE CALLED FROM BRELEASE TO INSERT THE PREVIOUS PRIORITY
061064   % ON THE PROCESS WHICH HAD A SYSTEM RESOURCE THET WAS WAITED FOR.
061064   % (RESAJ MUST BE CALLED BEFORE THE RESOURCE IS RELEASED)
061064   %
061064   % CALLED FROM MONITOR LEVEL OR WITH MONITOR LEVEL DISABLED OR IN IOF
061064   %
061064   % ENTRY:     B=DATAFIELD
061064   % EXIT:      NONE
061064   %
061064   % REGISTERS DESTROYED:       T,A,D,L
061064   %
061064   
061064   INTEGER BREG                 % DATAFIELD ADDRESS
061065   INTEGER SNUMPR               % NUMBER OF PROCESSES WAITING FOR THIS DATAFIELD
061066   INTEGER C2INDX               % CURRENT TIMESLICE-PROCESS INDEX
061067   INTEGER POINTER L2RG         % RETURN ADDRESS
061070   INTEGER XREG                 % SAVED X-REG
061071   INTEGER POINTER L3RG
061072   
061072   RESAJ:
061072          IF TYPRING BIT RING2 THEN                 % SYSTEM RESOURCE (ON RING 2)
061075             X=:XREG:=L=:"L3RG"
061100             X:=RTRES; CALL GTSLPINDEX; GO RETU; X=:C2INDX      % FIND PROCESS INDEX
061104             IF TSLSTATUS(X) BIT 5SPRF THEN         % PROCESS HAS ANTIJAM PRIORITY
061107                T:=0; X:=B+5BWLINK-5WLINK
061113                DO WHILE X:=X.WLINK><B; T+1; OD     % FIND NUMBER OF PROCESSES WAITING
061120                T=:SNUMPR
061121                D:=0; X:=RTRES+5BRESLINK; T:=RTRES
061125                DO WHILE X:=X.RESLINK><T            % FIND NUMBER OF SYSTEM RESOURCES RESERVED
061130                   IF X.TYPRING BIT RING2 AND X.BWLINK><X THEN D+1 FI
061137                OD
061140                A:=RTRES:=:B=:BREG
061143                IF 1>=D THEN                        % ONLY 1 SYS.RESOURCE, RESET PRIORITY
061146                   TSLSTATUS(C2INDX) BZERO 5SPRF=:TSLSTATUS(X)
061152                   IF A NBIT 5NOSLICE THEN
061154                      X:=37; X/\A; T:=TSLPRITAB(X)  % FIND OLD PRIORITY
061157                   ELSE
061160                      T:=77; T/\A
061162                   FI; STATUS/\177400\/T=:STATUS    % RESET PRIORITY
061166                   X:=B; CALL FRWQU
061170                   IF A><0 THEN B:=A; CALL TOWQU FI % UPDATE QUEUE ACCORDING TO PRIORITY
061173                FI
061173                IF SNUMPR>1 THEN                       % MORE THAN 1 PROCESS WAITING?
061177                   X:=BREG.BWLINK; CALL ANTI2JAMMER    % SET ATIJAM PRIOR ON RESERVING PROCESS
061202                FI; BREG=:B
061204   RETU:     FI; X:=XREG; GO L3RG
061206          FI
061206          EXIT
061207   *)FILL
061216   
061216   %==============================================================================
061216   %            G T S L P I N D E X
061216   %
061216   % GET TIMELSICE-PROCESS INDEX
061216   %
061216   % ENTRY:          X=RTDESCRIPTION
061216   %
061216   % RETURN:         NOT TIMESLICED PROCESS
061216   % SKIP RETURN:    X=TIMESLICE PROCESS INDEX
061216   %
061216   GTSLPINDEX: AD:=DFPTSLICE
061217          IF X>>=A AND X<<D THEN
061223             X-A=:D; A:=0; T:=5RTSIZE; *RDIV ST
061230             X:=A; EXITA
061232          FI; EXIT
061233   
061233   RBUS
061234   
061234   
061234   %==============================================================================
061234   %
061234   %                M I S C .  R O U T I N E S
061234   %
061234   % 15.0       G B R K D
061234   
061234   %MONITOR CALL TO GET BREAKPOINT FOR MACD
061234   % APPL. LEVEL
061234   INTEGER MDSEG:=5ERRSEG\5MACDSEG
061235   INTEGER ARRAY REFBP(10)
061245   SUBR GBRKD
061245   GBRKD: CALL GET0
061246          T:= RTREF.ACTSEG; MDSEG=:X.ACTSEG; "STUPR"; *IRW MLEVB DP
061254          MLEV; *MST PID; MST PIE
061257          CALL XGBRKD             % ON SYSTEM SEGMENT
061260   RBUS
061265   
061265   %==============================================================================
061265   % 15.1       C H L I M
061265   
061265   %SUBROUTINE TO CHECK LIMITS FOR MONITOR CALLS
061265   % A=ADDRESS, T=NO. OF WORDS, D=CALLING RT-PROGRAM
061265   % SKIP RETURN IF OK
061265   
061265   SUBR CHLIM
061265   INTEGER TREG,AREG,DREG,XREG,XFPAGE,XLPAGE
061273   INTEGER POINTER LREG
061274   REAL TADREG=TREG
061274          % LOCAL SUBROUTINE TO CHECK IF AREA IS WITHIN SEGMENT(IN A)
061274          % RETURN WITH A<0 IF NOT.
061274          XHLIM: X=:D; IF A=0 GO ERRL
061276                A*5SEGSIZW+SEGSTART; A.LOGADR/\77;  IF >XFPAGE GO ERRL
061306                T:=X.LOGADR SHZ -10-1+A; IF XLPAGE>T GO ERRL
061315                "0"
061316   OUT:         D=:X; EXIT
061320   ERRL:        -1; GO OUT
061322   
061322   CHLIM: *IOF
061323          TAD=:TADREG; X=:XREG:=L=:"LREG"
061327          IF X:=BACKGROUND=0 THEN                   % NO TEST FOR BACKGROUND
061332             T+A-1 SHZ-12=:XLPAGE; A SHZ-12=:XFPAGE
061340             IF D.STATUS BIT 11 GO OK               % RING 2 OR 3
061344             IF BIT 10 THEN                         %RING 1; TEST CORE COMMON
061346                IF XFPAGE>=CCFPAGE AND XLPAGE<=CCLPAGE GO OK
061356             FI; X.ACTSEG SHZ -10; CALL XHLIM; IF >=0 GO OK
061362             X.ACTSEG/\377; CALL XHLIM; IF>=0 GO OK
061366             X.RSEGM; CALL XHLIM; IF >=0 GO OK
061371             GO ERR
061372          FI
061372   OK:    MIN "LREG"
061373   ERR:   X:=XREG; "LREG"=:L
061376   SKIPRET: TADREG; *ION; EXIT
061401   RBUS
061410   
061410   %==============================================================================
061410   % 15.2       M M E X Y
061410   
061410   %SUBROUTINE TO CHANGE SEGMENTS WITHOUT USING MONITOR CALL
061410   %T=SEGMENT NUMBERS; RETURN WITH T=OLD SEGMENT NUMBERS
061410   SUBR MMEXY
061410   INTEGER XREG; INTEGER TREG; DOUBLE ADREG; REAL TADREG=TREG
061414   MMEXY: *IOF
061415          TAD=:TADREG; X=:XREG:=RTREF
061420          IF T SHZ -10=A:=377 THEN T:=X.ACTSEG SHZ -10 FI
061426          T SH 10=:D; IF A/\TREG=377 THEN A/\X.ACTSEG FI
061435          T:=X.ACTSEG; A\/D=:X.ACTSEG; "STUPR"; *IRW MLEVB DP
061442          MLEV; *MST PID
061444          X:=XREG; ADREG; *ION; EXIT
061450   RBUS
061453   
061453   %==============================================================================
061453   % 15.3       E N T R C O R E
061453   
061453   % SUBROUTINE TO ENTER RT AS USER; CALLED FROM ENTRT
061453   % A=PASSWORD
061453   SUBR ENTRCORE
061453   INTEGER POINTER OFLD:=OFLCK  % OPEN FILE TABLE LOCK FOR RT
061454   INTEGER RTUS:='RT',XREG,RTENFL:=0
061460   INTEGER POINTER LREG
061461   ENTRCORE: X=:XREG:=L=:"LREG"; IF X:=RTENFL><0 THEN MIN "LREG";GO LREG FI
061470          T:="5ERRSEG\377"; CALL MMEXY
061472          OFLD; CALL XLOCK
061474          X:="RTUS"; CALL FILSYS(ENSYS); GO NSKIP; MIN "LREG";MIN RTENFL
061502   NSKIP: OFLD; CALL XUNLOCK
061504          CALL MMEXY; X:=XREG; GO LREG
061507   RBUS
061515   
061515   %==============================================================================
061515   % 15.4       B L E V S E T
061515   
061515   % SUBROUTINE TO SAVE INBT/OUTBT LEVEL REGISTERS IN DATAFIELD
061515   % CALLED FROM PAGEFAULT - MONITOR LEVEL
061515   SUBR BLEVSET
061515   INTEGER POINTER LREG; INTEGER AREG
061517   BLEVSET: A:=L=:"LREG"; CALL GETDATAFIELD
061522   @LIB CXCPU
061522          X+"5BREGBLOCK"; *SRB BLEVB
061524          X-"5BREGBLOCK"; *IRR ALEVB DP
061526          A=:X.DBPREG; X=:D; T:=RTREF.ACTPRI
061532          "100002+ALEVB"=:X.ACTPRI/\3773; *TRR PCR
061536          T=:D.DBACTPRI; "BLEVREACTIVATE"; *IRW ALEVB DP; POF
061543          GO LREG
061544   %SUBROUTINE TO REACTIVATE INBT/OUTBT WHEN PROG. IS RESTARTED
061544   % RT LEVEL
061544          *IOF
061545   BLEVREACTIVATE: *IOF
061546          A=:AREG; "MBL"; *IRW MLEVB DP
061551          MLEV; *MST PID
061553          AREG; *ION
061555   % MONITOR LEVEL:
061555   MBL:   CALL GETDATAFIELD
061556   @LIB CXCPU
061556          X+"5BREGBLOCK"; *LRB BLEVB
061560          X-5BREGBLOCK; X.DBPREG; *IRW ALEVB DP
061563          X.DBACTPRI=:RTREF.ACTPRI/\3773; *TRR PCR
061570          BLEV; *MST PID
061572          GO MONEN
061573   RBUS
061602   
061602   %==============================================================================
061602   % 15.5       G E T D A T A F I E L D
061602   
061602   % SUBROUTINE TO GET ADDRESS TO TERMINAL DATAFIELD
061602   % RETURNED IN X-REG.
061602   SUBR GETDATAFIELD
061602   
061602   GETDATAFIELD:
061602          RTREF-"BAK01"
061604          IF A<0 THEN
061605             IF LGCOLDSTART><0 THEN L=:X; CALL LOGPH; X=:L:=A; EXIT FI
061614             A:=0
061615          FI; A=:D:=0; T:=5RTSIZE; *RDIV ST
061621          IF D><0 THEN CALL ERRFATAL FI
061624   *"-8BACS
"061624          X:=BACKTAB(A); EXIT
061627   *"8BACS
"061627   RBUS
061635   
