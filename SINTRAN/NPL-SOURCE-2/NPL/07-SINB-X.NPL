062327   *"-8RFAC
"062327   
062327   %=============================================================================
062327   %      R T C G P L O C
062327   %
062327   % READ/WRITE ONE LOCATION IN RT-COMMON
062327   % (THE REST OF THIS ROUTINE IS PLACED IN PAGING-OFF AREA)
062327   %
062327   % ENTRY:     T=0: READ; T=1: WRITE
062327   %            A=VALUE WHEN WRITE
062327   %            X=LOGICAL ADDRESS IN RT-COMMON
062327   %
062327   % EXIT:      ERROR, RT-COMMON ADDRESS NOT FOUND
062327   %
062327   % EXIT+1:    A=VALUE WHEN READ
062327   %
062327   SUBR RTCGPLOC
062327   
062327   INTEGER LRG
062330   RTCGPLOC: *PIOF
062331          A:=:L=:LRG:=L
062334          CALL PRTCGPLOC; GO ERR; MIN LRG
062337   ERR:   A=:L:=LRG; A:=:L; *PION; EXIT
