060361   %==============================================================================
060361   % 16.12      E D I N B T
060361   
060361   % INBT FROM LOG.NO. 0 - EDITED TERMINAL INPUT
060361   SUBR EDINBT
060361   EDINBT: X:="BFIELD":=:B=:EDSVB:=L=:"EDSVL"; "COMSTRING"=:CSTRING
060370          IF RTREF.ACTSEG><OPSEG THEN
060375             IF CPNT=0 OR NCOMPL><0 THEN
060401                IF X.RSEGM=5RTSG OR A=FRSG1 OR A=FRSG2 THEN 0=:X.RSEGM ELSE A:=0 FI
060416                A=:EDIRSEGM; T:=OPSEG; CALL MMEXY; T=:EDOSG  
060422                A:=NCOMPL; CALL MONEDIT; GO NORM; GO ERETU
060426   NORM:        0=:CPNT
060427                IF EDIRSEGM><0 THEN A=:RTREF.RSEGM FI; T:=EDOSG; CALL MMEXY
060435             FI
060435          ELSE
060436             IF CPNT=0 THEN CALL EDIT; 0=:CPNT FI  
060442          FI
060442          CALL XCREAD; IF =15 THEN 0=:CPNT FI; CALL SETPARITY
060450          MIN "EDSVL"
060451   RETU:  X:="EDSVL"=:L:=EDSVB=:B; A=:ZAREG; TAD:=ZTADREG; X:=ZXREG; EXIT
060461   
060461   % ERROR RETURN FROM MODEDIT ERROR CODE IN D-REG.
060461   % IF NOWAIT RETURN, CALL ADRESS OF UNSUCCSESSFUL ETCI IN A-REG.
060461   % ALL OTHER ERRORS 0 IN A-REG
060461   ERETU: A=:NCOMPL
060462          IF EDIRSEGM><0 THEN A=:RTREF.RSEGM FI
060466          T:=EDOSG; CALL MMEXY; A:=D; GO RETU
060472   
060472   % GET ONE CHAR. FROM COMAND BUFFER
060472   XCREAD: X=:D:=CPNT; MIN CPNT; T:=CSTRING; *LBYT
060477          D=:X; EXIT
060501   RBUS
