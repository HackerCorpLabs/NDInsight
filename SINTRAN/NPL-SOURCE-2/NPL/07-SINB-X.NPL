064224   * *+140/
064364   *"
"064364   
064364   %============================================================================
064364   %      S P T 3 P I T   -   S P T 0 P I T   -   S 3 N O A L P I T
064364   %
064364   % SET PAGE INDEX TABLE 0 OR 3 FOR CALLING PROGRAM
064364   %
064364   % SPT3PIT:   NORM PIT=3; ALT PIT=0
064364   % SPT0PIT:   NORM PIT=ALT PIT=0
064364   % S3NOALPIT: NORM PIT=ALT PIT=3
064364   %
064364   SUBR SPT3PIT,SPT0PIT,S3NOALPIT
064364   INTEGER SVX,SVL,CPITS
064367   S3NOALPIT: A:=3600; GO FELLS
064371   SPT0PIT: A:=0; GO FELLS
064373   SPT3PIT: A:=3000
064374   FELLS:   *PIOF
064375            A=:CPITS
064376            A:=L=:SVL; X=:SVX:=RTREF
064402            A:=X.ACTPRI/\174177\/CPITS
064405            A=:X.ACTPRI/\3773; *TRR PCR; BSET ONE
064411            X:=SVX; A:=SVL; *PION
064414            A=:P
064415   RBUS
064422   
