062345   *"8LAMU
"062345   %=============================================================================%
062345   %
062345   %      M L A M U
062345   %      LAMU MONITOR CALL.   DEMFIELD IS RESERVED ON ENTRY
062345   %      THE FUNCTION ARE:
062345   %         FUNC = 1     CREATE LAMU
062345   %         FUNC = 2     DELETE LAMU
062345   %         FUNC = 3     CONNECT LAMU
062345   %         FUNC = 4     DISCONNECT LAMU
062345   %         FUNC = 5     MOVE PAGES FROM LAMU AREA TO NOTHING.
062345   %                      USED FOR AREAS IN SHARED MEMORY THAT ARE USED
062345   %                      FOR SWAPPING BY OTHER CPUS
062345   %         FUNC = 6     MOVE PAGES FROM LAMU AREA TO SWAPPING
062345   %         FUNC = 7     CHANGE LAMU PROTECTION
062345   %         FUNC =10     GET LAMU INFORMATION
062345   SUBR MLAMU
062345   %            LAMU DESCRIPTOR ELEMENT
062345   % DISP 0
062345   %      INTEGER LAMPP         % FIRST PHYSICAL PAGE IN LAMU
062345   %      INTEGER LAMNP         % NUMBER OF PAGES IN LAMU
062345   %      INTEGER LAMPR         % LAMU PROTECTION
062345   % PSID
062345   
062345   %            DEMFIELD DATA
062345   DISP 5REG+11
062345          INTEGER LFUNC, LAMID, LAMSZ, LAMLOG   % PARAMETERS
062345          INTEGER LAMRT=LAMSZ,LAMPT=LAMSZ, LAMPH=LAMLOG
062345          INTEGER PFLFP=LAMID   % PAGES FROM LAMU FIRST PAGE
062345          INTEGER LADPH         % ADDRESS IN USER SEG OF PH. PAGE NO
062345          INTEGER LADID         % ADDRESS IN USER SEG OF LAMID
062345          INTEGER LAIAR         % ADDRESS IN USER SEG OF ARRAY TO RETURN LAMU-INFORMATION
062345          INTEGER LACTMAX       % ADDRESS OF LAST ELEMENT IN ACTIV LAMU TABLE
062345          INTEGER LATFLAG       % =0 TO ASSURE THAT GAPIT WILL WORK
062345          INTEGER CACLE         % ADDRESS OF CURRENT ACTIV LAMU TABLE ELEMENT
062345          INTEGER LC            % LOOP CONTROL
062345          INTEGER LC1           % LOOP CONTROL
062345          INTEGER CLLP          % CURRENT LAST LOGICAL PAGE
062345          INTEGER LEFREE        % INDEX OF FREE ELEMENT IN CURRENT ACT LAMU T.E.
062345                                % LAMSZ DUMMY IN CONLA
062345          INTEGER LALPP         % LAST PHYS PAGE IN LAMU AREA
062345          INTEGER LA1PH=LACTMAX % 1.PHYS PAGE IN LAMU
062345          INTEGER LALPH=CACLE   % LAST PHYS PAGE IN LAMU 
062345          DOUBLE  LNPRO=LC      % NO OF PAGES AND PROTECTION
062345   
062345   PSID
062345   SYMBOL MLAMF=10              % HIHEST LAMU FUNCTION
062345   
062345   %      LAMU ERROR MESSAGES
062345   SYMBOL ILLRA=ER170           % ILLEGAL RANGE ON LAMID
062345   SYMBOL LINUSE=ER171          % LAMU IN USE
062345   SYMBOL LAMTF=ER172           % LAMU TABLE FULL
062345   SYMBOL LILRT=ER173           % ILLEGAL LAMRT
062345   SYMBOL MLRT=ER174            % MAX NO OF LAMUS PR RT PROG REACHED
062345   SYMBOL LNCN=ER175            % LAMU NOT CONNECTED
062345   SYMBOL ILLPH=ER176           % NO LAMU AREA BIG ENOUGH
062345   SYMBOL LNDEF=ER177           % LAMU NOT DEFINED
062345   SYMBOL LILLO=ER178           % ILLEGAL LOGICAL PAGE NUMBER
062345   SYMBOL LOGOV=ER179           % LOGICAL LAMU OVERLAP
062345   SYMBOL XNFLAD=174            % NO FREE LAMU AREA DESCRICTOR
062345   
062345   INTEGER POINTER PPASS:=PASSTYPE
062346   
062346   MLAMU: S3; *BSET ZRO; STA ,X LADPH; BSET ONE
062352          S2; *BSET ZRO; STA ,X LAIAR; BSET ONE
062356          S1; *BSET ZRO; STA ,X LADID; BSET ONE
062362          CALL GET4; IF LFUNC >> MLAMF OR A = 0 THEN 174; GO FAR ERET FI
062372   
062372          IF LFUNC ><3 AND >< 4 AND >< 10 THEN    
062404            IF BACKGROUND >< 0 THEN                  % SYSTEM OR RT PROG RING 2
062406               IF  PPASS >< 2 THEN 25; GO FAR ERET FI
062414            ELSE
062415               IF OLDPAG NBIT 1 THEN 25; GO FAR ERET FI
062422            FI
062422          FI
062422   @ICR
062422          LFUNC GOSW FAR ERET, CRELA, FAR DELLA, FAR CONLA,
062430          FAR DISLA, FAR LPTNO, FAR LPTSW, FAR PROLA, FAR INFLA
062434   @CR
062434   %                       CREATE LAMU
062434   CRELA: IF LAMID = 0 THEN
062434                1=:LAMID
062434                FOR LAMID TO GNLAMU-1 DO          % SELECT 1. FREE LAMU ID
062434                   CALL GLAPP
062434                   IF A = 0 GO LAFND
062434                OD
062434                LAMTF; GO FAR ERET
062456          FI
062456   LAFND: CALL CHLID; CALL GLAPP; IF A >< 0 THEN LINUSE; GO FAR ERET FI
062463          CALL CHAREA                             % IS LAMPH INSIDE LAMU AREAS ?
062464   AROK:  CALL GLAPP; LAMPH; *STATX LMPP          % 1. PHYS.PAGE
062467          LAMSZ;  *STATX LMNP                     % NO OF PAGES
062471          140000; *STATX LMPR                     % DEFAULT PROTECTION R W  RING 0
062473          GO FAR MLRET
062474   *)FILL
062516   
062516   %                          DELETE LAMU
062516   DELLA: CALL CHLID
062517          A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
062525          A*GNLPRT-1*ALMSZ+LAMACT=:LACTMAX
062532          FOR X:=LAMACT STEP ALMSZ TO LACTMAX DO     % SEARCH TO FIND IF ANY PROGRAM HAS LAMID CONNECTED
062536                T:=LAMBANK; *LDATX LMCN
062540                IF A = LAMID THEN LINUSE; GO FAR ERET FI
062545          OD
062547          CALL GLAPP; IF A = 0 THEN LNDEF; GO FAR ERET FI
062553          A:=0; *STATX LMPP               % OK.  DELETE THE LAMU
062555          GO FAR MLRET
062556   *)FILL
062572   
062572   %                          CONNECT TO LAMU
062572   CONLA: CALL CHLID; CALL GLAPP; IF A = 0 THEN LNDEF; GO FAR ERET FI
062577          *LDATX LMNP
062600          IF A+LAMLOG-1=:CLLP >>= 300 OR LAMLOG << 100 THEN LILLO; GO FAR ERET FI
062614          CALL SACLE; 0=:LC; -1=:LEFREE
062620          FOR LC TO GNLPRT-1 DO
062625                CALL GLCAC; *LDDTX LMCN   % A=CONNECTED LAMU, D=LOGICAL PAGE NO
062627                IF A = LAMID GO ECLA                % LAMU IS ALREADY CONNECTED
062632                IF A = 0 THEN
062633                   IF LEFREE = -1 THEN LC=:LEFREE FI
062641                ELSE
062642                   CALL GAPP; *LDATX LMNP    % CHECK FOR LOGICAL OVERLAP
062644                   T:=D+A-1; IF LAMLOG <<= T AND CLLP >>= D THEN LOGOV; GO FAR ERET FI
062657                FI
062657          OD
062663          IF LEFREE >< -1 THEN
062667                CALL GAAC; LAMID; *STATX            % OK.  LAMU IS CONNECTED
062672                LAMLOG; *STATX LMLP
062674          ELSE
062675                MLRT; GO FAR ERET
062677          FI
062677   ECLA:  GO FAR MLRET
062700   *)FILL
062715      
062715   %                         DISCONNECT FROM LAMU
062715   DISLA: CALL SACLE; 0=:LC
062717          IF LAMRT = 0 OR A = SEGPROG THEN; *PIOF
062725                CALL CLAMU; *PION
062727          FI
062727          IF LAMID = -1 THEN
062733                FOR LC TO GNLPRT-1 DO
062740                   CALL GLCAC; A:=0; *STATX
062743                OD
062747          ELSE
062750                CALL CHLID
062751                FOR LC TO GNLPRT-1 DO
062756                   CALL GLCAC 
062757                   IF A-LAMID = 0 THEN
062761                      *STATX
062762                      GO DISOK
062763                   FI
062763                OD
062767                LNCN; GO FAR ERET
062771          FI
062771   DISOK: GO FAR MLRET
062772   *)FILL
063003   
063003   %      PAGES TO NOTHING & PAGES TO SWAPPING
063003   LPTSW:
063003   LPTNO: IF PFLFP=:LAMPH = 0 THEN 174; GO FAR ERET FI
063010          A+LAMSZ-1=:CLLP; CALL CHAREA; L:=X
063015          IF PFLFP >< T THEN
063020                IF A+LAMSZ-1 >< D THEN
063024                   0=:LC                % FIND A FREE LAMU AREA DESCRIPTOR
063025                   FOR LC TO "NINSZ-1" DO A SH 1+"LAMAR"=:X; T:=0; *LDATX
063036                       IF A = 0 GO NEWAR
063037                   OD; XNFLAD; GO FAR ERET % NO FREE AREA DESCRIPTOR
063045   NEWAR:          LC SH 1+"LAMAR"=:X; A:=PFLFP+LAMSZ; T:=0; *STDTX
063055                FI
063055                PFLFP-1; X:=L; T:=0; *STATX 10
063062          ELSE
063063                IF A+LAMSZ-1 >< D THEN
063067                   A+1; T:=0; *STATX
063072                ELSE
063073                   A:=0=:D=:T; *STDTX
063077                FI
063077          FI
063077          IF LFUNC = 6 THEN
063103                PFLFP=:LC
063105                FOR LC TO CLLP DO
063111                   A SH 2+CORMSTART=:D; SEGSTART+5SEGSIZE=:X; T:=CORMBANK
063120                   MLEV; *MCL PIE
063122                   X.BPAGLINK; X:=:D; *STATX DPAGL
063125                   A:=1; *STATX DPGPR
063127                   A:=X=:D.BPAGLINK
063132                   IF X.SEGLINK = 0 THEN
063134                      A:="BSEGLINK"
063135                      DO WHILE A.SEGLINK >< -1 OD
063143                      A:=D=:X.SEGLINK; -1=:D.SEGLINK
063150                   FI; MLEV; *MST PIE
063152                OD 
063156          FI
063156          GO MLRET
063157   *)FILL
063166   %                      CHANGE LAMU PROTECTION
063166   PROLA: CALL CHLID; CALL GLAPP; IF A=0 THEN LNDEF;GO FAR ERET FI 
063173          LAMPT /\ 163000; * STATX  LMPR
063176          GO MLRET
063177   *)FILL
063204   %                      LAMU INFORMATION
063204   INFLA: CALL CHLID; CALL GLAPP; IF A=0 THEN LNDEF;GO FAR ERET FI 
063211          A =:LA1PH; *LDDTX LMNP
063213          AD=:LNPRO; GO MLRET
063215   *)FILL
063221   
063221   MLRET: ZPREG+1=:ZPREG; A:=0
063225   ERET:  A=:ZAREG; 0=:LATFLAG; X:=B; CALL GAPIT; CALL DALTON; *BSET ZRO
063233          IF LFUNC = 1 THEN
063237                A:=LAMID; X:=LADID; *BSET ONE; STA ,X 0; BSET ZRO
063244                A:=LAMPH; X:=LADPH; *BSET ONE; STA ,X 0; BSET ZRO
063251          ELSE IF A= 10 THEN
063255                A:=LA1PH; X:=LAIAR; *BSET ONE; STA ,X 0; BSET ZRO
063262                AD:=LNPRO;          *BSET ONE; STD ,X 1; BSET ZRO
063266          FI;FI
063266          GO RETSTUPER
063267   *)FILL
063272   
063272             
063272   %      SERVICE FUNCTIONS
063272   
063272   
063272   %      CHECK FOR LEGAL LAMU AREA
063272   %      ON EXIT WITH LAMPH >< 0    T = FIRST, AND D = LAST PAGE OF OLD AREA
063272   CHAREA: 0=:LC
063273          FOR LC TO "NINSZ-1" DO                         % LAMID OK. THEN CHECK IF PHYSICAL AREA IS OK
063277                A SH 1 + "LAMAR"=:X; T:=0; *LDDTX
063304                IF A=:T >< 0 THEN                        % AREA IN USE
063306                   IF LAMPH = 0 THEN                     % SELECT PHYS. PAGES NOT IN USE
063310                      A:=D=:LALPP                        % LAST PHYS. PAGE IN LAMU AREA
063312   L1:                IF LAMSZ+T-1=:LALPH <<= X:=LALPP THEN % LAMU AREA BIG ENOUGH
063321                         T=:LA1PH; 1=:LC1;
063324                         FOR LC1 TO "GNLAMU-1" DO        % CHECK THAT NO LAUMU OCCUPIE SELECTED AREA
063330                            L=:D;CALL GAPP;D=:L
063333                            IF A >< 0 THEN
063334                               *LDDTX LMPP
063335                               IF D+A-1 >>=LA1PH AND A <<= LALPH THEN T+1;GO L1 FI
063347                            FI
063347                         OD
063353                         LA1PH=:LAMPH; EXIT               % OK, FREE AREA FOUND
063356                      FI
063356                   ELSE
063357                      IF A >>= T AND A <<= D THEN
063363                         IF A+LAMSZ-1 <<= D THEN EXIT ELSE GO ARNOK FI
063372                      FI
063372                   FI
063372                FI
063372          OD
063376   ARNOK: ILLPH; GO FAR ERET
063400   *)FILL
063405   
063405   GLCAC:       % GET LC ELEMENT OF CURRENT ACT LAMU TABLE RECORD.
063405          A:=LC
063406   GAAC:  A*ALMSZ+CACLE=:X; T:=LAMBANK; * LDATX
063413          EXIT
063414   GLAPP:       % GET PHYSICAL PAGE OF LAMID. T & X HOLDS THE ADDRESS
063414          A:=LAMID
063415   GAPP:  A*LDTSZ+LAMDT=:X; T:=LAMBANK; *LDATX LMPP
063422          EXIT
063423   CHLID:       % CHECK IF LAMID IS WITHIN LEGAL RANGE
063423          IF LAMID >>= GNLAMU OR A = 0 THEN ILLRA; GO FAR ERET FI; EXIT
063433   SACLE:       % SET CURRENT ACTIVE LAMU TABLE ELEMENT CACLE
063433          IF LAMRT = 0 THEN
063435                A:=RTREF
063436          ELSE
063437                IF A >>= SEGSTART OR A <<= RTSTART THEN
063445   L3:              LILRT; GO FAR ERET
063447                FI
063447          FI
063447          A-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
063454          A*GNLPRT*ALMSZ+LAMACT=:CACLE; IF D >< 0 GO L3; EXIT
063463   
063463   
063463   RBUS
063500   *"
"063500   
063500   %===========================================================================
063500   %            C H L A M
063500   %      CHECK IF A LOGICAL PAGE INTERVAL IS WITHIN A LAMU
063500   %      RETURNS WITH INTERRUPT ON
063500   %      ENTRY:    T = FIRST LOGICAL PAGE
063500   %                D = LAST LOGICAL PAGE
063500   %                A = RT DESCR
063500   %      EXIT:     NOT WITHIN A CONNECTED LAMU
063500   %      EXIT+1:   OK.   A = PHYSICAL START PAGE OF BUFFER WITHIN LAMU
063500   
063500   SUBR CHLAM
063500   
063500   *"8LAMU
"063500   INTEGER FPAGE, LPAGE         % FIRST & LAST LOGICAL INTERVAL
063502   INTEGER CACLE                % CURRENT ACTIVE LAMU ELEMENT
063503   INTEGER SAVX 
063504   INTEGER LC                   % LOOP COUNTER
063505   *"
"063505   
063505   CHLAM:
063505   *"8LAMU
"063505          *IOF
063506          X=:SAVX; T=:FPAGE:=D=:LPAGE:=5RTSIZE; A-RTSTART=:D:=0; *RDIV ST
063517          A*GNLPRT*ALMSZ+LAMACT=:CACLE; 0=:LC
063524          FOR LC TO GNLPRT-1 DO
063531                A*ALMSZ+CACLE=:X; T:=LAMBANK; *LDATX
063536                IF A >< 0 THEN
063537                   A=:D; *LDATX LMLP
063541                   A:=:D; A*LDTSZ+LAMDT=:X; *LDATX LMNP
063546                   A+D-1
063550                   IF T:=LPAGE <<= A AND FPAGE >>= D THEN
063556                      A-D=:D; T:=LAMBANK; *LDATX LMPP
063562                      A+D; L+1; GO CHLRE
063565                   FI
063565                FI
063565          OD
063571   CHLRE: X:=LPAGE=:D:=SAVX; *ION
063575   *"
"063575          EXIT
063576   RBUS
063605   
063605   %==============================================================================
063605   %            C O L A M       C L L A M
063605   %      COPY AND CLEAR LAMU
063605   %      ENTRY COLAM:    A = SOURCE RT PROG
063605   %                      X = DESTINATION RT PROG
063605   %      CLLAM:          A = RT PROGRAM
063605   
063605   SUBR COLAM, CLLAM
063605   INTEGER LREG
063606   COLAM:
063606   *"8LAMU
"063606          A-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
063613          A*GNLPRT*ALMSZ+LAMACT; A:=:X; A-RTSTART=:D:=0; *RDIV ST
063623          A*GNLPRT*ALMSZ+LAMACT=:T; A:=GNLPRT:=:L=:LREG; L+L
063633   @LIB CXCPU
063633   @LIB CXCPU-,
063633          T=:D:=LAMBANK
063635          DO WHILE L><0
063637             *LDATX
063640             X+1:=:D; *STATX
063643             X+1:=:D; L-1
063646          OD
063647   @ELIB
063647          LREG=:L
063651   *"
"063651          EXIT
063652   CLLAM: 
063652   *"8LAMU
"063652          A-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
063657          A*GNLPRT*ALMSZ+LAMACT=:X; GNLPRT*ALMSZ+X-1=:D:=0; T:=LAMBANK
063672          FOR X TO D DO
063674                *STATX
063675          OD
063677   *"
"063677          EXIT
063700   RBUS
063705   SUBR LAMDISCONNECT
063705   *"8LAMU
"063705   %=================================================================
063705   % DISCONNECT ALL LAMUS FROM TH CALLING PROGRAM
063705   % CALLED FROM ESCAPE HANDLING ,MON 0  AND BATCH I/O
063705   %
063705   INTEGER ARRAY LPAA:=("4","-1","0","0")
063711   *"
"063711   LAMDISCONNECT:
063711   *"8LAMU
"063711          A:="LPAA"; *MON 2LAMU; MON 2ERMS
063714   *"
"063714   EXIT
063715   RBUS
063721   
063721   % MAKE GLOBAL ENTRIES
063721   
063721   SUBR ELO3F,EUSE3,DUSE3,ELON3,ELOF3,DLOF3,T207RET,IBR3S,T206RET
063721   RBUS
063721   
063721   
063721   *"8ESCX
"063721   %==============================================================================
063721   %      E L O N   E L O F F   E L O F U   D L O F U   E U S E L   D U S E L
063721           
063721   % RESIDENT PART OF THE EXTENDED ESCAPE-HANDLING MONITOR CALLS
063721   % THE MONITOR CALLS IS EXECUTED ON PIT3-SEGMENT.
063721   SUBR ELON,ELOFF,ELOFU,DLOFU,EUSEL,DUSEL,T2P07
063721   ELON:  CALL GET0; CALL SPT3PIT; GO ELON3         % (MON 302)
063724   ELOFF: CALL GET0; CALL SPT3PIT; GO ELOF3         % (MON 303)
063727   ELOFU: CALL GET0; CALL SPT3PIT; GO ELO3F         % (MON 276)
063732   DLOFU: CALL GET0; CALL SPT3PIT; GO DLOF3         % (MON 277)
063735   EUSEL: CALL GET0; CALL SPT3PIT; GO EUSE3         % (MON 300)
063740   DUSEL: CALL GET0; CALL SPT3PIT; GO DUSE3         % (MON 301)
063743   T2P07: CALL CBERSP; 0/\0; GO T207RET             % ESCAPE RESPONSE IN ELON
063746   RBUS
063760   
063760   *"8IBRS
"063760   %=======================================================================
063760   %            I B R S I Z
063760   %
063760   % RESIDENT PART OF IBRSIZ MONITOR CALL. CODE ON PIT3-SEGMENT
063760   @LIB CXCPU
063760   @LIB CXCPU-,
063760   SUBR IBRSIZ,T2C06,T2P06,IBLBYT
063760   @ELIB
063760   IBRSIZ: CALL GET0; CALL SPT3PIT; GO IBR3S        % (MON 313)          
063763   T2C06: *POF
063764   T2P06: GO BISIZ; 0/\0; *PON                      % CALL TO BISIZ FOR TAD
063767          GO T206RET
063770   @LIB CXCPU-,
063770   IBLBYT: *POF; LBYT; PON; EXIT                    % LOAD A BYTE FROM BUFFER IN POF
063774   @ELIB
063774   RBUS
064001   *"
"064001   
064001   %=============================================================================
064001   %            C L R B M A P   B M F R T D   B M T R T D  
064001   %            B M O R
064001   %
064001   % ROUTINES TO MANIPULATE WITH THE RT-DESCRIPTION'S REENTRANT BITMAP
064001   %
064001   SUBR CLRBMAP,BMFRTD,BMTRTD,BMOR
064001   
064001   % CLRBMAP:   CLEAR THE REENTRANT BITMAP
064001   %      ENTRY:  X=RTDESCRIPTION; INTERRUPT MUST BE OFF OR MLEV DISABLED
064001   %      EXIT:   PAGING IS ON
064001   %
064001   CLRBMAP: *POF
064002          X:=X.RTDLGADDR
064003          0=:X.BITMAP=:X.BITM1=:X.BITM2=:X.BITM3=:X.BITM4=:X.BITM5=:X.BITM6=:X.BITM7
064013          *PON; EXIT
064015   
064015   % BMFRTD:    COPY BITMAP FROM RT-DESCRIPTION TO ARRAY POINTED AT BY B-REG
064015   %      ENTRY:  X=RTDESCRIPTION; B=ARRAY ADDR
064015   %      EXIT:   T,A,D,X ARE DESTROYED
064015   %
064015   BMFRTD:
064015   *"CXCPU
"064015          X:=X.RTDLGADDR+5BITMAP; B+BXBITMAP; T:=0
064021          *LDDTX 00; STD 0,B; LDDTX 20; STD 2,B
064025          *LDDTX 40; STD 4,B; LDDTX 60; STD 6,B
064031          B-BXBITMAP; EXIT
064033   *"
"064033   
064033   % BMTRTD:    COPY BITMAP FROM ARRAY POINTED AT BY B-REG TO RT-DESCRIPTION
064033   %      ENTRY:  X=RTDESCRIPTION; B=ARRAY ADDR
064033   %      EXIT:   T,A,D,X ARE DESTROYED
064033   %
064033   BMTRTD:
064033   *"CXCPU
"064033          X:=X.RTDLGADDR+5BITMAP; B+BXBITMAP; T:=0
064037          *LDD 0,B; STDTX 00; LDD 2,B; STDTX 20
064043          *LDD 4,B; STDTX 40; LDD 6,B; STDTX 60
064047          B-BXBITMAP; EXIT
064051   *"
"064051   
064051   % BMOR:      RT-DESCRIPTION.BITMAP OR SAVED-BITMAP =: RTDESCRIPTION.BITMAP
064051   %      ENTRY: X=RTDESCRIPTION ADDR; B=ARRAY ADDR
064051   %             MUST BE CALLED IN IOF AND ARRAY POINTED TO BY B-REG MUST
064051   %             BE IN MEMORY WHEN BMOR IS CALLED
064051   %      EXIT:  T,A,D,X ARE DESTROYED
064051   %
064051   BMOR:  X:=X.RTDLGADDR+5BITMAP; T:=0
064054          *LDATX 00; ORA XUBIM,B; STATX 00
064057          *LDATX 10; ORA XUBI1,B; STATX 10
064062          *LDATX 20; ORA XUBI2,B; STATX 20
064065          *LDATX 30; ORA XUBI3,B; STATX 30
064070          *LDATX 40; ORA XUBI4,B; STATX 40
064073          *LDATX 50; ORA XUBI5,B; STATX 50
064076          *LDATX 60; ORA XUBI6,B; STATX 60
064101          *LDATX 70; ORA XUBI7,B; STATX 70
064104          EXIT
064105   RBUS
064105   
064105   
064105   %==========================================================================
064105   %            C S T S E G
064105   %
064105   % ROUTINE TO CALL STSEG IN "POF-AREA", CALLED FROM MMREENT
064105   %
064105   SUBR CSTSEG
064105   CSTSEG: MLEV; *MCL PIE; POF; ION
064111          X=:A:=L; CALL STSEG; A:=RTREF:=:X; CALL CLRBMAP     % CLRBMAP SETS PAGING ON
064117          A=:L; MLEV; *MST PIE
064122          EXIT
064123   RBUS
064126   
064126   %=============================================================================
064126   %            R E E I N   R E E U T
064126   %
064126   % COPY THE REENTRANT BITMAP BETWEEN TWO RT-PROGRAMS
064126   %
064126   % REEIN: COPY BITMAP FROM SSREF TO RTREF
064126   % RREUT: RTREF.BITMAP\/SSREF.BITMAP=:SSREF.BITMAP
064126   %
064126   SUBR REEIN,REEUT
064126   
064126   INTEGER LREG,BREG,XREG
064131   
064131   REEIN: K:=1; GO FELLS
064133   REEUT: K:="0"
064134   FELLS: *PIOF
064135          X=:XREG:=L=:LREG:=SSREF:=:B=:BREG:=RTREF
064144          IF K THEN
064146             RSEGM=:X.RSEGM
064150             RTDLGADDR+"5BITMAP-BXBITMAP"=:B; CALL BMTRTD
064154          ELSE
064155             0=:X.RSEGM; X:=X.RTDLGADDR+"5BITMAP-BXBITMAP":=:B; CALL BMOR
064162          FI; X:=BREG=:B:=LREG=:L:=XREG; *PION
064170          EXIT
064171   RBUS
064174   
064174   *"8MOLI
"064174   %==============================================================================
064174   %
064174   % MON LOGIN
064174   %            <LOG.DEV>       : LOGICAL DEVICE NUMBER OF THE TERMINAL
064174   %            <USER NAME>
064174   %            <PASSWORD>
064174   %            <PROJECT PASSWORD>
