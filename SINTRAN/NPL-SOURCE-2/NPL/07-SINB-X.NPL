061635   %==============================================================================
061635   % 15.7       R T L R F I L E   R T L W F I L E   R T L 2 W F I L E
061635   %            T R T L D S E G   R T L R E T
061635   %            L O N A L T       L O F F A L T
061635   %            R T L M C A L L
061635   %
061635   % SUBROUTINES USED BY THE RT-LOADER
061635   
061635   SUBR RTLRFILE,RTLWFILE,RTL2WFILE,TRTLDSEG,RTLRET,LONALT,LOFFALT,RTLMCAL
