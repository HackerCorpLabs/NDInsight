060237   ERRMON: CALL GET0
060240          IF ZAREG><#35 AND ><#90 AND ><#91 AND <#50 OR >#69 THEN #41 FI
060261          A=:MERRNO; ZTREG; CALL 9ERRA
060264   INTEGER MERRNO
060265          GO RET
