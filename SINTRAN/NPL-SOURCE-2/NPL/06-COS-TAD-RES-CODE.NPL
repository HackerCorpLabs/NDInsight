055616   @DEV 1
055616   @DEV (S-S-J)COS-TAD-RES-CODE
055616   

055616   %%%%%%%%%%%%%%%%%%%%  COS-TAD-RES-CODE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
055616   
055616   *"BADAD
"055616   %==============================================================================
055616   %     T * A * D    R * E * S * I * D * E * N * T     P * A * R T
055616   %==============================================================================
055616   
055616   %-----------------------------------------------------------------------
055616   %   SAVED PIE IN MLVLOC TO RESET CORRECT STATE OF MLEV IN MLVULOC
055616   
055616   INTEGER MLVSAV
055617   %----------------------------------------------------------------------
055617   
055617   %=====================================================================
055617   %           M L V L O C 
055617   %
055617   % ROUTINE TO DISABLE MONITOR LEVEL. THE ORIGINAL STATE OF MONITOR LEVEL
055617   % IS SAVED IN MLVSAV                               
055617   % THE ROUTINE RETURNS WITH ION
055617   SUBR MLVLOC
055617   INTEGER AREG              
055620   MLVLOC: *IOF
055621          A=:AREG; *TRA PIE     
055623          A=:MLVSAV; MLEV; *MCL PIE       % SAVE PIE AND DISABLE MLEV
055626          A:=AREG; *ION; EXIT
055631   RBUS
055632   
055632   %=====================================================================
055632   %           M L V U L O C 
055632   %
055632   % ROUTINE TO ENABLE MONITOR LEVEL IF BIT 3 IS SET IN MLVSAV
055632   SUBR MLVULOC
055632   INTEGER AREG              
055633   MLVULOC: *IOF
055634          A=:AREG:=MLVSAV; 0=:MLVSAV         
055637          IF A BIT MLEVL THEN             % MONITOR LEVEL MUST BE ENABLED
055641              MLEV; *MST PIE
055643          FI
055643          A:=AREG; EXIT
055645   RBUS
055646   
055646   %==============================================================================
055646   %     T * A * D     S * T * A * C * K    R * O * U * T * I * N * E * S
055646   %==============================================================================
055646   %     EACH TAD HAS A STACK AREA IN PHYSICAL MEMORY. THE AREA IS RESERVED
055646   %     AT SINTRAN STARTUP. BOTH INPUT AND OUTPUT DATAFIELD (TSTADD) POINTS
055646   %     TO THE STACK.
055646   %
055646   %     GLOBAL VARIABLES:   TSBANK  - MEMORY BANK FOR STACK AREA
055646   %                         TSSIZE  - SIZE OF EACH TAD STACK
055646   %     DATAFIELD VARIABLE: TSTADD  - STACK ADDRESS
055646   
055646   %======================================================================================
055646   %      T S T O W F L   T S T D E R R
055646   %
055646   % FATAL ERROR IN TAD STACK. ERRFATAL IS CALLED
055646   % WHEN THE SYSTEM IS IN ERRFATAL THE REGISTERS WILL CONTAIN
055646   % SOME DEBUG INFORMATION:
055646   %
055646   %      A-REG - TAD STACK ADDRESS
055646   %      T-REG - WHERE THIS ROUTINE IS CALLED FROM
055646   %      D-REG - ORIGINAL L-REG                           
055646   
055646   SUBR TSTOWFL,TSTDERR,TSTEND
055646   TSTOWFL: L=:D; CALL ERRFATAL       % TAD STACK OWERFLOW
055650   TSTDERR: L=:D; CALL ERRFATAL       % TAD STACK DISPLACEMENT ERROR
055652   TSTEND:  L=:D; CALL ERRFATAL       % RETURNING AT START OF STACK
055654   RBUS
055655   
055655   %======================================================================================
055655   %      B R S T A C K    X R S T A C K
055655   %
055655   % ROUTINE TO RESET TAD STACK                             
055655   % BRSTACK: B-REG TAD-DATAFIELD INPUT OR OUTPUT
055655   % XRSTACK: X-REG TAD-DATAFIELD INPUT OR OUTPUT
055655   
055655   SUBR BRSTACK,XRSTACK
055655   INTEGER TREG,XREG,AREG,TSTAPO           
055661   XRSTACK: *IOF
055662          A=:AREG; X=:XREG; X.TSTADD=:TSTAPO; GO FELLS
055667   BRSTACK: *IOF
055670          A=:AREG; X=:XREG; TSTADD=:TSTAPO                          
055674   FELLS: T=:TREG:=TSBANK
055676          X:=TSTAPO; TSSIZE; *STATX       % STACK SIZE                    
055701          X+1; A:=1; *STATX               % STACK POINTER
055704          T:=TREG; X:=XREG; A:=AREG; *ION
055710          EXIT
055711   RBUS
055713   
055713   %======================================================================================
055713   %      S E T S T A C K
055713   %
055713   % ROUTINE TO CREATE STACK AREA FOR A ROUTINE AND SAVE L-REG
055713   % SIZE OF STACK:    LOCATION AFTER CALL  
055713   % TAD-DATAFIELD:    B-REG
055713   % ORGIGINAL L-REG:  D-REG
055713   % NORMAL RETURN:    SKIP OK
055713   % ERROR        :    STACK OWERFLOW, ERRFATAL             
055713   SUBR SETSTACK
055713   INTEGER TREG,AREG,DREG,XREG; TRIPLE TADREG=TREG
055717   INTEGER TSTMAX,STPOLD,NSIZE,NEWSTP
055723   SETSTACK: *IOF
055724          TAD=:TADREG; X=:XREG                                % SAVE REGISTERS
055726          T:=TSBANK; X:=TSTADD; *LDATX                        % GET MAX STACK SIZE
055731          A=:TSTMAX; X+1; *LDATX                              % GET OLD STACK POINTER
055734          A=:STPOLD; L=:X
055736          X.S0-=:NSIZE; STPOLD+NSIZE+2=:NEWSTP                % GET SIZE AND FIND NEW
055745          IF A>TSTMAX GO STOWF                                % TEST FOR OWERFLOW
055750          T:=TSBANK; X:=TSTADD+1; NEWSTP; *STATX              % SET NEW STACK POINT
055755          A+TSTADD=:X; STPOLD; *STATX                         % SAVE OLD STACK POINT
055761          X-1; DREG; *STATX                                   % SAVE ROUTINES L-REG
055764          TADREG; X:=XREG; *ION                               % RESTORE REGISTERS
055767          EXITA                                               % RETURN
055770   STOWF: TSTADD; P=:T; GO TSTOWFL    % STACK OWERFLOW
055773   RBUS    
055775   
055775   %======================================================================================
055775   %      T 1 X E X I    T 2 X E X I
055775   %
055775   % ROUTINES TO DO EXIT VIA THE STACK 
055775   % X-REG MUST POINT TO TAD-DATAFIELD
055775   % T1XEXI: EXIT
055775   % T2XEXI: EXITA
055775   
055775   SUBR T1XEXI,T2XEXI
055775   INTEGER RETFL,AREG,XREG,TREG,BREG
056002   T2XEXI: K:=1; GO FELLS
056004   T1XEXI: K:="0"
056005   FELLS: *IOF
056006          A=:AREG; X=:XREG; T=:TREG; X:=:B=:BREG
056013          IF K THEN 1=:RETFL ELSE 0=:RETFL FI
056021          T:=TSBANK; X:=TSTADD+1; *LDATX
056025          IF A=1 GO SEMPT                           % FATAL ERROR STACK EMPTY
056030          X+A-2; T:=TSBANK; *LDATX                  % GET L-REG
056034          A+RETFL=:L; X+1; *LDATX                   % FIND PREVIOUS POINTER
056040          X:=TSTADD+1; *STATX                       % POP STACK                
056043          A:=BREG=:B:=AREG; X:=XREG; T:=TREG; *ION
056051          EXIT
056052   SEMPT: TSTADD; P=:T; GO TSTEND
056055   RBUS
056057   
056057   %======================================================================================
056057   %      T 1 B E X I    T 2 B E X I
056057   %
056057   % ROUTINES TO DO EXIT VIA THE STACK 
056057   % B-REG MUST POINT TO TAD-DATAFIELD
056057   % T1BEXI: EXIT
056057   % T2BEXI: EXITA
056057   
056057   SUBR T1BEXI,T2BEXI
056057   INTEGER RETFL,AREG,XREG,TREG
056063   T2BEXI: K:=1; GO FELLS
056065   T1BEXI: K:="0"
056066   FELLS: *IOF
056067          A=:AREG; X=:XREG; T=:TREG
056072          IF K THEN 1=:RETFL ELSE 0=:RETFL FI
056100          T:=TSBANK; X:=TSTADD+1; *LDATX
056104          IF A=1 GO SEMPT                           % FATAL ERROR STACK EMPTY
056107          X+A-2; T:=TSBANK; *LDATX                  % GET L-REG
056113          A+RETFL=:L; X+1; *LDATX                   % FIND PREVIOUS POINTER
056117          X:=TSTADD+1; *STATX                       % POP STACK                
056122          AREG; X:=XREG; T:=TREG; *ION
056126          EXIT
056127   SEMPT: TSTADD; P=:T; GO TSTEND
056132   RBUS
056134   
056134   %======================================================================================
056134   %      S T A X   S T T X 
056134   %      S T A B   S T X B   S T T B 
056134   %
056134   % ROUTINES TO STORE ONE WORD IN THE STACK
056134   % STAX: STORE A-REG X-RELATIVE
056134   % STTX: STORE T-REG X-RELATIVE
056134   % STAB: STORE A-REG B-RELATIVE
056134   % STXB: STORE X-REG B-RELATIVE
056134   % STTB: STORE T-REG B-RELATIVE
056134   % NORMAL RETURN: SKIP OK
056134   % ERROR RETURN : DISPLACEMENT ERROR, ERRFATAL
056134   
056134   SUBR STAX,STTX,STAB,STXB,STTB
056134   INTEGER TSTAAD,CURSTP,EDISP,CAND,AREG,TREG,XREG
056143   STAX:  *IOF
056144          A=:CAND; GO FELLX
056146   STTX:  *IOF
056147          T=:CAND                    
056150   FELLX: A=:AREG; X.TSTADD; GO FELLS
056153   STXB:  *IOF
056154          X=:CAND; GO FELLB         
056156   STTB:  *IOF
056157          T=:CAND; GO FELLB         
056161   STAB:  *IOF
056162          A=:CAND
056163   FELLB: A=:AREG; TSTADD
056165   FELLS: A=:TSTAAD; X=:XREG; T=:TREG
056170          L=:X; A:=X.S0-1=:EDISP                              % FIND DISPLACEMENT
056174          T:=TSBANK; X:=TSTAAD+1; *LDATX                      % FIND STACK POSITION
056200          A+TSTAAD=:CURSTP=:X; *LDATX                         % FIND LEGAL AREA
056204          T:=EDISP; IF X+T<<A OR EDISP>-2 GO DPLER            % CHECK DISPLACEMENT
056214          T:=TSBANK; CAND; *STATX                             % STORE WORD
056217          T:=TREG; X:=XREG; AREG; *ION
056223          EXITA
056224   DPLER: TSTAAD; P=:T; GO TSTDERR              % DISPLACEMENT ERROR
056227   RBUS
056231   
056231   %======================================================================================
056231   %      S T A D B     S T A D X
056231   %
056231   % ROUTINES TO STORE TAD REGISTERS IN THE STACK
056231   % STADB: STORE TAD-REG B-RELATIVE
056231   % STADX: STORE TAD-REG X-RELATIVE
056231   % NORMAL RETURN: SKIP OK
056231   % ERROR RETURN : DISPLACEMENT ERROR, ERRFATAL
056231   
056231   SUBR STADB,STADX                
056231   INTEGER TSTAAD,CURSTP,EDISP,TREG,AREG,DREG,XREG
056240   TRIPLE TADREG=TREG; DOUBLE TAREG=TREG
056240   STADX: *IOF
056241          TAD=:TADREG; X.TSTADD; GO FELLS
056244   STADB: *IOF
056245          TAD=:TADREG; TSTADD
056247   FELLS: A=:TSTAAD; X=:XREG           
056251          L=:X; A:=X.S0-1=:EDISP                              % FIND DISPLACEMENT
056255          T:=TSBANK; X:=TSTAAD+1; *LDATX                      % FIND STACK POSITION
056261          A+TSTAAD=:X; *LDATX                                 % FIND LEGAL AREA
056264          T:=EDISP; IF X+T<<A OR EDISP>-4 GO DPLER            % CHECK DISPLACEMENT
056274          T:=TSBANK; TAREG; *STDTX                            % STORE TA-REG
056277          X+2; DREG; *STATX                                   % STORE D-REG
056302          TAD:=TADREG; X:=XREG; *ION
056305          EXITA
056306   DPLER: TSTAAD; P=:T; GO TSTDERR              % DISPLACEMENT ERROR
056311   RBUS
056313   
056313   %======================================================================================
056313   %      L D A X   L D T X 
056313   %      L D A B   L D X B   L D T B 
056313   %
056313   % ROUTINES TO LOAD ONE WORD FROM THE STACK
056313   % LDAX: LOAD A-REG X-RELATIVE
056313   % LDTX: LOAD T-REG X-RELATIVE
056313   % LDAB: LOAD A-REG B-RELATIVE
056313   % LDXB: LOAD X-REG B-RELATIVE
056313   % LDTB: LOAD T-REG B-RELATIVE
056313   % NORMAL RETURN: SKIP OK
056313   % ERROR RETURN : DISPLACEMENT ERROR, ERRFATAL
056313   
056313   SUBR LDAX,LDTX,LDAB,LDXB,LDTB
056313   INTEGER TSTAAD,CURSTP,EDISP,REGFL,AREG,TREG,XREG
056322   LDAX:  *IOF
056323          T=:TREG; X=:XREG; 0=:REGFL; GO FELLX          
056327   LDTX:  *IOF
056330          A=:AREG; X=:XREG; 2=:REGFL
056334   FELLX: X.TSTADD; GO FELLS
056336   LDXB:  *IOF
056337          A=:AREG; T=:TREG; 1=:REGFL; GO FELLB        
056344   LDTB:  *IOF
056345          A=:AREG; X=:XREG; 2=:REGFL; GO FELLB         
056352   LDAB:  *IOF
056353          T=:TREG; X=:XREG; 0=:REGFL
056356   FELLB: TSTADD
056357   FELLS: A=:TSTAAD; L=:X; A:=X.S0-1=:EDISP                   % FIND DISPLACEMENT
056364          T:=TSBANK; X:=TSTAAD+1; *LDATX                      % FIND STACK POSITION
056370          A+TSTAAD=:CURSTP=:X; *LDATX                         % FIND LEGAL AREA
056374          T:=EDISP; IF X+T<<A OR EDISP>-2 GO DPLER            % CHECK DISPLACEMENT
056404          T:=TSBANK; *LDATX                                   % LOAD WORD
056406          X:=REGFL
056407          IF X=0 THEN T:=TREG; X:=XREG; GO RETU FI            % LOAD A-REG
056414          IF X=1 THEN A=:X; AREG; T:=TREG; GO RETU FI         % LOAD X-REG
056423          A=:T; AREG; X:=XREG                                 % LOAD T-REG
056426   RETU:  *ION
056427          EXITA
056430   DPLER: TSTAAD; P=:T; GO TSTDERR              % DISPLACEMENT ERROR
056433   RBUS
056435   
056435   %======================================================================================
056435   %      L T A D B     L T A D X
056435   %
056435   % ROUTINES TO LOAD TAD REGISTERS FROM THE STACK
056435   % LTADB: LOAD TAD-REG B-RELATIVE
056435   % LTADX: LOAD TAD-REG X-RELATIVE
056435   % NORMAL RETURN: SKIP OK
056435   % ERROR RETURN : DISPLACEMENT ERROR, ERRFATAL
056435   
056435   SUBR LTADB,LTADX
056435   INTEGER TSTAAD,CURSTP,EDISP,TREG,AREG,DREG,XREG
056444   TRIPLE TADREG=TREG; DOUBLE TAREG=TREG
056444   LTADX: *IOF
056445          X=:XREG; X.TSTADD; GO FELLS          
056450   LTADB: *IOF
056451          X=:XREG; TSTADD
056453   FELLS: A=:TSTAAD; L=:X; A:=X.S0-1=:EDISP                   % FIND DISPLACEMENT
056460          T:=TSBANK; X:=TSTAAD+1; *LDATX                      % FIND STACK POSITION
056464          A+TSTAAD=:CURSTP=:X; *LDATX                         % FIND LEGAL AREA
056470          T:=EDISP; IF X+T<<A OR EDISP>-4 GO DPLER            % CHECK DISPLACEMENT
056500          T:=TSBANK; *LDDTX                                   % LOAD AD - TA-REG
056502          AD=:TAREG; X+2; *LDATX                              % LOAD A  - D-REG
056505          A=:DREG; TAD:=TADREG; X:=XREG                       % SET CORRECT REGISTERS
056510   RETU:  *ION
056511          EXITA
056512   DPLER: TSTAAD; P=:T; GO TSTDERR              % DISPLACEMENT ERROR
056515   RBUS
056517   
056517   %======================================================================
056517   % XX.XX     R S R E S T A R T
056517   %
056517   % ROUTINE TO RESTART USER AFTER RECEIVED RESPONSE. PROGRAM IS ALWAYS
056517   % IN IO-WAIT. ISTATE WAS NOT UPDATED WHEN PROGRAM WAS PUT IN WAITING 
056517   % STATE.
056517   SUBR RSRESTART
056517   RSRESTART: X=:B:=RTRES
056521          X.STATUS BZERO 5WAIT=:X.STATUS
056524          GO STUPR
056525   RBUS
056526   
056526   %======================================================================
056526   % XX.XX      R E D O M
056526   %
056526   % ROUTINE TO CAUSE MONITOR CALL TO BE REDONE
056526   % ENTRY:     B = DATAFIELD
056526   %            X = RT-PROGRAM
056526   %            D = WORKING AREA
056526   SUBR REDOM
056526   REDOM: *PON 
056527          CALL BRSTACK          % RESET TAD STACK
056530          IF X.RTRES-RTREF=0 THEN CALL WDATA FI
056534          D=:B; ZPREG-1=:ZPREG; GO RETSTUPR
056541   RBUS
056545   
056545   %=========================================================================
056545   % XX.XX      I E D C H K     
056545   %
056545   % ROUTINE TO CHECK IF INPUT IS DONE WHILE DELAYED ESCAPE ACTION IS ON
056545   % ENTRY: B = INPUT-DATAFIELD
056545   % ERROR: EXIT.  A = ERROR-CODE: INPUT DONE IN DELAYED ESCAPE ACTION
056545   % OK:    SKIP RETURN
056545   
056545   SUBR IEDCHK
056545   INTEGER DELMASK:=174377  % ZERO 5ESCLOFF, 5WESC, 5WLOC
056546   IEDCHK: IF FLAGB BIT 5ESCLOFF THEN
056551              IF T:=TYPRING BIT 5BAD THEN           %% B A D  ONLY
056554                IF A BIT 5WESC THEN                 %  ESCAPE WAITING
056556                   L=:D; CALL CBRESP; D=:L          %  SEND-RESPONSE
056561                FI                                  %
056561              FI                                    %%
056561              *IOF
056562              FLAGB/\DELMASK=:FLAGB; *ION
056566              A:=TER00; EXIT
056570           FI
056570           A:=0; EXITA
056572   RBUS
056574   
056574   %=========================================================================
056574   % XX.XX      B D O U T
056574   % 
056574   % START OUTPUT DRIVER ROUTINE FOR TAD
056574   % CALLED WITH PAGING OFF.            
056574   % ENTRY: B-REG - TAD OUTPUT DATAFIELD,  RETURN EXIT
056574   SUBR BDOUT
056574   BDOUT: *IOF
056575          B=:A; *IRW LV10B DB             % B = TAD OUTPUT DATAFIELD
056577          "ACTOUT"; *IRW LV10B DT         % T = DRIVER OUTPUT ROUTINE
056601          "SLV10";  *IRW LV10B DP         % P = LEVEL ACTIVATING POINT
056603          LV10; *MST PID           
056605          *PION; POF; EXIT                % ALLOW DRIVER TO EXECUTE
056610   RBUS
056612   
056612   %=========================================================================
056612   % XX.XX      C B E R S P
056612   % 
056612   % IF TAD, ROUTINE ACTIVATES DRIVER TO SEND ESCAPE-RESPONSE
056612   % ENTRY: B-REG - INPUT-DATAFIELD,  RETURN EXIT AD1
056612   SUBR CBERSP
056612   CBERSP: IF TYPRING BIT 5BAD THEN      
056615             L=:A; CALL BRSTACK; A=:L; *IOF  % RESET TAD-STACK
056621             B=:A; *IRW LV10B DB             % B = TAD INPUT DATAFIELD
056623             "BERESP"; *IRW LV10B DT         % T = DRIVER ESCAPE-RESPONSE
056625             "SLV10";  *IRW LV10B DP         % P = LEVEL ACTIVATING POINT
056627             LV10; *MST PID           
056631          FI
056631          *PION; EXIT AD1
056633   RBUS
056637   
056637   %=========================================================================
056637   % XX.XX      C X R E S P
056637   % 
056637   % IF TAD, ROUTINE ACTIVATES DRIVER TO SEND ESCAPE-RESPONSE
056637   % ENTRY: X-REG - INPUT-DATAFIELD,  RETURN EXIT AD1
056637   % ROUTINE IS CALLED WITH INTERUPTS OFF PAGING ON
056637   SUBR CXRESP
056637   CXRESP: L+1=:D                        
056641           IF X.TYPRING BIT 5BAD THEN         
056644             CALL XRSTACK; *IOF              % RESET TAD STACK
056646             X=:A; *IRW LV10B DB             % B = TAD INPUT DATAFIELD
056650             "BERESP"; *IRW LV10B DT         % T = DRIVER ESCAPE-RESPONSE
056652             "SLV10";  *IRW LV10B DP         % P = LEVEL ACTIVATING POINT
056654             LV10; *MST PID; ION; IOF 
056660          FI
056660          D=:P         
056661   RBUS
056665   
056665   %======================================================================
056665   % XX.XX      B D T O U
056665   %
056665   % OUTPUT TIMEOUT ROUTINE FOR TAD, CALLED WITH INTERUPT OFF
056665   % ROUTINE SENDS OUTPUT BUFFER AT TIMEOUT
056665   % B = TAD OUTPUT DATAFIELD
056665   SUBR BDTOU
056665   INTEGER POINTER LREG
056666   BDTOU: L=:D; CALL MLVLOC; CALL BRSTACK; CALL SETSTACK(0); *POF
056674          CALL SNDBUF; 0/\0; TTMR=:TMR; *PON
056701          CALL MLVULOC; GO T1BEXI 
056703   RBUS
056711   
056711   %======================================================================
056711   % XX.XX      C T I B A D
056711   %
056711   % INPUT IOSET ROUTINE FOR TAD
056711   % ENTRY: B = INPUT-DATAFIELD
056711   %        X = WORKING-AREA
056711   SUBR CTIBAD
056711   DISP -4; INTEGER XREG,TREG,AREG,DREG; TRIPLE TADREG=TREG; PSID                 
056711   CTIBAD: L=:D; CALL MLVLOC
056713          CALL BRSTACK; CALL SETSTACK(XREG)
056716          CALL STADB(TADREG); CALL STXB(XREG)
056722          IF X:=PORTNO=0 GO RETU; *POF
056725          IF A=-1 THEN                    % CLEAR BUFFER
056730             CALL CLIDAT; 0/\0
056732             IF A=1 THEN
056735                CALL CTRMES; 0/\0
056737             FI
056737             DFOPP=:B
056741   NXBFF:    7RESE; T:=0; CALL CREMES; GO ECHEC
056745             CALL SNDBUF; GO ORET; DFOPP=:B; GO RETW          % SEND RESET
056752   ECHEC:    IF A=2 THEN
056755                IF DFOPP.BUFFID><0 THEN
056760                   CALL MOVITO; GO NXBFF
056762                FI
056762             FI; GO ORET
056763   RETW:     *IOF
056764             RTREF.STATUS BONE 5WAIT=:X.STATUS
056770             7RECO=:DFOPP.RSPNUM; 1=:MTOR; GO RETU
056776   ORET:     DFOPP=:B; GO RETU
057001          FI
057001   RETU:  CALL LTADB(TADREG); CALL LDXB(XREG); *PON       
057006          CALL MLVULOC; GO T1BEXI
057010   RBUS
057030   
057030   %======================================================================
057030   % XX.XX      C T O B A D
057030   %
057030   % OUTPUT IOSET ROUTINE FOR TAD
057030   % ENTRY: B = OUTPUT-DATAFIELD
057030   %        X = WORKING-AREA
057030   %        A = CONTROLL
057030   %        D = PARAMETER
057030   % CALLED WITH INTERUPT OFF
057030   SUBR CTOBAD
057030   DISP -4; INTEGER XREG,TREG,AREG,DREG; TRIPLE TADREG=TREG; PSID
057030   CTOBAD: D=:T:=L; CALL MLVLOC
057033          CALL BRSTACK; CALL SETSTACK(XREG)
057036          CALL STADB(TADREG); CALL STXB(XREG)
057042          IF X:=DFOPP.PORTNO=0 GO RETU; *POF
057046          IF A=-1 THEN                              % CLEAR BUFFER
057051             CALL CLODAT; 0/\0  
057053             IF A=1 THEN
057056                CALL SNDBUF; 0/\0; GO RETU
057061             ELSE
057062                X:=BUFFID; AD:=TDTADD; 0=:BUFFID=:REMSIZ; CALL PUTPOOL
057067                GO RETU
057070             FI
057070          FI
057070          IF A=-2 THEN
057073             CALL SNDBUF; 0/\0; GO RETU             % SEND BUFFER
057076          FI
057076          IF A=23 OR A=24 THEN                      % SYSTEM/USER CONTROLL
057104   NWBUF:    IF BUFFID=0 THEN
057106                CALL GETPOOL; GO NYTRY              % GET NEW BUFFER
057110             FI
057110             CALL LDAB(AREG); IF A=23 THEN 7SYCN ELSE 7USCN FI
057120             T:=2; CALL CREMES; GO ECHK
057123             CALL LDAB(TREG); CALL WORDPUT; GO RETU; CALL LDAB(AREG)
057131             IF A=23 THEN
057134                CALL LDAB(TREG)
057136                IF A=1 OR A=13 OR A=17 THEN CALL SNDBUF; 0/\0 FI
057151             ELSE
057152                CALL SNDBUF; 0/\0; *IOF
057155                RTREF.STATUS BONE 5WAIT=:X.STATUS
057161                7ERRS=:RSPNUM; 1=:MTOR
057165             FI
057165             GO RETU
057166          FI
057166   RETU:  CALL LTADB(TADREG); CALL LDXB(XREG); *PON       
057173          CALL MLVULOC; GO T1BEXI
057175                  
057175   ECHK:  IF A=1 GO NYTRY
057200          IF A=2 THEN
057203             CALL SNDBUF; GO RETU; GO NWBUF
057206          FI
057206          GO RETU
057207   
057207   NYTRY: CALL LDAB(XREG); A=:D; RTREF=:X; CALL MLVULOC; GO REDOM
057216   RBUS
057242   
057242   %=======================================================================
057242   % XX.XX      B B R E C 
057242   %
057242   % ROUTINE TO SEND BREAK AND ECHO MESSAGE FOR TAD
057242   % ENTRY: X = INPUT DATAFIELD
057242   %        D = CONTROLL (1=BREAK, 2=ECHO)
057242   SUBR BBREC
057242   BBREC: A:=L+1=:X."LRSA"; IF X.PORTNO=0 GO RETU
057246          CALL XRSTACK; CALL MLVLOC; ZAREG/\377; *POF
057253          IF D=1 THEN CALL BDBREA ELSE CALL BDECHO FI; *PON
057262          CALL MLVULOC; *ION
057264   RETU:  T:=X."LRSA"=:L; EXIT
057267   RBUS
057275   
057275   %=====================================================================
057275   % XX.XX      B S T T Y
057275   %
057275   % ROUTINE TO SEND TERMINAL TYPE CALLED FROM MSSTY
057275   % X = INPUT-DATAFIELD
057275   
057275   SUBR BSTTY
057275   BSTTY: A:=L+1=:X."LRSA"
057277          IF X.PORTNO=0 THEN EXITA FI          
057302          X:=:B=:XRSA; DFOPP=:B
057306          CALL MLVLOC; CALL BRSTACK; *POF
057311   NXBUF: 7TTYP; T:=2; CALL CREMES; GO ECHEC
057315          DFOPP.CTTYP; CALL WORDPUT; GO RETU
057321   RETU:  *PON
057322          CALL MLVULOC; *ION
057324          DFOPP=:X; X.XRSA=:B; X."LRSA"=:L; EXIT
057333   
057333   ECHEC: IF A=2 THEN CALL SNDBUF; 0/\0; GO NXBUF; FI
057341          GO RETU
057342   RBUS
057350   
057350   %======================================================================
057350   % XX.XX      B T M O D
057350   %
057350   % ROUTINE TO SEND TERMINAL-MODE, CALLED FROM MTERMODE
057350   %
057350   % B = OUTPUT-DATAFIELD, A = MODE
057350   
057350   SUBR BTMOD
057350   BTMOD: T:=L+1=:"LRSA"; IF T:=DFOPP.PORTNO=0 THEN EXITA FI; *POF
057360          A=:XRSA; CALL MLVLOC; CALL BRSTACK                  % RESET TAD STACK
057363   NXBUF: 7TMOD; T:=1; CALL CREMES; GO ECHEC
057367          A:=XRSA/\377; CALL BYTPUT; GO RETU
057373          CALL SNDBUF; 0/\0
057375   RETU:  *PON
057376          CALL MLVULOC; *ION
057400          GO LRSA
057401   ECHEC: IF A=2 THEN CALL SNDBUF; 0/\0; GO NXBUF; FI
057407          GO RETU
057410   RBUS
057417   
057417   %======================================================================
057417   % XX.XX      C T M O D
057417   %
057417   % ROUTINE TO SEND TERMINAL-MODE, CALLED FROM TERMODE COMMAND
057417   %
057417   % X = INPUT-DATAFIELD
057417   
057417   SUBR CTMOD
057417   CTMOD: T:=L+1=:X."LRSA"; IF X.PORTNO=0 THEN EXITA FI; CALL MLVLOC; *POF
057426          X:=:B=:XRSA; DFOPP=:B; CALL BRSTACK          % RESET TAD STACK
057433   NXBUF: 7TMOD; T:=1; CALL CREMES; GO ECHEC; DFOPP=:B; A:=0
057442   
057442   % CAPITAL LETTERS
057442          IF T:=DFLAG BIT 5CAPITAL THEN A BONE "0" FI
057446   % CR DELAY
057446          IF T:=TYPRING BIT 5CRDLY THEN A BONE 1 FI
057452   % STOP ON FULL PAGE
057452          IF T:=DFOPP.SCREEN><X:=0 THEN A BONE 2 FI
057460   % LOGGOUT ON MISSING CARRIER 
057460          IF T:=FLAGB BIT 5LBLOG   THEN A BONE 3 FI
057464          X:=DFOPP=:B; CALL BYTPUT; GO RETU
057470          CALL SNDBUF; 0/\0
057472   RETU:  *PON
057473          CALL MLVULOC; *ION
057475          DFOPP=:X; X.XRSA=:B; X."LRSA"=:L; EXIT 
057504   ECHEC: IF A=2 THEN CALL SNDBUF; 0/\0; GO NXBUF; FI
057512          GO RETU
057513   RBUS
057521   
057521   %========================================================================
057521   % XX.XX      B C E S C
057521   %
057521   % ROUTINE CALLED FROM MCDESCFU/MCEESCFU TO SEND ENABLE/DISABLE ESCAPE
057521   % X = INPUT DATAFIELD
057521   SUBR BCESC
057521   BCESC: IF X.PORTNO=0 THEN EXITA FI  
057524          A:=L+1=:X."LRSA"; X:=:B=:XRSA; DFOPP=:B
057532          CALL MLVLOC; CALL BRSTACK; *POF             % RESET TAD STACK
057535   NXBUF: 7CESC; T:=1; CALL CREMES; GO ECHECK
057541          IF DFOPP.DFLAG BIT 5IESC THEN A:=0 ELSE A:=1 FI
057550          CALL BYTPUT; GO RETU; CALL SNDBUF; GO RETU; *IOF
057555          RTREF.STATUS BONE 5WAIT=:X.STATUS
057561          7CERS=:RSPNUM; 1=:MTOR
057565   RETU:  *PON
057566          CALL MLVULOC; *ION
057570          DFOPP=:X; X.XRSA=:B; X."LRSA"=:L; EXIT
057577   ECHEC: IF A=2 THEN CALL SNDBUF; 0/\0; GO NXBUF; FI
057605          GO RETU
057606   RBUS
057616   
057616   %========================================================================
057616   % XX.XX      B S D A E
057616   %
057616   % ROUTINE CALLED FROM MSDAE TO SEND CHANGE ESCAPE CHARECTER
057616   % X = INPUT DATAFIELD
057616   SUBR BSDAE
057616   BSDAE: A:=L+1=:X."LRSA"; IF X.PORTNO=0 THEN EXITA FI
057623          X:=:B=:XRSA; DFOPP=:B; CALL MLVLOC; CALL BRSTACK; *POF     
057632   NXBUF: 7DESC; T:=1; CALL CREMES; GO ECHECK
057636          DFOPP.CESCP/\377
057641          CALL BYTPUT; GO RETU; CALL SNDBUF; GO RETU
057645   RETU:  *PON
057646          CALL MLVULOC; *ION
057650          DFOPP=:X; X.XRSA=:B; X."LRSA"=:L; EXIT
057657   ECHEC: IF A=2 THEN CALL SNDBUF; 0/\0; GO NXBUF; FI
057665          GO RETU
057666   RBUS
057675   
057675   %=====================================================================
057675   % XX.XX      B I S I Z    O I S I Z
057675   %
057675   % ROUTINE CALLED FROM IBRSIZ WITH:                         
057675   % B = INPUT-DATAFIELD, X = WORKING-AREA
057675   % TO FIND NUMBER OF CHARACTERS LEFT TO READ IN A TAD
057675   % IF TAD INPUT-BUFFER IS EMPTY, A REQUEST FOR ISIZE IS SENT
057675   % TO PARTNER. 
057675   % ROUTINE IS CALLED WITH INTERUPT PAGING OFF
057675   %
057675   % SKIP-RETURN: A = NUMBER OF CHARACTERS IN BUFFER
057675   %              X = NUMBER OF CHARACTERS INCLUDING FIRST BREAK  (BISIZ ONLY)
057675   % RETURN:      A = ERROR CODE
057675   
057675   SUBR BISIZ,OISIZ
057675   BISIZ: 0=:XRSA; GO FELLS          % IBRSIZ (MON 313)
057677   OISIZ: 1=:XRSA                    % ISIZE  (MON 66)
057701   FELLS: X=:"LRSA"; CALL MLVLOC; CALL BRSTACK; *POF % RESET TAD-STACK
057705          IF BUFFID><0 THEN                          % INPUT BUFFER PRESENT
057707             IF CURMES=7BDAT THEN                    % DATA-MESSAGE PRESENT
057713   CDATA:       A:=REMBYT-
057715                IF A-1=0 THEN GO CMORE ELSE GO RETU FI
057721             ELSE
057722   CMORE:       CALL GETMES; GO ENDCH               % GET NEXT MESSAGE
057724                IF A=X:=7BDAT THEN                  % DATA MESSAGE
057727                   IF T=0 THEN                      % EMPTY
057731                      GO CMORE
057732                   ELSE                            
057733                      T=:A; GO RETU                 % NUMBER OF BYTES FOUND
057735                   FI
057735                ELSE
057736                   CALL CTRMES; GO EROUT  
057740                   IF CURMES=7BDAT THEN GO CDATA ELSE GO CMORE FI
057746             FI;FI; GO CMORE
057747             
057747   ENDCH:    IF A<0 GO EROUT
057750             IF A=3 THEN
057753                CALL SNDREJ; 0/\0; A:=TER01; GO EROUT
057757             FI
057757          FI
057757   
057757   % INPUT-BUFFER IS EMPTY OR NOT PRESENT
057757          DFOPP=:B                        % B = OUTPUT DATAFIELD
057761          IF DFOPP.BUFFID><0 THEN         % RETURN INPUT BUFFER TO POOL
057764             0=:X.BUFFID=:X.REMSIZ=:X.CURMES=:X.NOBDIS
057770             A=:T; AD:=X.TDTADD; T=:X; CALL PUTPOOL
057774          FI
057774   
057774   TAGAI: A:=7ISRQ; T:=0; CALL CREMES; GO BCHEC
060000          CALL SNDBUF; GO EROUT; GO WANSW
060003   
060003   BCHEC: IF A<0 GO EROUT
060004          IF A=2 THEN                     % OUTPUT-BUFFER FULL
060007             CALL SNDBUF; GO EROUT; GO TAGAI
060012          FI
060012          DFOPP=:B; RTREF=:X; "LRSA"=:D; *PON
060021          CALL MLVULOC; *ION
060023          GO REDOM                        % TRY WHEN BUFFERS RETURNED
060024   
060024   % WAIT FOR ISIZE RESPONSE FROM OTHER SIDE
060024   WANSW: *PON 
060025          CALL MLVULOC; DFOPP=:B                   % B = INPUT DATAFIELD, IOF FROM ULOC
060030          RTREF.STATUS BONE 5WAIT=:X.STATUS
060034          IF XRSA=0 THEN 7ISRS ELSE 7ISRS BONE 17 FI        
060042          A=:DFOPP.RSPNUM; "LRSA"=:B; 1=:MTOR; *ION
060051          MIN ZPREG; GO RET                         % RETURN IN IOWAIT
060053   
060053   % CHARACTERS PRESENT IN LOCAL BUFFER, RETURN NUMBER
060053   RETU:  *PON
060054          CALL MLVULOC; *ION
060056          B=:X; T:="LRSA"=:B; X:=X.XRSA;           
060062          A=:ZAREG; IF X=0 THEN A=:ZXREG FI
060066          MIN ZPREG; GO RET
060070   
060070   % ERROR RETURN
060070   EROUT: *PON
060071          CALL MLVULOC; *ION
060073          T:="LRSA"=:B; A=:ZAREG; GO RET
060077   RBUS
060115   
060115   %=====================================================================
060115   % XX.XX      P I S I Z
060115   %
060115   % ROUTINE CALLED FROM ISIZE MON CALL IF TAD
060115   SUBR PISIZ
060115   PISIZ: *PIOF
060116          B:=:X; GO OISIZ
060120   RBUS
060121   
060121   %=====================================================================
060121   % XX.XX      B O S I Z
060121   %
060121   % ROUTINE CALLED FROM OSIZE IF TAD
060121   % X = OUTPUT-DATAFIELD
060121   SUBR BOSIZ
060121   BOSIZ: IF X.BUFFID><0 THEN
060123             A:=X.REMSIZ
060124          FI
060124          A=:ZAREG; MIN ZPREG; GO RET
060127   RBUS
060130   

060130   %=====================================================================
060130   % XX.XX      B S C P C
060130   %
060130   % ROUTINE TO PREPARE SENDING OF COMPLETION CODE, CALLED FROM UEADM.
060130   % THE ROUTINE MUST CHECK DATA TO DETERMINE IF THE CURRENT OPERATION 
060130   % OF UEADM IS WRITE COMPLETION CODE.
060130   
060130   SUBR BSCPC
060130   DISP -177; INTEGER T2SEG,WPNT; PSID
060130   DISP -165; INTEGER ARRAY POINTER SYARR; PSID
060130   SYMBOL FPART=3,CBC01,CBC02,LPART,AREND=27
060130   INTEGER POINTER TTIF:=TTIFIELD
060131   BSCPC: A:=L+1=:TTIF."LRSA"; IF X.PORTNO=0 THEN EXITA FI
060137          CALL XRSTACK                           % RESET TAD STACK
060140          WPNT=:D
060142          FOR X:=0 TO FPART DO; X:=:D            % CHANGE IN UEDAT BEFORE COMP.CODE?
060147              T:=T2SEG; CALL GET1L; GO ERR; X+1:=:D
060154              IF A><SYARR(X) GO NOCOD
060157          OD; A:=D+2=:D
060164          FOR X:=LPART TO AREND DO; X:=:D        % CHANGE IN UEDAT AFTER COMP.CODE?
060171              T:=T2SEG; CALL GET1L; GO ERR; X+1:=:D
060176              IF A><SYARR(X) GO NOCOD
060201          OD
060203          T:=T2SEG; X:=WPNT+CBC02; CALL GET1L; GO ERR    % COLLECT COMPLETION CODE
060210          A=:D; X-1; CALL GET1L; GO ERR; X:=TTIF:=:B     % --------- " ----------
060216          CALL MLVLOC; *POF                              
060220          CALL SNDCP; *PON                               % SEND COMPLETION CODE
060222          CALL MLVULOC; X:=:B; *ION
060225   RETU:  X."LRSA"=:L; EXIT
060230   ERR:
060230   NOCOD: X:=TTIF; GO RETU
060232   RBUS
060237   
060237   
060237   *"-BADAD
