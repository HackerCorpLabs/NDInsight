135454   @DEV 1
135454   @DEV (S-S-J)COS-TAD-POF-CODE
135454   

135454   %%%%%%%%%%%%%%%%%%%%%%%%% COS-TAD-POF-CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
135454   
135454   *"BADAD
"135454   %==============================================================================
135454   %      T * A * D   P * A * G * I * N * G    O * F * F    P * A * R * T
135454   %==============================================================================
135454   
135454   %=======================================================================
135454   %      T A D   B U F F E R   O P E R A T I O N   R O U T I N E S
135454   %=======================================================================
135454   
135454   % XX.XX      D R X A C C
135454   %
135454   % SUBROUTINE TO PERFORM DIRECT ACCESS TO XMSG BUFFERS
135454   % NOTE! THE ROUTINE TURNS THE INTERRUPT OFF AND RETURNS IN IOF
135454   SUBR DRXACC
135454   INTEGER POINTER LREG
135455   INTEGER FUNC=?
135455   DISP 0; INTEGER ACCFUN; PSID
135455   DRXACC: IF X=0 THEN A:=XEIBP; EXITA; FI          % INCORRECT BUFFID    
135461           X:=:L; A=:D; X.ACCFUN; *IOF
135465           A=:FUNC; X=:"LREG"; L=:X; D=:A
135471           CALL DRXMSG; INTEGER FUNC
135473           GO RETU; MIN "LREG"
135475   RETU:   MIN "LREG"; GO LREG                           
135477   RBUS
135500   
135500   %========================================================================
135500   %      W R M H E A D
135500   %
135500   % ROUTINE TO WRITE MESSAGE HEADER ON EVEN BYTE
135500   %      ENTRY:   A-REG - MESSAGE HEADER
135500   %               B-REG - TAD OUTPUT DATAFIELD
135500   %      RETURN:  EXIT
135500   %
135500   SUBR WRMHEAD
135500   WRMHEAD: A=:D; T:=TDTAFI; X:=TDTALA
135503          IF TDBTPT BIT "0" THEN                    % ODD START, CREATE PAD BYTE
135506             A SHZ -1; X+A; *LDATX
135511             A/\177400; *STATX
135513             MIN TDBTPT; REMSIZ-1=:REMSIZ
135517          FI
135517          X:=TDTALA
135520          TDBTPT SHZ -1; X+A; D=:A; *STATX                    % WRITE IN BUFFER
135525          TDBTPT+2=:TDBTPT; REMSIZ-2=:REMSIZ
135533          EXIT
135534   RBUS
135535   
135535   %=======================================================================
135535   % XX.XX      C R E M E S  
135535   %
135535   % ROUTINES TO CREATE MESSAGE-HEADERS IN XMSG BUFFER  (TAD OUTPUT)
135535   % 
135535   % ENTRY:     A-REG - MESSAGE TYPE
135535   %            T-REG - REQUIRED I-FIELD SIZE
135535   %            B-REG - TAD OUTPUT DATAFIELD
135535   %
135535   % RETURN:    SKIP-RETURN:  OK     TAD DATAFIELD BUFFER VARIABLES
135535   %                                 REMSIZ,CURMES,NOBDIS ARE UPDATED
135535   %
135535   %            NOSKIP:       ERROR  A-REG:  1  NO OUTPUT BUFFER PRESENT
135535   %                                 A-REG:  2  OUTPUT-BUFFER FULL
135535   %                                 A-REG: <0  XMSG ERROR CODE
135535   %
135535   SUBR CREMES          
135535   DISP -2; INTEGER AREG,TREG; PSID
135535   CREMES: L=:D; CALL SETSTACK(AREG)
135540          CALL STAB(AREG); CALL STTB(TREG)
135544          IF BUFFID=0 THEN CALL GETPOOL; GO NOPOL FI          % NO BUFFER
135550          CALL LDTB(TREG)                                     % GET REQUIRED IFIELD SIZE
135552          IF TDBTPT BIT "0" THEN T+3 ELSE T+2 FI              % ODD OR EVEN START IN BUFFER
135560          IF REMSIZ<T THEN A:=2; GO T1BEXI FI                 % NOT ENOUGH SPACE
135565          CALL LDAB(AREG); A SHZ 10; CALL WRMHEAD             % WRITE MESSAGE HEADER
135571          TDBTPT-1=:NOBDIS; CALL LDAB(AREG); A=:CURMES        % UPDATE MESSAGE INFO
135577          GO T2BEXI                 
135600   NOPOL: A:=1; GO T1BEXI
135602   RBUS
135613   
135613   %=======================================================================
135613   %            C R H E E V                 
135613   %
135613   % ROUTINE LIKE CREMES BUT BYTE COUNTER IS ALSO WRITTEN           
135613   % USED WHEN MESSAGE IS COMPLETED BY CALLING ROUTINE
135613   % MESSAGE HEADER IS CREATED ON EVEN BYTE
135613   % 
135613   % ENTRY:     A-REG - MESSAGE TYPE
135613   %            T-REG - REQUIRED I-FIELD SIZE
135613   %            B-REG - TAD OUTPUT DATAFIELD
135613   %
135613   % RETURN:    SKIP-RETURN:  OK     TAD DATAFIELD BUFFER VARIABLES
135613   %                                 REMSIZ,CURMES,NOBDIS ARE UPDATED
135613   %
135613   %            NOSKIP:       ERROR  A-REG:  1  NO OUTPUT BUFFER PRESENT
135613   %                                 A-REG:  2  OUTPUT-BUFFER FULL
135613   %
135613   SUBR CRHEEV          
135613   DISP -2; INTEGER AREG,TREG; PSID
135613   CRHEEV: L=:D; CALL SETSTACK(AREG)
135616          CALL STAB(AREG); CALL STTB(TREG)                     
135622          IF BUFFID=0 THEN CALL GETPOOL; GO NOPOL FI          % NO BUFFER
135626          CALL LDTB(TREG)                                     % GET REQUIRED IFIELD SIZE
135630          IF TDBTPT BIT "0" THEN T+3 ELSE T+2 FI              % ODD OR EVEN START IN BUFFER
135636          IF REMSIZ<T THEN A:=2; GO T1BEXI FI                 % NOT ENOUGH SPACE
135643          CALL LDAB(AREG); A SHZ 10; CALL LDTB(TREG)
135650          A+T; CALL WRMHEAD                                   % WRITE MESSAGE HEADER
135652          TDBTPT-1=:NOBDIS; CALL LDAB(AREG); A=:CURMES        % UPDATE MESSAGE INFO
135660          GO T2BEXI                 
135661   NOPOL: A:=1; GO T1BEXI
135663   RBUS
135674   
135674   %=======================================================================
135674   %            C R H E O D                 
135674   %
135674   % ROUTINE LIKE CREMES BUT BYTE COUNTER IS ALSO WRITTEN           
135674   % USED WHEN MESSAGE IS COMPLETED BY CALLING ROUTINE
135674   % MESSAGE HEADER IS CREATED ON ODD BYTE
135674   % 
135674   % ENTRY:     A-REG - MESSAGE TYPE
135674   %            T-REG - REQUIRED I-FIELD SIZE
135674   %            B-REG - TAD OUTPUT DATAFIELD
135674   %
135674   % RETURN:    SKIP-RETURN:  OK     TAD DATAFIELD BUFFER VARIABLES
135674   %                                 REMSIZ,CURMES,NOBDIS ARE UPDATED
135674   %
135674   %            NOSKIP:       ERROR  A-REG:  1  NO OUTPUT BUFFER PRESENT
135674   %                                 A-REG:  2  OUTPUT-BUFFER FULL
135674   %
135674   SUBR CRHEOD          
135674   DISP -2; INTEGER AREG,TREG; PSID
135674   CRHEOD: L=:D; CALL SETSTACK(AREG)
135677          CALL STAB(AREG); CALL STTB(TREG)                     
135703          IF BUFFID=0 THEN CALL GETPOOL; GO NOPOL FI          % NO BUFFER
135707          CALL LDTB(TREG)                                     % GET REQUIRED IFIELD SIZE
135711          IF TDBTPT NBIT "0" THEN T+3 ELSE T+2 FI             % ODD OR EVEN START IN BUFFER
135717          IF REMSIZ<T THEN A:=2; GO T1BEXI FI                 % NOT ENOUGH SPACE
135724          IF TDBTPT NBIT "0" THEN A:=0; CALL STORBYT FI       % EVEN START, CREATE PAD BYTE
135731          CALL LDAB(AREG); CALL STORBYT                       % WRITE MESSAGE TYPE
135734          CALL LDAB(TREG); CALL STORBYT                       % WRITE BYTE COUNTER
135737          TDBTPT-1=:NOBDIS; CALL LDAB(AREG); A=:CURMES        % UPDATE MESSAGE INFO
135745          GO T2BEXI                 
135746   NOPOL: A:=1; GO T1BEXI
135750   RBUS
135761   
135761   %=======================================================================
135761   % XX.XX      G E T M E S
135761   %
135761   % ROUTINE TO FIND NEXT MESSAGE HEADER IN XMSG BUFFER  (TAD INPUT)
135761   % ENTRY:     B-REG - TAD INPUT DATAFIELD
135761   %
135761   % RETURN:    SKIP-RETURN:  OK     A-REG:  MESSAGE-TYPE
135761   %                                 T-REG:  NUMBER OF BYTES IN I-FIELD
135761   %                                 TAD DATAFIELD BUFFER VARIABLES
135761   %                                 REMSIZ,TDBTPT,CURMES,REMBYT ARE UPDATED
135761   %
135761   %            NOSKIP:       ERROR  A-REG:  1  NO INPUT BUFFER 
135761   %                                 A-REG:  2  BUFFER IS EMPTY
135761   %                                 A-REG:  3  INCONSISTENCY, MESSAGE BIGGER THAN BUFFER
135761   SUBR GETMES
135761   GETMES: IF BUFFID=0 THEN A:=1; EXIT FI                     % NO BUFFER
135765   TSTSP:  IF REMSIZ<2 THEN T=:A; EXIT FI
135773           T:=TDTAFI; X:=TDTALA; TDBTPT=:D SHZ -1
136000           X+A; *LDATX
136002           MIN TDBTPT
136003           IF D BIT "0" THEN                                  % ODD BYTE
136005              IF A/\377=0 THEN REMSIZ-1=:REMSIZ; GO TSTSP FI  % FIRST BYTE FOUND
136013              A=:CURMES; X+1; *LDATX
136016              A SHZ -10; MIN TDBTPT; GO RCHK                  % RETURN AND CHECK
136021           FI     
136021           A=:T SHZ -10
136023           IF A=0 THEN
136024              REMSIZ-1=:REMSIZ; GO TSTSP                      % PAD BYTE
136030           FI
136030           A=:CURMES:=T/\377; MIN TDBTPT
136034   RCHK:   IF A>REMSIZ-2 THEN A:=3; EXIT FI                   % INCONSISTENT MESSAGE
136042           A=:T+1-=:REMBYT; X:=REMSIZ-2=:REMSIZ
136051           A:=CURMES; EXITA                                   % MESSAGE FOUND
136053   RBUS
136054   
136054   %========================================================================
136054   %            U P D M B C
136054   %
136054   % ROUTINE TO UPDATE MESSAGE BYTE COUNT
136054   % ENTRY:       A-REG - NUMBER OF BYTES
136054   %              B-REG - TAD OUTPUT DATAFIELD
136054   % SKIP RETURN: OK
136054   % RETURN:      NOT ENOUGH SPACE
136054   SUBR UPDMBC
136054   UPDMBC: A=:D; T:=TDTAFI; X:=TDTALA
136057          IF NOBDIS BIT "0" THEN                    % BYTE COUNT ON ODD BYTE
136062             A SHZ -1; X+A; *LDATX                  % READ BYTE COUNT
136065             A=:T; A/\177400; A:=:T; A/\377
136071             A+D; T=:D; IF A>=400 THEN EXIT FI      % MESSAGE FULL?
136077             A\/D
136100          ELSE                                      % BYTE COUNT ON EVEN BYTE
136101             A SHZ -1; X+A; *LDATX                  % READ BYTE COUNT
136104             A=:T; A/\377; A:=:T; A SHZ -10
136110             A+D; T=:D; IF A>=400 THEN EXIT FI      % MESSAGE FULL?
136116             A SHZ 10; A\/D
136120          FI
136120          T:=TDTAFI; *STATX                         % WRITE BACK BYTE COUNT
136122          EXITA
136123   RBUS
136126   
136126   %=======================================================================
136126   %            G E T M B C
136126   %
136126   % ROUTINE TO FIND NUMBER OF BYTES IN CURRENT OUTPUT MESSAGE
136126   %
136126   % ENTRY:     B-REG - TAD OUTPUT DATAFIELD
136126   % RETURN:    A-REG - BYTE COUNT                                       
136126   SUBR GETMBC
136126   GETMBC: IF NOBDIS=0 THEN A:=400; EXIT FI
136132           A=:D SHZ -1; T:=TDTAFI; X:=TDTALA; X+A; *LDATX
136140           IF D BIT "0" THEN A/\377 ELSE A SHZ -10 FI
136145           EXIT 
136146   RBUS
136150   
136150   %=======================================================================
136150   % XX.XX      B Y T P U T
136150   %
136150   % ROUTINE TO PUT A BYTE IN XMSG BUFFER  (TAD OUTPUT)
136150   %
136150   % ENTRY:     A-REG - BYTE                    
136150   %            B-REG - TAD OUTPUT DATAFIELD
136150   %
136150   % RETURN:    SKIP-RETURN:  OK     TAD DATAFIELD BUFFER VARIABLES
136150   %                                 REMSIZ AND TDBTPT IS UPDATED
136150   %
136150   %            NOSKIP:       ERROR  A-REG:  1  NO OUTPUT BUFFER PRESENT
136150   %                                 A-REG:  2  OUTPUT BUFFER FULL    
136150   %                                 A-REG:  3  MESSAGE FULL
136150   SUBR BYTPUT
136150   DISP -1; INTEGER AREG; PSID
136150   BYTPUT: L=:D; CALL SETSTACK(AREG); A/\377; CALL STAB(AREG)
136156          IF BUFFID=0 THEN A:=1; GO T1BEXI FI          % OUTPUT BUFFER PRESENT?
136162          IF REMSIZ<=0 THEN A:=2; GO T1BEXI FI         % BUFFER FULL?
136167          A:=1; CALL UPDMBC; GO MSFUL                  % UPDATE MESSAGE BYTE COUNT
136172          T:=TDTAFI; X:=TDTALA; TDBTPT=:D SHZ -1; X+A
136200          IF D BIT "0" THEN                            % DESTINATION ODD BYTE
136202             *LDATX
136203             A/\177400; CALL LDTB(AREG); A\/T
136207          ELSE                                         % DESTINATION EVEN BYTE
136210             CALL LDAB(AREG); A SHZ 10
136213          FI
136213          T:=TDTAFI; *STATX                         % PUT BYTE IN BUFFER
136215          REMSIZ-1=:REMSIZ; MIN TDBTPT; GO T2BEXI   % UPDATE BUFFER COUNTERS AND RETURN
136222   MSFUL: A:=3; GO T1BEXI                           % MESSAGE IS FULL
136224   RBUS
136235   
136235   %=======================================================================
136235   % XX.XX      W O R D P U T
136235   %
136235   % ROUTINE TO PUT A WORD IN XMSG BUFFER  (TAD OUTPUT)
136235   %
136235   % ENTRY:     A-REG - WORD                    
136235   %            B-REG - TAD OUTPUT DATAFIELD
136235   %
136235   % RETURN:    SKIP-RETURN:  OK     TAD DATAFIELD BUFFER VARIABLES
136235   %                                 REMSIZ AND TDBTPT IS UPDATED
136235   %
136235   %            NOSKIP:       ERROR  A-REG:  1  NO OUTPUT BUFFER PRESENT
136235   %                                 A-REG:  2  OUTPUT BUFFER FULL    
136235   %                                 A-REG:  3  MESSAGE FULL
136235   SUBR WORDPUT
136235   DISP -1; INTEGER AREG; PSID
136235   WORDPUT: L=:D; CALL SETSTACK(AREG); CALL STAB(AREG)
136242          IF BUFFID=0 THEN A:=1; GO T1BEXI FI          % OUTPUT BUFFER PRESENT?
136246          IF REMSIZ<=1 THEN A:=2; GO T1BEXI FI         % BUFFER FULL?
136254          A:=2; CALL UPDMBC; GO MSFUL                  % UPDATE MESSAGE BYTE COUNT
136257          T:=TDTAFI; X:=TDTALA; TDBTPT=:D SHZ -1; X+A
136265          IF D BIT "0" THEN                            % ODD START IN BUFFER
136267             *LDATX
136270             A/\177400; CALL LDTB(AREG); T:=:A         
136274             A SHZ -10; A\/T; T:=TDTAFI; *STATX        % WRITE FIRST BYTE
136300             CALL LDAB(AREG); A SHZ 10; X+1; *STATX    % WRITE SECOND BYTE
136305          ELSE                                         % EVEN START IN BUFFER
136306             CALL LDAB(AREG); *STATX                   % WRITE WORD IN BUFFER
136311          FI
136311          REMSIZ-2=:REMSIZ; MIN TDBTPT; MIN TDBTPT  % UPDATE BUFFER COUNTERS 
136316          GO T2BEXI                                 % RETURN
136317   MSFUL: A:=3; GO T1BEXI                           % MESSAGE IS FULL
136321   RBUS
136331   
136331   %=======================================================================
136331   % XX.XX      B Y T G E T
136331   %
136331   % ROUTINE TO GET A BYTE IN XMSG BUFFER  (TAD INPUT)
136331   % MUST BE CALLED WITH PAGING INTERUPT OFF!
136331   % ENTRY:     B-REG - TAD INPUT DATAFIELD
136331   %
136331   % RETURN:    SKIP-RETURN:  OK     A-REG:  BYTE
136331   %                                 TAD DATAFIELD BUFFER VARIABLES
136331   %                                 REMSIZ,REMBYT ARE UPDATED
136331   %
136331   %            NOSKIP:       ERROR  A-REG:  0  MESSAGE EMPTY           
136331   %                                 A-REG:  1  NO INPUT BUFFER PRESENT
136331   %                                 A-REG:  2  BUFFER IS EMPTY
136331   SUBR BYTGET
136331   BYTGET:IF BUFFID=0  THEN A:=1; EXIT FI                % NO INPUT BUFFER
136335          IF REMSIZ<=0 THEN A:=2; EXIT FI                % INPUT BUFFER EMPTY
136342          IF REMBYT=0  THEN EXIT FI                      % MESSAGE EMPTY
136345          MIN REMBYT; GO CONT
136347          A:=0=:CURMES; EXIT                             % MESSAGE EMPTY
136352   CONT:  T:=TDTAFI; X:=TDTALA
136354          TDBTPT=:D SHZ -1; X+A; *LDATX                  % GET WORD WITH BYTE
136361          IF D BIT "0" THEN A/\377 ELSE A SHZ -10 FI     % GET WANTED BYTE
136366          T:=REMSIZ-1=:REMSIZ; MIN TDBTPT
136372          EXITA   
136373   RBUS
136374   

136374   
136374   %======================================================================
136374   %      L O A D B Y T
136374   %
136374   % ROUTINE TO LOAD A BYTE FROM THE XMSG BUFFER ACCORDING TO TDBTPT
136374   % TDBTPT IS INCREMEMENTED
136374   % ENTRY:     B-REG  - TAD-DATAFIELD  INPUT OR OUTPUT
136374   % RETURN:    A-REG  - BYTE   (OTHER REGISTERS IS NOT MODIFIED)
136374   SUBR LOADBYT
136374   INTEGER XREG,TREG,DREG
136377   LOADBYT: *IOF
136400          T=:TREG:=D=:DREG; X=:XREG
136404          T:=TDTAFI; X:=TDTALA; TDBTPT=:D SHZ -1; X+A; *LDATX
136413          MIN TDBTPT; IF D BIT "0" THEN A/\377 ELSE A SHZ -10 FI
136421          T:=DREG=:D:=TREG; X:=XREG; *ION; EXIT
136427   RBUS
136430   
136430   %======================================================================
136430   %      S T O R B Y T
136430   %
136430   % ROUTINE TO STORE A BYTE IN THE XMSG BUFFER ACCORDING TO TDBTPT
136430   % TDBTPT AND REMSIZ IS UPDATED
136430   % ENTRY:     B-REG  - TAD-DATAFIELD  INPUT OR OUTPUT
136430   %            A-REG  - BYTE   
136430   % RETURN:    NO REGISTERS MODIFIED          
136430   SUBR STORBYT
136430   INTEGER TREG,AREG,DREG,XREG; TRIPLE TADREG=TREG
136434   STORBYT: *IOF
136435          TAD=:TADREG; X=:XREG
136437          T:=TDTAFI; X:=TDTALA; TDBTPT=:D SHZ -1; X+A
136445          IF D BIT "0" THEN 
136447             *LDATX
136450             A/\177400=:T; AREG\/T; T:=TDTAFI; *STATX
136456          ELSE
136457             AREG SHZ 10; *STATX
136462          FI
136462          MIN TDBTPT; REMSIZ-1=:REMSIZ
136466          TAD:=TADREG; X:=XREG; *ION; EXIT
136472   RBUS
136473   
136473   %=======================================================================
136473   %      T A D   I O T R A N S   R O U T I N E S
136473   %=======================================================================
136473   
136473   % XX.XX      B D P U T
136473   %
136473   % OUTPUT IOTRANS ROUTINE FOR TAD.
136473   % CALLED WITH PAGING INTERUPT OFF
136473   % ENTRY:        A-REG - BYTE
136473   %               B-REG - TAD OUTPUT DATAFIELD
136473   % SKIP RETURN:  OK
136473   % RETURN:       ERROR-CODE IN DERROR
136473   SUBR BDPUT
136473   BDPUT: A=:LAST:=L=:"LRSA"; X=:XRSA; 0=:TMR
136500          CALL MLVLOC; CALL BRSTACK         
136502          IF DFOPP.PORTNO=0 THEN MIN "LRSA"; GO RETU; FI      % NOT CONNECTED
136507          IF 7BDAT><CURMES THEN
136513   CRMES:    T:=3; CALL CREMES; GO ERR
136516          FI
136516          LAST; CALL BYTPUT; GO ERR
136521          MIN "LRSA" GO RETU                                  % SKIP RETURN OK
136523   
136523   ERR:   IF A<0 GO CNXE                                      % ERROR FROM XMSG
136524          IF A=1 GO RETU                                      % WAIT FOR BUFFER
136527          IF A=2 THEN                                         % BUFFER FULL
136532             CALL SNDBUF; GO CNXE 
136534             IF BUFFID><0 THEN 7BDAT; GO CRMES FI
136540             GO RETU
136541          FI
136541          IF A=3 THEN 7BDAT; GO CRMES; FI                     % MESSAGE FULL         
136546          GO RETU
136547   CNXE:  CALL CNVERR                                         % CONVERT ERROR-CODE
136550   EROUT: A=:DERROR; X:=XRSA; CALL MLVULOC; GO LRSA           
136554   RETU:  TTMR=:TMR; X:=XRSA; LAST; CALL MLVULOC; GO LRSA
136562   RBUS
136571   
136571   %=======================================================================
136571   % XX.XX      B D G E T
136571   %
136571   % INPUT IOTRANS ROUTINE FOR TAD.
136571   % CALLED WITH PAGING INTERUPT OFF
136571   % ENTRY:        B-REG - TAD INPUT DATAFIELD
136571   % SKIP RETURN:  OK
136571   %               A-REG - BYTE
136571   % RETURN:       ERROR-CODE IN DERROR
136571   SUBR BDGET
136571   BDGET: A:=L=:"LRSA"; X=:XRSA; CALL MLVLOC        
136575          CALL BRSTACK; CALL IEDCHK; GO EROUT       % INPUT WHILE DELAYED ESCAPE
136600          IF PORTNO=0 THEN A:=TER02; GO EROUT; FI   % NOT CONNECTED
136604   BYGET: IF CURMES=7BDAT THEN
136610             CALL BYTGET; GO ERR; A=:LAST; MIN "LRSA"; GO RETU
136615          FI
136615   NXMES: CALL GETMES; GO ERR
136617          IF A=X:=7BDAT THEN
136622             IF T=0 THEN GO NXMES ELSE GO BYGET FI
136626          ELSE
136627             CALL CTRMES; GO CNXE; GO BYGET
136632          FI
136632          GO RETU
136633   
136633   ERR:   IF A<0 GO CNXE                                      % XMSG ERROR CODE
136634          IF A=0 GO NXMES                                     % DATA MESSAGE EMPTY
136635          IF A=1 OR A=2 THEN CALL SNDRFI; GO CNXE; GO RETU;FI % BUFFER EMPTY, SEND RFI
136646          IF A=3 THEN                                         % INCONSISTENT MESSAGE
136651             CALL SNDREJ; GO CNXE; A:=TER01; GO EROUT         % MESSAGE REJECTED
136655          FI
136655          GO RETU
136656   CNXE:  CALL CNVERR  
136657   EROUT: A=:DERROR
136660   RETU:  X:=XRSA; CALL MLVULOC; GO LRSA
136663   RBUS
136677   
136677   %=====================================================================
136677   % XX.XX      B M 8 O U T   B B 8 O U T   B D T C H   
136677   %
136677   % BM8OUT (MON 22):
136677   %    MONITOR CALL TO WRITE UP TO 8 BYTES ON A TAD (0 BYTE TERMINATES)
136677   % BB8OUT (MON 24):
136677   %    MONITOR CALL TO WRITE 8 BYTES ON A TAD
136677   %
136677   % CALLED WITH PAGING INTERUPT OFF WITH B = OUTPUT-DATAFIELD
136677   
136677   SUBR BM8OUT,BB8OUT,BDTCH
136677   
136677   % ROUTINE TO CHECK FOR TERMINATION IN DATA
136677   BDTCH:  A=:D                  
136700           IF X:=XRSA=0 THEN
136703             A SHZ -10; IF A=0 THEN EXIT FI      % FIRST BYTE EMPTY
136706             D=:A; A/\377
136710             IF A=0 THEN A:=D SHZ -10; EXITA FI  % LAST BYTE EMPTY
136714           FI
136714           D=:A; L+1; EXITA
136717   
136717   BM8OUT: 0=:XRSA; GO FELLS
136721   BB8OUT: 1=:XRSA
136723   FELLS: IF DFOPP.PORTNO=0 GO MOURET               % NOT CONNECTED
136727          0=:TMR; CALL BRSTACK                      % RESET TAD STACK
136731          IF 7BDAT><CURMES THEN                     % CURRENT NOT DATA-MESS
136735   CRMES:    T:=10; CALL CREMES; GO ERR             % RESERVE 10 BYTES
136740          ELSE
136741             IF REMSIZ<12 THEN A:=2; GO ERR FI      % NOT ENOUGH SPACE IN BUFFER
136747             CALL GETMBC                            % GET BYTE COUNT IN CURMES
136750             IF A+10>377 THEN 7BDAT; GO CRMES FI    % NOT ENOUGH SPACE IN MESSAGE
136756          FI
136756   
136756   % ENOUGH SPACE IN BUFFER
136756   
136756          *IRR ALEVB DA
136757          CALL BDTCH; GO OKRET; GO LASBY; CALL WORDPUT; GO ERR; *IRR ALEVB DD
136765          CALL BDTCH; GO OKRET; GO LASBY; CALL WORDPUT; GO ERR; *IRR ALEVB DL
136773          CALL BDTCH; GO OKRET; GO LASBY; CALL WORDPUT; GO ERR; *IRR ALEVB DX
137001          CALL BDTCH; GO OKRET; GO LASBY; CALL WORDPUT; GO ERR    
137006   
137006   % NORMAL RETURN, BYTES STORED IN BUFFER
137006   OKRET: TTMR=:TMR; GO MOURET
137011   
137011   % ONE BYTE LEFT TO WRITE IN BUFFER
137011   LASBY: CALL BYTPUT; GO ERR; GO OKRET
137014   
137014   % ERRORS FROM CREMES
137014   ERR:   IF A=1 GO RETU                            % WAIT FOR BUFFER
137017          IF A=2 THEN                               % BUFFER FULL
137022             CALL SNDBUF; GO CNXE
137024             IF BUFFID><0 THEN 7BDAT; GO CRMES FI   % NEW BUFFER
137030             GO RETU                                % WAIT FOR BUFFER
137031          FI
137031          GO RETU
137032   
137032   CNXE: CALL CNVERR; A=:DERROR
137034   RETU: TTMR=:TMR; GO WDX
137037   
137037   RBUS
137052   
137052   %=======================================================================
137052   % XX.XX      B B 4 I N W
137052   %
137052   % MON 63: MONITOR CALL ALWAYS RETURNS 8 BYTES FROM A TAD
137052   % CALLED WITH PAGING INTERUPT OFF WITH B = INPUT DATAFIELD
137052   
137052   SUBR BB4INW
137052   BB4INW: CALL BRSTACK; CALL IEDCHK; GO EROUT       % INPUT WHILE DELAYED ESCAPE
137055          IF PORTNO=0 THEN A:=TER02; GO EROUT FI    % NOT CONNECTED
137061   POSDA: IF CURMES><7BDAT THEN                     % NOT DATA MESSAGE
137065   NXMES:    CALL GETMES; GO ERR                    % GET NEW MESSAGE
137067             IF A><X:=7BDAT THEN                    % CONTROLL MESSAGE
137072                CALL CTRMES; GO CNXE; GO POSDA      % PERFORM CONTROLL
137075             FI   
137075          FI
137075          IF REMBYT=0 OR A=-1 GO NXMES              % CURRENT MESSAGE EMPTY
137102   
137102   % DATA-MESSAGE WITH AT LEAST ONE BYTE
137102   
137102          DBCOU GOSW BYT1,BYT2,BYT3,BYT4,BYT5,BYT6,BYT7,BYT8
137114   
137114   BYT1:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DA
137121          MIN DBCOU
137122   BYT2:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DA
137126          A\/LAST; *IRW ALEVB DA
137130          MIN DBCOU
137131   BYT3:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DD
137136          MIN DBCOU
137137   BYT4:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DD
137143          A\/LAST; *IRW ALEVB DD
137145          MIN DBCOU
137146   BYT5:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DL
137153          MIN DBCOU
137154   BYT6:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DL
137160          A\/LAST; *IRW ALEVB DL
137162          MIN DBCOU
137163   BYT7:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DX
137170          MIN DBCOU
137171   BYT8:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DX
137175          A\/LAST; *IRW ALEVB DX
137177   
137177   % ALL CHARACTERS COLLECTED, RETURN TO USER
137177          0=:DBCOU; A:=10; *IRW ALEVB DT
137202          GO MOURET
137203   
137203   % DETERMINE ACTION ON ERRORS
137203   ERR:   IF A<0 GO CNXE                            % XMSG ERROR
137204          IF A=0 GO NXMES                           % MESSAGE EMPTY
137205          IF A=1 OR A=2 THEN 
137213             CALL SNDRFI; GO CNXE; GO RETU          % BUFFER EMPTY, SEND RFI
137216          FI
137216          IF A=3 THEN
137221             CALL SNDREJ; GO CNXE; A:=TER01; GO EROUT         % MESSAGE REJECTED
137225          FI
137225          GO RETU
137226   
137226   CNXE:  CALL CNVERR
137227   EROUT: A=:DERROR; 0=:DBCOU
137231   RETU:  GO WDX
137232   RBUS
137246   
137246   %=======================================================================
137246   % XX.XX      B B 8 I N P
137246   %
137246   % MON 310: MONITOR CALL RETURNS UP TO 8 BYTES FROM A TAD.
137246   % NUMBER OF BYTES READ IS RETURNED IN T-REG. WHEN LAST
137246   % CHARACTER IS READ FROM BUFFER T BIT 17 IS SET TO INDICATE
137246   % BREAK CHARACTER.
137246   % CALLED WITH PAGING INTERUPT OFF WITH B = INPUT DATAFIELD
137246   
137246   SUBR BB8INP
137246   BB8INP: CALL BRSTACK; CALL IEDCHK; GO EROUT       % INPUT WHILE DELAYED ESCAPE
137251          IF PORTNO=0 THEN A:=TER02; GO EROUT FI    % NOT CONNECTED
137255          0=:DBCOU                                  % ZERO CHARACTER COUNT
137256   POSDA: IF CURMES><7BDAT THEN                     % NOT DATA MESSAGE
137262   NXMES:    CALL GETMES; GO ERR                    % GET NEW MESSAGE
137264             IF A><X:=7BDAT THEN                    % CONTROLL MESSAGE
137267                CALL CTRMES; GO CNXE; GO POSDA      % PERFORM CONTROLL
137272             FI   
137272          FI
137272          IF REMBYT=0 OR A=-1 GO NXMES              % CURRENT MESSAGE EMPTY
137277   
137277   % DATA-MESSAGE WITH AT LEAST ONE BYTE
137277   
137277   BYT1:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DA
137304          MIN DBCOU
137305   BYT2:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DA
137311          A\/LAST; *IRW ALEVB DA
137313          MIN DBCOU
137314   BYT3:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DD
137321          MIN DBCOU
137322   BYT4:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DD
137326          A\/LAST; *IRW ALEVB DD
137330          MIN DBCOU
137331   BYT5:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DL
137336          MIN DBCOU
137337   BYT6:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DL
137343          A\/LAST; *IRW ALEVB DL
137345          MIN DBCOU
137346   BYT7:  CALL BYTGET; GO ERR; A=:LAST SHZ 10; *IRW ALEVB DX
137353          MIN DBCOU
137354   BYT8:  CALL BYTGET; GO ERR; A=:LAST; *IRR ALEVB DX
137360          A\/LAST; *IRW ALEVB DX
137362          MIN DBCOU
137363          IF REMBYT=-1 THEN DBCOU BONE 17=:DBCOU FI % LAST CHARACTER, BREAK
137372   
137372   % ALL CHARACTERS COLLECTED, RETURN TO USER
137372   OKRET: A:=DBCOU; 0=:DBCOU; *IRW ALEVB DT
137375          GO MOURET
137376   
137376   % DETERMINE ACTION ON ERRORS
137376   ERR:   IF A<0 GO CNXE                            % XMSG ERROR
137377          IF A=0 GO NXMES                           % MESSAGE EMPTY
137400          IF A=1 OR A=2 THEN 
137406             IF DBCOU><0 THEN                       % CHARACTERS TO RETURN
137410                A BONE 17=:DBCOU; GO OKRET          % MARK FOR BREAK
137413             ELSE
137414                CALL SNDRFI; GO CNXE; GO RETU       % BUFFER EMPTY, SEND RFI
137417             FI
137417          FI
137417          IF A=3 THEN
137422             CALL SNDREJ; GO CNXE; A:=TER01; GO EROUT         % MESSAGE REJECTED
137426          FI
137426          GO RETU
137427   
137427   CNXE:  CALL CNVERR
137430   EROUT: A=:DERROR; 0=:DBCOU
137432   RETU:  GO WDX
137433   RBUS
137447   
137447   
137447   %==============================================================================
137447   %      C N V E R R
137447   %
137447   %      SUBROUTINE TO CONVERT FROM XMSG ERROR
137447   %      TO STANDARD ERROR CODE.
137447   SUBR CNVERR
137447   CNVERR: A-\/XKXXX; EXIT                             
137452   RBUS
137453   

137453   %=========================================================================
137453   %  B U F F E R   C O N T R O L L   R O U T I N E S   F O R   B A D
137453   %=========================================================================
137453   
137453   % XX.XX      P U T P O O L
137453   %
137453   % ROUTINE TO PUT A BUFFER IN FREE POOL OF OUTPUT DATAFIELD
137453   % THE ROUTINE EXECUTES IN IOF TO AVOID DOUBLE ACCESSES TO THE POOL
137453   % ENTRY:    AD-REG - BUFFER-ADDRESS
137453   %            X-REG - BUFFER ID
137453   %            B-REG - TAD OUTPUT DATAFIELD
137453   SUBR PUTPOOL
137453   INTEGER XREG     
137454   PUTPOOL: *IOF    
137455          IF X=0 GO RETU; X=:XREG                   % DUMMY CALL
137457          A=:T; D=:X; AD:=POOLLI; *STDTX            % PUT OLD POOLLI IN NEW BUFFER
137463          X+2; A:=XREG; *STATX                      % PUT BUFFID IN NEW BUFFER
137466          T=:A; X-2=:D; AD=:POOLLI                  % PUT NEW BUFFER IN POOLLI
137472   RETU:  *ION; EXIT
137474   RBUS
137474   
137474   %=========================================================================
137474   % XX.XX      G E T P O O L
137474   %
137474   % ROUTINE TO GET A BUFFER FROM FREE-POOL
137474   % THE ROUTINE EXECUTES IN IOF TO AVOID DOUBLE ACCESSES TO THE POOL
137474   % ENTRY:       B-REG - TAD OUTPUT DATAFIELD
137474   % SKIP RETURN: OK
137474   %              FOLLOWING VARIABLES IN OUTPUT DATAFIELD IS MODIFIED:
137474   %              BUFFID 
137474   %              TDTADD              
137474   %              TDBTPT                   
137474   %              REMSIZ
137474   %
137474   % RETURN:      ERROR   A-REG < 0 XMSG ERROR , ELSE POOL EMPTY
137474   
137474   SUBR GETPOOL
137474   GETPOOL: *IOF
137475          POOLLI; IF A=0 AND D=0 GO NOPOL           % POOL EMPTY
137501          A=:T; D=:X; *LDDTX                        % GET NEXT IN CHAIN
137504          AD=:POOLLI                                % UPDATE POOL POINTER
137505          T=:A; X=:D; AD=:TDTADD; X+2; *LDATX       % SAVE ADDRESS AND GET BUFFID
137512          A=:BUFFID; BUDIS=:TDBTPT                  % SET BUFFID AND BYTE POINTER
137515          DFOPP.FBSIZ-BUDIS=:REMSIZ                 % SET REMAINING SIZE
137521          *ION; EXIT AD1
137523   NOPOL: AD=:TDTADD; 0=:BUFFID=:REMSIZ=:TDBTPT; *ION; EXIT
137531   RBUS
137531   
137531   %=========================================================================
137531   % XX.XX      M O V I T O
137531   %
137531   % ROUTINE TO RELOCATE INPUT BUFFER AS OUTPUT BUFFER
137531   % CALLED WITH PAGING OFF
137531   % ENTRY:       B-REG - OUTPUT-DATAFIELD
137531   SUBR MOVITO
137531   MOVITO: DFOPP.BUFFID=:BUFFID; X.TDTADD=:TDTADD
137536           X.FBSIZ-BUDIS=:REMSIZ; BUDIS=:TDBTPT; 0=:CURMES
137544           A:=0=:D; AD=:X.TDTADD
137547           0=:X.BUFFID=:X.REMBYT=:X.TDBTPT=:X.REMSIZ=:X.CURMES
137554           EXIT
137555   RBUS
137555   
137555   %=========================================================================
137555   % XX.XX      C L I D A T
137555   % 
137555   % ROUTINE TO REPLACE DATA MESSAGES IN INPUT BUFFER WITH DUMMY
137555   % ENTRY        B-REG - INPUT DATAFIELD
137555   % SKIP RETURN: OK      A-REG = 0  BUFFER IS EMPTY
137555   %                      A-REG = 1  CONTROLL MESSAGES LEFT IN BUFFER
137555   % RETURN:      ERROR   A-REG - XMSG ERROR CODE
137555   SUBR CLIDAT
137555   DISP -3; INTEGER CTRBUF,BUFBP,BREMAI; PSID
137555   CLIDAT: L=:D; CALL SETSTACK(CTRBUF); A:=0; CALL STAB(CTRBUF)
137563          IF BUFFID=0 OR REMSIZ=0 GO OKOUT
137570          REMSIZ; CALL STAB(BREMAI); TDBTPT; CALL STAB(BUFBP)
137576          IF CURMES=7BDAT THEN
137602             T:=REMBYT-; T-1; TDBTPT+T=:TDBTPT; CALL STAB(BUFBP)
137612             REMSIZ-T=:REMSIZ; CALL STAB(BREMAI)              
137617          FI
137617          DO WHILE REMSIZ>0
137622             CALL GETMES; GO ECHECK; T=:D     
137625             IF CURMES=7BDAT THEN 
137631                T:=TDTAFI; X:=TDTALA; TDBTPT-2=:L SHZ -1; X+A; *LDATX
137641                IF L BIT "0" THEN 
137643                   T:=7DUMM; A/\177400\/T
137646                ELSE
137647                   T:=7DUMM SHZ 10; A/\377\/T
137653                FI
137653                T:=TDTAFI; *STATX
137655             ELSE
137656                A:=1; CALL STAB(CTRBUF)
137661             FI
137661             TDBTPT+D=:TDBTPT
137664          OD
137665   EOUT:  CALL LDAB(BUFBP); A=:TDBTPT
137670          0=:CURMES=:REMBYT; CALL LDAB(BREMAI); A=:REMSIZ
137675   OKOUT: CALL LDAB(CTRBUF); GO T2BEXI
137700   
137700   ECHECK: IF A<0 GO T1BEXI                         % XMSG ERROR CODE
137702          IF A=3 THEN A:=TER01; GO T1BEXI FI        % MESSAGE ERROR
137707          GO EOUT
137710   RBUS
137721   
137721   %=========================================================================
137721   % XX.XX      C L O D A T
137721   % 
137721   % ROUTINE TO REPLACE DATA MESSAGES IN OUTPUT BUFFER WITH DUMMY
137721   % ENTRY        B-REG - OUTPUT DATAFIELD
137721   % SKIP RETURN: OK      A-REG = 0  BUFFER IS EMPTY
137721   %                      A-REG = 1  CONTROLL MESSAGES IN BUFFER
137721   % RETURN:      ERROR   A-REG - XMSG ERROR CODE
137721   SUBR CLODAT
137721   DISP -3; INTEGER CTRBUF,BUFBP,AUXBP; PSID
137721   CLODAT: L=:D; CALL SETSTACK(CTRBUF); A:=0; CALL STAB(CTRBUF)
137727          IF BUFFID=0 OR REMSIZ=DFOPP.FBSIZ-BUDIS GO OKOUT
137737          TDBTPT=:D; CALL STAB(BUFBP); BUDIS=:TDBTPT
137745   NXTBY: DO WHILE TDBTPT<D      
137750             CALL LOADBYT; IF A=0 GO NXTBY; A=:CURMES; CALL LOADBYT; A=:X
137755             IF CURMES=7BDAT THEN
137761                TDBTPT-1=:TDBTPT; A:=7DUMM; CALL STORBYT
137766             ELSE
137767                1=:CTRBUF
137771             FI
137771             TDBTPT+X=:TDBTPT            
137774          OD
137775          CALL LDAB(BUFBP); A=:TDBTPT                   
140000   OKOUT: 0=:CURMES=:NOBDIS; CALL LDAB(CTRBUF); GO T2BEXI
140005   RETU:  GO T1BEXI
140006   RBUS
140015   
140015   %=========================================================================
140015   % XX.XX      S N D B U F
140015   %
140015   % ROUTINE TO SEND OUTPUT BUFFER    
140015   % ENTRY:     B-REG - TAD OUTPUT DATAFIELD
140015   SUBR SNDBUF
140015   SNDBUF: L=:D; CALL SETSTACK(0)
140020          IF BUFFID><0 THEN
140022             IF REMSIZ><DFOPP.FBSIZ-4 THEN
140030                1=:DRFUNC; CALL STDEV               % SEND BUFFER
140033             FI
140033          FI
140033          GO T2BEXI 
140034   RBUS
140036   
140036   
140036   

140036   %=========================================================================
140036   %      M E S S A G E   G E N E R A T I N G   R O U T I N E S
140036   %
140036   % XX.XX      S N D R F I
140036   %
140036   % ROUTINE TO GENERATE AND SEND RFI-MESSAGE. 
140036   % CALLED FROM ALL INPUT CALLS WHEN INPUT BUFFER IS EMPTY.
140036   
140036   % ENTRY:          B-REG - TAD INPUT DATAFIELD
140036   % SKIP RETURN:    OK
140036   % RETURN:         A-REG - XMSG ERROR CODE
140036   SUBR SNDRFI
140036   SNDRFI: L=:D; CALL SETSTACK(0); B=:X; DFOPP=:B
140044          IF X.ISTATE<0 THEN                        % NOWAIT MODE
140046             IF X.DFLAG BIT 5RQI GO NOSND           % RFI ALREADY SENT
140051          FI
140051          IF BUFFID=0 AND DFOPP.BUFFID><0 GO USINP  % OUTPUT BUFFER PRESENT?
140056          A:=7RFI; T:=0; CALL CREMES; GO NOSPA      % GENERATE MESSAGE
140062          GO SBUFF
140063   
140063   NOSPA: IF A<0 GO RETU                            % XMSG ERROR
140064          IF A=1 GO NOPOL                           % NO BUFFERS IN POOL
140067          CALL SNDBUF; GO RETU                      % OUTPUT BUFFER FULL, SEND
140071          IF BUFFID=0 GO USINP                      % NO BUFFER, USE INPUT
140073          A:=7RFI; T:=0; CALL CREMES; GO RETU       % GENERATE MESSAGE
140077   
140077   SBUFF: CALL SNDBUF; GO RETU                      % SEND BUFFER
140101          DFOPP.DFLAG BONE 5RQI=:X.DFLAG            % MARK RFI SENT IN INPUT-DATAFIELD
140105   NOSND: IF DFOPP.BUFFID><0 THEN
140110             0=:X.BUFFID=:X.REMSIZ=:X.CURMES=:X.REMBYT
140114             A=:T; AD:=X.TDTADD; T=:X; CALL PUTPOOL % RETURN INPUT BUFFER TO POOL
140120          FI
140120   OKRET: DFOPP=:B; GO T2BEXI                       % OK RETURN
140123   
140123   USINP: IF DFOPP.BUFFID=0 GO NOPOL                % POOL IS EMPTY
140126          CALL MOVITO                               % MOVE INP. BUFF. TO OUTPUT
140127          A:=7RFI; T:=0; CALL CREMES; GO RETU       % GENERATE MESSAGE
140133          CALL SNDBUF; GO RETU                      % SEND MESSAGE
140135          DFOPP.DFLAG BONE 5RQI=:X.DFLAG            % MARK RFI SENT IN INPUT-DATAFIELD
140141          GO OKRET                                  % OK RETURN
140142   RETU:  X:=DFOPP=:B; GO T1BEXI 
140145   
140145   NOPOL: DFOPP.DFLAG BZERO 5RQI BONE 5WRQI=:X.DFLAG
140152          GO OKRET                                  % DRIVER SENDS RFI WHEN BUFFER AVAILABLE
140153   RBUS
140162   
140162   %===========================================================================
140162   % XX.XX      S N D R E J
140162   %
140162   % ROUTINE TO GENERATE AND SEND REJECT-MESSAGE. 
140162   % IF REJECTED MESSAGE IS DATA, RFI-MESSAGE
140162   % IS ALSO SENDT.
140162   
140162   % ENTRY:          B-REG - TAD INPUT DATAFIELD
140162   % SKIP RETURN:    OK
140162   % RETURN:         A-REG - XMSG ERROR CODE
140162   SUBR SNDREJ
140162   SNDREJ: L=:D; CALL SETSTACK(0); A:=DFOPP=:B
140167          IF BUFFID=0 AND DFOPP.BUFFID><0 GO USINP     % OUTPUT BUFFER PRESENT?
140174          IF DFOPP.CURMES=7BDAT THEN T:=3 ELSE T:=1 FI % INCLUDING RFI?
140204          A:=7REJE; CALL CREMES; GO NOSPA              % GENERATE REJECT
140207          DFOPP.CURMES; CALL BYTPUT; GO RETU           %  
140213          A:=7RFI; T:=0; CALL CREMES; GO RETU          % GENERATE RFI
140217          GO SBUFF
140220   
140220   NOSPA: IF A<0 GO RETU                            % XMSG ERROR
140221          CALL SNDBUF; GO RETU                      % OUTPUT BUFFER FULL, SEND
140223          IF BUFFID=0 GO USINP                      % NO BUFFER, USE INPUT
140225          A:=7REJE; T:=1; CALL CREMES; GO RETU      % GENERATE REJECT
140231          DFOPP.CURMES; CALL BYTPUT; GO RETU       
140235          IF DFOPP.CURMES=7BDAT THEN
140242             A:=7RFI; T:=0; CALL CREMES; GO RETU    % GENERATE RFI
140246          FI
140246   
140246   SBUFF: CALL SNDBUF; GO RETU                      % SEND BUFFER
140250          IF DFOPP.BUFFID><0 THEN
140253             0=:X.BUFFID=:X.REMSIZ=:X.CURMES=:X.REMBYT
140257             A=:T; AD:=X.TDTADD; T=:X; CALL PUTPOOL % RETURN INPUT BUFFER TO POOL
140263          FI
140263   OKRET: DFOPP=:B; GO T2BEXI                       % OK RETURN
140266   
140266   USINP: IF DFOPP.BUFFID=0 THEN                    % NO BUFFERS AVAILABLE
140271             IF X.CURMES=7BDAT THEN
140275                X.DFLAG BONE 5WRQI=:X.DFLAG         % RFI MUST BE SENT BY DRIVER
140300             FI   
140300             GO OKRET                               % REJECT IS NOT POSSIBLE
140301          FI
140301          CALL MOVITO                               % MOVE INP. BUFF. TO OUTPUT
140302          A:=7REJE; T:=1; CALL CREMES; GO RETU      % GENERATE REJECT
140306          DFOPP.CURMES; CALL BYTPUT; GO RETU
140312          IF DFOPP.CURMES=7BDAT THEN
140317             A:=7RFI; T:=0; CALL CREMES; GO RETU    % GENERATE RFI
140323          FI
140323          CALL SNDBUF; GO RETU                      % SEND BUFFER
140325          GO OKRET                                  % OK RETURN
140326   
140326   RETU: X:=DFOPP=:B; GO T1BEXI
140331   RBUS
140342   
140342   %=====================================================================
140342   %            C B R E C T A
140342   %
140342   % ROUTINE TO COPY BREAK AND ECHO TABLES
140342   % ENTRY:    AD-REG  - SOURCE ADDRESS 
140342   %           B-REG   - TAD OUTPUT DATAFIELD
140342   % RETURN:   EXIT    TDBTPT, REMSIZ IS UPDATED
140342   %
140342   SUBR CBRECTA
140342   CBRECTA: D=:X:=L; CALL SETSTACK(0); X=:D; A=:L
140350          TDBTPT SHZ -1+TDTALA
140353          A=:OBCOU
140354          FOR X:=0 TO 7 DO; X=:XRSA
140361             L=:T; D=:X; *LDATX
140364             D+1; T:=TDTAFI; X:=OBCOU; *STATX
140370             MIN OBCOU
140371          X:=XRSA; OD
140374          TDBTPT+20=:TDBTPT; REMSIZ-20=:REMSIZ
140402          GO T1BEXI
140403   RBUS
140405   
140405   %=====================================================================
140405   % XX.XX      B D E C H O
140405   %
140405   % ROUTINE TO SEND ECHO-MESSAGE
140405   % ENTRY:       A-REG = ECHO STRATEGY
140405   %              X-REG = TAD INPUT DATAFIELD
140405   SUBR BDECHO
140405   DISP -3; INTEGER AREG,BREG,MSSIZ; PSID
140405   BDECHO: A=:T; B=:A:=X; L=:D; CALL SETSTACK(AREG);
140413           CALL STAB(BREG); CALL STTB(AREG); DFOPP=:B
140421          IF T=X:=7 THEN T:=21 ELSE T:=1 FI; CALL STTB(MSSIZ)
140431          IF BUFFID=0 THEN
140433             CALL GETPOOL; GO NYTRY
140435          ELSE
140436             IF REMSIZ<T+3 THEN
140442                CALL SNDBUF; GO NYTRY
140444                IF BUFFID=0 GO NYTRY
140446             FI
140446          FI
140446          A:=7ECKM; CALL LDTB(MSSIZ); CALL CRHEOD; GO RETU    % CREATE MESSAGE HEADER
140453          CALL LDAB(AREG); A=:D; CALL STORBYT                 % WRITE ECHO TYPE
140457          IF D=7 THEN                                         % COPY ECHO TABLE
140462             DFOPP+"PECH7"=:D:=0; CALL CBRECTA
140467          FI
140467   RETU:  DFOPP=:X; CALL LDAB(BREG); A=:B; GO T1XEXI 
140475   
140475   NYTRY: DFOPP=:B; RTREF=:X; CALL LDAB(BREG); A=:D; GO REDOM
140505   RBUS
140523   
140523   %=====================================================================
140523   % XX.XX      B D B R E A
140523   %
140523   % ROUTINE TO SEND BREAK-MESSAGE.
140523   % ENTRY:       A-REG = BREAK STRATEGY
140523   %              X-REG = TAD INPUT DATAFIELD
140523   SUBR BDBREA
140523   DISP -4; INTEGER AREG,BREG,MSSIZ,BRSTR; PSID                            
140523   BDBREA: A=:T; B=:A:=X; L=:D; CALL SETSTACK(AREG)  
140531          CALL STAB(BREG); CALL STTB(AREG)
140535          IF T>X:=7 THEN T:=7 FI; CALL STTB(BRSTR)                        
140543          IF T=X:=7 THEN T:=23 ELSE T:=3 FI; CALL STTB(MSSIZ); DFOPP=:B
140555          IF BUFFID=0 THEN
140557             CALL GETPOOL; GO NYTRY
140561          ELSE
140562             IF REMSIZ<T+3 THEN
140566                CALL SNDBUF; GO NYTRY
140570                IF BUFFID=0 GO NYTRY
140572             FI
140572          FI
140572          A:=7BMMX; CALL LDTB(MSSIZ); CALL CRHEOD; GO RETU    % CREATE MESSAGE HEADER
140577          CALL LDAB(BRSTR); A=:D; CALL STORBYT                % WRITE BREAK TYPE
140603          TDBTPT SHZ-1; T:=TDTALA+A; DFOPP.BRKMAX
140611          T=:X:=TDTAFI; *STATX                                % WRITE MAXBREAK
140614          TDBTPT+2=:TDBTPT; REMSIZ-2=:REMSIZ                   
140622          IF D=7 THEN
140625             CALL LDAB(AREG)
140627             IF A=11 THEN DFOPP.BRKTAB ELSE DFOPP+"PBRK7" FI
140637             A=:D:=0; CALL CBRECTA
140642          FI
140642   RETU:  DFOPP=:X; CALL LDAB(BREG); A=:B; GO T1XEXI
140650   
140650   NYTRY: DFOPP=:B; RTREF=:X; CALL LDAB(BREG); A=:D; GO REDOM
140660   RBUS
140676   
140676   %=======================================================================
140676   % XX.XX      N W S T A
140676   %
140676   % ROUTINE TO SEND NOWAIT STATUS, CALLED WITH PAGING INTERUPT OFF
140676   % ENTRY:      A = NOWAIT STATUS
140676   %             X = TAD INPUT-DATAFIELD
140676   SUBR NWSTA
140676   DISP -2; INTEGER BREG,NWS; PSID
140676   NWSTA: A=:D; IF X.PORTNO=0 THEN EXITA FI; D=:A             % NOT CONNECTED
140703          L=:D; X:=:B; CALL MLVLOC; CALL BRSTACK
140707          CALL SETSTACK(BREG); CALL STXB(BREG); CALL STAB(NWS)
140715   NXBFF: IF A=0 THEN A:=7NOWT ELSE A:=7TNOW FI               % DETERMINE NOWT TYPE
140721          T:=DFOPP=:B; T:=1; CALL CRHEEV; GO ECHK             % CREATE MESSAGE
140726          CALL LDAB(NWS); CALL STORBYT                        % WRITE STATUS
140731          CALL SNDBUF; 0/\0; GO RETUO                         % SEND MESSAGE
140734   
140734   ECHK:  IF A=1 THEN                                         % NO BUFFER
140737             DFOPP=:B; RTREF=:X; CALL LDAB(BREG); A=:D
140746             CALL MLVULOC; GO REDOM                           % TRY LATER
140750          FI
140750          IF A=2 THEN                                         % NOT ENOUGH SPACE
140753             CALL SNDBUF; GO RETUO; DFOPP=:B
140757             CALL LDAB(NWS); GO NXBFF                         % NEXT BUFFER
140762          FI
140762   RETUO: DFOPP=:B
140764   RETUI: B=:X; CALL LDAB(BREG); A=:B; CALL MLVULOC; GO T2XEXI
140772   RBUS
141007   
141007   %=======================================================================
141007   % XX.XX      S N D C P
141007   %
141007   % ROUTINE TO SEND COMPLETION CODE CALLED FROM BSCPC               
141007   % ENTRY:     AD= COMPLETION CODE
141007   %            B = TAD INPUT DATAFIELD
141007   % RETURN:    EXIT, NO ERRORS RAPPORTED
141007   
141007   SUBR SNDCP
141007   DISP -3; INTEGER BREG,CPC1,CPC2; PSID
141007   SNDCP: D=:T:=L; CALL SETSTACK(BREG)
141013          CALL STXB(BREG); CALL STAB(CPC1); CALL STTB(CPC2)
141021          DFOPP=:B                                  % B-REG - OUTPUT-DATAFIELD
141023   NXBUF: 7CPCO; T:=5; CALL CRHEEV; GO ECHEC        % CREATE MESSAGE
141027          TDBTPT SHZ -1; T:=TDTAFI; X:=TDTALA+A
141034          CALL LDAB(CPC1); *STATX
141037          X+1; CALL LDAB(CPC2); *STATX
141043          TDBTPT+4=:TDBTPT; REMSIZ-4=:REMSIZ
141051          CALL SNDBUF; 0/\0
141053   RETU:  DFOPP=:B; CALL LDXB(BREG); GO T1BEXI
141060   ECHEC: IF A=2 THEN CALL SNDBUF; 0/\0; GO NXBUF FI; GO RETU
141067   RBUS
141101   
141101   %=======================================================================
141101   % XX.XX      C T R M E S
141101   %
141101   % ROUTINE TO TAKE ACTION ON CONTROLL-MESSAGES
141101   % ENTRY:       B = INPUT DATAFIELD
141101   % SKIP-RETURN: OK
141101   % RETURN:      ERROR A = XMSG ERROR CODE
141101   SUBR CTRMES
141101   CTRMES: L=:D; CALL SETSTACK(0)
141104          IF CURMES=0 THEN
141106   NXMES:    CALL GETMES; GO ECHECK
141110          FI
141110          IF CURMES=7BDAT GO OKRET                  % DATA MESSAGE
141114          IF A=7TMOD THEN                           % TMODE-MESSAGE
141117             CALL BDTMOD; GO RETU; GO NXMES
141122          FI
141122          IF A=7TTYP THEN                           % TTYPE-MESSAGE
141125             CALL BDTTYP; GO RETU; GO NXMES
141130          FI
141130          IF A=7DESC THEN                           % DEF-ESC MESSAGE
141133             CALL BDDESC; GO RETU; GO NXMES
141136          FI
141136          IF A=7DUMM THEN                           % DUMMY MESSAGE
141141             CALL BDDUMM; GO RETU; GO NXMES
141144          FI
141144   SRJE:  CALL SNDREJ; GO RETU; A:=TER01; GO RETU   % MESSAGE REJECTED
141150   
141150   ECHECK: IF A=1 OR A=2 GO OKRET                   % EMPTY
141156          IF A=3 GO SRJE                            % SEND REJECT
141161          GO RETU                                   % XMSG ERROR
141162   OKRET: GO T2BEXI
141163   RETU:  GO T1BEXI
141164   RBUS
141176   
141176   %=======================================================================
141176   % XX.XX      B D T M O D
141176   %
141176   % ROUTINE TO SET TERMINAL MODE ON A TAD
141176   % ENTRY:       B = INPUT-DATAFIELD
141176   % SKIP-RETURN: OK
141176   
141176   SUBR BDTMOD
141176   BDTMOD: TDBTPT=:D SHZ -1; T:=TDTAFI; X:=TDTALA+A; *LDATX
141205          IF D BIT "0" THEN A/\377 ELSE A SHZ -10 FI; A=:D
141213          REMSIZ-1=:REMSIZ; MIN TDBTPT; 0=:REMBYT
141220   
141220   % CAPITAL LETTERS?
141220          T:=DFLAG BZERO 5CAPITAL
141222          IF D BIT "0" THEN T BONE 5CAPITAL FI; T=:DFLAG
141226   
141226   % CR DELAY?
141226          T:=TYPRING BZERO 5CRDLY=:TYPRING
141231          IF D BIT 1 THEN
141233             T BONE 5CRDLY=:TYPRING
141235             T:=DFOPP.TYPRING BONE 5CRDLY=:X.TYPRING
141241          FI
141241   
141241   % STOP ON FULL PAGE?
141241          0=:DFOPP.SCREEN
141243          IF D BIT 2 THEN MIN X.SCREEN FI
141246   
141246   % LOGGOUT ON MISSING CARRIER
141246          T:=FLAGB BZERO 5LBLOG
141250          IF D BIT 3 THEN T BONE 5LBLOG FI
141253          T=:FLAGB
141254   
141254   RETU:  EXITA      
141255   RBUS
141256   
141256   %=======================================================================
141256   % XX.XX      B D T T Y P
141256   %
141256   % ROUTINE TO SET TERMINAL TYPE ON A TAD
141256   % ENTRY:         B = INPUT-DATAFIELD
141256   % SKIP-RETURN:   OK
141256   SUBR BDTTYP
141256   BDTTYP: TDBTPT=:D SHZ -1; T:=TDTAFI; X:=TDTALA+A; *LDATX
141265          IF D BIT "0" THEN
141267             A SHZ 10=:D; X+1; *LDATX
141273             A SHZ -10+D
141275          FI
141275          A=:CTTYP; TDBTPT+2=:TDBTPT; REMSIZ-2=:REMSIZ; 0=:REMBYT
141305   RETU:  EXITA
141306   RBUS
141306   
141306   %==========================================================================
141306   % XX.XX      B D D E S C
141306   %
141306   % ROUTINE TO SET ESCAPE CHARACTER ON A TAD
141306   % ENTRY:        B = INPUT-DATAFIELD
141306   % SKIP-RETURN:  OK
141306   SUBR BDDESC
141306   BDDESC: TDBTPT=:D SHZ -1; T:=TDTAFI; X:=TDTALA+A; *LDATX
141315          IF D BIT "0" THEN A/\377 ELSE A SHZ -10 FI; A=:T
141323          CESCP/\177400+T=:CESCP
141327          MIN TDBTPT; REMSIZ-1=:REMSIZ; 0=:REMBYT
141334   RETU:  EXITA    
141335   RBUS
141337   
141337   %===========================================================================
141337   % XX.XX      B D D U M M
141337   %
141337   % ROUTINE TO BYPASS DUMMY MESSAGES
141337   % ENTRY:        B = INPUT-DATAFIELD
141337   % SKIP-RETURN:  OK
141337   SUBR BDDUMM
141337   BDDUMM: T:=REMBYT-; T-1; TDBTPT+T=:TDBTPT; REMSIZ-T=:REMSIZ
141350           0=:REMBYT
141351           EXITA
141352   RBUS
141352   

141352   %========================================================================
141352   %      T A D   D R I V E R
141352   %========================================================================
141352   
141352   % THIS DRIVER HAS EIGTH EXTERNAL ENTRY POINTS.
141352   %      INIBDR:     INITIAL START, CALLED FROM TADADM IN CONNECTION-
141352   %                  PHASE
141352   %      INISND:     INITIAL SEND, CALLED FROM TADADM TO SEND START-
141352   %                  BUFFER
141352   %      BDRINP:     INPUT-DRIVER, ACTIVATED FIRST TIME FROM INIBDR
141352   %                  ELSE ACTIVATED BY XMSG WHEN RECEIVING A BUFFER.
141352   %      BERESP:     ROUTINE TO SEND ESCAPE-RESPONSE, CALLED FROM  
141352   %                  ESCAPE HANDLING.
141352   %      STOTAD:     ROUTINE TO STOP A TAD, THE PORT IS DISCONNECTED
141352   %                  IF OPEN.
141352   %      BDDSCN:     ROUTINE TO DISCONNECT A TAD WITHOUT LOGGING OUT.
141352   %      BDROUT:     OUTPUT-DRIVER, ACTIVATED FROM OUTPUT CALLS.
141352   %=======================================================================
141352   %      M E S S A G E   H E A D E R S
141352   
141352   INTEGER HIGHT                % SAVE TYPE OF HIGH PRIORITY MESSAGE
141353   INTEGER RDATR                % DATA IN RESPONSE MESSAGE
141354   INTEGER EBUFF:=(7DUMM\0)     % DUMMY-MESSAGE 0 (EMPTY BUFFER)
141355   INTEGER BDESC:=(7ESCA\0)     % ESCAPE-MESSAGE
141356   INTEGER RLOCA:=(7RLOC\0)     % REMOTE LOCAL (RUBOUT NORD-NET)
141357   INTEGER BDDIS:=(7DCON\0)     % DISCONNECT-MESSAGE
141360   INTEGER CESCR:=(7CERS\0)     % CESC-RESP MESSAGE
141361   INTEGER RESCF:=(7RECO\0)     % RESET-CONF MESSAGE
141362   INTEGER NWREM:=(7NWRE\0)     % NOWAIT RESTART MESSAGE
141363   INTEGER ISZRS:=(7ISRS\2)     % ISIZE RESPONSE MESSAGE
141364   INTEGER ERRSP:=(7ERRS\2)     % ERROR-RESPONSE MESSAGE
141365   INTEGER TREPS:=(7TREP\2)     % TREPP STATUS MESSAGE
141366   
141366   TRIPLE  DMMES:=(7DUMM\0,0,2) % DUMMY MESSAGE
141371   TRIPLE  RFIMS:=(7RFI\0,0,2)  % RFI MESSAGE
141374   TRIPLE  ERESP:=(7ESRS\0,0,2) % ESCAPE RESPONSE BUFFER
141377   TRIPLE  EDRSP:=(7EDRS\0,0,2) % ESCAPE RESPONSE ESCAPE DISABLED BUFFER
141402   
141402   @ICR
141402   SUBR   INIBDR,INISND,
141402          BDRINP,BDROUT,
141402          BERESP,STOTAD,BDLOUT,BDDSCN,BDRWT,
141402          FAERR,FAERO;
141402   @CR;
141402   
141402   %=======================================================================
141402   %      I N I B D R
141402   %
141402   % INITIAL ENTRY, LEVEL 10:
141402   %
141402   %      PROGRAMMED FROM TADADM WITH B = TAD INPUT-DATAFIELD
141402   %      TO EXECUTE FOLLOWING TASKS:
141402   %            - OPEN A XMSG PORT.
141402   %            - RESERVE BUFFERS ACCORDING TO NOBUFF AND FBSIZ IN
141402   %              DATAFIELD, ARRANGE FREE-POOL.
141402   %            - UPDATE PORTNO IN DATAFIELD 
141402   %            - RETURN TO TADADM                        
141402   
141402   INIBDR: IF PORTNO=0 THEN                                   % NO PORT OPENED
141404             0=:DFOPP.BXTADD; T:=XFOPN; CALL MXMSG; GO IERR   % OPEN PORT
141411             A=:PORTNO; A:=L=:DFOPP.BXTADD                    % UPDATE DATAFIELDS
141415             IF XFOPN=T THEN T:=XENOT; GO IERR; FI            % SPECIAL TEST FOR XTBLOC
141422             A:=0=:D; AD=:X.POOLLI                            % POOL EMPTY
141425             FOR X:=1 TO NOBUFF DO; X=:XRSA                   
141432                T:=XFGET; A:=FBSIZ; CALL MXMSG; GO IERR       % RESERVE BUFFERS
141436                T:=DFOPP=:B; A=:X=:BUFFID                     % B = OUTPUT-DATAFIELD
141442                CALL DRXACC(XDINF); GO OERR; *ION      
141446                X:=BUFFID; CALL PUTPOOL; 0=:BUFFID; DFOPP=:B  % PUT BUFFER IN FREEPOOL
141453             X:=XRSA; OD
141456          FI
141456          GO BDRWT; *)FILL                                    % LEAVE LEVEL
141463   
141463   INISND: DFOPP=:B; CALL GETPOOL; GO OERR; BUFFID
141470          T:=DFOPP=:B; T:=PORTNO=:D
141474          T:=XFSCM; CALL MXMSG; GO IERR                       % SET CURRENT
141477          TAD:=DMMES; T=:X:=XFWHD; CALL MXMSG; GO IERR
141504          AD:=DFOPP.PARTNER; X:=PORTNO
141507          T:=XFSND; CALL MXMSG; GO IERR                       % SEND BUFFER
141512          T:=XFWDF; A:="BDRINP"; CALL MXMSG; GO IERR          % SET "WAKE UP" MODE
141516          FLAGB BZERO 5LSTA=:FLAGB                            % SET LINE OK BIT
141521          CALL BRSTACK                                        % INIT STACKS.
141522          0=:DFOPP.BUFFID; GO BDRINP                          % ENTER RECEIVE MODE
141525   
141525   % ----- INITIALIZING ERRORS -----
141525   OERR:  *ION
141526          A=:T; DFOPP=:B
141531   IERR:  T=:DFOPP.DERROR                                     % SAVE ERROR
141533          GO FAERR       
141534   *)FILL
141542   
141542   %==========================================================================
141542   %      B D R I N P
141542   %
141542   % TAD INPUT DRIVER.  B = TAD INPUT DATAFIELD
141542   %
141542   % BDRINP IS INITIALLY STARTED BY INIBDR
141542   % THE FUNCTION OF THIS DRIVER IS TO RECEIVE BUFFERS FROM XMSG AND TAKE
141542   % PROPER ACTION DEPENDING ON THE CONTENTS IN THE BUFFER
141542   % ACTTIONS MAY BE THE FOLLOWING:
141542   %      - EMPTY BUFFER, RETURN TO POOL
141542   %      - DATA-MESSAGE, RESPONSE-MESSAGE, WAKE USER
141542   %      - CONTROLL-MESSAGE, PROCEED ACCORDINGLY
141542   %
141542   % THE DRIVER IS RESTARTED BY XMSG WHEN A BUFFER IS QUEUED ON THE PORT.
141542   % THE STRATEGY FOR HANDLING MESSAGES DEPENDS ON WETHER THE MESSAGE IS
141542   % A HIGH PRIORITY MESSAGE OR NORMAL PRIORITY MESSAGE
141542   %      - NORMAL:  MESSAGE IS REMOVED FROM PORT QUEUE ONLY IF      
141542   %                 CURRENT INPUT-BUFFER IS EMPTIED (BUFFID=0)
141542   %      - HIGH:    MESSAGE IS IMIDEATELY SERVED.
141542   %==========================================================================
141542   
141542   BDRINP: *ION
141543           IF PORTNO=0 GO BDRWT; T:=XFPST BONE XFWAK           
141550           CALL MXMSG; GO FAERR                               % READ PORT STATUS
141552           IF T=0 GO BDRWT                                    % NO BUFFER
141554           CALL CHPART; GO BDRINP                             % CHECK IF LEGAL PARTNER
141556           IF XMTHI><T GO FAR NORMP                           % NORMAL PRIORITY
141561           T:=XFRCV; A:=PORTNO; CALL MXMSG; GO FAERR          % RECEIVE
141565           IF T=0 GO BDRWT                                    % NO BUFFER
141567           X:=D=:TMPBUF
141571           T:=XFRHD; A:=TMPBUF; CALL MXMSG; GO FAERR          % READ SIX BYTES
141575   
141575   % CHECK IF RESPONSE-MESSAGE OR EMPTY BUFFER
141575           X=:HIGHT                                           % SAVE MESSAGE TYPE
141576           IF X=EBUFF OR X=CESCR OR X=RESCF OR X=ISZRS OR X=ERRSP THEN                              
141615             IF X=EBUFF THEN DFLAG BZERO 5RQI=:DFLAG FI       % ALLOW RFI IN NOWAIT
141623             IF X=ISZRS OR X=ERRSP THEN                       % MESSAGE WITH DATA
141631                X:=TMPBUF; T:=6; CALL DRXACC(XDGER); GO FAERR; *ION
141637                A SHZ 10=:RDATR
141641                X:=TMPBUF; T:=7; CALL DRXACC(XDGER); GO FAERR; *ION
141647                T:=RDATR+A=:RDATR                             % DATA IN RDATR
141652             FI
141652             IF DFLAG BIT 5WRQI THEN                          % RFI WAITING TO BE SENDT
141655                A BZERO 5WRQI=:DFLAG; GO FAR RETRFI
141660             FI
141660             IF DFOPP.BUFFID=0 THEN                           % PUT BUFFER TO OUTPUT
141663                X:=TMPBUF; CALL CHSIZE; GO FAR CHRESO
141666                X:=TMPBUF; A:=-1; CALL DRXACC(XDSBP); GO FAERR; *ION           
141674                X:=TMPBUF; A:=BUDIS; CALL DRXACC(XDSBP); GO FAERR; *ION       
141702                AD=:DFOPP.TDTADD; TMPBUF=:X.BUFFID
141706                BUDIS=:X.TDBTPT; FBSIZ-BUDIS=:X.REMSIZ; 0=:TMPBUF
141714                GO FAR CHRESO; *)FILL
141736             ELSE                                             % PUT BUFFER IN POOL
141737                X:=TMPBUF; CALL CHSIZE; GO FAR CHRESO
141742                X:=TMPBUF; T:=DFOPP=:B; CALL PUTPOOL
141746                DFOPP=:B; 0=:TMPBUF; GO FAR CHRESO
141752             FI
141752           FI
141752           IF X=NWREM THEN                                    % NOWAIT RESTART
141755             T:=XFSND; AD:=DFOPP.PARTNER; X:=PORTNO
141761             CALL MXMSG; GO FAERR                             % RETURN MESSAGE
141763             GO FAR DATRES                                    % RESTART USER
141764           FI
141764           IF X=TREPS THEN                                    % TREP STATUS
141767             X:=TMPBUF; T:=6; CALL DRXACC(XDGER); GO FAERR; *ION
141775             A SHZ 10=:RDATR
141777             X:=TMPBUF; T:=7; CALL DRXACC(XDGER); GO FAERR; *ION
142005             T:=RDATR+A=:RDATR                                % DATA IN RDATR
142010             T:=XFSND; AD:=DFOPP.PARTNER; X:=PORTNO
142014             CALL MXMSG; GO FAERR
142016             T:=RDATR; A:=TINFO
142020             IF T BIT 2 THEN A BONE 5BFUL FI                  % BUFFER OVERRUN
142023             IF T BIT 3 THEN A BONE 5PAER FI                  % PARITY ERROR
142026             IF T BIT 4 THEN A BONE 5FRER FI                  % FRAMING ERROR
142031             A=:TINFO
142032             GO FAR BDRINP
142033           FI
142033           GO FAR ESCDIS; *)FILL                              % ESCAPE OR DISCONNECT
142050   
142050   % ----- NORMAL PRIORITY -----
142050   NORMP: IF BUFFID><0 GO BDRWT                               % INPUT-BUFFER NOT EMPTY
142053          DFLAG BZERO 5RQI=:DFLAG                             % ALLOW RFI IN NOWAIT
142056          T:=XFRCV; A:=PORTNO; CALL MXMSG; GO FAERR           % RECEIVE FUNCTION
142062          IF T=0 GO BDRWT
142064          X-BUDIS=:REMSIZ:=D=:BUFFID=:TMPBUF                             
142071          X:=BUFFID; CALL CHSIZE; GO WRSIZE; AD=:TDTADD; BUDIS=:TDBTPT
142077   
142077   % ----- BUFFER RECEIVED -----
142077   NXMES: CALL GETMES; GO ECHECK         
142101          IF CURMES=7BDAT GO DATRES                 % DATA MESSAGE
142105          IF A=7TMOD THEN                           % TMODE-MESSAGE
142110             CALL BDTMOD; GO FAERR; GO NXMES
142113          FI         
142113          IF A=7TTYP THEN                           % TTYPE-MESSAGE
142116             CALL BDTTYP; GO FAERR; GO NXMES
142121          FI          
142121          IF A=7DESC THEN                           % DEF-ESC MESSAGE
142124             CALL BDDESC; GO FAERR; GO NXMES
142127          FI           
142127          IF A=7DUMM THEN                           % DUMMY MESSAGE
142132             CALL BDDUMM; GO FAERR; GO NXMES
142135          FI          
142135   SRJE:  CALL REJECT; 0/\0; GO BDRINP              % MESSAGE REJECTED
142140   ECHECK: IF A=1 OR A=2 GO BEMTY                   % EMPTY
142146           IF A=3 GO SRJE                           % SEND REJECT
142151           GO FAERR                                 % XMSG ERROR
142152   *)FILL
142165   
142165   WRSIZE: 0=:BUFFID=:CURMES=:REMSIZ; GO BDRINP
142171   
142171   BEMTY: X:=BUFFID; 0=:BUFFID=:CURMES=:REMSIZ 
142175          CALL CHSIZE; GO BDRINP
142177          T:=DFOPP=:B; CALL PUTPOOL; DFOPP=:B
142204          GO BDRINP
142205   
142205   DATRES: A:=DFOPP.RSPNUM BZERO 17
142210           IF A><7CERS AND A><7RECO AND A><7ISRS THEN         % NOT AWAITING RESPONSE
142221             CALL STBACK; "IORESTART"=:MFUNC; CALL RTACT      % RESTART USER
142225           FI
142225           GO BDRINP; *)FILL
142234   
142234   RSPRST: 0=:DFOPP.RSPNUM                                    % RESET RESPONSE WAIT
142236           CALL STBACK; "RSRESTART"=:MFUNC; CALL RTACT        % RESTART AFTER RESPONSE
142242           GO BDRINP
142243   
142243   CHRESO: A:=HIGHT; 0=:HIGHT
142245           IF A=CESCR THEN                                    % CESC-RESP
142250             IF DFOPP.RSPNUM=7CERS GO RSPRST                   
142255             GO BDRINP
142256           FI
142256           IF A=RESCF THEN                                    % RESET-CONF
142261             IF DFOPP.RSPNUM=7RECO GO RSPRST                    
142266             GO BDRINP
142267           FI
142267           IF A=ISZRS THEN
142272              DFOPP.RSPNUM=:T; A BZERO 17
142276              IF A=X:=7ISRS THEN                             % WAITING FOR ISIZE-RESPONSE
142301                RDATR=:RTRES.RTDLGADDR.DAREG                 % RETURN PARAMETERS
142305                IF T NBIT 17 THEN A=:X.DXREG FI              % IBRSIZ ONLY
142310                GO RSPRST              
142311              FI
142311           FI
142311           IF A=ERRSP THEN
142314              IF DFOPP.RSPNUM=7ERRS THEN
142321                IF RTRES.STATUS BIT 5WAIT THEN
142325                   RDATR=:X.RTDLGADDR.DAREG
142330                   IF A=0 THEN X.DPREG+1=:X.DPREG FI
142334                   GO RSPRST
142335                FI
142335              FI
142335           FI
142335           DFOPP.RSPNUM BZERO 17
142340           IF A><7CERS AND A><7RECO AND A><7ISRS THEN        % NOT AWAITING RESPONSE
142351             IF DFOPP.ISTATE>=0 THEN X=:B
142355                "IORESTART"=:MFUNC; CALL RTACT; DFOPP=:B      % RESTART OUTPUT
142362             FI
142362           FI
142362           GO BDRINP
142363   *)FILL
142377   
142377   % ----- RFI MESSAGE SENT FROM DRIVER WHEN BUFFER ARRIVES AND 5WRQI IS SET.
142377   %       BUFFER WAS NOT AVAILABLE FOR NORMAL SENDING.
142377   
142377   RETRFI: TAD:=RFIMS; T=:X:=XFWHD; CALL MXMSG; GO FAERR
142404           AD:=DFOPP.PARTNER; X:=PORTNO 
142407           T:=XFSND; CALL MXMSG; GO FAERR; GO FAR CHRESO
142413   
142413   % ----- ESCAPE OR DISCONNECT, X = MESSAGE HEADER -----
142413   
142413   
142413   ESCDIS: IF X=BDESC OR X=RLOCA THEN                  % ESCAPE OR REMOTE-LOCAL MESSAGE
142421             IF DFLAG NBIT 5IESC THEN                  % ESCAPE ENABLED
142424                IF X=BDESC THEN
142427                   CESCP/\377=:LAST                    % ESCAPE
142432                ELSE
142433                   IF FLAGB BIT 5LCHAR THEN
142436                      CESCP SHZ-10=:LAST               % LOCAL CHARACTER
142441                   ELSE
142442                      177=:LAST                        % RUBOUT IN NORD-NET
142444                   FI
142444                FI
142444                DFLAG BZERO 5RQI=:DFLAG                % ALLOW RFI IN NOWAIT
142447                CALL ESCAPE; 0/\0
142451                TAD:=ERESP; T=:X:=XFWHD
142454                CALL MXMSG; GO FAERR                   % WRITE ESCAPE-RESPONCE
142456                TMPBUF=:ESCBUF; 0=:TMPBUF; GO BDRINP
142462             ELSE                                   % ESCAPE DISABLED
142463                TAD:=EDRSP; T=:X:=XFWHD
142466                CALL MXMSG; GO FAERR                   % WRITE ESCAPE DISABLED RESPONSE
142470                AD:=DFOPP.PARTNER; X:=PORTNO
142473                T:=XFSND; CALL MXMSG; GO FAERR         % SEND RESPONSE
142476                0=:TMPBUF; GO BDRINP
142500             FI
142500          FI
142500          IF X=BDDIS THEN                           % DISCONNECT-MESSAGE
142503             GO STOTAD                              % STOP AND DISCONNECT TAD
142504          FI
142504          A:=X SHZ -10=:CURMES; GO FAR SRJE         % ILLEGAL HIGH-PRIORITY
142510          GO BDRINP
142511   *)FILL
142527          
142527   %=========================================================================
142527   %      B E R E S P
142527   %
142527   % ESCAPE RESPONSE, ACTIVATED FROM ESCAPE HANDLING WITH B = INPUT DATAFIELD
142527   
142527   BERESP: IF ESCBUF><0 THEN
142531             PORTNO=:D; A:=ESCBUF; 0=:ESCBUF
142535             T:=XFSCM; CALL MXMSG; GO FAERR         % SET CURRENT
142540             T:=XFSND; AD:=DFOPP.PARTNER; X:=PORTNO
142544             CALL MXMSG; GO FAERR                   % SEND RESPONCE
142546           FI
142546           GO BDRINP
142547   
142547   %=========================================================================
142547   %      S T O B A D
142547   %
142547   % ROUTINE ACTIVATED TO STOP A TAD, B = INPUT DATAFIELD     
142547   % IF BACKROUND: TLREP ENABLED:  5LSTA AND 5LOGOUT IS SET
142547   %               TLREP DISABLED: TAD IS LOGGED OUT
142547   % TAD RESERVED: 5LSTA IS SET
142547   % THE TADS PORT IS CLOSED IF OPEN
142547   
142547   STOTAD: IF DBPROG><0 AND A=RTRES THEN               % BACKGROUND 
142554              IF FLAGB BIT 5TLREP THEN
142557                A BONE 5LOGOUT=:FLAGB                  % PROGRAM IS RESPONSIBLE, LOGOUT AT MON 0 
142561                "IORESTART"=:MFUNC; CALL RTACT         % RESTART PROGRAM
142564              ELSE
142565                CALL BDLOUT                            % LOGGOUT USER
142566              FI
142566           FI
142566           IF FLAGB NBIT 5LSTA THEN GO BDDSCN FI       % PORT SHOULD BE CLOSED
142572           GO BDRWT                                    % LEAVE DRIVER LEVEL
142573   
142573   %=========================================================================
142573   %      B D L O U T
142573   %
142573   % SUBROUTINE TO LOG OUT A TAD
142573   % B = INPUT-DATAFIELD
142573   
142573   BDLOUT: A:=L=:"DRIVER"
142575          IF DBPROG><0 AND A=RTRES THEN             % BACKGROUND AND LOGGED ON
142602             DFLAG BZERO 5IESC=:DFLAG               % ENABLE ESCAPE         
142605             0=:ISTATE=:DFOPP.ISTATE                % RESET ISTATE
142610             DBPROG.STATUS BZERO 5WAIT=:X.STATUS    % CLEAR WAIT BIT
142614             FLAGB/\ESCMASK BONE 5ESCON=:FLAGB      % RESET USER ESCAPE/LOCAL
142620             -1=:LAST; CALL ESCAPE; 0/\0            % LOGOUT USER
142624          FI
142624          GO DRIVER
142625   *)FILL
142637   
142637   %=========================================================================
142637   %      B D D S C N
142637   %
142637   % ROUTINE TO DISCONNECT A TAD IF PORT IS OPEN, B = INPUT-DATAFIELD
142637   % RETURN IS DONE BY LEAVING DRIVER-LEVEL.
142637   
142637   BDDSCN: FLAGB BONE 5LSTA=:FLAGB                     % SET LINE DEAD BIT
142642           IF PORTNO><0 AND DFOPP.BXTADD><0 THEN       % PORT IS OPEN
142647             IF TMPBUF><0 THEN
142651                0=:TMPBUF; T:=XFREL; CALL MXMSG; 0/\0  % RELEASE CURRENT BUFFER
142655             FI
142655             X.BXTADD=:L; 0=:PORTNO=:X.BXTADD          % CLEAR DATAFIELD
142661             0=:BUFFID=:X.BUFFID=:X.POOLP
142664             T:=XFDCT; *MON 2XMSG                      % DISCONNECT
142666          ELSE                                         % PORT IS CLOSED
142667             0=:PORTNO=:DFOPP.BXTADD
142672             0=:X.POOLP=:BUFFID=:X.BUFFID              % CLEAR DATAFIELD    
142675          FI
142675          GO BDRWT
142676   

142676   %=========================================================================
142676   %      B D R O U T
142676   %
142676   % TAD OUTPUT DRIVER ACTIVATED FROM STDEV WITH B = TAD OUTPUT-DATAFIELD
142676    
142676   BDROUT: IF DRFUNC=0 OR DFOPP.PORTNO=0 GO BDRWT             % DUMMY CALL
142704          IF BUFFID=0 GO OUT                                  % NO BUFFER
142706          0=:DRFUNC; CALL SETSIZE
142710          DFOPP=:B                                            % B = INPUT-DATAFIELD
142712          PORTNO=:D; A:=DFOPP.BUFFID
142716          T:=XFSCM; CALL MXMSG; GO FAERR                      % SET CURRENT
142721          AD:=DFOPP.PARTNER; X:=PORTNO
142724          T:=XFSND; CALL MXMSG; GO FAERR                      % SEND BUFFER
142727          DFOPP=:B; 0=:CURMES
142732          CALL GETPOOL; 0/\0
142734   OUT:   DFOPP=:B; GO BDRINP             % RETURN VIA INPUT-DRIVER
142737   
142737   % ----- F A E R R   FATAL ERROR IN DRIVER
142737   FAERO: DFOPP=:B
142741   FAERR: *ION                                                    
142742          GO STOTAD                                                                 
142743   
142743   % ----- B D R W T    LEAVE DRIVER LEVEL
142743   BDRWT: *ION
142744          CALL WT10; *JMP *-1
142746   
142746   RBUS
142760   
142760   %=======================================================================
142760   %      S E T S I Z E
142760   %
142760   % ROUTINE TO SET CORRECT SIZE AND BYTE-POINTER BEFORE SEND
142760   %      ENTRY: B-REG - TAD OUTPUT-DATAFIELD
142760   SUBR SETSIZE
142760   SETSIZE: A:=L=:DFOPP."DRIVER"
142763          A:=DFOPP.FBSIZ-REMSIZ-BUDIS=:REMSIZ                 % UPDATE SIZE
142770          T:=TDTAFI; X:=TDTALA; A:=0; *STATX
142774          X+1; REMSIZ; *STATX
142777          X:=BUFFID; A:=-1; CALL DRXACC(XDSBP); 0/\0; *ION    % SET BYTE POINTER
143005          X:=BUFFID; TDBTPT; CALL DRXACC(XDSBP); 0/\0; *ION 
143013          DFOPP."DRIVER"=:P
143016   RBUS
143017   
143017   %=======================================================================
143017   %      C H P A R T
143017   %
143017   % ROUTINE TO CHECK IF BUFFER IS SENT FROM PARTNER
143017   % B = INPUT-DATAFIELD, A = SENDERS NUMBER FROM RECEIVE
143017   SUBR CHPART
143017   CHPART: X:=L=:"DRIVER"
143021           IF A=X:=DFOPP.RPORT THEN                 % SENDER OK
143025              MIN "DRIVER"                          
143026           ELSE                                     % UNAUTORIZED SENDER
143027              DFOPP.BXTADD=:L:=PORTNO; T:=XFRCV; *MON 2XMSG
143035              CALL WT10; IF T<0 GO DRIVER           % RECEIVE BUFFER
143040              DFOPP.BXTADD=:L:=D; T:=XFREL; *MON 2XMSG
143046              CALL WT10                             % RELEASE BUFFER
143047           FI
143047          GO DRIVER
143050   RBUS
143051   
143051   %=====================================================================
143051   %      C H S I Z E
143051   %
143051   % ROUTINE TO CHECK IF A BUFFER IS OF CORRECT SIZE, IF NOT THE
143051   % BUFFER IS RELEASED.
143051   % ENTRY:        X-REG - BUFFER ID
143051   %               B-REG - TAD INPUT DATAFIELD
143051   % SKIP RETURN:  BUFFER OK, AD-REG - BUFFER ADDRESS
143051   % EXIT:         WRONG SIZE, BUFFER IS RELEASED 
143051   SUBR CHSIZE
143051   INTEGER XREG
143052   CHSIZE: *IOF
143053          A:=L=:"DRIVER"; X=:XREG
143056          CALL DRXACC(XDINF); GO FAERR; X:=XREG        
143062          T=:L
143063          IF L=FBSIZ THEN; *ION
143067             MIN "DRIVER"
143070          ELSE
143071             DFOPP.BXTADD=:L; T:=XFREL; XREG; *ION; MON 2XMSG
143100             CALL WT10
143101          FI
143101          GO DRIVER
143102   RBUS
143105   
143105   %====================================================================
143105   %      R E J E C T
143105   %
143105   %  ROUTINE TO SEND REJECT MESSAGE. THE ROUTINE HAS THE SAME FUNCTION
143105   %  AS SNDREJ. REJECT IS ONLY CALLED FROM DRIVER.
143105   %      ENTRY:   B-REG  - INPUT DATAFIELD
143105   %               CURMES - REJECTED MESSAGE
143105   SUBR REJECT
143105   REJECT: A:=L=:"DRIVER" 
143107          IF DFOPP.BUFFID=0 THEN
143112             BUFFID; X:=DFOPP=:B
143115             IF A><0 THEN
143116                CALL MOVITO; GO GESND
143120             ELSE
143121                CALL GETPOOL; GO NOPOL; GO GESND
143124             FI
143124          ELSE
143125             IF REMSIZ>=3 GO GESND
143131             CALL SETSIZE; BXTADD=:L; BUFFID; T:=XFSCM; *MON 2XMSG    
143137             CALL WT10; IF T>0 GO FAERO; AD:=PARTNER; X:=DFOPP.PORTNO
143145             T:=BXTADD=:L:=XFSND; *MON 2XMSG
143151             CALL WT10; IF T>0 GO FAERO
143154             CALL GETPOOL; GO NOPOL
143156          FI
143156   GESND: A:=7REJE; CALL STORBYT; A:=1; CALL STORBYT
143162          DFOPP.CURMES/\377; CALL STORBYT
143166          CALL SETSIZE; BXTADD=:L; BUFFID; T:=XFSCM; *MON 2XMSG    
143174          CALL WT10; IF T>0 GO FAERO; AD:=PARTNER; X:=DFOPP.PORTNO
143202          T:=BXTADD=:L:=XFSND; *MON 2XMSG
143206          CALL WT10; IF T>0 GO FAERO
143211   NOPOL: DFOPP=:B; GO DRIVER
143214   RBUS
143224             
143224   %=====================================================================
143224   %      M X M S G
143224   %
143224   % ROUTINE TO PERFORM XMSG MONITOR CALL, B = INPUT-DATAFIELD
143224   % SKIP RETURN: OK,    RETURN: XMSG ERROR
143224   
143224   SUBR MXMSG
143224   MXMSG: A:=:L=:"DRIVER"; A:=L; X=:L
143230          X:=DFOPP.BXTADD; X:=:L; *MON 2XMSG
143234          CALL WT10; IF T>=0 THEN MIN "DRIVER" FI
143240          GO DRIVER
143241   RBUS
143242   
143242   *"-BADAD
"143242   @EOF
