121030   % 36.9       S H R S O V E R L A P 
121030   %
121030   % SUBROUTINE TO CHECK IF A REENTRANT SEGMENT ADDRESS OVERLAPS
121030   % A NON DEMAND SEGMENT
121030   % IF SHRSOVERLAP:
121030   % ENTRY:     X=SEGMENT TABLE ADDRESS OF ACTUAL NONREENTRANT SEGMENT
121030   %            A=SEGMENT FLAG OF ACTUAL NONREENTRANT SEGMENT
121030   %            T=REENTRANT SEGMENT NUMBER
121030   %
121030   % EXIT:      NO OVERLAP
121030   %
121030   % ERROR AND EXIT TO RETXIT IF OVERLAP
121030   %
121030   
121030   SUBR SHRSOVERLAP
121030   INTEGER CSTRA,CLA,CLRS
121033   
121033   SHRSOVERLAP:  IF A BIT 5DEMAND OR T=0 GO OUT
121037                 A:=T*5SEGSIZE+SEGSTART:=:X=:T
121044                 X.LOGADR/\377=:CSTRA; X.LOGADR SHZ -10=:CLA; X:=T
121053                 IF X=0 GO OUT
121054                 X.LOGADR SHZ -10=:CLRS; X.LOGADR/\377
121061                 IF A>CSTRA THEN
121064                    IF A-CLA<T GO 45ERR
121067                 ELSE
121070                    IF A+CLRS>T GO 45ERR
121073   OUT:          FI; EXIT
121074   45ERR: CALL 9ERRA(#45); GO RETXIT
121077   
