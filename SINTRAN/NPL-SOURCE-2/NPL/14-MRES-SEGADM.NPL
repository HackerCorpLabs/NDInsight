116310   %  ROUTINES FOR SETTING/CLEARING RT'S SYSTEM SEGMENT PIT ENTRIES
116310   
116310   SUBR CLERT,SETRT
116310   
116310   INTEGER XREG,BREG
116312   INTEGER ARRAY POINTER CPITADDR:=177000+SYSST+2+SYSST+2
116313   DOUBLE ARRAY POINTER DCPITADDR=CPITADDR
116313   
116313   CLERT: X=:XREG:=B=:BREG
116316          FOR X:=0 STEP 2 TO "5SSSZ-5ESSZ-1" SH 1 DO 0=:CPITADDR(X) OD
116326          CCFPAGE SH 1+177200=:X; T:=177400
116333          DO WHILE X<<T; 0=:X.S0; X+2; OD
116340          GO OUT
116341   
116341   SETRT: A:=B=:BREG; X=:XREG; T:=0
116345          A:="SYSST+2"=:D:=162000
116350          FOR X:=0 STEP 2 TO "5SSSZ-5ESSZ-1" SH 1 DO AD=:DCPITADDR(X); D+1; OD
116361   OUT:   X:=BREG=:B:=XREG; EXIT
