120040   INTEGER WRITTEN,MODUS,CNUMBER,LMASSNO,XREG,XREG2,BREG,CABLPAGE,NPAGES,BMASS
120052   INTEGER POINTER LREG2
120053   DOUBLE BLSTX
120055   
120055   RWSEGM: A=:NPAGES:=L=:"LREG2":=B=:BREG; X=:XREG2
120063          IF WRITTEN=0 THEN
120065             MADR SHZ -16; MASSUNIT(A) SH 6+MODUS+60=:SWPMTMODUS
120075             ABLPAGE(X)=:CABLPAGE*NPAGES=:SWPBLPAGE
120101             X=:T+X; DBLST(X)=:BLSTX; X:=T
120106             IF D=0 AND A=0 THEN CALL ERRFATAL FI
120112             MASSNO(X)=:LMASSNO; CALL LOGPH; A=:BMASS=:B
120117             X:=SRTREF; CALL BRESERVE
120121             IF A<0 THEN
120122                IF SWPFLAG><0 THEN
120124                   BMASS=:B; GO LNK1SWAP
120127                FI; 5CLOAD; CALL RELEASE
120131                IF X=RTREF GO PRWAIT; GO PSTUPR; *)FILL
120156             FI; MIN WRITTEN; BREG=:B
120161          FI; T:=CORMBANK; X:=XREG2; *LDATX DALOG
120164          A=:D:=LOGADR/\377; D-A; MADR/\37777+D*CABLPAGE=:L
120175          BLSTX; D+L; A:=A+C; AD=:SWPMASSADR
120201          *LDATX DPAGP
120202          D:=0; AD SHZ -6=:SWPCOREADR
120205   *"8SWLG
"120205          A:=BMASS=:B:="SWPPARLIST"; CALL PMTRANS; IF HSTAT BIT 4 GO ERR
120214          X:=BREG=:B:=XREG2; T:=CORMBANK
120220          IF MODUS><0 THEN
120222             *LDATX DPGPR
120223             A BZERO 5WIP
120224          ELSE
120225             *LDATX DPGPR
120226             A=:D:=FLAG/\177400\/D
120232          FI; *STATX DPGPR
120233          GO LREG2
