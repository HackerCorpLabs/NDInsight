117100   % 37.10      S E G I N
117100   
117100   % SUBROUTINE TO GET A NEW SEGMENT INTO CORE
117100   % B=SEGMENT ELEMENT; NO RETURN
117100   
117100   SUBR SEGIN
117100   SYMBOL 5READ,5WRITE
117100   SEGIN: 5CLOAD; X:=RTREF; CALL RESERVE
117103          IF <0 THEN                      %SEG. TRANSFER GOING ON
117104             IF SWPFLAG><0 THEN
117106                X.ACTPRI BONE 5SWWAIT=:X.ACTPRI
117111                X.STATUS BONE 5WAIT=:X.STATUS
117114   LOOP:        RTREF+"BRESLINK"=:X
117117                DO WHILE X:=X.RESLINK><RTREF
117123                   IF X.TYPRING/\3=3 THEN X=:B:=RTREF; CALL BRELEASE; GO LOOP FI
117134                OD
117135             FI; GO PRWAIT; *)FILL
117146          FI; A:=B=:SEGREF
117150          X=:SRTREF; NSEGA=:TSEGA; NSEGB=:TSEGB; NSEGC=:TSEGC
117157          CALL XCSEGS
117160          IF FLAG NBIT 5DEMAND THEN
117163   
117163   %NON-DEMAND SEGMENT
117163             DO                 %UNTIL THE SEGMENT HAS GOT ENOUGH PAGES
117163                IF B="XSGRT" THEN -1=:NUMBER; GO XLRU FI      % DUMMY SEGMENT
117171                LOGADR SHZ-10-=:NUMBER
117175                IF X:=BPAGLINK><0 THEN
117177                   LOGADR/\377=:D; T:=CORMBANK; *LDATX DALOG
117204                   D-A=:A; A=:NUMBER
117207                FI
117207             WHILE NUMBER><0    %ENOUGH PAGES
117211   XLRU:        CALL LRU; X:=:B; FLAG =:SAVEFLAG BZERO 5OK=:FLAG
117217                5WRITE; CALL TRNSEG
117221                IF ><0 THEN SAVEFLAG=:FLAG; GO END1 FI
117225                X:=:B; CALL LINKOVER
117227             OD
117230          ELSE
117231   
117231   %DEMAND SEGMENT
117231             IF FLAG BIT 5OK THEN
117234                -1=:NUMBER; PNUMB=:CPNUMB
117240                FLAG BZERO 5OK=:FLAG
117243                CALL LRU; X:=:B; FLAG BZERO 5OK=:FLAG
117250                5WRITE; CALL TRNSEG; X:=:B; CALL LINKOVER
117254                T:=CORMBANK; X:=BPAGLINK; *LDATX DPAGL
117257                IF A><0 THEN
117260                   A=:BPAGLINK; *STZTX DPAGL
117262                   X=:D
117263                   DO WHILE A><0
117264                      A=:X; *LDATX DPAGL
117266                   OD; A:=D; *STATX DPAGL
117271                FI
117271             FI
117271          FI
117271          0=:NUMBER; 5READ; CALL TRNSEG
117274   %SEGMENT OK:
117274          FLAG BONE 5OK=:FLAG
117277   END1:  X:=SRTREF; 5CLOAD; CALL RELEASE
117302          IF X=RTREF GO PRW; GO PSTUPR
117306   RBUS
