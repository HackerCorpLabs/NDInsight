120704   % 37.21      O V E R L A P
120704   %
120704   SUBR OVERLAP
120704   % SUBROUTINE TO SEARCH FOR OVERLAP AND DELETE PAGES
120704   % ENTRY:     A=SEGM. ELEMENT POINTER, T=REENTRANT SEGMENT
120704   %
120704   %
120704   INTEGER SEGAB,XREG,RSTART,REND,RESEG,PREVT
120712   INTEGER POINTER SEG1:=XSGRT,BP1:=BPAG1   % SEGMENT 1
120714   INTEGER POINTER LREG
120715   
120715   OVERLAP: IF A=0 THEN EXIT FI
120717          A=:SEGAB; T=:RESEG; X=:XREG:=L=:"LREG"; IF A.SEGLINK=0 GO OUT
120727          RESEG.LOGADR/\377=:RSTART; X.LOGADR SHZ -10+RSTART=:REND
120737          X:=SEGAB+1; T:=0
120742   PSTART: DO
120742             X=:D; T=:PREVT; *LDXTX DPAGL
120745          WHILE X><0
120746             T:=CORMBANK; *LDATX DALOG
120750             IF A>=RSTART AND A<REND THEN          % OVERLAP
120756                T:=CORMBANK; CALL CLPAGE; *LDATX DPAGL
120761                D:=:X; T=:L:=PREVT; *STATX DPAGL          % REMOVE PAGE
120765                X:=:D; T:=:L; BP1; *STATX DPAGL     % LINK TO DUMMY SEGMENT
120771                X=:BP1; A:=1; *STATX DPGPR          % SET SEGMENT NUMBER
120774                IF SEG1=0 THEN            % MOVE DUMMY SEGMENT TO END OF SEGMENT LINK
120776                   BSEGLINK
120777                   DO WHILE A.SEGLINK><-1 OD
121005                   "SEG1"=:X.SEGLINK; T=:SEG1
121010                FI; X:=D; T:=L; GO PSTART
121013             FI; T:=CORMBANK
121014          OD
121015          IF SEGAB.BPAGLINK=0 THEN CALL SREMOVE FI
121021   OUT:   X:=XREG; GO LREG
121023   RBUS
