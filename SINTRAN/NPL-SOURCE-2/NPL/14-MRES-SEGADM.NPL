115732   @ELIB
115732             FI
115732          FI
115732          PNUMB SH 1+177000=:X
115736          IF X.S0><0 THEN CALL ERRFATAL FI
115741          IF DEMAND=0 THEN PNUMB; CALL 9ERR(#13); GO PBRTEXT FI
115747          X:=SEGMC; CALL LIMCHECK
115751          IF =0 THEN
115752                A:=X.LOGADR/\300=:D:=PNUMB/\377-D
115760                AD SHZ -4; X:=RTREF.RTDLGADDR+A
115764                SHAINSTR; D SHZ -14+A; 1; *EXR SD
115771                IF A/\X.BITMAP><0 GO NOTREENT; X:=SEGMC
115774          ELSE
115775   NOTREENT:    X:=SEGMA; CALL LIMCHECK
115777                IF <0 THEN X:=SEGMB; CALL LIMCHECK
116002                   IF <0 THEN
116003   OUTSIDE:           PNUMB; CALL 9ERR(#14); GO PBRTEXT
116007                   FI
116007          FI    FI; X=:B; CALL SEGIN
116011   *)FILL
