117766          GO PSTUPR
117767   
117767   
117767   TRNSEG: A=:MODUS:=L=:"LREG"; X=:XREG
117773          0=:WRITTEN; NUMBER=:CNUMBER; X:=BPAGLINK
117777          FOR CNUMBER DO WHILE X><0
120000             T:=CORMBANK; *LDATX DPGPR
120002             IF A=:D/\160000\/MODUS=0 OR MODUS SHR 5WIP/\D><0 THEN
120012                1; CALL RWSEGM
120014             FI; T:=CORMBANK; *LDXTX DPAGL
120016          OD
120020          IF WRITTEN><0 THEN X:=SRTREF; LMASSNO; CALL RELEASE FI
120025          WRITTEN; X:=XREG; GO LREG
120030   *)FILL
