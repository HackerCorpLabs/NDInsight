121330          A:="9SMRE" SHZ -12=:D
121333          A:="9EPT3" SHZ -12=:L; IF "9EPT3"/\1777><0 THEN L+1 FI
121342          X:=177600+D+D; A:=162000
121346          DO AD=:X.DOU0; WHILE D><L; X+2; D+1; OD
