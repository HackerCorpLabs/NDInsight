115716          ELSE
115717             IF A="5BFPAGE" THEN
115722   @LIB CXCPU
115722   @LIB CXCPU-,
115722               IF RTREF.WINDOW SHZ -10=0 GO OUTSIDE
115726               A=:D:=162000; AD=:BPG
115731   *"8SWLG
