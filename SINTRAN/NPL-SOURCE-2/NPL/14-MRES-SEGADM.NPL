122037   % SUBROUTINE TO SET SPEED FOR TERMINAL BUFFER AND MULTITERMINAL INTERFACE
122037   % THE SPEED IS FOUND IN INPUT DATAFIELD; -1 MEANS DO NOT SET SPEED
122037   
122037   INTEGER POINTER INDXX,CLREG; INTEGER ICNTI,CHDEV
122043   DISP 12; INTEGER CCDFILD; PSID
122043   TBUSPEED: A:=L=:"CLREG"
122045          X=:D; "TMRTE"-2=:"INDXX"
122051          DO WHILE X:=INDXX><-1 OR "INDXX"="TMRTE"  % IN TIMER TABLE
122061                IF X><0 AND X><-1 THEN
122065                   IF X.TYPRING BIT 5TERM THEN      % TERMINAL
122070                      T:="HDEV"; CALL XGTDFADDR; A=:CHDEV
122073                      IF A NBIT 2 THEN
122075                         T:="TSPEED"; CALL XGTDFADDR
122077                         IF A+1><0 THEN
122101                            T:=CHDEV+1; A-1; *IOXT
122105                FI FI FI FI; MIN "INDXX"
122106          OD
122107          1=:ICNTI
122111          FOR ICNTI TO MXLIN DO          % SET SPEED FOR SIN/SIN COMMUNICATION
122115            X:=LINAR(ICNTI); IF X.TSPEED><-1 THEN
122123              T:=X.CCDFILD.HDEV+1; *EXR ST
122127            FI
122127          OD D=:X; GO CLREG
