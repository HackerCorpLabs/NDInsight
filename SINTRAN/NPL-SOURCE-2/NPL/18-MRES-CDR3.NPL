133112   SYMBOL INIT = 4                        % INITIATE INTERFACE
133112   SYMBOL PSTAT = 5                       % GET PORT STAUS
133112   SYMBOL DTLI = 6                        % DEFINE TRANSMITTER LIST * 81F*
133112   SYMBOL DRBI = 7                        % DECLARE RECEIVER BUFFER * 81F*
133112   %
133112   
133112   %      MESSAGE DECRIPTIONS
133112   %
133112   
133112   %      INIT
133112   %
