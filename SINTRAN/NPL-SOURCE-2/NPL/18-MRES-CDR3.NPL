133112          INTEGER DISP2                   % DISPLACEMENT 2
133112          INTEGER MAXR                    % MAX RECEIVER BLOC LENGTH
133112          INTEGER CHECK                   % CHECKSUM
133112          INTEGER LISTL                   % NUMBER OF ENTRIES IN  RECEIVER LIST
