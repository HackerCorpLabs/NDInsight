"131520   %==============================================================================
131520   % 40.3       L O G 1   L O G 2   L G A R R
131520   %
131520   % ROUTINES TO GATHER SYSTEM AND PROGRAM STATISTICS
131520   % CALLED FROM TERMINAL OUTPUT DRIVER (LEVEL 10)
131520   % THE INFORMATION IS USED BY THE COMMAND "RT-PROGRAM-LOG"
131520   
131520   INTEGER HHISTART=?,HTESTPROG=?,HFLGHISTO=?
131520   INTEGER COMRTP,ALLRTP
131522   INTEGER ARRAY LGARR(0)
131522   SUBR LOG1,XHISTI
131522   INTEGER ACTC1,ACTC2,ACTP1,ACTP2        % NOTE THAT THESE VARIABLES CORRESPOND
131526   INTEGER SWC1,SWC2,SWP1,SWP2            % TO SYMBOLS DECLAIRED ON THE OPCOM SEGM
131532   INTEGER FILC1,FILC2,FILP1,FILP2        % IN THE RT-PROGRAM-LOG COMMAND
131536   INTEGER DIC1,DIC2
131540   INTEGER PASP1,PASP2
131542   INTEGER IOWP1,IOWP2
131544   INTEGER TOTL1,TOTL2
131546   INTEGER U1T1,U1T2,U1P1,U1P2
131552   INTEGER U2T1,U2T2,U2P1,U2P2
131556   INTEGER ADRSWP,ADRU1,ADRU2
131561   INTEGER LOGFIELD,TESTPROG
131563   INTEGER PTOT1,PTOT2
131565   INTEGER INCRL,CINCR
131567   
131567   INTEGER POINTER PTESTPROG=?
131567   
131567   % SUBROUTINE TO GET STATISTICS
131567   % B=TERMINAL OUTPUT DATAFIELD
131567   % FOR VSX: X=ADDR OF RESIDENT DATAFIELD
131567   LOG1:
131567   @LIB CXCPU-,
131567          IF LOGFIELD><B THEN EXIT FI
131573   @ELIB
131573   @LIB CXCPU
131573          MIN CINCR; EXIT; INCRL=:CINCR  % INTERRUPTS BETWEEN SAMPLES
131577          IF COMRTP=0 GO TALLRTP
131601   @LIB CXCPU
131601   @LIB CXCPU-,
131601          IF "F1202".RTRES><RTRES THEN
131606   @ELIB
131606                IF ALLRTP=0 THEN 0=:LOGFIELD FI; 0=:COMRTP
131612                EXIT; *)FILL
131616          FI; *TRA PVL
131617          IF A SH 11 SHZ -14><0 THEN; *MIN ACTC2; SKP; MIN ACTC1; RAND
131626                IF PTESTPROG=CURPROG THEN; *MIN ACTP2; SKP; MIN ACTP1; RAND
131636          FI    FI
131636          IF "CLFIE".RTRES><0 AND A><"1SWAP" THEN; *MIN SWC2; SKP; MIN SWC1; RAND
131650                IF =PTESTPROG THEN; *MIN SWP2; SKP; MIN SWP1; RAND
131657          FI    FI; GO L1; *)FILL
131663   INTEGER POINTER PTESTPROG:=TESTPROG
131664   L1:    IF ADRSWP.RTRES=:D><0 THEN; *MIN DIC2; SKP; MIN DIC1; RAND
131674                IF "CLFIE".RTRES=0 OR A="1SWAP" THEN; *MIN FILC2; SKP; MIN FILC1; RAND
131706                  IF D=PTESTPROG THEN; *MIN FILP2; SKP; MIN FILP1; RAND
131715          FI    FI FI
131715          IF PTESTPROG.WLINK=0 THEN; *MIN PASP2; SKP; MIN PASP1; RAND
131724          FI
131724          IF X.STATUS BIT 5WAIT THEN; *MIN IOWP2; SKP; MIN IOWP1
131732          FI
131732          *MIN TOTL2; SKP; MIN TOTL1; RAND
131736          IF ADRU1><0 THEN
131740                IF A.RTRES><0 THEN; *MIN I (U1T2; SKP; MIN I (U1T1; RAND
131747                   IF A=PTESTPROG THEN; *MIN I (U1P2; SKP; MIN I (U1P1; RAND
131756          FI    FI   FI
131756          IF ADRU2><0 THEN
131760                IF A.RTRES><0 THEN; *MIN I (U2T2; SKP; MIN I (U2T1; RAND
131767                   IF A=PTESTPROG THEN; *MIN I (U2P2; SKP; MIN I (U2P1; RAND
131776          FI    FI   FI
131776   TALLRTP: IF ALLRTP=0 THEN EXIT FI
132001   @LIB CXCPU-,
132001          IF "F1352".RTRES><RTRES THEN EXIT FI
132007   @ELIB
132007   @LIB CXCPU
132007          CURPROG-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
132015          A SH 1+"PGARR"=:X; *MIN 1,X; SKP; MIN ,X; RAND
132024          *MIN I IPTO2; SKP; MIN I IPTO1; RAND
132030   *"8LOG 8HIST
"132030          IF HTESTPROG=PTESTPROG AND HFLGHISTO><0 AND HHISTART=0 GO XHISTI
132041   *"8LOG
"132041          EXIT
132042   INTEGER POINTER IPTO1:=PTOT1,IPTO2:=PTOT2
132044   RBUS
