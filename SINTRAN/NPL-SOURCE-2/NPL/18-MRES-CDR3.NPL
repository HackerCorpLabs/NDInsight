133112          INTEGER ORERR                   % OR FUNCTION OF ALL ERRORS
133112          INTEGER LHAST                   % LAST HARDWARE STATUS
133112          INTEGER SSTPC                   % # OF RECEIVER STOPPS
133112          INTEGER MAXEM                   % MAX # OF EMTY BUFFERS HELD BY RECExIVER
