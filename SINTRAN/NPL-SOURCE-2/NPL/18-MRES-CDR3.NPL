133112          INTEGER LBYTC                   % BYTECOUNT
133112          INTEGER LMEM1                   % MOUST SIGNIFICANT MEMORY ADDRESS
133112          INTEGER LMEM2                   % LEAST SIGNIFICANT MEMORY ADDRESS
133112          DOUBLE LMEM = LMEM1             % *81F*
133112          INTEGER LEOL                    % END OF LIST
133112   PSID
133112   %
133112   SYMBOL LMASK = 60377
133112   SYMBOL HX21M = 60000
133112   SYMBOL HX21S = 16
133112   SYMBOL HX21D = 15
133112   %
133112   %      LKEY VALUES
133112   %
133112   SYMBOL FSERM = 2003                    % FULL TRANSMITTER BLOCK
133112   SYMBOL FEOL  = 0                       % END OF LIST
133112   SYMBOL ERB   = 1000                    % EMTY RECEIVER BLOCK
133112   SYMBOL NLP   = 3000                    % NEW LIST POINTER
133112   SYMBOL XBLDN  =   10                   % BLOCK DONE
133112   %
133112   
133112   
133112   %      USER MESSAGE DECRIPTION
133112   
133112   SYMBOL CHEAD = 3                       % LENGTH OF USER HEAD
133112   SYMBOL BCHEA = CHEAD+CHEAD             % LENGTH OF USER HEAD IN BYTES
133112   DISP 0
133112          INTEGER XCFUNC                  % FUNCTION
133112          INTEGER CRET                    % RETURN STATUS INFO
133112          INTEGER ADSTA                   % ADDITIONAL STATUS INFO.
133112   %      LOCATIONS USED BY XMSG FUNCTIONS *81F*
133112          INTEGER XHBYT                   % BYTECOUNT OF RECEIVER FRAME
133112          DOUBLE XHBUF                    % RECEIVER DATA ADDRESS
133112          DOUBLE XMLIS = XHBYT            % ADDRESS OF TRANSMITTER LIST
