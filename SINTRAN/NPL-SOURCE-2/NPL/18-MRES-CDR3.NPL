133112          INTEGER HDERC                   % # OF ERROR TRANSFERS
133112          INTEGER DSTAT                   % OR FUNCTION OF BAD STATUS
133112          INTEGER STPCNT                  % # OF RECEIVER STOP
133112          INTEGER POINTER WTADR           % ADDRESS OF WT12 OR WT13
133112          INTEGER POINTER SRRES           % ADDRESS OF RESET ROUTINE
133112          INTEGER POINTER SRDAT           % ADDRESS OF TRANSFER ROUTINE
133112          INTEGER ACTSW                   % SET IF DRIVER RUNNING, INPUT ONLY(ALLWAYS 77 FOR OUTPUT) *81F*
133112          INTEGER MAINT                   % MAINTENANCE MODUS
133112          INTEGER HASTAT                  % HARDWARE STATUS
133112          INTEGER LISTP                   % POINTER TO DMA LIST
133112          INTEGER LIINT                   % LIST ELEMENT WAITING FOR INTERRUPT
133112          INTEGER LISTF                   % NEXT FREE LIST ELEMENT
133112          INTEGER OMSG                    % CURRENT MESSAGE
