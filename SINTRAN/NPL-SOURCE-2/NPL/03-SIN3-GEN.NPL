CKJU/
)KILL CKJU
]
047002  
047002  
047002  % MACRO FOR REMOTE TERMINAL OUTPUT RT-DESCRIPTION
047002  
047002  )MCDEF RTUP $NR,$LNR
RU$NR $LNR , 0;1061;0;0;0;0;RTOCH;0
       0;0;0;*-13
       0;0;0
]
047002  
047002  
047002  % MACRO FOR RWRT-PROGRAM FOR SIN/SIN CHANNEL INPUT
047002  
047002  )MCDEF RWCR $NR,$LNR
CR$NR $LNR , 0;1100;0;0;0;0;TR$NR $LNR ;6
       0;0;0;*-13
       0;0;0
]
047002  
047002  % MACRO FOR RWRT-PROGRAM FOR SIN/SIN CHANNEL OUTPUT
047002  
047002  )MCDEF RWCW $NR,$LNR
CW$NR $LNR , 0;1100;0;0;0;0;TW$NR $LNR ;6
       0;0;0;*-13
       0;0;0

]
047002  
047002  )MCDEF ACRTP
       NYRTP=NXRTP; )KILL NXRTP; NXRTP=NYRTP+1; )KILL NYRTP
]
