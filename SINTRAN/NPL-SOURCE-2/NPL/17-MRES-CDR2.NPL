126427          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DD; SBYT
126436          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DL
126444          A SHZ -10; *SBYT
126446          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DL; SBYT
126455          X+1; IF MAX=X THEN X:=0 FI; *IRR ALEVB DX
126463          A SHZ -10; *SBYT
