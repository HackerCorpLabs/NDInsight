127707          IF X+1=L THEN X:=BUFST FI; X.S0; *IRW ALEVB DX
127715          T:=10; BHOLD-T=:BHOLD; CFREE+T=:CFREE; A:=T; *IRW ALEVB DT
127726          IF X+1=L THEN X:=BUFST FI; A:=X-BUFST SHZ 1=:HENTE
