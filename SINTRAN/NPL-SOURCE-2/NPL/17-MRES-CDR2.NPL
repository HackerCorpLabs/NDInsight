130032   *"8CXHD+8C1X2+8C2X2+8C3X2+8C4X2
"130032   

130032   %========================================================================
130032   % 39.12
130032   %      H D L C    A C T 1 2    A C T 1 3
130032   %      HDLC -  NONE-RESIDENT PART
130032   %
130032   % ENTRY:  B-REG POINTS TO DATAFIELD
130032   %
130032   %         POF, ION, LEV 3 DISABLED
130032   %
130032   INTEGER POLSZ=?
130032   SUBR HDLC,ACT12,ACT13,IMHDLC
130032   %
130032   DISP -1; INTEGER BCOMT; PSID
130032   INTEGER MESSM:=0                       %INCREMENTED FOR EACH SEND
130033   HDLC:  A:=L=:"RSRET"                   %SAVE RETURN ADDRESS
130035          IF HINIF >< -1 THEN             % POOL INITIATED ?
130041            MASTB =: XXSBK                % BANKNO TO COPY ROUTINE
130043            MAX -1 SHZ -1 + BUFST =: D; A:=BUFST
130051            X:=B; T:=MASTB; *AAX XBBNK
130054            CALL ZBINI; CALL PZCRA; -1=:HINIF       %MARK AS INITIATED
130060          FI
130060          IF DDD0 = FSEND THEN
130064   % 
130064   % SEND
130064   %
130064             IF DDD3 < 0 THEN T:=EMSGS; GO RSRET FI    %ILLEGAL MESSAGE SIZE
130070             IF A > DDD4 THEN T:=EMAXS; GO RSRET FI    % MAX SIZE < USED SIZE
130075             X:="XBBNK"+B; "BHEAD+BHEAD"+DDD4; CALL ZBGET; CALL ZCRAS  %ALLOCATE BUFFER
130103             IF A = 0 THEN T:=ENBUF; GO RSRET FI
130106             A=:RSCUR=:X                               %USER PART OF MESSAGE
130110             IF MESSM + 1 < 0 THEN 1=:MESSM FI        %ONLY POSITIVE VALUES
130115             A=:MESSM=:MESSID; T:=MASTB; * BBID@3 STATX
130121             DDD4; * BMBYT@3 STATX                     %MAX BYTECOUNT IN MESSAGE
130123             DDD3; * BBYTC@3 STATX
130125             "OCHAIN"; *XCAHI@3 STATX                  % NOT XMSG DCB
130127             DDD2=:XXUBF; T:=DDD3=:D; X+BHEAD=:XXSBF; *AAB XXUBF 
130136             CALL Z0PHY; * AAB -XXUBF; IOF             % COPY USER DATA TO BUFFER% SET MESSAGE IN QUEUE
130141             X:=RSCUR; CALL ICHAIN; *ION               % SET MESSAGE IN QUEUE
130144             CALL STDEV                                % ACTIVATE DRIVER
130145             0=:T; GO RSRET;
130147          FI
130147   %
130147   % RECEIVE
130147   %
130147   REMSG: *IOF
130150          CALL DOCHAIN; GO CHEMTY                   %REMOVE MESSAGE FROM QUEUE
130152          *ION
130153          X=:RSCUR; T:=MASTB; * BBID@3 LDATX
130156          A=:MESSID                                 %MESSID OF CURRENT MESSAGE
130157          * BBYTC@3 LDATX
130160          A=:T
130161          IF DDD0-FMXRECV=0 AND DDD3<<T THEN
130167             T:=EMSGS=:DDD0; T:=A                   % ERROR, DCB GREATHER THAN SPECIFIED IN PARAMETER #4
130172          ELSE
130173             0=:DDD0
130174          FI; CALL STUSP;                           %BYTECOUNT TO USER
130175   IMHDLC:                                          % STUSP GOES HERE
130175          DDD2=:XXUBF; T=:D
130200          X:=RSCUR; X+BHEAD=:XXSBF; * AAB XXUBF
130204          CALL Z0USR
130205          * AAB -XXUBF; COPY SB DX; AAX XBBNK
130210          RSCUR; CALL ZBREL; CALL ZCRAS             %RELEASE BUFFER
130213          T:=DDD0; GO RSRET                         %GO BACK TO RESIDENT PART
130215   *)FILL
130231   %
130231   %
130231   CHEMT: DDD4=:XWAITF
130233          IF A = 1 THEN
130236                X:=CURPR; CALL WDATA
130240                *ION
130241                B+OFSET; ZPREG-1=:ZPREG
130245                CALL RETSTUPR
130246          ELSE
130247                *ION
130250                T:=EEMTY; GO RSRET
130252          FI
130252          GO RSRET
130253   %
130253   PZCRA: IF A = 2 THEN T:=ENBUF; GO RSRET; FI
130260          CALL ZCRAS
130261   %
130261   %      ROUTINES FOR ACTIVATION OF DRIVER PART
130261   %
130261   ACT12: IF WAKEF = 1 THEN EXIT FI
130266          T:="STDRIV"; D:=L; CALL STL12; D=:P       %*80B*
130272   %
130272   %
130272   ACT13: IF WAKEF = 1 THEN EXIT FI
130277          T:="STDRIV"; D:=L; CALL STL13; D=:P                 %*80B*
130303   RBUS
130311   

130311   %=======================================================================
130311   % 39.14     I C H A I N    O C H A I N
130311   %      HDLC - CHAINING ROUTINES
130311   %
130311   %
130311   %PURPOSE: ENTER OR REMOVE ENTRIES IN THE DRIVER QUEUE
130311   %
130311   %METHOD:     THE QUEUES ARE ARRANGED AS FIFOS.
130311   %            THE LINKING IS ONE WAY ONLY.
130311   %            0 IN THE LINKWORD IS USED T MARK END OF QUEUE.
130311   %            THE HEAD OF THE QUEUES IS IN THE APPROPRIATE DATAFIELD.
130311   %            IQUEU FOR INPUT, AND OQUEU FOR OUTPUT.
130311   
130311   %            CHANGED FOR I VERSION:
130311   %            THE QUEUES MAY NOW APPEAR OUTSIDE BANK 0
130311   %            THE "MASTB" LOCATION IN DATAFIELD HOLDS THE BANK NUMBER
130311   
130311   %ICHAIN: SET MESSAGE IN INPUT QUEUE (TO DRIVER)
130311   %OCHAIN: SET MESSAGE IN OUTPUT QUEUE (FROM DRIVER)
130311   %
130311   %ENTRY:  B-REG   DATAFIELDPOINTER
130311   %        X-REG   MESSAGEPOINTER (ICHAIN ONLY)
130311   %
130311   %EXIT:   B-REG   DATAFIELDPOINTER
130311   %        X-REG   MESSAGEPOINTER (OCHAIN ONLY)
130311   %
130311   SUBR ICHAIN,OCHAIN
130311   ICHAIN: IF IQUEU =0 THEN                                   % AM I ALONE ?
130313             X=:IQUEU; T:=MASTB; * BCHAI@3 STATX              % YES, 0 IN NEXT POINTER
130316             EXIT
130317           FI 
130317           GO ICOC                                            % NO, LINK IN AT END OF LIST
130320   OCHAIN: T:=MASTB; * XCHAI@3 LDATX
130322           IF A >< "OCHAIN" THEN                              % SPECIAL CHAINING ROUTINE *81F*
130325             IF A >> XBSTR AND A << XBEND THEN EXIT FI        % CHECK POINTER
130334             *ION; COPY SA DP                                 % RETURN TO "CALL OCHAIN"  *81F*
130336           FI
130336           IF ISTATE >< 0  THEN L=:D; CALL RTACT; D=:L; FI
130343           IF OQUEU =0 THEN                                   % AM I ALONE?
130345             X=:OQUEU; T:=MASTB; * BCHAI@3 STATX              % YES, 0 IN LINK WORD
130350             EXIT
130351           FI
130351   ICOC: X=:D:=A; T:=MASTB
130354      DO WHILE A >< 0
130355          A=:X; * BCHAI@3 LDATX
130357      OD
130360          A:=D; * BCHAI@3 STATX                     % LINK IN AT END OF LIST
130362          A=:X:=0; * BCHAI@3 STATX                  % 0 AT END OF LIST
130365          EXIT
130366   RBUS
130370   
130370   
130370   %=======================================================================
130370   % 39.15     D I C H A I N    D O C H A I N
130370   %
130370   %DICHAIN: REMOVE OLDEST ENTRY FROM INPUT QUEUE (TO DRIVER)
130370   %DOCHAIN: REMOVE OLDEST ENTRY FROM OUTPUT QUEUE (FROM DRIVER)
130370   %TSTCH:   ANY MESSAGE IN DRIVER QUEUE.
130370   %
130370   %ENTRY:  B-REG  DATAFIELDPOINTER
130370   %
130370   %EXIT:   B-REG  DATAFIELDPOINTER
130370   %        X-REG  MESSAGEPOINTER
130370   %
130370   %        SKIP RETURN - MESSAGE FOUND
130370   %        NO SKIP     - EMTY QUEUE
130370   %
130370   SUBR DICHAIN,DOCHAIN,TSTCH
130370   TSTCH:   IF IQUEU><0 THEN EXITA FI EXIT
130374   DICHAIN: IF IQUEU =0 THEN 0=:WAKEF; EXIT FI
130400            X:=A; T:=MASTB; * BCHAI@3 LDATX
130403            A =:IQUEU; 1=:WAKEF; EXITA;
130407   DOCHAIN: IF OQUEU =0 THEN
130411                IF DDD4 = 0 THEN -1=:ISTATE FI
130415                EXIT
130416            FI
130416            X:=A; T:=MASTB; * BCHAI@3 LDATX
130421            A=:OQUEU; 0=:ISTATE; EXITA;
130424   RBUS
130424   

130424   %=======================================================================
130424   % 39.16
130424   %      Z C R A S             INCONSISTENSY IN HDLC NONRESIDENT PART
130424   %
130424   %      T-REGISTER WILL CONTAIN OLD L-REGISTER WHEN STOP IN ERRFATAL
130424   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
130424   %
130424   SUBR ZCRAS
130424   INTEGER DHAAA                                  % ERRCODE
130425   INTEGER DHLLL                                  % WHERE I COME FROM
130426   ZCRAS: A=:DHAAA; A:=L=:DHLLL
130431          L=:T; A:=B+OFSET=:B; CALL 9ERR(#33)
130437          B-OFSET=:B; T:=HXERF; GO RSRET
130443   RBUS
130444   

130444   *"
"130444   *"8PIOC
"130444   @LIB OLDPIOC
130444   *"
"130444   
130444   %==========================================================================
130444   %      P R T C G P L O C
130444   %
130444   % SUBROUTINE TO THE RTCGPLOC IN RESIDENT
130444   % MUST BE CALLED IN PIOF.
130444   %
130444   SUBR PRTCGPLOC
130444   INTEGER TREG,AREG,DREG,CCDISP; TRIPLE SVTAD=TREG
130450   INTEGER ARRAY POINTER ACCTAB:=CCTAB
130451   PRTCGPLOC:
130451          TAD=:SVTAD; X=:XRG; A:=X/\1777=:CCDISP:=X SHZ -12+100=:D; X:=0
130463          DO WHILE ACCTAB(X)><-1
130467             IF A/\377=D THEN
130472                X+1; A:=ACCTAB(X)=:D:=0; AD SH 12; X:=CCDISP
130500                X+D; T:=A
130502                IF TREG=0 THEN
130504                   *LDATX; STA AREG
130506                ELSE
130507                   AREG; *STATX
130511                FI; GO  OUT
130512             FI; X+2
130513          OD; L-1
130515   OUT:   TAD:=SVTAD; X:=XRG; EXITA
130520   RBUS
130522   
130522   
