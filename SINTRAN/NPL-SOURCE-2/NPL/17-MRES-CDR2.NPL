127557          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % ( 2.BYTE)
127566          A\/CCHAR; *IRW ALEVB DA
127570          IF X+1=L THEN X:=0 FI; *LBYT                        % ( 3.BYTE)
127575          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % ( 4.BYTE)
127604          A\/CCHAR; *IRW ALEVB DD
127606          IF X+1=L THEN X:=0 FI; *LBYT                        % ( 5.BYTE)
127613          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % ( 6.BYTE)
127622          A\/CCHAR; *IRW ALEVB DL
127624          IF X+1=L THEN X:=0 FI; *LBYT                        % ( 7.BYTE)
127631          A SHZ 10; A=:CCHAR; IF X+1=L THEN X:=0 FI; *LBYT    % (10.BYTE)
127640          A\/CCHAR; *IRW ALEVB DX
127642          T:=10; A:=T; *IRW ALEVB DT
127645          BHOLD-T=:BHOLD; CFREE+T=:CFREE
127653          IF X+1=L THEN X:=0 FI; X=:HENTE; *ION
