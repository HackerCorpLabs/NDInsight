111335   % 37.5       I O A P D   O O A P D
111335   %
111335   % SUBROUTINES TO READ AND WRITE A CHARACTER USING IOXT!!!!!!!
111335   
111335   SUBR IOAPD,OOAPD,XOOAPD
111335   INTEGER ERRCODE,IOXNO
111337   IOAPD: T:=HDEV+DST; *IOXT
111342          A =: D                                    % STATUS
111343          T+"DDR-DST"; *IOXT                        % BYTE IN A
111345          IF D BIT 13 THEN                          % CARRIER MISSING?? 
111347                IF TYPRING BIT 5TERM THEN           % TERMINAL      
111352                   DFLAG BONE 5LBRK=:DFLAG
111355                   -2=:TMR                          % START TIME-OUT IN 2 SEC.
111357                FI
111357                L =: D                              % SAVE RETUR-ADRESS
111360                CALL CLBUF ; L := D                 % CLEAR BUFFER
111362                EXIT
111363          ELSE
111364             T:=DFLAG BZERO 5LBRK=:DFLAG            % LINE IS OK
111367          FI
111367          IF D BIT 4 THEN
111371             T:=TINFO
111372             IF D BIT 5 THEN T BONE 5FRER ELSE T BONE 5PAER FI; T=:TINFO
111400             IF A=0 THEN
111401                IF CESCP/\377><LAST GO SIMESC
111406             FI
111406             CNTREG; T:=HDEV+DCONT; *IOXT
111412             TTMR=:TMR; EXIT
111415          FI
111415   SIMESC: A=:D; CNTREG; T:=HDEV+DCONT; *IOXT
111422          D=:A; EXITA
111424   
111424   OOAPD: A=:D                                      % SAVE CHAR IN D
111425          T:=HDEV+DST; *IOXT
111430          IF BIT 3 THEN                             % READY!!!
111432             D=:A
111433   XOOAPD:   T:=HDEV+DDW; *IOXT                     % WRITE CHAR TO INTERFACE
111436          FI
111436   OUTRA: "DACT+DPIN"; T:=HDEV+"DCONT"; *IOXT       % RE-ACTIVATE.
111442          EXIT
