111664   % 40.1       T E L I N   T E L E N T
111664   %
111664   *"TELIX
"111664   %
111664   % SIMPLE DRIVER FOR TELETYPE INTERFACE
111664   % BREAK ON EVERY CHARACTER, NO ECHO, NO MODIFICATIONS OF THE BYTES
111664   % LEVEL 12
111664   %
111664   
111664   SUBR TELIN,TELENT
111664   INTEGER ERRCODE,IOXNO
111666   @LIB CXCPU
111666   TELIN: TTMR=:TMR;CALL ID12
111671   TELENT:
111671   @LIB CXCPU
111671   @LIB CXCPU-,
111671          X:=DFOPP
111672   @ELIB
111672          T:=HDEV+"DST"; *IOXT            % READ STATUS
111675          IF A BIT 4 THEN       % ERROR
111677                A=:ERRCODE; A BONE 17=:DERROR; T-"DST"=:IOXNO; T+"DDR"; *IOXT
111706                A=:D; T+"DST-DDR"; *IOXT  
111711                IF A BIT 3 GO ERR; GO L1
111714          ELSE
111715          T+"DDR-DST"; *IOXT    % READ DATA
111717          FI; A=:LAST; T+"DST-DDR"; *IOXT  
111722          IF A BIT 3 GO ERR
111724   L1:    CNTREG; T+"DCONT-DST"; *IOXT     % PIN DEV
111727          A:=LAST; CALL XONCHECK
111731          CALL XONREAD; GO CONT1
111733          A := LAST
111734   % TEXT EDITING TERMINAL CONVERTING ROUTINE
111734   *"TELIX 7TEXT
"111734   CONT1:
111734   @LIB CXCPU
111734   @LIB CXCPU-,
111734          CALL RBPUT; CALL RTACT
111736   @ELIB
111736          GO TELIN
111737   ERR:   T:=HDEV; A:=:T; CALL 9ERR(#23); 232=:DERROR
111745   @LIB CXCPU
111745   @LIB CXCPU-,
111745          IF RTRES><0 THEN CALL RTACT FI
111750   @ELIB
111750          CALL ID12; GO ERR22
111752   RBUS
