110741   *"8XON
"110741   %=====================================================================
110741   %            X O F T R      
110741   %      37.20
110741   %
110741   % THIS ROUTINE IS AN ALTERNATIVE TO NORMAL XOFF/XON CHECKING AND
110741   % REQUIRES XOFF/XON TO BE IN SEQUENCE. ANY OTHER COMBINATION WILL
110741   % BE TREATED AS NORMAL DATA CHARACTERS.
110741   % THE ROUTINE IS ACTIVATED BY ENTERING IT'S ADDRESS IN THE ROUSPEC
110741   % LOCATION IN THE TERMINAL INPUT DATAFIELD. THE ROUTINE IS CALLED
110741   % AT THE START (D=0) AND AT THE END (D=1) OF THE DRIVER.
110741   % FIRST PART (D=0) PERFORMS THE XOFF/XON CHECKING WILE THE LAST PART
110741   % (D=1) PERFORMS BRANCHING ACCORDING TO RESULTS FROM FIRST PART.
110741   
110741   SUBR XOFTR
110741   SYMBOL IXOFF=3,IDATA=4,OPIN=5
110741   XOFTR: IF T:=DFLAG BIT 5XDEVICE THEN   % XOFF/XON CHECKING FOR THIS TERMINAL?
110744             IF D=0 THEN                                      % TEST CHARACTERS
110746                A BZERO 7=:LAST=:D
110751                IF T:=BRECHOFL NBIT IXOFF THEN      % X O F F   T E S T
110754                   IF "XOFF"=D THEN
110757                      T BONE IXOFF BZERO IDATA=:BRECHOFL
110762                      T:=DFLAG BONE 5OXON=:DFLAG              % STOP OUTPUT
110765                      0=:X.TMR; L-1
110767                   FI; A:=LAST; EXITA
110771                ELSE                                % X O N   T E S T
110772                   IF D="XON" THEN                            % IGNORE CHARACTERS
110775                      T:=BRECHOFL BZERO IXOFF BZERO IDATA=:BRECHOFL
111001                      T:=DFLAG BZERO 5OXON=:DFLAG
111004                      T:=X.HDEV+DCONT
111006                      A:=1; *IOXT                             % PIN OUTPUT
111010                      EXIT
111011                   ELSE
111012                      A SHZ 10+"XOFF"=:LAST                   % DATA CHARACTERS
111015                      T:=BRECHOFL BONE IDATA BZERO IXOFF=:BRECHOFL
111021                      EXITA
111022                   FI   
111022                 FI    
111022             ELSE                                   % R E T U R N   C H E C K
111023                IF T:=BRECHOFL BIT IDATA THEN
111026                   T BONE OPIN BZERO IDATA=:BRECHOFL
111031                   LAST SHZ -10=:LAST
111034                   EXIT                                       % NEW CHARACTER
111035                FI
111035                IF T:=BRECHOFL BIT OPIN THEN
111040                   T BZERO OPIN=:BRECHOFL
111042                   DFLAG BZERO 5OXON=:DFLAG
111045                   T:=X.HDEV+DCONT
111047                   A:=1; *IOXT                                % PIN OUTPUT
111051                FI
111051                EXITA
111052             FI
111052          ELSE
111053             IF D=0 THEN
111055                A BZERO 7=:LAST; 0=:BRECHOFL
111060             FI
111060          FI
111060          EXITA
111061   RBUS
