111077          IF BHOLD<T AND OISTAT><0 THEN
111104   @LIB CXCPU-,
111104             "IORESTART"=:MFUNC;  CALL XRTACT
111107   @ELIB
111107   @LIB CXCPU
111107          FI
111107          IF SCREEN><0 THEN
111111             IF A>24 THEN 207; CALL OOAPD; 0=:EMPTFLAG; -1=:SCREEN FI
111121             IF A<0 GO FAR OUT
111123          FI; CALL OXONCHECK; GO CALLOOAPD          % SEND 'XON/XOFF'
111125          CALL XONWRITE; GO FAR OUT                 % TEST FOR XOFF.
111127   NOXON: IF BHOLD >< 0 THEN
111131             T:=HDEV+DST; *IOXT
111134             IF BIT 3 THEN                     % READY FOR TRANSFER AND CARRIER NOT MISSING
111136                IF TYPRING BIT 5CRDLY THEN
111141                   CALL CHDL2
111142                ELSE
111143                   IF A BIT 5TERM THEN CALL CXRBGET ELSE CALL RBGET FI
111150                FI
111150   NOCH:        IF T:=SCREEN>0 THEN
111153                   IF =12 THEN MIN SCREEN FI
111157                   IF =14 THEN T+24=:SCREEN FI
111164                   GO CALLOOAPD; *)FILL
111202                FI
111202   CALLOOAPD:   CALL XOOAPD; 0=:EMPTFLAG; TTMR=:TMR
111206                IF X><0 THEN X.DFLAG BZERO 5LBRK=:X.DFLAG FI  % LINE IS OK
111212             ELSE
111213                T:=HDEV+"DCONT"; "DPIN+DACT"; *IOXT           % PIN DEVICE.
111217                TTMR =: TMR                                   % START TIME-OUT
111221                IF X><0 THEN
111222                   IF X.TYPRING BIT 5TERM THEN                % SPEC. FOR TERMINALS
111225                      T := X.HDEV + DST; * IOXT               % READ INPUT STATUS.
111230                      IF BIT 4 OR BIT 13 THEN                 % IF ERROR
111234                         IF BIT 13 THEN                       % CARR. MISSING 
111236                            X.DFLAG BONE 5LBRK=:X.DFLAG       % FLAG CARRIER MISSING
111241                            -2=:X.TMR                         % SET INPUT TIME-OUT IN 2 SEC.
111243                         FI; T:=HDEV+"DCONT"; "DACT"; *IOXT   % UNPIN DEVICE
111247                         CALL CLBUF                           % CLEAR BUFFER
111250   @LIB CXCPU
111250   @LIB CXCPU-,
111250                         IF RTRES><0 THEN CALL XRTACT FI % ACTIVATE USER
111253   @ELIB
111253   EFI:      FI; FI; FI; FI
111253          ELSE            
