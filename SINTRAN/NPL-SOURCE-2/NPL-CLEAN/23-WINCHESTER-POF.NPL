%
% *"8WDIS+8WDIM+8ZWDI
"8WDIS+8WDIM+8ZWDI
%

% *)9SLPL
)9SLPL
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %                                                                                 %
 %   FILE NAME   : WINCHESTER:NPL                                                  %
 %   PROGRAM NO. : HUT-2475 A.6                                                    %
 %   ISSUED      : 82.02.18             BY: DG AND TP                              %
 %                                                                                 %
 %   LAST CHANGED: 83.10.03             BY: MJH                                    %
 %   LAST CHANGED: 85.09.04             BY: KGT USE AD-REG FOR SECTOR ADDRESS      %
 %                                                                                 %
 % T R A N S F E R   R O U T I N E   F O R    8"   W I N C H E S T E R    D I S K  %
 %                                                                                 %
 % INCLUDING BAD TRACK REALLOCATION, BUT NO ERROR CORRECTION                       %
 %                                                                                 %
 %                                                                                 %
 %                                                                                 %
 % CALLING SEQUENCE:                                                               %
 %      JPL I (WIDIS          % OR  JPL I (ZWDIS  IF SWAP DRIVER                   %
 %      JMP   ERROR           % ERROR    EXIT                                      %
 %      JMP   BUSY            % BUSY     EXIT                                      %
 %      JMP   FINIS           % FINISHED EXIT                                      %
 %                                                                                 %
 % CALLING PARAMETERS:                                                             %
 %      X-REG = NUMBER OF SECTORS TO TRANSFER                                      %
 %      T-REG (BIT 0-5)  = FUNCTION CODE:                                          %
 %                          0 - READ                                               %
 %                          1 - WRITE                                              %
 %                          2 - READ PARITY                                        %
 %                          3 - COMPARE                                            %
 %                         20 - READ STATUS                                        %
 %             BIT  6-7  = UNIT NUMBER                                             %
 %             BIT     8 = TRACK TEST                                              %
 %             BIT     9 = NOT USED                                                %
 %             BIT    10 = LATE DATA STROBE
 %             BIT 11-13 = NOT USED                                                %
 %             BIT    14 = EARLY DATA STROBE                                      %
 %             BIT    15 = BAD TRACK                                               %
 %      AD-REG = SECTOR ADDRESS (LOGICAL)                                           %
 %                                                                                 %
 %      THE MEMORY ADDRESS (24 BITS) IS FOUND IN THE DATAFIELD DOUBLE WORD CMAD1   %
 %                                                                     AND CMAD2   %
 %                                                                                 %
 %                                                                                 %
 % RETURN INFORMATION:                                                             %
 %      ERROR    EXIT: X = HARDWARE STATUS                                         %
 %      BUSY     EXIT: THE ROUTINE MUST BE CALLED AFTER INTERRUPT                  %
 %      FINISHED EXIT: X = HARDWARE STATUS                                         %
 %                                                                                 %
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

 *"8ZWDI -8WDIS
"
 *ZWDIS, JMP   WISTA

 *"8WDIS+8WDIM
"
 SYMBOL ACTIV=2 , ICERR=4 , ADDMI=10 , ONCYL=16 , TEST=10

 % LOCAL VARIABLES IN DRIVER ------------------------------------------

 INTEGER IRETR:=-4
 INTEGER 9TREG     % SAVED T-REG IN CALL
 INTEGER 9AREG     % SAVED A-REG IN CALL
 INTEGER 9DREG     % SAVED D-REG IN CALL
 INTEGER 9XREG     % SAVED X-REG IN CALL
 INTEGER SSTAT     % SAVED HARDWARE STATUS
 TRIPLE SATAD=9TREG


 % DATA FIELD VARIABLES USED BY THE DRIVER:
 %
 % ADMIA      SAVED ADDR MISMATCH BLOCK ADDR
 % ADMIS      SAVED ADDR MISMATCH STATUS
 % ALTPO      ADDRESS OF ALTERNATIVE TRACK POINTER
 % BADDR      BAD ADDR
 % BADIP      BAD ADDR IN PROCESS (EXTRA ADDRESS BIT)
 % BADTR      BAD TRACK FLAG
 % BUSFL      BUSY FLAG
 % CMAD1      MEM ADDR
 % CMAD2       "   "
 % ERRC1      RETRY COUNTER
 % HDEV       DEVICE NUMBER (0500,0510)
 % HTABL(2)   DISK DESCRIPTOR TABLE
 % LCYLI(2)   LAST CYLINDER
 % NOSEC      NO. OF SECTORS IN TRANSFER
 % RTZFL      RETURN-TO-ZERO FLAG
 % SEEKF      SEEK FLAG
 % SHEAD      HEAD NO.
 % SSEC       NO. OF SECTORS IN LAST TRANSFER
 % SSTEP      SAVED LAST STEP COUNT
 % SVLBB      SAVED DISK ADDR (CYLINDER AND SECTOR)
 % SVLCA      SAVED LEAST MEM ADDR
 % SVLCO      SAVED CONTROL WORD
 % SVLWC      SAVED WORD COUNT
 % TRTZ       RETURN-TO-ZERO FLAG
 % WANKN      SAVED MOST MEM ADDR


 % DISK TYPE SPECIFICATION:   -------------------------------------------

 INTEGER WSECW        % WORDS/SECTOR
 INTEGER WSECT        % SECTORS/TRACK
 INTEGER WSECY        % SECTORS/CYLINDER
 INTEGER WMXCY        % MAX CYL. VALUE
 TRIPLE  DISDE=WSECW
 DISP 0 ; TRIPLE CDISD ; INTEGER CMAXC ; PSID
 INTEGER STAT1=?
 INTEGER STAT3=?

 *"8ZWDI -8WDIS
"
 *)KILL WSECW WSECT WSECY WMXCY

 *"2W1U0+2W2U0 8ZWDI -8WDIS
"
 *WSECW, 01000
 *WSECT, 011
 *WSECY, 110
 *WMXCY, 01775

 *"3M1U0+3M2U0 8ZWDI -8WDIS
"
 % DRIVER INITIALIZE ------------------------------------------------

 SUBR WIDIS

 % IOX DISPLACEMENTS:

 SYMBOL RMAR=0       % READ MEMORY ADDRESS REGISTER
 SYMBOL LMAR=1       % LOAD MEMORY ADDRESS REGISTER
 SYMBOL RSEEK=2      % READ SEEK CONDITION
 SYMBOL LDAD=3       % LOAD DISK   ADDRESS REGISTER
 SYMBOL RSTAT=4      % READ HARDWARE STATUS
 SYMBOL LCONT=5      % LOAD CONTROL WORD
 SYMBOL RDAD=6       % READ DISK ADDRESS REGISTER
 SYMBOL LWORD=7      % LOAD WORDCOUNT
 SYMBOL IOXIN=164500 % IOX 500 DISC SYSTEM 1
 SYMBOL IOXRS=164004

 *"8WDIM
"

 %        WDISC:
 %  >>>>>>>>>>>>V
 %              V
 %              V
 %   -----------V----------------- YES
 %   * IS IOX STAT1 OR IOX CONT4 >>>>>>>>>>>>>>>>>>>V
 %   * WRONG                     *                  V
 %   -----------V-----------------          --------V------------
 %              V NO                        * GENERATE AL IOX'S *
 %              V                           --------V------------
 %              V                                   V
 %              V<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
 %              V
 %   -----------V---------------------
 %   * READ STATUS. SAVE IT IN SSTAT *
 %   -----------V---------------------
 %              V
 %         -----V---- YES
 %         * BUSY ? >>>>>>>> WBUSY:
 %         -----V----
 %              V NO
 %         -----V--------- YES
 %         * ON CYLINDER ? >>>>>>>> RETZ:
 %         -----V---------
 %              V NO
 %     NO  -----V-------- YES
 %    <<<<<< BUSFL><0 ? >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
 %    V    --------------                                  V
 %    V                                                    V
 %  --V-------------------------------------   ------------V------------
 %  * SELECT UNIT AND READ STATUS AND SAVE *   * INCLUSIVE OR OF ERROR * YES
 %  * RESET SEEKF, BADTR, RTZFL AND TRTZ   *   * IN STATUS ?           >>>>>>>> IERR:
 %  --V-------------------------------------   ------------V------------
 %    V                                                    V NO
 %    V                                             -------V----- YES
 %  --V-------------                                * TRTZ><0 ? >>>>>>>> DSEEK:
 %  * IS OPERATION *                                -------V-----
 %  * READ STATUS  * YES                                   V NO
 %  * (20) ?       >>>>>>>>>> DFIN:                 -------V------ YES
 %  --V-------------                                * SEEKF><O ? >>>>>>> RWDIS:
 %    V NO                                          -------V------
 %  --V-------------                                       V NO
 %  * IS OPERATION * YES                         ----------V-------------- NO
 %  * >=4 ?        >>>>>>> DILLC:                * MAR=OLDMAR+OLDWORDC ? >>>>>>> MEMER:
 %  --V-------------                             ----------V--------------
 %    V NO                                                 V YES
 %    V                                                ----V--------- YES
 %    V                                                * BADTR><0 ? >>>>>>>> DBAD:
 %    V                                                ----V---------
 %    V                                                    V NO
 %    V>>>>>>>>>>>>>>>>V<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<V
 %                     V
 %                 ----V---- YES
 %                 * X=0 ? >>>>>>> DFIN:
 %                 ----V----
 %                     V NO
 %                     V>>>>>>>>>> DSEEK:


 WISTA: TAD=:SATAD ; X=:9XREG           % SAVE T,A,D,X

 *"8WDIS+8WDIM
"
        IF A:=HDEV+IOXRS-STAT1><0 OR A+STAT1-STAT3><0    % TEST FIRST & LAST IOX
           THEN                                                        % IF NOT INITIALIZED THEN DO SO
             A:=HDEV+IOXRS  ; * STA    STAT1; STA    STAT2; STA I (STAT3
             A+"LDAD-RSTAT" ; * STA I (DAD1 ; STA I (DAD3
             A+"RDAD-LDAD"  ; * STA I (DAD2
             A+"LMAR-RDAD"  ; * STA I (LMAR1; STA I (LMAR2; STA I (LMAR3; STA I (LMAR4
             A+"LCONT-LMAR" ; * STA    CONT1; STA    CONT2; STA I (CONT3; STA    CONT4; STA I (CONT5; STA I (CONT6
             A+"LWORD-LCONT"; * STA I (WORD1; STA I (WORD2; STA I (WORD3; STA I (WORD4
             A+"RMAR-LWORD" ; * STA    RMAR1; STA    RMAR2
        FI

 % DRIVER MAIN ENTRY -----------------------------------------------

 *STAT1, IOXIN RSTAT                              % READ STATUS
         A=:SSTAT
         IF A BIT ACTIV  GO FAR WBUSY             % GO IF CONTROLLER BUSY
         IF A NBIT ONCYL GO FAR RETZ              % IF NOT ON CYLINDER, ERROR, RECALIBRATE
         IF T:=BUSFL><0                           % IF LAST LEAVE WAS A BUSY RETURN
            THEN                                  % THEN  OLD TRANSFER IS TO BE CHECKED
              IF A BIT ICERR GO     IERR          % GO IF INCLUSIVE OR OF ERRORS SET
              IF A:=TRTZ><0  GO FAR DSEEK         % NEW SEEK IF LAST COMMAND WAS RECALIBRATE
              IF A:=SEEKF><0 GO FAR RWDIS         % GO TO READ/WRITE ROUTINE IF SEEK FLAG SET
 *RMAR1,      IOXIN RMAR                          % READ MEMORY ADDRESS REG. LOWER 16 BITS
              T:=A
 *RMAR2,      IOXIN RMAR                          % READ MEMORY ADDRESS REG. UPPER 8 BITS
              A/\377:=:T-SVLCA
              T:=T+C-1
              A-SVLWC
              T:=T+C-1
              A:=:T-WANKN
              IF A><0 OR T><0 GO FAR MEMER        % MEMORY ADDRESS ERROR
              IF A:=BADTR><0  GO FAR DBAD         % GO TO BAD TRACK ROUTINE
            ELSE                                  % ELSE NEW TRANSFER
              A:=9TREG/\300 SHZ 3 BONE 4
 *CONT1,      IOXIN LCONT                         % SELECT UNIT, CLEAR DISC UNIT
 *CONT2,      IOXIN LCONT                         % CLEAR DISC INTERFACE
 *STAT2,      IOXIN RSTAT                         % READ STATUS
              A=:SSTAT
              0=:SEEKF=:BADTR
              0=:RTZFL=:TRTZ=:NOSEC
              IF A:=77/\9TREG-20=0 GO FAR DFIN    % GO IF READ STATUS COMMAND
              IF A+14>=0           GO FAR DILLC   % GO IF ILLEGAL COMMAND
        FI
        IF X=0 GO FAR DFIN                        % GO IF ALL WORDS TRANSFERRED, FINISHED  !!!!!!!!
        0=:BADIP
        GO FAR DSEEK                              % EXECUTE SEEK

 *)FILL


 % ROUTINE TO HANDLE DISK STATUS ERROR -------------------------------
 %
 %      >>>>>>>>>>>>>>>>V
 %                IERR: V
 %            ----------V----------
 %            * CLEAR DEVICE      *
 %            ----------V----------
 %                      V
 %            ----------V---------- YES
 %            * 9TREG BIT TEST    >>>>>>>> HDERR:
 %            ----------V----------
 %                      V NO
 %            ----------V---------- YES
 %            * SEEKF><0 ?        >>>>>>>> RETZ:
 %            ----------V----------
 %                      V NO
 %            ----------V---------- YES
 %            * TRTZ><0 ?         >>>>>>>> HDERR:
 %            ----------V----------
 %                      V NO
 %         NO ----------V---------- YES
 %       V<<<<< BADTR><0 ?        >>>>>>>>>>>>>>>>>>
 %       V    ---------------------                V
 %       V                                         V
 %  -----V-----------------   ---------------------V--------------------
 %  * CALCULATE THE VALUE *   * STEP THE BLOCK ADDRESS TO POINT TO THE *
 %  * OF 9XREG PRIOR TO   *   * NEXT SECTOR ON THE BAD TRACK. DID THAT * YES
 %  * LAST TRANSFER       *   * GIVE A TO BIG SECTOR NO. ?             >>>>>>>V
 %  -----V-----------------   ---------------------V--------------------      V
 %       V                                         V NO                       V
 %  -----V--------------                           V           ---------------V----------------
 %  * HAS AL RETRYS    * NO                        V           * RESTORE BLOCK ADD AND STATUS *
 %  * BEEN DONE (ERRC1)>>>>>>> RWDIS:              V           * OF THE ORIGINAL ERROR        *
 %  -----V--------------                           V           ---------------V----------------
 %       V YES                                     V                          V
 %  -----V------------                             V                          V
 %  * RESET RETRIES  *                             V                          V>>>>>> RETZ:
 %  * (IRETR=:ERRC1) *                             V
 %  -----V------------                             V
 %       V                                         V
 %  -----V----------------                         V
 %  * WAS THE ERROR      * NO                      V
 %  * ADDRESS MISMATCH ? >>>>> RETZ:               V
 %  -----V----------------                         V
 %       V YES                                     V
 %  -----V-----------------------------------      V
 %  * SSTAT=:ADMIS. READ FAILING BLOCK ADD. *      V
 %  * FROM THE INTERFACE. SAVE IT IN ADMIA. *      V
 %  * CALCULATE BLOCK ADDRESS FOR THE FIRST.*      V
 %  * SECTOR ON THAT TRACK.                 *      V
 %  * SET AND BADIP BADTR><0.               *      V
 %  -----V-----------------------------------      V
 %       V                                         V
 %       >>>>>>>>>>>>>>>>>>>V<<<<<<<<<<<<<<<<<<<<<<<
 %                          V
 %               -----------V----------------------
 %               * LOAD BLOCK ADDRESS             *
 %               * LOAD MAR WITH ADDRESS OF ALTPO *
 %               * LOAD WORDC WITH 1.             *
 %               * SET BIT 15 IN T (SEEK)         >>>>>>> WDACT:
 %               ----------------------------------



 IERR:   A:=20
 *CONT4, IOXIN LCONT                           % DEVICE CLEAR
         IF A:=9TREG BIT TEST GO FAR HDERR     % IF TEST SPECIFIED, NO ERROR HANDLING
         IF A:=SEEKF><0       GO RETZ          % IF THE ERROR OCCURED DURING SEEK DO RETURN TO ZERO ZEEK
         IF A:=TRTZ ><0       GO FAR HDERR     % IF RETURN TO ZERO SEEK ALREADY HAS BEEN DONE, ERROR RETURN
         IF A:=BADTR><0                        % IF BAD TRACK FLAG SET THEN
            THEN                               % TRY NEXT SECTOR ON THE TRACK
              T:=BADDR+1                       % ERROR IN ALTERNATIVE ADDRESS FETCH INCR. SECT. ADDR. TO FIND A GOOD SECTOR
              IF A:=37/\T-WSECT>=0             % TEST LEGAL SEC. COUNT
                 THEN                          % THEN ALL SECTORS ON THE TRACK TRIED
                   A:=ADMIA=:SVLBB             % REPORT THE ORIGINAL ERROR
                   A:=ADMIS=:SSTAT
                   GO RETZ
              FI
              A:=T                             % BLOCK ADDRESS OF NEXT SECTOR IN A
            ELSE
              A:=9XREG+NOSEC=:9XREG=:X         % RESTORE X AND 9XREG
              MIN ERRC1 ; GO FAR RWDIS         % DO AL RETRIES FIRST
              A:=IRETR=:ERRC1                  % RESTORE RETRY COUNTER
              IF A:=SSTAT NBIT ADDMI GO RETZ   % NOT ADDRESS MISMATCH,  RECALIBRATE  !
              A=:ADMIS                         % SAVE ADDRESS MISMATCH STATUS IN CASE OF REAL ADDRESS MISMATCH
              A:=100000=:BADTR=:BADIP          % SET BAD TRACK FLAG
 *DAD2,       IOXIN RDAD                       % READ LAST DISK ADDRESS
              A-1=:ADMIA                       % SAVE FAILING BLOCK ADDRESS REG IN CASE OF REAL ADDRESS MISMATCH
              A/\177740                        % BACK TO FIRST SECTOR ON THE TRACK
                                               % IT IS AN ADDRESS MISMATCH, TRY BAD TRACK BIT
         FI
 *DAD3,  IOXIN LDAD                            % LOAD FAILING ADDRESS
         A=:BADDR
         A:=0=:WANKN
 *LMAR3, IOXIN LMAR                            % LOAD UPPER MEM. ADDR.
         A:="ALTPO"+B=:SVLCA
 *LMAR4, IOXIN LMAR                            % LOAD LOWER MEM. ADDR.
         A:=1=:SVLWC
 *WORD4, IOXIN LWORD                           % LOAD WORD COUNT = 1 SECTOR
         T:=100000                             % SET BAD TRACK BIT IN COMMAND
         GO FAR WDACT                          % TRY TO READ FAILING SECTOR WITH BAD TRACK BIT SET


 % ROUTINE TO DO RETURN TO ZERO SEEK       ------------------------------

 RETZ:   IF A:=RTZFL><0 GO FAR HDERR      % RECALIBRATE ALREADY DONE ?
         0=:BADTR=:SEEKF=:SHEAD=:BADIP    % RESET BAD TRACK FLAG
         A:=9TREG SHZ 10 SHZ -16 =:X      % UNIT INTO X
         0=:LCYLI(X)                      % CLEAR CYLINDER NO IN BASE FIELD
         A:=IRETR=:ERRC1                  % RESET RETRY COUNT
         T:=34000                         % RETURN TO ZERO SEEK, RECALIBRATE
         T=:RTZFL=:TRTZ                   % SET RECALIBRATE AND FLAG
         GO FAR WDACT                     % ACTIVATE


 % ROUTINE TO GET ALTERNATIVE DISK ADDRESS ------------------------------

 % ENTER HERE WHEN A SECTOR CONTAINING POINTERS TO THE ALTERNATIVE TRACK
 % IS READ CORRECT
 % PICK UP THE POINTER TO THE ALTERNATIVE TRACK FROM THE FIRST WORD IN THE MEMORY BUFFER
 % FIND THE CYLINDER PART OF THE POINTER. SUBTRACT IT FROM THE CURRENT CYLINDER (LCYLI)
 % THE DIFFERENCE (NO. CYLINDERS TO SEEK) IS WRITTEN OUT AS WORD COUNT.
 % STORE THE NEW CYLINDER NO. IN LCYLI.
 % FIND THE ALTERNATIVE TRACK'S HEAD NO., AND STORE IT IN SHEAD.

 DBAD:   T:=ALTPO                       % T <== ALTERNATIVE DISK CYL. ADDR.
         A:=9TREG SHZ 10 SHZ -16=:X     % UNIT NO. IN X
         A:=T ; AD SHZ -5               % HEAD INTO UPPER 5 BITS OF D, CYLINDER IN A
         A-LCYLI(X)                     % A <== NO. OF CYL'S TO GO
 *WORD3, IOXIN LWORD
         T SHZ -5 =:LCYLI(X)            % NEW CYL. ADDR. AFTER THIS SEEK
         A:=0 ; AD SHZ 5 ; A=:SHEAD     % HEAD TO USE ON ALT TRACK
         A:=-1=:SEEKF                   % SET SEEK FLAG
         0=:BADTR                       % RESET BAD TRACK FLAG
         T:=60000                       % SEEK COMMAND
         GO WDACT                       % ACTIVATE

 *)FILL


 % ROUTINE TO SEEK ON DISK ---------------------------------------------

 INTEGER TEMPX

 DSEEK:  0=:TRTZ                        % RESET RECALIBRATE FLAG
         A:=9DREG=:D
         A:=9TREG/\300 SHZ 3 BONE 4
 *CONT5, IOXIN LCONT                    % DEVICE CLEAR
 *CONT6, IOXIN LCONT                    % DEVICE CLEAR
         A:=9AREG
         X-1;D+X;IF C THEN A+1;FI; X+1  % AD= LAST LOGICAL DISK ADDR.
         T:=WSECY ; * RDIV ST % A<= CYL. NO.    D<= NO. OF SEC'S IN LAST CYL
         IF A>>T:=WMXCY GO LAOUR        % GO IF WANTED LOGICAL ADDRES>MAX LOGICAL ADDRESS
         X=:TEMPX
         T:=9TREG SHZ 10 SHZ-16=:X      % UNIT NO. IN X
         T:=LCYLI(X)
         A=:LCYLI(X)
         X:=TEMPX
         A-T ; * BLDC 170 DA            % SAVE SEEK DIRECTION IN K
         IF A<0 THEN A:=A- FI           % NEGATIVE STEP COUNT
 *WORD1, IOXIN LWORD                    % LOAD WORD COUNT WITH TRACK DIFFERENCE
         A=:SSTEP
         A:=0 ; T:=WSECT ; * RDIV ST    % A<= HEAD NO.     D<= NO. OF SEC'S ON LAST TRACK
         A=:SHEAD
         A:=D+1=:SSEC
         IF A:=SSTEP><0
            THEN                        % IF NOT ON CORR. CYL
              A=:SEEKF                  % SET SEEK FLAG
              T:=20000 ; * BSTA 160 DT  % STEP COMMAND INCLUDE DIRECTION
              GO WDACT                  % ACTIVATE
        FI


 % ROUTINE TO READ OR WRITE ON DISK -----------------------------------


 RWDIS:  0=:SEEKF                                 % RESET SEEK FLAG
         T:=SSEC=:D
         IF X<<T THEN T:=X FI                     % IF WHOLE TRANSFER WITHIN THIS TRACK THEN T<= NO. OF SEC'S TO TRANSFER
         T=:NOSEC
         X-T=:9XREG                               % X<= REMAINING SECTORS
         D-T                                      % D<= FIRST SECTOR
         A:=9TREG SHZ 10 SHZ -16=:X               % UNIT NO. IN X
         A:=LCYLI(X) SHZ 5 \/D                    % SHIFT CYLINDER ADDR. TO CORR. POSITION COMBINE CYL. & SEC. ADDRESS
 *DAD1,  IOXIN LDAD
         A=:SVLBB
         A:=WSECW ; X:=9XREG ; * RMPY SA DX       % AD<= REMAINING WORDCOUNT
         A:=:D+CMAD2:=:D
         A:=A+C+CMAD1
 *LMAR1, IOXIN LMAR                               % LOAD MEMORY ADDRESS, UPPER PART
         A=:WANKN
         IF A-400>=0 GO MORER                     % MEMORY OUT OF RANGE
         A:=D
 *LMAR2, IOXIN LMAR                               % LOAD MEMORY ADDRESS, LOWER PART
         A=:SVLCA
         A:=T*WSECW                               % A<= WORDCOUNT
 *WORD2, IOXIN LWORD
         A=:SVLWC
         A:=3/\9TREG SHZ 13 =:T                   % FUNCTION CODE IN T


 % ROUTINE TO CREATE CONTROLWORD FOR ACTIVATION -----------------------

 WDACT:  A:=SHEAD SHZ 5   ; T\/A        % SHIFT HEAD NO. TO CORR. POSITION
         A:=9TREG/\142000
         A\/BADIP ; T\/A
         A:=9TREG SHZ 3/\3000\/T+5      % + UNIT NO. + ACTIVATE & INT. ENABLE
 *CONT3, IOXIN LCONT
         A=:SVLCO
 *STAT3, IOXIN RSTAT
         IF A NBIT ACTIV GO CNACT       % ERROR, NOT BUSY
         A=:BUSFL
 WBUSY:  TAD:=SATAD ; X:=9XREG
         GO RETUR                       % BUSY EXIT
 *)FILL


 % FINISHED & ERROR EXITS ----------------------------------------------

 DFIN:   T:=9TREG
         L+1 ; GO WFINI                       % FINISHED EXIT

 MORER:  T:=1   ; GO DERR                     % ATTEMPT TO USE BANK NO. >>377.         BIT  8
 MEMER:  T:=4   ; GO DERR                     % CORE ADDRESS REGISTER NOT AS EXPECTED  BIT 10
 LAOUR:  T:=10  ; GO DERR                     % LOGICAL ADDRESS OUTSIDE DICE DEVICE    BIT 11
 DILLC:  T:=100 ; GO DERR                     % ILLEGAL CODE                           BIT 14
 CNACT:  T:=200 ; GO DERR                     % CONTROLLER NOT ACTIVE AFTER ACTIVATE   BIT 15
 HDERR:  T:=0                                 % HARDWARE ERROR NO ADDITIONAL STATUS

 DERR:   L-1                                  % ERROR RETURN
         T SHZ 10                             % GET THE ADDITIONAL STATUS
         A:=9TREG/\377 ; T\/A
 WFINI:  X:=SSTAT
         A:=IRETR=:ERRC1
         0=:BUSFL
 RETUR:  EXITA                                % GENERAL EXIT
 RBUS

 *)KILL LDAD  RSTAT LCONT LWORD 9TREG 9AREG 9DREG 9XREG
 *)KILL SSTAT SATAD WSECW WSECY ACTIV ICERR ADDMI ONCYL TEST
 *)KILL IRETR
 *)KILL WSECT WMXCY STAT1 RMAR1 RMAR2 CONT1 STAT2 CONT4
 *)KILL DAD2  DAD3  LMAR3 LMAR4 WORD4 WORD3 WORD1 DAD1  LMAR1 LMAR2
 *)KILL WORD2 CONT3 STAT3 DISDE CDISD CMAXC CONT2
 *)KILL CONT5 CONT6

 *"8ZWDI -8WDIS
" *)KILL 9ESWP; 9ESWP=*

 *"8WDIS; 8WDIS=0
"
 @EOF

 @LIB OLDX


 %==============================================================================
 % 36.22      S T A R T
 %
 % RT-PROGRAM FOR STARTING SINTRAN
 %

 INTEGER FPS41                          % FIRST PHYSICAL PAGE FOR SEGMENT 41

 DOUBLE DSBANK=SBANK
 SUBR START
 INTEGER PARTIMER:=("TIMRT","1","2")

 CRWTR:       FOR X DO
                X=:D; MASSUNIT(0) SH 6\/DSKTYP+60=:XFUNC
                T:=MASSNO(X); "RPAR"; *MON 2ABST
                IF <0 THEN CALL ERRFATAL FI
                XFUNC+1=:XFUNC; "WPAR"; *MON 2ABST
                IF <0 THEN CALL ERRFATAL FI; X:=D
                AD:=DTBLCK; T:=NBLCK; D+T; A:=A+C; AD=:DTBLCK
                AD:=DFBLCK; T:=NBLCK; D+T; A:=A+C; AD=:DFBLCK
              OD; EXIT
 *)FILL

 INTEGER CDFADDR=?,CDBPCOLDSTART=?,CCHDEV=?
 START: "DT01R"=:CDFADDR
        IF HENTFLAG=0 AND LGCOLDSTART><1 THEN
           CALL LOGPH
           IF A=0 OR A.TYPRING NBIT 5TERM THEN 1=:LGCOLDSTART; GO L1 FI
           X=:CDFADDR
           T:="DBPROG"; CALL XGTDFADDR; A=:CDBPCOLDSTART
           T:="DBPROG"; A:=0; CALL XSTDFADDR
           X:="DT01R"; A:=0; T:="DBPROG"; CALL XSTDFADDR
           T:="HDEV"; X:=CDFADDR; CALL XGTDFADDR; A=:CCHDEV
           T:="CNTREG"; CALL XGTDFADDR; T:=CCHDEV+DCONT; *IOXT
           GO L1; *)FILL
        FI
 L1:    "PARTIMER"; *MON 2INTV
        "PARTIMER"; *MON 2RT

 % MAKE STSIN A BACKGROUND PROGRAM
        *PIOF
        1=:BACKGROUND; RTREF.ACTPRI BONE 5BACKGR=:X.ACTPRI

 % FIND BUFFER PAGE FOR MOVING OP.COM SEGMENT
        T:=CORMBANK; X:=BPAG1; *LDATX DPAGP
        IF A-"5BFPAGE"=0 THEN
           *LDXTX DPAGL; LDATX DPAGP
        ELSE
           *LDATX DPAGP
        FI; *PION
        0=:D; A:=:D
        AD SH 12=:DSBANK      % USE FIRST OR SECOND SWAP-PAGE
        ABLPAGE(0)=:NBLCK
        MASSNO(X); CALL LOGPH; A.TYPRING/\177774+3=:X.TYPRING
        IF X."TRNSF"="BDISK" THEN                 % READ FORMAT CALL TO DRIVER
           42=:XFUNC; T:=MASSNO(0); "RPAR"; *MON 2ABST
        FI; GO OVER; *)FILL

 INTEGER CDFADDR,CDBPCOLDSTART,CCHDEV
 INTEGER POINTER TTIF:=TTIFIELD,PTTNO:=TTNO

 OVER:
 % MOVE OP.COM SEGMENT
        IF HENTFLAG=0 THEN    % START AFTER ")HENT"
 % MOVE PIT3 SEGMENT FROM THE SAVE SEGMENT (17) TO SEGMENT 41
              "SG17".MADR*NBLCK=:T; DDBLST; D+T; A:=A+C; AD=:DFBLCK
              "SG41".MADR*NBLCK=:T; DDBLST; D+T; A:=A+C; AD=:DTBLCK
              X.LOGADR SHZ -10-=:X
              CALL FAR CRWTR
 % MOVE COMMAND SEGMENT FROM SAVE-AREA TO SEGMENT 3
              "5OPSEG*5SEGSIZE+XSEGS"=:X=:L
              "5FYOP"*NBLCK=:T; DDASA; D+T; A:=A+C; AD=:DFBLCK
              X.MADR*NBLCK=:T; DDBLST; D+T; A:=A+C; AD=:DTBLCK
              L.LOGADR SHZ -10-=:X
              CALL FAR CRWTR
              "SYSST"*NBLCK=:T; DDASA; D+T; A:=A+C; AD=:DFBLCK
              "SG5".MADR*NBLCK=:T; DDBLST; D+T; A:=A+C; AD=:DTBLCK
              "SG5".LOGADR SHZ -10 -=:X
              CALL FAR CRWTR
              IF LGCOLDFLAG><1 THEN
                 A=:PTTNO; CDFADDR=:TTIF; CDBPCOLDSTART=:DBPCOLDSTART
              FI
        FI
 @LIB CXCPU
        GO OVFILL; *)FILL

 OVFILL:
 % COPY PIT3 SEGMENT INTO MEMORY
        "SG41".MADR*NBLCK=:T; DDBLST; D+T; A:=A+C; AD=:DFBLCK
        X.LOGADR SHZ -10*NBLCK=:NBLCK
        MASSUNIT(0) SH 6\/DSKTYP+60=:XFUNC
        A:=FPS41=:D:=0; AD SH 12=:DSBANK
        T:=MASSNO(X); "RPAR"; *MON 2ABST
        IF A<0 THEN CALL ERRFATAL FI
        ABLPAGE(0)=:NBLCK
 % SET UP PAGE LINK FOR PIT3 SEGMENT
        "SG41".LOGADR SHZ -10=:L
        FPS41 SH 2+CORMSTART=:X.BPAGLINK
        X.LOGADR/\377=:D; X:=X.BPAGLINK; T:=CORMBANK
        DO WHILE L><0
           A:=X+4; *STDTX DPAGL
           A:=162041; *STATX DPGPR
           L-1; D+1; X+4
        OD; X-4; *STZTX
        "SG41".FLAG BONE 5FIX=:X.FLAG
 % SET UP PAGE TABLE FOR PIT3 SEGMENT
        T:=CORMBANK; X.LOGADR/\77 SH 1+177600=:B; X:=X.BPAGLINK; CALL SS41IPIT
        GO IOBHDLC; *)FILL

 INTEGER CLOGU,NPAGES,CPNTR,CFPAG,CLPG
 INTEGER PMO61:=("5",NPAGES,CFPAG,CLPG,0,0)
 INTEGER POINTER LREG

 CSUBR: A:=L=:"LREG"; X:=0
        DO WHILE X<<"CUMSIZE*2"
           X=:L
           A:="CUMTABLE"; X+A; T:=0; *LDDTX
           IF A<<=CFPAG AND D+1>>T THEN T:=D=:CFPAG FI
           IF X:=CFPAG>>=CLPG GO LREG
           IF A<<=CLPG AND A>>=CFPAG THEN A-1=:CLPG FI
           X:=L+2
        OD; MIN "LREG"; GO LREG

 IOBHDLC: "IOBUTAB"=:CPNTR
        DO WHILE CPNTR.S0><-1
           IF A BIT BIHDLC AND X.S1/\77777>>1777 THEN
              A+1777 SHZ -12=:NPAGES
              CPNTR.S0/\37777; CALL LOGPH
              IF T:=X.S0 BIT 17 THEN A:=D FI; IF A=0 THEN CALL ERRFATAL FI
              A=:CLOGU; -1=:CLPG
 DOLOOP:      DO CLPG+1=:CFPAG WHILE CFPAG<<ENDPAGE
                 CFPAG+77=:CLPG; CALL CSUBR; GO DOLOOP; "PMO61"; *MON 61
                 GO DOLOOP; GO FOUND
              OD; CALL ERRFATAL
 FOUND:       T=:CLOGU.FIXID; A=:X.LWPHY=:D:=0; AD SH 12
              A=:X.MASTB:=D=:X.BUFST; 1=:X.SWBUF; 0=:X.HINIF
              NPAGES SH 13=:X.MAX
           FI; CPNTR+2=:CPNTR
        OD
       GO OLDSTART       % ON OP. SEGMENT
 RBUS

 %=============================================================================
 %  38.10     S Y S E V A L
 %
 %  ROUTINE TO DEDUCT CPU/SYSTEM INFORMATION AND UPDATE THE GLOBAL
 %  SINTRAN VARIABLES WITH THIS INFORMATION
 %
 %  A 12 WORD (14 OCTAL) ARRAY CONTAIN VARIOUS INFORMATION ABOUT THE SYSTEM.
 %  THE ARRAY IS SUBDIVIDED INTO SEVERAL FIELDS FOR VARIOUS TYPE OF INFORMATION.
 %  THE FOLLOWING GIVES A DETAILED DESCRIPTION OF THE INFORMATION PRESENT IN
 %  THE VARIOUS ENTRIES
 %
 %-----------------------------------------------------------------------------
 %
 %  DISP  NAME            DESCRIPTION
 %
 %   0    SYSNO           SYSTEM NUMBER (NORMALLY CPU NUMBER), 16 BIT INTEGER
 %
 %   1    HWINFI(0)       HARWARE INFORMATION
 %                        LEFT BYTE = CPU TYPE
 %                                    0 = NORD-10  48 BIT FLOATING
 %                                    1 = NORD-10  32 BIT FLOATING
 %                                    2 = ND-100   48 BIT FLOATING
 %                                    3 = ND-100   32 BIT FLOATING
 %                                    4 - 255  NOT USED
 %                        RIGHT BYTE = INSTRUCTION SET
 %                                    0 = STANDARD (NORD-10 OR ND-100)
 %                                    1 = NORD-10 COMMERCIAL, ND-100/CE
 %                                    2 - ND-100/CE WITH "MICRO-SEGADM"
 %                                    3 - 255 NOT USED
 %
 %   2    HWINFO(1)       NOT USED
 %
 %   3    HWINFO(2)       NOT USED
 %
 %   4    SINVER(0)       OPERATING SYSTEM
 %                        LEFT BYTE = OPERATING SYSTEM
 %                                    0 = SINTRAN III VS
 %                                    1 = SINTRAN III VSE
 %                                    2 = SINTRAN III VSE/500
 %                                    3 = SINTRAN III RTP
 %                                    4 = SINTRAN III VSX
 %                                    5 = SINTRAN III VSX/500
 %                                    6 - 255 NOT USED
 %                        RIGHT BYTE = VERSION LETTER
 %                                     ASCII CHARACTER WITHOUT PARITY (A-Z)
 %
 %   5    SINVER(1)       NOT USED
 %
 %   6    REVLEV          PATCH/CORRECTION LEVEL INDICATIOR, 16 BIT INTEGER
 %                        (SYSTEM DEPENDANT CODING)
 %
 %   7    GENDAT(0)       SYSTEM GENERATION TIME  (MINUTES)
 %   8    GENDAT(1)       SYSTEM GENERATION TIME  (HOURS)
 %   9    GENDAT(2)       SYSTEM GENERATION TIME  (DAY)
 %  10    GENDAT(3)       SYSTEM GENERATION TIME  (MONTH)
 %  11    GENDAT(4)       SYSTEM GENERATION TIME  (YEAR)
 %
 %-----------------------------------------------------------------------------

 SUBR SYSEVAL

 INTEGER SXREG,SBREG,STREG,AREG,SDREG
 TRIPLE TADR=STREG
 INTEGER POINTER SLREG

 SYSEVAL: TAD=:TADR; X=:SXREG:=B=:SBREG:=L=:"SLREG"
 %  32/48 BIT FLOATING?
        T:=0; A:=1; *NLZ 20
        IF T=0 THEN T:=1 ELSE T:=0 FI

 %  NORD-10 OR ND-100?
        A:=CPSTA/\10000 SHZ -13+T SH 10=:HWINFO(0)

 %  INSTRUCTION SET
 %  COMMERCIAL INSTRUCTION SET?
        *TRA IIC
        A:=20; *TRR IIE
        A:=0; *TRR PIE; TRR PID
        A:=40000; *MST PIE
        A:="CLEV14"; *IRW 160 DP; ION
        T:="L1"=:L:=0; *140130; JMP *+1; TRA IIC            % BFILL
 L1:    IF A=0 THEN
           "L2"=:L
           B:=0; D:=0; A:=0; X:=0; *142700; TRA IIC         % GECO
 L2:       IF A><0 GO OUT
        FI
        *143500                                             % SLWCS
        MIN HWINFO(0)
        T:="L3"=:L; X:=0; *ICLEP; TRA IIC
 L3:    IF A=0 THEN MIN HWINFO(0) FI
 OUT:
 *"-CXCPU
"        A:=1
 *"CXCPU
"        IF T:=PN500D><0 THEN A+1 FI                         % ND-500 INCLUDED
        A SH 10+##J                                         % VERSION LETTER
        A=:SINVER(0)
        *IOF; TRA IIC
        A:=0; *TRR PIE; TRR PID; TRR IIC
        TAD:=TADR; X:=SBREG=:B:=SXREG; GO SLREG

 % ROUTINE ON LEVEL 14 TO CHECK FOR ILLEGAL INSTRUCTION
 CLEV14: *TRA IIC
        IF A><4 THEN CALL ERRFATAL FI
        *IRW DA; IRR DL; IRW DP
        *WAIT
        GO CLEV14

 RBUS
 @LIB OLDX
 %============================================================================
 %      I N T D F I E L D S
 %
 % INITIALIZE THE TERMINAL DATAFIELDS
 %

 INTEGER 77CBU                          % END OF "POF-RTDESC"+1

 SUBR INTDFIELDS

 INTEGER ARRAY DAMO(0)
        *37
 INTEGER FEB
        *37;36;37;36;37;37;36;37;36;37

 @LIB CXCPU

 % COMPUTE THE NUMBER OF DAYS IN FEBRUARY THE YEAR THE SYSTEM
 % IS GENERATED
 INTDFIELDS:
        GENDA(4)-PTBASE(X); D:=0
        DO WHILE A>0
           A-1; IF D+1>3 THEN D:=0 FI
        OD; IF D=1 THEN 35 ELSE 34 FI; A=:FEB
        X:=GENDA(3)-1; A:=DAMO(X)+1-=:MND
        *PIOF
        CALL CH5CPUPRESENT              % CHECK IF ND-500 CPU IS PRESENT
        A:=200; *TRR IIE; TRR IIC
        A:=10; *TRR ECCR; TRA IIC
        IF A><0 THEN
           0=:TCNTI
        ELSE
           A:=4; *TRR ECCR
        FI; A:=0; *TRR IIE; TRA PGS; TRA PEA; TRA IIC
 *"8BACS
"        GO L0; *)FILL

 @LIB CXCPU

 L0:

 @LIB CXCPU
 RETU:  7RTDLGADDR=:D
        FOR X:=RTSTART STEP 5RTSIZE TO SEGSTART-5RTSIZE DO
           A:=D=:X.RTDLGADDR+5XRTDSIZE=:D
        OD
        FOR X:=7RTDLGADDR TO 77CBUF-1 DO 0=:X.S0 OD
        "DUMMY".STADR=:X.RTDLGADDR.DPREG
        "STSIN".STADR=:X.RTDLGADDR.DPREG
        "1SWAP".STADR=:X.RTDLGADDR.DPREG
        GO SETPTABL
 RBUS

 @LIB OLDX

 @EOF


 %

 %==============================================================================
 %      P I T 3 - S E G M E N T
 %==============================================================================


 *9EPT3+1777@-12@12/
 *XSPT3=*
 *XSPT3;XLPT3;XEPT3
 *S41FP=XSPT3@-12+100


 %============================================================================
 %            P F I X C
 %
 % RESERVE MEMORY FOR SPECIAL USE
 %
 SUBR PFIXC

 DISP -200
 INTEGER SGADR,FPHYS,SG1ADR,OLDFLAG
 INTEGER CMMENTRY,CSEGN,STEPINCR,CCORMSTART,CECORMAP,BREG
 INTEGER COLDFLAG,CINDX
 INTEGER PGFOUND,PREVPGFOUND
 INTEGER CFPHYS,CT,CA,CD,CLOGPAGE,CCECORMAP
 INTEGER POINTER LINK
 TRIPLE CTAD=CT; DOUBLE CTA=CT
 INTEGER FIXFLAG
 INTEGER NPAGES; INTEGER CCTINDX=NPAGES
 INTEGER AFPHYS,NPARTS=AFPHYS
 INTEGER ALPHYS,CPHPAGE=ALPHYS; DOUBLE ARRAY POINTER DPARTADDR=ALPHYS
 INTEGER NSHARED; INTEGER POINTER RNPARTS=NSHARED; INTEGER MXMININTERVAL=NSHARED
 INTEGER ARRAY POINTER ARRPNT; DOUBLE ARRAY POINTER DRETADDR=ARRPNT
 DOUBLE ARRAY POINTER DARRPNT=ARRPNT
 TRIPLE ARRAY POINTER FARRPNT=ARRPNT
 INTEGER ARRAY POINTER PCCTAB
 DOUBLE ARRAY POINTER DPCCTAB=PCCTAB
 DOUBLE POINTER DCCFPA
 INTEGER PREVT,PREVX
 TRIPLE T5D1=NPAGES; DOUBLE D5DD4=NSHARED
 INTEGER CURPAGE,CPEND; DOUBLE CCAREA=CURPAGE
 INTEGER CNPAGES=CPEND, CSGNO=CPEND, CTINDX=CPEND
 INTEGER CBPGLINK
 INTEGER PARTINDX,RETINDX,CCPRG=PARTINDX
 INTEGER POINTER RINDXADDR
 INTEGER SVFLAGB
 PSID

 INTEGER CBRG

 PFIXC: A:=BREG:=:B=:CBRG
        CALL XTOPOFF(SRESER)                       % RESERVE "SWAPPING SYSTEM"
        0=:CINDX=:PAGPN; CBRG=:B
        CALL XTOPOFF(XCSEGS)
        RTREF; X:="FIXCRT"; T:=0; *STATX          % CURRENT PROGRAM EXECUTING FIXC
 @ICR
        FIXFLAG GOSW 0F500,FAR 1F500,FAR 2F500,FAR 3F500,FAR 4F500,
        FAR 5F500,FAR 6F500,FAR 7F500,FAR 10F500;
 @CR;
 0F500: CALL MBSREMOVE                  % REMOVE SEGMENT FROM MEMORY
        NPAGES-1+FPHYS=:CURPAGE
        ECORMAP=:CECORMAP
        CALL SGFIXC                     % FIX SEGMENT CONTIGUOUSLY
        FIXPAGES+NPAGES=:FIXPAGES
        CALL XRELES
        BREG=:B; IF D0 BIT 17 THEN 0=:ZAREG FI; GO RETSTUPR
 *)FILL

 INTEGER CB,XINDX
 INTEGER POINTER LREG

 % RELEASE ALL SWAPPING-DEVICES AND THE SWAPPING-SYSTEM
 XRELES: A:=L=:"LREG"
        CALL XTOPOFF(SRELES)
        X:="FIXCRT"; T:=0; *STZTX
        IF BACKGROUND><0 AND SVFLAGB BIT 5ESCON THEN CALL ESCON FI
        GO LREG

 % REMOVE ALL PAGES OF A SEGMENT FROM MEMORY
 MBSREMOVE: A:=L=:"LREG"
        IF SGADR.SEGLINK><0 THEN CALL XTOPOFF(SREMOVE) FI
        X.FLAG=:OLDFLAG BZERO 5OK=:X.FLAG
 % REMOVE ALL PAGES CURRENTLY IN SEGMENT
        DO WHILE X:=SGADR.BPAGLINK><0
           T:=CORMBANK; *LDATX DPGPR
           IF A BIT 5WIP THEN A:=1=:D; T:=SGADR; CALL XTOPOFF(ATRNSEG) FI
           T:=SG1ADR; SGADR; CALL XLINKOVER
        OD; GO LREG
 *)FILL

 %      ALLOCATE MEMORY FOR NORD-500
 1F500:
 500FIXC: CORMSTART=:CCORMSTART; AFPHYS=:CURPAGE
 %      FIND POSSIBLE AREA FOR NORD-500 SEGMENT
 XLOOP: X:=CCORMSTART; CURPAGE=:FPHYS; 0=:PGFOUND
 % SEARCH ALL PAGES IN MEMORY-MAP
        DO
           T:=CORMBANK; *LDDTX DPGPR
           X=:CMMENTRY
           IF D=CURPAGE THEN
              IF A/\377=0 OR A>>SGMAX GO NEWSTART
              A=:CSEGN*5SEGSIZE+SEGSTART=:SGADR
              IF A.FLAG BIT 5FIX THEN
                 CALL TSTSHARED; GO 5ERR; GO NEWSTART
              FI; GO PGOK
           ELSE
              IF D>>T GO CHRTC
           FI
 INLOOP: WHILE X:=CMMENTRY<<ECORMAP
           X+4
        OD
 CHRTC: X:=0=:CSEGN
 % CHECK RT-COMMON
        DO AD:=DPCCTAB(X) WHILE A><-1
           IF D=CURPAGE THEN
              A/\377=:T; AD:=DCCFPA
              IF A-100=0 GO NEWSTART; A+200; D BONE 6
              IF T<A OR T>D GO NEWSTART
              CALL TSTSHARED; GO 5ERR; GO NEWSTART; CMMENTRY-4=:CMMENTRY; GO PGOK
           FI; X+2
        OD; GO NEWSTART

 5ERR:  A=:BREG.ZAREG; CALL XRELES; BREG=:B; GO RETSTUPR
 *)FILL

 % CURRENT AREA NOT AVAILABLE, START AFTER LAST CHECKED PAGE IF POSSIBLE
 NEWSTART: MIN CURPAGE
        IF CURPAGE-1+NPAGES>>ALPHYS THEN   % NO AREA AVAILABLE FOR NORD-500
              A:=0; GO 5ERR FI
        CMMENTRY=:CCORMSTART; GO XLOOP

 % THIS PAGE IS AVAILABLE
 PGOK:  MIN PGFOUND; MIN CURPAGE
        IF PGFOUND><NPAGES GO INLOOP   % ALL NEEDED PAGES NOT YET FOUND
 % AREA FOR NORD-500 SEGMENT IS FOUND
        IF CMMENTRY><ECORMAP THEN A+4 FI; A=:CCECORMAP
        FPHYS=:AFPHYS+NPAGES-1=:ALPHYS  % PHYSICAL ADDRESSES OF NORD-500 AREA
        IF FIXFLAG=4 THEN
           AFPHYS=:FPHYS+NPAGES-1=:CURPAGE
           CSGNO*5SEGSIZE+SEGSTART=:SGADR
           CALL 5SGFIXC; FIXPAGES+NPAGES=:FIXPAGES
           AFPHYS; GO FAR OKRET; *)FILL
        ELSE
           IF A=5 THEN
              AFPHYS=:FPHYS+NPAGES-1=:CURPAGE
              CTINDX+1=:SGADR; CALL 5SGFIXC
              CTINDX=:BREG.ZTREG; X:=CTINDX+1; RTREF=:FXCTAB(X)
              AFPHYS; GO FAR OKRET
           FI
        FI; 0=:CINDX
 %  TEST IF THE SHARED AREAS ARE OF CORRECT SIZE AND IF THEY ARE PLACED
 %  IN CORRECT PHYSICAL ADDRESSES
 LOOP2: IF CINDX=NSHARED GO FAR FINEX   % FOR CINDX DO WHILE CINDX><NSHARED
           CINDX*3=:X                   % ; TAD:=FARRPNT(X)=:CTAD
           T:=0; A:="FARRPNT"; X+A; *LDDTX
           AD=:CTA; *LDATX 20
           A=:CD
           IF SGMAX<<CT THEN 311; GO 5ERR FI      % ILL. SEGM. NO.
           IF T=0 THEN                  % RT-COMMON
              IF CCFPA=100 THEN 302; GO 5ERR FI   % NO RT-COMMON
              A+100=:CLOGPAGE
              IF CCLPA-CCFPA+1><CD THEN 312; GO FAR 5ERR FI % RT-C SIZE DOES NOT MATCH
              AFPHYS+CA=:CURPAGE; 0=:PGFOUND
 LOOP1:       X:=0; PGFOUND=:PREVPGFOUND
              DO AD:=DPCCTAB(X) WHILE A><-1
                 IF A/\377=CLOGPAGE THEN
                    IF D><CURPAGE THEN 303; GO FAR 5ERR FI  % RT-C IN ILL. PHYS ADDRESS
                    MIN PGFOUND
                    IF CLOGPAGE=CCLPA+100 THEN
                       IF PGFOUND><CD THEN 314; GO FAR 5ERR FI % RT-C NOT CONTIGOUS
                       GO FAR NEXT
                    FI; MIN CURPAGE; MIN CLOGPAGE
                 FI; X+2
              OD; IF PGFOUND><PREVPGFOUND GO LOOP1
              304; GO FAR 5ERR; *)FILL      % ERROR IN LINKING TO RT-COMMON
           ELSE
              A:=T*5SEGSIZE+SEGSTART=:X
              IF X.FLAG BIT 5DEMAND THEN A:=T SH 10+313; GO FAR 5ERR FI
              IF X.LOGADR SHZ -10><CD THEN CT SH 10+316; GO FAR 5ERR FI
              IF X.FLAG BIT 5FIX THEN
                 AFPHYS+CA=:CURPAGE
                 IF X:=X.BPAGLINK=0 THEN CT SH 10+305; GO FAR 5ERR FI
                 DO
                    T:=CORMBANK; *LDATX DPAGP
                    IF A><CURPAGE THEN CT SH 10+307; GO FAR 5ERR FI
                    MIN CURPAGE; T:=CORMBANK; *LDXTX DPAGL
                 WHILE X><0
                 OD
              FI
           FI
 NEXT:  CINDX+1=:CINDX; GO FAR LOOP2
 FINEX: 0=:CINDX
 % MOVE ALL SHARED SINTRAN III SEGMENTS, NOT YET FIXED, FROM MEMORY
        FOR CINDX DO WHILE CINDX><NSHARED
           A*3=:X
           "ARRPNT"; X+A; T:=0; *LDATX            % IF ARRPNT(X)><0 THEN
           IF A><0 THEN
              A*5SEGSIZE+SEGSTART=:SGADR; CALL MBSREMOVE
           FI
        OD
        0=:CINDX=:CLOGPAGE
        IF NSHARED><0 THEN
           A*3=:X; "ARRPNT"; X+A; T:=0; *STZTX    % 0=:ARRPNT(X) FI
        FI; GO RM500; *)FILL
 % RESERVE THE MEMORY AREA FOR NORD-500 SEGMENT
 RM500: FOR CINDX DO WHILE CINDX><NSHARED
           CINDX*3=:X; T:=0; "FARRPNT"; X+A; *LDDTX   % TAD:=FARRPNT(X)=:CTAD
           AD=:CTA; *LDATX 20
           A=:CD; TAD:=CTAD
           IF A><CLOGPAGE THEN
 % NOT SHARED AREA, LINK TO NORD-500 PAGELINK
              A-T=:CNPAGES-1+CLOGPAGE+AFPHYS=:CURPAGE
              CLOGPAGE+AFPHYS=:FPHYS; 0=:SGADR
              CALL 5SGFIXC; CLOGPAGE+CNPAGES=:CLOGPAGE
           FI
           IF CT=0 THEN                 % RT-COMMON
              CLOGPAGE+CD=:CLOGPAGE
           ELSE
              A*5SEGSIZE+SEGSTART=:SGADR=:X
              IF X.FLAG NBIT 5FIX THEN  % SHARED SEGMENT NOT YET FIXED
                 CA+AFPHYS=:FPHYS+CD-1=:CURPAGE
                 CALL 5SGFIXC            % FIX SEGMENT
                 CD+FIXPAGES=:FIXPAGES
                 NSHARED*3=:X=:D; T:=0; "ARRPNT"; X+A       % MIN ARRPNT(X); ARRPNT(X); X+A
                 *LDATX; AAA 1; STATX
                 X:=A+D                                     % =ARRPNT(X)
                 "ARRPNT"; X+A; CT; *STATX                  % CT=:ARRPNT(X)
              FI; CLOGPAGE+CD=:CLOGPAGE
           FI
        OD
        IF NPAGES-CLOGPAGE><0 THEN
 % NOT SHARED AREA, LINK TO NORD-500 PAGLINK
           A=:NPAGES; CLOGPAGE+AFPHYS=:FPHYS+NPAGES-1=:CURPAGE
           0=:SGADR; CALL 5SGFIXC; PAGPN=:BREG.ZTREG; 0=:PAGPN
        FI; AFPHYS
 OKRET: A=:BREG.ZAREG; MIN X.ZPREG; 0/\0; CALL FAR XRELES; BREG=:B
        GO RETSTUPR

 *)FILL


 % FIND WANTED PAGES IN MEMORY-MAP, REMOVE THEM FROM THEIR CURRENT SEGMENT
 % AND INSERT PAGES INTO FIXC-SEGMENT
 5SGFIXC: CCECORMAP=:CECORMAP
 SGFIXC: A:=L=:"LINK"
        4=:STEPINCR; CORMSTART=:CCORMSTART
 LOOP:  X:=CCORMSTART
        DO
           T:=CORMBANK; *LDDTX DPGPR
           IF D=CURPAGE THEN
              IF A/\377=0 GO ERR                  % PAGE NOT IN SWAPPING AREA
              A*5SEGSIZE+SEGSTART=:CSEGN; X=:CMMENTRY
              IF A.FLAG BIT 5FIX GO ERR           % PAGE BELONGS TO FIXED SEGM.
              X:=CMMENTRY; CSEGN; CALL OUTLINK
              T:=CORMBANK; *LDATX DPGPR
              IF A BIT 5WIP THEN
                 CSEGN.FLAG=:COLDFLAG BZERO 5OK=:X.FLAG; X:=CMMENTRY
                 T:=CSEGN; A:=1=:D; CALL XTOPOFF(ATRNSEG)
                 IF CSEGN.FLAG BIT 5DEMAND THEN COLDFLAG=:X.FLAG FI
              FI; GO FORBI; *)FILL
 FORBI:       X:=CMMENTRY; T:=SGADR; CSEGN; CALL XLINKOVER
              IF CURPAGE=FPHYS GO L1
              A-1=:CURPAGE
              IF STEPINCR>0 THEN
                 -4=:STEPINCR; CMMENTRY-4=:CCORMSTART
                 T:=NPAGES-2 SH 2; A-T; A=:CECORMAP
              FI; GO LOOP
           FI
        WHILE X><CECORMAP
           A:=X+STEPINCR=:X
        OD
 % AREA NOT AVAILABLE
 ERR:   IF FIXFLAG><0 THEN -1; GO FAR 5ERR FI
        IF X:=SGADR.BPAGLINK><0 THEN
           T:=CORMBANK; A:=1
           DO WHILE X><0
              X=:D; *STATX DPGPR; STZTX DALOG; LDXTX DPAGL
           OD; "XSGRT".BPAGLINK; X:=D; *STATX DPAGL
           SGADR.BPAGLINK; 0=:X.BPAGLINK; A=:"XSGRT".BPAGLINK
        FI
        CALL XRELES; BREG=:B
        IF D0 BIT 17 THEN A:=-1; A=:ZAREG; GO RETSTUPR FI
        CALL 9ERRA(#28); GO RETXIT

 L1:    IF X:=SGADR>>SEGSTART THEN
           X.FLAG BONE 5FIX BONE 5OK=:X.FLAG; X.LOGADR/\377=:CURPAGE
           A:=X-SEGSTART; A=:D:=0; T:=5SEGSIZE; *RDIV ST
           A=:D; X.FLAG/\177400\/D=:D; X:=X.BPAGLINK
           T:=CORMBANK; A:=CURPAGE
 % SET CORRECT LOGICAL PAGE NUMBERS AND SEGMENT NUMBER IN CORMAP ENTRIES
           DO
              *STDTX DALOG
              A+1; *LDXTX DPAGL
           WHILE X><0
           OD
 % TRANSFER SEGMENT TO MEMORY
           A:=SGADR.LOGADR SHZ -10
           X:=X.BPAGLINK; D:=0; T:=SGADR; CALL XTOPOFF(ATRNSEG)
        FI; GO LINK; *)FILL

 % TEST IF THE SHARED SINTRAN III/NORD-500 AREA ARE PLACED IN CORRECT
 % PLACE IN PHYSICAL MEMORY, AND TEST IF THE AREA SIZES ARE CORRECT
 TSTSHARED: 0=:CINDX
        FOR CINDX DO WHILE CINDX><NSHARED
           CINDX*3=:X; "FARRPNT"; X+A; T:=0; *LDATX   % TAD:=FARRPNT(X)=:CTAD
           AD=:CTA; *LDATX 20
           A=:CD; TAD:=CTAD
           IF CSEGN=T THEN
              IF A=0 THEN               % RT-COMMON
                 IF CCFPA=100 THEN EXIT FI        % ERROR, NO RT-COMMON
                 A+100=:CLOGPAGE; X:=0
                 DO AD:=DPCCTAB(X) WHILE A><-1
                    IF A/\377=CLOGPAGE THEN
                       IF FPHYS+CA><D THEN EXITA FI   % WRONG SIZE
                       L+1; EXITA                 % OK
                    FI; X+2
                 OD; 304; EXIT                    % ERROR
              ELSE                                % SEGMENT
                 IF X:=SGADR.BPAGLINK=0 THEN CSEGN SH 10+305; EXIT FI  % ERROR, SEG. NOT IN MEMORY
                 T:=CORMBANK; *LDATX DPAGP
                 A=:CLOGPAGE=:CT
                 DO
                    *LDATX DPAGP
                    IF A><CLOGPAGE THEN CSEGN SH 10+306; EXIT FI   % ERROR, SEG. NOT CONTINUOUS
                    MIN CLOGPAGE; T:=CORMBANK; *LDXTX DPAGL
                 WHILE X><0
                 OD
                 IF CA+FPHYS><CT THEN CSEGN SH 10+307; EXIT FI   % WRONG PHYSICAL ADDRESS
                 L+1; EXITA                       % OK
              FI
           FI
        OD; EXITA                                 % NOT SHARED AREA
 2F500: 0=:PARTINDX=:RETINDX=:PGFOUND; GO DO1; *)FILL
 DO1:   IF PARTINDX>=NPARTS SH 1 THEN GO FAR 55ERR FI
           "DPARTADDR"; X:=PARTINDX+A; T:=0; *LDDTX     % AD:=DPARTADDR(PARTINDX)
           A=:FPHYS:=D=:CURPAGE; X:=ECORMAP; 0=:CPEND
           T:=CORMBANK; *LDATX DPAGP
           IF A<<FPHYS GO IO1ND
           IF A<<CURPAGE THEN A=:CURPAGE FI
 DO2:      IF X<<CORMSTART GO FAR EDO2
              T:=CORMBANK; *LDDTX DPGPR
              X=:CMMENTRY
              IF D=CURPAGE THEN
                 IF A/\377=0 OR A>>SGMAX GO NUSEPAGE
                 A=:CSEGN*5SEGSIZE+SEGSTART=:SGADR
                 IF A.FLAG BIT 5FIX GO NUSEPAGE
                 IF CPEND=0 THEN CURPAGE=:CPEND FI
                 X:=CMMENTRY; SGADR; CALL OUTLINK
                 T:=CORMBANK; *LDATX DPGPR
                 IF A BIT 5WIP THEN
                    SGADR.FLAG=:COLDFLAG BZERO 5OK=:X.FLAG
                    X:=CMMENTRY; T:=SGADR; A:=1=:D; CALL XTOPOFF(ATRNSEG)
                    IF SGADR.FLAG BIT 5DEMAND THEN COLDFLAG=:X.FLAG FI
                 FI; X:=CMMENTRY; T:=0; SGADR; CALL XLINKOVER
                 X:=CMMENTRY; T:=CORMBANK; 160377; *STATX DPGPR
                 MIN PGFOUND
                 IF PGFOUND=NPAGES THEN
                    AD:=CCAREA; T:="DRETADDR"; X:=RETINDX+T; T:=0; *STDTX  %=:DRETADDR(RETINDX)
                    X:=PAGPN; A:=160000; T:=CORMBANK
                    DO WHILE X><0
                       *STATX DPGPR; LDXTX DPAGL
                    OD
                    PAGPN=:BREG.ZTREG; 0=:PAGPN
                    A:=RETINDX SHZ -1+1; GO FAR OKRET; *)FILL
                 FI
                 IF CURPAGE=FPHYS THEN
 TODO1:             AD:=CCAREA; T:="DRETADDR"; X:=RETINDX+T; T:=0; *STDTX  %=:DRETADDR(RETINDX)
                    X:=RETINDX+2=:RETINDX
                    IF A:=X SHZ -1>=MXMININTERVAL GO 55ERR
 IO1ND:             PARTINDX+2=:PARTINDX
                    GO FAR DO1
                 FI
 IO2ND:          CURPAGE-1=:CURPAGE
 IO3ND:          X:=CMMENTRY-4
                 GO FAR DO2
              FI
 NUSEPAGE:    IF CPEND><0 THEN
                 AD:=CCAREA; A+1; T:="DRETADDR"; X:=RETINDX+T; T:=0; *STDTX  %AD=:DRETADDR(RETINDX)
                 X:=RETINDX+2=:RETINDX
                 IF A:=X SHZ -1>=MXMININTERVAL GO 55ERR
                 0=:CPEND
              FI
              IF CURPAGE=FPHYS GO IO1ND
              X:=CMMENTRY; T:=CORMBANK; *LDATX DPAGP
              IF A=CURPAGE GO IO2ND
              IF A>FPHYS GO IO3ND
              GO IO1ND
 EDO2:     IF CPEND><0 THEN CURPAGE+1=:CURPAGE; GO TODO1 FI
           GO FAR IO1ND
 *)FILL

 55ERR: X:="PAGPN"; T:=0
        DO
           X=:D; T=:L; *LDXTX DPAGL
        WHILE X><0
           T:=CORMBANK; *LDATX DPGPR
           IF A/\377-377=0 THEN
              A:=1; *STATX DPGPR; LDATX DPAGL
              X:=:D; T:=L; *STATX DPAGL
              X=:CMMENTRY; "XSGRT".BPAGLINK; A:=:D; A=:X.BPAGLINK
              X:=A; T:=CORMBANK; A:=D; *STATX DPAGL
              X:=CMMENTRY; T:=L
           FI
        OD
        IF "XSGRT".SEGLINK=0 AND X.BPAGLINK><0 THEN
           X:="BSEGLINK"; DO WHILE X.SEGLINK><-1; X:=A; OD
           "XSGRT"=:X.SEGLINK; -1=:"XSGRT".SEGLINK
        FI; GO FAR 5ERR
 *)FILL


 3F500: 0=:PARTINDX
        DO WHILE PARTINDX<NPARTS SH 1
           "DPARTADDR"; X:=PARTINDX+A; T:=0; *LDDTX      %AD:=DPARTADDR(PARTINDX)
           A=:FPHYS:=D=:CURPAGE
           X:="PAGPN"; T:=0
           DO
              X=:PREVX; T=:PREVT; *LDXTX DPAGL
              IF X=0 THEN CALL ERRFATAL FI
              T:=CORMBANK; *LDATX DPAGP
           WHILE A><FPHYS
              T:=CORMBANK
           OD
           X=:CBPGLINK
           DO
              T:=CORMBANK; *LDATX DPAGP
           WHILE A><CURPAGE
              T:=CORMBANK; *LDATX DPAGL
              IF A=0 THEN CALL ERRFATAL FI
              A=:X
           OD; T:=CORMBANK; *LDATX DPAGL; STZTX DPAGL
           T:=PREVT; X:=PREVX; *STATX DPAGL
           T:=CORMBANK; X:=CBPGLINK
           DO
              A:=1; *STATX DPGPR; LDXTX DPAGL
           WHILE X><0
           OD; X=:D; "XSGRT".BPAGLINK; X:=:D; *STATX DPAGL
           CBPGLINK=:D.BPAGLINK
        OD; GO FAR OKRET;*)FILL

 4F500: T:=CORMBANK; X:=ECORMAP; *LDDTX DPGPR
        IF ALPHYS>>D THEN A:=D=:ALPHYS FI
        NPAGES=:CSGNO
        IF A<=0 OR A>SGMAX GO 2ERR
        A*5SEGSIZE+SEGSTART=:SGADR; A.LOGADR SHZ -10=:NPAGES
        IF A=0 GO 2ERR
        IF X.FLAG=0 OR A BIT 5INHB OR A BIT 5DEMAND GO 2ERR
        IF A BIT 5FIX THEN
              X:=X.BPAGLINK; D:=0
              DO
                 T:=CORMBANK; *LDATX DPAGP
                 IF A<AFPHYS OR A>ALPHYS GO 2ERR
                 IF D=0 THEN
                    A=:D=:FPHYS
                 ELSE
                    IF A><D+1 GO 2ERR
                 FI; T:=CORMBANK; *LDXTX DPAGL
              WHILE X><0
              OD; A:=FPHYS; GO FAR OKRET
        FI; T:=CORMBANK; X:=ECORMAP; *LDDTX DPGPR
        IF AFPHYS+NPAGES>>D THEN 1; GO FAR 5ERR FI
        IF ALPHYS<<AFPHYS OR A-T+1<<NPAGES THEN 3; GO FAR 5ERR FI
        IF FIXPAGES+NPAGES>>FIXMAX THEN 3; GO FAR 5ERR FI
        CALL MBSREMOVE; 0=:NSHARED; GO FAR 500FIXC
 2ERR:  2; GO FAR 5ERR; *)FILL

 5F500: T:=CORMBANK; X:=ECORMAP; *LDDTX DPGPR
        IF ALPHYS>>D THEN A:=D=:ALPHYS FI
        X:=0
        DO WHILE X><"NALME+NALME"
              IF FXCTAB(X)=0 GO INDXFOUND
              X+2
        OD; A:=2; GO FAR 5ERR
 INDXFOUND: X=:CTINDX; T:=CORMBANK; X:=ECORMAP; *LDDTX DPGPR
        IF AFPHYS+NPAGES-1>>D THEN 1; GO FAR 5ERR FI
        IF ALPHYS<<AFPHYS OR A-T+1<<NPAGES THEN 3; GO FAR 5ERR FI
        0=:NSHARED; GO FAR 500FIXC
 *)FILL

 CSUBR: A:=1; T:=CORMBANK
        DO WHILE X><0
           X=:D; *STATX DPGPR; LDXTX DPAGL
        OD; "XSGRT".BPAGLINK; X:=D; *STATX DPAGL
        FXCTAB(CCTINDX); 0=:FXCTAB(X); X+1; 0=:FXCTAB(X); A=:"XSGRT".BPAGLINK
        IF X.SEGLINK=0 THEN
           BSEGLINK
           DO WHILE A.SEGLINK><-1 OD
           "XSGRT"=:X.SEGLINK; T=:"XSGRT".SEGLINK
        FI; EXIT

 6F500: IF X:=CCTINDX>>="NALME+NALME" OR X BIT "0" THEN 3; GO FAR 5ERR FI
        T:=CORMBANK; X:=FXCTAB(X); *LDATX DPAGP
        IF A><AFPHYS THEN 3; GO FAR 5ERR FI
        CALL CSUBR; A:=0; GO FAR OKRET

 7F500: IF NPAGES=0 THEN RTREF FI; A=:CCPRG
        A:=A-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
        IF D><0 THEN 3; GO FAR 5ERR FI            % ILLEGAL RT-PROG.
        0=:CCTINDX
        DO WHILE X:=CCTINDX<<"NALME+NALME"
           X+1
           IF FXCTAB(X)=CCPRG THEN
              X-1; X:=FXCTAB(X); T:=CORMBANK; CALL CSUBR
           FI; CCTINDX+2=:CCTINDX
        OD; A:=0; GO FAR OKRET
 *)FILL

 10F500: AFPHYS=:CLOGPAGE
        IF NPAGES>>SGMAX THEN 174; GO FAR 5ERR FI          % ILLEGAL SEGMENT NUMBER
        A*5SEGSIZE+SEGSTART=:SGADR                          % ADDR. OF SEG.TABLE ELEMENT
        IF A.FLAG=0 OR A BIT 5INHB THEN 2; GO FAR 5ERR FI   % SEGMENT NOT LOADED
        IF X.LOGADR SHZ -10<<CLOGPAGE THEN 174; GO FAR 5ERR FI % ILLEGAL PAGE NUMBER IN PAR.LISTE
        0=:CINDX; BREG.ZAREG=:CPHPAGE
        IF SGADR.FLAG NBIT 5FIX GO COKRET                   % SEGMENT NOT FIXED
        X.LOGADR/\377+CLOGPAGE=:CLOGPAGE; 0=:CCTINDX; 2=:CINDX
        T:=CORMBANK; IF X:=X.BPAGLINK=0 THEN 174; GO FAR 5ERR FI
        DO
           *LDATX DPAGP
           IF A=:D><CCTINDX+1 AND T:=CCTINDX><0 THEN 1=:CINDX ELSE A=:CCTINDX FI
           T:=CORMBANK; *LDATX DALOG
           IF A=CLOGPAGE THEN A:=D=:CPHPAGE FI
           T:=CORMBANK; *LDXTX DPAGL
        WHILE X><0
        OD
 COKRET: SGADR.FLAG=:BREG.ZDREG; CINDX=:X.ZTREG; CPHPAGE; GO FAR OKRET
 RBUS


 %============================================================================
 % 37.19      O U T L I N K
 %
 % SUBROUTINE TO REMOVE PAGES FROM A NON-DEMAND SEGMENT
 %
 % ENTRY:     X=CORMAP ADDRESS OF FIRST PAGE NOT TO REMOVE
 %            A=SEGMENT ADDRESS
 %
 SUBR OUTLINK
 INTEGER XREG,SGADR,SG1ADR:=XSGRT
 INTEGER POINTER LREG

 OUTLINK: X=:XREG:=L=:"LREG"; A=:SGADR
        IF A.BPAGLINK=XREG OR X.FLAG BIT 5DEMAND OR X="XSGRT" GO OUT
        X.FLAG BZERO 5OK=:X.FLAG
        DO WHILE X:=SGADR.BPAGLINK><XREG
           T:=CORMBANK; *LDATX DPGPR
           IF A BIT 5WIP THEN
              A:=1=:D; T:=SGADR; CALL XTOPOFF(ATRNSEG)
           FI; T:=SG1ADR;; SGADR; CALL XLINKOVER
        OD
 OUT:   X:=XREG; GO LREG

 RBUS


 %============================================================================
 % 37.20      X L I N K O V E R
 %
 % SUBROUTINE TO MOVE A PAGE FROM ONE SEGMENT INTO ANOTHER SEGMENT
 %
 % ENTRY:     T=ADDRESS OF SEGMENT TO LINK PAGE INTO
 %            T=0 LINK TO N500
 %            T>0 AND T<SEGSTART THEN T-1=INDEX IN FXCTABLE
 %            T>=SEGSTART THEN T=ADDRESS OF ORDINARY SEGMENT
 %            X=ADDRESS OF CORMAP ENTRY
 %            A=ADDRESS OF SEGMENT TO LINK PAGE FROM
 %
 SUBR XLINKOVER


 INTEGER BREG,XREG,AREG,LSSEG,CURPAGE
 INTEGER POINTER LREG

 XLINKOVER: T=:LSSEG; T:=:B; T=:BREG:=L=:"LREG"; A=:AREG; X=:XREG
        T:=0; X:=AREG+1
        DO T=:D; X=:L; *LDXTX DPAGL
        WHILE X><XREG
           T:=CORMBANK
        OD; A:=L=:AREG; T:=CORMBANK; *LDATX DPGPR
        A/\377*5SEGSIZE+SEGSTART=:LSSEG; AREG; *LDXTX DPAGL
        A:=:X; T:=D; *STATX DPAGL
        IF B>>SEGSTART THEN
           T:=5SEGSIZE; A:=B-SEGSTART; A=:D:=0; *RDIV ST
           A=:D:=FLAG/\177400+D; X:=XREG; T:=CORMBANK; *STATX DPGPR
           BPAGLINK; X=:BPAGLINK; *STATX DPAGL
        ELSE                            % ALLOCATE NORD-500 MEMORY
           X:=XREG; T:=CORMBANK; *LDATX DPAGP
           A=:CURPAGE
           IF B=0 THEN "PAGPN" ELSE A:=B+"FXCTAB-1" FI
           X:=A; T:=0
           DO
              X=:D; T=:L; *LDXTX DPAGL
           WHILE X><0
              T:=CORMBANK; *LDATX DPAGP
              IF A-CURPAGE>=0 THEN
                 X:=D; T:=L; *LDATX DPAGL
                 A=:D:=XREG; *STATX DPAGL
                 X:=A; T:=CORMBANK; A:=D; *STATX DPAGL
                 GO XOUT
              FI
           OD; X:=D; T:=L; XREG; *STATX DPAGL
           X:=A; T:=CORMBANK; *STZTX DPAGL
 XOUT:     160000; *STATX DPGPR
        FI; IF LSSEG.BPAGLINK=0 AND X.SEGLINK><0 THEN CALL XTOPOFF(SREMOVE) FI
 OUT:   IF X:=LSSEG>=SEGSTART THEN
           IF X.FLAG NBIT 5DEMAND THEN A BZERO 5OK=:X.FLAG FI
        FI; BREG=:B; X:=XREG; GO LREG

 RBUS

 *"8SIBA+8SIBX+8SIBM
" %==============================================================================
 %            M A P S I B   -   M S I B B
 %
 % SIBAS COMMUNICATION MONITOR CALL
 %
 SUBR 3MAPSIB,3MSIBB

 INTEGER ARRAY POINTER ACCTAB:=CCTAB
 DOUBLE ARRAY POINTER DACCTAB=ACCTAB
 DOUBLE ARRAY CRTCADDR(0)
         *0;0;0;0;0;0
 *"8SIBX+8SIBM
"
 INTEGER IMAPSIB:=0           % ><0 AFTER FIRST MAPSIB

 3MAPSIB: IF BACKGROUND><0 THEN CALL ESCOFF FI
        IF SRTCSTAT><0 GO FAR M2ERR
        X:=SIBBDEVS(ZTREG)
        IF X:=X.RTRES=0 GO FAR M1ERR; IF X.STATUS NBIT 5WAIT GO FAR M2ERR
        IF IMAPSIB=0 THEN
           0=:SICCOUNT
           FOR SICCOUNT TO MXSIBAS DO
              T:=SICCOUNT SH 11; A:=177000-T SHZ -12+100=:L
              X:=0
              DO ACCTAB(X) WHILE A><-1
                 IF A/\377=L THEN
                    AD:=DACCTAB(X); A:=0; AD SH 12
                    IF T:=SICCOUNT NBIT "0" THEN T:=1000; D+T FI
 INDO1:             X:=SICCOUNT+X; AD=:CRTCADDR(X); GO EFOR
                 FI; X+2
              OD; A:=0=:D; GO INDO1
 EFOR:     OD
 OKINIT:   1=:IMAPSIB
        FI; X:=ZTREG+X; AD:=CRTCADDR(X); IF A=0 AND D=0 GO FAR EE174
        AD=:SIDRTC
        X:=ZXREG; OLDPAGE=:D; CALL DALTON; *BSET ZRO
        MLEV; *MST PIE
        *BSET ONE; LDA 1,X; BSET ZRO
        IF A=0 OR A>>177 GO FAR EE174; A=:SICCOUNT; GO L1; *)FILL
 L1:
 @LIB CXCPU
 @LIB CXCPU-,
        T:=SIAD1; SIAD2+777=:X; A:=B; *STATX
        X:=SIAD2; SICCOUNT=:L; ZXREG=:B; *BSET ONE
        DO WHILE L><0
           *LDD ,B; STDTX; LDD 2,B; STDTX 20
           B+4; X+4; L-1
        OD; A:=X/\177000+777=:X; *LDATX; COPY SA DB
 @ELIB
        *BSET ZRO
 TOSIBAS:                     % LET'S ACTIVATE SIBAS AND WAIT FOR REPLY
        *IOF
        X:=SIBBDEVS(ZTREG)
        IF X.SIB500=0 THEN
           IF X:=X.RTRES=0 GO M1ERR; IF X.STATUS NBIT 5WAIT GO M1ERR
           A BZERO 5WAIT=:X.STATUS
        ELSE
           IF X.RTRES=0 GO M1ERR
           A=:D; *IOF
           CALL TOPOFF(FSEMA); GO M1ERR; CALL TOPOFF(MMBREACTIVATE); GO M1ERR
        FI; GO OVER; *)FILL
 OVER:  RTREF.STATUS BONE 5WAIT=:X.STATUS; -1=:SRTCSTAT
        "STUPR"; *IRW MLEVB DP
        MLEV; *MST PID; PION
        X:=SIAD2; T:=SIAD1; *LDATX 10
        IF A=0 OR A>>177 GO EE174; A=:SICCOUNT

 @LIB CXCPU
 @LIB CXCPU-,
        T:=SIAD1; SIAD2+777=:X; A:=B; *STATX
        X:=SIAD2; SICCOUNT=:L; ZDREG=:B; *BSET ONE
        DO WHILE L><0
           *LDDTX; STD ,B; LDDTX 20; STD 2,B
           B+4; X+4; L-1
        OD; A:=X/\177000+777=:X; *LDATX; COPY SA DB
 @ELIB
        *BSET ZRO
 OKRET: 0=:ZAREG; MIN ZPREG; 0/\0; GO MXRET
 *)FILL
 EE174: 174; GO CERET
 M2ERR: A:=-2; GO CERET
 M1ERR: A:=-1
 CERET: A=:ZAREG; *PION
        GO MXRET

 3MSIBB: X:=SIBAPDEVS(ZTREG)=:D; 0=:SIB500
        *IOF
        IF X:=X.RTRES><0 AND X.STATUS BIT 5WAIT THEN A BZERO 5WAIT=:X.STATUS FI
        IF ZAREG=0 THEN RTREF.STATUS BONE 5WAIT=:X.STATUS; A:=0 ELSE A:=1 FI
        A=:D.SRTCSTAT; MIN ZPREG; 0/\0
        "STUPR"; *IRW MLEVB DP
        MLEV; *MST PIE; MST PID; ION
        GO RET

 RBUS

