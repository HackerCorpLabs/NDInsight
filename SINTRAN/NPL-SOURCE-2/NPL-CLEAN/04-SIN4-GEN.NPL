%==============================================================================
% 29.6       S E G M E N T  T A B L E
%
% CALCULATE VALUES FOR ALLOCATING (LOGICAL AND PHYSICAL ADDRESSES) SEGMENTS

% LOGICAL START OF SYSTEM SEGMENT
SYSST=BGSYS@-12
% SIZE OF SYSTEM SEGMENT (5 PAGES - IN LEFT BYTE)
SYSSZ=5SSSZ@10
5NBSG=2      % NUMBER OF SEGMENTS FOR EACH BACKGROUND PROCESS
5SDSP=1002   % SEGM. DISPLACEMENT (2 FOR SYSTEM AND USER SEGM.)
"8RFAC
5FDSZ=4      % SIZE OF FILE USER DATA SEGMENT
FRSSZ=26     % SIZE OF FILE USER REENTRANT SEGMENT
FDSTR=72     % START PAGE OF FILE USER DATA SEGMENT
"
5ESSZ=2      % SIZE OF ERROR SEGMENT
SGLEN=0      % SEGMENT LENGTH IN PAGES
SGMAD=0      % MASS STORAGE ADDRESS IN PAGES OF THE SEGMENT
NNBRT=0      % NUMBER OF BACKGROUND PROGRAMS

%==========================================================================
%      S E G M E N T  T A B L E

XSEGS=*
       0;0;0;0;0                       % RESIDENT
XSGRT, -1
BPAG1, XCORM;177000;0;161000           % DUMMY SEGMENT

       MSGLE 77


       XY=SGMAD; )KILL SGMAD; SGMAD=XY+SGLEN; )KILL XY
       )KILL SGLEN CSGLE; SGLEN=77; CSGLE=SGLEN@10

SG2,   0;0;CSGLE+100;SGMAD;162003      % MEMORY IMAGE
       SGLEN:000077     SGMAD:000000
       SG02S=00@12

       MSGLE 32


       XY=SGMAD; )KILL SGMAD; SGMAD=XY+SGLEN; )KILL XY
       )KILL SGLEN CSGLE; SGLEN=32; CSGLE=SGLEN@10

SG3,   0;0;CSGLE+044;SGMAD;162003      % COMMAND SEGMENT
