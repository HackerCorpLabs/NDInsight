       SG03S=44@12

       MSGLE 20


       XY=SGMAD; )KILL SGMAD; SGMAD=XY+SGLEN; )KILL XY
       )KILL SGLEN CSGLE; SGLEN=20; CSGLE=SGLEN@10

SG4,   0;0;CSGLE+044;SGMAD;62003       % REENTRAN RT-LOADER SEGMENT
       SGLEN:000020     SGMAD:000131
       SG04S=44@12

       MSGLE 5ESSZ


       XY=SGMAD; )KILL SGMAD; SGMAD=XY+SGLEN; )KILL XY
       )KILL SGLEN CSGLE; SGLEN=5ESSZ; CSGLE=SGLEN@10

