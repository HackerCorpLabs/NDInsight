 %==============================================================================
 %  36.1      G E T 0   G E T 1   G E T 2   G E T 3   G E T 4
 %            G E T 5   G E T S 2

 % SUBROUTINES TO GET PARAMETER VALUES FROM USER
 % ENTRY:     B=PARAMETER LIST
 %            X=WORKING AREA
 % RETURN:    X=B=WORKING AREA
 % RT LEVEL

 SUBR GET0,GET1,GET2,GET3,GET4,GET5,GET6,GETS2
 DISP 0; DOUBLE POINTER DP1=P1; DOUBLE DD1=D1; PSID
 GETS2: DP1; *BSET ZRO 0; STD DD1,X; BSET ONE 0; JMP GET1
 GET6:  P5; *BSET ZRO 0; STA D5,X; BSET ONE 0
 GET5:  P4; *BSET ZRO 0; STA D4,X; BSET ONE 0
 GET4:  P3; *BSET ZRO 0; STA D3,X; BSET ONE 0
 GET3:  P2; *BSET ZRO 0; STA D2,X; BSET ONE 0
 GET2:  P1; *BSET ZRO 0; STA D1,X; BSET ONE 0
 GET1:  P0; *BSET ZRO 0; STA D0,X; BSET ONE 0
 GET0:  X=:B; *PIOF
        IF BACKGROUND><0 THEN L=:D;*PION
              CALL XBMRET; D=:L; *POF
        FI
        RTREF.ACTPRI/\177177=:X.ACTPRI/\3773; B=:X; *TRR PCR
        MLEV; *MCL PIE; TRA PGS; PION
        EXIT
 RBUS




 %==============================================================================
 % 36.2       P M T R A N S

 DOUBLE SWPCOREADR,SWPMASSADDR
 INTEGER SWPMTMODUS,SWPBLPAGE
 INTEGER SWPPARLIST:=(SWPMTMODUS,SWPCOREADR,SWPMASSADR,SWPBLPAGE)

 SUBR PMTRANS
 INTEGER POINTER LREG
 PMTRANS: T:=L=:"LREG"; CALL MTRANS; *POF
        GO LREG
 RBUS

 SUBR PAGEFAULT,PAGE2FAULT,PWFAIL,RESYS,COLDSTART
 RBUS

 %==============================================================================
 % 36.3       P P A G E F A U L T   P 2 P A G E 2 F A U L T
 %            P P W F A I L   P R E S Y S
 %            P C O L D S T A R T

 SUBR PPAGEFAULT,P2PAGE2FAULT,PPWFAIL,PRESYS,PCOLDSTART
 PPAGEFAULT: *POF
        GO PAGEFAULT
 P2PAGEFAULT: *POF
        GO PAGE2FAULT
 PPWFAIL: *PIOF
        GO PWFAIL
 PRESYS: *PIOF
        GO RESYS
 PCOLDSTART: *PIOF
        GO COLDSTART
 RBUS

 %============================================================================
 % 36.4       A T R A N S      X T R A N S    D B T R A N S
 %
 % SUBROUTINE TO TRANSFORM ADDRESSES TO WINDOW ADDRESSES
 % CALLED FROM BLOCK MONITOR CALLS (MAGTP,RFILE,..) AND XMSG
 % RT LEVEL
 %
 % ATRANS:    PAGING/INTER. STATUS. ON CALL: UNDEFINED, RETURN: PION
 % ENTRY:     A=USER ADDRESS,  X=BUFFER ADDRESS, D=CALLING RT-PROGRAMS ACTPRI
 % RETURN:    A=WINDOW ADDRESS, X=BUFFER WINDOW
 %
 % DBTRANS:   PAGING/INTERRUPT STATUS AS FOR ATRANS.
 % ENTRY:     AS FOR ATRANS BUT T-REG MUST CONTAIN NO. OF BANK IN WHICH BUFFERS LIE.
 % EXIT:      AS FOR ATRANS.

 % XTRANS:    PAGING/INTER. STATUS MUST BE PIOF WHEN CALLING XTRANS (AND RETURN)
 % ENTRY:     AS ATRANS, BUT T=BANK NO OF BUFFER (0 TO 3)
 % RETURN:    AS ATRANS

 SUBR ATRANS,XTRANS,DBTRANS
 INTEGER TREG,AREG,DREG,XREG; REAL TADREG=TREG
 DOUBLE POINTER BPG:=177000+5BFPAGE+5BFPAGE
 DOUBLE POINTER WND0:=177174,WND1:=177176
 INTEGER C5BFPAGE(0); *5BFPA@12                   % "5BFPA*2000"

 XTRANS: X=:XREG
 FELLS: TAD=:TADREG; 600/\D SHZ -1; T:=AREG SHZ -12\/A % USER LOG PAGE
        XREG/\176000=:D:=TREG; AD SHZ -2
 @LIB CXCPU-,
        T\/D=:RTREF.WINDOW
        T SHZ -10=:D; A:=162000; AD=:BPG
        X.WINDOW/\377=:WIND1 SH 1+177000=:X
        AD:=X.DOU0=:WND0; X+2
        IF X<0 THEN AD:=X.DOU0 ELSE A:=0 FI; AD=:WND1
        T:=174000
 @ELIB
 @LIB CXCPU
        1777/\XREG\/C5BFPAGE=:X                   % LOG. ADDR OF SYSTEM BUFFER
        1777/\AREG\/T=:AREG                       % LOG. ADDR OF USER BUFFER
        TAD:=TADREG; EXIT

 INTEGER ATSAV,ALSAV,BANKSAV                      % SAVE LOCATIONS FOR ATRANS AND DBTRANS
 DBTRANS:
          *PIOF
          T=:ATSAV=:BANKSAV                       % BANK IN WHICH DEVICE BUFFERS LIE.
 @LIB CXCPU
 @LIB CXCPU-,
          GO COMM
 @ELIB

 ATRANS:  *PIOF
          T=:ATSAV:=0=:BANKSAV                    % BANK 0
 COMM:    X=:XREG:=L=:ALSAV
          CALL FELLS; T:=ALSAV=:L:=ATSAV; *PION  % RESTORE REGISTERS
        EXIT
 RBUS



 %==============================================================================
 %
 %                S E G M E N T  M O N I T O R  C A L L S
 %
 %==============================================================================
 % 36.5       M C A L L   M E X I T

 % MONITOR CALLS MCALL AND MEXIT - TO CHANGE SEGMENTS
 % APPL. LEVEL

 SUBR MCALL,MEXIT,0LEGSEG,LEGSEG,R15ERRD,RLEGSEG

 DISP 0; DOUBLE MSTADR; PSID
 DISP 0; INTEGER MSEGM=D0; PSID
 INTEGER STRA,LA,STRB,LB,MSEGA,MSEGB
 INTEGER POINTER LREG

 MCALL: T=:B; MSTADR; CALL ALTOFF; T:=X.ZPREG=:X.ZLREG
        A=:X.ZPREG:=D=:X.MSEGM; CALL GET0; GO MMC

 MEXIT: CALL GET0; ZLREG=:ZPREG; T=:MSEGM
 MMC:   RTREF.ACTSEG=:ZTREG
        IF MSEGM SHZ -10=377 THEN X.ACTSEG SHZ -10 FI
        A=:MSEGA; CALL DECO; A=:STRA; T=:LA; X:=RTREF
        IF MSEGM/\377=377 THEN X.ACTSEG/\377 FI
        A=:MSEGB; CALL DECO; T=:LB
 %CHECK FOR OVERLAP:
        IF A>STRA THEN IF A-LA<T GO ERRO
        ELSE IF A+LB>T GO ERRO
        FI
        MSEGA SH 10+MSEGB=:RTREF.ACTSEG
        GO RETSTUPR
 ERRO:  MSEGA SH 10+MSEGB; CALL 9ERRA(#42); GO RETXIT  % OVERLAP

 % DECODE SEGMENT ELEMENT
 % ENTRY: A=SEGMENT NUMBER; X=RTREF
 % EXIT:  A=FIRST LOGICAL PAGE IN SEGMENT; T=NUMBER OF PAGES IN SEGMENT
 DECO:  IF A=0 THEN T:=0; EXIT FI
        T:=L=:"LREG"; IF A=X.RSEGM GO ERRIL
        CALL LEGSEG; *POF
        CALL SHRSOVERLAP; *PON
        T:=X.LOGADR SHZ -10; X.LOGADR/\377
        GO LREG

 % SUBROUTINE TO CHECK FOR LEGAL SEGMENT
 % ENTRY:     A=SEGMENT NUMBER
 % EXIT:      A=SEGMENT FLAG; D=SEGMENT NUMBER; X=SEGMENT TABLE ADDRESS
 % RETURN TO RETXIT IF ERROR

 0LEGSEG: IF A=0 GO ERRIL
 LEGSEG:  IF A>>X:=SGMAX GO ERRIL
          A=:D*5SEGSIZE+SEGSTART=:X
          IF X.FLAG=0 OR A BIT 5INHB GO ERRNL
          EXIT

 R15ERRD:
 ERRIL: CALL 9ERRA(#15); GO RETXIT                % ILL.SEGM.NO.
 ERRNL: A:=D; CALL 9ERRA(#16); GO RETXIT          % SEGMENT NOT LOADED

 % CHECK FOR LEGAL SEGMENT NUMBER IN MON REENT/SREENT CALLED FROM BACKGROUND
 % PROGRAMS. ONLY SEGMENTS ON PIT 1 AND PIT 2 WITH PROTECTION RING ZERO
 % IS LEGAL
 %
 RLEGSEG: IF BACKGROUND><0 AND OLDPAGE/\3=0 THEN
              IF X.LOGADR/\300><100 AND A><200 GO ERRIL
              IF X.FLAG/\3><0 GO ERRIL
          FI; EXIT
 RBUS

 %==============================================================================
 % 36.6       M F I X   M U N F I X

 %MONITOR CALLS: CALL FIX(SEGNO),CALL UNFIX(SEGNO)
 SUBR MOFIX,MUNFIX
 DISP 0; INTEGER SGADR=D1,OLDSGNO=D2; PSID

 MOFIX: CALL GET1; D0; CALL 0LEGSEG
        IF A BIT 5DEMAND GO ERRD
        IF A BIT 5FIX GO RET
        IF X.LOGADR SHZ -10=0 GO ERRNL
        IF A+FIXPAGES>FIXMAX GO ERRF
        A=:FIXPAGES; X=:SGADR
        RTREF.ACTSEG=:OLDSGNO; D0=:X.ACTSEG
        "STUPR"; *IRW MLEVB DP
        MLEV; *MST PID; MST PIE
 %RETURN WITH CHANGED SEGMENT
        MLEV; *MCL PIE
        OLDSGNO=:X.ACTSEG    %CHANGE BACK
        SGADR.FLAG BONE 5FIX=:X.FLAG
        X=:L:="BSEGLINK"
 LOOP:  X=:D:=X.SEGLINK; IF X=-1 THEN CALL ERRFATAL FI
        IF X><L GO LOOP
        X.SEGLINK; 0=:X.SEGLINK; A=:D.SEGLINK
        GO RETSTUPR

 MUNFIX: CALL GET1; IF D0=0 OR A>>SGMAX GO ERRIL
        A*5SEGSIZE+SEGSTART
        IF A.FLAG BIT 5FIX THEN
              A BZERO 5FIX=:X.FLAG
              377; T:=X.LOGADR SHZ -10/\A; FIXPAGES-T=:FIXPAGES; IF <0 GO ERRF
              IF X.SEGLINK><0 THEN CALL ERRFATAL FI
              BSEGLINK=:X.SEGLINK; X=:BSEGLINK
        FI; GO RET

 ERRNL: D0; CALL 9ERRA(#16); GO RETXIT    % EMPTY SEGMENT (NOT LOADED)
 ERRD:  D0; CALL 9ERRA(#17); GO RETXIT    % FIXING DEMAND
 ERRF:  D0; CALL 9ERRA(#18); GO RETXIT    % TOO MANY FIXED
 ERRIL: D0; CALL 9ERRA(#15); GO RETXIT    % ILLEGAL SEGMENT NUMBER
 RBUS

 %==============================================================================
 % 36.7       W S E G   -   W S E G X

 % MONITOR CALL: CALL WSEG(SEGNO) - WRITE BACK SEGMENT
 SUBR WSEG,WSEGX

 INTEGER SG,SGA
 INTEGER POINTER CRETADR

 WSEG:  CALL GET1
        "RET"=:"CRETADR"
        D0=:SG; CALL 0LEGSEG; X=:SGA
 FELLS: *POF
        CALL SRESER; *PON
        "MWSEG"; *IRW MLEVB DP
        MLEV; *MST PID; MST PIE

 %MONITOR LEVEL:
 MWSEG: X:=RTREF=:SRTREF
        IF SGA.FLAG=0 OR A BIT 5INHBT THEN
           SG; CALL 9ERR(#16); GO BRTEXT
        FI; A BZERO 5OK=:X.FLAG; X=:B=:SEGREF:=SRTREF
        *POF
        A:=B; CALL CSEGS; 1=:NUMBER; CALL TRNSEG
        X:=SRTREF; CALL ZSRELES; "OUT"; *PON
        IF X=CURPROG THEN
           *IRW ALEVB DP
        ELSE
           X:=X.RTDLGADDR; T:=0; *STATX XTDPR
        FI; GO STUPR
 %RT LEVEL:
 OUT:   GO CRETADR

 % CALLED FROM PSPLREE IN POF
 % ENTRY:     A=SEGMENT NUMBER
 %            X=ADDRESS OF SEGMENT TABLE ENTRY
 %

 INTEGER POINTER WSEGL
 WSEGX: A=:SG:=L=:"WSEGL":="WSEG1"=:"CRETADR"; X=:SGA; GO FELLS
 WSEG1: GO WSEGL
 RBUS

 %==============================================================================
 % 36.8       R E E N T

 % MONITOR CALL REENT(SEGNO) - ATTACH REENTRANT SEGMENT
 SUBR REENT,IMREENT
 DISP 0; INTEGER RESEG=D1; PSID

 REENT: CALL GET1; *POF
 IMREENT:  CALL XCSEGS
        IF D0><0 THEN
           CALL LEGSEG
           X=:RESEG; IF A NBIT 5DEMAND GO ERRD
           IF X=NSEGA OR X=NSEGB GO RETSTUPR
           CALL RLEGSEG
           T:=D0; NSEGA.FLAG; CALL SHRSOVERLAP
           T:=D0; NSEGB.FLAG; CALL SHRSOVERLAP
           NSEGA; T:=RESEG; CALL OVERLAP
           NSEGB; T:=RESEG; CALL OVERLAP
        FI
        X:=RTREF; CALL CLRBMAP
 OUT:   RTREF.RSEGM/\177400+D0=:X.RSEGM; GO RETSTUPR

 ERRD:  CALL 9ERRA(#45); GO RETXIT  % NOT DEMAND SEGMENTS
 RBUS


 %===========================================================================
 %            S P L R E E
 % MON SPLREE(SGNO,FP1,NP1,FP2,LP2,FLAG)
 %            FP1= FIRST PAGE IN LOG.AREA 1 TO OVERLAP BACKGROUND SEGMENT
 %            NP1= NUMBER OF PAGES IN AREA 1
 %            FP2= FIRST PAGE IN LOG.AREA 2 TO OVERLAP BACKGROUND SEGMENT
 %            NP2= NUMBER OF PAGES IN AREA 2
 %            FLAG><0: CLEAR PAGE-OWNER TABLE
 %
 SUBR SPLRE,3SPLRE
 SPLRE: CALL GET6; *POF
        CALL XCSEGS; CALL S3NOALTPIT; *PON
        GO 3SPLRE
 RBUS


 %====================================================================
 % 36.10      C H C O R M A P
 %
 SUBR CHCORMAP
 CHCORMAP: EXITA
 RBUS

 %=============================================================================
 %            S S S W P   -   C B R E L   -   C B R E S
 %
 % RT-PROGRAM RESERVING THE SWAPPING-SEMAPHORE (CLFIE) AND WAITING FOR
 % THE DISC ON BEHALF OF THE SWAPPING-REQUESTING PROGRAM
 % THE SWAPPING-REQUESTING PROGRAM WILL BE SET IN SWAPPING-WAIT
 % 1SWAP HAS THE PRIORITY OF THE SWAPPING-REQUESTING PROGRAM
 %
 SUBR INRWSEGM,SSSWP,CBREL,CBRES,LNK1SWAP
 INTEGER XREGG
 SSSWP: *IOF
        "XRTEX"; *IRW MLEVB DP
        MLEV; *MST PID; ION
        GO SSSWP

 % MONITOR LEVEL
 XRTEX: X:="1SWAP"
        DO WHILE X.BRESLINK><X; A=:B; CALL BRELEASE; OD
        CALL FREXQ
        IF SWPFLAG><1 THEN
           X:="BEXQU-WLINK"; T:="BEXQU-BWLINK"; A:=XREGG
           DO WHILE X:=X.WLINK><T
              IF X=A GO IRWAIT
           OD
        FI; GO STUPR

 % SUBROUTINES FOR QUICK BRESERVE/BRELEASE
 CBREL: X+5BRESLINK
        DO WHILE X.RESLINK><B; X:=A; OD
        RESLINK=:X.RESLINK; 0=:RESLINK=:RTRES; EXIT

 CBRES: X.BRESLINK=:RESLINK; A:=B=:X.BRESLINK; X=:RTRES; EXIT

 %============================================================================
 %            L N K 1 S W A P
 %
 % ROUTINE TO START 1SWAP
 % MONITOR LEVEL, CALLED FROM RWSEGM
 %
 % ENTRY:     B=ADDRESS OF DISC DATAFIELD
 %            X=DISC-REQUESTING RT-PROGRAM
 %
 % EXIT TO PSTUPR
 %

 LNK1SWAP: X=:XREGG
        X.ACTPRI BONE 5SWWAIT=:X.ACTPRI
        X.STATUS BONE 5WAIT=:X.STATUS
        X:="1SWAP"; CALL TOWQU                    % 1SWAP WAITS FOR DISC
        X:=XREGG; "CLFIE"=:B; CALL CBREL          % RELEASE SWAPPING-SEMAPHORE FROM
                                                  % DISC-REQUESTING PROGRAM
        X:="1SWAP"; CALL CBRES                    % DISC IS RESERVED BY 1SWAP
        GO PSTUPR
  RBUS

 %==========================================================================
 %            S W P R E L E A S E
 %
 % RESETT THE SWAPPING-QUEUE
 %
 % ENTRY:     B=DATAFIELD
 %
 SUBR SWPRELEASE
 INTEGER XREGG
 SWPRELEASE:
        IF "CLFIE"=B THEN
           X=:XREGG:="BEXQUE-WLINK"; T:="BEXQU-BWLINK"
           DO WHILE X:=X.WLINK><T
              IF X.ACTPRI BIT 5SWWAIT THEN
                 A BZERO 5SWWAIT=:X.ACTPRI; X.STATUS BZERO 5WAIT=:X.STATUS
              FI
           OD; X:=XREGG
        FI; EXIT
 RBUS

 %===========================================================================
 %            M R L C L F I E
 %
 % SUBROUTINE TO RELEASE THE SWAPPING-SEMAPHORE (CLFIE) WHEN
 % WAITING FOR THE DISC (WAITING IN RWSEGM)
 %
 % CALLED FROM MESCAPE AND SYSABORT IN MON-60 (ND-500 DRIVER)
 %
 % ENTRY: X=ACTUAL PROGRAM
 %
 SUBR MRLCLFIE
 MRLCLFIE: IF SWPFLAG><0 THEN
              IF X.ACTPRI BIT 5SWWAIT THEN
                 A BZERO 5SWWAIT=:X.ACTPRI
                 X.STATUS BZERO 5WAIT=:X.STATUS
              FI
           FI; EXIT
 RBUS

 *"8DILG
"
 %==============================================================================
 % 36.13      E N T S G
 %
 %  MONITOR CALL: ENTSG(SEGNO,PT.NO,INT.LEVEL,STARTADDR)
 %  ENTERING A FIXED SEGMENT INTO THE PAGE TABLES
 SUBR ENTSG
 INTEGER SVB,IRWINST(0); *IRW DP
 ENTSG: CALL GET4
        IF D1>>3 GO ERR                     % ILLEGAL PAGE TABLE NUMBER
        IF D0>>SGMAX GO ERR
        A*5SEGSIZE+SEGSTART
        IF A.FLAG NBIT 5FIX GO ERR
        D1; *PIOF
        A SH 7+177000:=:B=:SVB; T:=CORMBANK; X:=X.BPAGLINK
        DO WHILE X><0
           *LDATX DALOG
           A/\77 SH 1+B=:B; *LDDTX DPGPR
           AD=:DOU0; A:=B/\177600=:B; *LDXTX DPAGL
        OD; SVB=:B; *PION
        IF D2<2 OR >11 OR =3 OR =4 GO ERR
        D1 SH 7=:D SH 2; D\/A; D2 SH 3+2\/D; *TRR PCR
        D2 SH 3\/IRWINST=:T; D3; *EXR ST
        1; FOR X:=D2- DO A SH 1; OD; *MST PIE
        0=:ZAREG; GO RET
 ERR:   -1=:ZAREG; GO RET
 RBUS

 %===========================================================================
 %            F X C T A
 %
 % TABLE FOR START OF COREMAP FOR ALLOCATED MEMORY AREAS (NOT SEGMENTS)
 % LAYOUT: WORD 1: MEMORY MAP POINTER OF THE ALLOCATED MEMORY AREA
 %         WORD 2: PROGRAM WHICH HAS ALLOCATED THE MEMORY AREA

 INTEGER ARRAY FXCTAB(0)
 * FXCTA<*+NALME+NALME; )ZERO; *+NALME+NALME/


 INTEGER PAGPN                % MEMORY MAP ELEMENT ADDR OF FIRST PAGE
                              % LINKED OUT BY MON 61

 %===========================================================================
 % 36.14      F I X C   P F I X C   F I X C 5 0 0
 %

 SUBR FIXC,PFIXC,FIXC500

 BASE BFIXC
 INTEGER SGADR,FPHYS,SG1ADR:=XSGRT,OLDFLAG
 INTEGER CMMENTRY,CSEGN,STEPINCR,CCORMSTART,CECORMAP,BREG
 INTEGER COLDFLAG,CINDX
 INTEGER PGFOUND,PREVPGFOUND
 INTEGER CFPHYS,CT,CA,CD,CLOGPAGE,CCECORMAP
 INTEGER POINTER LINK
 TRIPLE CTAD=CT
 INTEGER FIXFLAG
 INTEGER NPAGES; INTEGER CCTINDX=NPAGES
 INTEGER AFPHYS,NPARTS=AFPHYS
 INTEGER ALPHYS; DOUBLE ARRAY POINTER DPARTADDR=ALPHYS
 INTEGER NSHARED; INTEGER POINTER RNPARTS=NSHARED; INTEGER MXMININTERVAL=NSHARED
 INTEGER ARRAY POINTER ARRPNT; DOUBLE ARRAY POINTER DRETADDR=ARRPNT
 DOUBLE ARRAY POINTER DARRPNT=ARRPNT
 TRIPLE ARRAY POINTER FARRPNT=ARRPNT
 INTEGER ARRAY POINTER PCCTAB:=CCTAB
 DOUBLE ARRAY POINTER DPCCTAB=PCCTAB
 DOUBLE POINTER DCCFPA:=CCFPA
 INTEGER PREVT,PREVX
 TRIPLE T5D1=NPAGES; DOUBLE D5DD4=NSHARED
 INTEGER CURPAGE,CPEND; DOUBLE CCAREA=CURPAGE
 INTEGER CNPAGES=CPEND, CSGNO=CPEND, CTINDX=CPEND
 INTEGER CBPGLINK
 INTEGER PARTINDX,RETINDX
 INTEGER POINTER RINDXADDR
 INTEGER SVFLAGB
 ESAB

 DISP 0; TRIPLE TD1=D1; DOUBLE DD4=D4; PSID
 INTEGER POINTER PPTTIF:=TTIFIELD

 FIXC:  CALL GET2; D1=:"BFIXC".FPHYS
        IF D0 BZERO 17<=0 OR A>SGMAX GO ERRIL     % ILLEGAL SEGMENT NUMBER
        A*5SEGSIZE+SEGSTART=:X.SGADR
        IF A.FLAG=0 OR A BIT 5INHB GO ERRNL       % SEGMENT NOT LOADED
        IF A BIT 5DEMAND GO ERRD                  % DEMAND SEGMENT NOT LEGAL
        T:="BFIXC"; T:=:B; T=:BREG
        IF A BIT 5FIX THEN                        % SEGMENT ALREADY FIXED
 % CHECK IF FIXED CONTINUOUS IN CORRECT ADDRESS
           FPHYS=:CURPAGE; X:=X.BPAGLINK; T:=CORMBANK
           DO
              *LDATX DPAGP
              IF A-CURPAGE><0 THEN BREG=:B; GO ERRFX FI  % ERROR, FIXED IN WRONG ADDR.
              MIN CURPAGE; *LDXTX DPAGL
           WHILE X><0
           OD; BREG=:B
           IF D0 BIT 17 THEN A:=0; GO FXRET FI; GO RETSTUPR % SEGMENT FIXED OK.
        FI
        IF SGADR.LOGADR SHZ -10=0 THEN BREG=:B; GO ERRNL FI % ERROR, EMPTY SEGMENT
        A=:NPAGES
        IF A+FIXPAGES>FIXMAX THEN BREG=:B; GO ERRF FI  % TOO MANY FIXED PAGES
        0=:FIXFLAG
 L1:    IF BACKGROUND><0 THEN
           PPTTIF.FLAGB=:SVFLAGB; CALL ESCOFF
        FI
        CALL S3NOALPIT                  % ALT PIT=NORM PIT=3
        GO PFIXC; *)FILL


 ERRIL: IF D0 BIT 17 THEN A:=-2; GO FXRET FI
        CALL 9ERRA(#15); GO RETXIT        % ILL.SEGM.NO.
 ERRNL: IF D0 BIT 17 THEN A:=-3; GO FXRET FI
        CALL 9ERRA(#16); GO RETXIT    % NOT LOADED
 ERRD:  IF D0 BIT 17 THEN A:=-4; GO FXRET FI
        CALL 9ERRA(#17); GO RETXIT    % FIXING DEMAND
 ERRF:  IF D0 BIT 17 THEN A:=-5; GO FXRET FI
        CALL 9ERRA(#18); GO RETXIT    % TOO MANY PAGES FIXED
 ERRFX: IF D0 BIT 17 THEN A:=-6; GO FXRET FI
        CALL 9ERRA(#25); GO RETXIT    % ALREADY FIXED

 FXRET: A=:ZAREG; GO RETSTUPR         % RETURN TO USER PROGRAM

 %=========================================================================
 % SPECIAL MONITOR CALL TO ALLOCATE MEMORY SPACE FOR NORD-500 SEGMENTS
 % AND/OR FIXC (IN MEMORY AREA)/ ALLOCATE BUFFER (IN MEMORY AREA)
 %
 %
 % FUNCTION=1:      ALLOCATE MEMORY FOR NORD 500 SEGMENT - ONE USER VERSION
 %
 % PAR1:      NUMBER OF PAGES IN SEGMENT
 % PAR2:      FIRST LEGAL PHYSICAL PAGE FOR SEGMENT
 % PAR3:      LAST LEGAL PHYSICAL PAGE FOR SEGMENT
 % PAR4:      NUMBER OF SINTRAN III/N500 SHARED AREAS
 % PAR5:      ADDRESS OF SHARED INFORMATION ARRAY (PHYSICAL ADDRESS)
 %
 % RETURN:    ERROR - NO AREA ALLOCATED FOR NORD-500
 %
 % SKIP RETURN:  MEMORY ALLOCATED FOR NORD-500 SEGMENT
 %               A=FIRST PHYSICAL PAGE IN NORD-500 SEGMENT
 %               NUMBER OF FIXED SINTRAN III SEGMENTS  IS RETUNED
 %               IN THE "SHARED INFORMATION ARRAY"
 %
 %
 % FUNCTION=2:    GIVE N500 SWAPPING PAGES
 %
 % PAR1:      NO. OF PAGES
 % PAR2:      NO. OF N500 HARDWARE CONFIGURATION MEMORY PARTS
 % PAR3:      ADDRESS OF N500 HARDWARE CONFIGURATION MEMORY PARTS TABLE
 %            (PHYSICAL ADDRESS)
 % PAR4:      MAX NO. OF MEMORY INTERVALS TO RETURN
 % PAR5:      ADDRESS OF TABLE TO RETURN THE AVAILABLE MEMORY PARTS INTO
 %            (PHYSICAL ADDRESS)
 %
 % RETURN:    ERROR
 % SKIP RETURN: A = NO. OF MEMORY INTERVALS
 %
 %
 % FUNCTION=3:   TAKE PAGES FROM N500
 %
 % PAR1:      NO. OF PAGES
 % PAR2:      NO. OF MEMORY PARTS
 % PAR3:      ADDRESS OF MEMORY PARTS TABLE (PHYSICAL ADDRESS)
 % PAR4:      DUMMY
 % PAR5:      DUMMY
 %
 % RETURN:    ERROR
 % SKIP RETURN: OK
 %
 %
 % FUNCTION=4:   FIX A SEGMENT CONTIGOUSLY AT ANY ADDRESS WITHIN A
 %               SPECIFIED AREA
 %
 % PAR1:      SEGMENT NUMBER
 % PAR2:      FIRST (LOWER) LEGAL PHYSICAL PAGE NUMBER
 % PAR3:      LAST (UPPER) LEGAL PHYSICAL PAGE NUMBER
 % PAR4:      DUMMY
 % PAR5:      DUMMY
 %
 % RETURN:    A=0: AREA OCCUPIED
 %            A=1: "PAR2">>LAST PAGE IN MEMORY MAP
 %            A=2: SOMETHING WRONG WITH THE SEGMENT (DEMAND, ALREADY FIXED...)
 %
 % SKIP RETURN:  SEGMENT IS FIXED CONTIGOUSLY, A=FIRST PHYSICAL PAGE IN SEGMENT
 %
 %
 % FUNCTION=5:   RESERVE A CONTIGOUS MEMORY AREA
 %
 % PAR1:      NUMBER OF PAGES TO RESERVE
 % PAR2:      FIRST (LOWER) LEGAL PHYSICAL PAGE
 % PAR3:      LAST (UPPER) LEGAL PHYSICAL PAGE
 % PAR4:      DUMMY
 % PAR5:      DUMMY
 %
 % RETURN:    ERROR:
 %            A=0: AREA OCCUPIED
 %            A=1: "PAR2" >> LAST PAGE IN MEMORY MAP
 %            A=2: NO FREE TABLE ELEMENT (TRYING TO RESERVE TO MANY AREAS)
 %
 % SKIP RETURN:  OK, A=FIRST PHYSICAL PAGE IN AREA, T=TABLE INDEX
 %
 %
 % FUNCTION=6:   RELEASE MEMORY AREA RESERVED BY FUNCTION=5
 %
 % PAR1:      TABLE INDEX (RETURN PARAMETER FROM FUNCTION=5)
 % PAR2:      FIRST PHYSICAL PAGE IN AREA (FROM FUNCTION=5)
 % PAR3:      DUMMY
 % PAR4:      DUMMY
 % PAR5:      DUMMY
 %
 % RETURN:    ERROR
 %
 % SKIP RETURN:  OK
 %
 %
 % FUNCTION=7:   RELEASE ALL MEMORY AREAS RESERVED BY A SPECIFIC PROGRAM.
 %               THE MEMORY AREAS MUST BE RESERVED BY FUNCTION=5 IN MON 61.
 %
 % PAR1:      RT-PROGRAM WHICH HAS RESERVED THE MEMORY AREAS
 %            PAR1=0 MEANS CALLING PROGRAM.
 % PAR2:      DUMMY
 % PAR3:      DUMMY
 % PAR4:      DUMMY
 % PAR5:      DUMMY
 %
 % RETURN:    ERROR
 %
 % SKIP RETURN: OK
 %
 %
 %
 % FUNCTION=10:  GET SEGMENT'S FIXED-STATUS
 %
 % PAR1:      SEGMENT NUMBER
 % PAR2:      PAGE NUMBER WITHIN SEGMENT TO FIND THE PHYSICAL MEMORY PAGE OF,
 %            IF THE SEGMENT IS FIXED.
 %            <PAR2>=0 IS ALLWAYS FIRST PAGE IN SEGMENT.
 % PAR3:      DUMMY
 % PAR4:      DUMMY
 % PAR5:      DUMMY
 %
 % RETURN:    ERROR; A=174 : ILLEGAL SEGMENT NUMBER <PAR1> OR ILLEGAL PAGE
 %                           NUMBER WITHIN SEGMENT <PAR2>
 %                   A=2   : SEGMENT NOT LOADED
 %
 % SKIP RETURN: OK, T=FIXED STATUS
 %                  T=0 : SEGMENT NOT FIXED
 %                  T=1 : SEGMENT FIXED SCATTERED
 %                  T=2 : SEGMENT FIXED CONTIGUOUSLY
 %                  A=PHYSICAL PAGE NUMBER WHER <PAR2> PAGE RESIDE IN MEMORY
 %                  D=SEGMENT-TABLE-ELEMENT.FLAG
 %

 FIXC500:
        CALL GET6
        IF D0>>10 GO ERET; A=:"BFIXC".FIXFLAG
        IF A<4 AND PN500=0 GO ERET
        TAD:=TD1=:X.T5D1; AD:=DD4=:X.D5DD4
        X:=:B=:BREG; GO L1
 ERET:  174=:ZAREG; GO RET
 RBUS

 %============================================================================
 % 36.15      S T M L E V   Y T R N S E G   X T R N S E G
 %
 SUBR STMLEV,YTRNSEG,XTRNSEG
 STMLEV: *PON; JMP *+1; ION; JMP *+1; POF; EXIT
 YTRNSEG: *POF
        GO XTRNSEG
 RBUS


 %=============================================================================
 %            T O P O F F
 %
 % SUBROUTINE TO CALL A ROUTINE IN PAGING-OFF AREA FROM THE PIT3 SEGMENT
 %
 % THIS ROUTINE MUST BE CALLED IN IOF OR WITH MONITOR LEVEL DISABLED
 % WHEN CALLED ON LEVEL 1.
 %
 SUBR TOPOFF
 INTEGER POINTER LREG,CROUTINE
 TOPOFF: X:=:L+1=:"LREG"-1; X:=X.S0=:"CROUTINE":=L; *POF
         CALL CROUTINE; GO NSKIP; MIN "LREG"
 NSKIP:  *PON
         GO LREG
 RBUS

 %==============================================================================
 %            X T O P O F F
 %
 % PRIVATE SUBROUTINE FOR THE PFIXC ROUTINE ON PIT3 SEGMENT TO CALL
 % ROUTINES IN POF.
 %
 SUBR XTOPOFF
 INTEGER POINTER LREG,CROUTINE
 XTOPOFF: X:=:L+1=:"LREG"-1; X:=X.S0=:"CROUTINE":=L; *POF
          CALL CROUTINE; GO NSKIP; MIN "LREG"
 NSKIP:   *PON
          GO LREG
 RBUS

 %==============================================================================
 %            S S 4 1 I P I T
 %
 % SUBROUTINE TO SET PIT3 SEGMENT INTO PIT3
 %
 % ENTRY: X=START OF PAGELINK
 %        T=CORMBANK
 %        B=ADDR OF FIRST PAGE TABLE ENTRY FOR PIT3 SEGMENT
 %
 SUBR SS41IPIT
 SS41IPIT: *PIOF
        DO
           *LDDTX DPGPR
           AD=:DS0; *LDXTX DPAGL
        WHILE X><0
           B+2
        OD; *PION
        EXIT
 RBUS

 *"8SREE
" INTEGER FIXCRT=?
 %==============================================================================
 % 36.15      S R E E N T
 %
 % MONITOR CALL SREENT(SEGNO) - ATTACH REENTRANT SEGMENT AND WRITE SHADDOW
 %                              PAGES WITH 5WIP TO MASSTORAGE

 SUBR SREENT

 INTEGER SAVB,SGA,SGB,RSGA=?,RSTA=?,REND=?
 SREENT: CALL GET1; A:=B=:SAVB; *POF
        CALL XCSEGS           % CLEAR PAGE TABLES
        IF D0><0 THEN
           CALL LEGSEG; X=:RSGA; IF X=NSEGA OR X=NSEGB GO RETSTUPR
           IF A NBIT 5DEMAND GO ERRD
           CALL RLEGSEG
           T:=D0; NSEGA.FLAG; X=:SGA; CALL SHRSOVERLAP
           T:=D0; NSEGB.FLAG; X=:SGB; CALL SHRSOVERLAP
           CALL SRESER         % RESERVE SWAPPING AND DISC SYSTEM
           IF BACKGROUND><0 THEN CALL ESCOF FI    % DISABLE ESCAPE
           X:=RTREF=:FIXCRT
           CALL CLRBMAP; 0=:RTREF.RSEGM; *POF
           RSGA.LOGADR/\377=:RSTA; X.LOGADR SHZ -10+RSTA=:REND
           IF X:=SGA><0 THEN CALL TFWBACK FI
           IF X:=SGB><0 THEN CALL TFWBACK FI
           SGA; T:=RSGA; CALL OVERLAP; SGB; T:=RSGA; CALL OVERLAP
           CALL SRELES; 0=:FIXCRT; *PION          % RELEASE SWAPPING AND DISC SYSTEM
           IF BACKGROUND><0 THEN CALL ESCON FI
           SAVB=:B
        FI;
        X:=RTREF; CALL CLRBMAP; X:=RTREF
        X.RSEGM/\177400+D0=:X.RSEGM; GO RETSTUPR

 % ERROR EXITS:
 ERRD:  CALL 9ERRA(#45); GO RETXIT  % NOT DEMAND SEGMENTS

 *)FILL

 %  LOCAL SUBROUTINE TO FIND SHADDOW PAGES WITH 5WIP AND WRITE THESE
 %  PAGES TO DISC.
 %  ENTRY:    X = SEGMENT TABLE ENTRY
 %            RSTA = FIRST LOGICAL PAGE FOR REENTRANT SEGMENT
 %            REND = LAST LOGICAL PAGE FOR REENTRANT SEGMENT
 %            SWAPPING AND DISCS MUST BE RESERVED!!
 %
 %  EXIT:     B IS DESTROID

 INTEGER RSGA,RSTA,REND
 INTEGER POINTER LREG
 TFWBACK: A:=L=:"LREG"; X=:B; T:=0; X+1
        FLAG BZERO 5OK=:FLAG
        DO; *LDXTX DPAGL
        WHILE X><0                      % FIND OVERLAPING PAGES
              T:=CORMBANK; *LDATX DALOG
              IF A>=RSTA AND A<REND THEN % SHADDOW PAGE
                 T:=CORMBANK; *LDATX DPGPR
                 IF A BIT 5WIP THEN A:=1=:D; B=:T; CALL ATRNSEG FI
              FI; T:=CORMBANK
        OD; GO LREG; *)FILL

 RBUS
 *"
"

 %==============================================================================
 %            S G A N D   S G O R
 %
 % SUBROUTINES TO THE SEGMENT-WRITE-PERMIT AND SEGMENT-WRITE-PROTECT COMMANDS
 % ENTRY: X=SEGMENT TABLE ENTRY; D=SEGMENT NUMBER
 % EXIT: ERROR
 % EXIT+1: OK

 SUBR SGAND,SGOR
 INTEGER CSEG
 SGAND: K:="0"; GO FELLS
 SGOR:  K:=1
 FELLS: MLEV; *MCL PIE
        X=:CSEG
        IF X=SEGMA OR X=SEGMB OR X=SEGMC THEN
           D=:T; X.LOGADR/\377 SH 1+177000=:T
           X.LOGADR SHZ -10 SH 1; T=:X; T+A
           DO WHILE X><T
              *PIOF
              IF X.S0/\377=D THEN
                 X.S0; IF K THEN A BONE 5WPM ELSE A BZERO 5WPM FI; A=:X.S0
              FI; X+2; *PION
           OD
        FI; T:=0; X:=CSEG+1
        DO
           *LDXTX DPAGL
        WHILE X><0
           T:=CORMBANK
           *LDATX DPGPR
           IF K THEN A BONE 5WPM ELSE A BZERO 5WPM FI; *STATX DPGPR
        OD; CSEG.FLAG; IF K THEN A BONE 5WPM ELSE A BZERO 5WPM FI; A=:X.FLAG
        MLEV; *MST PIE
        EXITA
 RBUS


 %==============================================================================
 %            M X R E T
 %
 % ROUTINE TO RELEASE MONITOR CALL WORKING FIELD AND GO TO MRET
 %
 SUBR MXRET
 MXRET: MLEV; *MCL PIE
        X:=RTREF; CALL BRELEASE
        A:=B; *IRW MLEVB DX
        "MRET"; *IRW MLEVB DP
        "MONEN"; *IRW MLEVB DL
        MLEV; *MST PID; MST PIE; PION
        CALL ERRFATAL
 RBUS

 *"8SIBA+8SIBX+8SIBM
" %==============================================================================
 % SPECIAL SIBAS MONITOR CALLS
 %
 *"8SIBA
" *)KILL XSIB; XSIB=2
 *"8SIBX
" INTEGER MXSIBAS(0); *XSIB
 *)KILL XSIB;
 *"8SIBA+8SIBX+8SIBM
" INTEGER ARRAY  SIBBDEVS(0)
        *DSI0;DSI1;DSI2
 *"8SIBX+8SIBM
" INTEGER ARRAY SIBAPDEVS(0)
        *DIA0;DIA1;DIA2
 *"8SIBX+8SIBM
" *DIA0, 0;0;*-2;2;0;0;APLRS;*20/
 *DIA1, 0;0;*-2;2;0;0;APLRS;*20/
 *DIA2, 0;0;*-2;2;0;0;APLRS;*20/
 *DSI0, 0;0;*-2;2;*15/
 *DSI1, 0;0;*-2;2;*15/
 *DSI2, 0;0;*-2;2;*15/

 *"8SIBX+8SIBM
" *EDSIB=*

 SUBR MAPSIB,MSIBB,3MAPSIB,3MSIBB
 MAPSIB: CALL GET0; CALL S3NOALPIT; GO 3MAPSIB
 MSIBB:  CALL GET0; CALL S3NOALPIT; GO 3MSIBB
 RBUS

 *"
"
 * 7ENDC=*

 %

 *"-CXCPU
" %%*5BFPA@12/
 * 172400/
 * 999EN=*
 *"
" @LIB CXCPU

 SUBR SETPTABL,INTDFIELDS
 RBUS

 INTEGER TADFPHPAGE           % FIRST PHYSICAL PAGE IN TAD-STACK
 INTEGER TADLPHPAGE           % LAST PHYSICAL PAGE IN TAD-STACK
 INTEGER TDLPHPAGE            % LAST PHYSICAL PAGE IN TERMINAL-DATAFIELDS

 %===============================================================================
 % 36.16      S I N T R
 %

 INTEGER CCSTART=?,PIEREG=?,PIDREG=?,TMRTE=?,CCNOX=?
 INTEGER XCHREENTPAGES=?
 DOUBLE XCLEP=?,XSETP=?
 INTEGER XCLNREENT=?
 DOUBLE ARRAY NSWPAGE=?,NINIPAGE=?
 INTEGER IRTCPIT=?,77CBU=?
 DOUBLE ARRAY XCCTAB=?
 INTEGER FPS41=?

 INTEGER FMEMCHECK:=0         % NO MEMORY TEST IN START-UP

 SUBR SINTR

 BASE SBFIELD
 INTEGER 9HDEV                % SPECIAL IOX-NUMBER FOR MAIN SWAP-DEVICE
 INTEGER XIOBUTAB:=IOBUTAB    % ADDRESS OF I/O-DEVICES BUFFER TABLE
 INTEGER ARRAY LSWPDEV:=(502,1104,1100,1224,1231,1207)  % LOG.DEV. NO FOR SWAP-DEVICES
 INTEGER ARRAY HSWPDEV:=(500, 510,1540, 500, 510,1550)   % IOX-DEV. NO FOR SWAP-DEVICES
 INTEGER XSMRES:=9SMRE        % START OF PAGING-OFF CODE AREA
 INTEGER XEMRES:=9EMRE        % END OF PAGING-OFF AREA
 INTEGER CBUF:=9EMRE          % ADDRESS OF CURRENT I/O BUFFER
 INTEGER LPHYSPAGE            % LAST PAGE IN MEMORY
 INTEGER DBFNO:=5BUFA         % NUMBER OF DEVICE-BUFFER-HEADERS.
 INTEGER MMSIZE               % SIZE OF MEMORY MAP
 INTEGER MMFPAGE:=-1          % FIRST PAGE OF MEMORY MAP
 INTEGER MMLPAGE:=-1
 INTEGER DBFPAGE:=-1          % FIRST PAGE USED AS DEVICE BUFFER
 INTEGER DBLPAGE:=-1          % LAST PAGE USED AS DEVICE BUFFER
 INTEGER FLAMPAGE:=0          % FIRST PHYSICAL PAGE FOR LAMU TABLES
 INTEGER LLAMPAGE:=0          % LAST PHYSICAL PAGE FOR LAMU TABLES
 INTEGER CLAMSIZE             % SIZE OF LAMU DESCRIPTION TABLE
 INTEGER NPLAMU:=1            % NUMBER OF PAGES USED BY LAMU TABLES
 INTEGER CURRPAGE             % CURRENT PAGE NUMBER TO CHECK
 INTEGER CHDLCF=CURRPAGE      % HDLC FLAG
 INTEGER CCOUNT
 DOUBLE ARRAY POINTER DCCTAB:=CCTAB
 INTEGER ARRAY POINTER ACCTAB=DCCTAB
 INTEGER ARRAY POINTER PNSWPAGE:=NSWPAGE
 INTEGER POINTER ICINDADDR(2)
 DOUBLE POINTER CINDADDR=ICINDADDR
 INTEGER POINTER FPGNO:=XFPGNO,PHYSPTEST:=XPHYSPTEST,GETAREA:=XGETAREA
 INTEGER POINTER INITPAGE:=XINIPAGE,MEMCHECK:=XMEMCHECK,OUTLINK:=XOUTLINK
 INTEGER XT,XA,XD,XXX; TRIPLE XTAD=XT
 INTEGER POINTER CLINK
 INTEGER PREVX,PREVT
 DOUBLE ARRAY POINTER PNINITPAGE:=NINITPAGE
 DOUBLE ARRAY POINTER PLAMARR:=LAMARR
 INTEGER 1CCTAB,2CCTAB
 INTEGER CINDX
 INTEGER NNRTP,POWFPAG,POWLPAG,POWSIZE
 DOUBLE DPOWADDR=POWFPAG
 INTEGER LPS41
 INTEGER BUSYMOD
 INTEGER SYMFPHPAGE,SYMLPHPAGE

 @ICR
 INTEGER ARRAY ENTAB:=(EN000,0,EN200,EN300,EN400,EN500,EN600,EN700,
                       E1000,E1100,E1200,E1300,E1400,E1500,E1600,E1700,
                       E2000,E2100,E2200,E2300,E2400);
 @CR;

 ESAB

 DISP 0; INTEGER 5NBLCK,5RETRY; INTEGER POINTER 5TRNSF; PSID
 DISP -4; INTEGER M4; PSID


 % LOCAL SUBROUTINE TO FIND SPACE FOR THE I/O BUFFERS
 %
 % ENTRY:     A=0 : TRY TO PLACE ALL I/O BUFFERS (EXCEPT LARGE HDLC BUFFERS),
 %                : IN POF.
 % EXIT:      I/O BUFFERS FOUND
 % EXIT+1:    NOT ENOUGH SPACE IN POF
 %
 % ENTRY:     A><0: SAME AS FOR A=0 EXCEPT THAT BUFFERS FOR SYNC.MODEM WILL
 %                  BE PLACED OUTSIDE POF
 % EXIT:      I/O BUFFERS OK
 %
 % EXIT+1:    FATAL ERROR
 %
 INTEGER CFIOFLG
 CFIOBUF: A=:CFIOFLG; 0=:BUSYMOD
        X:=XIOBUTAB; A:=CBUF=:D
        DO WHILE X.S0><-1
           IF A BIT BIHDLC AND X.S1/\77777>>=2000 THEN
              A:=0
           ELSE
              IF A BIT BISYMOD AND T:=CFIOFLG><0 THEN
                 X.S1/\77777+BUSYMOD=:BUSYMOD; GO NXT
              ELSE
                 X.S1/\77777
              FI
           FI; D+A; IF C THEN EXITA FI              % CROSS 64KW MEMORY BANK
 NXT:      X+2
        OD; IF D>>177000 THEN EXITA FI              % OVERLAP PAGE INDEX TABELS
        EXIT                                        % BUFFER IS FOUND

 % LOCAL SUBROUTINE TO SIMULATE LOGPH FOR ELEMENTS IN IOBUTAB
 %
 % ENTRY:     A=LOGICAL DEVICE NUMBER
 %            CINDADDR MUST POINT TO ELEMENT IN IOBUTAB
 %
 % EXIT:      X=ADDRESS OF DATAFIELD
 %
 % CALL TO ERRFATAL WHEN ERROR

 XLOGPH: AD SHZ -6; IF A=1 OR A>24 THEN CALL ERRFATAL FI
        A=:X:=D SHZ -12
        IF A+A+CNVRT(X)+1=:D-ENTAB(X)>=0 THEN CALL ERRFATAL FI
        AD:=D.DOU0; IF T:=ICINDADDR BIT 17 THEN D=:X ELSE A=:X FI
        IF X=0 THEN CALL ERRFATAL FI
        EXIT
 *)FILL

 % INITIALIZE PAGING SYSTEM AND INTERRUPT SYSTEM

 SINTR: A:=0; *PIOF; TRR IIE; TRA IIC
        A:=0; *TRR PID; TRR PIE
        A:=2; *TRR PCR; SEX; TRA STS
        IF A NBIT 5N100 THEN CALL ERRFATAL FI % THIS SYSTEM IS ONLY FOR NORD 100!!!!
        A=:CPSTA
        A:="LV0"; *IRW 0 DP; ION
 LV0:   *IOF
        "SBFIELD"=:B
 % INITIALIZE THE PAGE TABLES
        A:=162000; D:=0; X:=177000
        DO AD=:X.DOU0; D+1; X+2 WHILE X><0 OD
 % INITIALIZE THE MEMORY AREA FROM END OF RESIDENT UP TO 128 KBYTE
        X:=ENDCOR; DO X.S0=:X.S0 WHILE X><177777; X+1; OD
        A:=ENDCORE-1; CALL FPGNO
        IF A>"9POFS" SHZ -12 -1 THEN CALL ERRFATAL FI  % RESIDENT AND POF OVERLAPS
        A=:LRESP                                     % LAST PAGE IN RESIDENT

 % TEST MEMORY ADDRESS BITS 19-23 (1-32MB)
 ISINTR: 1000=:CURRPAGE
 % IF MULTIPORT 3 THEN 3777=:ENDPAGE ELSE 37777=:ENDPAGE FI
        A:=200; *TRR IIE; TRA IIC; IOX 750; TRA IIC
        IF A=0 THEN A:=3777 ELSE A:=37777 FI; A=:ENDPAGE; A:=0; *TRR IIC
        DO WHILE CURRPAGE><ENDPAGE+1
           X:=0
           DO WHILE X<<"NINSZ*2"
              AD:=PNINITPAGE(X)
              IF A><0 AND A<<=CURRPAGE AND D>>=T GO NEXT
              X+2
           OD; X:=0; 124000=:X.S0
           A:=CURRPAGE=:D:=162000; X:=177176; AD=:X.DOU0
           A:=1000; *TRR IIE; TRA IIC; PON
           X:=176000; X.S0; *POF; TRA IIC
           IF A=0 THEN
              *PON
              A:=X.S0=:D:=-1=:X.S0; *POF
              X:=0
              IF X.S0=124000 THEN
                 A:=D; X:=176000; *PON
                 A=:X.S0; *POF; TRA IIC
              ELSE
                 124000=:X.S0; CURRPAGE-1=:ENDPAGE
                 GO LABL1
              FI
           FI
 NEXT:     CURRPAGE SH 1=:CURRPAGE
        OD

 % FIND LAST 32K MEMORY MODULE
 LABL1: A:=77=:LPHYSPAGE+1
 DO1:   DO WHILE A<<=ENDPAGE
           CALL PHYSPTEST; GO NOTEXIST; A+37=:LPHYSPAGE; A+1
        OD; GO L1
 NOTEXIST: A+40; GO DO1
 *)FILL

 L1:    7EPOF=:CBUF
        A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
        A=:NNRTP
 *"8XMSG
"        -1=:CBUF.S0; CBUF=:XZRTT+NNRTP=:CBUF
 *"
"        CBUF=:7RTDLGADDR
        A:=NNRTP*5XRTDSIZE+CBUF=:CBUF=:77CBU; IF C THEN CALL ERRFATAL FI
        GO LABL2; *)FILL
 % FIND THE I/O BUFFER AREA
 LABL2: A:=0; CALL FAR CFIOBUF; GO IOBOK
        A:=1; CALL FAR CFIOBUF; GO IOBOK; CALL ERRFATAL
 IOBOK:
 % CHECK IF "PAGING OFF" AREA AND I/O BUFFER AREA EXISTS IN MEMORY
        A:=D; CALL FPGNO; A=:LPOFP            % LAST PAGE IN "PAGING-OFF" AREA
        "9POFS"; CALL FPGNO; A=:FPOFP         % FIRST PAGE IN "PAGING-OFF" AREA
        DO
           CALL PHYSPTEST; CALL ERRFATAL; A+1
        WHILE A><LPOFP
        OD; GO LABL3; *)FILL

 % SET UP THE I/O BUFFERS

 LABL3: XIOBUTAB=:"CINDADDR"
        DO AD:=CINDADDR WHILE A><-1
           0=:CHDLCF
           IF A BIT BIHDLC THEN
              A=:CHDLCF; IF D>>1777 GO NXIOD
           FI; A/\7777; CALL FAR XLOGPH
           CBUF=:X.BUFST; AD:=CINDADDR
           IF A:=D NBIT 17 THEN A SH 1 ELSE A BZERO 17 FI; A=:X.MAX=:X.CFREE
           IF CHDLCF><0 THEN 0=:MASTB FI
           A:=D BZERO 17+CBUF=:CBUF
 NXIOD:    "CINDADDR"+2=:"CINDADDR"
        OD
 % SET UP RT-COMMON TABLE
        IF CCNOX><0 THEN
           IF ACCTAB(0)=0 THEN
              IF CCSTART=0 THEN
                 LPHYSPAGE; X:=CCNOX; T:=LRESP+1
                 CALL YGETAREA; CALL ERRFATAL; A-CCNOX+1=:CCSTART
              FI; A=:D
              200-CCNOX+161000; T:=CCNOX; X:=0
              DO WHILE T><0
                 AD=:DCCTAB(X); A+1; D+1; X+2; T-1
              OD; -1=:ACCTAB(X)
           FI
        ELSE
           IF ACCTAB(0)=0 THEN -1=:ACCTAB(X) FI
        FI; GO L2; *)FILL
 % TEST IF RT-COMMON PAGES EXIST AND INITIALIZE THE RT-COMMON PAGES
 L2:    X:=0
        DO WHILE ACCTAB(X)><-1
           X+1; ACCTAB(X); CALL PHYSPTEST; CALL ERRFATAL
           CALL INITPAGE; X+1
        OD
        GO FILL1; *)FILL
 FILL1:

 % FIND CONTINUOUS AREA FOR THE DEVICE-BUFFERS IN MEMORY BANK 1 TO 3,
 % AND INITIALIZE THE PAGES
 %
        A:=100; X:=DBFNO; T:=377; CALL GETAREA; CALL ERRFATAL     % LAST PAGE = 377
        A=:DBFPAGE/\77 SH 12=:BUFASTART           % START ADDRESS OF BUFFER AREA WITHIN BUFBANK
        A:=DBFPAGE SHZ -6=:BUFBANK                % MEMORY BANK IN WHICH THE BUFFERS LIE
        DBFPAGE+DBFNO-1=:DBLPAGE
        FOR A:=DBFPAGE TO DBLPAGE DO CALL INITPAGE; CALL MEMCHECK; CALL ERRFATAL OD

 % RESERVE MEMORY FOR THE LAMU SYSTEM AND CLEAR THE LAMU TABLES

        IF GNLAMU><0 THEN
           A*LDTSZ=:CLAMSIZE
           A:=SEGSTART-RTSTART=:D:=0; T:=5RTSIZE; *RDIV ST
           A*GNLPRT*ALMSZ+CLAMSIZE; CALL FPGNO; A+D=:NPLAMU
           A:=100; T:=LPHYSPAGE; X:=NPLAMU; CALL GETAREA; CALL ERRFATAL
           A=:D=:FLAMPAGE+NPLAMU-1=:LLAMPAGE:=0; AD SH 12=:DLAMDT
           A:=D+CLAMSIZE=:LAMACT
           A:=FLAMPAGE; T:=NPLAMU+A
           DO WHILE A><T; CALL ZEROPAGE; A+1; OD
           X:=0
           DO WHILE X<<"NINSZ*2"; AD:=PNINITPAGE(X)=:PLAMARR(X); X+2; OD
           GO AFLAM; *)FILL
        FI

 AFLAM:

 % RESERVE MEMORY FOR THE MONITOR-CALL-LOG TABLE
        IF "MCLGPAGE"><0 THEN
           A:=0; T:=LPHYSPAGE; X:=1; CALL GETAREA; CALL ERRFATAL
           A=:MCLGPAGE=:D:=0; AD SHZ 12; A=:MCLGBANK:=D=:TNMCALL
        FI

 % RESERVE MEMORY FOR THE SYNC.MODEM BUFFERS IF THEY ARE PLACED
 % OUTSIDE MEMORY BANK #0

        IF BUSYMOD><0 THEN
           CALL FPGNO; A+D=:X=:SYMLPHPAGE
           A:=0; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
           A=:SYMFPHPAGE-1+SYMLPHPAGE=:SYMLPHPAGE
           A:=SYMFPHPAGE=:D:=0; AD SHZ 12; A=:MBSYMOD:=D=:CBUF
           XIOBUTAB=:"CINDADDR"
 % INITIALIZE THE SYNC.MODEM DATAFIELDS WITH
 % BUFFER START ADDR, MAX AND CFREE
           DO AD:=CINDADDR WHILE A><-1
              IF A BIT BISYMOD THEN
                 A/\7777; CALL FAR XLOGPH
                 CBUF=:X.BUFST
                 AD:=CINDADDR
                 IF A:=D NBIT 17 THEN A SH 1 ELSE A BZERO 17 FI
                 A=:X.MAX=:X.CFREE
                 A:=D BZERO 17+CBUF=:CBUF
              FI; "CINDADDR"+2=:"CINDADDR"
           OD
        ELSE
           0=:MBSYMOD
        FI; GO BYPFILL; *)FILL
 BYPFILL:
 @LIB CXCPU

 % RESERVE MEMORY FOR THE TAD-STACK
        T:=0; X:="D1400"+1
        DO                                        % SEARCH IN LOG.DEV TABLES
           IF "D1500"=X THEN X+1 FI
        WHILE "9EBAD">>X
           AD:=X.DS0
           IF A><0 OR D><0 THEN T+1 FI
           X+2
        OD
        IF T><0 THEN                              % RESERVE PAGES
           A:=T*TSSIZE; CALL FPGNO; A+D=:MMSIZE   % MMSIZE=NO.OF PAGES IN TAD-STACK
           X:=A; A:=0; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
           A=:TADFPHPAGE-1+MMSIZE=:TADLPHPHAGE    % FIRST AND LAST PHYSICAL PAGE FOR TAD-STACK
           A:=TADFPHPAGE SHZ -6=:TSBANK           % MEMORY BANK FOR TAD-STACK
           A:=TADFPHPAGE SH 12=:CCOUNT            % CCOUNT=ADDR OF STACK WITHIN A 64KW MEMORY BANK
           X:="D1400"+1=:L
           DO                                     % INITIALIZE THE TAD DATAFIELDS
              IF L="D1500" THEN L+1 FI            % WITH THE ADDR OF THE TAD-STACK AREA
           WHILE L<<"9EBAD"
              AD:=L.DS0
              IF A><0 OR D><0 THEN
                 T:=CCOUNT
                 IF A><0 THEN T=:A.TSTADD FI
                 IF D><0 THEN T=:D.TSTADD FI
                 CCOUNT+TSSIZE=:CCOUNT
              FI; L+1; L+1
           OD;
        FI; GO OVFILL; *)FILL

 OVFILL:
 % COMPUTE SIZE OF THE PAGE-OWNER TABLE FOR MON SPLREE
        "NNBRT"*POTESIZE+1777 SHZ -12=:X=:POWSIZE; A:=0; T:=LPHYSPAGE
        CALL GETAREA; CALL ERRFATAL
        A=:D=:POWFPAGE+POWSIZE-1=:POWLPAGE:=0; AD SH 12=:DSREBADDR

 % COMPUTE SIZE OF MEMORY MAP, FIND CONTINUOUS MEMORY FOR THE MEMORY MAP
 % AND SET UP MEMORY MAP FOR ALL PAGES (0 - LPHYSPAGE)
 % THE PHYSICAL PAGE NUMBER IS INDEX IN THE MEMORY MAP
        IF LPHYSPAGE=37777 THEN A-1=:LPHYSPAGE FI
        A+2 SH 2; CALL FPGNO; A+D=:MMSIZE
        100; X:=MMSIZE; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
        A=:D=:MMFPAGE SHZ -6=:CORMBANK:=D+MMSIZE-1=:MMLPAGE
        IF A:=D/\77=0 THEN A SH 12+4 ELSE A SH 12 FI
        A=:CORMSTART=:"XSGRT".BPAGLINK=:D:=CORMBANK; AD=:DCORMSTART
        LPHYSPAGE=:ENDPAGE
        GO L3; *)FILL
 L3:    0=:CURRPAGE; X:=CORMSTART
        FOR CURRPAGE DO WHILE CURRPAGE<<=LPHYSPAGE
           T:=CORMBANK; A:=X+4; D:=0; *STDTX DPAGL
           CURRPAGE=:D; A:=1; *STDTX DPGPR
           X+4
        OD; X-4=:ECORMAP; T:=CORMBANK; *STZTX

 % RESERVE MEORY FOR PIT3 SEGMENT
        "XLPT3"+1-"XSPT3" SHZ -12=:MMSIZE
        "SG41".LOGADR/\377; T:=MMSIZE SH 10; A\/T=:X.LOGADR
        X:=MMSIZE; A:=100; T:=LPHYSPAGE; CALL GETAREA; CALL ERRFATAL
        A=:D=:FPS41+MMSIZE-1=:LPS41
        IF "SG33".LOGADR/\77 SH 12><0 AND A<<="XLPT3" THEN
           CALL ERRFATAL                          % PIT3 SEG AND X-MESSAGE OVERLAPS
        FI
 @LIB CXCPU-,
        A:="5BFPAGE-1"=:D:=0; CALL OUTLINK
        A:=LRESP=:D:="5BFPAGE+1"; CALL OUTLINK    % LINK OUT RESIDENT
 @ELIB
 @LIB CXCPU
        A:=LPOFP=:D:=FPOFP; CALL IOUTLINK         % LINK OUT POF AREA
        A:=MMLPAGE=:D:=MMFPAGE; CALL IOUTLINK     % LINK OUT MEMORY MAP AREA
        A:=DBLPAGE=:D:=DBFPAGE; CALL IOUTLINK     % LINK OUT DEVICE BUFFER AREA
        A:=POWLPAGE=:D:=POWFPAGE; CALL IOUTLINK   % LINK OUT PAGE-OWNER TABLE
        IF "MCLGBANK"><0 THEN
           A:=MCLGPAGE=:D; CALL IOUTLINK          % LINK OUT MONITOR-CALL-LOG-TABLE PAGE
        FI
        IF TADLPHPAGE><0 THEN
           A=:D:=TADFPHPAGE; CALL IOUTLINK        % LINK OUT TAD-STACK PAGES
        FI
        IF SYMLPHPAGE><0 THEN
           A=:D:=SYMFPHPAGE; CALL IOUTLINK        % LINK OUT SYNC.MODEM I/O BUFFERS
        FI
 @LIB CXCPU
        A:=LPS41=:D:=FPS41; CALL OUTLINK          % LINK OUT PAGES RESERVED FOR PIT3 SEGMENT
        IF GNLAMU><0 THEN
           A:=FLAMPAGE+NPLAMU-1=:D:=FLAMPAGE
           CALL OUTLINK                           % LINK OUT LAMU TABLE PAGES
        FI; A:=DBFPAGE SH 2+CORMSTART=:BUFMAPSTA
        GO L31; *)FILL

 % LINK OUT RT-COMMON
 L31:   IF ACCTAB(0)><-1 THEN
           A/\377=:ARTFPAGE SH 1; T:="XCCTAB"-A=:IRTCPIT
           177=:ARTLPAGE
           DO WHILE ACCTAB(X)><-1
              X=:CINDX; A=:1CCTAB
              X+1; ACCTAB(X)=:D=:2CCTAB; CALL IOUTLINK
              A:=2CCTAB=:D:=161000; AD=:XCCTAB(CINDX); X+2
           OD
        ELSE
           -1=:ARTFPAGE=:ARTLPAGE
        FI; IF LPOFP><77 THEN A:=77=:D; CALL OUTLINK FI     % LINK OUT PAGE #77
 % LINK OUT NOT-SWAP PAGES AND INITIALIZE THE PAGES
        X:=0
        DO WHILE X<<"NNSWSZ*2"
           AD:=NSWPAGE(X)
           IF A><0 AND A<<=D THEN
              CALL OUTLINK
              DO WHILE A<<=D; CALL INITPAGE; A+1; OD
           FI; X+2
        OD
 % FIND NUMBER OF SWAPPING PAGES AND INITIALIZE THE SWAPPING PAGES
        0=:CURRPAGES; X:="XSGRT"+1=:PREVX; T:=0=:PREVT
 INDO2: DO
           *LDXTX DPAGL
        WHILE X><0
           T:=CORMBANK; *LDATX DPAGP
           CALL PHYSPTEST; GO COUTLINK; CALL INITPAGE
           CALL MEMCHECK; GO ERRPAGE; MIN CURRPAGE
           T=:PREVT; X=:PREVX
        OD; CURRPAGE=:NOPGS; GO L4
 ERRPAGE: CALL 9ERR(#03)
 COUTLINK: T:=CORMBANK; *LDATX DPAGL
        T:=PREVT; X=:D:=PREVX; *STATX DPAGL
        X:=D; T:=CORMBANK; A:=0=:D; *STDTX DPAGL; STZTX DPGPR
        X:=PREVX; T:=PREVT; GO INDO2
 *)FILL

 L4:    "MASKE"=:PIEREG; 0=:PIDREG
        CALL XCHIOX; XTMRTERM=:TMRTERM
        CALL SYSEVAL
 @LIB CXCPU-,
 % TEST FOR NEW MICROPROGRAM
        IF HWINFO(0)/\377=2 THEN        % NEW MICROPROGRAM, ND100 CX.
           "SCPOUT"-"XCLEP"-1+124000=:D; A:=ICLEP; AD=:XCLEP
           "SCPOUT"-"XSETP"-1+124000=:D; A:=ISETP; AD=:XSETP
           A:=124001=:XCLNREENT
           A:="NEWLOOP"-"XCHREENTPAGES"/\377+124000=:XCHREENTPAGES
        FI
 @ELIB
 @LIB CXCPU
        ESGTABLE-SEGSTART=:D:=0; T:=5SEGSIZE; *RDIV ST
        A-1=:SGMAX; "SEGTX"-SEGSTART=:D:=0; *RDIV ST
        A=:USEGM
 % SET TIMESLICE CLASS
 % IF SAVED TIMESLICE CLASS (TSLSTATUS BIT 15-17) EQUALS ZERO THEN
 %          TIMESLICE CLASS FOR TERMINALS IS SET TO ZERO AND TIMESLICE
 %          CLASS FOR BATCH IS SET TO ONE
 % ELSE
 %          TIMESLICE CLASS IS SET EQUAL SAVED TIMESLICE CLASS
 % ENDIF
 %
        FPTSLICE=:B; D:=0
        DO WHILE B<<LPTSLICE
           IF TSLSTATUS(D)/\160000=0 THEN
              X:="BCHTA"+1
              DO WHILE X.S0><-1
                 IF X.S1=B THEN T:=22000; GO BBBAT FI       % BATCH
                 X+4
              OD; T:=0
           ELSE
              T:=A SHZ -3\/A
 BBBAT:    FI; A:=TSLSTATUS(D)/\1000\/T=:TSLSTATUS(X)
           A:=5RTSIZE; B+A; D+1
        OD;
 *"8BFD1 8FDI1
" GO INTDFIELDS

 RBUS

 %%@LIB CXCPU
 %========================================================================
 %      X C H I O X
 %
 % CHECK FOR IOX ERRORS ON THE TERMINALS
 %
 SUBR XCHIOX

 INTEGER POINTER LREG,PTMRTE
 INTEGER XREG; TRIPLE TADREG
 INTEGER CCOUNT

 XCHIOX: TAD=:TADREG; X=:XREG; A:=L=:"LREG"
        A:=200; *TRR IIE; TRA IIC
        "TMRTE"+1=:"PTMRTE"
        DO WHILE X:=PTMRTE><-1 AND "PTMRTE"<<"9EXTD"
           *TRA IIC
           IF X><0 AND X.HDEV><0 THEN
              T:=A+2; *IOXT; TRA IIC
              IF A=7 THEN
                 0=:PTMRTE
              ELSE
                 IF X.HDEV NBIT 2 THEN
 % CHECK IDENT CODE IF INPUT DEVICE
                    X=:D; T:=X.HDEV+3; A:=30; *IOXT
                    *IDENT PL10; IDENT PL12; TRA IIC
                    15; *IOXT
                    A:=0; T+"5-3"; *IOXT
                    0=:CCOUNT; FOR CCOUNT DO OD; FOR CCOUNT DO OD
                    5; T+"7-5"; *IOXT
                    A:=0; *IDENT PL12
                    IF A=0 GO ERRID; A-1
                    IF A<<="HIDTERM" AND A>>="LIDTERM" THEN
                       IF A-T>>"MXX12" GO ERRID
                       X:="ID12T"+A; X.S0
                    ELSE
                       ITB12(A)
                    FI; IF A><D GO ERRID; A:=0; *IDENT PL10
                    IF A=0 GO ERRID; A-1
                    IF A<<="HIDTERM" AND A>>="LIDTERM" THEN
                       IF A-T>>"MXX10" GO ERRID
                       X:="ID10T"+A; X.S0
                    ELSE
                       ITB10(A)
                    FI
                    T:="9CXTI"; D+T
                    IF A><D GO ERRID
                    T+"3-7"; A:=30; *IOXT; IDENT PL10; IDENT PL12; TRA IIC
                    GO IDOK
 ERRID:             D.HDEV; T:=0; CALL 9ERR(#23)
 IDOK:           FI
              FI
           FI; MIN "PTMRTE"
        OD; TAD:=TADREG; X:=XREG; GO LREG
 RBUS


 %===============================================================================
 % 36.18      X G E T A R E A     Y G E T A R E A
 %
 % SUBROUTINE TO ALLOCATE CONTINUOUS AREA IN MEMORY
 %
 % ENTRY: A=FIRST PAGE TO TEST
 %        B=SBFIELD IN SINTR
 %        X=NUMBER OF PAGES IN AREA
 %        T=LAST POSSIBLE PAGE IN AREA
 %
 %        XGETAREA: ALLOCATES PAGES FROM A UPP TO T
 %                  AND TEST THAT WHOLE AREA IS IN ONE BANK
 %        YGETAREA: ALLOCATES PAGES FROM A DOWN TO T
 %                  (CALLED WHEN ALLOCATING PAGES TO RT-COMMON)
 % EXIT:  AREA NOT FOUND
 %
 % EXIT+1: AREA FOUND, A=FIRST PAGE IN AREA
 %

 % N O T E: THIS DISP DEFINITION MUST CORRESPOND TO THE BASEFIELD IN SINTR

 SUBR XGETAREA,YGETAREA

 DISP -200
 INTEGER 9HDEV                % SPECIAL IOX-NUMBER FOR MAIN SWAP-DEVICE
 INTEGER XIOBUTAB             % ADDRESS OF I/O-DEVICES BUFFER TABLE
 INTEGER ARRAY LSWPDEV(6)     % LOG.DEV. NO FOR SWAP-DEVICES
 INTEGER ARRAY HSWPDEV(6)     % IOX-DEV. NO FOR SWAP-DEVICES
 INTEGER XSMRES               % START OF PAGING-OFF CODE AREA
 INTEGER XEMRES               % END OF PAGING-OFF AREA
 INTEGER CBUF                 % ADDRESS OF CURRENT I/O BUFFER
 INTEGER LPHYSPAGE            % LAST PAGE IN MEMORY
 INTEGER DBFNO                % NUMBER OF DEVICE-BUFFER-HEADERS.
 INTEGER MMSIZE               % SIZE OF MEMORY MAP
 INTEGER MMFPAGE              % FIRST PAGE OF MEMORY MAP
 INTEGER MMLPAGE
 INTEGER DBFPAGE              % FIRST PAGE USED AS DEVICE BUFFER
 INTEGER DBLPAGE              % LAST PAGE USED AS DEVICE BUFFER
 INTEGER FLAMPAGE             % FIRST PHYSICAL PAGE FOR LAMU TABLES
 INTEGER LLAMPAGE             % LAST PHYSICAL PAGE FOR LAMU TABLES
 INTEGER CLAMSIZE             % SIZE OF LAMU DESCRIPTION TABLE
 INTEGER NPLAMU               % NUMBER OF PAGES USED BY LAMU TABLES
 INTEGER CURRPAGE             % CURRENT PAGE NUMBER TO CHECK
 INTEGER CCOUNT
 DOUBLE ARRAY POINTER DCCTAB
 INTEGER ARRAY POINTER ACCTAB=DCCTAB
 INTEGER ARRAY POINTER PNSWPAGE
 INTEGER POINTER ICINDADDR(2)
 DOUBLE POINTER CINDADDR=ICINDADDR
 INTEGER POINTER FPGNO,PHYSPTEST,GETAREA
 INTEGER POINTER INITPAGE,MEMCHECK,XYOUTLINK
 INTEGER XT,XA,XD,XXX; TRIPLE XTAD=XT
 INTEGER POINTER CLINK
 INTEGER PREVX,PREVT
 DOUBLE ARRAY POINTER PNINITPAGE
 DOUBLE ARRAY POINTER PLAMARR
 INTEGER 1CCTAB,2CCTAB
 INTEGER CINDX
 INTEGER NNRTP,POWFPAG,POWLPAG,POWSIZE
 INTEGER LPS41
 INTEGER BUSYMOD
 INTEGER SYMFPHPAGE,SYMLPHPAGE
 PSID

 DOUBLE ARRAY POINTER PCUMTABLE:=CUMTABLE
 YGETAREA: K:="0"; GO L1
 XGETAREA: K:=1
 L1:    TAD=:XTAD; X-=:XXX; T:=L=:"CLINK"
 AGAIN: XXX=:CCOUNT; XA=:CURRPAGE
        FOR CCOUNT DO
           IF CURRPAGE<<100 THEN
              IF A<<=LRESP GO FAR TRNX
              IF A=77 GO FAR TRNX                     % DO NOT USE PAGE 77
              IF A>>=FPOFP AND A<<=LPOFP GO FAR TRNX  % FOR DEVICE BUFFERS OR CORE MAP
           FI; IF A>>=DBFPAGE AND A<<=DBLPAGE GO FAR TRNX
           IF A>>=TDFPAGE AND A<<=TDLPHPAGE GO FAR TRNX
           IF A>>=POWFPAGE AND A<<=POWLPAGE GO FAR TRNX
           IF A>>=FLAMPAGE AND A<<=LLAMPAGE GO FAR TRNX     % IN LAMU TABLE AREA?
           IF A>>=MMFPAGE AND A<<=MMLPAGE GO FAR TRNX       % MEMORY MAP AREA
           IF T:="MCLGPAGE"><0 AND A=MCLGPAGE GO FAR TRNX   % MONCALL LOG PAGE
           IF A>>=TADFPHPAGE AND A<<=TADLPHPAGE GO FAR TRNX % TAD STACK AREA
           IF A>>=FPS41 AND A<<=LPS41 GO FAR TRNX           % MEMORY RESERVED FOR PIT3 SEGMENT
           IF A>>=SYMFPHPAGE AND A<<=SYMLPHPAGE GO FAR TRNX % SYNC.MODEM I/O BUFFER
           X:=0
           IF K THEN
             DO WHILE ACCTAB(X)><-1                         % RT COMMON
                X+1; IF ACCTAB(X)=CURRPAGE GO TRNX; X+1
             OD; X:=0
           FI
           DO WHILE X<<"NINSZ*2"
              AD:=PNINITPAGE(X)
              IF A><0 AND A<<=CURRPAGE AND D>>=T GO TRNX
              X+2
           OD; X:=0
           DO WHILE X<<"CUMSIZE*2"
              AD:=PCUMTABLE(X)
              IF A><0 AND A<<=CURRPAGE AND D>>=T GO TRNX
              X+2
           OD
           CURRPAGE; CALL PHYSPTEST; GO TRNX
           IF K THEN
              CURRPAGE/\177700=:T; IF XA/\177700><T GO TRNX    % CHECK THAT WHOLE
              MIN CURRPAGE                                     % AREA IS IN ONE BANK
            ELSE
              CURRPAGE-1=:CURRPAGE
           FI
        OD; GO OUT; *)FILL
 OUT:   MIN "CLINK"; A:=XA; GO CLINK          % AREA FOUND
 TRNX:  A:=XXX;
        IF K THEN A-; IF A+CURRPAGE >> XT GO CLINK; CURRPAGE+1=:XA;
        ELSE          IF A+CURRPAGE << XT GO CLINK; CURRPAGE-1=:XA;
        FI;GO FAR AGAIN

 RBUS


 %============================================================================
 %
 % SUBROUTINE TO INITIALIZE A PAGE (READ AND WRITE IN EVERY ADDRESS IN THE PAGE)
 %
 % ENTRY: A=PAGE NUMBER
 %
 % 36.19      X I N P A G E
 %
 SUBR XINIPAGE
 INTEGER XREG,TREG,AREG,DREG
 TRIPLE TADR=TREG
 XINIPAGE: TAD=:TADR; X=:XREG
        X:=0
        DO WHILE X<<"NINSZ*2"
           AD:=NINITPAGE(X)
           IF A><0 AND A<<=AREG AND D>>=T GO OUT
           X+2
        OD
        A:=AREG=:D:=162000; X:=177176; AD=:X.DOU0; *PON
        FOR X:=176000 DO X.S0=:X.S0 OD; *POF
 OUT:   TAD:=TADR; X:=XREG; EXIT
 RBUS

 %============================================================================
 % 36.20      X M E M C H E C K
 %
 %
 % SUBROUTINE TO DO MEMORY CHECK ON A PAGE
 %
 % ENTRY: A=PAGE NUMBER
 %
 % EXIT:  MEMORY ERROR IN PAGE
 % EXIT+1: OK
 %
 SUBR XMEMCHECK
 *"8MEMC
" XMEMCHECK:
 *"-8MEMC
"        EXITA
 *"8MEMC
" RBUS

 %============================================================================
 % 36.21      X F P G N O
 %
 %
 % SUBROUTINE TO CONVERT ADDRESS TO PAGE NUMBER
 %
 % ENTRY: A=ADDRESS
 %
 % EXIT:  A=PAGE NUMBER
 %        D=0 WHEN ADDRESS IS MODULO 2K BYTE ELSE D=1
 %
 SUBR XFPGNO
 INTEGER SAVD
 XFPGNO: D:=0; AD SHZ -12; IF D><0 THEN D:=1 FI; EXIT
 RBUS


 %============================================================================
 % 36.11      X P H Y S P T E S T
 %
 % SUBROUTINE TO TEST IF PAGE EXIST IN MEMORY
 %
 % ENTRY: A=PAGE NUMBER
 %
 % EXIT:  PAGE DOES NOT EXIST
 %
 % EXIT+1: PAGE EXSIST
 %
 SUBR XPHYSPTEST
 INTEGER XREG,TREG,AREG,DREG
 TRIPLE TADR=TREG
 XPHYSPTEST: TAD=:TADR; X=:XREG:=0
        DO WHILE X<<"NINSZ*2"
           AD:=NINITPAGE(X)
           IF A><0 AND A<<=AREG AND D>>=T GO NOTOK
           X+2
        OD; A:=AREG=:D:=162000; X:=177176; AD=:X.DOU0; A:=1000
        *TRR IIE; PON; TRA IIC
        X.S0; *POF; TRA IIC
        IF A=0 THEN L+1 FI; A:=0; *TRR IIE
 NOTOK: TAD:=TADR; X:=XREG; EXIT
 RBUS

 %==============================================================================
 %            X O U T L I N K   -   I O U T L I N K
 %
 % SUBROUTINE TO LINK OUT AN AREA FROM THE MEMORY MAP
 % IOUTLINK WILL ALSO INITIALIZE THE AREA (READ AND WRITE IN ALL LOCATIONS)
 %
 % ENTRY:     A=FIRST PAGE TO LINK OUT
 %            D=LAST PAGE TO LINK OUT
 SUBR XOUTLINK,IOUTLINK
 INTEGER TREG,AREG,DREG,XREG,PREVX,PREVT
 TRIPLE TADR=TREG
 INTEGER POINTER LREG
 IOUTLINK: K:=1; GO FELLS
 XOUTLINK: K:="0"
 FELLS: TAD=:TADR; X=:XREG:=L=:"LREG"
        IF K THEN
           DO CALL XINIPAGE; WHILE A><D; A+1; OD; TAD:=TADR
        FI; X:="XSGRT"+1; T:=0
        DO
           IF X=0 THEN CALL ERRFATAL FI
           X=:PREVX; T=:PREVT
           *LDXTX DPAGL
           T:=CORMBANK; *LDATX DPAGP
           IF A-AREG=0 GO FOUND
        OD
 FOUND: DO
           *LDATX DPAGP
           IF A-DREG=0 THEN
              *LDATX DPAGL
              X=:D:=PREVX; T:=PREVT; *STATX DPAGL
              X:=D; T:=CORMBANK; A:=0=:D; *STDTX DPAGL; STZTX DPGPR
              TAD:=TADR; X:=XREG; GO LREG
           FI; A:=0=:D; *STDTX DPAGL; STZTX DPGPR
           X+4
        OD
 RBUS
 %=============================================================================
 %      Z E R O P A G E
 %
 % SUBROUTINE TO FILL A PAGE WITH ZEROES
 %
 % ENTRY:     A=PHYSICAL PAGE NUMBER
 %
 SUBR ZEROPAGE
 INTEGER XREG; TRIPLE TADR
 ZEROPAGE: TAD=:TADR; X=:XREG
        A=:D:=162000; X:=177176; AD=:X.DOU0; *PON
        FOR X:=176000 DO 0=:X.S0 OD; *POF
        TAD:=TADR; X:=XREG; EXIT
 RBUS

 @LIB CXCPU

 * 99END=*

