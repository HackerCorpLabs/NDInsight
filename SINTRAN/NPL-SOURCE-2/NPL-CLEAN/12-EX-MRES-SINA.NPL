 RBUS
 %============================================================================
 %
 % 35.40  X M S G / H D L C    I N T E R F A C E  : S T A R T    D R I V E R
 %
 %============================================================================
 SUBR ZXS12,ZXS13
 INTEGER POINTER HOME
 ZXS12: A:=L=:"HOME"; *PIOF                       % X->DCB, B->HDLC DATAFIELD
        CALL ICHAIN; CALL ACT12; GO UT            % CHAIN TO HDLC AND KICK HIM

 ZXS13: A:=L=:"HOME"; *PIOF                       % X->DCB, B->HDLC DATAFIELD
        CALL ICHAIN; CALL ACT13;                  % CHAIN TO HDLC AND KICK HIM

 UT:    *PION;
        GO HOME
 RBUS
