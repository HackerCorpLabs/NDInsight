%----PAGE DISPLACEMENT FROM BEGINNING OF SINTRAN:DATA------------

5FYFS=144                    % FILESYSTEM SAVE-AREA
5FYRL=502                    % RT-LOADER
5FYSP=534                    % SPOOLING
5FCRL=32+77                  % ND-NET FILECOPY
5FYER=136                    % ERROR PROGRAM
5FYOP=77                     % COMMAND SEGMENT

%----------------------------------------------------------------

5NASE=517

FLBPA=100                    % FIRST LOGICAL PAGE IN BACKGROUND SEGMENT

"5WDIS+8WD1+8MD1 -55CDK -5GDIS -5BDIS
%  MAIN SWAPPING DEVICE:   WINCHESTER DISC ON CONTROLLER 1
5DSK=1224
5ABLP=2
5BLST=400
5BL01=0
8ZWDI
