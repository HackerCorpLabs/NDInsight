"C14L$LNR ;S16$LNR R
"C15L$LNR ;S17$LNR R
"C16L$LNR ;S20$LNR R
"
MXCC=*-IDA$LNR -2
XXY=AKMCS;)KILL AKMCS;AKMCS=XXY+MXCC+1;)KILL XXY

COTA$LNR =*
"C01L$LNR ;CDVNR;0; "B01L$LNR ;*-2/100000+CDVNR;0
"C01L$LNR ;XDVNR=CDVNR;)KILL CDVNR;CDVNR=XDVNR+1;)KILL XDVNR
