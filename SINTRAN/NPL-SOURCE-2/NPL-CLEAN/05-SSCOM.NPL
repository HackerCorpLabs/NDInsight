
       )MCDEF SDATA
       A=6; ]

       )MCDEF DATA $PAR
       )KILL A; A=$PAR +1; ]

       )MCDEF FENTR
       STD I (ASTCK; COPY SL DA; COPY SB DD; SAB A; JPL I (SPUSH; ]

       )MCDEF FLEAV
       SAA -A; JMP I (SPOP; )KILL A; ]

       )MCDEF ISTCK
       STA I (ASTCK; LDA (STACK; STA I (CSTCK
       SAA 1; STA I (TDVN; LDA I (ASTCK; ]

       )MCDEF MINBT
       JPL I (SINBT; ]

       )MCDEF MOUTB
       JPL I (SOUTB; ]
)LINE
