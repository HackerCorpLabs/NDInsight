" @DEV 1
 @DEV (S-S-J)CDR1


 %============================================================================
 %      C D R 1
 %============================================================================


 *"MODIN
" %==============================================================================
 % 33.1       M O S T I   M O T R I   M O S T O   M O T R O
 %            M O T M O   M O T M I
 %

 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %    SYNCRONOUS MODEM DRIVER                 %
 %    AND HANDLING ROUTINES FOR SINTRAN III   %
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

 SUBR MOSTI,MOTRI,MOSTO,MOTRO,MOTMO,MOTMI,TDBPUT,TDBGET
 DISP -12
 INTEGER MOWSTAT
 INTEGER TERSW,MOSW
 PSID
 % SET STATUS FOR MODEM INPUT
 % A=-3: READ MOSW, AND RETURN IT TO THE USER
 % A=-2: INITIATE BLOCK RECEIVE (SEARCH FOR SYNC)
 % A=-1: CLEAR INPUT BUFFER
 % A= 0: UNDEFINED TERMINATE CONDITION
 % A= 1: SET DCT-2000 TERMINATE CONDITION
 % A= 2: SET CD-200USER TERMINATE CONDITION
 % A= 3: SET GERTS-115 TERMINATE CONDITION
 % A= 4: SET IBM-3780/2780 TERMINATE CONDITION
 % A= 5: SET VIP TERMINATE CONDITION
 % A= 6: SET HASP WS TERMINATE CONDITION
 % A= 7: SET UNIVAC NTR TERMINATE CONDITION
 % A=10: SET MSV2 TERMINATE CONDITION
 % A=11: SET IBM-3270 TERMINATE CONDITION
 % A=12: SET BTH/VIP7700 TERMINATE CONDITION
 % A=13: SET STANSAAB TERMINATE CONDITION
 % A=14: SET UTS-400  TERMINATE CONDITION
 %
 %
 %      SET STATUS FOR MODEM INPUT
 %
 MOSTI: IF A<0 GO MOSI5
        IF A>14 GO MOSI6
        A=:TERSW; EXIT                  % SET TERMINATE CONDITION
 MOSI5: IF A+4<0 GO MOSI6
        GOSW MOSI4, MOSI3, MOSI2, MOSI1
 MOSI4: EXIT
 %
 %      CHECK IF A COMPLETE BLOCK IS RECEIVED
 %
 MOSI3: A:=0
        IF T:=MOSW-4=0 THEN 5=:MOSW; A:=1 FI
        EXIT
 %
 %      INITIATE BLOCK RECEIVE (SEARCH FOR SYNC), CLEAR INPUT BUFFER
 %
 MOSI2: T:=HDEV; *EXR ST; EXR ST        % DUMMY READ
        2204; T:=HDEV+DCONT; *EXR ST
        2205; GO MOSI7
 %
 %      RECEIVER RESET, CLEAR BUFFER
 %
 MOSI1: 2204
 MOSI7: T:=HDEV+DCONT;*EXR ST
        0=:MOSW
        A:=0 BONE 14; *MCL PID          % DISABLE DRIVER ON LEVEL 12
        GO CLBUF
 MOSI6: EXIT
 %
 %      TIMER ROUTINE FOR MODEM INPUT
 %
 MOTMI: 4=:MOSW
        2204; T:=HDEV+DCONT; *EXR ST
        GO RTACT
 %
 %      IOTRANS ROUTINE FOR MODEM INPUT
 %
 MOTRI: L+1
        IF BHOLD>0 THEN T:=MBSYMOD; GO TDBGET FI
        A:=-1; EXIT
 *)FILL
 %
 %      SET STATUS FOR MODEM OUTPUT :
 %
 % A=-1: CLEAR MODEM OUTPUT BUFFER
 % A= 0: START SENDING OF CURRENT BLOCK
 % A= 1: SET 377 - BYTES TO SEND BETWEEN DATA
 % A= 2: SET ASCII SYNC TO SEND
 % A= 3: SET EBCDIC SYNC TO SEND
 % A= 4: SYNCRONIZE ON 26 RECEIVED (ASCII)
 % A= 5: SYNCRONIZE ON 62 RECEIVED (EBCDIC)
 % A= 6: SYNCRONIZE ON 226 RECEIVED (ASCII)
 % A= 7: SET ASCII SYNC (226 TO SEND BETWEEN DATA)
 %
 MOSTO: IF A+1<0 OR >10 THEN EXIT FI
        GOSW MOSCL,MOS0,MOS1,MOS2,MOS3,MOS4,MOS5,MOS6,MOS7
 MOS1:  777;  GO MOS11
 MOS2:  426;  GO MOS11
 MOS3:  462;  GO MOS11
 MOS4:  1026; GO MOS11
 MOS5:  1062; GO MOS11
 MOS6:  1226; GO MOS11
 MOS7:  626;
 MOS11: T:=HDEV-3;*EXR ST;EXIT          % UPDATE HARDWARE SYNCREGISTERS

 MOSCL: 0=:MOWSTAT=:TMR=:DERROR
        GO CLBUF

 MOS0:  5; T:=HDEV+DCONT; *EXR ST
        TTMR=:TMR; 2=:MOWSTAT; EXIT     % SET WAIT CONDITION
 %
 %      IOTRANS ROUTINE FOR MODEM OUTPUT
 %
 MOTRO: IF T:=MOWSTAT-2=0 THEN EXIT FI  % CALLING PROGR WILL WAIT
        L+1; T:=MBSYMOD; GO TDBPUT
 %
 %      TIME-OUT SUBROUTINE FOR MODEM OUTPUT
 %
 MOTMO: 12=:DERROR
        "0"; T:=HDEV+DCONT; *EXR ST
        IF ISTATE>0 GO RTACT
        0=:MOWSTAT
        EXIT
 RBUS
 *"8HMO1+8HMO2+8HMO3+8HMO4+8HMO5+8HMO6
"
 %==============================================================================
 % 33.11      H O S T I   H O T R I   H O S T O   H O T R O
 %            H O T M O   H O T M I
 %

 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 % SYNCRONOUS MODEM DRIVER FOR HDLC INTERFACE
 % AND HANDLING ROUTINES FOR SINTRAN III
 %
 % IMPLEMENTED IN SINTRAN 81F (15/5/81  H-AA)
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

 %
 %
 %I O X DEFINITIONS FOR HDLC USED AS SYNCRONOUS MODEM

 @ICR;
 SYMBOL BRRDR=0,                                 % READ REC.DATA REG.
 BWPCR,                                          % WRITE PARAM. CONTR. REG.
 BRRSR,                                          % READ REC STATUS
 BWSAR,                                          % WRITE SYNC/ADDRESS REG.
 BWCHL,                                          % WRITE CHAR. LENGTH
 BWTDR,                                          % WRITE TRANSM. DATA REG.
 BRTSR,                                          % READ TRANSM. STATUS REG.
 BWTCR,                                          % WRITE TRANSM. CONTROLE REG.
 BRRTS,                                          % READ REC. TRANSFER STATUS
 BWRTC,                                          % WRITE REC. TRANSFER CONTROLE
 BRTTS,                                          % READ TRANSM. TRANSFER STATUS
 BWTTC;                                          % WRITE TRANSM. TRANSFER CONTRO
 @CR;


 SUBR HOSTI,HOTRI,HOSTO,HOTRO,HOTMO,HOTMI
 DISP -14
        INTEGER HTFIL                   % OUTPUT UNDERRUN FILL CHAR
        INTEGER HOWSTAT
        INTEGER HERSW
        INTEGER HDXOK                   % CLEARED BY X21
        INTEGER MOSW
 PSID
 % SET STATUS FOR MODEM INPUT
 % A=-3: READ MOSW, AND RETURN IT TO THE USER
 % A=-2: INITIATE BLOCK RECEIVE (SEARCH FOR SYNC)
 % A=-1: CLEAR INPUT BUFFER
 % A= 0: UNDEFINED TERMINATE CONDITION
 % A= 1: SET DCT-2000 TERMINATE CONDITION
 % A= 2: SET CD-200USER TERMINATE CONDITION
 % A= 3: SET GERTS-115 TERMINATE CONDITION
 % A= 4: SET IBM-3780/2780 TERMINATE CONDITION
 % A= 5: SET VIP TERMINATE CONDITION
 % A= 6: SET HASP WS TERMINATE CONDITION
 % A= 7: SET UNIVAC NTR TERMINATE CONDITION
 % A=10: SET MSV2 TERMINATE CONDITION
 % A=11: SET IBM-3270 TERMINATE CONDITION
 % A=12: SET BTH/VIP7700 TERMINATE CONDITION
 % A=13: SET STANSAAB TERMINATE CONDITION
 % A=14: SET UTS-400  TERMINATE CONDITION
 %
 %
 % SET STATUS FOR MODEM INPUT
 HOSTI: A=:D
        IF HDXOK><X21OP THEN 12=:DERROR; EXIT FI
        D=:A
        IF A<0 GO MOSI5
        IF A>14 GO MOSI6
        A=:HERSW; EXIT        % SET TERMINATE CONDITION
 MOSI5: IF A+4<0 GO MOSI6
        GOSW MOSI4, MOSI3, MOSI2, MOSI1
 MOSI4: EXIT
 MOSI3: "0"; IF T:=MOSW-4=0 THEN 5=:MOSW;1 FI;EXIT
 MOSI2: T:=HDEV+BRRDR;*EXR ST;EXR ST    % DUMMY READ
        100; T+"BWRTC-BRRDR"; *EXR ST   % STOP RECEIVER
        105; *EXR ST                    % START AND SEARCH FOR SYN
        1=:HOWSTAT
        0=:MOSW; GO FAR CLBUF
 MOSI1: A:=100; T:=HDEV+BWRTC; *EXR ST
        A:=0; T+"BWCHL-BWRTC"; *EXR ST  % 8 BITS BYTE
        0=:MOSW
        GO FAR CLBUF
 MOSI6: EXIT
 %
 % TIMER ROUTINE FOR MODEM INPUT
 HOTMI: 4=:MOSW
        100; T:=HDEV+BWRTC; *EXR ST
        GO FAR RTACT
 % IOTRANS ROUTINE FOR MODEM INPUT
 HOTRI: L+1
        IF BHOLD>0 THEN T:=MBSYMOD; GO TDBGET FI
        A:=-1;EXIT;*)FILL
 %
 %
 % SET STATUS FOR MODEM OUTPUT
 % A=-1: CLEAR MODEM OUTPUT BUFFER
 % A= 0: START SENDING OF CURRENT BLOCK
 % A= 1: SET 377 - BYTES TO SEND BETWEEN DATA
 % A= 2: SET ASCII SYNC TO SEND
 % A= 3: SET EBCDIC SYNC TO SEND
 % A= 4: SYNCRONIZE ON 26 RECEIVED (ASCII)
 % A= 5: SYNCRONIZE ON 62 RECEIVED (EBCDIC)
 % A= 6: SYNCRONIZE ON 226 RECEIVED (ASCII)
 % A= 7: SET ASCII SYNC (226 TO SEND BETWEEN DATA)
 %
 HOSTO: A=:D
        IF T:=HDXOK><X21OP THEN 12=:DERROR; EXIT FI
        D=:A
        IF A+1<0 OR >10 THEN EXIT FI
        GOSW MOSCL,MOS0,MOS1,MOS2,MOS3,MOS4,MOS5,MOS6,MOS7
 MOS1:  377=:HTFIL; T:=HDEV+BWTDR; *EXR ST   % DUMMY SYNC CHAR
        117; T+"BWPCR-BWTDR"; *EXR ST   % 377 AS UNDERRUN FILL CHAR
        EXIT
 MOS4:  26=:HTFIL
 MOS2:  26; GO MOS11
 MOS5:  62=:HTFIL
 MOS3:  62; GO MOS11
 MOS7:  226=:HTFIL
 MOS6:  226
 MOS11: T:=HDEV+BWSAR; *EXR ST;         % UPDATE HARDWARE SYNCREGISTER
        IF HTFIL=377 THEN 117 ELSE 107 FI
        T:=HDEV+BWPCR; *EXR ST
        EXIT
 MOSCL: 0=:HOWSTAT=:TMR=:DERROR
        GO FAR CLBUF
 MOS0:  "MODXX"=:"DRIVER"               % ENTRY POINT FIRST INTERRUPT
        1; T:=HDEV+BWTCR; *EXR ST       % SEND SYNC CHAR, AND START TRANSMITTER
        105; T+"BWTTC-BWTCR"; *EXR ST   % ENABLE OUTPUT
        TTMR=:TMR;2=:HOWSTAT;EXIT       % SET WAIT CONDITION
 % IOTRANS ROUTINE FOR MODEM OUTPUT
 HOTRO: IF T:=HOWSTAT-2=0 THEN EXIT FI   % CALLING PROGR WILL WAIT
        L+1; T:=MBSYMOD; GO TDBPUT
 %
 % TIME-OUT SUBROUTINE FOR MODEM OUTPUT
 HOTMO: 12=:DERROR
        A:=0; T:=HDEV+BWTTC; *EXR ST
        IF ISTATE>0 GO FAR RTACT
        0=:HOWSTAT
        EXIT
 RBUS
 *"
"
 %==============================================================================
 % 33.2       I O R E M
 %
 SUBR IOREM
 IOREM: IF X:=X.RTRES >< 0 THEN CALL RTENT; CALL FTIMQU FI
        CALL STUPR
 RBUS


 *"IDR4
"

 %==============================================================================
 % 33.11      P L O T T
 %


 %- - -  GRAPHIC I/O.
 % MONITOR CALL:              CALL PLOTT(X,Y,Z,DVN,FUNC)
 % APPL. LEVEL

 SUBR PLOTT

 DISP -6; INTEGER POINTER PLDRI; PSID

 PLOTT: CALL GET5; IF D3/\177700=100 THEN 2; GO ERROR FI
        D3; CALL LOGPH
        IF X:=D=0 THEN 2;  GO ERORR FI     % TEST IF DEVICE PRESENT
        IF X.RTRES><CURPROG THEN 5; GO ERORR FI  % RESERVED BY THIS USER ?
        X."PLDRI"=:P                   % CALL RELEVANT INTERFACEROUTINE
 ERORR: A=:ZAREG;  GO RET               % DEVICE NOT AVAILABLE
 RBUS


 *"8TXTR
" %====================================================================
 %
 % 33.24      R E A D C L O C K
 %
 %
 %   ROUTINE TO READ PANEL CLOCK ON N-100 AND UPDATE THE
 %   INTERNAL SINTRAN CLOCK.
 %

 *"8PACL
" @DEC
 INTEGER ARRAY PTBASE(0)
 DATA(0,0,1,1,1979); INTEGER ARRAY TBASE(0)       % TIME BASE FOR PANEL CLOCK
 INTEGER ARRAY DAYEAR:=(365,366,365,365)
 INTEGER ARRAY DAMONTH:=(31,28,31,30,31,30,31,31,30,31,30,31)
 @OCT
 INTEGER ADDYEAR,ADDMONTH,PERIOD
 INTEGER HDAYES,DAYES,HOURS,SECOND
 INTEGER HDAY2,SEC2

 INTEGER PX9CL:=(X9CL1)
 INTEGER PX8CL:=(X9CL0,X9CL1)
 INTEGER X9CL0,X9CL1,X9CL2,X9CL3,X9CL4,X9CL5,X9CL6,X9CL7
 INTEGER ARRAY PXCLX(0)
 INTEGER PPXCL:=PX8CL
 INTEGER PPX3CL:=PX9CL
 INTEGER XCLNUN,XCLUN
 DOUBLE DXCLUN
 INTEGER ARRAY PLXCL:=(XCLNUN,XCLUN)
 *"
" INTEGER PWRFREST             % POWERFAIL/RESTART FLAG
 INTEGER ERUCL:=0             % SET WHEN PANEL CLOCK INCORRECT

 *"8PACL
" SUBR READCLOCK
 INTEGER POINTER LREG
 READCLOCK:
        IF PWRFREST><0 THEN EXIT FI
        A:=L=:"LREG"
        *PIOF
        CALL 3RCLOCK; *PION             % IN POF AREA
        1=:PWRFREST; GO LREG
 RBUS

 SUBR EX113M,EX112M
 EX113M: *PION; MON 113; PIOF; EXIT
 EX112M: *PION; MON 112; PIOF; EXIT
 RBUS

 *"-8PACL
"
 %======================================================================
 %
 % 33.25      S E T C L O C K
 %
 %  ROUTINE TO UPDATE PANEL CLOCK ON N-100.  THE CLOCK IS UPDATED
 %  WITH THE COMMAND @UPDAT OR THE SIMILAR MONITOR CALL (MON 111)
 %  AND THE COMMAND @CLADJ OR THE SIMILAR MONITOR CALL (MON 112)
 %
 % CALLED WITH MONITOR LEVEL DISABLED!!!!
 %

 SUBR SETCLOCK
 INTEGER POINTER LREG
 SETCLOCK:
        IF PWRFREST><1 THEN EXIT FI
        A:=L=:"LREG"
        *POF
        CALL 3SETCLOCK
        *PON
        GO LREG
 RBUS


 %  PANEL PROCESSOR DRIVER
 SUBR PANEL
 INTEGER TIMOX:=-2000
 PANEL: *TRR 0
        X:=TIMOX; *TRA 0; BSKP ONE 140 DA; JNC *-2
        EXIT
 RBUS
 *"
"
 %======================================================================
 %
 % 33.26      G E R D V
 %
 %  MONITOR CALL TO RETURN ERROR DEVICE (LOGICAL NUMBER) AND BY WHOM
 %  IT MIGHT BE RESERVED.
 %

 SUBR GERDV
 INTEGER POINTER PTTNO:=TTNO

 GERDV: CALL GET0; MLEV; *MST PIE
        T:=5ERRSEG; CALL MMEXY; A:=PTTNO; CALL MMEXY A=:ZAREG
        CALL LOGPH; A:=D.RTRES=:ZDREG; GO RET
 RBUS

