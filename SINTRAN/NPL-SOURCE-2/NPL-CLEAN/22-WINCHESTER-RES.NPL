% *"8WDIS+8WDIM+8ZWDI
"8WDIS+8WDIM+8ZWDI
%

% *)9SLPL
)9SLPL
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %                                                                                 %
 %   FILE NAME   : WINCHESTER:NPL                                                  %
 %   PROGRAM NO. : HUT-2475 A.6                                                    %
 %   ISSUED      : 82.02.18             BY: DG AND TP                              %
 %                                                                                 %
 %   LAST CHANGED: 83.10.03             BY: MJH                                    %
 %   LAST CHANGED: 85.09.04             BY: KGT USE AD-REG FOR SECTOR ADDRESS      %
 %                                                                                 %
 % T R A N S F E R   R O U T I N E   F O R    8"   W I N C H E S T E R    D I S K  %
 %                                                                                 %
 % INCLUDING BAD TRACK REALLOCATION, BUT NO ERROR CORRECTION                       %
 %                                                                                 %
 %                                                                                 %
 %                                                                                 %
 % CALLING SEQUENCE:                                                               %
 %      JPL I (WIDIS          % OR  JPL I (ZWDIS  IF SWAP DRIVER                   %
 %      JMP   ERROR           % ERROR    EXIT                                      %
 %      JMP   BUSY            % BUSY     EXIT                                      %
 %      JMP   FINIS           % FINISHED EXIT                                      %
 %                                                                                 %
 % CALLING PARAMETERS:                                                             %
 %      X-REG = NUMBER OF SECTORS TO TRANSFER                                      %
 %      T-REG (BIT 0-5)  = FUNCTION CODE:                                          %
 %                          0 - READ                                               %
 %                          1 - WRITE                                              %
 %                          2 - READ PARITY                                        %
 %                          3 - COMPARE                                            %
 %                         20 - READ STATUS                                        %
 %             BIT  6-7  = UNIT NUMBER                                             %
 %             BIT     8 = TRACK TEST                                              %
 %             BIT     9 = NOT USED                                                %
 %             BIT    10 = LATE DATA STROBE
 %             BIT 11-13 = NOT USED                                                %
 %             BIT    14 = EARLY DATA STROBE                                      %
 %             BIT    15 = BAD TRACK                                               %
 %      AD-REG = SECTOR ADDRESS (LOGICAL)                                           %
 %                                                                                 %
 %      THE MEMORY ADDRESS (24 BITS) IS FOUND IN THE DATAFIELD DOUBLE WORD CMAD1   %
 %                                                                     AND CMAD2   %
 %                                                                                 %
 %                                                                                 %
 % RETURN INFORMATION:                                                             %
 %      ERROR    EXIT: X = HARDWARE STATUS                                         %
 %      BUSY     EXIT: THE ROUTINE MUST BE CALLED AFTER INTERRUPT                  %
 %      FINISHED EXIT: X = HARDWARE STATUS                                         %
 %                                                                                 %
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

 *"8ZWDI -8WDIS
"
 *WIDIS, JMP WISTA

 *"8WDIS+8WDIM+8ZWDI
"
 SYMBOL ACTIV=2 , ICERR=4 , ADDMI=10 , ONCYL=16 , TEST=10

 % LOCAL VARIABLES IN DRIVER ------------------------------------------

 INTEGER IRETR:=-4
 INTEGER 9TREG     % SAVED T-REG IN CALL
 INTEGER 9AREG     % SAVED A-REG IN CALL
 INTEGER 9DREG     % SAVED D-REG IN CALL
 INTEGER 9XREG     % SAVED X-REG IN CALL
 INTEGER SSTAT     % SAVED HARDWARE STATUS
 TRIPLE SATAD=9TREG


 % DATA FIELD VARIABLES USED BY THE DRIVER:
 %
 % ADMIA      SAVED ADDR MISMATCH BLOCK ADDR
 % ADMIS      SAVED ADDR MISMATCH STATUS
 % ALTPO      ADDRESS OF ALTERNATIVE TRACK POINTER
 % BADDR      BAD ADDR
 % BADIP      BAD ADDR IN PROCESS (EXTRA ADDRESS BIT)
 % BADTR      BAD TRACK FLAG
 % BUSFL      BUSY FLAG
 % CMAD1      MEM ADDR
 % CMAD2       "   "
 % ERRC1      RETRY COUNTER
 % HDEV       DEVICE NUMBER (0500,0510)
 % HTABL(2)   DISK DESCRIPTOR TABLE
 % LCYLI(2)   LAST CYLINDER
 % NOSEC      NO. OF SECTORS IN TRANSFER
 % RTZFL      RETURN-TO-ZERO FLAG
 % SEEKF      SEEK FLAG
 % SHEAD      HEAD NO.
 % SSEC       NO. OF SECTORS IN LAST TRANSFER
 % SSTEP      SAVED LAST STEP COUNT
 % SVLBB      SAVED DISK ADDR (CYLINDER AND SECTOR)
 % SVLCA      SAVED LEAST MEM ADDR
 % SVLCO      SAVED CONTROL WORD
 % SVLWC      SAVED WORD COUNT
 % TRTZ       RETURN-TO-ZERO FLAG
 % WANKN      SAVED MOST MEM ADDR


 % DISK TYPE SPECIFICATION:   -------------------------------------------

 INTEGER WSECW        % WORDS/SECTOR
 INTEGER WSECT        % SECTORS/TRACK
 INTEGER WSECY        % SECTORS/CYLINDER
 INTEGER WMXCY        % MAX CYL. VALUE
 TRIPLE  DISDE=WSECW
 DISP 0 ; TRIPLE CDISD ; INTEGER CMAXC ; PSID
 INTEGER STAT1=?
 INTEGER STAT3=?

 *"8ZWDI -8WDIS
"
 % DRIVER INITIALIZE ------------------------------------------------

 SUBR WIDIS

 % IOX DISPLACEMENTS:

 SYMBOL RMAR=0       % READ MEMORY ADDRESS REGISTER
 SYMBOL LMAR=1       % LOAD MEMORY ADDRESS REGISTER
 SYMBOL RSEEK=2      % READ SEEK CONDITION
 SYMBOL LDAD=3       % LOAD DISK   ADDRESS REGISTER
 SYMBOL RSTAT=4      % READ HARDWARE STATUS
 SYMBOL LCONT=5      % LOAD CONTROL WORD
 SYMBOL RDAD=6       % READ DISK ADDRESS REGISTER
 SYMBOL LWORD=7      % LOAD WORDCOUNT
 SYMBOL IOXIN=164500 % IOX 500 DISC SYSTEM 1
 SYMBOL IOXRS=164004

 *"8WDIM
"

 %        WDISC:
 %  >>>>>>>>>>>>V
 %              V
 %              V
 %   -----------V----------------- YES
 %   * IS IOX STAT1 OR IOX CONT4 >>>>>>>>>>>>>>>>>>>V
 %   * WRONG                     *                  V
 %   -----------V-----------------          --------V------------
 %              V NO                        * GENERATE AL IOX'S *
 %              V                           --------V------------
 %              V                                   V
 %              V<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
 %              V
 %   -----------V---------------------
 %   * READ STATUS. SAVE IT IN SSTAT *
 %   -----------V---------------------
 %              V
 %         -----V---- YES
 %         * BUSY ? >>>>>>>> WBUSY:
 %         -----V----
 %              V NO
 %         -----V--------- YES
 %         * ON CYLINDER ? >>>>>>>> RETZ:
 %         -----V---------
 %              V NO
 %     NO  -----V-------- YES
 %    <<<<<< BUSFL><0 ? >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
 %    V    --------------                                  V
 %    V                                                    V
 %  --V-------------------------------------   ------------V------------
 %  * SELECT UNIT AND READ STATUS AND SAVE *   * INCLUSIVE OR OF ERROR * YES
 %  * RESET SEEKF, BADTR, RTZFL AND TRTZ   *   * IN STATUS ?           >>>>>>>> IERR:
 %  --V-------------------------------------   ------------V------------
 %    V                                                    V NO
 %    V                                             -------V----- YES
 %  --V-------------                                * TRTZ><0 ? >>>>>>>> DSEEK:
 %  * IS OPERATION *                                -------V-----
 %  * READ STATUS  * YES                                   V NO
 %  * (20) ?       >>>>>>>>>> DFIN:                 -------V------ YES
 %  --V-------------                                * SEEKF><O ? >>>>>>> RWDIS:
 %    V NO                                          -------V------
 %  --V-------------                                       V NO
 %  * IS OPERATION * YES                         ----------V-------------- NO
 %  * >=4 ?        >>>>>>> DILLC:                * MAR=OLDMAR+OLDWORDC ? >>>>>>> MEMER:
 %  --V-------------                             ----------V--------------
 %    V NO                                                 V YES
 %    V                                                ----V--------- YES
 %    V                                                * BADTR><0 ? >>>>>>>> DBAD:
 %    V                                                ----V---------
 %    V                                                    V NO
 %    V>>>>>>>>>>>>>>>>V<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<V
 %                     V
 %                 ----V---- YES
 %                 * X=0 ? >>>>>>> DFIN:
 %                 ----V----
 %                     V NO
 %                     V>>>>>>>>>> DSEEK:


 WISTA: TAD=:SATAD ; X=:9XREG           % SAVE T,A,D,X

 *"8WDIS+8WDIM
"
        T SHZ 10 SHZ -16=:X             % UNIT NO IN X
        X:=HTABL(X)                     % POINTER TO DESCRIPTOR FIELD IN X
        TAD:=X.CDISD=:DISDE             % PUT WORDS/SECTOR, SECTORS/TRACK AND SECTORS/CYLINDER
        X:=X.CMAXC=:WMXCY               % PUT MAX CYL. VALUE
        X:=9XREG

 *"8WDIS+8WDIM+8ZWDI
"
        IF A:=HDEV+IOXRS-STAT1><0 OR A+STAT1-STAT3><0    % TEST FIRST & LAST IOX
           THEN                                                        % IF NOT INITIALIZED THEN DO SO
             A:=HDEV+IOXRS  ; * STA    STAT1; STA    STAT2; STA I (STAT3
             A+"LDAD-RSTAT" ; * STA I (DAD1 ; STA I (DAD3
             A+"RDAD-LDAD"  ; * STA I (DAD2
             A+"LMAR-RDAD"  ; * STA I (LMAR1; STA I (LMAR2; STA I (LMAR3; STA I (LMAR4
             A+"LCONT-LMAR" ; * STA    CONT1; STA    CONT2; STA I (CONT3; STA    CONT4; STA I (CONT5; STA I (CONT6
             A+"LWORD-LCONT"; * STA I (WORD1; STA I (WORD2; STA I (WORD3; STA I (WORD4
             A+"RMAR-LWORD" ; * STA    RMAR1; STA    RMAR2
        FI

 % DRIVER MAIN ENTRY -----------------------------------------------

 *STAT1, IOXIN RSTAT                              % READ STATUS
         A=:SSTAT
         IF A BIT ACTIV  GO FAR WBUSY             % GO IF CONTROLLER BUSY
         IF A NBIT ONCYL GO FAR RETZ              % IF NOT ON CYLINDER, ERROR, RECALIBRATE
         IF T:=BUSFL><0                           % IF LAST LEAVE WAS A BUSY RETURN
            THEN                                  % THEN  OLD TRANSFER IS TO BE CHECKED
              IF A BIT ICERR GO     IERR          % GO IF INCLUSIVE OR OF ERRORS SET
              IF A:=TRTZ><0  GO FAR DSEEK         % NEW SEEK IF LAST COMMAND WAS RECALIBRATE
              IF A:=SEEKF><0 GO FAR RWDIS         % GO TO READ/WRITE ROUTINE IF SEEK FLAG SET
 *RMAR1,      IOXIN RMAR                          % READ MEMORY ADDRESS REG. LOWER 16 BITS
              T:=A
 *RMAR2,      IOXIN RMAR                          % READ MEMORY ADDRESS REG. UPPER 8 BITS
              A/\377:=:T-SVLCA
              T:=T+C-1
              A-SVLWC
              T:=T+C-1
              A:=:T-WANKN
              IF A><0 OR T><0 GO FAR MEMER        % MEMORY ADDRESS ERROR
              IF A:=BADTR><0  GO FAR DBAD         % GO TO BAD TRACK ROUTINE
            ELSE                                  % ELSE NEW TRANSFER
              A:=9TREG/\300 SHZ 3 BONE 4
 *CONT1,      IOXIN LCONT                         % SELECT UNIT, CLEAR DISC UNIT
 *CONT2,      IOXIN LCONT                         % CLEAR DISC INTERFACE
 *STAT2,      IOXIN RSTAT                         % READ STATUS
              A=:SSTAT
              0=:SEEKF=:BADTR
              0=:RTZFL=:TRTZ=:NOSEC
              IF A:=77/\9TREG-20=0 GO FAR DFIN    % GO IF READ STATUS COMMAND
              IF A+14>=0           GO FAR DILLC   % GO IF ILLEGAL COMMAND
        FI
        IF X=0 GO FAR DFIN                        % GO IF ALL WORDS TRANSFERRED, FINISHED  !!!!!!!!
        0=:BADIP
        GO FAR DSEEK                              % EXECUTE SEEK

 *)FILL


 % ROUTINE TO HANDLE DISK STATUS ERROR -------------------------------
 %
 %      >>>>>>>>>>>>>>>>V
 %                IERR: V
 %            ----------V----------
 %            * CLEAR DEVICE      *
 %            ----------V----------
 %                      V
 %            ----------V---------- YES
 %            * 9TREG BIT TEST    >>>>>>>> HDERR:
 %            ----------V----------
 %                      V NO
 %            ----------V---------- YES
 %            * SEEKF><0 ?        >>>>>>>> RETZ:
 %            ----------V----------
 %                      V NO
 %            ----------V---------- YES
 %            * TRTZ><0 ?         >>>>>>>> HDERR:
 %            ----------V----------
 %                      V NO
 %         NO ----------V---------- YES
 %       V<<<<< BADTR><0 ?        >>>>>>>>>>>>>>>>>>
 %       V    ---------------------                V
 %       V                                         V
 %  -----V-----------------   ---------------------V--------------------
 %  * CALCULATE THE VALUE *   * STEP THE BLOCK ADDRESS TO POINT TO THE *
 %  * OF 9XREG PRIOR TO   *   * NEXT SECTOR ON THE BAD TRACK. DID THAT * YES
 %  * LAST TRANSFER       *   * GIVE A TO BIG SECTOR NO. ?             >>>>>>>V
 %  -----V-----------------   ---------------------V--------------------      V
 %       V                                         V NO                       V
 %  -----V--------------                           V           ---------------V----------------
 %  * HAS AL RETRYS    * NO                        V           * RESTORE BLOCK ADD AND STATUS *
 %  * BEEN DONE (ERRC1)>>>>>>> RWDIS:              V           * OF THE ORIGINAL ERROR        *
 %  -----V--------------                           V           ---------------V----------------
 %       V YES                                     V                          V
 %  -----V------------                             V                          V
 %  * RESET RETRIES  *                             V                          V>>>>>> RETZ:
 %  * (IRETR=:ERRC1) *                             V
 %  -----V------------                             V
 %       V                                         V
 %  -----V----------------                         V
 %  * WAS THE ERROR      * NO                      V
 %  * ADDRESS MISMATCH ? >>>>> RETZ:               V
 %  -----V----------------                         V
 %       V YES                                     V
 %  -----V-----------------------------------      V
 %  * SSTAT=:ADMIS. READ FAILING BLOCK ADD. *      V
 %  * FROM THE INTERFACE. SAVE IT IN ADMIA. *      V
 %  * CALCULATE BLOCK ADDRESS FOR THE FIRST.*      V
 %  * SECTOR ON THAT TRACK.                 *      V
 %  * SET AND BADIP BADTR><0.               *      V
 %  -----V-----------------------------------      V
 %       V                                         V
 %       >>>>>>>>>>>>>>>>>>>V<<<<<<<<<<<<<<<<<<<<<<<
 %                          V
 %               -----------V----------------------
 %               * LOAD BLOCK ADDRESS             *
 %               * LOAD MAR WITH ADDRESS OF ALTPO *
 %               * LOAD WORDC WITH 1.             *
 %               * SET BIT 15 IN T (SEEK)         >>>>>>> WDACT:
 %               ----------------------------------



 IERR:   A:=20
 *CONT4, IOXIN LCONT                           % DEVICE CLEAR
         IF A:=9TREG BIT TEST GO FAR HDERR     % IF TEST SPECIFIED, NO ERROR HANDLING
         IF A:=SEEKF><0       GO RETZ          % IF THE ERROR OCCURED DURING SEEK DO RETURN TO ZERO ZEEK
         IF A:=TRTZ ><0       GO FAR HDERR     % IF RETURN TO ZERO SEEK ALREADY HAS BEEN DONE, ERROR RETURN
         IF A:=BADTR><0                        % IF BAD TRACK FLAG SET THEN
            THEN                               % TRY NEXT SECTOR ON THE TRACK
              T:=BADDR+1                       % ERROR IN ALTERNATIVE ADDRESS FETCH INCR. SECT. ADDR. TO FIND A GOOD SECTOR
              IF A:=37/\T-WSECT>=0             % TEST LEGAL SEC. COUNT
                 THEN                          % THEN ALL SECTORS ON THE TRACK TRIED
                   A:=ADMIA=:SVLBB             % REPORT THE ORIGINAL ERROR
                   A:=ADMIS=:SSTAT
                   GO RETZ
              FI
              A:=T                             % BLOCK ADDRESS OF NEXT SECTOR IN A
            ELSE
              A:=9XREG+NOSEC=:9XREG=:X         % RESTORE X AND 9XREG
              MIN ERRC1 ; GO FAR RWDIS         % DO AL RETRIES FIRST
              A:=IRETR=:ERRC1                  % RESTORE RETRY COUNTER
              IF A:=SSTAT NBIT ADDMI GO RETZ   % NOT ADDRESS MISMATCH,  RECALIBRATE  !
              A=:ADMIS                         % SAVE ADDRESS MISMATCH STATUS IN CASE OF REAL ADDRESS MISMATCH
              A:=100000=:BADTR=:BADIP          % SET BAD TRACK FLAG
 *DAD2,       IOXIN RDAD                       % READ LAST DISK ADDRESS
              A-1=:ADMIA                       % SAVE FAILING BLOCK ADDRESS REG IN CASE OF REAL ADDRESS MISMATCH
              A/\177740                        % BACK TO FIRST SECTOR ON THE TRACK
                                               % IT IS AN ADDRESS MISMATCH, TRY BAD TRACK BIT
         FI
 *DAD3,  IOXIN LDAD                            % LOAD FAILING ADDRESS
         A=:BADDR
         A:=0=:WANKN
 *LMAR3, IOXIN LMAR                            % LOAD UPPER MEM. ADDR.
         A:="ALTPO"+B=:SVLCA
 *LMAR4, IOXIN LMAR                            % LOAD LOWER MEM. ADDR.
         A:=1=:SVLWC
 *WORD4, IOXIN LWORD                           % LOAD WORD COUNT = 1 SECTOR
         T:=100000                             % SET BAD TRACK BIT IN COMMAND
         GO FAR WDACT                          % TRY TO READ FAILING SECTOR WITH BAD TRACK BIT SET


 % ROUTINE TO DO RETURN TO ZERO SEEK       ------------------------------

 RETZ:   IF A:=RTZFL><0 GO FAR HDERR      % RECALIBRATE ALREADY DONE ?
         0=:BADTR=:SEEKF=:SHEAD=:BADIP    % RESET BAD TRACK FLAG
         A:=9TREG SHZ 10 SHZ -16 =:X      % UNIT INTO X
         0=:LCYLI(X)                      % CLEAR CYLINDER NO IN BASE FIELD
         A:=IRETR=:ERRC1                  % RESET RETRY COUNT
         T:=34000                         % RETURN TO ZERO SEEK, RECALIBRATE
         T=:RTZFL=:TRTZ                   % SET RECALIBRATE AND FLAG
         GO FAR WDACT                     % ACTIVATE


 % ROUTINE TO GET ALTERNATIVE DISK ADDRESS ------------------------------

 % ENTER HERE WHEN A SECTOR CONTAINING POINTERS TO THE ALTERNATIVE TRACK
 % IS READ CORRECT
 % PICK UP THE POINTER TO THE ALTERNATIVE TRACK FROM THE FIRST WORD IN THE MEMORY BUFFER
 % FIND THE CYLINDER PART OF THE POINTER. SUBTRACT IT FROM THE CURRENT CYLINDER (LCYLI)
 % THE DIFFERENCE (NO. CYLINDERS TO SEEK) IS WRITTEN OUT AS WORD COUNT.
 % STORE THE NEW CYLINDER NO. IN LCYLI.
 % FIND THE ALTERNATIVE TRACK'S HEAD NO., AND STORE IT IN SHEAD.

 DBAD:   T:=ALTPO                       % T <== ALTERNATIVE DISK CYL. ADDR.
         A:=9TREG SHZ 10 SHZ -16=:X     % UNIT NO. IN X
         A:=T ; AD SHZ -5               % HEAD INTO UPPER 5 BITS OF D, CYLINDER IN A
         A-LCYLI(X)                     % A <== NO. OF CYL'S TO GO
 *WORD3, IOXIN LWORD
         T SHZ -5 =:LCYLI(X)            % NEW CYL. ADDR. AFTER THIS SEEK
         A:=0 ; AD SHZ 5 ; A=:SHEAD     % HEAD TO USE ON ALT TRACK
         A:=-1=:SEEKF                   % SET SEEK FLAG
         0=:BADTR                       % RESET BAD TRACK FLAG
         T:=60000                       % SEEK COMMAND
         GO WDACT                       % ACTIVATE

 *)FILL


 % ROUTINE TO SEEK ON DISK ---------------------------------------------

 INTEGER TEMPX

 DSEEK:  0=:TRTZ                        % RESET RECALIBRATE FLAG
         A:=9DREG=:D
         A:=9TREG/\300 SHZ 3 BONE 4
 *CONT5, IOXIN LCONT                    % DEVICE CLEAR
 *CONT6, IOXIN LCONT                    % DEVICE CLEAR
         A:=9AREG
         X-1;D+X;IF C THEN A+1;FI; X+1  % AD= LAST LOGICAL DISK ADDR.
         T:=WSECY ; * RDIV ST % A<= CYL. NO.    D<= NO. OF SEC'S IN LAST CYL
         IF A>>T:=WMXCY GO LAOUR        % GO IF WANTED LOGICAL ADDRES>MAX LOGICAL ADDRESS
         X=:TEMPX
         T:=9TREG SHZ 10 SHZ-16=:X      % UNIT NO. IN X
         T:=LCYLI(X)
         A=:LCYLI(X)
         X:=TEMPX
         A-T ; * BLDC 170 DA            % SAVE SEEK DIRECTION IN K
         IF A<0 THEN A:=A- FI           % NEGATIVE STEP COUNT
 *WORD1, IOXIN LWORD                    % LOAD WORD COUNT WITH TRACK DIFFERENCE
         A=:SSTEP
         A:=0 ; T:=WSECT ; * RDIV ST    % A<= HEAD NO.     D<= NO. OF SEC'S ON LAST TRACK
         A=:SHEAD
         A:=D+1=:SSEC
         IF A:=SSTEP><0
            THEN                        % IF NOT ON CORR. CYL
              A=:SEEKF                  % SET SEEK FLAG
              T:=20000 ; * BSTA 160 DT  % STEP COMMAND INCLUDE DIRECTION
              GO WDACT                  % ACTIVATE
        FI


 % ROUTINE TO READ OR WRITE ON DISK -----------------------------------


 RWDIS:  0=:SEEKF                                 % RESET SEEK FLAG
         T:=SSEC=:D
         IF X<<T THEN T:=X FI                     % IF WHOLE TRANSFER WITHIN THIS TRACK THEN T<= NO. OF SEC'S TO TRANSFER
         T=:NOSEC
         X-T=:9XREG                               % X<= REMAINING SECTORS
         D-T                                      % D<= FIRST SECTOR
         A:=9TREG SHZ 10 SHZ -16=:X               % UNIT NO. IN X
         A:=LCYLI(X) SHZ 5 \/D                    % SHIFT CYLINDER ADDR. TO CORR. POSITION COMBINE CYL. & SEC. ADDRESS
 *DAD1,  IOXIN LDAD
         A=:SVLBB
         A:=WSECW ; X:=9XREG ; * RMPY SA DX       % AD<= REMAINING WORDCOUNT
         A:=:D+CMAD2:=:D
         A:=A+C+CMAD1
 *LMAR1, IOXIN LMAR                               % LOAD MEMORY ADDRESS, UPPER PART
         A=:WANKN
         IF A-400>=0 GO MORER                     % MEMORY OUT OF RANGE
         A:=D
 *LMAR2, IOXIN LMAR                               % LOAD MEMORY ADDRESS, LOWER PART
         A=:SVLCA
         A:=T*WSECW                               % A<= WORDCOUNT
 *WORD2, IOXIN LWORD
         A=:SVLWC
         A:=3/\9TREG SHZ 13 =:T                   % FUNCTION CODE IN T


 % ROUTINE TO CREATE CONTROLWORD FOR ACTIVATION -----------------------

 WDACT:  A:=SHEAD SHZ 5   ; T\/A        % SHIFT HEAD NO. TO CORR. POSITION
         A:=9TREG/\142000
         A\/BADIP ; T\/A
         A:=9TREG SHZ 3/\3000\/T+5      % + UNIT NO. + ACTIVATE & INT. ENABLE
 *CONT3, IOXIN LCONT
         A=:SVLCO
 *STAT3, IOXIN RSTAT
         IF A NBIT ACTIV GO CNACT       % ERROR, NOT BUSY
         A=:BUSFL
 WBUSY:  TAD:=SATAD ; X:=9XREG
         GO RETUR                       % BUSY EXIT
 *)FILL


 % FINISHED & ERROR EXITS ----------------------------------------------

 DFIN:   T:=9TREG
         L+1 ; GO WFINI                       % FINISHED EXIT

 MORER:  T:=1   ; GO DERR                     % ATTEMPT TO USE BANK NO. >>377.         BIT  8
 MEMER:  T:=4   ; GO DERR                     % CORE ADDRESS REGISTER NOT AS EXPECTED  BIT 10
 LAOUR:  T:=10  ; GO DERR                     % LOGICAL ADDRESS OUTSIDE DICE DEVICE    BIT 11
 DILLC:  T:=100 ; GO DERR                     % ILLEGAL CODE                           BIT 14
 CNACT:  T:=200 ; GO DERR                     % CONTROLLER NOT ACTIVE AFTER ACTIVATE   BIT 15
 HDERR:  T:=0                                 % HARDWARE ERROR NO ADDITIONAL STATUS

 DERR:   L-1                                  % ERROR RETURN
         T SHZ 10                             % GET THE ADDITIONAL STATUS
         A:=9TREG/\377 ; T\/A
 WFINI:  X:=SSTAT
         A:=IRETR=:ERRC1
         0=:BUSFL
 RETUR:  EXITA                                % GENERAL EXIT
 RBUS

 *)KILL LDAD  RSTAT LCONT LWORD 9TREG 9AREG 9DREG 9XREG
 *)KILL SSTAT SATAD WSECW WSECY ACTIV ICERR ADDMI ONCYL TEST
 *)KILL IRETR
 *)KILL WSECT WMXCY STAT1 RMAR1 RMAR2 CONT1 STAT2 CONT4
 *)KILL DAD2  DAD3  LMAR3 LMAR4 WORD4 WORD3 WORD1 DAD1  LMAR1 LMAR2
 *)KILL WORD2 CONT3 STAT3 DISDE CDISD CMAXC CONT2
 *)KILL CONT5 CONT6

 *"8ZWDI -8WDIS
" *"8WDIM; 8WDIM=0
"
 @EOF



 *)9SLPL
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %                                                                              %
 % 50.0 STC MAGTAPE DRIVER    80-07-03   PHE      VERSION  AA                   %
 %          LAST MODIFIED     82-02-03   TLS      REV.     01                   %
 %          LAST MODIFIED     82-14-06   TP       BIT 6 TO BIT 3 IN STAKO       %
 %          LAST MODIFIED     83-05-31   HKD      READ BACKWARDS (CORE.ADDR)    %
 %          LAST MODIFIED     83-10-11   TP       ERROR IN STARE CORRECTED      %
 %                                                                              %
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 *"99SM1+99SM2
" *)9SCLC

%
% @EOF
%
)LINE


%============================================================================
% 47.0       B U F F E R   S I Z E S
%
*"-8S3C
BPOOL/
*"
)MCDEF ACE9I $SIZB
99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+$SIZB ; )KILL 99EIO
]

%============================================================================
% 47.1       I O B U T
%
9EIOB=9EMRE                            % START OF I/O BUFFERS
IOBUT=*
       1     ;40
       100001;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8SMO1+NSBM1
       20006 ;MIBU1
       120006;MOBU1
"8TR5; 44    ;40
       100044;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8TR6; 45    ;40
       100045;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8TR7; 46    ;40
       100046;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8TR8; 47    ;40
       100047;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8TR9; 60    ;40
       100060;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8TR10;61    ;40
       100061;40
       ACE9I 100

99EIO=9EIOB; )KILL 9EIOB; 9EIOB=99EIO+100; )KILL 99EIO

"8TR11;62    ;40
