%%%%%%%%%%%%%%%%%%%%%%%%%   B U F F E R S   %%%%%%%%%%%%%%%%%%%%%%%%%%%%
%=======================================================================
%      LINE-PRINTER AND/OR VERSATEC BUFFERS
%




)LINE


%=============================================================================
%      M 1 D R I V E R S
%=============================================================================

%============================================================================
% 43.0       N O R D   1 0 0   D R I V E R S   F O R   D M A   D E V I C E S

"

)LINE


%=============================================================================
%      M 2 D R I V E R S
%=============================================================================

"8FDI1+8FDI2+8BFD1+8BFD2

)KILL RDAT  RSR1 RSR2 WCWD WDAD WSCT INTEN BBUSY
)KILL ENINT DVCL BCLBU WRDAT WRDEL RDID FREAD SEEK
)KILL RECAL
)KILL 9TREG 9AREG 9DREG 9XREG 9LREG

"
%


)LINE
 *"8BFD1+8BFD2
"
 SUBR BFDIS
 %=========================================================================
 %  43.9      B F D I S
 %
 % F L O P P Y   D I S K   D R I V E R   F O R   S I N G L E /
 % D O U B L E  D E N S I T Y  &  S I D E
 %
 % MODIFIED: 3/6 -81
 % MODIFIED: 24/2-82 BY TP
 %
 %       CALLING SEQUENCE:
 %       JPL I (BFDIS
 %       JMP   ERROR           ERROR EXIT
 %       JMP   BUSY            BUSY EXIT
 %       JMP   FIN             FINISHED
 %
 %
 %       REGISTER CONTENT WHEN CALLING BFDIS:
 %
 %       X- NUMBER OF SECTORS TO TRANSFER
 %       T- BIT 0-5: FUNCTION CODE
 %
 %              0 - READ
 %              1 - WRITE
 %              7 - ERASE TAPE                          *
 %             10 - ADVANCE TO EOF
 %             11 - REVERCE TO EOF
 %             12 - WRITE EOF
 %             13 - REWIND TO BOT
 %             20 - READ STATUS
 %             36 - READ EXTENDED STATUS                *
 %             41 - FORMAT FLOPPY                       *
 %             42 - READ FORMAT                         *
 %             43 - READ DELETED RECORD
 %             44 - WRITE DELETED RECORD
 %             54 - COPY FLOPPY                         *
 %             55 - FORMAT TRACK (FLOPPY)
 %             56 - CHECK CARTRIDGE (READ AND TEST CRC) *
 %             57 - TEST CARTRIDGE CAPASITY (WRITE)     *
 %             70 - RETENSION CARTRIDGE                 *
 %             71 - PERFORM TEST                        *
 %             72 - ILLEGAL COMMAND                     *
 %             73 - CLEAR                               *
 %             74 - Continious Read                     *
 %             75 - Continious Write                    *
 %
 %       BIT 6-7: UNIT NUMBER  (0,1,2,3)
 %
 %       BIT 8-9: BYTES/SECTOR:  0 = 512
 %                               1 = 256
 %                               2 = 128
 %                               3 = 1024
 %
 %       BIT 10: DOUBLE SIDED DRIVE & DISKETTE
 %
 %       BIT 11: DUAL DENSITY DISKETTE
 %
 %       POSSIBLE FORMATS (BITS 8-9-10-11):
 %
 %             0- IBM SYS-32-II  512 BYTES/SECTOR    SINGLE SIDE, SINGLE DENSITY
 %             1- IBM 3600       256 BYTES/SECTOR    SINGLE SIDE, SINGLE DENSITY
 %             2- IBM 3740       128 BYTES/SECTOR    SINGLE SIDE, SINGLE DENSITY
 %             3- ILLEGAL
 %             4- NON IBM        512 BYTES/SECTOR    DOUBLE SIDE, SINGLE DENSITY
 %             5- NON  IBM       256 BYTES/SECTOR    DOUBLE SIDE, SINGLE DENSITY
 %             6- NON  IBM       128 BYTES/SECTOR    DOUBLE SIDE, SINGLE DENSITY
 %             7- ILLEGAL
 %            10- NON  IBM       512 BYTES/SECTOR    SINGLE SIDE, DOUBLE DENSITY
 %            11- IBM SYS-34     256 BYTES/SECTOR    SINGLE SIDE, DOUBLE DENSITY
 %            12- ILLEGAL
 %            13- NON  IBM      1024 BYTES/SECTOR    SINGLE SIDE, DOUBLE DENSITY
 %            14- NON  IBM       512 BYTES/SECTOR    DOUBLE SIDE, DOUBLE DENSITY
 %            15- IBM SYS-34     256 BYTES/SECTOR    DOUBLE SIDE, DOUBLE DENSITY
 %            16- ILLEGAL
 %            17- NON IBM       1024 BYTES/SECTOR    DOUBLE SIDE, DOUBLE DENSITY
 %
 %
 %       BIT 12: STREAMER CASSET
 %
 %       BIT 14-15: DESTINATION UNIT DURING COPY COMMAND
 %
 %       D- DISK ADDRESS (LOGIC SECTOR ADDRESS)
 %
 %       ADDRESS RANGE:
 %
 %             0-1150  FORMAT  0   232     PAGES
 %             0-2203  FORMAT  1   220.375 PAGES
 %             0-3722  FORMAT  2   175.125 PAGES
 %                     FORMAT  3
 %             0-2320  FORMAT  4   464     PAGES
 %             0-4406  FORMAT  5   440.75  PAGES
 %             0-7644  FORMAT  6   372.25  PAGES
 %                     FORMAT  7
 %             0-2203  FORMAT 10   440.75  PAGES
 %             0-3722  FORMAT 11   372.25  PAGES
 %                     FORMAT 12
 %             0-1150  FORMAT 13   464     PAGES
 %             0-4406  FORMAT 14  1101.5   PAGES
 %             0-7644  FORMAT 15   764.5   PAGES
 %                     FORMAT 16
 %             0-2320  FORMAT 17  1150     PAGES
 %
 %  EXIT INFORMATION:
 %
 %       IF NORMAL OPERATIONS
 %         T-REG = HARDWARE STATUS
 %         X-REG = STATUS 1 (FROM FSTAT+0):
 %         D-REG = STATUS 2 (FROM FSTAT+1):
 %
 %       IF TEST OPERATIONS
 %         T-REG = HARDWARE STATUS
 %         X-REG = HARDWARE STATUS
 %         D-REG = 177777
 %
 %                 STATUS 1 (FROM FSTAT+0):
 %                                 BIT 0 - NOT USED
 %                                     1 - INT. ENABLED
 %                                     2 - CONTROLLER BUSY
 %                                     3 - CONTROLLER READY
 %                                     4 - OR OF ERRORS
 %                                     5 - DELETED RECORD
 %                                     6 - INTERNAL RETRIES (NO ERROR)
 %                                     7 - SERIOUS ERROR, NO MEMORY CONTACT
 %                                     8 - NOT USED
 %
 %                              BIT 9-15 - ERROR CODE:
 %                                     0 - TRANSFER OK
 %                                     5 - CRC ERROR
 %                                     6 - SECTOR NOT FOUND
 %                                     7 - TRACK NOT FOUND
 %                                    10 - FORMAT NOT FOUND
 %                                    11 - DISKETTE DEFECT (IMPOSSIBLE TO FORMAT)
 %                                    12 - FORMAT MISMATCH
 %                                    13 - ILLEGAL FORMAT SPECIFIED
 %                                    14 - SINGLE SIDED DISKETTE INSERTED
 %                                    15 - DOUBLE SIDED DISKETTE INSERTED
 %                                    16 - WRITE PROTECTED DISKETTE/CARTRIGE
 %                                    17 - DELETED RECORD
 %                                    20 - DRIVE NOT READY
 %                                    21 - CONTROLLER BUSY ON START
 %                                    22 - LOST DATA (OVER OR UNDERRUN)
 %                                    23 - TRACK ZERO NOT DETECTED
 %                                    24 - VCO FREQUENCY OUT OF RANGE
 %                                    25 - MICROPROGRAM OUT OF RANGE
 %                                    26 - TIMEOUT
 %                                    27 - UNDEFINED ERROR
 %                                    30 - TRACK OUT OF RANGE
 %                                    32 - COMPARE ERROR (DURING COMPARE OF DATA)
 %                                    33 - INTERNAL DMA ERRORS
 %                                    40 - ND-100 BUS ERROR COMMAND FETCH
 %                                    41 - ND-100 BUS ERROR STATUS TRANSFER
 %                                    42 - ND-100 BUS ERROR DATA TRANSFER
 %                                    43 - ILLEGAL COMMAND
 %                                    44 - WORDCOUNT NOT ZERO
 %                                    45 - ILLEGAL COMPETION (CONT. TRANSF)
 %                                    46 - ADR-REG ERROR
 %                                    50 - NO BOOTSTRAP FOUND ON DISKETTE
 %                                    51 - WRONG BOOTSTRAP (TOO OLD FLO-MON VERSION)
 %                                    60 - STREAMER HANDSHAKE ERROR
 %                                    61 - STREAMER STATUS TRANSFER ERROR
 %                                    62 - BAD CARTRIGE
 %                                    63 - NO CARTRIGE INSTALLED
 %                                    64 - END OF TAPE, CARTRIGE FULL
 %                                    65 - STREAMER DRIVE ERROR
 %                                    66 - UNIDENTIFIED EXCEPTION
 %                                    67 - ILLEGAL COMMAND TO STREAMER
 %                                    70 - PROM CHECKSUM ERROR
 %                                    71 - RAM ERROR
 %                                    72 - CTC ERROR
 %                                    73 - DMACTRL ERROR
 %                                    74 - VCO ERROR
 %                                    75 - FLOPPY CONTROLLER ERROR
 %
 %
 %                 STATUS 2 (FROM FSTAT+1):
 %                       BIT   0-3  - IF READ FORMAT COMMAND OR FORMAT ERROR:
 %                                    FORMAT READ FROM DISKETTE, OTHERWISE = 0
 %                             4-5  - NOT USED
 %                               6  - TRUE IBM FORMAT (128 B/S ON TR. 0 SIDE 0)
 %                               7  - NOT USED
 %                             8-9  - LAST ACCESSED UNIT
 %                            10-15 - NOT USED
 %
 %                 HARDWARE STATUS (HDEV+2):
 %                         BIT 0-6 - EQUAL TO STATUS 1 (FROM FSTAT+0)
 %                               7 - SERIOUS ERROR !!!!!!!!!!!!
 %                            8-14 - ALWAYS 0
 %                              15 - ALWAYS 1 ( = NEW CONTROLLER)
 %


 %      USE OF BUFFER WHILE RUNNING TESTS
 %
 %            *********************************************
 % BUFFER +00 * TEST NO                                   *
 % BUFFER +01 * BITS SET COROSPONDING TO IOX'S TO PERFORM *
 % BUFFER +02 * DATA READ FROM        IOX DEVNO +0        *
 % BUFFER +03 * DATA TO BE WRITHEN TO IOX DEVNO +1        *
 % BUFFER +04 * DATA READ FROM        IOX DEVNO +2        *
 % BUFFER +05 * DATA TO BE WRITHEN TO IOX DEVNO +3        *
 % BUFFER +06 * DATA READ FROM        IOX DEVNO +4        *
 % BUFFER +07 * DATA TO BE WRITHEN TO IOX DEVNO +5        *
 % BUFFER +06 * DATA READ FROM        IOX DEVNO +4        *
 % BUFFER +10 * DATA READ FROM        IOX DEVNO +6        *
 % BUFFER +11 * DATA TO BE WRITHEN TO IOX DEVNO +7        *
 %            *********************************************
 %            *  USE USER SPESIFYED CCB                   *
 %            *********************************************
 % BUFFER +12 *  CCBWO,  COMMAND WORD                     *
 % BUFFER +13 *  BFDEV,  DEVICE ADDRESS                   *
 % BUFFER +14 *  FMEMH,  MEMORY ADDRESS ( HIGH )          *
 % BUFFER +15 *  FMEML,  MEMORY ADDRESS ( LOW )           *
 % BUFFER +16 *  OPWCH,  OPTIONS AND WORD COUNT ( HIGH )  *
 % BUFFER +17 *  WCOUN,  WORD/RECORD COUNT ( LOW )        *
 % BUFFER +20 *  FSTA1,  STATUS 1                         *
 % BUFFER +21 *  FSTA2,  STATUS 2                         *
 % BUFFER +22 *  LASMH,  LAST MEMORY ADDRESS ( HIGH )     *
 % BUFFER +23 *  LASML,  LAST MEMORY ADDRESS ( LOW )      *
 % BUFFER +24 *  MREMW,  MOUST REMAINING WORDS            *
 % BUFFER +25 *  LREMW,  LEAST REMAINING WORDS            *
 %            *********************************************
 % BUFFER +26 *  FUTHER EXTENTIONS                        *
 % BUFFER +27 *  FUTHER EXTENTIONS                        *
 %            *********************************************
 % BUFFER +30 *  REAL BUFFER START                        *
 %            *********************************************



 SYMBOL IOXIN=164000
 %SYMBOL RDATA=0               % READ DATA
 SYMBOL RSTAT=2               % READ STATUS
 SYMBOL LCONT=3               % LOAD CONTROL WORD
 SYMBOL LHPOI=5               % LOAD POINTER HIG
 SYMBOL LLPOI=7               % LOAD POINTER LOW
 SYMBOL LDATA=7               % LOAD DATA

 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %                              %
 %  OPERATION DECLARATIONS      %
 %  *):NEW                      %
 %                              %
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

 SYMBOL RSSTA=20              %   READ STATUS
 SYMBOL PTEST=71              % * PERFORM TEST
 SYMBOL FCLEAR=73             % * CLEAR

 SYMBOL FOCCU=2, INERR=4, SEERR=7                            %
                                                             %
 INTEGER TEARG                                               %   TEMPRARY SAVED A-REG DORING TEST IOXS
 INTEGER TETRG                                               %   TEMPRARY SAVED T-REG DORING TEST IOXS
                                                             %
 BFDIS: TAD=:TADRG      ; X=:XRG                             %
                                                             %
        IF A:=77 /\ T-FCLEAR >< 0 THEN                       %
                                                             %
          A:=HDEV+RSTAT   ; * EXR SA                         %   READ STATUS
          IF A BIT FOCCU GO HBUSY                            %   CONTROLLER BUSY
                                                             %
          X:=A                                               %
          K:="0"                                             %
          IF A:=BUSFL><0        THEN K:=1 FI                 %   PREVIOUS TRANSFER TO BE CHECKED ?
                                                             %   OR
          IF A:=77 /\ T-RSSTA=0 THEN K:=1 FI                 %   OPER. READ STATUS ON FLOPPY?
          IF K THEN                                          %
                                                             %   YES, PREVIOUS TRANSFER TO BE CHECKED
            X=:XRG                                           %
            T:=HDEV ; * EXR ST                               %   READ STATUS 1
            D:=A                                             %
            IF X BIT INERR THEN                              %   ERRORS
                                                             %
              IF A:=TRG NBIT 14  THEN                        %   IF NOT STREAMER
                T+LCONT                                      %
                A:=22 ; * EXR ST                             %   CLEAR DEVICE
              FI                                             %
              L-1                                            %   ERROR RETUR
                                                             %
            ELSE                                             %   NO ERRORS, FINISHED
                                                             %
              IF A:=77 /\ TRG -PTEST=0 THEN                  %   IF PERFORME TEST
                                                             %
                X:=HDEV                                      %
                AD:=MEMAD ; D+1 ; A:=A+C ; * EXAM            %
                T BZERO 10                                   %
                DO                                           %
                  D+1 ; A:=A+C                               %
                  IF T BIT "0" THEN                          %
                    T=:TETRG ; A=:TEARG                      %
                    * EXR SX                                 %   EXIQUTE THE INPUT IOX
                    T:=A ; A:=TEARG                          %
                    * DEPO                                   %   STORE THE READ DATA
                    T:=TETRG                                 %
                  FI                                         %
                WHILE T SHZ -2 ><0                           %
                  X+2 ; D+1 ; A:=A+C                         %
                OD                                           %
                                                             %
              FI                                             %
                                                             %
 RETFI:       L+1                                            %   FINISED RETUR
                                                             %
            FI                                               %
            T:=FSTA2                                         %   STATUS 2 (ERROR CODE & FORMAT NO.)
            X:=XRG:=:D                                       %   HWSTAT IN D, FSTA1 IN X
            IF A:=77 /\ TRG -PTEST=0  AND D NBIT INERR THEN  %   IF PREFORME TEST WENT OK
              X:=D                                           %   HWSTAT TO X
              T:=-1                                          %
            FI                                               %
            T:=:D                                            %   HWSTAT TO T, FSTA2/-1 TO D
            A:=ARG                                           %
            0=:BUSFL                                         %
            GO RETUR                                         %
                                                             %
 HBUSY:     GO BUSYR                                         %   BUSY RETURN
                                                             %
          FI                                                 %
        FI                                                   %

                                                           %
                                                             %   START NEW OPERATION
        * BLDA 140 DT                                        %   SET K IF STREAMER
                                                             %   START CREATING THE CONTROLLWORD IN D
        IF A:=77 /\ T -PTEST=0 THEN                          %
                                                             %
          AD:=MEMAD ; * EXAM                                 %
          T SHZ 11                                           %   SHIFT TEST NO. IN PLACE
          T BONE 10 BONE 3                                   %
          T BONE 1 ; * BSTA 60 DT                            %   TAKE STERAMING FROM K
          T=:SFCOM                                           %
          X:=HDEV+1                                          %
          D+1 ; A:=A+C ; * EXAM ; BLDA 100 DT                %   GET IOX BITS, SAVE USE USER SPESIFYED CCB IN K
          T BZERO 10                                         %
          DO                                                 %
            D+1 ; A:=A+C                                     %
            D+1 ; A:=A+C                                     %
            IF T  BIT 1 THEN                                 %
              T=:TETRG                                       %
              * EXAM ; SWAP SA DT                            %
              * EXR SX                                       %   EXEQUTE THE WANTED OUTPUT IOX
              T=:A:=TETRG                                    %
            FI                                               %
          WHILE T SHZ -2><0                                  %
            X+2                                              %
          OD                                                 %
          IF K THEN                                          %
            T:=HDEV+LLPOI                                    %
            AD:=MEMAD  ; A:=:D+12        ; * EXR ST          %   LOAD CCB POINTER LOW
            A:=:D:=A+C ; T+"LHPOI-LLPOI" ; * EXR ST          %   LOAD CCB POINTER HIG
            A:=:D+16:=:D:=A+C                                %
          FI                                                 %
                                                             %
        ELSE                                                 %
                                                             %
          IF A:=77 /\ T -FCLEAR=0 THEN                       %
            A:=22 ; * BSTA 50 DA                             %   CLEAR + STREAMER IF STREAMER IN USE
            A=:SFCOM                                         %   SAVE COMMAND
          ELSE                                               %
                                                             %
            T BZERO 14 =:CCBWO                               %
            0=:OPWCH                                         %
            X:=XRG=:WCOUN                                    %   NO. OF SECTORS TO TRANSFER
            A:=D=:BFDEV                                      %
            A:=0         ; T:=HDEV+"LHPOI" ; * EXR ST        %   LOAD COMMAND POINTER, UPPER ADDR
            A:="CCBWO"+B ; T+"LLPOI-LHPOI" ; * EXR ST        %   LOWER
            D:=0 BONE 10 BONE 1 ; * BSTA 50 DD               %   SET ACTVATE AND ENABELE INTERUPT BITS, BIT  6 IF STREAMER
                                                             %
            IF  D NBIT 5 THEN                                %   IF NOT STREAMER
                                                             %
              A:=CCBWO SHZ 10 SHZ -16 =:X                    %   UNIT NO. TO X
                                                             %
              IF A:=STEPR(X)><0 THEN D BONE 11 FI            %   SET BIT  9 IF STEP RATE
              IF A:=DOORL(X)><0 THEN D BONE 12 FI            %   SET BIT 10 IF DOOR LOCK
              IF A:=PRECP(X)><0 THEN D BONE 13 FI            %   SET BIT 11 IF DISABLE PRECOMP
              IF A:=DTRCK(X)><0 THEN D BONE 14 FI            %   SET BIT 12 IF DUAL TRACK DENSITY (FUTURE!!)
              IF A:=COMFL   ><0 THEN D BONE 15 FI            %   SET BIT 13 IF HARDWARE COMPARE
                                                             %
            FI                                               %
            A:=D=:SFCOM                                      %   SAVE COMMAND
            AD:=MEMAD                                        %
          FI                                                 %
                                                             %
        FI                                                   %
                                                             %
        AD=:FMEMD                                            %   MEMORY ADDRESS
        T:=HDEV+LCONT                                        %
        A:=SFCOM ; * EXR ST                                  %   ACTIVATE
        A=:T                                                 %
        IF A:=77/\TRG-FCLEAR=0 THEN                          %
          T:=0; L+1                                          %   FINISHED!!!
          A:=HDEV+RSTAT   ; * EXR SA                         %   READ STATUS
          A=:XRG                                             %
        FI                                                   %
        A:=T                                                 %
 BUSYR: A=:BUSFL                                             %   BUSY
        X:=XRG                                               %
        TAD:=TADRG                                           %
 RETUR: EXITA                                                %
                                                             %
 RBUS                                                        %

 *"
"
 @EOF

 %

 %==============================================================================
 %  PIT3-POF-CODE
 %
 %==============================================================================
 %
 *)KILL 3PITU 3POFU
 *"8UDMA+8VICO 3PIT
" *"8PUDM+8PVIC -3PIT
"
 *"3PITU+3POFU
"
 *)KILL 3PITP 3POFP
 *"8PIOC 3PIT
" *"8PPIO -3PIT
" *"3PITP+3POFP
"
 *"3PIT
"
 *"-3PIT
" * 3PIT; *-1/       % MARK THAT NEXT TIME WE ARE ON PIT 3
 *"
" @EOF


%
