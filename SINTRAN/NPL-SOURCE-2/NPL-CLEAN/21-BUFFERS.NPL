%
ITE13=*;
*+XID13/
-1
IT13E=*

%==============================================================================
% 42.20      I T B 1 3
%
ITB13, CLCFI
"8C1HD;ITB13+147/HDIF1
"8C2HD;ITB13+150/HDIF2
"8HMO3;ITB13+151/IDHM3
"8HMO4;ITB13+152/IDHM4
"

MAX13=*-ITB13

