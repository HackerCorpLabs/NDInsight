"8TR5
ITB12+43/DT05R
"
"8TR6
ITB12+44/DT06R
"8TR7
ITB12+45/DT07R
"8TR8
ITB12+46/DT08R
"8TR9
ITB12+47/DT09R
"8TR10
ITB12+50/DT10R
"8TR11
ITB12+51/DT11R
"8TR12
ITB12+52/DT12R
"
ITB12+117/DT01R
"8C1HD;ITB12+147/HDOF1
"8C2HD;ITB12+150/HDOF2
"8HMO3;ITB12+151/UDHM3
"8HMO4;ITB12+152/UDHM4
"
MAX12=*-ITB12


%==============================================================================
% 42.16      I T E 1 0
%
ITE10=*

*+XID10/
-1
%==============================================================================
% 42.17      I T E 1 1
%
ITE11=*




*+XID11/
-1
%==============================================================================
