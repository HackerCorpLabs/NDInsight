








)LINE


%%%%%%%%%%%%  M A C R O E S  -  S I N 3  -  G E N  %%%%%%%%%%%%%%%%%%%%%

%%     MACROES USED ON SIN3-GEN
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%     PREVIOUSLY USED MACROES ARE KILLED
)KILL IDVI IDVO BLIDV SIB TXTRO BCHD NSGB NTBA DR11C DIGOUT
)KILL ARISTO CMAC GUDMA GGPIB

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



% MACRO FOR BACKGROUND PROGRAMS

"-8S3C

)MCDEF BBP $NAM
$NAM ,  0;1100;0;0;0;0;9ENTO;GSEG
       0;0;100000;*-13
       0;0;0
XYS=GSEG;)KILL GSEG;GSEG=XYS+1000;)KILL XYS
]


"

)MCDEF JONAC $CJOC
CKJU=*; DVTAB/ $CJOC  %
CKJU/
)KILL CKJU
]


% MACRO FOR REMOTE TERMINAL OUTPUT RT-DESCRIPTION

)MCDEF RTUP $NR,$LNR
RU$NR $LNR , 0;1061;0;0;0;0;RTOCH;0
       0;0;0;*-13
       0;0;0
]


% MACRO FOR RWRT-PROGRAM FOR SIN/SIN CHANNEL INPUT

)MCDEF RWCR $NR,$LNR
CR$NR $LNR , 0;1100;0;0;0;0;TR$NR $LNR ;6
       0;0;0;*-13
       0;0;0
]

% MACRO FOR RWRT-PROGRAM FOR SIN/SIN CHANNEL OUTPUT

)MCDEF RWCW $NR,$LNR
CW$NR $LNR , 0;1100;0;0;0;0;TW$NR $LNR ;6
       0;0;0;*-13
       0;0;0

]

)MCDEF ACRTP
       NYRTP=NXRTP; )KILL NXRTP; NXRTP=NYRTP+1; )KILL NYRTP
]





)LINE


%%%%%%%%%%%%%%%%%%%%%%% S I N 3  -  G E N %%%%%%%%%%%%%%%%%%%%%%%%%%

