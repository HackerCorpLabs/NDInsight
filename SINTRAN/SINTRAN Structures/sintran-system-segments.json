{
  "_metadata": {
    "title": "SINTRAN III System Segment Definitions",
    "description": "Complete mapping of system segment numbers to names, address ranges, PIT assignments, and descriptions. Covers SEGFIL 0 (system segments 1-135 octal) and SEGFIL 1 (spooler segments 400+ octal).",
    "sources": [
      "ND-860230-8-EN SINTRAN III Release Information N-version, Section 18.3",
      "ND-860230-7A-EN SINTRAN III Release Information M-Version, Section 17.3",
      "SINTRAN NPL Source SYMBOL-1-LIST L07 (kernel segment constants)",
      "Physical memory dump cross-verification"
    ],
    "conventions": {
      "segment_numbers": "Octal (as used by SINTRAN). Decimal equivalent provided for convenience.",
      "address_ranges": "Octal, format 'start:end' representing logical page addresses",
      "pit_numbers": "Decimal PIT number. DPIT=7, RPIT=8(dec)/10(oct), SPIT=9(dec)/11(oct), MPIT=10(dec)/12(oct), IPIT=13(dec)/15(oct)",
      "naming_pattern": "S3xxx = active segment, S3Sxxx = Save copy, S3Ixxx = Image copy"
    },
    "segment_entry_format": {
      "entry_size_words": 8,
      "entry_size_symbol": "5SEGS=010 (octal)",
      "fields": {
        "SEGLI":  {"offset_oct": "000", "description": "Segment link (linked list pointer)"},
        "PRESE":  {"offset_oct": "001", "description": "Previous segment link"},
        "LOGAD":  {"offset_oct": "002", "description": "Logical address (first page number)"},
        "SEGLE":  {"offset_oct": "003", "description": "Segment length in pages"},
        "MADR":   {"offset_oct": "004", "description": "Mass storage address (disk)"},
        "FLAG":   {"offset_oct": "005", "description": "Segment status flags"},
        "SGSTA":  {"offset_oct": "006", "description": "Protection and ring level bits"},
        "BPAGL":  {"offset_oct": "007", "description": "Begin page link in core map (0=swapped out)"}
      }
    },
    "flag_bits": {
      "bit_0": {"symbol": "5OK",   "text": "OK",        "description": "Segment is valid"},
      "bit_1": {"symbol": "5INHB", "text": "INHIBITED", "description": "Segment is inhibited"},
      "bit_3": {"symbol": "5NORE", "text": "PROTECT",   "description": "Write-protected (no-release)"},
      "bit_4": {"symbol": "5SREE", "text": "SHARED",    "description": "Shared/reentrant segment"},
      "bit_5": {"symbol": "5FIXC", "text": "FIXED",     "description": "Fixed in core (never swapped)"},
      "bit_6": {"symbol": "5DEMA", "text": "DEMAND",    "description": "Demand-loaded segment"}
    },
    "sgsta_bits": {
      "bit_15": {"symbol": "5WPM",  "text": "WPM",     "description": "Write permit"},
      "bit_14": {"symbol": "5RPM",  "text": "RPM",     "description": "Read permit"},
      "bit_13": {"symbol": "5FPM",  "text": "FPM",     "description": "Fetch permit"},
      "bits_10_9": {"text": "RING",  "description": "Ring level: 00=RING0, 01=RING1, 10=RING2, 11=RING3"},
      "bit_3":  {"text": "KPIT",    "description": "Kernel PIT flag (set on kernel PIT-related segments)"},
      "bit_0":  {"symbol": "5NCLS", "text": "NOCLEAR", "description": "Pages not cleared on deallocation"}
    },
    "created": "2026-02-09",
    "version": "1.0"
  },

  "segfil_structure": {
    "description": "SINTRAN uses multiple segment files (SEGFILs). Each SEGFIL holds up to 256 segments. Global segment number = SEGFIL_number * 256 + local_segment_number.",
    "segfils": {
      "0": "System segments (kernel, OS components)",
      "1": "User/spooler segments (base 256 decimal = 400 octal)",
      "2": "Library segments",
      "3": "ND-500 domains",
      "4": "Special/additional segments"
    }
  },

