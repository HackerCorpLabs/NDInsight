  "spooler_segments": {
    "description": "Spooler segments are in SEGFIL 1, starting at global segment 400 octal (256 decimal). Used by the spooler RT programs (SPRT1-SPRT16). Actual SEGFIL names are unknown - these segment numbers were identified from the memory dump but their disk file names have not been verified.",
    "base_segment_oct": "400",
    "base_segment_dec": 256,
    "notes": "No verified segment names available for spooler segments. The RT programs SPRT1-SPR16 use these segments (identified via SEGM1/SEGM2 cross-reference) but the actual SEGFIL file names are not known."
  },

  "segment_categories": {
    "kernel": "Core OS segments that are always present and mapped into kernel PITs (DPIT, MPIT, RPIT, IPIT, 5PIT)",
    "active": "Active code/data segments that are swapped in/out as needed",
    "save": "Save copies on disk - used to restore active segments after crashes or INITIALIZE-SYSTEM-SEGMENT",
    "image": "Image copies - pristine original from system generation, used as fallback",
    "data": "Data-only segments (no executable code)",
    "nd500": "ND-500/5000 coprocessor related segments",
    "system": "System utility segments",
    "reserved": "Allocated but not used"
  },

  "naming_conventions": {
    "S3xxx":  "Active segment (the one currently in use)",
    "S3Sxxx": "Save copy (written to disk periodically, restored on crash)",
    "S3Ixxx": "Image copy (original from SYSGEN, never modified at runtime)",
    "xPIT":   "Page Index Table segment (DPIT, MPIT, RPIT, IPIT, 5PIT)"
  },

  "segment_triads": {
    "description": "Many system components exist as a triad: Active + Save + Image. The Active segment runs in memory, the Save is periodically updated on disk, and the Image is the original from system generation.",
